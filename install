#!/usr/bin/env bash
# ae bootstrap installer — fetch a release bundle and hand it to the core.
#
# The whole of ae's remaining Bash, and it exists for one reason: a machine with
# no ae has no core to run. It resolves the platform, downloads the bundle and
# the release manifest, PROVES the bundle against that manifest, and runs the
# core it just unpacked. Everything a publication IS — the version directory,
# its 0555 modes, SHA256SUMS, the ~/.local/bin/ae symlink, the journal that
# makes a half-done install reversible — is `ae-core _install`, in Rust, since
# slice Z4. It is also a bundle member, so an installed ae ships the installer
# that published it.
#
# Safe as the advertised one-liner: the archive is downloaded to a FILE and
# checksum-verified before anything is extracted, and no payload is ever piped
# to a shell. AE_VERSION pins a CalVer target; unset takes the latest release.
set -euo pipefail

REPOSITORY="https://github.com/clemens33/ae"

die() {
    echo "ae: $*" >&2
    exit 1
}

case "$(uname -s):$(uname -m)" in
    Darwin:arm64) platform="darwin-arm64" ;;
    Linux:x86_64) platform="linux-x86_64-musl" ;;
    Darwin:*) die "Intel macOS is unsupported; use an Apple Silicon Mac." ;;
    Linux:*) die "Linux ARM is unsupported; use a Linux x86_64 machine." ;;
    *) die "unsupported platform: $(uname -s)/$(uname -m)" ;;
esac

version="${AE_VERSION:-}" && version="${version#v}" && release="latest"
if [ -n "$version" ]; then
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        die "AE_VERSION must be a CalVer tag such as 2026.9.1: $version"
    release="v$version"
fi

command -v curl >/dev/null 2>&1 || die "curl is required to download a release."
if command -v sha256sum >/dev/null 2>&1; then
    digest() { sha256sum "$1"; }
elif command -v shasum >/dev/null 2>&1; then
    digest() { shasum -a 256 "$1"; }
else
    die "neither sha256sum nor shasum is available."
fi

# A bundle root is published 0555, and a 0555 directory refuses the unlink of
# its own entries — so the tree is made writable before it is removed.
tmp="$(mktemp -d "${TMPDIR:-/tmp}/ae-install.XXXXXX")"
trap 'chmod -R u+w "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT

url="$REPOSITORY/releases/$release/download"
curl -fsSL --retry 3 --output "$tmp/SHA256SUMS" "$url/SHA256SUMS" ||
    die "no release at $release; build from a checkout instead (just install)."
[ -n "$version" ] || version="$(awk -v p="$platform" '
    { name = $2; sub(/^\*/, "", name)
      if (name ~ ("^ae-[0-9]+\\.[0-9]+\\.[0-9]+-" p "\\.tar\\.gz$")) {
          sub(/^ae-/, "", name); sub("-" p "\\.tar\\.gz$", "", name); print name; exit } }
' "$tmp/SHA256SUMS")"
[ -n "$version" ] || die "the latest release has no $platform bundle."

archive="ae-$version-$platform.tar.gz"
curl -fsSL --retry 3 --output "$tmp/$archive" "$url/$archive" ||
    die "could not download $archive"
want="$(awk -v a="$archive" '$2 == a || $2 == "*" a { print $1; exit }' "$tmp/SHA256SUMS")"
[[ "$want" =~ ^[0-9a-fA-F]{64}$ ]] || die "checksum entry for $archive is missing or malformed."
[ "$(digest "$tmp/$archive" | awk 'NR == 1 { print $1 }')" = "$want" ] ||
    die "checksum mismatch for $archive; nothing was installed."

tar -xzf "$tmp/$archive" -C "$tmp" || die "archive extraction failed."
root="$tmp/ae-$version-$platform"
[ -x "$root/ae-core" ] || die "the bundle carries no executable core."
# Not `exec`: the EXIT trap has a temporary tree to remove, and the core reads
# the bundle out of it. The core's exit status is still this script's.
rc=0
"$root/ae-core" _install --from "$root" || rc=$?
exit "$rc"
