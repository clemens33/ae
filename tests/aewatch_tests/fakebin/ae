#!/usr/bin/env python3
"""Fake ae executable for the aewatch bash oracle (the watchdog's ae_path=).
Phase-2 boundaries only — no network, no real behavior:

  _recover-pending <session>  -> print the CURRENT tick's recover rows as TSV
                                 (kind\tslot\tagent\ttool\tcaptured), driven by
                                 ticks.json[tick.idx].recover in AEWATCH_ORACLE_DIR.
  telegram _supervise         -> record a telegram.supervise effect carrying the
                                 propagated tmux server (AE_TMUX_SERVER, '' if unset),
                                 only when AEWATCH_ORACLE_RECORD=1. No network/send.

FAILS LOUD (exit 2 + stderr) on any other command OR a wrong arg shape — a silent
accept would forge call-shape parity.
"""
import json
import os
import sys
from pathlib import Path


def die(msg):
    sys.stderr.write(f"fake-ae: {msg}\n")
    sys.exit(2)


argv = sys.argv[1:]

if argv[:1] == ["_recover-pending"]:
    if len(argv) != 2:
        die(f"_recover-pending expects exactly <session>, got {argv[1:]}")
    session = argv[1]
    oracle = os.environ.get("AEWATCH_ORACLE_DIR")
    if oracle:
        D = Path(oracle)
        idx = int((D / "tick.idx").read_text().strip()) if (D / "tick.idx").exists() else 0
        ticks = json.loads((D / "ticks.json").read_text()) if (D / "ticks.json").exists() else []
        # recover is SESSION-KEYED: {session: [rows]} (phase 3).
        recover = ticks[idx].get("recover", {}) if idx < len(ticks) else {}
        rows = recover.get(session, [])
        for r in rows:
            fields = [r.get("kind", ""), r.get("slot", ""), r.get("agent", ""), r.get("tool", ""), r.get("captured", "")]
            sys.stdout.write("\t".join(fields) + "\n")
    sys.exit(0)

if argv == ["telegram", "_supervise"]:
    oracle = os.environ.get("AEWATCH_ORACLE_DIR")
    if oracle and os.environ.get("AEWATCH_ORACLE_RECORD", "0") == "1":
        effect = {"kind": "telegram.supervise", "tmux_server": os.environ.get("AE_TMUX_SERVER", "")}
        with (Path(oracle) / "effects.jsonl").open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(effect) + "\n")
    sys.exit(0)

die(f"unmodeled command: {' '.join(argv)}")
