#!/usr/bin/env python3
"""Fake date for the aewatch bash oracle: deterministic time from the current
fixture tick. Implements the forms the watchdog + ae_emit_event use: `+%s`,
`-u +%FT%TZ` (event timestamps), `+%H:%M:%S`, and `-d <ts> +%s` (delegated)."""
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

D = Path(os.environ["AEWATCH_ORACLE_DIR"])


def cur_epoch():
    idx = int((D / "tick.idx").read_text().strip()) if (D / "tick.idx").exists() else 0
    ticks = json.loads((D / "ticks.json").read_text())
    t = ticks[idx] if idx < len(ticks) else ticks[-1]
    return int(t["epoch"])


args = sys.argv[1:]
# Timestamp -> epoch. ae's _ae_epoch tries the GNU form (`date -d <ts> +%s`)
# first and falls back to the BSD form (`date -u -j -f <fmt> <ts> +%s`), so the
# fake must answer BOTH — parsed here rather than delegated, so the oracle
# behaves identically on a GNU and a BSD host.
if args and args[0] == "-d":
    ts = args[1] if len(args) > 1 else ""
    try:
        print(int(datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()))
    except ValueError:
        sys.stderr.write(f"date: invalid date '{ts}'\n")
        sys.exit(1)
    sys.exit(0)
if "-j" in args:
    fmt_ts = args[args.index("-f") + 1] if "-f" in args else "%Y-%m-%dT%H:%M:%SZ"
    ts = args[args.index("-f") + 2] if "-f" in args else ""
    try:
        print(int(datetime.strptime(ts, fmt_ts).replace(tzinfo=timezone.utc).timestamp()))
    except (ValueError, IndexError):
        sys.stderr.write(f"date: invalid date '{ts}'\n")
        sys.exit(1)
    sys.exit(0)

if args and args[0] == "-u":
    args = args[1:]  # our epoch is already UTC
fmt = args[0] if args else "+%s"
dt = datetime.fromtimestamp(cur_epoch(), tz=timezone.utc)
if fmt == "+%s":
    print(dt.strftime("%s") if False else int(dt.timestamp()))
elif fmt == "+%FT%TZ":
    print(dt.strftime("%Y-%m-%dT%H:%M:%SZ"))
else:
    strf = fmt.lstrip("+").replace("%F", "%Y-%m-%d").replace("%T", "%H:%M:%S")
    print(dt.strftime(strf))
