#!/usr/bin/env python3
"""Fake sleep for the aewatch bash oracle: never sleeps. Advances the tick + writes
a cycle boundary ONLY when its argument is the sentinel interval the runner forces
via AE_WATCHDOG_INTERVAL_SEC — so helper sleeps (send 0.3s, etc.) do NOT consume a
tick. After the final tick it flips `control` so the next has-session breaks the loop."""
import json
import os
import sys
from pathlib import Path

D = Path(os.environ["AEWATCH_ORACLE_DIR"])
sentinel = os.environ.get("AEWATCH_ORACLE_SLEEP_SENTINEL", "")
arg = sys.argv[1] if len(sys.argv) > 1 else ""

if arg != sentinel:
    sys.exit(0)  # a helper sleep — do not advance a tick / write a boundary

idx = int((D / "tick.idx").read_text().strip()) if (D / "tick.idx").exists() else 0
n = int((D / "n_ticks").read_text().strip())
if os.environ.get("AEWATCH_ORACLE_RECORD", "0") == "1":
    with (D / "effects.jsonl").open("a") as fh:
        fh.write(json.dumps({"boundary": idx}) + "\n")
idx += 1
(D / "tick.idx").write_text(str(idx))

# Inject the NEW tick's INPUT events (agent declarations / inbound messages) into
# the session events.jsonl AFTER incrementing the index and BEFORE the next loop
# reads events — the only real cross-cycle boundary without editing ae. These are
# inputs, not effects: appended directly (compact), never recorded as event.append.
if idx < n:
    ticks = json.loads((D / "ticks.json").read_text())
    tick = ticks[idx] if idx < len(ticks) else {}
    sdir_file = D / "sessions_dir.txt"
    if sdir_file.exists():
        sdir = Path(sdir_file.read_text().strip())
        # Per-tick INPUT events, routed BY SESSION (phase 3). Inputs, not effects.
        for entry in tick.get("events", []):
            evp = sdir / entry["session"] / "events.jsonl"
            with evp.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps(entry["event"], separators=(",", ":")) + "\n")
        # Orchestrator heartbeats, keyed by session (mtime = INTEGER epoch - age).
        for session, spec in tick.get("heartbeats", {}).items():
            hb = sdir / session / "meta-agent-state.json"
            hb.write_text("{}", encoding="utf-8")
            mtime = int(tick["epoch"]) - int(spec["age"])
            os.utime(hb, (mtime, mtime))

if idx >= n:
    (D / "control").write_text("gone")
sys.exit(0)
