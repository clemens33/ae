#!/usr/bin/env bash
# Parallel front-end for tests/integration.
#
# Run: tests/itest-par                  — every section, in parallel
#      tests/itest-par list send        — only those domains (see tests/itest-domains.tsv)
#      tests/itest-par --domain list,send
#      tests/itest-par --jobs 4         — or AE_ITEST_JOBS=4
#      tests/itest-par --list           — print domain / chain / section
#      tests/itest-par --check          — the domains-file guard, and nothing else
#      tests/itest-par --timings        — merge this run's measured durations into
#                                         tests/itest-timings.tsv (implied by a full run)
#      tests/itest-par --serial         — one job, for bisecting a parallel-only failure
#      tests/itest-par --keep-logs      — keep the per-unit logs even on success
#
# WHY THIS EXISTS. The serial suite costs ~30 minutes, which is the whole inner loop
# spent once per question. Nothing here weakens a section: every section still runs in
# a REAL `tests/integration` process, through the suite's own `#64` filter, with the
# suite's own isolation preamble. This file only decides WHICH sections each process
# runs and adds up the answers.
#
# ISOLATION IS INHERITED, NOT REIMPLEMENTED. The preamble derives TMPDIR from
# `mktemp -d`, SOCK_DIR from `mktemp -d /tmp/ae-itest-$$-XXXXXX`, TMUX_TMPDIR from
# SOCK_DIR and AE_TMUX_SERVER from `$$` — all per PROCESS. So N processes are N
# isolated worlds for free, and there is no seed to pass. The preamble's stale-directory
# sweep is already concurrency-safe: it reads the owning pid out of the marker IT wrote
# and leaves a live one alone (measured — 88 concurrent runs, no cross-reap).
#
# THE UNIT OF WORK IS A CHAIN, NOT A SHARD. The suite's sections are not hermetic: a
# handful reference a fixture, a stub function or a shell variable left behind by the
# section above them, and the suite says so. Those are recorded as a `chain` in
# tests/itest-domains.tsv and always run in ONE process, in file order. Everything else
# is its own unit. Units are then dispatched longest-first onto a pool of N workers, so
# balance comes from a dynamic queue rather than from a static partition that is only as
# good as its timings file.
#
# NOT errexit. This runner's job is to collect failures, so an exit status is data here,
# not an accident. `set -u` and `pipefail` stay.
set -uo pipefail

if [[ -z "${BASH_VERSINFO[0]:-}" ]] || ((BASH_VERSINFO[0] < 4)); then
    echo "$0: needs bash >= 4 (this is ${BASH_VERSION:-unknown}); try /opt/homebrew/bin/bash $0" >&2
    exit 2
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SUITE="$ROOT/tests/integration"
DOMAINS_FILE="$ROOT/tests/itest-domains.tsv"
TIMINGS_FILE="$ROOT/tests/itest-timings.tsv"
# What a section costs when the timings file has never seen it. Deliberately a little
# above the measured floor (~4s): a new section that is actually slow should be
# scheduled EARLY, and over-estimating an unknown only costs a suboptimal order.
DEFAULT_SECS=8

# ── options ──────────────────────────────────────────────────────────
JOBS=""
WANT_DOMAINS=""
MODE="run"
FORCE_TIMINGS=""
KEEP_LOGS=""
usage() {
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}
while (($#)); do
    case "$1" in
        -h | --help) usage 0 ;;
        --list) MODE="list" ;;
        --check) MODE="check" ;;
        --timings) FORCE_TIMINGS=1 ;;
        --keep-logs) KEEP_LOGS=1 ;;
        --serial) JOBS=1 ;;
        --jobs)
            shift
            JOBS="${1:-}"
            ;;
        --jobs=*) JOBS="${1#*=}" ;;
        --domain)
            shift
            WANT_DOMAINS="${WANT_DOMAINS},${1:-}"
            ;;
        --domain=*) WANT_DOMAINS="${WANT_DOMAINS},${1#*=}" ;;
        -*)
            echo "$0: unknown option '$1'" >&2
            usage 2
            ;;
        *) WANT_DOMAINS="${WANT_DOMAINS},$1" ;;
    esac
    shift
done
WANT_DOMAINS="${WANT_DOMAINS#,}"

# Physical cores, halved: every section drives tmux servers and pane children, so the
# useful parallelism is bounded by process churn and not by arithmetic. Measured on an
# 18-core M-series laptop: 9 jobs put the whole suite inside the length of its own
# longest section.
_cores() {
    local n=""
    n="$(sysctl -n hw.physicalcpu 2>/dev/null || true)"
    if [[ ! "$n" =~ ^[0-9]+$ ]]; then
        n="$(lscpu -p=core 2>/dev/null | grep -v '^#' | sort -u | grep -c . || true)"
    fi
    if [[ ! "$n" =~ ^[0-9]+$ ]] || ((n == 0)); then
        n="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
    fi
    [[ "$n" =~ ^[0-9]+$ ]] && ((n > 0)) || n=4
    printf '%s' "$n"
}
if [[ -z "$JOBS" ]]; then JOBS="${AE_ITEST_JOBS:-}"; fi
if [[ -z "$JOBS" ]]; then JOBS=$(($(_cores) / 2)); fi
if [[ ! "$JOBS" =~ ^[0-9]+$ ]] || ((JOBS < 1)); then JOBS=1; fi

# ── the section list, and the domains file that must mirror it ───────
# The suite is the authority on what a section is; this file never re-derives one.
mapfile -t SECTIONS < <("$BASH" "$SUITE" --list)
if ((${#SECTIONS[@]} == 0)); then
    echo "$0: '$SUITE --list' produced no sections" >&2
    exit 2
fi

DOM=()
CHAIN=()
DNAME=()
if [[ ! -f "$DOMAINS_FILE" ]]; then
    echo "$0: missing $DOMAINS_FILE" >&2
    exit 2
fi
# Rows are domain <TAB> chain <TAB> section — the free-text field LAST, and a `-`
# placeholder in the chain column, because a run of tabs is one IFS delimiter and an
# empty middle field would silently shift the section name into it (AGENTS.md, TSV
# framing).
while IFS=$'\t' read -r _d _c _n; do
    [[ -n "${_d:-}" ]] || continue
    case "$_d" in \#*) continue ;; esac
    DOM+=("$_d")
    CHAIN+=("$_c")
    DNAME+=("$_n")
done <"$DOMAINS_FILE"

# THE GUARD. Same length, same names, SAME ORDER. Order is load-bearing twice over: a
# chain must be contiguous in file order to reproduce the serial sequence, and a domains
# file that has merely drifted out of order is a file nobody is maintaining.
_check() {
    local rc=0 i n
    n=${#SECTIONS[@]}
    if ((${#DNAME[@]} != n)); then
        echo "DOMAINS FILE OUT OF SYNC: ${#DNAME[@]} rows, $n sections" >&2
        rc=1
    fi
    for ((i = 0; i < n; i++)); do
        if [[ "${DNAME[i]:-}" != "${SECTIONS[i]}" ]]; then
            echo "  row $((i + 1)): file has '${DNAME[i]:-<missing>}'" >&2
            echo "               suite has '${SECTIONS[i]}'" >&2
            rc=1
        fi
    done
    for ((i = n; i < ${#DNAME[@]}; i++)); do
        echo "  row $((i + 1)): '${DNAME[i]}' is not a section of this suite" >&2
        rc=1
    done
    # A chain must be a contiguous run. A gapped chain would reorder the suite, which is
    # exactly the thing chains exist to preserve.
    local seen="" c prev=""
    for ((i = 0; i < ${#CHAIN[@]}; i++)); do
        c="${CHAIN[i]}"
        [[ "$c" == "-" ]] && {
            prev=""
            continue
        }
        if [[ "$c" != "$prev" ]]; then
            case "$seen" in
                *"|$c|"*)
                    echo "  chain '$c' is not contiguous (resumes at row $((i + 1)))" >&2
                    rc=1
                    ;;
            esac
            seen="${seen}|${c}|"
        fi
        prev="$c"
    done
    if ((rc == 0)) && [[ "$MODE" == "check" ]]; then
        echo "domains file: $n sections, all present, chains contiguous"
    fi
    return $rc
}
if [[ "$MODE" == "check" ]]; then
    _check
    exit $?
fi
_check || {
    echo "" >&2
    echo "Refusing to run: $DOMAINS_FILE does not mirror the suite. Fix the file" >&2
    echo "(add the new section with its domain, or drop the stale row) and retry." >&2
    exit 2
}

if [[ "$MODE" == "list" ]]; then
    printf '%s\t%s\t%s\n' "domain" "chain" "section"
    for ((i = 0; i < ${#SECTIONS[@]}; i++)); do
        printf '%s\t%s\t%s\n' "${DOM[i]}" "${CHAIN[i]}" "${SECTIONS[i]}"
    done
    echo ""
    printf '%s\n' "${DOM[@]}" | sort | uniq -c | sort -rn | sed 's/^/  /'
    exit 0
fi

# ── selection ────────────────────────────────────────────────────────
declare -A WANT=()
if [[ -n "$WANT_DOMAINS" ]]; then
    IFS=',' read -r -a _w <<<"$WANT_DOMAINS"
    for d in "${_w[@]}"; do
        [[ -n "$d" ]] || continue
        WANT["$d"]=1
    done
    _bad=""
    for d in "${!WANT[@]}"; do
        if ! printf '%s\n' "${DOM[@]}" | grep -qxF "$d"; then _bad="$_bad $d"; fi
    done
    if [[ -n "$_bad" ]]; then
        {
            echo "unknown domain(s):$_bad"
            echo "known domains:"
            printf '%s\n' "${DOM[@]}" | sort -u | sed 's/^/  /'
        } >&2
        exit 2
    fi
fi

# ── units ────────────────────────────────────────────────────────────
# A unit is a list of section indices that one `tests/integration` process runs. A chain
# is one unit whole — selecting ANY of its members selects all of them, because a member
# alone is exactly the broken run the chain records.
declare -a UNIT_IDX=() # newline-separated indices per unit
declare -a UNIT_SECS=()
declare -a UNIT_LABEL=()
declare -A TIMING=()
if [[ -f "$TIMINGS_FILE" ]]; then
    while IFS=$'\t' read -r _s _n; do
        [[ -n "${_s:-}" ]] || continue
        case "$_s" in \#*) continue ;; esac
        [[ "$_s" =~ ^[0-9]+$ ]] || continue
        TIMING["$_n"]="$_s"
    done <"$TIMINGS_FILE"
fi

_selected() { # index -> 0 if its domain was asked for
    if ((${#WANT[@]} == 0)); then return 0; fi
    [[ -n "${WANT[${DOM[$1]}]:-}" ]] && return 0
    return 1
}

PULLED=0
i=0
n=${#SECTIONS[@]}
while ((i < n)); do
    j=$i
    if [[ "${CHAIN[i]}" != "-" ]]; then
        while ((j + 1 < n)) && [[ "${CHAIN[j + 1]}" == "${CHAIN[i]}" ]]; do j=$((j + 1)); done
    fi
    want=1
    for ((k = i; k <= j; k++)); do
        if _selected "$k"; then want=0; fi
    done
    if ((want == 0)); then
        idx=""
        secs=0
        for ((k = i; k <= j; k++)); do
            idx="${idx}${k}"$'\n'
            t="${TIMING[${SECTIONS[k]}]:-$DEFAULT_SECS}"
            secs=$((secs + t))
            _selected "$k" || PULLED=$((PULLED + 1))
        done
        UNIT_IDX+=("$idx")
        UNIT_SECS+=("$secs")
        if ((i == j)); then UNIT_LABEL+=("${SECTIONS[i]}"); else UNIT_LABEL+=("chain ${CHAIN[i]} (${SECTIONS[i]} .. ${SECTIONS[j]})"); fi
    fi
    i=$((j + 1))
done

if ((${#UNIT_IDX[@]} == 0)); then
    echo "$0: no sections selected" >&2
    exit 2
fi

# Longest first. A dynamic queue plus longest-first dispatch is within a few percent of
# optimal here and, unlike a static partition, degrades gracefully when the timings file
# is stale or absent.
mapfile -t ORDER < <(
    for u in "${!UNIT_SECS[@]}"; do printf '%s\t%s\n' "${UNIT_SECS[u]}" "$u"; done | sort -rn -k1,1 | cut -f2
)

# ── the filter pattern ───────────────────────────────────────────────
# The suite's filter is an extended regex matched case-insensitively against the whole
# section name, on two paths: `awk 'tolower($0) ~ tolower(pat)'` for the selection
# report and bash's `[[ =~ ]]` for the guard. Section names are prose and contain ERE
# metacharacters — parens, `+`, `.`, `#`, `[`. Backslash-escaping them is NOT safe here:
# awk processes escapes in a `-v` assignment, so `\(` reaches the regex engine as an
# undefined escape whose meaning differs per awk. Replacing each metacharacter with `.`
# needs no backslash at all, is a valid ERE on both paths, and can only ever OVER-match —
# which the uniqueness assertion below turns into a refusal rather than a silent
# miscount.
_esc() { printf '%s' "$1" | sed 's/[][(){}.^$*+?|\\]/./g'; }
_pattern() { # indices on stdin -> anchored alternation
    local alt="" k
    while IFS= read -r k; do
        [[ -n "$k" ]] || continue
        alt="${alt}|$(_esc "${SECTIONS[k]}")"
    done
    printf '^(%s)$' "${alt#|}"
}
ALL_NAMES="$(printf '%s\n' "${SECTIONS[@]}")"
_selects_n() { # pattern -> how many of the suite's sections it selects
    printf '%s\n' "$ALL_NAMES" | awk -v pat="$1" 'tolower($0) ~ tolower(pat)' | grep -c . || true
}

# ── run ──────────────────────────────────────────────────────────────
# One core, built once. Without this each unit would re-derive it, and a cold tree would
# start N cargo builds against one target directory.
if [[ -z "${AE_CORE_BIN:-}" ]]; then
    _core="$ROOT/target/debug/ae"
    if [[ ! -x "$_core" ]]; then
        echo "building the core (cargo build --locked) …"
        (cd "$ROOT" && cargo build --locked --quiet) || {
            echo "$0: could not build the core" >&2
            exit 1
        }
    fi
    export AE_CORE_BIN="$_core"
fi

RUNDIR="$(mktemp -d "${TMPDIR:-/tmp}/itest-par-XXXXXX")"
NSEL=0
for u in "${!UNIT_IDX[@]}"; do NSEL=$((NSEL + $(printf '%s' "${UNIT_IDX[u]}" | grep -c . || true))); done
echo "tests/itest-par: $NSEL of $n sections in ${#UNIT_IDX[@]} units, $JOBS jobs"
((PULLED > 0)) && echo "  ($PULLED section(s) pulled in by a chain dependency)"
[[ -n "$WANT_DOMAINS" ]] && echo "  domains: $WANT_DOMAINS"
echo "  logs: $RUNDIR"
echo ""

START=$(date +%s)
DONE=0
_report_new() {
    local f u
    for f in "$RUNDIR"/*.res; do
        [[ -e "$f" ]] || continue
        [[ -e "$f.seen" ]] && continue
        : >"$f.seen"
        u="${f##*/}"
        u="${u%.res}"
        IFS=$'\t' read -r _rc _secs _p _fl _ran _lbl <"$f"
        DONE=$((DONE + 1))
        if [[ "$_rc" == "0" ]]; then
            printf '  [%2d/%2d] %4ss  %s passed             %s\n' "$DONE" "${#UNIT_IDX[@]}" "$_secs" "$_p" "$_lbl"
        else
            printf '  [%2d/%2d] %4ss  %s passed, %s FAILED (rc=%s)  %s\n' "$DONE" "${#UNIT_IDX[@]}" "$_secs" "$_p" "$_fl" "$_rc" "$_lbl"
        fi
    done
}

for u in "${ORDER[@]}"; do
    while (($(jobs -rp | grep -c . || true) >= JOBS)); do
        sleep 0.2
        _report_new
    done
    (
        pat="$(printf '%s' "${UNIT_IDX[u]}" | _pattern)"
        want=$(printf '%s' "${UNIT_IDX[u]}" | grep -c . || true)
        got=$(_selects_n "$pat")
        if [[ "$got" != "$want" ]]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "9" "0" "0" "$want" "0" "PATTERN SELECTED $got, WANTED $want: ${UNIT_LABEL[u]}" >"$RUNDIR/$u.tmp"
            mv "$RUNDIR/$u.tmp" "$RUNDIR/$u.res"
            exit 0
        fi
        s=$(date +%s)
        env -u AE_ITEST_ONLY -u AE_ITEST_FULL "$BASH" "$SUITE" "$pat" >"$RUNDIR/$u.log" 2>&1
        rc=$?
        e=$(date +%s)
        line="$(tail -1 "$RUNDIR/$u.log")"
        p=0
        fl=0
        ran=0
        if [[ "$line" =~ ^([0-9]+)\ passed,\ ([0-9]+)\ failed ]]; then
            p="${BASH_REMATCH[1]}"
            fl="${BASH_REMATCH[2]}"
        else
            # No summary line at all: the suite died before it could report. Counting
            # this as "0 failed" is how a parallel runner invents a green run.
            rc=$((rc == 0 ? 8 : rc))
        fi
        if [[ "$line" =~ :\ ([0-9]+)\ of\ [0-9]+\ sections\ ran ]]; then ran="${BASH_REMATCH[1]}"; fi
        # temp+rename: the parent polls this directory for progress and must never
        # read a half-written row.
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$rc" "$((e - s))" "$p" "$fl" "$ran" "${UNIT_LABEL[u]}" >"$RUNDIR/$u.tmp"
        mv "$RUNDIR/$u.tmp" "$RUNDIR/$u.res"
    ) &
done
wait
_report_new
WALL=$(($(date +%s) - START))

# ── aggregate ────────────────────────────────────────────────────────
TP=0
TF=0
TRAN=0
BAD=()
for u in "${!UNIT_IDX[@]}"; do
    f="$RUNDIR/$u.res"
    if [[ ! -f "$f" ]]; then
        BAD+=("$u")
        continue
    fi
    IFS=$'\t' read -r _rc _secs _p _fl _ran _lbl <"$f"
    TP=$((TP + _p))
    TF=$((TF + _fl))
    TRAN=$((TRAN + _ran))
    [[ "$_rc" == "0" ]] || BAD+=("$u")
done

echo ""
if ((${#BAD[@]} > 0)); then
    echo "── failures ─────────────────────────────────────────────────────────"
    for u in "${BAD[@]}"; do
        f="$RUNDIR/$u.res"
        if [[ -f "$f" ]]; then IFS=$'\t' read -r _rc _secs _p _fl _ran _lbl <"$f"; else
            _rc="no-result"
            _lbl="${UNIT_LABEL[u]}"
        fi
        echo ""
        echo "UNIT: $_lbl   (rc=$_rc, log: $RUNDIR/$u.log)"
        printf '%s' "${UNIT_IDX[u]}" | while IFS= read -r k; do
            [[ -n "$k" ]] && echo "  section: ${SECTIONS[k]}"
        done
        if [[ -f "$RUNDIR/$u.log" ]]; then
            grep -n '^FAIL:\|^ABORTED at\|expected\|actual' "$RUNDIR/$u.log" | head -40 | sed 's/^/    /'
        fi
    done
    echo ""
fi

# ── timings ──────────────────────────────────────────────────────────
# Merged, never clobbered: a domain-scoped run measures a handful of sections and must
# not delete the numbers for the ones it did not run. A unit's wall time is split evenly
# across its members — exact for the 1-member units that are the overwhelming majority,
# and only ever a scheduling hint for the rest.
if [[ -n "$FORCE_TIMINGS" ]] || ((NSEL == n)); then
    tmp="$TIMINGS_FILE.tmp.$$"
    for u in "${!UNIT_IDX[@]}"; do
        f="$RUNDIR/$u.res"
        [[ -f "$f" ]] || continue
        IFS=$'\t' read -r _rc _secs _p _fl _ran _lbl <"$f"
        [[ "$_rc" == "0" || "$_rc" == "1" ]] || continue
        members=$(printf '%s' "${UNIT_IDX[u]}" | grep -c . || true)
        ((members > 0)) || continue
        each=$((_secs / members))
        ((each > 0)) || each=1
        while IFS= read -r k; do
            [[ -n "$k" ]] && TIMING["${SECTIONS[k]}"]="$each"
        done < <(printf '%s' "${UNIT_IDX[u]}")
    done
    {
        echo "# seconds<TAB>section — measured by tests/itest-par, used to order units"
        echo "# longest-first. Regenerate with: tests/itest-par --timings"
        for ((k = 0; k < n; k++)); do
            printf '%s\t%s\n' "${TIMING[${SECTIONS[k]}]:-$DEFAULT_SECS}" "${SECTIONS[k]}"
        done
    } >"$tmp" && mv "$tmp" "$TIMINGS_FILE"
fi

if ((${#BAD[@]} == 0 && TF == 0)); then
    [[ -n "$KEEP_LOGS" ]] || rm -rf "$RUNDIR"
    echo "${TP} passed, ${TF} failed — ${TRAN} of ${n} sections ran in ${#UNIT_IDX[@]} units, ${JOBS} jobs, ${WALL}s wall"
    exit 0
fi
echo "${TP} passed, ${TF} failed — ${TRAN} of ${n} sections ran in ${#UNIT_IDX[@]} units, ${JOBS} jobs, ${WALL}s wall; ${#BAD[@]} unit(s) failed"
echo "logs kept: $RUNDIR"
exit 1
