_closure_missing=""
_gen_bad=""
_gen_seen=0
_CLOSURE_LEX_ERR=""
for _af in "$_gen_dir"/*; do
    [[ -f "$_af" ]] || continue
    _an="$(basename "$_af")"
    case "$_an" in
        meta | meta.lock | workspace.md | *.lock | *.jsonl | *.tsv | *.sid) continue ;;
    esac
    # bash is the syntax authority for a file bash will run.
    if ! "${BASH:-bash}" -n "$_af" 2>/dev/null; then
        _gen_bad+="${_an}:syntax "
        continue
    fi
    # `declare -f` re-prints a definition as `name () ` at column 0.
    if ! grep -qE '^[a-z_][a-zA-Z0-9_]* \(\) $' "$_af"; then
        case " $_closure_shims " in
            *" $_an "*) continue ;;
            *)
                _gen_bad+="${_an}:defines-nothing "
                continue
                ;;
        esac
    fi
    # Strip the trailing dispatch call so sourcing DEFINES without RUNNING —
    # and REMEMBER the name, because stripping it is exactly what would hide a
    # dispatch that calls something the artifact never defines.
    _tail="$(tail -1 "$_af")"
    _tailfn=""
    if [[ "$_tail" =~ ^([a-z_][a-zA-Z0-9_]*)\ \"\$@\"$ ]]; then
        _tailfn="${BASH_REMATCH[1]}"
        sed '$d' "$_af" >"$_gen_dir/.closure_src"
    elif [[ "$_an" == "_lib" ]]; then
        cp "$_af" "$_gen_dir/.closure_src" # a library: no dispatch tail by design
    else
        _gen_bad+="${_an}:unknown-tail "
        continue
    fi
    _gen_seen=$((_gen_seen + 1))
    # Ask bash what this artifact defines and what those definitions contain.
    # Sourcing reproduces the real availability set INCLUDING whatever _lib the
    # artifact chose to source — the grant is a consequence, not an inference.
    #
    # TRUST BOUNDARY, stated deliberately: the input here is ae's OWN generated
    # output, and the threat model is an ACCIDENTAL shape in trusted code (a
    # helper that shadows a name, a definition that vanishes), not hostile code.
    # So this is env -i plus `builtin`-prefixed introspection — enough that a
    # shadowed `declare` cannot poison the primitives the probe reads with — and
    # deliberately NOT a sandbox: no primitive-rejection list, no fs or network
    # jail. Those would be the wrong cost for this threat model, and would rot.
    _probe="$(
        cd "$_gen_dir" && "${_closure_tmo[@]}" env -i \
            PATH="$PATH" HOME="$_gen_home" AE_HOME="$_gen_home/.ae" \
            "${BASH:-bash}" -c '
            builtin set +eu
            # $0 IS the artifact path — a helper resolves its own _lib via
            # dirname "$0", so probing with bash'"'"'s own $0 made every artifact
            # look for _lib next to the bash binary and silently define nothing
            # from it. This is how a real invocation sees itself.
            #
            # EVERY primitive the probe reads with is qualified — builtin for
            # shell builtins, command for externals. Half-qualifying is not a
            # weaker version of this, it is a hole: an awk() shadow that
            # delegates to `command awk` and appends one extra name makes
            # declare -F report a definition that does not exist, and a real
            # missing callee then reads as available.
            # shellcheck disable=SC1090
            builtin source "$0" >/dev/null 2>&1
            _fns="$(builtin declare -F | command awk "{print \$3}")"
            builtin printf "===DEFS===\n%s\n===BODIES===\n" "$_fns"
            for _f in $_fns; do builtin declare -f "$_f"; done
        ' "$_gen_dir/.closure_src" </dev/null 2>/dev/null
    )"
    _defs="$(LC_ALL=C awk '/^===DEFS===$/{f=1;next} /^===BODIES===$/{exit} f' <<<"$_probe")" ||
        _CLOSURE_LEX_ERR="defs-extract"
    if [[ -z "$_defs" ]]; then
        _gen_bad+="${_an}:no-definitions "
        continue
    fi
    # The dispatch target must actually exist, and be THIS artifact's main.
    if [[ -n "$_tailfn" ]]; then
        grep -qxF "$_tailfn" <<<"$_defs" ||
            _gen_bad+="${_an}:dispatch-undefined(${_tailfn}) "
        _expect="helper_$(printf '%s' "${_an#_}" | tr '-' '_')_main"
        [[ "$_tailfn" == "$_expect" ]] ||
            _gen_bad+="${_an}:dispatch-name(${_tailfn}!=${_expect}) "
    fi
    # Canonical bodies, with heredoc PAYLOADS dropped: `declare -f` re-prints a
    # heredoc verbatim, and its data lines are not code — lexing them reports
    # calls that cannot happen. The opener line itself is kept (it can carry a
    # real call before the <<).
    # No `|| true` in guard plumbing: a stage that fails must be an ERROR, not an
    # empty body that reads as "calls nothing". Comment-stripping uses awk rather
    # than grep -v precisely so that "no lines left" is not a non-zero exit.
    _bodies="$(LC_ALL=C awk '/^===BODIES===$/{f=1;next} f' <<<"$_probe")" ||
        _CLOSURE_LEX_ERR="bodies-extract"
