    mkdir -p "$dir/bin"
    cp "$AE_BIN" "$dir/ae"
    cp "$(dirname "$AE_BIN")/ae-entry" "$dir/ae-entry"
    cp "$(dirname "$AE_BIN")/Cargo.toml" "$dir/Cargo.toml"
    cp "$(dirname "$AE_BIN")/Cargo.lock" "$dir/Cargo.lock"
    cp "$(dirname "$AE_BIN")/justfile" "$dir/justfile"
    printf '%s\n' \
        '#!/usr/bin/env bash' \
        'if [[ "${2:-}" == "+%Y" ]]; then printf "%s\n" "$AE_FIXTURE_YEAR"; elif [[ "${2:-}" == "+%m" ]]; then printf "%s\n" "$AE_FIXTURE_MONTH"; else exit 1; fi' \
        >"$dir/bin/date"
    chmod +x "$dir/bin/date"
    git -C "$dir" init -q
    git -C "$dir" config user.email calver@example.test
    git -C "$dir" config user.name CalVer
    printf '%s\n' fixture >"$dir/fixture"
    git -C "$dir" add ae ae-entry Cargo.toml Cargo.lock justfile fixture
    git -C "$dir" commit -qm fixture
}
_calver_tag_fixture() {
    local dir="$1" tag
    shift
    for tag; do
        git -C "$dir" tag "$tag"
    done
}
_calver_run() {
    local dir="$1" year="$2" month="$3"
    (
        cd "$dir"
        # shellcheck disable=SC2031  # PATH selects fixture date/git shims
        env "AE_FIXTURE_YEAR=$year" "AE_FIXTURE_MONTH=$month" \
            "AE_REAL_GIT=$_calver_real_git" "AE_REAL_MV=$_calver_real_mv" \
            "AE_REAL_CP=$_calver_real_cp" \
            "PATH=$dir/bin:$PATH" just bump
    )
}
_calver_recover_run() {
    local dir="$1"
    (
        cd "$dir"
        env "AE_REAL_MV=$_calver_real_mv" "AE_REAL_CP=$_calver_real_cp" \
            "PATH=$dir/bin:$PATH" just bump-recover
    )
}
_calver_versions() {
    local dir="$1"
    printf '%s|%s|%s|%s' \
        "$(grep -m1 '^_AE_ENTRY_VERSION=' "$dir/ae-entry" | cut -d'"' -f2)" \
        "$(grep -m1 '^AE_VERSION=' "$dir/ae" | cut -d'"' -f2)" \
        "$(grep -m1 '^version = "' "$dir/Cargo.toml" | cut -d'"' -f2)" \
        "$(awk '/^name = "ae"$/{in_ae=1; next} in_ae && /^version = /{gsub(/"/, "", $3); print $3; exit} /^\\[\\[package\\]\\]$/{in_ae=0}' "$dir/Cargo.lock")"
}
_calver_fingerprint() {
    cksum "$1/ae" "$1/ae-entry" "$1/Cargo.toml" "$1/Cargo.lock"
}
_calver_source_ae_block() {
    awk '
        function flush(    i) {
            if (has_name && has_source) {
                for (i = 1; i <= n; i++) print lines[i]
            }
            delete lines
            n = 0
            has_name = 0
            has_source = 0
        }
        /^\[\[package\]\]$/ {
            flush()
            lines[++n] = $0
            next
        }
        {
            lines[++n] = $0
            if ($0 == "name = \"ae\"") has_name = 1
            if ($0 ~ /^source = /) has_source = 1
        }
        END { flush() }
    ' "$1/Cargo.lock"
}
