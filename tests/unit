# ── _ae_inside_tmux: is $TMUX trustworthy? (#29) ─────────────────────
# $TMUX is a plain env var: a GUI terminal launched from a pane hands it to every
# tab shell, and those shells are NOT tmux clients. Truth test = our controlling
# tty must be a PANE tty on that server. Stubs: `ps` reports our tty, `tmux`
# reports the server's pane ttys. (Deliberately NOT client ttys — a client's tty
# is the terminal EMULATOR's, never the pane pty a shell sits on, so matching
# there would call every genuine in-pane shell stale.)
# Globals, not locals: the stubs outlive the call that installs them.
_IT_TTY=""
_IT_PANES=""
_IT_SESSION="stub-session"
# shellcheck disable=SC2317,SC2329
ps() { printf '  %s\n' "$_IT_TTY"; } # leading blanks: BSD ps pads its columns
# shellcheck disable=SC2317,SC2329
tmux() {
    case "$*" in
        *list-panes*)
            [[ -n "$_IT_PANES" ]] || return 1
            # shellcheck disable=SC2086
            printf '%s\n' $_IT_PANES
            ;;
        *display-message*) printf '%s\n' "$_IT_SESSION" ;;
        *) return 1 ;;
    esac
}
_it_stub() { # $1 = our tty as ps prints it, rest = the server's pane ttys
    _IT_TTY="$1"
    shift
    _IT_PANES="$*"
}
assert_eq "inside-tmux: no \$TMUX at all -> outside" "1" \
    "$(unset TMUX; _ae_inside_tmux; echo $?)"
assert_eq "inside-tmux: our tty IS a pane tty -> inside" "0" \
    "$(_it_stub ttys039 /dev/ttys039 /dev/ttys040; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
# procps prints "pts/3", BSD ps "ttys039"; a ps that spelled the full path must
# not make every genuine pane look stale.
assert_eq "inside-tmux: linux-shaped tty (pts/N) matches its pane" "0" \
    "$(_it_stub pts/3 /dev/pts/3 /dev/pts/9; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
assert_eq "inside-tmux: a ps that prints /dev/... still matches" "0" \
    "$(_it_stub /dev/ttys039 /dev/ttys039; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
assert_eq "inside-tmux: our tty is NOT a pane tty -> stale, treated as outside" "1" \
    "$(_it_stub ttys999 /dev/ttys039 /dev/ttys040; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
assert_eq "inside-tmux: stale says so on stderr, exactly once" "1" \
    "$(_it_stub ttys999 /dev/ttys039
       export TMUX=/tmp/s,1,0
       out="$({ _ae_inside_tmux || true
                _ae_inside_tmux || true; } 2>&1 >/dev/null)"
       command grep -c 'stale \$TMUX inherited' <<<"$out" || true)"
# Unanswerable stays TRUE — the guard fires on PROVEN mismatch only. Agents' own
# children have no controlling tty ("?"/"??"/"-" by ps flavour); a tmux that
# cannot answer proves nothing either.
assert_eq "inside-tmux: no controlling tty (??) -> trust \$TMUX (historical)" "0" \
    "$(_it_stub '??' /dev/ttys039; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
assert_eq "inside-tmux: no controlling tty (?) -> trust \$TMUX" "0" \
    "$(_it_stub '?' /dev/ttys039; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
assert_eq "inside-tmux: tmux cannot answer -> trust \$TMUX" "0" \
    "$(_it_stub ttys999; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
# The client-semantics branches route through it. detect_current_session is the
# sharp one: under a stale $TMUX, display-message answers for the ORIGINAL pane,
# so `ae end` with no name used to resolve to somebody else's session.
_it_sessdir="$(mktemp -d)"
mkdir -p "$_it_sessdir/stub-session"
# Sourced ad-hoc (not in the global extraction list): later blocks install their
# own detect_current_session stubs, so this definition must not outlive the block.
eval "$(awk '/^detect_current_session\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
assert_eq "inside-tmux: a stale \$TMUX is NOT inside tmux (asked of the predicate itself)" "1" \
    "$(_it_stub ttys999 /dev/ttys039; TMUX=/tmp/s,1,0 _ae_inside_tmux 2>/dev/null; echo $?)"
assert_eq "inside-tmux: detect_current_session still resolves from a genuine pane" "stub-session" \
    "$(_it_stub ttys039 /dev/ttys039; SESSIONS_DIR="$_it_sessdir" TMUX=/tmp/s,1,0 detect_current_session 2>/dev/null || true)"
assert_eq "inside-tmux: detect_current_session claims nothing under a stale \$TMUX" "" \
    "$(_it_stub ttys999 /dev/ttys039; SESSIONS_DIR="$_it_sessdir" TMUX=/tmp/s,1,0 detect_current_session 2>/dev/null || true)"
rm -rf "$_it_sessdir"
unset _it_sessdir
unset -f detect_current_session
# Completeness invariant rather than text adjacency: exactly the two remaining
# client-semantics branches consult the guard, and exactly ONE bare ${TMUX:-}
# read survives outside the helper — resolve_launch_tmux_server, which reads the
# SOCKET PATH, not our client status (an inherited $TMUX still names the very
# server that spawned the terminal, which is the right one to talk to). In both
# directions so a new branch cannot be added unguarded, and so a future sweep
# cannot "finish the job" and break end/stop targeting.
# Still two guarded branches — `tmux_attach` went with the launch flow, and the
# launch fall-through took its place: it asks the guard whether to hand the core
# `--inside-tmux`. The ONE bare ${TMUX:-} read is still
# resolve_launch_tmux_server's, which reads the SOCKET PATH rather than our
# client status (an inherited $TMUX names the very server that spawned the
# terminal, which is the right one to talk to).
assert_eq "inside-tmux: 2 client branches guarded, 1 deliberate bare read left" "2|1" \
    "$(_g="$(command grep -c '^ *if _ae_inside_tmux; then' <<<"$AE_SOURCE" || true)"
       _b="$(command grep -c '^ *if \[\[ -n "\${TMUX:-}" \]\]; then' <<<"$AE_SOURCE" || true)"
       printf '%s|%s' "$_g" "$_b")"
unset -f _it_stub ps tmux
unset _IT_TTY _IT_PANES _IT_SESSION

