# ── EVERY REFUSAL ARM, CALLED BARE UNDER ERRExIT ────────────────────────────────
# A refusal that ABORTS is not a refusal. This function's containment check was
# `grep -oF … | wc -l`; grep exits 1 on no match, pipefail makes the pipeline exit 1,
# and in statement position that killed the function instead of returning empty. In
# production it reaches write_launch_script's SPLIT assignment, which re-arms errexit,
# so the intended degradation (launch fine, no re-run form) became a FAILED LAUNCH —
# "could not write the launch script — agent not started".
#
# Every pin above is blind to it: they all call through `$( )` in an assert_eq
# argument, where the abort is masked and the empty stdout reads as a clean refusal.
# AGENTS.md says it plainly — only a BARE call proves set -e safety, a green suite does
# not — so each arm is driven BARE, in statement position, in its own errexit shell,
# and what is asserted is that the CALLER IS STILL ALIVE afterwards.
_r43_bare() { # -> every arm's marker, or a short list ending where it died
    _timeout 10 "${BASH:-bash}" -c '
        set -euo pipefail
        for fn in _launch_id_probeable extract_binary_from_cmd launch_rerun_command; do
            eval "$(awk "/^${fn}\(\) \{/,/^\}\$/" "$1")"
        done
        launch_rerun_command "claude --session-id i1 --append x" i1 "claude --session-id i1" >/dev/null
        printf "rewrote "
        launch_rerun_command "claude --session-id i1" i1 "grok --other --session-id i1" >/dev/null
        printf "uncontained "
        launch_rerun_command "claude --session-id i1 x claude --session-id i1" i1 "claude --session-id i1" >/dev/null
        printf "twice "
        launch_rerun_command "claude --session-id i1" "" "claude --session-id i1" >/dev/null
        printf "no-id "
        launch_rerun_command "claude --session-id i1" i1 "" >/dev/null
        printf "no-pre "
        launch_rerun_command "claude --session-id pending" pending "claude --session-id pending" >/dev/null
        printf "pending "
        launch_rerun_command "mytool --session-id i1" i1 "mytool --session-id i1" >/dev/null
        printf "wrong-binary "
        launch_rerun_command "claude --model opus" i1 "claude --model opus" >/dev/null
        printf "no-token"
    ' _ "$AE_BIN" 2>/dev/null
}
assert_eq "#43: every refusal arm RETURNS under errexit when called bare" \
    "rewrote uncontained twice no-id no-pre pending wrong-binary no-token" "$(_r43_bare)"
# ...and the list is an ENUMERATION, not a sample: it is derived from the function's
# `return 0` sites, so adding an arm without a bare call for it fails HERE. (It was a
# sample: "no-id" and "pending" both land on the id check, and the valid-id/empty-pre
# arm — a return site of its own — had no case at all.)
assert_eq "#43: the bare-call list still covers every return site in the function" "7" \
    "$(_body="$(awk '/^launch_rerun_command\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
       _code="$(command grep -vE '^[[:space:]]*#' <<<"$_body" || true)"
       command grep -c 'return 0' <<<"$_code" | tr -d '[:space:]')"

# The rest of the slice, same shape. These four are QUERIES — their answer is stdout,
# so their status must be a deliberate 0 on every path, including the refusing ones.
# (They pass today; the pin exists because the one that did not also passed every
# `$( )` test in the file.)
_r43_bare_queries() {
    _timeout 10 "${BASH:-bash}" -c '
        set -euo pipefail
        for fn in _launch_id_probeable _launch_injected_head _launch_is_resume \
            _launch_probe_claude _launch_probe_codex _launch_resume_decider; do
            eval "$(awk "/^${fn}\(\) \{/,/^\}\$/" "$1")"
        done
        _launch_injected_head "codex x" "" >/dev/null;   printf "head "
        _launch_probe_claude "" >/dev/null;              printf "claude "
        _launch_probe_codex "bad;id" >/dev/null;         printf "codex "
        _launch_resume_decider "" A B >/dev/null;        printf "decider"
