            # %4 unstamped but external (@ae_agent not in meta -> skip). '|'
            # delimiter with an EMPTY slot field — the tab-collapse repro.
            printf '%s|%s|%s\n' "%1" "main" "claude:lead"
            printf '%s|%s|%s\n' "%2" "" "optimal:builder"
            printf '%s|%s|%s\n' "%3" "" "codex:helper"
