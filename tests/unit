assert_eq "#43: the slice's query functions all RETURN when they refuse (bare, errexit)" \
    "head claude codex decider" "$(_r43_bare_queries)"
# Predicate calls sitting in STATEMENT position, where returning 1 would abort the
# caller under errexit. Factored out so the detector can be pointed at a seed rather
# than only at ae — a filter nobody ever fed a hostile line is not a filter.
_r43_stmt_calls() { # <source-text> -> count
    local hits
    # Only genuine CONDITIONAL operators are exempt. The first version exempted any
    # line containing `|` or `&`, which let a LONE PIPELINE through — and a pipeline is
    # statement position: under pipefail `pred | cat` aborts at rc=1 for precisely the
    # reason this guard exists. `|&` is a pipeline too. So the exemption is `||` and
    # `&&`, spelled out, and everything else counts.
    hits="$(command grep -vE '^[[:space:]]*#' <<<"$1" \
        | command grep -E '^[[:space:]]*(_launch_id_probeable|_launch_is_resume)[[:space:]]' \
        | command grep -vE '(\|\||&&)' \
        | command grep -vE '^(_launch_id_probeable|_launch_is_resume)\(\) \{' || true)"
    [[ -n "$hits" ]] || {
        printf '0'
        return 0
    }
    printf '%s' "$(command grep -c . <<<"$hits" | tr -d '[:space:]')"
    return 0
}

# The two PREDICATES are the deliberate exception: they return 1 to mean "no", so a
# bare call SHOULD abort — which is safe only while every call site is a condition.
# That is the fact pinned here, since the day one moves to statement position it
# becomes the same bug in a function nobody would think to probe.
assert_eq "#43: the resume predicates are only ever called in condition position" "0" \
    "$(_r43_stmt_calls "$AE_SOURCE")"
# The exclusion is anchored to the definition SHAPE — name at column 0 followed by
# "() {" — not to "the line contains () {" anywhere. The loose version dropped any
# matched line mentioning that text, so a real bare call wearing it as a trailing
# comment was filtered out and the detector reported a clean zero. Pinned with that
# exact disguise, because a detector is only as good as what it refuses to ignore.
assert_eq "#43: a bare predicate call disguised by a trailing '() {' comment is still counted" "1" \
    "$(_r43_stmt_calls '    _launch_id_probeable "$id" # predicate contract () {')"
assert_eq "#43: a predicate in a LONE PIPELINE is statement position, and is counted" "1" \
    "$(_r43_stmt_calls '    _launch_id_probeable "$id" | cat')"
assert_eq "#43: ...and bash's |& pipeline counts too" "1" \
