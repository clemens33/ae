# Generalized emission-completeness guards — ALL declare-f emissions, not just
# the watchdog (same failure class: a name silently dropped from a declare -f
# list degrades that helper only on the branches that call the missing fn).
# Collect every declare -f list in ae, continuation lines joined.
_emit_lists="$(awk '/^ *declare -f /{l=$0; while (l ~ /\\ *$/) {getline nl; gsub(/\\ *$/,"",l); l=l " " nl}; sub(/^ *declare -f /,"",l); gsub(/  +/," ",l); print l}' <<<"$AE_SOURCE")"
# 1. Every helper-script list ends with its helper_*_main (the call tail's fn
#    must be emitted last, after its support fns). The _lib list carries no
#    helper_* names and is exempt.
_bad_tail=""
while IFS= read -r _el; do
    [[ "$_el" == *helper_* ]] || continue
    [[ "${_el##* }" == helper_*_main ]] || _bad_tail+="${_el##* } "
done <<<"$_emit_lists"
assert_eq "emissions: every helper declare -f list ends with its main fn" "" "$_bad_tail"
# 2. Every emitted name (any list, _lib included) has exactly one top-level
#    definition — emitted-but-undefined would emit nothing at generation time.
_bad_def=""
while IFS= read -r _en; do
    [[ -n "$_en" ]] || continue
    _c="$(grep -c "^${_en}() {" <<<"$AE_SOURCE")"
    [[ "$_c" == "1" ]] || _bad_def+="${_en}=${_c} "
done < <(tr ' ' '\n' <<<"$_emit_lists" | sort -u)
assert_eq "emissions: every emitted fn has exactly one top-level definition" "" "$_bad_def"
# 3. Parity: the set of helper_* fns DEFINED in the template library must
#    equal the union of helper_* names EMITTED — nothing defined-but-orphaned,
#    nothing emitted-but-missing.
_sec_helpers="$(grep -oE '^helper_[a-z0-9_]+\(\) \{' <<<"$AE_SOURCE" | sed 's/() {//' | sort -u)"
_emit_helpers="$(tr ' ' '\n' <<<"$_emit_lists" | grep '^helper_' | sort -u)"
assert_eq "emissions: template helper_* set == emitted helper_* set" \
    "$_sec_helpers" "$_emit_helpers"


