assert_eq "transfer-orch: rsync invoked for codex conversation file" "1" "$_orch_codex_rsync_seen"

# Every rsync call must include --protect-args (codex IMPORTANT 3 runtime check).
_orch_all_have_protect=1
for entry in "${ORCH_CALL_LOG[@]}"; do
    [[ "$entry" == "rsync: "* ]] || continue
    [[ "$entry" == *"--protect-args"* ]] || { _orch_all_have_protect=0; break; }
done
assert_eq "transfer-orch: every rsync invocation includes --protect-args at runtime" "1" "$_orch_all_have_protect"

# Event-emit was called after the rsync invocations.
_orch_event_idx=-1 _orch_last_rsync_idx=-1
for i in "${!ORCH_CALL_LOG[@]}"; do
    entry="${ORCH_CALL_LOG[$i]}"
    [[ "$entry" == "emit-event: "* ]] && _orch_event_idx=$i
    [[ "$entry" == "rsync: "* ]] && _orch_last_rsync_idx=$i
done
assert_eq "transfer-orch: event-emit on destination follows all rsync invocations at runtime" "1" \
    "$([[ "$_orch_event_idx" -gt "$_orch_last_rsync_idx" ]] && echo 1 || echo 0)"

# Path-with-spaces variant: work_dir contains a space → cmd_transfer must complete
# AND the captured stdin script must contain the work_dir with proper bash quoting.
_orch_workdir_with_space="$_orch_home/projects/has space/bar"
mkdir -p "$_orch_workdir_with_space"
sed -i "s|work_dir=.*|work_dir=$_orch_workdir_with_space|" "$_orch_home/.ae/sessions/$_orch_session/meta"
ORCH_CALL_LOG=()
_orch_rc=0
HOME="$_orch_home"
cmd_transfer "$_orch_session" fake-target --yes >/dev/null 2>&1 || _orch_rc=$?
HOME="$_orch_real_home"
assert_eq "transfer-orch: workdir with spaces does not crash the pipeline" "0" "$_orch_rc"
# And the rsync calls in the spaces-variant run also include --protect-args.
_orch_all_have_protect=1
for entry in "${ORCH_CALL_LOG[@]}"; do
    [[ "$entry" == "rsync: "* ]] || continue
    [[ "$entry" == *"--protect-args"* ]] || { _orch_all_have_protect=0; break; }
done
assert_eq "transfer-orch: spaces-variant — rsync still uses --protect-args" "1" "$_orch_all_have_protect"
# CRITICAL: the path-with-spaces value must be bash-quoted into the stdin
# script so the remote bash recovers the original string with the space intact.
# We verify by running the captured `work_dir=...` assignment through a fresh
# bash interpreter and checking the resulting expansion matches the original.
_orch_path_check_seen=0
for entry in "${ORCH_CALL_LOG[@]}"; do
    [[ "$entry" == "check-path: "* ]] && _orch_path_check_seen=1
