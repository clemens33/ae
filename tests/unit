    "$(_quiet_pane_decision "hashB" "$KEY1" "hashA" "$KEY2")"
# Armed for this declaration AND pane matches baseline → hold (suppress nudge).
assert_eq "quiet_decision: pane unchanged since baseline holds" "hold" \
    "$(_quiet_pane_decision "hashB" "$KEY1" "hashB" "$KEY1")"
