    "$([[ "$result" == *"memo add [--topic <topic>]"* ]] && echo 1 || echo 0)"

assert_eq "ae_context: contains peek helper" \
    "1" \
    "$([[ "$result" == *"peek <agent>"* && "$result" == *"peak"* ]] && echo 1 || echo 0)"

assert_eq "ae_context: helpers are invoked by absolute path (\$meta_dir/<name>)" \
    "1" \
    "$([[ "$result" == *"/tmp/ae-test/send"* && "$result" == *"/tmp/ae-test/ask"* && "$result" == *"/tmp/ae-test/mark-done"* ]] && echo 1 || echo 0)"

