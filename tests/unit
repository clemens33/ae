rm -rf "$_van_meta"
unset _van_msg _van_ctx _van_prof_ctx _van_spawn_out _van_spawn_rc

# ── #59 C3-1/C4-1: name dedup — RETIRED with identity v2 ─────────────────────
# v2 rule: a name taking two seats is REFUSED by the core's roster pass (the
