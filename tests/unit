# not as a fragment. This one is CHARACTER-COUNTING dependent: under LC_ALL=C the
# cap is 200 BYTES, the em-dash sits past it, and its absence is correct rather
# than a bug. Assert it in a shell whose locale we chose, not the ambient one.
_cap_utf8_locale="$(locale -a 2>/dev/null | grep -iE '^(en_US\.)?(utf-?8|UTF-?8)$|^en_US\.UTF-8$' | head -1)"
[[ -n "$_cap_utf8_locale" ]] || _cap_utf8_locale="en_US.UTF-8"
assert_eq "cap_summary: under a UTF-8 locale a character before the cut is kept intact" "1" \
    "$(LC_ALL="$_cap_utf8_locale" "${BASH:-bash}" -c '
        source "$1"
        em=$'"'"'\xe2\x80\x94'"'"'
        ae_cap_summary "$(printf "%197s" "" | tr " " "x")${em}tail" 200
