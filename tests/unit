# Persisted intent (codex IMPORTANT #4): persist must be SECTION-SCOPED.
# `ae telegram stop` writes enabled=false via _telegram_persist_intent and
# does not require a token, so it's the cleanest behavioral driver. We run
# it against crafted configs covering the edge cases codex flagged.
_t_persist_run() {  # <config-content> -> prints resulting config
    local _cfg; _cfg="$(mktemp)"
    printf '%s' "$1" >"$_cfg"
    CONFIG_FILE="$_cfg" XDG_RUNTIME_DIR="$(mktemp -d)" \
        "$AE_BIN" telegram stop >/dev/null 2>&1 || true
    cat "$_cfg"
    rm -f "$_cfg"
}

