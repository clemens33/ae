# Behavioral: a stubbed unreachable socket sets _SWEEP_UNSURE in THIS shell.
_swp() {
    local mode="$1"
    # shellcheck disable=SC2317
    command() { # intercept `command tmux -S ...`
        if [[ "$mode" == unreachable ]]; then
            printf 'error connecting to /tmp/x (Permission denied)\n'; return 1
        fi
        printf 'other\n'; return 0
    }
    TMUX_TMPDIR="$_swp_dir_parent" _end_sweep_servers ghost
    printf '%s|%s' "$_SWEEP_FOUND" "$_SWEEP_UNSURE"
    unset -f command
    return 0
}
_swp_dir_parent="$(mktemp -d)"; mkdir -p "$_swp_dir_parent/tmux-$(id -u)"
: > "$_swp_dir_parent/tmux-$(id -u)/sockA"  # plain file, not a socket → skipped
python3 - "$_swp_dir_parent/tmux-$(id -u)/sockB" <<'PYEOF' 2>/dev/null || true
import socket, sys
s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1])
PYEOF
assert_eq "sweep (10th B1): unverifiable enumerable socket lands in _SWEEP_UNSURE (this shell)" "|sockB" \
    "$(_swp unreachable)"
rm -rf "$_swp_dir_parent"
