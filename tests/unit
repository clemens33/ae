assert_eq "tmux_attach mutation control: bare exec tmux makes structure and argv checks RED" \
    "RED|RED" "$_ta_mutation_structural|$_ta_mutation_behavior"
_ta_stale_nested_body="$(printf '%s\n' "$_tmux_attach_body" | sed 's/^        if \[\[ "\$_current_pane_match" == 1 && -n "\$_current_sock" && -n "\$_target_sock" && "\$_current_sock" != "\$_target_sock" \]\]; then$/        if [[ -n "\$_current_sock" \&\& -n "\$_target_sock" \&\& "\$_current_sock" != "\$_target_sock" ]]; then/')"
_ta_nested_mutation="$(
    export PATH="$_ta_bin:$PATH" AE_TA_LOG="$_ta_dir/argv"
    export AE_TMUX_SERVER=other AE_TMUX_SERVER_KIND=name TMUX_TMPDIR="$_ta_dir"
    unset AE_TA_CURRENT_PANES
    export AE_TA_PREDICATE_PANES=/dev/ttys040
    TMUX="$_ta_dir/tmux-$(id -u)/foreign,123,0"
    export TMUX
    : >"$_ta_dir/argv"
    unset _AE_INSIDE_TMUX
    (
        eval "$_ta_stale_nested_body"
        # shellcheck disable=SC2317,SC2329
        ps() { printf 'ttys999\n'; }
        # shellcheck disable=SC2317,SC2329
        tmux() {
            case "$*" in
                *list-panes*) printf '/dev/ttys039\n' ;;
