# ── _start_session_watchdog: the single watchdog-ownership decision ──────────
# The plan's no-double-run non-negotiable, made structural — and now trivially
# true, because exactly ONE watchdog implementation is left. The aewatch sidecar
# is retired (RR P4): a running one claims the bridge-owner marker and kills
# competing bridges on every tmux server, the Rust one included, and updated
# bytes on disk do not help a process already running. So AE_WATCHDOG_IMPL no
# longer SELECTS anything here — enabled starts the bash per-session watchdog
# whatever it says, disabled starts none. Driven behaviorally: a fake
# ${AE_META}/watchdog executable records a bash start, and the retired hook is
# still stubbed as a TRIPWIRE — if anyone re-wires it, `uv` records "aewatch"
# and the second assertion below goes red.
eval "$(awk '/^_start_session_watchdog\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
assert_eq "watchdog-decision: _start_session_watchdog defined" "yes" "$(declare -F _start_session_watchdog >/dev/null && echo yes || echo no)"
_sw_run() {  # <impl> <enabled> -> "bash" | "aewatch" | "none"
    local impl="$1" enabled="$2" d
    d="$(mktemp -d)"
    mkdir -p "$d/meta"
    printf '#!/usr/bin/env bash\necho bash >>"%s/rec"\n' "$d" >"$d/meta/watchdog"
    chmod +x "$d/meta/watchdog"
    : >"$d/rec"
    # shellcheck disable=SC2317,SC2329  # tripwire: nothing may reach this any more
    _aewatch_autostart_if_available() { echo aewatch >>"$d/rec"; }
    AE_META="$d/meta" AE_WATCHDOG_IMPL="$impl" _start_session_watchdog "$enabled"
    if [[ -s "$d/rec" ]]; then cat "$d/rec"; else echo none; fi
    rm -rf "$d"
}
assert_eq "watchdog-decision: default+enabled -> bash" "bash" "$(_sw_run '' true)"
assert_eq "watchdog-decision: uv+enabled -> BASH too (aewatch retired, not selectable)" "bash" "$(_sw_run uv true)"
assert_eq "watchdog-decision: explicit bash -> bash" "bash" "$(_sw_run bash true)"
assert_eq "watchdog-decision: invalid impl -> bash" "bash" "$(_sw_run xyz true)"
assert_eq "watchdog-decision: disabled+uv -> NEITHER" "none" "$(_sw_run uv false)"
assert_eq "watchdog-decision: disabled+default -> NEITHER" "none" "$(_sw_run '' false)"

