# THEIR characters while a UTF-8 byte walk-back reasons about something else.
# Measured, not assumed: before the fix, LC_ALL=ja_JP.SJIS at offset 199 emitted
# a tail of 78 78 e2 80 — a partial em-dash escaping into events.jsonl.
#
# The check is on the OUTPUT BYTES via od. A `case` glob evaluated INSIDE the
# locale under test is not reliable — that is what hid this the first time.
# The probe runs from a FILE, not an inline -c string. The inline form needed
# three levels of quote nesting to carry a $'\xe2\x80\x94' literal into a child
# shell, and it silently produced an empty result instead of a partial — a
# locale matrix that could not fail. A file has one level of quoting.
_cap_probe="$(mktemp)"
cat >"$_cap_probe" <<'CAPPROBE'
#!/usr/bin/env bash
# argv: <fn-file> <offset>   prints the last 6 hex digits of the capped output
source "$1"
em=$'\xe2\x80\x94'
pad="$(printf "%$2s" "" | tr ' ' 'x')"
ae_cap_summary "${pad}${em}tail" 200
printf '%s' "$_EV_SUMMARY" | od -An -tx1 | tr -d ' \n' | tail -c 6
CAPPROBE
chmod +x "$_cap_probe"

_cap_locale_bad=""
_cap_probe_out=""
# Availability is read ONCE into a variable, and matched with a herestring.
# `locale -a | grep -q` looks obvious and is wrong under `set -o pipefail`:
# grep -q exits at the first match, locale takes SIGPIPE, and the PIPELINE
# reports failure — so a locale that IS present tested as absent and every
# probe was skipped. The matrix then reported "no partials" having measured
# nothing.
_cap_locales_avail="$(locale -a 2>/dev/null || true)"
for _cl in en_US.UTF-8 C ja_JP.SJIS zh_CN.GB18030 ko_KR.eucKR; do
    if [[ "$_cl" != "C" ]] && ! grep -qxiF "$_cl" <<<"$_cap_locales_avail"; then
        _cap_skipped+="$_cl "
        continue
    fi
    for _co in 197 198 199 200; do
        _cap_tail="$(LC_ALL="$_cl" "${BASH:-bash}" "$_cap_probe" "$_cap_fn_file" "$_co" 2>/dev/null || true)"
        _cap_probe_out+="${_cl}@${_co}=${_cap_tail} "
        # A partial em-dash ends the output with e280, or with a bare e2.
        case "$_cap_tail" in
            *e280 | *e2) _cap_locale_bad+="${_cl}@${_co}(${_cap_tail}) " ;;
        esac
    done
done
rm -f "$_cap_probe"
# A matrix that produced no output would report "no partials" forever. Count the
# probes that actually returned something; the raw results ride along so a
# failure says WHAT was measured, not just that something was wrong.
_cap_probe_ran="$(printf '%s' "$_cap_probe_out" | tr ' ' '\n' | grep -c '=[0-9a-f]' || true)"
assert_eq "cap_summary: the locale matrix actually ran" "1" \
    "$([[ "${_cap_probe_ran:-0}" -ge 8 ]] && echo 1 || echo 0)"
assert_eq "cap_summary: no locale leaks a partial sequence" "" "$_cap_locale_bad"
