# _event_json_str returns through the global _EV, not stdout (the fork it used
# to cost per call was ~60x the extraction itself). This shim is the ONLY place
# the calling convention is spelled out, so the assertions stay readable.
_ejs() {
    _event_json_str "$1" "$2"
    printf '%s' "$_EV"
}

# _event_json_str: extract simple string field
assert_eq "event_json_str: extract action" "done" \
    "$(_ejs '{"ts":"2026-01-01T00:00:00Z","actor":"claude:lead","action":"done","target":""}' action)"

assert_eq "event_json_str: extract actor" "claude:lead" \
    "$(_ejs '{"ts":"2026-01-01T00:00:00Z","actor":"claude:lead","action":"done","target":""}' actor)"

assert_eq "event_json_str: missing field returns empty" "" \
    "$(_ejs '{"ts":"2026-01-01T00:00:00Z","actor":"claude:lead","action":"done"}' summary)"

assert_eq "event_json_str: escaped quote in summary" 'hello "world"' \
    "$(_ejs '{"actor":"x","summary":"hello \"world\""}' summary)"

assert_eq "event_json_str: escaped backslash in summary" 'a\b' \
    "$(_ejs '{"actor":"x","summary":"a\\b"}' summary)"

# ---- fast path vs escape path -------------------------------------------
# The extractor now short-circuits values with no backslash to a single
# parameter expansion. The two paths must agree everywhere, and above all the
# fast path must NOT be taken when an escaped quote hides the real terminator:
# a naive "${rest%%\"*}" would truncate `a\"b` to `a\`.
assert_eq "event_json_str: escaped quote does NOT take the fast path" 'a"b' \
    "$(_ejs '{"summary":"a\"b","actor":"x"}' summary)"

assert_eq "event_json_str: value ending in an escaped quote" 'say "hi"' \
    "$(_ejs '{"summary":"say \"hi\"","actor":"x"}' summary)"

assert_eq "event_json_str: empty value" "" \
    "$(_ejs '{"summary":"","actor":"x"}' summary)"

assert_eq "event_json_str: unescaped value keeps every inner character" \
    'a b/c-d.e:f,g' \
    "$(_ejs '{"summary":"a b/c-d.e:f,g","actor":"x"}' summary)"

assert_eq "event_json_str: escaped newline becomes a space" 'a b' \
    "$(_ejs '{"summary":"a\nb","actor":"x"}' summary)"

assert_eq "event_json_str: escaped tab becomes a space" 'a b' \
    "$(_ejs '{"summary":"a\tb","actor":"x"}' summary)"

assert_eq "event_json_str: escaped CR is dropped" 'ab' \
    "$(_ejs '{"summary":"a\rb","actor":"x"}' summary)"

# Last field in the object — no trailing comma/quote to lean on.
assert_eq "event_json_str: value is the final field" 'tail-value' \
    "$(_ejs '{"actor":"x","summary":"tail-value"}' summary)"

# A backslash LATER in the line must not drag an earlier clean value onto the
# slow path with a different answer — both paths must produce the same string.
assert_eq "event_json_str: clean value preceding an escaped one" 'plain' \
    "$(_ejs '{"actor":"plain","summary":"esc \"q\""}' actor)"

