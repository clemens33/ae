# ── requests helper: pending/replied logic from events.jsonl ─────────

# Run the generated 'requests' helper script against a synthetic events.jsonl.
# This validates the actor/target-match invariant that distinguishes a real
# reply from a stray reply event sharing the same ref.
_req_helper_dir="$(mktemp -d)"
cat >"$_req_helper_dir/meta" <<META
session=req-test
tmux_server=
META

# Extract a named heredoc body from ae into a target file (bash + awk only —
# the project's "no deps" rule applies to the test suite too).
_extract_heredoc() {
    local src="$1" eof="$2" out="$3"
    awk -v eof="$eof" -v outfile="$out" '
        $0 ~ ("<<\047" eof "\047") { inside=1; next }
        inside && $0 == eof { exit }
        inside { print > outfile }
    ' "$src"
}
_extract_heredoc "$(dirname "$0")/../ae" LIBEOF "$_req_helper_dir/_lib"
_extract_heredoc "$(dirname "$0")/../ae" REQUESTSEOF "$_req_helper_dir/requests"
chmod +x "$_req_helper_dir/_lib" "$_req_helper_dir/requests"

# Replied case: reply actor=target, reply target=sender → status=replied
cat >"$_req_helper_dir/events.jsonl" <<'EVENTS'
{"ts":"2026-01-01T00:00:00Z","actor":"claude:lead","action":"ask","target":"codex:helper","ref":"ae-001","summary":"do thing"}
{"ts":"2026-01-01T00:01:00Z","actor":"codex:helper","action":"reply","target":"claude:lead","ref":"ae-001","summary":"done"}
EVENTS
_req_out="$(bash "$_req_helper_dir/requests" all 2>/dev/null || true)"
assert_eq "requests: matching reply marks request replied" "1" \
    "$([[ "$_req_out" == *"replied"*"ae-001"* ]] && echo 1 || echo 0)"

