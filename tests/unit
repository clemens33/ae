    "$([[ "$_orch_mkdir_idx" -ge 0 && "$_orch_rsync_ae_idx" -ge 0 && "$_orch_mkdir_idx" -lt "$_orch_rsync_ae_idx" ]] && echo 1 || echo 0)"

# SSH-quoting regression (real VM bug, this session): the mkdir stdin script
# must contain a %q-quoted session assignment (the literal session value or
# a bash-quoted form), NOT a positional-arg placeholder.
_orch_session_in_stdin=0
for entry in "${ORCH_CALL_LOG[@]}"; do
    [[ "$entry" == "ssh-stdin: "*"session=$_orch_session"* ]] && _orch_session_in_stdin=1
