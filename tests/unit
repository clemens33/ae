assert_eq "tmux_attach mutation control: dropping tty proof makes stale case RED" \
    "RED" "$_ta_nested_mutation"
_ta_return_mutated_body="$(printf '%s\n' "$_tmux_attach_body" | sed 's/^            exit 0$/            return 0/')"
_ta_return_mutation="$(
