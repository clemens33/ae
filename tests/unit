    "env -u CLAUDECODE -u CLAUDE_CODE_SESSION claude --model opus --resume abc-123 || env -u CLAUDECODE -u CLAUDE_CODE_SESSION claude --model opus --continue" \
    "$(build_launch_command "claude --model opus --resume abc-123" "")"

assert_eq "launch: prompt is shell-quoted once" \
    "env -u CLAUDECODE -u CLAUDE_CODE_SESSION claude --model opus don\\'t\\ break" \
    "$(build_launch_command "claude --model opus" "don't break")"

assert_eq "launch: codex resume keeps fresh-start fallback" \
    "codex --yolo resume abc-123 || codex --yolo" \
    "$(build_launch_command "codex --yolo resume abc-123" "Go")"

