assert_eq "tg-log: single EXIT handler records exit rc (merged, not clobbered)" "1" \
    "$([[ "$AE_SOURCE" == *'daemon_on_exit() {'* && "$AE_SOURCE" == *'local rc=$?'* && "$AE_SOURCE" == *'daemon exiting (rc=$rc, signal=$_DAEMON_EXIT_SIGNAL)'* && "$AE_SOURCE" == *'trap daemon_on_exit EXIT'* ]] && echo 1 || echo 0)"

# Death-cause instrumentation: main() is an infinite loop, so any exit is
