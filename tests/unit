_calver_replace_badge_line() {
    local file="$1" pre_pattern="$2" prior_pattern="$3" post_line="$4" source_pattern
    if grep -Eq "$pre_pattern" "$file"; then
        source_pattern="$pre_pattern"
    elif grep -Eq "$prior_pattern" "$file"; then
        source_pattern="$prior_pattern"
    else
        printf 'no known pre-release or prior-release badge line: %s\n' "$file" >&2
        return 1
    fi
    sed -E -e "s@${source_pattern}@${post_line}@" "$file" >"$file.next" && mv "$file.next" "$file" || return 1
    if ! grep -Fxq "$post_line" "$file"; then
        printf 'did not become expected release badge line: %s\n' "$file" >&2
        return 1
    fi
}
