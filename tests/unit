assert_eq "portability guard fires: 'mystat -f' is not a fallback" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$f" || mystat -f %m "$f")"')"
assert_eq "portability guard fires: stat -c with no fallback at all" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$f")"')"
# ...and the marker is what exempts now, per line, with a stated reason.
assert_eq "portability guard quiet: a port-ok marked line is exempt" "" \
    "$(_port_mutation 'm="$(stat -c %y "$f" || stat -f %Sm "$f")" # port-ok: remote-host — no shim across ssh')"

# ── command-token boundary: suffix-named commands are not the command ──
# An identifier boundary treats `-` and `.` as separators, so each of these
# matched the real command name inside a LONGER one.
assert_eq "portability guard quiet: iso-date -d (suffix-named command)" "" \
    "$(_port_mutation 'iso-date -d "$x"')"
assert_eq "portability guard quiet: not.date -d (dot-separated name)" "" \
    "$(_port_mutation 'not.date -d "$x"')"
assert_eq "portability guard quiet: unused-sed -i (suffix-named command)" "" \
