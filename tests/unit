eval "$(awk '/^_valid_slot\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^_stamp_live_slots\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_sls_tmp="$(mktemp -d)"
_sls_run() {  # emits "PANE SLOT" per stamped pane
    local metafile="$_sls_tmp/meta"
    cat >"$metafile" <<'META'
tmux_server=
agent.main=claude:lead:uuidm
agent.worker.0=optimal:builder:uuidw
agent.spawned.1=codex:helper:uuids
META
    # shellcheck disable=SC2317  # invoked indirectly by _stamp_live_slots
    tmux() {
