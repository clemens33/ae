# an earlier round asserted the stderr strings EXISTED, which was true, while control
# fell through to the positive line, a task-bearing action=spawn event and rc=0. Only a
# caller probe sees that, so this block drove the real `_cmd_spawn` with stubbed TUI
# states and counted actual pastes and events.
#
# B move 2 took the whole operation to the core, and took the finding with it: the
# module states the rule in its own header — pane-created and brief-delivered are
# DIFFERENT TRUTHS, and conflating them is how a delivery failure became a success at
# the caller — and it records `spawn` only on delivery, `spawn-failed` otherwise, with
# the exit code and the event log agreeing with reality. Its suite drives that the same
# way, on the ported readiness gate; end to end it is the integration spawn-retire
# domain, which asserts on the events a real spawn leaves behind.
#
# What did NOT move is the equivalent duty on the LAUNCH delivery, and that is pinned
# above against _deliver_launch_prompt: no paste without confirmed readiness, a
# captured status, a loud failure and the text preserved.

# ── consumer 2: _paste_input_busy (pre-paste) — IDLE=safe, OCCUPIED/INDETERMINATE=unsafe ──
_pib() { # <tool> <region-printf_b> -> safe|unsafe
    local _R
    _R="$(printf '%b' "$2")"
    # shellcheck disable=SC2317,SC2329
    _capture_input_region() { printf '%s' "$_R"; }
    _paste_input_busy "%1" "$1" && echo unsafe || echo safe
}
assert_eq "input-busy: codex empty placeholder -> safe (idle)" "safe" "$(_pib codex '\033[1m›\033[0m \033[2mExplain this codebase\033[0m')"
assert_eq "input-busy: codex typed -> unsafe (protect human input)" "unsafe" "$(_pib codex '\033[1m›\033[0m human draft')"
assert_eq "input-busy: codex staged paste -> unsafe" "unsafe" "$(_pib codex '\033[1m›\033[0m [Pasted Content 1469 chars]')"
assert_eq "input-busy: codex mid-gen (no live prompt) -> unsafe (fail-closed)" "unsafe" "$(_pib codex '─ Worked for 2m 45s ─')"
assert_eq "input-busy: codex unreadable -> unsafe (fail-closed)" "unsafe" "$(_pib codex '')"
assert_eq "input-busy: claude empty ornament -> safe (idle)" "safe" "$(_pib claude '❯\xc2\xa0')"
