# The `default_session_name` contract pins (hostile working directories all yield
# a name the validator accepts; a deep path caps its BODY and keeps its hash) went
# with the function: the core derives a launch's name when none is typed, and
# proves that contract in src/session_launch/name.rs.
unset _dsn_root

# ── MIGRATION: legacy names stay usable as SOURCES, never as traversal ───
_snu_root="$(mktemp -d)"
_snu_outside="$(mktemp -d)"
mkdir -p "$_snu_root/legacy.name" "$_snu_root/victim"
: >"$_snu_outside/CANARY"
ln -s "$_snu_outside" "$_snu_root/symlinked.name"
assert_eq "usable: grammar ok / PHYSICAL legacy dir ok / traversal, phantom and SYMLINK refused" \
    "OK|OK|NO|NO|NO|NO" \
    "$(SESSIONS_DIR="$_snu_root"
       for _n in 'good-name' 'legacy.name' '../victim' 'a/b' 'never.existed' 'symlinked.name'; do
           if _session_name_usable "$_n" 2>/dev/null; then printf 'OK|'; else printf 'NO|'; fi
       done | sed 's/|$//')"
# `-d` alone accepts a direct-child SYMLINK, and a symlink is an escape wearing a
# compliant name: rsync -a --delete onto it follows the link out of the root.
assert_eq "usable: the existence arm demands a physical directory, not just -d" "1" \
    "$([[ "$AE_SOURCE" == *'[[ -d "${SESSIONS_DIR}/${name}" && ! -L "${SESSIONS_DIR}/${name}" ]]'* ]] && echo 1 || echo 0)"
# ...but that arm is UNREACHABLE for a grammar-valid name, because the function
# returns on a grammar accept. The path question therefore has its own answer,
# asked independently of the name — every specimen below is grammar-VALID, so
# only the path property is under test.
_sp_root="$(mktemp -d)"
_sp_out="$(mktemp -d)"
mkdir -p "$_sp_root/real-dir"
: >"$_sp_out/CANARY"
ln -s "$_sp_out" "$_sp_root/valid-name"
ln -s "$_sp_out/nope" "$_sp_root/dangling-name"
: >"$_sp_root/a-file"
assert_eq "path-safe: physical dir and absent OK; grammatical symlink, dangling symlink, file, escape NOT" \
    "OK|OK|NO|NO|NO|NO" \
    "$( # shellcheck disable=SC2034  # read by the eval'd _session_path_is_safe, which shellcheck cannot see
       SESSIONS_DIR="$_sp_root"
       for _n in 'real-dir' 'absent-name' 'valid-name' 'dangling-name' 'a-file' '../escape'; do
           if _session_path_is_safe "$_n" 2>/dev/null; then printf 'OK|'; else printf 'NO|'; fi
       done | sed 's/|$//')"
# A dangling symlink is NOT -e, so an -e-first test calls it absent. What rsync
# does with one varies by implementation, so the classification does not rest on
# that: a symlink of any kind is unsafe regardless.
assert_eq "path-safe: -L is tested before -e, so a dangling symlink cannot slip past" "1" \
    "$([[ "$AE_SOURCE" == *'[[ -L "$p" ]] && return 1'*'[[ -e "$p" ]] || return 0'* ]] && echo 1 || echo 0)"
# Every existing-session boundary asks the PATH question, not only the name one.
# EIGHT now: launch, transfer, rename source+target, and #33's FOUR stop boundaries
# — the public dispatch (_stop_dispatch, which must validate before self-detection
# because the self branch promises a durable path), the two internal ones
# (_stop_one_session and the directly-callable _stop-supervisor), and round 10's
# _stop_refuse_unidentified, which writes events into a session directory and so
# builds a path from a name like any other. A new entrypoint does not INHERIT a
# boundary — it must ENTER it, and this count is what makes forgetting fail loudly.
# It did exactly that when the eighth arrived.
# Nine since #48: archive preview reads a session directory by name, so it asks the
# same question before touching it — a preview of a symlinked "session" would read
# whatever the link points at.
# Ten since slice 2: `ae compact` resolves a session by name and then ENDS it, which is
# the most consequential consumer yet — a symlinked "session" would be archived and
# deleted through the link.
# TWO since the final glue cut: rename went to the core with doctor, so the two
# rename call sites left with it. What still asks in bash is the pair of entry
# points that resolve a session by name BEFORE the core is handed anything — the
# launch fall-through and `archive preview`. The core owns the name grammar and
# derives an unnamed launch's name, but it does not look at the path OBJECT, so
# the half bash can still answer exactly — a name the caller TYPED — is answered
# here.
assert_eq "path-safe: both surviving boundaries consult it (launch, archive preview)" "2" \
    "$(printf '%s' "$AE_SOURCE" | command grep -c '_require_session_path_safe ' || true)"
# ...and the two stop entrypoints ask BOTH questions, in the right order: before
# any lock, meta or event path is built from the name.
# The stop entrypoints' name+path validation pin went with `_stop`, which is one
# core operation now and refuses an unusable name before it reads anything.
rm -rf "$_sp_root" "$_sp_out"
unset _sp_root _sp_out
# `_canonical_dir` went with the derived-name ownership guard that used it: the
# core compares a derived name's owner against the caller's directory itself.
rm -rf "$_snu_root" "$_snu_outside"
unset _snu_root _snu_outside
# RENAME'S HALF OF THIS WENT TO THE CORE at the final cut (strict on the target,
# migratable on the source, one operation). What the glue still owes is that the
# two predicates stay DISTINCT and that neither has been loosened into the other:
# `_validate_session_name` is the creation grammar, `_session_name_usable` is the
# consume-in-place escape that lets a pre-grammar directory still be addressed.
# Collapsing them is the regression this row now watches for.
assert_eq "boundaries: the strict grammar and the migratable escape are still two predicates" "1" \
    "$([[ "$AE_SOURCE" == *'_validate_session_name() {'* \
        && "$AE_SOURCE" == *'_session_name_usable() {'* \
        && "$AE_SOURCE" != *"cannot contain '/', ':', or '.'"* ]] && echo 1 || echo 0)"

# ── DERIVED NAMES: lossy body, hash over the RAW path — RETIRED (B glue cut 2) ─────────────────────
# 6 assertion(s) went with their subject: the whole launch and resume is ONE core operation now (`_launch`,
# src/session_launch.rs): the argv grammar, the resume decision, the command
# build, the context injection, the launch script and its paste all moved with
# it, and the bash bodies these assertions called are gone.

# ── SPAWN ROLLBACK — the whole operation is the core's ───────────────────
# The rollback used to be bash's: a spawn that failed after reserving its seat
# stripped the slot's meta rows under meta.lock, dropped the launch artifacts and
# killed the pane through the ownership guard. B move 2 took `_spawn` whole, and
# the rollback went with it — there is no `_spawn_rollback` left to hold to the
# locked-rewrite invariant, and the arms that drove it (a sentinel holding
# meta.lock, the byte-identical refusal, the strip-only-my-slot proof) went with
# their subject. The core owns the same order and pins it in its own suite;
# end to end it is the integration spawn-retire domain.

# The launch-script write and its checked assignment are the core's: `_launch` and
# `_spawn` both roll their whole operation back when one cannot be published.

# The bridge: an unusable core or a refused new-session must reach the caller,
# whose "autostart failed" warning was unreachable while a cosmetic `|| true`
# tail forced rc 0. The bash daemon artifact is retired — the spawn now resolves
# the RUST core (operator input, absolute, executable, reports a version) and
# hands tmux DIRECT ARGV.
eval "$(awk '/^(_telegram_spawn_daemon|_telegram_coexistence_guard|_telegram_coexistence_probe|_telegram_coexistence_same_bot|_telegram_coexistence_token|_ae_core_bin_input|_ae_core_current_input|_ae_core_bin_version)\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"

# ── THE CORE COMES FROM TWO SOURCES, IN ONE ORDER ───────────────────────────
# env AE_CORE_BIN -> <AE_HOME>/core/current. The second is what makes an install
# visible to every RE-ENTRY (a helper exec'ing its recorded ae path, the
# watchdog's `telegram _supervise`, compact's child) with no environment to go
# stale. Each case below differs from its neighbour by ONE fact, so a precedence
# that silently collapsed would show up as a wrong answer rather than as a
# still-green suite.
#
# THE CONFIG KEY `workspace.core` WAS RETIRED at the final glue cut. It was the
# only source that could not be answered without an INI parser, and keeping the
# parser in the glue to read one key was the wrong trade. Every fixture below
# still WRITES that key, and that is deliberate: it is the negative control. If
# the reader ever consults the config again, the "not a source" assertions turn
# red instead of the suite staying green on a resolution nobody asked for.
_cc_dir="$(mktemp -d)"
mkdir -p "$_cc_dir/core"
printf '%s\n' '[workspace]' 'core = /from/config' >"$_cc_dir/config"
printf '%s\n' '/from/current' >"$_cc_dir/core/current"
assert_eq "core input: env AE_CORE_BIN outranks core/current" "/from/env" \
    "$(AE_CORE_BIN=/from/env AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
assert_eq "core input: core/current answers when no env is set" "/from/current" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
# Leading/trailing whitespace is the installer's newline and a hand edit's tab —
# trimmed, because a path with a stray space is a path that will not execute.
printf '%s\n' '   /from/current   ' >"$_cc_dir/core/current"
assert_eq "core input: the current line is trimmed" "/from/current" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
# NOT ABSOLUTE = IGNORED, and with the config retired there is nothing under it:
# the answer is a REFUSAL. A relative path would resolve against whatever
# directory the caller happened to be in, and `~` is not expanded by this reader,
# so pinning either would pin a core that cannot be run.
# The tilde is DELIBERATELY unexpanded: this reader refuses a `~` value rather
# than expanding one, so the literal is the fixture.
# shellcheck disable=SC2088
for _cc_bad in 'relative/ae' '~/.ae-next/core/0.0.0/ae' '' '   '; do
    printf '%s\n' "$_cc_bad" >"$_cc_dir/core/current"
    assert_eq "core input: an unusable current ('$_cc_bad') refuses — the config is NOT a source" "1" \
        "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input >/dev/null 2>&1; echo $?)"
done
# A SYMLINK is not a pointer the installer published, and this reader is the one
# RE-ENTRY uses — helpers, the watchdog's supervise, compact's child, a bare `ae`
# with AE_HOME set. None of them pass through the wrapper's own refusal, so the
# check has to be here as well.
rm -f "$_cc_dir/core/current"
# THE LINK MUST POINT AT A READABLE POINTER FILE, or this test cannot fail. A
# DANGLING link is rejected by the `-f` test that follows anyway, so the symlink
# rule would never be the sole decider and dropping it would leave the row green
# — measured, on this very assertion.
printf '%s\n' '/from/the-link-target' >"$_cc_dir/core/real-current"
ln -s "$_cc_dir/core/real-current" "$_cc_dir/core/current"
assert_eq "core input: a SYMLINKED core/current is ignored, not followed" "1" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input >/dev/null 2>&1; echo $?)"
rm -f "$_cc_dir/core/current" "$_cc_dir/core/real-current"
# ABSENCE PIN, and the point of the whole block: a config that names a core, with
# no env and no core/current, resolves to NOTHING. This is the assertion that
# would have to be edited to bring the config back as a source, which is exactly
# the edit that should be hard to make by accident.
assert_eq "core input: a config that names a core is NOT consulted -> rc 1" "1" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input >/dev/null 2>&1; echo $?)"
assert_eq "core input: ...and it prints nothing, so no caller can mistake it for a path" "" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input 2>/dev/null || true)"
# The glue must not READ the config at all on this path. `get_config` still
# exists for the bodies that have not moved yet (doctor's roster, telegram's
# enabled flag), so its mere presence proves nothing — an unreadable config file
# does: resolution still succeeds from core/current with the file unreadable.
printf '%s\n' '/from/current' >"$_cc_dir/core/current"
assert_eq "core input: resolution does not touch the config — an unreadable one is harmless" "/from/current" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/nonexistent-config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
# An unset CONFIG_DIR must not abort under `set -u` — the reader is called from
# paths that run before any session home is derived. With no CONFIG_DIR there is
# no core/current to read, so the answer is a refusal.
assert_eq "core input: an unset CONFIG_DIR is not an error, just no answer" "1" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR='' _ae_core_bin_input >/dev/null 2>&1; echo $?)"
rm -rf "$_cc_dir"
unset _cc_dir _cc_bad

