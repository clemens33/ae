assert_eq "alert_pass: ancient alert under a 200-line quiet tail is still found" "dead" \
    "${_AE_ALERT[claude:old]:-}"
assert_eq "alert_pass: throttle resolved in the same pass" "throttled" \
    "${_AE_ALERT[claude:thr]:-}"
assert_eq "alert_pass: own activity means no alert" "" \
