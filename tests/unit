)"
assert_eq "tmux_attach mutation control: return instead of exit makes continuation RED" \
    "RED" "$([[ "$_ta_return_mutation" == *CONTINUED* ]] && echo RED || echo GREEN)"
rm -rf "$_ta_dir"
unset _tmux_attach_body _ta_dir _ta_bin _ta_hint _ta_foreign_rc _ta_stale_out _ta_mutated_body _ta_mutation_structural _ta_mutation_behavior _ta_stale_nested_body _ta_nested_mutation _ta_return_mutated_body _ta_return_mutation

# ── the forks must not come back ────────────────────────────────────
# Every extraction site was converted to the global-returning form. A single
# reintroduced command substitution silently restores the per-call fork that
# made `ae list` take 3s, and nothing else in the suite would notice.
assert_eq "perf: no command substitution around _event_json_str" "0" \
    "$(grep -c '\$(_event_json_str' <<<"$AE_SOURCE" || true)"

# Meta blobs are read in-shell. The echo-into-sed idiom cost two processes per
# field on a blob already in memory and must not come back.
assert_eq "perf: no echo|sed meta field reads remain" "0" \
    "$(grep -cE 'echo "\$(meta_)?blob" \| sed -n' <<<"$AE_SOURCE" || true)"

# The three rollup perf pins that stood here (caller-supplied pane map, the
# map-less fallback, one `date` per process) went with `_session_attn_rollup`
# itself: A.2c retired the glue's last caller — `cmd_next` — to the core, so
# there is no bash rollup left to keep cheap. The core pays none of those forks
# by construction and pins its own cost in its suite.

# ── goal: session objective (helper + meta + list + nudge) ───────────

# Wiring: helper generated, event emitted, preserved across resume. The list
# rendering of a goal is the core's since A.2a and is pinned in its own suite.
assert_eq "goal: helper script generated + chmod" "1" \
    "$([[ "$AE_SOURCE" == *'declare -f _ae_core_try helper_goal_main'* && "$AE_SOURCE" == *'mv "${AE_META}/goal.tmp.$$" "${AE_META}/goal"'* ]] && echo 1 || echo 0)"
assert_eq "goal: preserved across meta rewrite (resume)" "1" \
    "$([[ "$AE_SOURCE" == *"PRESERVED_GOAL=\"\$(grep '^goal='"* && "$AE_SOURCE" == *'echo "goal=${PRESERVED_GOAL}"'* ]] && echo 1 || echo 0)"

# ── branch side channel: who publishes, who clears ──────────────────
# PUBLICATION is the core's since A.3 (src/watchdog_glue.rs `publish_branch`
# writes the untrimmed @ae_branch_name beside the 24-char display option, and the
# core's suite pins that the display option is never the data source). The glue
# keeps the CLEARING half — one owner enumerating every session option — so that
# is what is pinned here. The stale nudge and its goal quote went with the loop.
assert_eq "branch: the glue clears the branch side channel with the display option" "1" \
    "$([[ "$AE_SOURCE" == *'for _o in @ae_branch_status @ae_branch_name @ae_watchdog_status @ae_agents_status; do'* ]] && echo 1 || echo 0)"
assert_eq "branch: no second publisher survives in the glue" "0" \
    "$(grep -c '_watchdog_set_status @ae_branch' <<<"$AE_SOURCE" || true)"

# Codex IMPORTANT: goal text is stripped of ALL control bytes (ESC/BEL/…), not just
# Codex IMPORTANT: the refresh-path meta writer must hold the same meta.lock as the
# helpers' ae_meta_set — an unlocked read-modify-write could clobber a concurrent
# goal write with stale contents.
assert_eq "meta: set_session_meta_value serializes on meta.lock (refresh vs helper writes)" "1" \
    "$([[ "$AE_SOURCE" == *'set_session_meta_value() {'* && "$AE_SOURCE" == *'} 200>"${meta_file}.lock"'* ]] && echo 1 || echo 0)"

# interrupt joined send in the core at B move 1: the cancel, the optional message and
# the one interrupt event are its, so the glue must hold no writer for it either.
assert_eq "events: the glue holds no interrupt-event writer" "0" \
    "$(grep -c 'ae_emit_event "interrupt"' <<<"$AE_SOURCE" || true)"

assert_eq "events: focus emits event" \
    "1" \
    "$([[ "$AE_SOURCE" == *'ae_emit_event "focus"'* ]] && echo 1 || echo 0)"

# The spawn and retire events are the core's since B move 2, written from the same
# ledger transaction as everything else it records. `_spawn_emit_event` survives as
# the ONE writer for the bash code that runs outside the _lib context — `ae stop`, and
# the launch path's delivery-failure reporter — and the action stays its parameter, so
# those callers cannot drift apart either.
assert_eq "events: one event writer for the code outside _lib, action as a parameter" \
    "1" \
    "$([[ "$AE_SOURCE" == *'_spawn_emit_event() { # <meta_dir> <actor> <target> <action> <summary>'* \
        && "$AE_SOURCE" == *'_spawn_emit_event "$meta_dir" ae "$slot" launch-delivery-failed'* ]] && echo 1 || echo 0)"
assert_eq "events: the glue writes no spawn or retire event of its own" "0" \
    "$(grep -cE '"action":"(retire|spawn)"' <<<"$AE_SOURCE" || true)"

# ── watchdog (watchdog) ───────────────────────────────────────────

# Emission-completeness guards (regression: a surgery-script bug once silently
# dropped fn names from the declare -f list and leaked executable flow into
# top-level ae — the watchdog runs under set -uo pipefail with NO errexit, so
# a missing emitted fn degrades silently at runtime, not loudly).
# 1. The watchdog template-section fn set must EQUAL the emission's declare -f
#    list exactly (helper_watchdog_main included).
_wd_sec="$(awk '/^# — watchdog template functions/{f=1} /^ATTACH_ON_READY=true$/{f=0} f && /^[a-z_]+\(\) \{/{sub(/\(\).*/,""); print}' <<<"$AE_SOURCE" | sort)"
_wd_list="$(awk '/^ *declare -f _ae_core_try _watchdog_is_running/{f=1} f{l=$0; stop=(l !~ /\\ *$/); gsub(/\\ *$/,"",l); sub(/^ *declare -f /,"",l); print l; if (stop) exit}' <<<"$AE_SOURCE" | tr ' ' '\n' | grep -v '^$')"
# A.3: the emission carries EXACTLY the template section plus _ae_core_try, which
# is the one name defined outside it — it has to be, because the section's `_run`
# execs the core through that shim and a generated helper only has what declare -f
# put in it. Stated as an equality against section+shim rather than relaxed to a
# subset, so a name dropped from either side is still caught.
assert_eq "watchdog emission: declare -f list == template-section fn set + the core shim" \
    "$(printf '%s\n%s\n' "_ae_core_try" "$_wd_sec" | sort)" "$(sort <<<"$_wd_list")"
# 2. helper_watchdog_main is emitted LAST (all fns defined before the call tail).
assert_eq "watchdog emission: helper_watchdog_main last in the declare -f list" \
    "helper_watchdog_main" "$(tail -1 <<<"$_wd_list")"
# 3. The whole section must SOURCE silently under set -u in a clean bash:
#    function defs execute without output; any leaked top-level executable
#    (trap/printf/status call — which would run on every ordinary ae
#    invocation) errors on unset vars or prints. Pattern-scanning col-0 can't
#    do this (heredoc/string content inside fn bodies legitimately sits at
#    col-0); bash itself is the oracle.
_tpl_src="$(mktemp)"
awk '/^# ── Session-helper template library/{f=1} /^ATTACH_ON_READY=true$/{f=0} f' <<<"$AE_SOURCE" >"$_tpl_src"
# "${BASH:-bash}", not bare `bash`: on macOS the PATH bash can be /bin/bash 3.2,
# which cannot even PARSE ae's bash-4 syntax — the probe then failed and this
# bare assignment aborted the whole suite under set -e with zero output.
_tpl_out="$("${BASH:-bash}" -c 'set -u; source "$1" && declare -F | wc -l | tr -d "[:space:]"' _ "$_tpl_src" 2>&1)"
if [[ "$_tpl_out" =~ ^[0-9]+$ ]] && ((_tpl_out >= 50)); then _tpl_ok=1; else _tpl_ok="0 (out: $_tpl_out)"; fi
assert_eq "template library: sources silently under set -u (no executable leaks)" \
    "1" "$_tpl_ok"
rm -f "$_tpl_src"

# 4. Referenced-implies-available: every ae top-level function CALLED in the
#    watchdog helper (its emitted fns' bodies) must be AVAILABLE to the generated
#    helper — in the watchdog declare-f list OR the _lib declare-f list. The
#    existing guards check emitted names are DEFINED, but NOT that referenced names
#    are AVAILABLE — the cross-section gap that made _agent_alert_reason a silent
#    runtime no-op (watchdog called it; neither the watchdog list nor _lib emitted
#    it). This catches that whole class.
_lib_list="$(awk '/^ *declare -f ae_resolve /{f=1} f{l=$0; stop=(l !~ /\\ *$/); gsub(/\\ *$/,"",l); sub(/^ *declare -f /,"",l); print l; if (stop) exit}' <<<"$AE_SOURCE" | tr ' ' '\n')"
_wd_avail="$(printf '%s\n%s\n' "$_wd_list" "$_lib_list" | grep -v '^$' | sort -u)"
_ae_fns="$(grep -oE '^[a-z_][a-z0-9_]*\(\)' <<<"$AE_SOURCE" | sed 's/()//' | sort -u)"
# Emitted watchdog fn bodies, full-line comments stripped (a fn name in prose must
# not read as a call).
_wd_bodies="$(while IFS= read -r fn; do [[ -n "$fn" ]] || continue
    awk "/^${fn}\\(\\) \\{/,/^\\}\$/" <<<"$AE_SOURCE"; done <<<"$_wd_list" | grep -vE '^[[:space:]]*#')"
_wd_missing=""
while IFS= read -r fn; do
    [[ -n "$fn" ]] || continue
    # Called in command position (start / space / ; & | ( / $( ; then a word break).
    if grep -qE "(^|[ \t;&|(]|\\\$\()${fn}([ \t;)&|]|\$)" <<<"$_wd_bodies"; then
        grep -qxF "$fn" <<<"$_wd_avail" || _wd_missing+="$fn "
    fi
done <<<"$_ae_fns"
assert_eq "watchdog emission: every referenced ae fn is available (emitted or in _lib)" \
    "" "$_wd_missing"

# The bash>=4 fail-fast must sit at the very top of ae, BEFORE any function
# definition — bash parses fn bodies at definition time, so on 3.2 a later
# guard never runs (the parser dies on bash-4 syntax first). Head = 1200 chars.
# Spawn prompt delivery: TUI-readiness poll before the paste (process-started
# is not input-ready; a paste in the boot gap is swallowed wholesale). MODELED tools go
# through the structural predicate — the marker grep survives only for unmodeled TUIs,
# which have no predicate; the readiness BEHAVIOUR is proved by the _cmd_spawn caller
# probe, not by this source match.
# (#36 extracted the poll loop into _wait_input_ready so the launch path could share
# it; the fact pinned is unchanged — spawn waits for readiness before it pastes.)
assert_eq "launch: polls for TUI readiness before pasting the prompt" "1" \
    "$(_lr="$(awk '/^_deliver_launch_prompt\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
       _rdy="$(command grep -n '_wait_input_ready "\$pane" "\$tool_kind" 90' <<<"$_lr" | head -1 | cut -d: -f1)"
       _pst="$(command grep -n 'tmux_paste_submit "\$pane" "\$prompt"' <<<"$_lr" | head -1 | cut -d: -f1)"
       [[ -n "$_rdy" && -n "$_pst" && "$_rdy" -lt "$_pst" ]] && echo 1 || echo 0)"

# ── orchestrator companion autostart ─────────────────────────────────────

assert_eq "autostart: orchestrator companion fn exists with all four guards" "1" \
    "$([[ "$AE_SOURCE" == *'_orchestrator_autostart_if_scaffolded() {'* && "$AE_SOURCE" == *'AE_NO_AUTOSTART'* && "$AE_SOURCE" == *'orchestrator | hub) return 0'* && "$AE_SOURCE" == *'daemon_session_running orchestrator || _st_rc=$?'* ]] && echo 1 || echo 0)"

# ── daemon_session_running: error is not absence (#28) ───────────────
if _unit_slow 'daemon_session_running: live process probes'; then
# The old body was `tmux list-sessions 2>/dev/null | grep -Fxq`, so ANY tmux
# failure came back as a plain false. One transient client error then read as
# "no orchestrator running" and fired an autostart whose backgrounded duplicate died
# silently. Tri-state now: 0 running / 1 verifiably absent / 2 unknown.
# ABSENCE IS PROVEN, NEVER INFERRED. The classifier is the SHARED
# _tmux_err_is_clean_dead (stale socket only) — see its own assertions below for
# the anchoring and the adversarial socket name. It deliberately refuses ENOENT,
# and that refusal matters more here than at its original call sites: there,
# reading an unlinked-but-LIVE server as dead deletes state; here it would
# create a SECOND SERVER on that socket path, and the two never see each other.
# shellcheck disable=SC2317,SC2329
_dsr_tmux_ok() { tmux() { printf 'aedev\norchestrator\norchestrator-old\n'; }; }
assert_eq "dsr: running session -> 0" "0" \
    "$(_dsr_tmux_ok; daemon_session_running orchestrator; echo $?)"
assert_eq "dsr: exact match only (prefix must not count)" "1" \
    "$(_dsr_tmux_ok; daemon_session_running stew; echo $?)"
assert_eq "dsr: successful listing without the name -> absent" "1" \
    "$(_dsr_tmux_ok; daemon_session_running hub; echo $?)"
# shellcheck disable=SC2329  # tmux() is a double; daemon_session_running calls it inside this $( )
assert_eq "dsr: server exited cleanly (stale socket) -> absent, autostart may proceed" "1" \
    "$(tmux() { echo 'no server running on /tmp/tmux-501/default' >&2; return 1; }; daemon_session_running orchestrator; echo $?)"
# THE LIVE-UNLINKED CASE (round-2 BLOCKER). Unlinking a running server's socket
# yields ENOENT while the server and its sessions keep running. Treating that as
# absence is what starts a second server — so it is UNKNOWN, and nothing fires.
# shellcheck disable=SC2329  # tmux() is a double; daemon_session_running calls it inside this $( )
assert_eq "dsr: ENOENT is UNKNOWN, not absence (unlinked LIVE server)" "2" \
    "$(tmux() { echo 'error connecting to /tmp/tmux-501/default (No such file or directory)' >&2; return 1; }; daemon_session_running orchestrator; echo $?)"
# shellcheck disable=SC2329  # tmux() is a double; daemon_session_running calls it inside this $( )
assert_eq "dsr: permission error -> UNKNOWN" "2" \
    "$(tmux() { echo 'error connecting to /tmp/tmux-501/default (Permission denied)' >&2; return 1; }; daemon_session_running orchestrator; echo $?)"
# shellcheck disable=SC2329  # tmux() is a double; daemon_session_running calls it inside this $( )
assert_eq "dsr: tmux failed for any other reason -> UNKNOWN, not absent" "2" \
    "$(tmux() { echo 'lost server' >&2; return 1; }; daemon_session_running orchestrator; echo $?)"
# ...and the consequence, end to end: an unlinked LIVE server must not produce a
# second one. (The orchestrator caller's own note is asserted further down.)
# shellcheck disable=SC2329  # tmux() is a double; daemon_session_running calls it inside this $( )
assert_eq "dsr: ENOENT never reaches the create path" "no-launch" \
    "$(tmux() { echo 'error connecting to /tmp/tmux-501/default (No such file or directory)' >&2; return 1; }
       _rc=0; daemon_session_running orchestrator || _rc=$?
       if ((_rc == 1)); then echo "WOULD-LAUNCH"; else echo "no-launch"; fi)"
# One immediate retry (no sleep — the observed failure is first-call-only, and a
# delay would tax the launch path on every genuinely broken tmux).
# The counter lives in a FILE: each `$(tmux …)` inside daemon_session_running is
# its own subshell, so a shell variable would reset between the two attempts and
# the test would prove nothing.
_dsr_ctr="$(mktemp)"
# shellcheck disable=SC2329  # tmux() is a double; daemon_session_running calls it inside this $( )
assert_eq "dsr: retries once, so a first-call-only failure still answers" "0" \
    "$(tmux() {
           printf 'x' >>"$_dsr_ctr"
           if [[ "$(<"$_dsr_ctr")" == 'x' ]]; then
               echo 'lost server' >&2
               return 1
           fi
           printf 'orchestrator\n'
       }
       daemon_session_running orchestrator
       echo $?)"
assert_eq "dsr: ...and that took exactly two tmux calls" "2" \
    "$(_c="$(<"$_dsr_ctr")"; echo "${#_c}")"
rm -f "$_dsr_ctr"
unset _dsr_ctr
unset -f _dsr_tmux_ok

# Autostart consequence: UNKNOWN must skip, and say why. Fail toward doing
# nothing — a duplicate orchestrator's launch dies with its stderr on /dev/null.
_as_sc="$(mktemp -d)"
mkdir -p "$_as_sc/orchestrator"
: >"$_as_sc/orchestrator/orchestrator.config"
eval "$(awk '/^_orchestrator_autostart_if_scaffolded\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
# shellcheck disable=SC2317,SC2329
daemon_session_running() { return "${_AS_RC:-1}"; }
