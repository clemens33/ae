# ── tmux_attach: explicit server selection at the exec boundary ────────────
# `exec tmux` bypasses ae's function shim, so an attach from a plain shell looked
# for a named-server session on the default server. The explicit argv must survive
# exec at both attach/switch sites, while a client on a different server gets an
# actionable hint rather than a nested-client error.
_tmux_attach_body="$(awk '/^tmux_attach\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$_tmux_attach_body"
assert_eq "tmux_attach: no bare exec tmux bypass remains" "1" \
    "$(grep -Eq '^[[:space:]]*exec command tmux ' <<<"$_tmux_attach_body" \
        && ! grep -Eq '^[[:space:]]*exec tmux ' <<<"$_tmux_attach_body" && echo 1 || echo 0)"
_ta_dir="$(mktemp -d)"
_ta_bin="$_ta_dir/bin"
mkdir -p "$_ta_bin"
cat >"$_ta_bin/tmux" <<'TMUX_STUB'
#!/usr/bin/env bash
if [[ "${1:-}" == "-S" && "${3:-}" == "list-panes" ]]; then
    [[ -n "${AE_TA_CURRENT_PANES:-}" ]] && printf '%s\n' "$AE_TA_CURRENT_PANES"
    exit 0
fi
if [[ "${1:-}" == "list-panes" || ( "${1:-}" == "-L" && "${3:-}" == "list-panes" ) ]]; then
    [[ -n "${AE_TA_PREDICATE_PANES:-}" ]] && printf '%s\n' "$AE_TA_PREDICATE_PANES"
    exit 0
fi
printf '%s\n' "$@" >"${AE_TA_LOG:?}"
TMUX_STUB
chmod +x "$_ta_bin/tmux"
_ta_attach_args() (
    export PATH="$_ta_bin:$PATH" AE_TA_LOG="$_ta_dir/argv"
    export AE_TMUX_SERVER=canary AE_TMUX_SERVER_KIND=name
    unset TMUX
    _AE_INSIDE_TMUX=0 tmux_attach target
)
_ta_attach_args
assert_eq "tmux_attach: named server args precede attach-session" \
    $'-L\ncanary\nattach-session\n-t\ntarget' "$(cat "$_ta_dir/argv")"
_ta_default_args() (
    export PATH="$_ta_bin:$PATH" AE_TA_LOG="$_ta_dir/argv"
    unset AE_TMUX_SERVER AE_TMUX_SERVER_KIND TMUX
    _AE_INSIDE_TMUX=0 tmux_attach target
)
_ta_default_args
assert_eq "tmux_attach: unset server emits no -L/-S" \
    $'attach-session\n-t\ntarget' "$(cat "$_ta_dir/argv")"
_ta_foreign_hint() (
    export PATH="$_ta_bin:$PATH" AE_TA_LOG="$_ta_dir/argv"
    export AE_TMUX_SERVER=other AE_TMUX_SERVER_KIND=name TMUX_TMPDIR="$_ta_dir"
    export AE_TA_CURRENT_PANES=/dev/ttys039
    TMUX="$_ta_dir/tmux-$(id -u)/foreign,123,0"
    export TMUX
    : >"$_ta_dir/argv"
    unset _AE_INSIDE_TMUX
    # shellcheck disable=SC2317,SC2329
    ps() { printf 'ttys039\n'; }
    tmux_attach target
    echo CONTINUED
)
_ta_foreign_rc=0
_ta_hint="$(_ta_foreign_hint 2>&1)" || _ta_foreign_rc=$?
assert_eq "tmux_attach: foreign client gets a direct attach hint and no tmux call" \
    "session 'target' is on tmux server 'other'; attach with: tmux -L other attach -t target|0" \
    "$_ta_hint|$(wc -c <"$_ta_dir/argv" | tr -d '[:space:]')"
assert_eq "tmux_attach: foreign hint exits instead of returning to its caller" \
    "0|0" "$_ta_foreign_rc|$([[ "$_ta_hint" != *CONTINUED* ]] && echo 0 || echo 1)"
_ta_stale_tmux() (
    export PATH="$_ta_bin:$PATH" AE_TA_LOG="$_ta_dir/argv"
    export AE_TMUX_SERVER=other AE_TMUX_SERVER_KIND=name TMUX_TMPDIR="$_ta_dir"
    unset AE_TA_CURRENT_PANES
    export AE_TA_PREDICATE_PANES=/dev/ttys040
    TMUX="$_ta_dir/tmux-$(id -u)/foreign,123,0"
    export TMUX
    : >"$_ta_dir/argv"
    unset _AE_INSIDE_TMUX
    # shellcheck disable=SC2317,SC2329
    ps() { printf 'ttys039\n'; }
    tmux_attach target
)
_ta_stale_out="$(_ta_stale_tmux 2>&1)"
assert_eq "tmux_attach: stale inherited TMUX falls through to explicit attach" \
    $'no-hint|-L\nother\nattach-session\n-t\ntarget' \
    "$([[ "$_ta_stale_out" != *'on tmux server'* ]] && printf 'no-hint' || printf 'hint')|$(cat "$_ta_dir/argv")"
_ta_same_server() (
    export PATH="$_ta_bin:$PATH" AE_TA_LOG="$_ta_dir/argv"
    export AE_TMUX_SERVER=canary AE_TMUX_SERVER_KIND=name TMUX_TMPDIR="$_ta_dir"
    TMUX="$_ta_dir/tmux-$(id -u)/canary,123,0"
