# ── s19: Telegram bridge ownership (aewatch vs bash), no double-send ──────────
# Ownership is a DURABLE MARKER + fresh heartbeat (NOT env — a concurrent bash reviver via
# `telegram _supervise` never shares the uv-launcher's env, so ownership must be a machine-
# readable fact). _aewatch_owns_bridge: $AE_HOME/aewatch/bridge-owner exists AND the heartbeat
# is fresh (<=90s, the s18-hook rule). Marker but STALE heartbeat (aewatch dead) -> NOT owned,
# so the next _supervise revives bash (the free fallback). The bash STOP lives in the aewatch
# daemon's handoff, NOT in ae.
eval "$(awk '/^_aewatch_owns_bridge\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_owns_run() {  # <marker: yes|no> <hb: none|fresh|stale> -> yes|no
    local marker="$1" hb="$2" d
    d="$(mktemp -d)"
    mkdir -p "$d/aewatch"
    [[ "$marker" == yes ]] && : >"$d/aewatch/bridge-owner"
    case "$hb" in
        fresh) : >"$d/aewatch/heartbeat" ;;
        stale) : >"$d/aewatch/heartbeat"; _touch_ago 7200 "$d/aewatch/heartbeat" ;;
    esac
    if CONFIG_DIR="$d" _aewatch_owns_bridge; then echo yes; else echo no; fi
    rm -rf "$d"
}
assert_eq "owns-bridge: marker + FRESH heartbeat -> owns" "yes" "$(_owns_run yes fresh)"
assert_eq "owns-bridge: marker + STALE heartbeat -> NOT owns (bash revives = fallback)" "no" "$(_owns_run yes stale)"
assert_eq "owns-bridge: marker + NO heartbeat -> NOT owns" "no" "$(_owns_run yes none)"
assert_eq "owns-bridge: NO marker + fresh heartbeat -> NOT owns (default path zero-diff)" "no" "$(_owns_run no fresh)"
assert_eq "owns-bridge: NO marker + no heartbeat -> NOT owns" "no" "$(_owns_run no none)"

