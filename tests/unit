# ── manifest + context: the glue's half of two core renders ──────────────────
# A.2c moved BOTH documents into the core: it reads meta, lists the panes through
# the typed tmux transport, and writes workspace.md itself. The role column, the
# profile/tool columns and the whole context text are pinned in the core's own
# suite and end to end by the integration `doctor --refresh` canary — a bash tmux
# STUB cannot reach a separate process, so re-pinning them here would only test
# the stub. What stays the glue's, and is pinned here, is the CALL.
_mfc_body="$(awk '/^regenerate_manifest\(\) \{/{f=1} f{print} f&&/^\}$/{exit}' "$AE_BIN")"
_ctxc_body="$(awk '/^build_ae_context\(\) \{/{f=1} f{print} f&&/^\}$/{exit}' "$AE_BIN")"
assert_eq "manifest: regenerate_manifest is a thin _manifest-render call, argv in order" "1" \
    "$([[ "$_mfc_body" == *'_ae_core_preflight_try _manifest-render "$sessions_dir" "$sess" "$wdir" "$origin" "$mode"'*'"$main_pane"'* ]] && echo 1 || echo 0)"
assert_eq "context: build_ae_context is a thin _context call, argv in order" "1" \
    "$([[ "$_ctxc_body" == *'_ae_core_preflight_try _context "$meta_dir" "$session" "$work_dir" "$slot"'* ]] && echo 1 || echo 0)"
# The core is forbidden from reading the environment, so the two config paths are
# ARGUMENTS — and only when the file is really there: --global/--local take a
# value, so an empty one would be a path the core cannot read.
for _cfn in _mfc_body _ctxc_body; do
    assert_eq "render: ${_cfn%_body} passes CONFIG_FILE/AE_LOCAL_CONFIG as --global/--local, only when the file exists" "1" \
        "$([[ "${!_cfn}" == *'[[ -n "${CONFIG_FILE:-}" && -f "${CONFIG_FILE:-}" ]] && cfg+=(--global "$CONFIG_FILE")'* \
            && "${!_cfn}" == *'[[ -n "${AE_LOCAL_CONFIG:-}" && -f "${AE_LOCAL_CONFIG:-}" ]] && cfg+=(--local "$AE_LOCAL_CONFIG")'* ]] && echo 1 || echo 0)"
done
# No second renderer survives in the glue: the manifest heredoc and the context
# assembly are gone, not merely bypassed.
assert_eq "render: the glue holds no second manifest or context renderer" "1" \
    "$([[ "$AE_SOURCE" != *'## Parent archive'* && "$AE_SOURCE" != *'LEADERSHIP PEER'* \
        && "$AE_SOURCE" != *'You are in an ae multi-agent workspace'* ]] && echo 1 || echo 0)"
unset _mfc_body _ctxc_body _cfn

# ── the two rendered documents, produced once for the prose pins below ──────
# A.2c moved the manifest and the injected context into the core, but what they
# SAY stays a product invariant of ae: an agent that is never told rule 5 or
# rule 9 does not follow them, wherever the sentence is generated. So the prose
# assertions further down grep the REAL renders — one workspace.md written by
# the glue's own thin call, one context produced through build_ae_context —
# instead of the bash heredocs they used to grep out of $AE_SOURCE.
eval "$(awk '/^regenerate_manifest\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_RENDER_META="$(mktemp -d)"
printf 'mode=local\norigin=/o\nlayout=lead-pair\nsession=rsess\n' >"$_RENDER_META/meta"
CONFIG_FILE=/dev/null regenerate_manifest rsess /work /o local '%0' "$_RENDER_META"
_RENDER_MANIFEST="$(cat "$_RENDER_META/workspace.md")"
_RENDER_CONTEXT="$(CONFIG_FILE=/dev/null build_ae_context "$_RENDER_META" rsess /work worker.0)"
rm -rf "$_RENDER_META"
# A render that failed would make every pin below vacuously true, so prove both
# documents exist before anything greps them.
assert_eq "render: the fixture documents are non-empty (the prose pins are not vacuous)" "1" \
    "$([[ -n "$_RENDER_MANIFEST" && -n "$_RENDER_CONTEXT" ]] && echo 1 || echo 0)"

# ── refresh ordering: stamp @ae_slot BEFORE the manifest is regenerated ──
# On the FIRST doctor --refresh of a pre-slot lead-pair session, worker.0 has an
# empty @ae_slot; the render reads @ae_slot for the role column, so the region must
# run _stamp_live_slots first or the colead row prints 'agent' until some later
# regeneration (colead gate finding, review f9c11c22). The behavioural pair that
# proved it went with the bash renderer — the ORDER is a property of the shipped
# region, and that is what is pinned.
# ...and the structural pin on the shipped region: the stamp call precedes the
# regenerate call between the SYNC_SESSION_ASSETS_BODY markers, so doctor
# --refresh (which awk-sources exactly that region) runs them in the proven order.
_ord_region="$(awk '/^    # SYNC_SESSION_ASSETS_BODY_START$/{f=1} f{print} /^    # SYNC_SESSION_ASSETS_BODY_END$/{f=0}' <<<"$AE_SOURCE")"
_ord_stamp_ln="$(command grep -Fn '_stamp_live_slots "$SESSION"' <<<"$_ord_region" | head -1 | cut -d: -f1)"
_ord_regen_ln="$(command grep -Fn 'regenerate_manifest "$SESSION"' <<<"$_ord_region" | head -1 | cut -d: -f1)"
assert_eq "refresh-order: _stamp_live_slots precedes regenerate_manifest inside the marker region" "1" \
    "$([[ -n "$_ord_stamp_ln" && -n "$_ord_regen_ln" && "$_ord_stamp_ln" -lt "$_ord_regen_ln" ]] && echo 1 || echo 0)"
unset _ord_region _ord_stamp_ln _ord_regen_ln

