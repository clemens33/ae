# ── Telegram autostart refusal visibility ─────────────────────────────
# Autostart stderr is intentionally discarded by every launch/supervise caller.
# The refusal therefore crosses two durable, token-safe surfaces: the current
# session's events.jsonl and one machine-global last-refusal record for status/
# doctor when the bridge is down.
eval "$(awk '
/^_telegram_autostart_refusal_category\(\) \{/ ||
/^_telegram_load_last_autostart_refusal\(\) \{/ ||
/^_telegram_record_autostart_refusal\(\) \{/ ||
/^_telegram_autostart_if_enabled\(\) \{/ { printing=1 }
printing { print }
printing && /^\}$/ { printing=0 }
' "$AE_BIN")"
_tg_obs_root="$(mktemp -d)"
mkdir -p "$_tg_obs_root/session" "$_tg_obs_root/sessions/fixture"
printf '[telegram]\nenabled = true\n' >"$_tg_obs_root/config"
_tg_obs_token='123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi'
(
    export CONFIG_DIR="$_tg_obs_root"
    export CONFIG_FILE="$_tg_obs_root/config"
    export SESSIONS_DIR="$_tg_obs_root/sessions"
    export _AE_META_DIR="$_tg_obs_root/session"
    export SESSION=fixture
    # shellcheck disable=SC2317,SC2329
    ae_emit_event() {
        printf '{"action":"%s","target":"%s","summary":"%s"}\n' "$1" "$2" "$4" \
            >>"$_tg_obs_root/session/events.jsonl"
    }
    # shellcheck disable=SC2317,SC2329
    _telegram_intent_enabled() { echo true; }
    # shellcheck disable=SC2317,SC2329
    _telegram_intent_enabled_uncached() { echo true; }
    # shellcheck disable=SC2317,SC2329
    _telegram_daemon_running() { return 1; }
    # shellcheck disable=SC2317,SC2329
    _telegram_validate_token_file() { :; }
    # shellcheck disable=SC2317,SC2329
    _telegram_control_lock_file() { echo "$_tg_obs_root/control.lock"; }
    # The refusal text carries a token-shaped SHAPE, but the autostart surface
    # must persist only its fixed category.
    # shellcheck disable=SC2317,SC2329
    _telegram_spawn_daemon() {
        printf 'coexistence refusal token=%s\n' "$_tg_obs_token" >&2
        return 1
    }
    _telegram_autostart_if_enabled >/dev/null 2>&1
)
_tg_obs_record="$(<"$_tg_obs_root/telegram/autostart-refusal")"
assert_eq "tg-observe: global record is a closed category + timestamp" "1" \
    "$([[ "$_tg_obs_record" =~ ^(aewatch-live|same-token-live|token-unreadable|probe-failed|spawn-failed)$'\t'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] && echo 1 || echo 0)"
assert_eq "tg-observe: global record contains no refusal text or token" "1" \
    "$([[ "$_tg_obs_record" != *"$_tg_obs_token"* && "$_tg_obs_record" != *'coexistence'* ]] && echo 1 || echo 0)"
assert_eq "tg-observe: event is emitted at the autostart refusal" "1" \
    "$(grep -c '"action":"telegram_autostart_refused"' "$_tg_obs_root/session/events.jsonl" 2>/dev/null || true)"
_tg_obs_event="$(<"$_tg_obs_root/session/events.jsonl")"
assert_eq "tg-observe: event excludes token-shaped refusal text" "1" \
    "$([[ "$_tg_obs_event" != *"$_tg_obs_token"* && "$_tg_obs_event" != *'coexistence'* ]] && echo 1 || echo 0)"
_tg_obs_status="$(AE_HOME="$_tg_obs_root" CONFIG_FILE="$_tg_obs_root/config" "$AE_BIN" telegram status 2>&1)"
_tg_obs_doctor="$(AE_HOME="$_tg_obs_root" CONFIG_FILE="$_tg_obs_root/config" "$AE_BIN" doctor 2>&1 || true)"
assert_eq "tg-observe: status surfaces the last refusal while bridge is down" "1" \
    "$([[ "$_tg_obs_status" == *'last refusal=spawn-failed at '* && "$_tg_obs_status" != *"$_tg_obs_token"* ]] && echo 1 || echo 0)"
assert_eq "tg-observe: doctor adds a WARN row with category + timestamp" "1" \
    "$([[ "$_tg_obs_doctor" == *'WARN  telegram.autostart'*'last refusal=spawn-failed at '* && "$_tg_obs_doctor" != *"$_tg_obs_token"* ]] && echo 1 || echo 0)"
assert_eq "tg-observe: status/doctor never surface the token-shaped refusal text" "1" \
    "$([[ "$_tg_obs_status" != *"$_tg_obs_token"* && "$_tg_obs_doctor" != *"$_tg_obs_token"* ]] && echo 1 || echo 0)"
CONFIG_DIR="$_tg_obs_root" _telegram_load_last_autostart_refusal
assert_eq "tg-observe: reader accepts the persisted category and timestamp" \
    "spawn-failed" "$_TELEGRAM_LAST_REFUSAL_CATEGORY"
assert_eq "tg-observe: successful starts do not erase the last refusal" "1" \
    "$([[ -f "$_tg_obs_root/telegram/autostart-refusal" ]] && echo 1 || echo 0)"
assert_eq "tg-observe: atomic publication leaves no temp refusal artifact" "0" \
    "$(find "$_tg_obs_root/telegram" -maxdepth 1 -name 'autostart-refusal.tmp.*' -print | wc -l | tr -d '[:space:]')"
rm -rf "$_tg_obs_root"
unset _tg_obs_root _tg_obs_record _tg_obs_event _tg_obs_status _tg_obs_doctor _tg_obs_token

# ── Telegram refusal seams + hostile reader records ─────────────────
if _unit_slow 'telegram refusal seams + hostile reader records'; then
# The smoke fixture above proves the basic publication path. These cases make
# the mutation controls meaningful: the mapper receives token-shaped unknown
# input, the reader sees a hostile multiline row, and every real refusal branch
# drives the expected closed category into both durable surfaces.
_TG_OBS_REAL_FNS="$TMPDIR/tg-observe-real-fns.sh"
