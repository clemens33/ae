        mkdir -p "$SESSIONS_DIR/alpha"
        printf "session=alpha\nsession_id=aaaa1111-2222-3333-4444-555566667777\nagent.main=claude:lead:u1\nagent.worker.0=codex:coworker:u2\n" >"$SESSIONS_DIR/alpha/meta"
        [[ "$(resolve_session_ref alpha)" == "alpha	$SESSIONS_DIR/alpha" ]] && p=$((p+1)) # 9 exact
        [[ "$(resolve_session_ref aaaa)" == "alpha	$SESSIONS_DIR/alpha" ]] && p=$((p+1)) # 10 prefix
        resolve_session_ref nope >/dev/null || p=$((p+1))   # 11 none
        resolve_session_ref "../../etc" >/dev/null || p=$((p+1)) # 12 traversal blocked
        # Agent validation (codex BLOCKER): canonicalize, and reject anything
        # that is not a real agent of this session.
        d="$SESSIONS_DIR/alpha"
        [[ "$(resolve_agent_in_session "$d" claude:lead)" == "claude:lead" ]] && p=$((p+1)) # 13 exact ref
        [[ "$(resolve_agent_in_session "$d" coworker)" == "codex:coworker" ]] && p=$((p+1)) # 14 bare->canon
        resolve_agent_in_session "$d" "%42"   >/dev/null || p=$((p+1)) # 15 reject pane-id
        resolve_agent_in_session "$d" "@x:y"  >/dev/null || p=$((p+1)) # 16 reject cross-session
        resolve_agent_in_session "$d" "telegram:9" >/dev/null || p=$((p+1)) # 17 reject external prefix
        resolve_agent_in_session "$d" "ghost" >/dev/null || p=$((p+1)) # 18 reject unknown agent
        # Reply-routing: parse the forwarded-message header → session\tactor.
        [[ "$(tg_parse_reply_target "[alpha] waiting-user  claude:lead")" == "alpha	claude:lead" ]] && p=$((p+1)) # 19 parse plain header
        [[ "$(tg_parse_reply_target "[alpha] ask  claude:lead → codex:coworker
the question text")" == "alpha	claude:lead" ]] && p=$((p+1)) # 20 header w/ target+summary → actor, line 1 only
        tg_parse_reply_target "just a normal message" >/dev/null || p=$((p+1)) # 21 reject non-header
        tg_parse_reply_target "" >/dev/null || p=$((p+1)) # 22 reject empty
        # Compact grammar + sticky target (slice 2). Stub the side-effecting
        # boundary so we observe routing without curl/helpers.
        send_message() { :; }
        tg_dispatch() { printf "%s|%s|%s|%s" "$2" "$3" "$4" "$5" >"$STATE_DIR/disp"; }
        rm -f "$STATE_DIR/disp"
        tg_cmd_at 999 "@alpha:claude:lead do the thing"
        [[ "$(cat "$STATE_DIR/disp" 2>/dev/null)" == "alpha|send|claude:lead|do the thing" ]] && p=$((p+1)) # 23 @session:agent → send (agent keeps alias:name colon)
        rm -f "$STATE_DIR/disp"
        tg_cmd_at 999 "@noagent hello"  # missing :agent → usage, no dispatch
        [[ ! -f "$STATE_DIR/disp" ]] && p=$((p+1)) # 24 @ without agent does not dispatch
        tg_cmd_use 999 "alpha claude:lead"   # validated against running alpha
        [[ "$(cat "$TG_TARGET_FILE" 2>/dev/null)" == "alpha	claude:lead" ]] && p=$((p+1)) # 25 /use persists a validated canon target
        rm -f "$STATE_DIR/disp"
        tg_route_sticky 999 "bare message"
        [[ "$(cat "$STATE_DIR/disp" 2>/dev/null)" == "alpha|send|claude:lead|bare message" ]] && p=$((p+1)) # 26 bare msg routes to sticky target
        tg_cmd_use 999 clear
        [[ ! -f "$TG_TARGET_FILE" ]] && p=$((p+1)) # 27 /use clear removes target
        rm -f "$STATE_DIR/disp"
        tg_route_sticky 999 "no target now"
        [[ ! -f "$STATE_DIR/disp" ]] && p=$((p+1)) # 28 sticky with no target does not dispatch
        echo "$p"
    ' 2>/dev/null
)"
