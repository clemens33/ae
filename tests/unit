tool_kind_from_cmd() { printf 'codex'; }
write_launch_script() { printf '%s' "$3" >"${MD}/built"; printf '%s/launch.sh' "$MD"; }
tmux_paste_submit() { return 0; }
wait_for_agent_start() { return 0; }
_deliver_launch_prompt() { printf '%s\n' "$3" >>"${MD}/deferred"; return 0; }
