# F1 (hazard read): the LAUNCH path was dummy=bash-blind. A MODELED tool whose
# paste never submits makes ae_submit_pasted_message -> return 1, which
# tmux_paste_submit PROPAGATES — hence the `|| true` guards at the launch sites.
eval "$(awk '/^pane_current_command\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^tmux_paste_submit\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_tps_staged() {  # modeled tool stays staged -> propagated nonzero
    local rc
    # shellcheck disable=SC2317
    sleep() { :; }
    # shellcheck disable=SC2317
    tmux() {
        case "$1" in
            display-message) printf 'claude' ;;                     # pane_current_command
            capture-pane) printf '❯ [Pasted text #2 +7 lines]\n' ;; # staged in the input region
        esac
        return 0
    }
    tmux_paste_submit "%1" "a long message that never submits"
    rc=$?
    echo "$rc"
}
assert_eq "F1: launch paste propagates nonzero when a modeled tool never submits" "1" "$(_tps_staged 2>/dev/null)"

# ── request-integrity-2 shell guard (lead ruling): interpreted-sink protection ───────
# A real agent that dies drops its pane to a shell; a send's paste + Enter would
# EXECUTE the message as a command. _pane_agent_is_dead refuses ONLY when the pane
# is a shell AND the expected agent_bin is a real (non-shell) agent — so a
# shell-BASED agent (dummy=bash) and live agents still deliver.
eval "$(awk '/^command_is_shell\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^_agent_bin_for_pane\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^_pane_has_descendant_named\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^_pane_agent_is_dead\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_pad() {  # <pane-foreground-command> <agent_bin> [agent-in-tree: 0=yes 1=no] -> dead|alive
    local _PROC="$1" _ABIN="$2" _INTREE="${3:-1}" # default 1 = agent NOT in the tree
    # shellcheck disable=SC2317
    tmux() {
        [[ "$1" == display-message ]] || return 0
        case "$*" in
        *pane_pid*) printf '99999' ;; # numeric pid so the tree walk runs
        *) printf '%s' "$_PROC" ;;    # pane_current_command
        esac
        return 0
    }
    # shellcheck disable=SC2317
    _agent_bin_for_pane() { printf '%s' "$_ABIN"; }
    # shellcheck disable=SC2317
    _pane_has_descendant_named() { return "$_INTREE"; } # 0=agent alive in tree, 1=not found
    _pane_agent_is_dead "%1" && echo dead || echo alive
}
assert_eq "dead-shell: real agent dropped to shell -> dead (REFUSE)" "dead" "$(_pad bash claude)"
assert_eq "dead-shell: live real agent in foreground -> alive (deliver)" "alive" "$(_pad claude claude)"
assert_eq "dead-shell: node-wrapped live agent -> alive" "alive" "$(_pad node claude)"
assert_eq "dead-shell: shell-based agent (dummy=bash) -> alive (don't break dummy delivery)" "alive" "$(_pad bash bash)"
assert_eq "dead-shell: undeterminable agent_bin -> alive (fail-open, don't break delivery)" "alive" "$(_pad bash '')"
assert_eq "dead-shell: empty/unreadable pane command + real agent -> dead (fail-closed)" "dead" "$(_pad '' codex)"
# ri-3: a LIVE agent momentarily running a Bash tool (or under the bash -lc wrapper)
# shows a shell foreground while its binary is alive as a DESCENDANT — the tree walk
# must DELIVER, not false-refuse. Reverting the walk makes this return "dead" (fails).
assert_eq "dead-shell: shell foreground BUT agent alive in process tree -> alive (ri-3)" "alive" "$(_pad bash claude 0)"
# ri-3 (codex review finding): exercise the REAL _pane_has_descendant_named — the _pad
# tests stub it, so the actual pgrep + /proc ancestor walk needs its own coverage.
eval "$(awk '/^_pane_has_descendant_named\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
sleep 30 &
_ri3_sleep=$!
assert_eq "descendant-walk: a live child IS found under its parent pid" "0" "$(_pane_has_descendant_named "$$" sleep >/dev/null; echo $?)"
assert_eq "descendant-walk: an absent process name -> not found" "1" "$(_pane_has_descendant_named "$$" no_such_proc_ri3xyz >/dev/null; echo $?)"
assert_eq "descendant-walk: empty args -> not found (guard)" "1" "$(_pane_has_descendant_named '' claude >/dev/null; echo $?)"
kill "$_ri3_sleep" 2>/dev/null || true

# _agent_bin_for_pane reads agent_bin.<slot> from the pane's OWN session meta.
_abfp_tmp="$(mktemp -d)"
mkdir -p "$_abfp_tmp/sessX"
printf 'agent_bin.main=claude\nagent_bin.worker.0=codex\n' >"$_abfp_tmp/sessX/meta"
_abfp() {  # <slot> -> agent_bin
    local _SLOT="$1" _AE_SESSIONS_DIR="$_abfp_tmp"
    # shellcheck disable=SC2317
    tmux() {
        [[ "$1" == display-message ]] || return 0
        case "$*" in
            *@ae_slot*) printf '%s' "$_SLOT" ;;
            *'#S'*) printf 'sessX' ;;
        esac
        return 0
    }
    _agent_bin_for_pane "%1"
}
assert_eq "agent-bin-for-pane: reads agent_bin.<slot> from the pane's session meta" "claude" "$(_abfp main)"
assert_eq "agent-bin-for-pane: worker slot" "codex" "$(_abfp worker.0)"
assert_eq "agent-bin-for-pane: unstamped (invalid slot) -> empty" "" "$(_abfp '')"

# ── send-focus (codex review): NO focus change in send/interrupt, longer patience ──
# select-pane changed the window's ACTIVE pane mid-send — the human's in-flight
# keystrokes routed into the TARGET (acute under lead-pair: lead+colead share window
# 0). paste-buffer/send-keys take -t; focus is not part of any TUI submission contract.
_sf_send="$(awk '/^helper_send_main\(\) \{/{f=1} f{print} f && /^\}$/{exit}' <<<"$AE_SOURCE")"
_sf_int="$(awk '/^helper_interrupt_main\(\) \{/{f=1} f{print} f && /^\}$/{exit}' <<<"$AE_SOURCE")"
assert_eq "send-focus: helper_send_main issues ZERO select-pane (code, not comments)" "0" \
    "$(grep -vE '^\s*#' <<<"$_sf_send" | grep -c 'select-pane')"
assert_eq "send-focus: helper_interrupt_main issues ZERO select-pane (code, not comments)" "0" \
    "$(grep -vE '^\s*#' <<<"$_sf_int" | grep -c 'select-pane')"
# Patience: bounded in-process wait, numeric-guarded env override, 30s default.
assert_eq "send-focus: defer bound is AE_SEND_DEFER_SEC (default 30, numeric-guarded)" "1" \
    "$([[ "$_sf_send" == *'_defer_sec="${AE_SEND_DEFER_SEC:-30}"'* && "$_sf_send" == *'=~ ^[0-9]+$ ]] || _defer_sec=30'* ]] && echo 1 || echo 0)"
# The wait holds the target flock (ordering): lock is taken BEFORE the defer loop.
assert_eq "send-focus: target flock held during the wait (lock precedes defer loop)" "1" \
    "$([[ "$_sf_send" == *'ae_lock_target "$target"'*'while _paste_input_busy'* ]] && echo 1 || echo 0)"
# Human-presence signal joins the defer condition (supplemental, tool-agnostic).
assert_eq "send-focus: defer also gates on _pane_recently_viewed" "1" \
    "$([[ "$_sf_send" == *'_paste_input_busy "$target" "$tool" || _pane_recently_viewed "$target"'* ]] && echo 1 || echo 0)"
# _pane_recently_viewed: client-at-pane with fresh activity -> defer; stale/other -> clear.
eval "$(awk '/^_pane_recently_viewed\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_prv() {  # <client-pane> <activity-age-s> <target> -> viewed|clear
    local _CP="$1" _AGE="$2"
    # shellcheck disable=SC2317  # invoked indirectly by _pane_recently_viewed
    date() { printf '1000000'; }
    # shellcheck disable=SC2317  # invoked indirectly by _pane_recently_viewed
    tmux() { printf '%s|%s\n' "$_CP" "$((1000000 - _AGE))"; }
    _pane_recently_viewed "$3" && echo viewed || echo clear
}
assert_eq "presence: client at target pane, 1s-old activity -> viewed (defer)" "viewed" "$(_prv %5 1 %5)"
assert_eq "presence: client at target pane, 60s-old activity -> clear" "clear" "$(_prv %5 60 %5)"
assert_eq "presence: client at ANOTHER pane, fresh activity -> clear" "clear" "$(_prv %7 1 %5)"
_prv_none() {
    # shellcheck disable=SC2317  # invoked indirectly by _pane_recently_viewed
    tmux() { :; }
    # shellcheck disable=SC2317  # invoked indirectly by _pane_recently_viewed
    date() { printf '1000000'; }
    _pane_recently_viewed %5 && echo viewed || echo clear
}
assert_eq "presence: no clients -> clear" "clear" "$(_prv_none)"
assert_eq "presence: emitted into the send-path _lib" "1" \
    "$([[ "$AE_SOURCE" == *'_paste_input_busy _pane_recently_viewed'* ]] && echo 1 || echo 0)"

# helper_send_main refuses a dead-shell target BEFORE the lock (fail fast, no defer).
assert_eq "send-guard: dead-shell refusal precedes the lock" "1" \
    "$([[ "$AE_SOURCE" == *'if _pane_agent_is_dead "$target"; then'*'REFUSED'*'exit 1'*'ae_lock_target "$target"'* ]] && echo 1 || echo 0)"
# helper_interrupt_main refuses a MESSAGE-carrying interrupt to a dead-shell pane
# (same sink); a no-message interrupt (bare cancel keystrokes) is unaffected.
assert_eq "interrupt-guard: message interrupt to a dead-shell pane refuses (same sink)" "1" \
    "$([[ "$AE_SOURCE" == *'if [[ -n "$msg" ]] && _pane_agent_is_dead "$target"; then'*'interrupt of '*'REFUSED'*'exit 1'* ]] && echo 1 || echo 0)"
# Behavioral: a message interrupt to a dead real-agent pane exits nonzero and pastes nothing.
eval "$(awk '/^helper_interrupt_main\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_int_dead() {  # -> "rc=? pasted=?"
    local rc pasted=0
    # shellcheck disable=SC2317,SC2034  # AE_RESOLVED_AGENT read by helper_interrupt_main
    ae_resolve() {
        AE_RESOLVED_PANE="%9"
        AE_RESOLVED_AGENT="claude:ghost"
        return 0
    }
    # shellcheck disable=SC2317
    _pane_agent_is_dead() { return 0; } # dead real agent
    # shellcheck disable=SC2317
    ae_lock_target() { return 0; }
    # shellcheck disable=SC2317
    ae_submit_pasted_message() { pasted=1; return 0; }
    # shellcheck disable=SC2317
    ae_unlock_target() { return 0; }
    # shellcheck disable=SC2317
    ae_emit_event() { return 0; }
    # shellcheck disable=SC2317
    tmux() { return 0; }
    # shellcheck disable=SC2317
    sleep() { :; }
    ( helper_interrupt_main claude:ghost "stop and run rm -rf" ) 2>/dev/null
    rc=$?
    echo "rc=$rc pasted=$pasted"
}
assert_eq "interrupt-guard: dead-agent message interrupt exits 1, pastes nothing" "rc=1 pasted=0" "$(_int_dead)"
# codex code-round: a message interrupt whose submit is UNCONFIRMED must exit 1
# and emit NO interrupt event (the "false delivered" class the send path fixes).
_int_unconfirmed() {  # live target, submit fails -> "rc=? emitted=?"
    local rc evfile
    evfile="$(mktemp)" # a FILE survives the subshell fork (a var would not)
    # shellcheck disable=SC2317,SC2034  # AE_RESOLVED_AGENT read by helper_interrupt_main
    ae_resolve() {
        AE_RESOLVED_PANE="%9"
        AE_RESOLVED_AGENT="claude:live"
        return 0
    }
    # shellcheck disable=SC2317
    _pane_agent_is_dead() { return 1; } # alive
    # shellcheck disable=SC2317
    ae_lock_target() { return 0; }
    # shellcheck disable=SC2317
    ae_target_tool() { echo claude; }
    # shellcheck disable=SC2317
    ae_submit_pasted_message() { return 1; } # submit UNCONFIRMED
    # shellcheck disable=SC2317
    ae_unlock_target() { return 0; }
    # shellcheck disable=SC2317
    ae_emit_event() {
        echo x >>"$evfile"
        return 0
    }
    # shellcheck disable=SC2317
    tmux() { return 0; }
    # shellcheck disable=SC2317
    sleep() { :; }
    ( helper_interrupt_main claude:live "stop now" ) 2>/dev/null
    rc=$?
    echo "rc=$rc emitted=$([[ -s "$evfile" ]] && echo 1 || echo 0)"
    rm -f "$evfile"
}
assert_eq "interrupt-verify: unconfirmed submit exits 1, emits NO interrupt event" "rc=1 emitted=0" "$(_int_unconfirmed)"

