_calver_versions() {
    local dir="$1"
    printf '%s|%s|%s|%s' \
        "$(grep -m1 '^_AE_ENTRY_VERSION=' "$dir/ae-entry" | cut -d'"' -f2)" \
        "$(grep -m1 '^AE_VERSION=' "$dir/ae" | cut -d'"' -f2)" \
        "$(grep -m1 '^version = "' "$dir/Cargo.toml" | cut -d'"' -f2)" \
        "$(awk '/^name = "ae"$/{in_ae=1; next} in_ae && /^version = /{gsub(/"/, "", $3); print $3; exit} /^\\[\\[package\\]\\]$/{in_ae=0}' "$dir/Cargo.lock")"
}
_calver_fingerprint() {
    cksum "$1/ae" "$1/ae-entry" "$1/Cargo.toml" "$1/Cargo.lock"
}
_calver_source_ae_block() {
    awk '
        function flush(    i) {
            if (has_name && has_source) {
                for (i = 1; i <= n; i++) print lines[i]
            }
            delete lines
            n = 0
            has_name = 0
            has_source = 0
        }
        /^\[\[package\]\]$/ {
            flush()
            lines[++n] = $0
            next
        }
        {
            lines[++n] = $0
            if ($0 == "name = \"ae\"") has_name = 1
            if ($0 ~ /^source = /) has_source = 1
        }
        END { flush() }
    ' "$1/Cargo.lock"
}
