# ── end: the archive step, on a session that has no id and on one ae cannot parse ──
eval "$(awk '/^(_end_archive_step|_ae_core_try|set_session_meta_value|set_session_meta_values|gen_uuid)\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_ar48_step() { # <session_id value or empty> -> rc|session-still-there|archives
    local home="$_ar48_root/step.$RANDOM"
    mkdir -p "$home/sessions/legacy"
    _ar48_session "$home/sessions/legacy"
    # A.1: the archive step is the core's — pin it in the fixture meta, and let the
    # archive land where the CORE puts it (the session dir's grandparent), not at an
    # AE_HOME the core never reads.
    printf 'ae_core=%s\nae_core_version=%s\n' "$_AE_UNIT_CORE" "$_AE_UNIT_CORE_VER" \
        >>"$home/sessions/legacy/meta"
    if [[ -n "${1:-}" ]]; then
        _sed_i -e "s|^session_id=.*|session_id=$1|" "$home/sessions/legacy/meta"
    else
        _sed_i -e "/^session_id=/d" "$home/sessions/legacy/meta"
    fi
    local rc=0
    (
        # shellcheck disable=SC2034  # read by the archive step and its callees
        SESSIONS_DIR="$home/sessions" WORKTREES_DIR="$home/worktrees" AE_HOME="$home"
        _AE_PURGE_HISTORY_CLI=""
        # ae declares this at top level; the harness loads functions only, and under
        # `set -u` subscripting an UNDECLARED associative array is an arithmetic eval on
        # the key ("legacy: unbound variable") — the hazard AGENTS.md names.
        declare -A _AE_END_FROZEN_PLAN=()
        declare -A _AE_END_FROZEN_AUTHORITY=()
        _end_archive_step legacy not-managed - - "" >/dev/null 2>&1
    ) || rc=$?
    printf '%s|%s|%s' "$rc" \
        "$([[ -f "$home/sessions/legacy/meta" ]] && echo 1 || echo 0)" \
        "$(find "$home/archive" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | grep -c . | tr -d '[:space:]')"
    printf '\t%s' "$home"
}
