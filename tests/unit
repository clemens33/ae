# B2: empty-query-result proves nothing when the QUERY failed. Tri-state:
# 0 verified-gone / 1 verified-alive / 2 cannot-verify. Stub _end_tmux per case.
_evg() { # fixture-mode _end_verify_gone: $1 = stub behavior
    local mode="$1"
    # shellcheck disable=SC2317
    _end_tmux() {
        case "$mode" in
            alive) printf 'victim\nother\n'; return 0 ;;
            gone) printf 'other\n'; return 0 ;;
            noserver) printf 'no server running on /tmp/tmux-1000/x\n'; return 1 ;;
            unreachable) printf 'error connecting to /tmp/tmux-1000/x (Permission denied)\n'; return 1 ;;
        esac
    }
    local rc=0
    _end_verify_gone victim || rc=$?
    printf '%s' "$rc"
    unset -f _end_tmux
    return 0
}
