assert_eq "launch server: RELATIVE #{socket_path} without pid-verification → kind=ambiguous (fail closed)" "ambiguous|rel.sock" \
    "$(_rls rel.sock)"
assert_eq "launch server: query failed → AE_TMUX_SERVER name → kind=name" "name|srv-a" \
