    "codex" \
    "$(extract_binary_from_cmd "sudo --user=alice codex")"

assert_eq "binary: sudo with boolean -E plus -u" \
    "codex" \
    "$(extract_binary_from_cmd "sudo -E -u alice codex")"

assert_eq "binary: nice with -n" \
    "claude" \
    "$(extract_binary_from_cmd "nice -n 5 claude")"

assert_eq "binary: nice with --adjustment" \
    "claude" \
    "$(extract_binary_from_cmd "nice --adjustment 5 claude")"

assert_eq "binary: time with --format" \
    "claude" \
    "$(extract_binary_from_cmd "time --format %E claude")"

assert_eq "binary: ionice with --class" \
    "codex" \
    "$(extract_binary_from_cmd "ionice --class 2 codex")"

assert_eq "binary: nested env then sudo" \
    "codex" \
    "$(extract_binary_from_cmd "env -i sudo -u bob codex")"

# ── tool_name_from_cmd ──────────────────────────────────────────────

assert_eq "name: claude" "claude code" "$(tool_name_from_cmd "claude --model opus")"
assert_eq "name: codex"  "codex"       "$(tool_name_from_cmd "codex --yolo")"
assert_eq "name: opencode" "opencode"  "$(tool_name_from_cmd "opencode")"
assert_eq "name: unknown passes through" "mytool --flag" "$(tool_name_from_cmd "mytool --flag")"

