# Behavioral: extract the daemon body and exercise the security functions.
_tg3_daemon="$(mktemp)"
# Strip the top-level lines that have side effects when SOURCED (vs run as the
# real daemon): `main "$@"` and the `exec >>"$LOG_FILE" 2>&1` log redirect —
# the latter would hijack this test's own stdout into a log file.
awk "/cat >\"\\\$dest\" <<'TELEGRAM_DAEMON_EOF'/{f=1;next} /^TELEGRAM_DAEMON_EOF\$/{f=0} f" \
    "$(dirname "$0")/../ae" | sed -e '/^main "\$@"$/d' -e '/^exec >>"\$LOG_FILE" 2>&1$/d' >"$_tg3_daemon"
_tg3_home="$(mktemp -d)"
_tg3_result="$(
    AE_HOME="$_tg3_home" bash -c '
        set -uo pipefail
        SESSIONS_DIR="$AE_HOME/sessions"; STATE_DIR="$AE_HOME/telegram"
        mkdir -p "$SESSIONS_DIR" "$STATE_DIR"
        # shellcheck disable=SC1090
        source "'"$_tg3_daemon"'" 2>/dev/null || true
        # Stub the tmux running-check so resolve logic is tested without a
        # live server (the running filter itself is asserted structurally).
        daemon_session_running() { return 0; }
        TG_CHAT_ID="999"; TG_ALLOWED_IDS="999, 1000"; TG_OFFSET_FILE="$STATE_DIR/tg_offset"
        p=0
        update_authorized 999 999 private   && p=$((p+1))   # 1 allow
        update_authorized 999 999 group     || p=$((p+1))   # 2 reject group
        update_authorized 999 888 private   || p=$((p+1))   # 3 reject wrong chat
        update_authorized 777 999 private   || p=$((p+1))   # 4 reject unlisted
        update_authorized abc 999 private   || p=$((p+1))   # 5 reject non-numeric
