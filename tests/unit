# Every pane kill goes through _kill_owned_pane, which reads the pane's session and
# @ae_agent at the moment of the kill and refuses a stranger: pane ids are server-local
# and reused after a server restart on the same socket name, so a process holding a
# stale id (a spawn rolling back, a retire, a watchdog stopping) killed a later
# session's freshly spawned pane in the integration suite. The ONE raw `tmux kill-pane`
# is the guard's own.
assert_eq "kill-pane: the only raw tmux kill-pane in ae is inside _kill_owned_pane" "1" \
    "$(grep -c 'tmux kill-pane' <<<"$AE_SOURCE")"
assert_eq "kill-pane: every surviving kill site goes through the guard (3: two watchdog, one legacy reaper)" "3" \
    "$(grep -c '^ *\(if \[\[ -n "\$watchdog_pane" \]\]; then \)\?_kill_owned_pane "\$\(resolved\|pane_id\|legacy_pane\|watchdog_pane\)"' <<<"$AE_SOURCE")"
# ── _kill_owned_pane FAILS CLOSED: a kill needs a POSITIVE owner match ──
# The stranger-kill this guard prevents is a destructive act, so the absence of a
# contradiction must not authorise it (colead gate f0a99784): a probe that fails, a
# probe that answers no session (tmux renders an empty format for an unknown pane,
# rc 0 — measured), a caller that cannot name the session it means, and a mismatch
# on either fact all end with ZERO kill calls. The two positive arms prove the guard
# still kills what it should. Every call is BARE under this suite's errexit — the
# only shape that proves the probe's non-zero rc cannot abort the caller.
eval "$(awk '/^_kill_owned_pane\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_kop_log="$(mktemp)"
_KOP_RC=0
_KOP_ANSWER=""
# shellcheck disable=SC2317,SC2329
tmux() {
    case "${1:-}" in
        display-message)
            printf '%s' "$_KOP_ANSWER"
            return "$_KOP_RC"
            ;;
        kill-pane) printf 'kill-pane %s\n' "${3:-}" >>"$_kop_log" ;;
    esac
    return 0
}
_KOP_RC=1 _KOP_ANSWER="" _kill_owned_pane '%7' s alice 2>/dev/null
_KOP_RC=0 _KOP_ANSWER=$'\t' _kill_owned_pane '%7' s alice 2>/dev/null
_kop_err="$(_KOP_RC=0 _KOP_ANSWER=$'other\talice' _kill_owned_pane '%7' s alice 2>&1 >/dev/null)"
assert_eq "kill-guard: a pane in another session is refused, loudly" "1" \
    "$(command grep -Fc "belongs to session 'other', not 's'" <<<"$_kop_err" || true)"
_kop_err="$(_KOP_RC=0 _KOP_ANSWER=$'s\tbob' _kill_owned_pane '%7' s alice 2>&1 >/dev/null)"
assert_eq "kill-guard: a pane stamped for another agent is refused, loudly" "1" \
    "$(command grep -Fc "stamped 'bob', not 'alice'" <<<"$_kop_err" || true)"
_KOP_RC=0 _KOP_ANSWER=$'s\talice' _kill_owned_pane '%7' '' alice 2>/dev/null
_kill_owned_pane '' s alice 2>/dev/null
assert_eq "kill-guard: failed probe, unknown pane, mismatches, unnamed session and empty pane id kill NOTHING" "0" \
    "$(command grep -c 'kill-pane' "$_kop_log" || true)"
_KOP_RC=0 _KOP_ANSWER=$'s\talice' _kill_owned_pane '%7' s alice
_KOP_RC=0 _KOP_ANSWER=$'s\t' _kill_owned_pane '%8' s
assert_eq "kill-guard: a matching session+stamp, and a matching session with no stamp asked, kill exactly their pane" \
    $'kill-pane %7\nkill-pane %8' "$(cat "$_kop_log")"
unset -f tmux
rm -f "$_kop_log"
unset _kop_log _kop_err _KOP_RC _KOP_ANSWER

