    "$(resume_cmd_from_cmd "opencode")"

assert_eq "resume: opencode with session ID → --session" \
    "opencode --session ses_abc123" \
    "$(resume_cmd_from_cmd "opencode" "ses_abc123")"

assert_eq "resume: opencode with flags + session ID" \
