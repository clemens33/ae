# ── set -e liveness: the sensor is called from `ae`, which runs set -euo pipefail ──
# These functions were NOT set -e safe and this suite could never have shown it — not
# because it lacks errexit (line 7 sets -euo pipefail) but because a failing command only
# aborts in STATEMENT position: every test reaches the sensor through `$(…)` in an
# assert_eq argument, and `$(fn)`, `if fn`, `fn && …`, `fn || …` all mask the abort.
# Production callers sat in `if` conditions for the same reason. So the bug was real,
# live, and invisible from both sides. `((x++))` yields the OLD value, so at 0 it is a
# FALSE arithmetic result -> status 1 -> a bare call aborts the caller mid-way.
# `_cmd_spawn` now calls this tree under `ae`'s errexit, and a spawn dying inside the
# sensor would be the silent-loss class wearing a crash.
# So drive them BARE, in statement position, inside a set -euo pipefail subshell — the
# only shape that can catch it.
_sete_probe() { # -> ok|ABORT:<stage>
    _timeout 10 "${BASH:-bash}" -c '
        set -euo pipefail
        for fn in _sgr_parse _input_region_is_border _input_region_content_end \
            _input_region_prompt_seg _input_region_occupied; do
            eval "$(awk "/^${fn}\(\) \{/,/^\}\$/" "$1")"
        done
        echo -n ""
        _sgr_parse "$(printf "%b" "\033[1m›\033[0m draft\n  second row\n\n  footer")"
        _input_region_content_end 0 blank
        _input_region_prompt_seg 1 "›"
        printf "ok"
    ' _ "$(dirname "$0")/../ae" 2>/dev/null || printf "ABORT:rc=%s" "$?"
    return 0
}
assert_eq "set-e: bare sensor calls survive errexit (no ((x++)) at zero)" "ok" "$(_sete_probe)"

