    awk -v eof="$eof" -v outfile="$out" '
        $0 ~ ("<<\047" eof "\047") { inside=1; next }
        inside && $0 == eof { exit }
        inside { print > outfile }
    ' "$src"
}
# Build a functional _lib from the declare-f source layout: the emitted
# prologue (LIBPROLOGUE heredoc) + EXACTLY the fn set named by the real
# emission's declare -f list, parsed from the emission block itself. The
# synthetic _lib must never be BROADER than the runtime one — a superset
# (e.g. including helper_* template fns) could mask an accidental _lib
# dependency that generated sessions would only hit at runtime.
_build_lib_from_source() {
    local src="$1" out="$2" fn
    {
        awk "/<<'LIBPROLOGUE'/{f=1;next} /^LIBPROLOGUE\$/{f=0} f" "$src"
        while IFS= read -r fn; do
            [[ -n "$fn" ]] || continue
            awk "/^${fn}\\(\\) \\{/,/^\\}\$/" "$src"
        done < <(awk '/^ *declare -f ae_resolve /{f=1} f{l=$0; stop=(l !~ /\\ *$/); gsub(/\\ *$/,"",l); sub(/^ *declare -f /,"",l); print l; if (stop) exit}' "$src" | tr ' ' '\n')
    } >"$out"
}
_build_lib_from_source "$(dirname "$0")/../ae" "$_req_helper_dir/_lib"
assert_eq "_lib builder: mirrors the emission list (no helper_* leakage, non-empty)" \
    "0|1" \
    "$(printf '%s|%s' "$(grep -c '^helper_' "$_req_helper_dir/_lib")" \
        "$(grep -q '^ae_meta_set() {' "$_req_helper_dir/_lib" && echo 1 || echo 0)")"

# EXECUTION proof, run against the ACTUAL generated _lib. The structural closure
# guard above says a callee is emitted; this says the emitted artifact RUNS. Both
# are needed — the omission this replaces produced "command not found" on a
# discarded stderr and rc 0, so every structural signal downstream looked fine.
#
# The subject moved with A.3: the alert resolvers retired with the bash watchdog
# loop, so the probe rides on _event_json_str, which every send-path helper reaches
# through this same artifact. Its escape handling is the discriminating part — a
# body that failed to load would answer empty, not wrong.
_wedge_dir="$(mktemp -d)"
printf '{"ts":"2026-05-29T10:00:00Z","actor":"claude:q\\"uote","action":"state","ref":"working","summary":"a\\\\b"}\n' \
    >"$_wedge_dir/events.jsonl"
_wedge_out="$(
    AE_LIB="$_req_helper_dir/_lib" AE_EV="$_wedge_dir/events.jsonl" \
        "${BASH:-bash}" -c '
        set -uo pipefail
        # shellcheck disable=SC1090
        source "$AE_LIB"
        line="$(cat "$AE_EV")"
        _event_json_str "$line" actor
        printf "%s|" "$_EV"
        _event_json_str "$line" summary
        printf "%s" "$_EV"
    ' 2>&1
)"
assert_eq "_lib execution: the generated _lib runs, and unescapes what it reads" \
    'claude:q"uote|a\b' "$_wedge_out"
rm -rf "$_wedge_dir"
# Build a runnable generated helper from the declare-f layout: the helper's
# emitted <TAG>PROLOGUE heredoc + the fn bodies named by its declare -f line +
# the main-call tail — mirroring the real emission exactly.
_build_helper_from_source() {
    local src="$1" tag="$2" out="$3" fn names
    names="$(awk "/^${tag}PROLOGUE\$/{f=1;next} f && /^ *declare -f /{sub(/^ *declare -f /,\"\"); print; exit}" "$src")"
    {
        awk "/<<'${tag}PROLOGUE'/{f=1;next} /^${tag}PROLOGUE\$/{f=0} f" "$src"
        local -a _fns
        read -ra _fns <<<"$names"
        for fn in "${_fns[@]}"; do
            awk "/^${fn}\\(\\) \\{/,/^\\}\$/" "$src"
        done
        printf '%s "$@"\n' "${names##* }"
    } >"$out"
}
