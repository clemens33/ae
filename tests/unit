while IFS= read -r _en; do
    [[ -n "$_en" ]] || continue
    _c="$(grep -c "^${_en}() {" <<<"$AE_SOURCE")"
    [[ "$_c" == "1" ]] || _bad_def+="${_en}=${_c} "
done < <(tr ' ' '\n' <<<"$_emit_lists" | sort -u)
assert_eq "emissions: every emitted fn has exactly one top-level definition" "" "$_bad_def"
# 3. Parity: the set of helper_* fns DEFINED in the template library must
#    equal the union of helper_* names EMITTED — nothing defined-but-orphaned,
#    nothing emitted-but-missing.
_sec_helpers="$(grep -oE '^helper_[a-z0-9_]+\(\) \{' <<<"$AE_SOURCE" | sed 's/() {//' | sort -u)"
_emit_helpers="$(tr ' ' '\n' <<<"$_emit_lists" | grep '^helper_' | sort -u)"
assert_eq "emissions: template helper_* set == emitted helper_* set" \
    "$_sec_helpers" "$_emit_helpers"

# 4. TRANSITIVE CLOSURE — referenced implies available, for EVERY artifact.
#
# The failure this kills has now shipped three times (register-sid's missing
# shims, _ae_yesterday, _agents_alert_reasons): a function is emitted into an
# artifact, it calls a second ae function, and nothing emits THAT one. The
# artifact still generates, still runs, and the missing call yields "command not
# found" on stderr the helper discards — an empty string and rc 0. Guards that
# only check emitted-names-are-defined cannot see it; the previous guard checked
# it for the watchdog alone.
#
# For each generated artifact: available = its own declare -f list + _lib's list
# when its prologue sources _lib + any function its prologue defines outright.
# Then walk the call graph from its own list to a FIXPOINT — every function that
# can run inside the artifact must have all of ITS callees available too.
# ── EMISSION CLOSURE: analysed on the GENERATED ARTIFACTS ────────────
# Every function an artifact can run must be defined in that artifact.
#
# This guard used to reconstruct the generated files by re-lexing ae's
# GENERATOR source — inferring heredoc bodies, printf payloads, group
# boundaries and prologue definitions. That is a bash-emulator problem with an
# unbounded adversarial surface, and it produced eleven distinct under-reads:
# truncated lists, boundary-mismatched patterns, a dropped final line,
# generator text taken for generated text, first-match specimens, unbounded
# group scope, greedy literals, skipped shims, stolen group starts, invented
# line boundaries, and non-heredoc-aware prologue parsing. Each fix was correct
# and the next seed found another hole, because the specimen was wrong.
#
# So the specimen changed. ae's REAL generator now writes REAL artifacts into an
# isolated home, and every question is answered from the bytes that actually
# run, by bash itself:
#   syntax          -> bash -n on the generated file
#   what is defined -> source it in a sandbox, ask declare -F
#   what it calls   -> lex declare -f canonical re-prints, never raw source
#   does it get _lib -> it sourced _lib or it did not; declare -F shows the
#                       result, so the grant is observed rather than inferred
# Reconstruction, grouping and printf semantics are gone from the guard.
_gen_root="$(mktemp -d /tmp/aeclosure.XXXXXX)"
# Isolation: HOME and AE_HOME are assigned in SEPARATE statements from the
# literal temp path. `export HOME=x AE_HOME="$HOME/.ae"` expands $HOME BEFORE
# assigning it and writes to the REAL ~/.ae (AGENTS.md, shipped twice).
_gen_home="$_gen_root/home"
_gen_dir="$_gen_home/.ae/sessions/closure"
mkdir -p "$_gen_dir"
cat >"$_gen_dir/meta" <<'CLOSUREMETA'
session=closure
dir=/tmp
mode=local
created=2026-08-02T00:00:00Z
tmux_server=
agent.main=claude:lead:00000000-0000-0000-0000-000000000001
agent.worker.0=codex:builder:00000000-0000-0000-0000-000000000002
CLOSUREMETA
# AE_CLOSURE_BIN is a probe seam: it lets this block be run standalone against
# a seeded copy of ae, which is how the seed battery reads the DETECTOR'S own
# verdict rather than the suite's exit code (some seeds are runtime-fatal and
# kill the suite before it ever reaches this guard).
env HOME="$_gen_home" AE_HOME="$_gen_home/.ae" \
    "${AE_CLOSURE_BIN:-$(dirname "$0")/../ae}" doctor --refresh closure \
    >"$_gen_root/refresh.log" 2>&1 && _refresh_rc=0 || _refresh_rc=$?

# Generation completeness. rc is RECORDED, not asserted zero: `doctor` also
# reports unrelated liveness findings for a session that is not on any tmux
# server, so rc 1 is normal here. What must hold is that the refresh step
# itself succeeded and produced the EXACT artifact set — an aborted refresh
# leaves a plausible-looking partial directory, and a ">= N" check passes over
# it happily.
#
# Note for anyone seeding this: injecting a bare `false` into the generator
# does NOT truncate generation. sync runs as an if-condition, so errexit is
# suppressed for the whole call, and the last artifact (watchdog) has already
# landed by then anyway. To seed incomplete generation, stop an artifact from
# landing at all — then the exact-manifest assertion is what catches it.
assert_eq "closure: the refresh step reported success" "1" \
    "$(grep -q 'refreshed session helpers' "$_gen_root/refresh.log" && echo 1 || echo 0)"
assert_eq "closure: refresh rc is recorded (0 or the known liveness-warning 1)" "1" \
    "$([[ "$_refresh_rc" == 0 || "$_refresh_rc" == 1 ]] && echo 1 || echo 0)"
_manifest_want="_lib _register-sid agents ask events-tail focus goal interrupt loop mark-done memo peak peek reply requests retire review say send spawn state watchdog"
_manifest_got="$(
    cd "$_gen_dir" || exit 0
    for _mf in *; do
        case "$_mf" in meta | meta.lock | workspace.md) continue ;; esac
        printf '%s\n' "$_mf"
    done | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'
)"
assert_eq "closure: generator produced the EXACT artifact manifest" \
    "$_manifest_want" "$_manifest_got"

# Grants read off the ground truth: the generated file either carries the
# source line or it does not. _register-sid deliberately does not (AGENTS.md).
assert_eq "closure: a helper really sources _lib in the generated file" "1" \
    "$(grep -qxF 'source "$(cd "$(dirname "$0")" && pwd)/_lib"' "$_gen_dir/send" && echo 1 || echo 0)"
assert_eq "closure: _register-sid really does not source _lib" "0" \
    "$(grep -qxF 'source "$(cd "$(dirname "$0")" && pwd)/_lib"' "$_gen_dir/_register-sid" && echo 1 || echo 0)"

# The ONLY artifacts allowed to define nothing. Anything else that defines
# nothing is a broken emission, not a shim — a `send` emitted with a no-op
# dispatch would otherwise read perfectly clean.
_closure_shims="loop mark-done peak"

# Per-probe bound, only where the tool exists. `timeout` is optional in ae
# (absent on macOS by default, and absent on this box) — guarded with
# command -v and degraded rather than hard-required, per AGENTS.md.
_closure_tmo=()
if command -v timeout >/dev/null 2>&1; then _closure_tmo=(timeout 30); fi

# ── callee lexer: END-OF-LIFE, DO NOT EXTEND ────────────────────────
# Recorded ruling (2026-08-02): this hand-written lexer over canonical
# `declare -f` output is the last hand-rolled parser in the guard, and it is
# where the final three defects of the night lived. Its remaining failures are
# a QUOTE-AWARENESS dimension — a quoted operand that merely LOOKS like shell
# syntax arms the matcher — and that dimension is unbounded, so the next patch
# would be #14 of the same class. The component is therefore frozen: its
# replacement (a real parser) is queued as a DESIGN DECISION, because a parser
# means shfmt-AST or a python-tier walker and tests/unit's "bash, no deps"
# contract is not ours to amend.
#
# DO NOT PATCH THESE. The two known specimens are pinned as assertions below,
# deliberately asserting the WRONG-BUT-CURRENT behaviour so they turn hard-red
# the day a quote-aware replacement lands:
#     A. a quoted operand that looks like an opener:  command echo "<<FAKE_H"
#     B. a fake and a real opener on one line:        command echo "<<FAKE_H" <<REAL
#
# Everything else in this guard is generated-artifact ground truth; this is the
# one remaining place that reads shell text as text.
_closure_strip_heredocs() {
    # LC_ALL=C: `declare -f` re-prints ae_sanitize_utf8's 0x80-0xFF bracket
    # literals as RAW bytes, and a multibyte-aware awk refuses them
    # ("towc: multibyte conversion failure"), truncating the body stream at that
    # function. Every canonical-body stage runs in byte semantics for that
    # reason — see the doctrine note at the closure guard.
    LC_ALL=C awk '
        nq > 0 {
            t = $0
            if (dash[qi]) { sub(/^\t+/, "", t) }
            if (t == q[qi]) { qi++; if (qi > nq) { nq = 0; qi = 1 } }
            next
        }
        {
            rest = $0
            # Neutralise herestrings FIRST. `match()` scans forward, so on
            # `<<< "$s"` it starts at the SECOND `<`, reads `<< "$s"` as a
            # heredoc opener, and arms the filter with a delimiter that never
            # arrives — swallowing every remaining line of every body. ae is
            # full of `<<<`, so this silently emptied the whole analysis.
            gsub(/<<</, "@@@", rest)
            nq = 0; qi = 1
            while (match(rest, /<<-?[ \t]*("[^"]*"|\047[^\047]*\047|[A-Za-z_][A-Za-z0-9_.-]*)/)) {
                tok = substr(rest, RSTART, RLENGTH)
                d = (tok ~ /^<<-/) ? 1 : 0
                sub(/^<<-?[ \t]*/, "", tok)
                gsub(/^["\047]|["\047]$/, "", tok)
                nq++; q[nq] = tok; dash[nq] = d
                rest = substr(rest, RSTART + RLENGTH)
            }
            print
        }'
}

# Command position over canonical re-prints: plain, $( ), backtick, and both
# directions of process substitution.
_closure_tokens() {
    # STATUS, not a flag. The previous version set _CLOSURE_LEX_ERR from inside
    # `{ ... } | sed` — the left side of a pipeline is a SUBSHELL — and this
    # function is itself called through $( ), another subshell. The write could
    # never reach the reader, so a real grep rc=2 arrived as rc 0 with an empty
    # flag. Who writes it, who reads it, same process? It was not.
    # Each stage now runs in THIS shell with its status inspected, and the
    # function RETURNS non-zero so the caller can see the failure.
    local _b _one _rc _st=0 _out="" _pat _norm
    _b="$(cat)"
    for _pat in \
        '\$\([a-z_][a-zA-Z0-9_]*' \
        '[<>]\([a-z_][a-zA-Z0-9_]*' \
        '`[a-z_][a-zA-Z0-9_]*' \
        '(^|[ \t;&|(])[a-z_][a-zA-Z0-9_]*([ \t;&]|$)'; do
        # Declaration and assignment are split on purpose: `local x="$(cmd)"`
        # reports the status of `local`, never of cmd.
        # `x="$(cmd)"` is a FAILING COMMAND under set -e: the shell aborts
        # before $? is ever read, so the status can only be captured from a
        # context where errexit is suspended. An `if` condition is such a
        # context; a bare assignment is not.
        if _one="$(LC_ALL=C grep -oE "$_pat" <<<"$_b")"; then
            _rc=0
        else
            _rc=$?
        fi
        # grep: 0 matched, 1 no match (legitimate), 2+ a real error.
        ((_rc <= 1)) || _st=1
        [[ -n "$_one" ]] && _out+="$_one"$'\n'
    done
    ((_st == 0)) || return 2
    _norm="$(LC_ALL=C sed -E 's/^[^a-zA-Z_]+//; s/[^a-zA-Z0-9_]+$//' <<<"$_out")" || return 2
    LC_ALL=C sort -u <<<"$_norm" || return 2
    return 0
}

# ── PINNED KNOWN EDGES of the end-of-life lexer ─────────────────────
# These assert the WRONG-BUT-CURRENT behaviour on purpose. They are the visible
# form of the limitation — a quote-unaware filter drops every line after a
# quoted operand that merely looks like a heredoc opener, so a real call there
# goes unreported. Pinning them means the edge is documented and bounded rather
# than silently fail-open, AND that the day a quote-aware replacement lands
# these turn hard-red and force their own removal. Do not "fix" the lexer to
# make them pass; that is the patch the ruling forbids.
printf 'NOTE: closure lexer carries 2 PINNED known edges (quote-awareness). The\n' >&2
printf '      component is end-of-life; its replacement is a queued design\n' >&2
printf '      decision (shfmt-AST / python walker / amend the no-deps line).\n' >&2
printf '      See "closure lexer KNOWN EDGE" assertions in tests/unit.\n' >&2

_spec_a='    command echo "<<FAKE_H";
    real_call_a;'
assert_eq "closure lexer KNOWN EDGE A [END-OF-LIFE, do not patch]: a quoted \"<<TAG\" operand swallows the rest of the function" \
    "command" \
    "$(printf '%s\n' "$_spec_a" | _closure_strip_heredocs | _closure_tokens | tr '\n' ' ' | sed 's/ *$//')"

_spec_b='    command echo "<<FAKE_H" <<REAL;
payload_line;
REAL
    real_call_b;'
assert_eq "closure lexer KNOWN EDGE B [END-OF-LIFE, do not patch]: a fake opener alongside a real one loses the real terminator" \
    "command" \
    "$(printf '%s\n' "$_spec_b" | _closure_strip_heredocs | _closure_tokens | tr '\n' ' ' | sed 's/ *$//')"

# Control: the pins above must not be satisfiable by the filter simply doing
# nothing, or by it eating everything. A genuine heredoc still yields the call
# that follows it.
_spec_c='    command cat <<REAL;
payload_line;
REAL
    real_call_c;'
assert_eq "closure lexer control: a REAL heredoc still yields the call after its terminator" \
    "command real_call_c" \
    "$(printf '%s\n' "$_spec_c" | _closure_strip_heredocs | _closure_tokens | tr '\n' ' ' | sed 's/ *$//')"

_closure_missing=""
_gen_bad=""
_gen_seen=0
_CLOSURE_LEX_ERR=""
for _af in "$_gen_dir"/*; do
    [[ -f "$_af" ]] || continue
    _an="$(basename "$_af")"
    case "$_an" in
        meta | meta.lock | workspace.md | *.lock | *.jsonl | *.tsv | *.sid) continue ;;
    esac
    # bash is the syntax authority for a file bash will run.
    if ! "${BASH:-bash}" -n "$_af" 2>/dev/null; then
        _gen_bad+="${_an}:syntax "
        continue
    fi
    # `declare -f` re-prints a definition as `name () ` at column 0.
    if ! grep -qE '^[a-z_][a-zA-Z0-9_]* \(\) $' "$_af"; then
        case " $_closure_shims " in
            *" $_an "*) continue ;;
            *)
                _gen_bad+="${_an}:defines-nothing "
                continue
                ;;
        esac
    fi
    # Strip the trailing dispatch call so sourcing DEFINES without RUNNING —
    # and REMEMBER the name, because stripping it is exactly what would hide a
    # dispatch that calls something the artifact never defines.
    _tail="$(tail -1 "$_af")"
    _tailfn=""
    if [[ "$_tail" =~ ^([a-z_][a-zA-Z0-9_]*)\ \"\$@\"$ ]]; then
        _tailfn="${BASH_REMATCH[1]}"
        sed '$d' "$_af" >"$_gen_dir/.closure_src"
    elif [[ "$_an" == "_lib" ]]; then
        cp "$_af" "$_gen_dir/.closure_src" # a library: no dispatch tail by design
    else
        _gen_bad+="${_an}:unknown-tail "
        continue
    fi
    _gen_seen=$((_gen_seen + 1))
    # Ask bash what this artifact defines and what those definitions contain.
    # Sourcing reproduces the real availability set INCLUDING whatever _lib the
    # artifact chose to source — the grant is a consequence, not an inference.
    #
    # TRUST BOUNDARY, stated deliberately: the input here is ae's OWN generated
    # output, and the threat model is an ACCIDENTAL shape in trusted code (a
    # helper that shadows a name, a definition that vanishes), not hostile code.
    # So this is env -i plus `builtin`-prefixed introspection — enough that a
    # shadowed `declare` cannot poison the primitives the probe reads with — and
    # deliberately NOT a sandbox: no primitive-rejection list, no fs or network
    # jail. Those would be the wrong cost for this threat model, and would rot.
    _probe="$(
        cd "$_gen_dir" && "${_closure_tmo[@]}" env -i \
            PATH="$PATH" HOME="$_gen_home" AE_HOME="$_gen_home/.ae" \
            "${BASH:-bash}" -c '
            builtin set +eu
            # $0 IS the artifact path — a helper resolves its own _lib via
            # dirname "$0", so probing with bash'"'"'s own $0 made every artifact
            # look for _lib next to the bash binary and silently define nothing
            # from it. This is how a real invocation sees itself.
            #
            # EVERY primitive the probe reads with is qualified — builtin for
            # shell builtins, command for externals. Half-qualifying is not a
            # weaker version of this, it is a hole: an awk() shadow that
            # delegates to `command awk` and appends one extra name makes
            # declare -F report a definition that does not exist, and a real
            # missing callee then reads as available.
            # shellcheck disable=SC1090
            builtin source "$0" >/dev/null 2>&1
            _fns="$(builtin declare -F | command awk "{print \$3}")"
            builtin printf "===DEFS===\n%s\n===BODIES===\n" "$_fns"
            for _f in $_fns; do builtin declare -f "$_f"; done
        ' "$_gen_dir/.closure_src" </dev/null 2>/dev/null
    )"
    _defs="$(LC_ALL=C awk '/^===DEFS===$/{f=1;next} /^===BODIES===$/{exit} f' <<<"$_probe")" ||
        _CLOSURE_LEX_ERR="defs-extract"
    if [[ -z "$_defs" ]]; then
        _gen_bad+="${_an}:no-definitions "
        continue
    fi
    # The dispatch target must actually exist, and be THIS artifact's main.
    if [[ -n "$_tailfn" ]]; then
        grep -qxF "$_tailfn" <<<"$_defs" ||
            _gen_bad+="${_an}:dispatch-undefined(${_tailfn}) "
        _expect="helper_$(printf '%s' "${_an#_}" | tr '-' '_')_main"
        [[ "$_tailfn" == "$_expect" ]] ||
            _gen_bad+="${_an}:dispatch-name(${_tailfn}!=${_expect}) "
    fi
    # Canonical bodies, with heredoc PAYLOADS dropped: `declare -f` re-prints a
    # heredoc verbatim, and its data lines are not code — lexing them reports
    # calls that cannot happen. The opener line itself is kept (it can carry a
    # real call before the <<).
    # No `|| true` in guard plumbing: a stage that fails must be an ERROR, not an
    # empty body that reads as "calls nothing". Comment-stripping uses awk rather
    # than grep -v precisely so that "no lines left" is not a non-zero exit.
    _bodies="$(LC_ALL=C awk '/^===BODIES===$/{f=1;next} f' <<<"$_probe")" ||
        _CLOSURE_LEX_ERR="bodies-extract"
    _bodies="$(_closure_strip_heredocs <<<"$_bodies")" ||
        _CLOSURE_LEX_ERR="heredoc-strip"
    _bodies="$(LC_ALL=C awk '!/^[[:space:]]*#/' <<<"$_bodies")" ||
        _CLOSURE_LEX_ERR="comment-strip"
    if _toks="$(_closure_tokens <<<"$_bodies")"; then
        _tok_rc=0
    else
        _tok_rc=$?
    fi
    ((_tok_rc == 0)) || _CLOSURE_LEX_ERR="tokens rc=${_tok_rc} (${_an})"
    # comm's status is captured by MATERIALISING its output first. Reading the
    # loop straight from `< <(comm ...)` discarded that status entirely, so a
    # comm error was indistinguishable from "no functions in common". The two
    # inputs remain process substitutions — they are printf of in-memory
    # strings; the CHECKED command is comm itself.
    if _pairs="$(LC_ALL=C comm -12 <(printf '%s\n' "$_toks") <(printf '%s\n' "$_ae_fns"))"; then
        _comm_rc=0
    else
        _comm_rc=$?
    fi
    ((_comm_rc == 0)) || _CLOSURE_LEX_ERR="comm rc=${_comm_rc} (${_an})"
    while IFS= read -r _cal; do
        [[ -n "$_cal" ]] || continue
        LC_ALL=C grep -qxF "$_cal" <<<"$_defs" && continue
        _closure_missing+="${_an}->${_cal} "
    done <<<"$_pairs"
done
rm -rf "$_gen_root"

# DOCTRINE: stderr noise in a GREEN run is signal. This guard used to print
# "awk: towc: multibyte conversion failure" fifteen times per run while
# reporting a clean closure — the body stream was truncating at
# ae_sanitize_utf8 and three functions went unanalysed. Behaviourally: a
# violation seeded inside ae_sanitize_utf8 was CAUGHT under ambient LC_ALL=C and
# reported CLEAN under ambient en_US.UTF-8. A lexer stage that fails is now an
# asserted error, never an empty body.
assert_eq "closure: no lexer stage failed (an error is not an empty body)" \
    "" "$_CLOSURE_LEX_ERR"
assert_eq "closure: every generated artifact analysed cleanly" "" "$_gen_bad"
assert_eq "closure: every non-shim artifact was analysed" "19" "$_gen_seen"
assert_eq "closure: every function a generated artifact can run is defined in it" \
    "" "$_closure_missing"


# ── portability: no raw GNU-only coreutils outside the shims ─────────
# Each form below fails SILENTLY on BSD/macOS — the command errors, the
# `|| fallback` value lands, and the feature reads as "nothing found" rather
# than "broken". That whole class shipped (see AGENTS.md > GNU vs BSD
# userland). The shims at the top of ae own the legitimate uses; a line
# carrying its OWN BSD fallback (the ssh heredocs, which run on the remote
# host, and the telegram daemon's standalone copy) is allowed too.
_port_src="$(awk '
    /^# --- Portability shims/ { inshim = 1 }
    /^# --- Function index ---/ { inshim = 0 }
    /^_stat_field\(\) \{/ { daemon = 1 }
    daemon && /^\}$/ { daemon = 0; next }
    !inshim && !daemon { print }
' <<<"$AE_SOURCE" | grep -vE '^[[:space:]]*#' |
    # Join `||`/`\`-continued lines so a GNU call and its BSD fallback on the
    # next line read as ONE line — otherwise every multi-line fallback trips.
    awk '{ buf = buf $0; if ($0 ~ /(\|\||\\)[[:space:]]*$/) next; print buf; buf = "" }
         END { if (buf != "") print buf }')"
_port_bad=""
_port_flag() { # <label> <bad-pattern> [allowed-when-line-also-matches]
    local hits
    hits="$(grep -E "$2" <<<"$_port_src" || true)"
    if [[ -n "${3:-}" && -n "$hits" ]]; then hits="$(grep -vE "$3" <<<"$hits" || true)"; fi
    [[ -n "$hits" ]] && _port_bad+="$1 "
    return 0
}
# Options are ORDER-INDEPENDENT: `date -u -d` and `sed -E -i` are the same
# GNU-only calls as `date -d` / `sed -i`, and patterns anchored to the canonical
# order let them through unflagged. `([[:space:]]+-[^[:space:]]+)*` skips any
# leading option run. Every rule lives in this ONE function so the mutation
# tests below exercise the patterns the real check uses, not a copy that rots.
# CMD followed by any option words, where some option word is a short-option
# cluster containing FLAG. What may follow FLAG is PER COMMAND — a single
# word-final rule is wrong in both directions:
#
#   arg       the flag takes an argument, which GNU allows ATTACHED:
#             `stat -c%Y`, `stat -Lc%Y`, `date -dyesterday`, `date -udyesterday`.
#             Nothing may be required after the letter.
#   noarg     the flag takes NO argument, so cluster letters may legally FOLLOW
#             it: `grep -Po`, `grep -Pz` as well as `grep -oP`.
#   wordfinal the argument must be separate — but `-i''` and `-i""` DO count,
#             because the shell strips the quotes and what reaches sed is a bare
#             `-i`, which is the GNU-only spelling that breaks BSD. `-i.bak`
#             stays deliberately quiet (accepted risk: narrowing it trades a
#             false negative for false positives on forms like `grep -e`).
#
# The leading group is a shell TOKEN start, not an identifier boundary. An
# identifier boundary ([^[:alnum:]_]) treats `-` and `.` as separators, so
# `iso-date -d`, `not.date -d`, `unused-sed -i` and `pcre-grep -Po` all matched
# the command name inside a LONGER name. A command token begins at start of
# line or after whitespace or a shell operator, and may carry a PATH prefix —
# so `/usr/bin/date -d` is still caught (the prefix must end in `/`, which no
# suffix-named command does).
_port_optflag() { # <cmd> <flag> <arg|noarg|wordfinal> -> ERE
    local tail
    case "$3" in
        arg) tail='' ;;
        noarg) tail='[a-zA-Z]*([[:space:]]|$)' ;;
        wordfinal) tail="([[:space:]]|\$|''|\"\")" ;;
        *)
            echo "_port_optflag: bad mode '$3'" >&2
            return 1
            ;;
    esac
    # token start | optional path prefix ending in / | command | option words
    printf '(^|[[:space:]]|[|&;(`])([^[:space:]|&;(`]*/)?%s([[:space:]]+-[^[:space:]]+)*[[:space:]]+-[a-zA-Z]*%s%s' \
        "$1" "$2" "$tail"
}
_port_run_flags() {
    # Inline exemption marker, dropped HERE rather than in the _port_src
    # pipeline so the mutation harness below exercises this rule too — a filter
    # that only the real run passes through is a rule no test can falsify.
    # Applied to the already-joined line, so one marker covers one logical line.
    # Unlike a pattern-shaped allow, a marker cannot accidentally cover a
    # DIFFERENT violation that merely shares the line: it is a reviewed
    # statement about that line, and the count is pinned above.
    local _raw="$_port_src"
    local _port_src
    _port_src="$(grep -v 'port-ok:' <<<"$_raw" || true)"
    # No pair-shape exemption. A generic `GNU || BSD` allow could not tell an
    # EQUIVALENT pair from a mismatched one (`stat -c %Y fileA || stat -f %z
    # fileB` passed), one valid pair on a line suppressed every OTHER hit on
    # that line, and `mystat -f` counted as a fallback. Exemption is now an
    # explicit reviewed marker on the line itself (see _port_src).
    _port_flag stat-c "$(_port_optflag stat c arg)"
    # NO allow-list. The only legitimate GNU/BSD date pair in ae lives behind
    # _ae_yesterday (inside the shim region, excluded below). An exemption here
    # would have to be wide enough to also pass NON-equivalent pairs such as
    # `date -u -d '2 days ago' || date -u -v-1d`, whose branches disagree.
    _port_flag date-d "$(_port_optflag date d arg)"
    _port_flag tac '(^|[ (|])tac[ "]' 'command -v tac'
    _port_flag sed-i "$(_port_optflag sed i wordfinal)"
    _port_flag grep-oP "$(_port_optflag grep P noarg)"
    _port_flag md5sum '(^|[ (|])md5sum([ |]|$)' 'command -v md5sum'
    # /proc/sys/kernel/random/uuid is the one allowed read: existence-guarded,
    # with a uuidgen fallback. Any OTHER /proc path is Linux-only and silently empty.
    _port_flag proc '/proc/' '/proc/sys/kernel/random/uuid'
    _port_flag readlink-f 'readlink -f' 'realpath'
    _port_flag find-printf 'find .* -printf'
    grep -qF '\(^\|' <<<"$_port_src" && _port_bad+="sed-BRE-alternation "
    # GNU-only sed regex/replacement escapes (\s \+ \? \b \w, and \n on the RHS).
    grep -qE 'sed [^|]*\\[snbw+?]' <<<"$_port_src" && _port_bad+="sed-GNU-escape "
    return 0
}
_port_run_flags
