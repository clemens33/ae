# ── round 3: a fact observed twice is two facts ──────────────────────────────────
# These drive the REAL cmd_end confirmation path with a STATEFUL planner — one that
# answers differently on each call — because that is the only shape that can tell "the
# prompt and the contract came from one observation" apart from "they happened to agree".
eval "$(awk '/^cmd_end\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"

_ar48_confirm_probe() { # <target> <sessions...> -> what was rendered + what was frozen
    (
        declare -A _AE_END_FROZEN_PLAN=()
        declare -A _AE_END_FROZEN_AUTHORITY=()
        declare -a _AE_END_CONFIRMED_TARGETS=()
        _AE_END_PLAN_LINE=""
        # The call counter lives in a FILE because the planner is read through a process
        # substitution — a fork — so a shell variable it increments would not come back.
        # That is the same property that makes the freeze itself impossible to do there,
        # which is the whole point of this probe.
        local _probe_calls="${TMPDIR:-/tmp}/ae48-plancalls.$$"
        : >"$_probe_calls"
        local _probe_target="$1"
        shift
        local -a _probe_sessions=("$@")
        # A planner whose answer CHANGES on every call. If the prompt and the freeze are
        # two observations, they land on different answers and this test says so.
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        _end_archive_plan() {
            printf 'x' >>"$_probe_calls"
            local _n
            _n="$(wc -c <"$_probe_calls" | tr -d '[:space:]')"
            if ((_n % 2 == 1)); then
                printf 'keep\t/arch/%s\tfalse\n' "$1"
            else
                printf 'purge\t/arch/%s\ttrue\n' "$1"
            fi
        }
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        _end_target_class() { printf 'live'; }
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        _end_will_push() { printf ''; }
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        list_ae_sessions() { printf '%s\n' "${_probe_sessions[@]}"; }
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        iter_stopped_sessions() { :; }
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        end_session() { printf 'ENDED %s\n' "$1"; }
        # Output goes to a FILE, not through a pipe or $(…). Both of those fork, and the
        # freeze this probe exists to observe is an assoc-array write that cannot survive
        # a fork — the probe would have reproduced the very defect it is checking for.
        local out outfile="${TMPDIR:-/tmp}/ae48-confirm.$$.out"
        cmd_end "$_probe_target" <<<'n' >"$outfile" 2>&1 || true
        out="$(cat "$outfile")"
        rm -f "$outfile"
        printf 'RENDERED:%s\n' "$(grep -c 'archive -> ' <<<"$out" | tr -d '[:space:]')"
        printf 'PLAN_CALLS:%s\n' "$(wc -c <"$_probe_calls" | tr -d '[:space:]')"
        rm -f "$_probe_calls"
        local k
        for k in "${!_AE_END_FROZEN_PLAN[@]}"; do
            printf 'FROZEN:%s=%s\n' "$k" "${_AE_END_FROZEN_PLAN[$k]//$'\t'/|}"
        done
        printf 'TARGETS:%s\n' "${#_AE_END_CONFIRMED_TARGETS[@]}"
        printf 'PROMPT:%s\n' "$(grep -c 'ARCHIVES the session' <<<"$out" | tr -d '[:space:]')"
    )
}

