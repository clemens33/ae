assert_eq "quiet_decision: pane changed since baseline yields" "yield" \
    "$(_quiet_pane_decision "hashC" "$KEY1" "hashB" "$KEY1")"

# Same-second re-declare (codex IMPORTANT): a fresh declaration that differs only
# in summary must re-arm even though the timestamp is identical — otherwise it
# would inherit the prior (yielded) baseline and never suppress.
assert_eq "quiet_decision: same-second re-declare (diff summary) re-arms" "arm" \
    "$(_quiet_pane_decision "hashD" "$KEY1" "hashB" "$KEY2")"
unset KEY1 KEY2

# Branch-sequence model (codex IMPORTANT): the real watchdog flow. Walks the
# arm→hold→yield transitions a pane goes through, proving the declaration's own
# echo does NOT defeat the quiet state (the bug the baseline design fixes).
_qbkey=""  # armed declaration key (per-pane state the watchdog keeps)
_qbhash="" # armed baseline hash
_key="state|2026-01-01T00:00:00Z|waiting-user|claude:lead|need input"
# prior hash A → agent runs `state waiting-user`, echo changes pane to B.
# Cycle 1: first sighting of the declaration, current hash B → arm + baseline B.
_d="$(_quiet_pane_decision "hashB" "$_qbkey" "$_qbhash" "$_key")"
assert_eq "quiet_seq: cycle1 arms on first declaration sighting" "arm" "$_d"
[[ "$_d" == "arm" ]] && { _qbkey="$_key"; _qbhash="hashB"; }
# Cycle 2: pane still B (agent idle, waiting) → hold (suppress) despite the echo.
assert_eq "quiet_seq: cycle2 holds while pane stays at the echoed baseline" "hold" \
    "$(_quiet_pane_decision "hashB" "$_qbkey" "$_qbhash" "$_key")"
# Cycle 3: human replies in-pane → hash C → yield → watchdog falls through.
assert_eq "quiet_seq: cycle3 yields once the human changes the pane" "yield" \
    "$(_quiet_pane_decision "hashC" "$_qbkey" "$_qbhash" "$_key")"
