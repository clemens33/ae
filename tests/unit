        echo '{"ts":"2026-08-01T00:08:00Z","actor":"codex:colead","action":"reply","ref":"req-3","target":"claude:lead","actor_slot":"worker.0","target_slot":"main","actor_session":"demo","target_session":"demo","summary":"the real answer"}'
        echo '{"ts":"2026-08-01T03:00:00Z","actor":"claude:lead","action":"state","ref":"working","summary":"on the slice"}'
        echo '{"ts":"2026-08-01T03:01:00Z","actor":"codex:colead","action":"state","ref":"blocked","summary":"waiting on review"}'
