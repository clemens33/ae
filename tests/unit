assert_eq "transfer-orch: SSH-quoting fix — session value interpolated into stdin (not positional)" "1" "$_orch_session_in_stdin"

# No `bash -s --` (positional-arg-passing) should remain in cmd_transfer or
# any _transfer_* helper. SSH argv is not preserved — every value must go
# through the %q-quoted-stdin pattern.
_t_bad_argv="$(awk '
    /^cmd_transfer\(\)|^_transfer_/ { in_fn=1 }
    in_fn && /^\}$/ { in_fn=0 }
    in_fn && /bash -s --/ { print NR }
' "$(dirname "$0")/../ae")"
assert_eq "transfer-orch: SSH-quoting fix — no bash -s -- argv passing in transfer code" "" "$_t_bad_argv"

# Per-agent rsync invocations — one for claude, one for codex.
_orch_claude_rsync_seen=0 _orch_codex_rsync_seen=0
for entry in "${ORCH_CALL_LOG[@]}"; do
    [[ "$entry" == "rsync: "*".claude/projects"*"$_orch_claude_uuid.jsonl"* ]] && _orch_claude_rsync_seen=1
    [[ "$entry" == "rsync: "*".codex/sessions"*"$_orch_codex_uuid"* ]] && _orch_codex_rsync_seen=1
