_ta_mutated_body="${_tmux_attach_body//exec command tmux/exec tmux}"
_ta_mutation_structural="$(grep -Eq '^[[:space:]]*exec tmux ' <<<"$_ta_mutated_body" && echo RED || echo GREEN)"
