# ── lead-default Part 1: DEFAULT_CONFIG — model-named aliases, strict pins ──
# Extract the DEFAULT_CONFIG string from source, parse it with the real get_config.
# End on the FIRST line ending in a single quote (the closing quote), not a content
# sentinel — the value grew a trailing [prompt] section, and a fixed last-line marker
# would silently over-capture into ae's code if the layout shifts again.
eval "$(awk '/^DEFAULT_CONFIG=\047/{p=1} p{print} p&&/\047$/{exit}' <<<"$AE_SOURCE")"
_dc_cfg="$(mktemp)"
printf '%s\n' "$DEFAULT_CONFIG" >"$_dc_cfg"
_dc_xdg="$(mktemp -d)"
_dc_get() { CONFIG_FILE="$_dc_cfg" AE_LOCAL_CONFIG="" XDG_RUNTIME_DIR="$_dc_xdg" get_config "$1"; }
# SPEC (identity v2): the seats are NAMES bound in [roster]; `main`/`workers` never
# carry a profile again. `alias:name` in a seat is the exact spelling v2 refuses.
assert_eq "default-config: main = the lead NAME alone (never profile:name)" "lead" "$(_dc_get workspace.main)"
# The standing roster is the JUDGMENT PAIR only (f07ec5f): builders and reviewers
# are spawned per slice and retired when the work is verified, so worker.0 — the
# colead seat — is the whole default worker list.
assert_eq "default-config: workers = the colead seat alone (builders/reviewers are spawned)" \
    "colead" "$(_dc_get workspace.workers)"
assert_eq "default-config: layout = lead-pair" "lead-pair" "$(_dc_get workspace.layout)"
# v2: every seat name is bound to a profile in [roster], and the binding is what
# carries the tool. A seat with no [roster] row would refuse the launch.
assert_eq "default-config: [roster] binds lead → fable5" "fable5" "$(_dc_get roster.lead)"
assert_eq "default-config: [roster] binds colead → gpt56sol" "gpt56sol" "$(_dc_get roster.colead)"
# The legacy section is GONE from the shipped default — a file carrying [agents] is
# refused at launch, so shipping one would make a fresh install unlaunchable.
assert_eq "default-config: no [agents] section survives (v2 refuses it at launch)" "0" \
    "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -c '^\[agents\]')"
assert_eq "default-config: the profiles section is the one command table" "1" \
    "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -c '^\[profiles\]')"
# STRICT model pins — a model-named PROFILE must never silently run another model.
assert_eq "default-config: opus5 pins exact --model claude-opus-5 (family alias would drift)" "1" "$([[ "$(_dc_get profiles.opus5)" == *'--model claude-opus-5'* ]] && echo 1 || echo 0)"
assert_eq "default-config: fable5 defined + pins --model fable (premium tier)" "1" "$([[ "$(_dc_get profiles.fable5)" == *'--model fable'* ]] && echo 1 || echo 0)"
assert_eq "default-config: sonnet5 pins --model sonnet" "1" "$([[ "$(_dc_get profiles.sonnet5)" == *'--model sonnet'* ]] && echo 1 || echo 0)"
assert_eq "default-config: gpt56sol pins gpt-5.6-sol" "1" "$([[ "$(_dc_get profiles.gpt56sol)" == *'gpt-5.6-sol'* ]] && echo 1 || echo 0)"
assert_eq "default-config: gpt56terra pins gpt-5.6-terra" "1" "$([[ "$(_dc_get profiles.gpt56terra)" == *'gpt-5.6-terra'* ]] && echo 1 || echo 0)"
assert_eq "default-config: gpt56luna pins gpt-5.6-luna" "1" "$([[ "$(_dc_get profiles.gpt56luna)" == *'gpt-5.6-luna'* ]] && echo 1 || echo 0)"
# NO profile-definition line uses --model best (comments may mention the anti-pattern).
assert_eq "default-config: no profile uses --model best (strict pins only)" "0" "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -E '^[a-z0-9]+ = ' | grep -c -- '--model best')"
# Old tier-named profiles retired.
assert_eq "default-config: tier profile 'optimal' retired" "" "$(_dc_get profiles.optimal)"
assert_eq "default-config: tier profile 'fast' retired" "" "$(_dc_get profiles.fast)"
# Self-documenting default (P3): the [prompt] section is COMMENTED, so it documents the
