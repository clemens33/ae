# ── doctor --refresh writes the core's helper set ────────────────────
# The EMISSION CLOSURE guard stood here: 375 lines that re-lexed generated
# `declare -f` bodies and walked each artifact's call graph to a fixpoint,
# because a generated helper carried LOGIC and one name dropped from an emission
# list broke it SILENTLY at runtime. B glue cut 2 removed that subject, and
# slice Z2 removed the artifact: a helper is a SYMLINK to the core binary, so
# there is no body to close over and no bash in a session directory at all.
#
# What survives is the one asset job worth pinning here: `doctor --refresh`
# re-linking the set. It is checked END TO END, through the shipped `ae`, on
# what actually lands in a session dir.
_gen_root="$(mktemp -d /tmp/aeclosure.XXXXXX)"
# Isolation: HOME and AE_HOME are assigned in SEPARATE statements from the
# literal temp path. `export HOME=x AE_HOME="$HOME/.ae"` expands $HOME BEFORE
# assigning it and writes to the REAL ~/.ae (AGENTS.md, shipped twice).
_gen_home="$_gen_root/home"
_gen_dir="$_gen_home/.ae/sessions/closure"
mkdir -p "$_gen_dir"
cat >"$_gen_dir/meta" <<'CLOSUREMETA'
session=closure
dir=/tmp
mode=local
created=2026-08-02T00:00:00Z
tmux_server=
schema=2
seat.main=lead
profile.main=claude
agent_bin.main=claude
harness_session.main=00000000-0000-0000-0000-000000000001
seat.worker.0=builder
profile.worker.0=codex
agent_bin.worker.0=codex
harness_session.worker.0=00000000-0000-0000-0000-000000000002
CLOSUREMETA
env HOME="$_gen_home" AE_HOME="$_gen_home/.ae" \
    "${AE_CLOSURE_BIN:-$AE_BIN}" doctor --refresh closure \
    >"$_gen_root/refresh.log" 2>&1 && _refresh_rc=0 || _refresh_rc=$?
# rc is RECORDED, not asserted zero: `doctor` also reports unrelated liveness
# findings for a session that is on no tmux server, so rc 1 is normal here.
assert_eq "refresh: the refresh step reported success" "1" \
    "$(grep -q 'refreshed session helpers' "$_gen_root/refresh.log" && echo 1 || echo 0)"
assert_eq "refresh: rc is recorded (0 or the known liveness-warning 1)" "1" \
    "$([[ "$_refresh_rc" == 0 || "$_refresh_rc" == 1 ]] && echo 1 || echo 0)"
# EXACT, never ">= N": exactness is what makes an artifact quietly appearing or
# vanishing a failure rather than a different number. This list is the core's
# PASSTHROUGH table plus mark-done, the two monitor processes and the two
# aliases; the integration suite proves the LINK TARGETS match what the core
# links at launch.
#
# `_register-sid` IS IN THE SET, and it is the one name here a human never runs.
# It and `_lib` left together when the template library went, but the link it
# was reached through was codex's own handshake: ae tells codex, in its
# developer_instructions, to run `<meta>/_register-sid` as its first action,
# because codex has no launch-time session-id flag and that is the only way its
# UUID reaches meta before a resume needs it. With no entry, that instruction
# named a file that was not there and the handshake was dead.
_manifest_want="_register-sid agents ask events-tail focus goal interrupt loop mark-done memo peak peek reply requests retire review say send spawn state watchdog"
_manifest_got="$(
    cd "$_gen_dir" || exit 0
    for _mf in *; do
        case "$_mf" in meta | meta.lock | workspace.md) continue ;; esac
        printf '%s\n' "$_mf"
    done | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'
)"
assert_eq "refresh: the helper set is exactly the core's" \
    "$_manifest_want" "$_manifest_got"
# THE LINK, on what landed: every name is a symlink (never a regular file, which
# is what a returning generator would leave), its target is the ABSOLUTE path of
# the core that refreshed it, and that target is executable. `readlink` without
# -f deliberately: the pin is the recorded target, not what it resolves through.
_gen_bad=""
for _ga in $_manifest_want; do
    [[ -L "$_gen_dir/$_ga" ]] || { _gen_bad+="${_ga}:not-a-symlink "; continue; }
    [[ "$(readlink "$_gen_dir/$_ga")" == "$AE_CORE_BIN" ]] || _gen_bad+="${_ga}:target "
    [[ -x "$_gen_dir/$_ga" ]] || _gen_bad+="${_ga}:target-not-executable "
done
assert_eq "refresh: every helper is a symlink to the core that refreshed it" \
    "" "$_gen_bad"
# ...and ONE target for all of them. mark-done, peak and loop used to be bodies
# of their own (a prepended word, a sibling exec); since Z2 the aliasing lives in
# the core's argv[0] dispatch, so a second target here means an alias grew a
# body again.
# `grep -c` exits 1 on a zero count, and under `pipefail` that would abort the
# whole suite mid-run rather than fail this one assertion — the long-emitter
# footgun in AGENTS.md. The pipeline owns its own `|| true` for that reason.
_gen_targets="$(
    for _ga in $_manifest_want; do readlink "$_gen_dir/$_ga" || true; done |
        LC_ALL=C sort -u | command grep -c . | tr -d '[:space:]' || true
)"
assert_eq "refresh: all 21 names point at ONE target, aliases included" "1" "$_gen_targets"
# NOTHING IN A SESSION DIRECTORY IS A SCRIPT. The old set was checked for a
# parsable shebang under the oldest bash on the machine; the invariant that
# replaced it is stronger and simpler — no regular executable file at all.
_gen_execfiles=""
for _mf in "$_gen_dir"/*; do
    if [[ ! -L "$_mf" && -f "$_mf" && -x "$_mf" ]]; then
        _gen_execfiles+="${_mf##*/} "
    fi
done
assert_eq "refresh: no generated artifact is an executable file any more" "" "$_gen_execfiles"
unset _gen_targets _gen_execfiles
# THE FULL-PATH RULE. argv[0] carries both facts the core needs — the entry
# (basename) and the session (dirname) — so a helper reached by BARE NAME has no
# session to act on. It refuses rather than guessing at one; a helper that
# guessed would deliver one workspace's message into another. Driven the way it
# actually happens: the session directory on PATH.
_gen_bare_rc=0
_gen_bare_err="$(cd "$_gen_root" && PATH="$_gen_dir:$PATH" send lead hi 2>&1 >/dev/null)" || _gen_bare_rc=$?
assert_eq "refresh: a helper invoked by BARE NAME refuses with exit 2" "2" "$_gen_bare_rc"
assert_eq "refresh: ...and the refusal names the full-path rule" "1" \
    "$([[ "$_gen_bare_err" == *"is a session helper"* && "$_gen_bare_err" == *"full path"* ]] && echo 1 || echo 0)"
# THE CONTROL for that pair: the SAME link, the SAME argv, reached by full path,
# must get past the refusal. Without it "exit 2" could be any failure at all.
_gen_full_err="$("$_gen_dir/send" lead hi 2>&1 >/dev/null || true)"
assert_eq "refresh CONTROL: the same call by full path is not the bare-name refusal" "0" \
    "$([[ "$_gen_full_err" == *"is a session helper"* ]] && echo 1 || echo 0)"
unset _gen_bare_rc _gen_bare_err _gen_full_err
# The manifest is a core render, and refresh must have produced one.
assert_eq "refresh: workspace.md was re-rendered" "1" \
    "$([[ -s "$_gen_dir/workspace.md" ]] && echo 1 || echo 0)"
rm -rf "$_gen_root"

# ── portability: no raw GNU-only coreutils in the installer ──────────
# Each form below fails SILENTLY on BSD/macOS — the command errors, the
# `|| fallback` value lands, and the feature reads as "nothing found" rather
# than "broken". That whole class shipped (see AGENTS.md > GNU vs BSD
# userland).
#
# THE SUBJECT IS `install`, and since slice Z3 it is the whole subject: it is
# the one bash file ae still ships, it runs on both userlands, and it is the
# highest-authority path there is — a silently-wrong install is not a
# diagnosable one. The wrapper this block used to read is deleted, and the
# shim region it excluded went with it; install carries no shims and needs
# none, because every branch it takes on a divergence is an explicit `uname`
# or `command -v` test that this gate can see.
_port_src="$(grep -vE '^[[:space:]]*#' <<<"$AE_INSTALL_SOURCE" |
    # Join `||`/`\`-continued lines so a GNU call and its BSD fallback on the
    # next line read as ONE line — otherwise every multi-line fallback trips.
    awk '{ buf = buf $0; if ($0 ~ /(\|\||\\)[[:space:]]*$/) next; print buf; buf = "" }
         END { if (buf != "") print buf }')"
_port_bad=""
_port_flag() { # <label> <bad-pattern> [allowed-when-line-also-matches]
    local hits
    hits="$(grep -E "$2" <<<"$_port_src" || true)"
    if [[ -n "${3:-}" && -n "$hits" ]]; then hits="$(grep -vE "$3" <<<"$hits" || true)"; fi
    [[ -n "$hits" ]] && _port_bad+="$1 "
    return 0
}
# Options are ORDER-INDEPENDENT: `date -u -d` and `sed -E -i` are the same
# GNU-only calls as `date -d` / `sed -i`, and patterns anchored to the canonical
# order let them through unflagged. `([[:space:]]+-[^[:space:]]+)*` skips any
# leading option run. Every rule lives in this ONE function so the mutation
# tests below exercise the patterns the real check uses, not a copy that rots.
# CMD followed by any option words, where some option word is a short-option
# cluster containing FLAG. What may follow FLAG is PER COMMAND — a single
# word-final rule is wrong in both directions:
#
#   arg       the flag takes an argument, which GNU allows ATTACHED:
#             `stat -c%Y`, `stat -Lc%Y`, `date -dyesterday`, `date -udyesterday`.
#             Nothing may be required after the letter.
#   noarg     the flag takes NO argument, so cluster letters may legally FOLLOW
#             it: `grep -Po`, `grep -Pz` as well as `grep -oP`.
#   wordfinal the argument must be separate — but `-i''` and `-i""` DO count,
#             because the shell strips the quotes and what reaches sed is a bare
#             `-i`, which is the GNU-only spelling that breaks BSD. `-i.bak`
#             stays deliberately quiet (accepted risk: narrowing it trades a
#             false negative for false positives on forms like `grep -e`).
#
# The leading group is a shell TOKEN start, not an identifier boundary. An
# identifier boundary ([^[:alnum:]_]) treats `-` and `.` as separators, so
# `iso-date -d`, `not.date -d`, `unused-sed -i` and `pcre-grep -Po` all matched
# the command name inside a LONGER name. A command token begins at start of
# line or after whitespace or a shell operator, and may carry a PATH prefix —
# so `/usr/bin/date -d` is still caught (the prefix must end in `/`, which no
# suffix-named command does).
_port_optflag() { # <cmd> <flag> <arg|noarg|wordfinal> -> ERE
    local tail
    case "$3" in
        arg) tail='' ;;
        noarg) tail='[a-zA-Z]*([[:space:]]|$)' ;;
        wordfinal) tail="([[:space:]]|\$|''|\"\")" ;;
        *)
            echo "_port_optflag: bad mode '$3'" >&2
            return 1
            ;;
    esac
    # token start | optional path prefix ending in / | command | option words
    printf '(^|[[:space:]]|[|&;(`])([^[:space:]|&;(`]*/)?%s([[:space:]]+-[^[:space:]]+)*[[:space:]]+-[a-zA-Z]*%s%s' \
        "$1" "$2" "$tail"
}
_port_run_flags() {
    # Inline exemption marker, dropped HERE rather than in the _port_src
    # pipeline so the mutation harness below exercises this rule too — a filter
    # that only the real run passes through is a rule no test can falsify.
    # Applied to the already-joined line, so one marker covers one logical line.
    # Unlike a pattern-shaped allow, a marker cannot accidentally cover a
    # DIFFERENT violation that merely shares the line: it is a reviewed
    # statement about that line, and the count is pinned above.
    local _raw="$_port_src"
    local _port_src
    _port_src="$(grep -v 'port-ok:' <<<"$_raw" || true)"
    # No pair-shape exemption. A generic `GNU || BSD` allow could not tell an
    # EQUIVALENT pair from a mismatched one (`stat -c %Y fileA || stat -f %z
    # fileB` passed), one valid pair on a line suppressed every OTHER hit on
    # that line, and `mystat -f` counted as a fallback. Exemption is now an
    # explicit reviewed marker on the line itself (see _port_src).
    _port_flag stat-c "$(_port_optflag stat c arg)"
    # NO allow-list. An exemption here would have to be wide enough to also pass
    # NON-equivalent pairs such as `date -u -d '2 days ago' || date -u -v-1d`,
    # whose branches disagree.
    _port_flag date-d "$(_port_optflag date d arg)"
    _port_flag tac '(^|[ (|])tac[ "]' 'command -v tac'
    _port_flag sed-i "$(_port_optflag sed i wordfinal)"
    _port_flag grep-oP "$(_port_optflag grep P noarg)"
    _port_flag md5sum '(^|[ (|])md5sum([ |]|$)' 'command -v md5sum'
    # /proc/sys/kernel/random/uuid is the one allowed read: existence-guarded,
    # with a uuidgen fallback. Any OTHER /proc path is Linux-only and silently empty.
    _port_flag proc '/proc/' '/proc/sys/kernel/random/uuid'
    _port_flag readlink-f 'readlink -f' 'realpath'
    _port_flag find-printf 'find .* -printf'
    grep -qF '\(^\|' <<<"$_port_src" && _port_bad+="sed-BRE-alternation "
    # GNU-only sed regex/replacement escapes (\s \+ \? \b \w, and \n on the RHS).
    grep -qE 'sed [^|]*\\[snbw+?]' <<<"$_port_src" && _port_bad+="sed-GNU-escape "
    return 0
}
_port_run_flags
assert_eq "portability: no raw GNU-only coreutils in the installer" "" "$_port_bad"

# Marker budget. Each `port-ok:` is a reviewed, irreducible exception. The only
# one ae ever carried was the `ae transfer` ssh heredoc, which ran on the REMOTE
# host where the shims do not exist; transfer was cut, so the budget is ZERO and
# a new marker cannot appear without turning this red.
assert_eq "portability: inline exemption markers pinned to the reviewed set" "0" \
    "$(grep -c 'port-ok:' <<<"$AE_INSTALL_SOURCE" || true)"

# ── mutation tests: the guard must FIRE, not merely pass ────────────
# A rule that matches nothing is indistinguishable from a clean tree. Each case
# feeds ONE offending line through the real rule set. The `-u -d` / `-E -i` /
# `-L -c` cases are the regression: pre-fix they returned "" (silently unflagged).
# `local` gives _port_run_flags its scratch copies via dynamic scoping.
_port_mutation() { # <line> -> flag labels tripped
    local _port_src="$1" _port_bad=""
    _port_run_flags
    printf '%s' "${_port_bad% }"
}
assert_eq "portability guard fires: date -d" "date-d" \
    "$(_port_mutation 'ts="$(date -d "$x" +%s)"')"
assert_eq "portability guard fires: date -u -d (option-ordered)" "date-d" \
    "$(_port_mutation 'ts="$(date -u -d "2 hours ago" +%FT%TZ)"')"
assert_eq "portability guard fires: sed -i" "sed-i" \
    "$(_port_mutation 'sed -i "s/a/b/" "$f"')"
assert_eq "portability guard fires: sed -E -i (option-ordered)" "sed-i" \
    "$(_port_mutation 'sed -E -i "s/(a)/b/" "$f"')"
assert_eq "portability guard fires: stat -c" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$f")"')"
assert_eq "portability guard fires: stat -L -c (option-ordered)" "stat-c" \
    "$(_port_mutation 'm="$(stat -L -c %Y "$f")"')"
assert_eq "portability guard fires: tac" "tac" \
    "$(_port_mutation 'done < <(tac "$events")')"
assert_eq "portability guard fires: grep -oP" "grep-oP" \
    "$(_port_mutation 'id="$(grep -oP "\"id\":\"\K[^\"]+" "$f")"')"
# CLUSTERED short options — the same calls, spelled without the separating
# space. An option-run-only regex misses all three: each was mutation-probed
# and came back UNFLAGGED before _port_optflag anchored the flag to the end of
# the cluster.
assert_eq "portability guard fires: stat -Lc (clustered)" "stat-c" \
    "$(_port_mutation 'm="$(stat -Lc %Y "$f")"')"
assert_eq "portability guard fires: date -ud (clustered)" "date-d" \
    "$(_port_mutation 'ts="$(date -ud "yesterday" +%F)"')"
assert_eq "portability guard fires: sed -Ei (clustered)" "sed-i" \
    "$(_port_mutation 'sed -Ei "s/(a)/b/" "$f"')"
# ATTACHED arguments. GNU takes the operand joined to the flag, so nothing may
# be required after the letter — the word-final rule missed every one of these.
assert_eq "portability guard fires: stat -c%Y (attached arg)" "stat-c" \
    "$(_port_mutation 'm="$(stat -c%Y "$f")"')"
assert_eq "portability guard fires: stat -Lc%Y (clustered + attached)" "stat-c" \
    "$(_port_mutation 'm="$(stat -Lc%Y "$f")"')"
assert_eq "portability guard fires: date -dyesterday (attached arg)" "date-d" \
    "$(_port_mutation 'd="$(date -dyesterday +%F)"')"
assert_eq "portability guard fires: date -udyesterday (clustered + attached)" "date-d" \
    "$(_port_mutation 'd="$(date -udyesterday +%F)"')"
# -P takes NO argument, so cluster letters may legally follow it.
assert_eq "portability guard fires: grep -Po (flag before cluster letters)" "grep-oP" \
    "$(_port_mutation 'id="$(grep -Po "x" "$f")"')"
assert_eq "portability guard fires: grep -Pz (flag before cluster letters)" "grep-oP" \
    "$(_port_mutation 'grep -Pz "x" "$f"')"
# COMMAND-TOKEN BOUNDARY. These are ordinary words that END in a command name;
# without the boundary "validate -d" matches `date -d` and "unused -i" matches
# `sed -i`, so the detector flags innocent code and gets switched off.
assert_eq "portability guard quiet: validate -d (not the date command)" "" \
    "$(_port_mutation 'validate -d "$arg"')"
assert_eq "portability guard quiet: unused -i (not the sed command)" "" \
    "$(_port_mutation 'unused -i "$arg"')"
assert_eq "portability guard quiet: _update -c (not the stat command)" "" \
    "$(_port_mutation '_update -c "$arg"')"
# KNOWN FALSE POSITIVE, pinned deliberately so it is reviewable rather than
# latent: `date -Iseconds` trips date-d, because the attached-argument rule
# cannot lexically tell the `d` inside "seconds" from the `d` of `-dyesterday`
# — the two have identical shape. Distinguishing them needs a per-command
# known-flag alphabet, which would buy this at the cost of FALSE NEGATIVES when
# the alphabet is incomplete. For a lint, over-flagging is the safe direction:
# a false positive is loud and fixed in one line, a false negative ships a
# silent BSD break. ae does not use `date -I`; if it ever does, shim it.
assert_eq "portability guard: date -Iseconds is a known false positive" "date-d" \
    "$(_port_mutation 'ts="$(date -Iseconds)"')"
