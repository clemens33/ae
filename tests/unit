# ── roster-completeness: registered keying, steward, per-window ──────
# BARE-CALL ERREXIT PROBE (AGENTS.md "only a BARE call proves set -e safety"): every
# assertion in this file reaches these functions through $(…) inside assert_eq, which
# MASKS a nonzero return — a fully green suite proves nothing about errexit. The
# generated watchdog runs `set -uo pipefail`, but `ae` itself runs `set -euo pipefail`
# and these are ae-level functions, so a bare call under errexit is a real caller shape.
# Probe each one bare, in that shape, and fail loudly if it aborts.
_roster_bare_probe() { # -> ok | aborted:<fn>
    local out rc=0
    out="$("${BASH:-bash}" -c '
        set -euo pipefail
        eval "$(awk "/^(_roster_session_id|_roster_glyph|_roster_label|_roster_compose|_roster_slot_refs|_roster_window_compose)\(\) \{/{p=1} p{print} p&&/^\}\$/{p=0}" "$1")"
        meta="$(mktemp)"; printf "agent.main=a:lead:sid\nagent.worker.0=b:w1:sid\n" > "$meta"
        # BARE calls — no $(…), no ||, no if. Statement position is the only shape that
        # lets a nonzero status abort, which is exactly what we are testing for.
        _roster_glyph active
        _roster_glyph ""
        _roster_glyph bogus
        _roster_label "x:y"
        _roster_label "nocolon"
        printf "a:b\tactive\n" | _roster_compose
        printf "" | _roster_compose
        _roster_slot_refs "$meta"
        _roster_slot_refs /nonexistent/meta
        # UNREADABLE-but-existing: -f passes, the OPEN fails. This is the path codex
        # found and my first probe missed — a green suite plus a passing mutation test
        # proved the probe had teeth, not that it was COMPLETE.
        _roster_slot_refs /proc/1/mem
        # NOTE: this whole probe body is inside a single-quoted bash -c, so every string
        # here must use DOUBLE quotes — a nested single quote silently ends the outer
        # quoting and the probe stops testing what it claims to.
        printf "%s\n" "\$0 s" | _roster_session_id s
        printf "" | _roster_session_id gone
        printf "%s\n" "\$0 s" | _roster_session_id ""
        printf "0\t●\n" | _roster_window_compose
        printf "" | _roster_window_compose
        rm -f "$meta"
        printf ok
    ' _ "$(dirname "$0")/../ae" 2>&1)" || rc=$?
    ((rc == 0)) || {
        printf 'aborted:rc=%s:%s' "$rc" "${out: -40}"
        return 0
    }
    printf 'ok'
    return 0
}
assert_eq "roster: every _roster_* fn survives a BARE call under set -euo pipefail" "ok" \
    "$(_roster_bare_probe)"

# REGISTERED-AGENT KEYING — the roster is keyed by the agents meta REGISTERS, not by the
# panes that happen to be alive. A registered agent whose pane is MISSING must render a
# failure glyph; previously it silently VANISHED from the bar, which reads as "fine".
_rc_meta="$(mktemp)"
printf 'session=x\nagent.main=fable5:lead:734f2f3e\nagent.worker.0=gpt56sol:colead:019f5f6f\nagent.worker.1=opus48:builder:1f2539a2\nagent.spawned.0=grokbuild:grok:pending\n' > "$_rc_meta"
