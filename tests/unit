# submit-verification bounded retry + LOUD failure. Stub _paste_still_staged to
# stay staged for the first N checks; count Enter keystrokes.
_asp() {  # <staged-for-N-checks> -> "rc=? enters=? checks=?"
    local staged_for="$1" checks=0 enters=0 rc
    # shellcheck disable=SC2317,SC2329
    sleep() { :; }
    # shellcheck disable=SC2317,SC2329
    _paste_still_staged() { checks=$((checks + 1)); ((checks <= staged_for)) && return 0 || return 1; }
    # shellcheck disable=SC2317,SC2329
    tmux() { [[ "$1" == send-keys && "$*" == *Enter* ]] && enters=$((enters + 1)); return 0; }
    ae_submit_pasted_message "%1" "codex" "buf" "hi" 2>/dev/null
    rc=$?
    echo "rc=$rc enters=$enters checks=$checks"
}
assert_eq "submit-verify: submits first try -> rc=0, one Enter" "rc=0 enters=1 checks=1" "$(_asp 0)"
assert_eq "submit-verify: staged once then clears -> rc=0, retry Enter" "rc=0 enters=2 checks=2" "$(_asp 1)"
assert_eq "submit-verify: never submits -> rc=1 LOUD after bounded 2 retries" "rc=1 enters=3 checks=3" "$(_asp 9)"
# The loud failure writes a warning to stderr.
_asp_loud() {  # always-staged -> emits the LOUD warning to stderr
    # shellcheck disable=SC2317,SC2329
    sleep() { :; }
    # shellcheck disable=SC2317,SC2329
    _paste_still_staged() { return 0; }
    # shellcheck disable=SC2317,SC2329
    tmux() { return 0; }
    ae_submit_pasted_message "%1" codex buf hi
}
assert_eq "submit-verify: unconfirmed writes a LOUD stderr warning" "1" \
    "$(_asp_loud 2>&1 1>/dev/null | grep -c 'submit UNCONFIRMED')"

# The send body's ordering rule — inspect input (busy?) BEFORE the cancel keystroke,
# because the cancel keystroke ITSELF would clobber staged or human-typed text — and
# its loud exit on an unconfirmed submit are the core's since B move 1. src/deliver.rs
# states that order in its header as one of the two positions that are load-bearing
# rather than arbitrary, and pins it. The bash body those two matched is gone.

# F1 (hazard read): the LAUNCH path was dummy=bash-blind. A MODELED tool whose
# paste never submits makes ae_submit_pasted_message -> return 1, which
# tmux_paste_submit PROPAGATES — hence the `|| true` guards at the launch sites.
eval "$(awk '/^pane_current_command\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^tmux_paste_submit\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_tps_staged() {  # modeled tool stays staged -> propagated nonzero
    local rc
    # shellcheck disable=SC2317,SC2329
    sleep() { :; }
    # shellcheck disable=SC2317,SC2329
    tmux() {
        case "$1" in
            display-message) printf 'claude' ;;                     # pane_current_command
            capture-pane) printf '❯ [Pasted text #2 +7 lines]\n' ;; # staged in the input region
        esac
        return 0
    }
    tmux_paste_submit "%1" "a long message that never submits"
    rc=$?
    echo "$rc"
}
assert_eq "F1: launch paste propagates nonzero when a modeled tool never submits" "1" "$(_tps_staged 2>/dev/null)"

# ── request-integrity-2 shell guard: the interpreted sink, now the core's ────────
# The rule is unchanged and is one of ae's interpreted-sink boundaries: an agent that
# dies drops its pane to a shell, and a send's paste + Enter would EXECUTE the message
# as a command. It refuses ONLY when the pane is a shell AND the seat's agent_bin is a
# real (non-shell) agent, so a shell-BASED agent (dummy=bash) and live agents still
# deliver — and the DESCENDANT WALK is not optional, because a live agent running a
# Bash tool shows a shell foreground while its binary is alive underneath (ri-3).
#
# B move 1 ported the whole guard into src/deliver.rs (`pane_agent_is_dead`, with the
# same fail-open on an undeterminable agent_bin and the same fail-closed on an
# unreadable pane command) and pins the same case table there. `_pane_agent_is_dead`,
# `_agent_bin_for_pane` and `_pane_has_descendant_named` left the glue with the send
# body that was their only caller. `command_is_shell` stays — the launch path still
# classifies a pane — and is pinned where the send-path emission set is.

# ── send-focus / send-finish / interrupt-guard: all of it is the core's ─────────
# Every invariant this block held is unchanged, and every one of them moved with B
# move 1 into src/deliver.rs, which states them in its own header and pins them in
# its own suite:
#
#   * NO focus change, ever. select-pane changed the window's ACTIVE pane mid-send and
#     routed the human's in-flight keystrokes into the target — acute under a lead pair,
#     where lead and colead share window 0. paste-buffer and send-keys take -t; focus is
#     not part of any TUI's submission contract, and only the `focus` helper may select.
#   * The bounded, numeric-guarded defer, taken while HOLDING the target lock, gating on
#     the busy sensor AND on human presence at the pane.
#   * The dead-shell refusal BEFORE the lock, on send and on a message-carrying
#     interrupt alike; a bare cancel is unaffected.
#   * An UNCONFIRMED submit is not a delivery: non-zero out, and no event written — for
#     the notice path too, where a failed proof must leave the ledger byte-unchanged.
#
# The bash bodies those probes drove (`helper_send_body`, the `_send-deliver` entry and
# its finisher, `helper_interrupt_main`'s body) are gone, so the probes drove nothing.
# The one glue-side residue is pinned with the helper emission set: the internal
# delivery entry is not generated at all any more.


