rm -f "$_rc2_meta"
assert_eq "slots: publisher routes by @ae_slot, not by display ref" "1" \
    "$([[ "$AE_SOURCE" == *'live_slots['* && "$AE_SOURCE" == *'#{@ae_slot}'* ]] && echo 1 || echo 0)"
