# SHELL-CORRECTNESS, AND WHICH WAY IT FAILS. Inside double quotes bash honours `\`
# only before " \ $ ` and newline; the first version closed the word at the first quote
# it saw, so a VALID escaped-quote path was cut in half and the next argument was
# swallowed into the binary's raw span — which reconstruction would then have spliced.
assert_eq "#32: an escaped quote inside a double-quoted path decodes, and does not eat the next word" '/Applications/Open "Quoted"/codex|codex' \
    "$(_cmd_split_binary 'env FOO=1 "/Applications/Open \"Quoted\"/codex" --yolo'
       printf '%s|%s' "$_CMD_BIN" "$(tool_kind_from_cmd 'env FOO=1 "/Applications/Open \"Quoted\"/codex" --yolo')")"
assert_eq "#32: ...and the untouched RAW span is what reconstruction splices" '"/Applications/Open \"Quoted\"/codex"| --yolo' \
    "$(_cmd_split_binary 'env FOO=1 "/Applications/Open \"Quoted\"/codex" --yolo'
       printf '%s|%s' "$_CMD_BIN_RAW" "$_CMD_REST")"
# A PARSER VALIDATES WHAT IT CONSUMES, NOT WHAT IT SKIPS. The tokenizer's job is to
# find the binary; everything after it is passed through untouched and ae makes no
# validity claim about it. So a malformed PREFIX or BINARY WORD yields unknown — and a
# malformed TAIL is simply not this function's business.
#
# An earlier version counted trailing backslashes across the whole command and was
# wrong BOTH ways: it refused `codex --yolo # note\` (valid — the backslash is inside a
# comment) and suppressed all codex shaping, while `codex --yolo "unterminated` (invalid)
# classified fine anyway because the scan had already stopped at the binary. Reaching
# for whole-command validity meant writing a shell lexer in bash, which is not a promise
# this can keep.
# shellcheck disable=SC1003  # the dangling backslash IS the fixture: it sits inside the
# binary word, which is the region the tokenizer consumes and therefore validates.
assert_eq "#32: a malformed BINARY WORD fails toward unknown" "unknown|unknown|unknown" \
    "$(printf '%s|%s|%s' \
        "$(tool_kind_from_cmd 'env FOO=1 codex\')" \
        "$(tool_kind_from_cmd 'env FOO=1 "/opt/codex --yolo')" \
        "$(tool_kind_from_cmd "env FOO=1 '/opt/codex --yolo")")"
# ...and a malformed TAIL is not a validity claim ae makes. Both of these were wrong
# before: the first was refused though valid, the second was accepted while the counter
# pretended to judge the whole command.
# shellcheck disable=SC1003  # trailing backslash inside a COMMENT — valid shell.
assert_eq "#32: the tail is passed through, not judged" "codex|codex" \
    "$(printf '%s|%s' \
        "$(tool_kind_from_cmd 'codex --yolo # note\')" \
        "$(tool_kind_from_cmd 'codex --yolo "unterminated')")"
# Escapes in the binary word are PROCESSED, not rejected — without this control the fix
# could pass by refusing anything containing a backslash. `co\dex` decodes to codex
# (escaping an ordinary character yields that character), whereas `codex\\` decodes to a
# binary literally NAMED "codex\" and correctly is not codex.
# shellcheck disable=SC1003  # the escape is the fixture.
assert_eq "#32: an escape inside the binary word is decoded, not refused" "codex|unknown" \
    "$(printf '%s|%s' \
        "$(tool_kind_from_cmd 'co\dex --yolo')" \
        "$(tool_kind_from_cmd 'codex\\ --yolo')")"
# And an unclassifiable command is left ALONE rather than half-rewritten.
# shellcheck disable=SC1003  # same malformed fixture, asserted end to end.
assert_eq "#32: an unclassifiable command is passed through untouched by resume shaping" 'env FOO=1 codex\' \
    "$(resume_cmd_from_cmd 'env FOO=1 codex\' UUID-4)"

# The tokenizer's own contract: quoted AND backslash-escaped paths containing spaces.
# The bug classified both as unknown while the same path without a space worked, which
# is what localised it to shell-word boundaries.
assert_eq "#32: a spaced binary path classifies, quoted or escaped" "codex|codex|opencode" \
    "$(printf '%s|%s|%s' \
        "$(tool_kind_from_cmd "env FOO=1 '/Applications/Open Code/codex' --yolo")" \
        "$(tool_kind_from_cmd "env FOO=1 /Applications/Open\\ Code/codex --yolo")" \
        "$(tool_kind_from_cmd "\"/Applications/Open Code/opencode\"")")"
# ...and reconstruction splices around that same span rather than re-splitting it.
assert_eq "#32: codex resume rebuilds around a spaced path without mangling it" \
    "env FOO=1 '/Applications/Open Code/codex' --yolo resume UUID-9" \
    "$(resume_cmd_from_cmd "env FOO=1 '/Applications/Open Code/codex' --yolo" "UUID-9")"
unset _m32 _m32_meta

