# 6th review I1: the advertised recovery override is REAL — AE_END_SERVER is consumed
# by _end_target_server, and ONLY for a legacy-empty record (never over a typed one).
_eot() { # $1 = stubbed meta value, then env-passed AE_END_SERVER
    local metaval="$1"
    # shellcheck disable=SC2317,SC2329  # invoked indirectly by _end_target_server
    read_session_meta() { printf '%s' "$metaval"; }
    _end_target_server ghost
    unset -f read_session_meta
    return 0
}
