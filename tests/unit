# ── one-pass alert resolution (perf slice) ──────────────────────────
# The plural resolver is the single source of alert semantics; the singular
# form delegates to it. These assertions pin the two properties that make the
# rewrite safe: it agrees with per-agent resolution, and its early exit is
# EXACT (driven by "every agent decided") rather than a scan-depth cap.

# Three agents, three different verdicts, decided at different depths, with a
# deep tail above the oldest one so any scan-depth cap loses it.
#
# The filler must SURVIVE the grep prefilter, or this fixture proves nothing:
# a first version used action=send filler, which the prefilter strips before the
# loop ever sees it — a 200-line "deep" log that arrived at the scan 3 lines
# long, and a tail-window mutation stayed green against it. These filler lines
# are alerts about an agent nobody asked about: they pass the prefilter, reach
# the loop, and settle nothing.
{
    printf '{"ts":"2026-05-29T10:00:00Z","actor":"watchdog","action":"alert","target":"claude:old","summary":"agent process dead"}\n'
    for i in $(seq 1 200); do
        printf '{"ts":"2026-05-29T11:00:00Z","actor":"watchdog","action":"alert","target":"claude:bystander","summary":"filler %s"}\n' "$i"
    done
    printf '{"ts":"2026-05-29T12:00:00Z","actor":"watchdog","action":"throttled","target":"claude:thr","summary":"throttled for 60s"}\n'
    printf '{"ts":"2026-05-29T13:00:00Z","actor":"claude:fine","action":"state","target":"","ref":"working"}\n'
} >"$_ss_dir/events.jsonl"

