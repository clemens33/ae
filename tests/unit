_rw_tmp_root="$(mktemp -d)"
# v2 config: [profiles] holds the commands, [roster] binds each NAME to one, and every
# [roster] row must take a seat (a dormant row refuses the launch), so the roster is
# generated from the seats the case actually uses.
_rw_cfg() { # <file> <main> <comma-separated worker names>
    local f="$1" main="$2" workers="$3" n
    # One [roster] row per DISTINCT name: an INI key repeated in a section is a
    # duplicate the config reader invalidates, which would refuse the launch for the
    # wrong reason — and the duplicate-seat case below needs the refusal to be about
    # the SEAT list, not about a malformed roster.
    local -A _seen=()
    {
        printf '[profiles]\n'
        printf 'opus48 = "claude --model opus"\n'
        printf 'gpt55 = "codex --yolo"\n'
        printf '[roster]\n'
        printf '%s = opus48\n' "$main"
        _seen["$main"]=1
        for n in ${workers//,/ }; do
            [[ -n "${_seen[$n]:-}" ]] && continue
            printf '%s = gpt55\n' "$n"
            _seen["$n"]=1
        done
        printf '[workspace]\n'
        printf 'main = %s\n' "$main"
        printf 'workers = %s\n' "$workers"
    } >"$f"
    return 0
}
_rw_run() { # <mode: resume|resume-empty|fresh> <config workers> -> "profile:name,..."
    local mode="$1" cfg_workers="$2" i out=""
    rm -rf "$_rw_tmp_root/s" "$_rw_tmp_root/wt"
    _rw_cfg "$_rw_tmp_root/config" lead "$cfg_workers"
    if [[ "$mode" != fresh ]]; then
        mkdir -p "$_rw_tmp_root/s"
        {
            printf 'schema=2\nsession=s\nseat.main=lead\nprofile.main=opus48\nagent_bin.main=claude\n'
            if [[ "$mode" == resume ]]; then
                printf 'seat.worker.0=builder\nprofile.worker.0=opus48\nagent_bin.worker.0=claude\n'
                printf 'seat.worker.1=reviewer\nprofile.worker.1=gpt55\nagent_bin.worker.1=codex\n'
            fi
        } >"$_rw_tmp_root/s/meta"
    fi
    AE_CORE_BIN="$_AE_UNIT_CORE" CONFIG_FILE="$_rw_tmp_root/config" AE_LOCAL_CONFIG="" \
        MAIN_OVERRIDE="" SESSION="s" \
        SESSIONS_DIR="$_rw_tmp_root" WORKTREES_DIR="$_rw_tmp_root/wt" _resolve_workers
    for i in "${!WORKER_ALIASES[@]}"; do out+="${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]},"; done
    echo "${out%,}"
    return 0
}
