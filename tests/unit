# Slot-qualified, like every other identity decision in this sensor.
_ar48_c_wrongsess="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-wrongsess","target":"b:two","actor_slot":"main","target_slot":"worker.0","actor_session":"S","target_session":"S","summary":"q"}' \
