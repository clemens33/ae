# ── the gate's own hazard: shellcheck must never be able to read stdin (#67) ─────
# The linter reads stdin when fd 0 is open, and an agent harness hands its tool
# calls a UNIX SOCKET. If that socket's peer has not closed by the time the read
# happens, it never returns EOF and the process blocks FOREVER at 0.0% CPU —
# wedges observed at 4h40m, 8h40m, 16h52m and 18h33m beside successful runs of
# the same command, with NOTHING in between (a race on the peer's close, not
# slowness). Every input is already on the argv, so `< /dev/null` costs nothing
# and removes the race. It also looks like line-noise to anyone tidying the
# recipe, which is exactly why it is pinned here.
#
# SOURCE SHAPE ONLY, and the label says so: this proves the redirect is WRITTEN,
# not that a wedge cannot occur. The behaviour is falsifiable only against a fifo
# that is never closed — a rig no unit test can own without risking the very hang
# it is testing for; run it by hand (see #67) when changing the recipe.
#
# Two ways a source-shape guard of this kind lies, both closed below because both
# were demonstrated against the first version of it:
#   * A COMMENT is not evidence. `# shellcheck ... < /dev/null` in the recipe
#     satisfies any grep over raw text while the real command runs unprotected.
#     Full-line comments are stripped before anything is asserted.
#   * A SECOND CALL on the same logical line hides behind the first. The tail
#     test alone passes `shellcheck ae; shellcheck install < /dev/null`, where
#     the protected command is not the one doing the work. So the count of
#     `shellcheck` tokens in EXECUTABLE text must be exactly one, that one line
#     must BE the command (not contain it), and it must carry the redirect.
# The predicate is a pure function of justfile text precisely so both lies can be
# asserted here as red inputs, instead of living in a rig someone has to remember
# to run.
#
# shfmt's redirect in `format-check` is deliberately NOT pinned: it is insurance
# (shfmt only reads stdin when given no paths), and pinning insurance as contract
# invites the next reader to treat the two as equally load-bearing. They are not.

# Executable text of the `lint` recipe: body lines only, full-line comments and
# blanks dropped, backslash continuations folded so one command is one line.
# A `#` line is only a comment when no fold is in progress — mid-continuation it
# is argument text, not commentary.
_gate_lint_exec_text() { # stdin: justfile text
    awk '
        /^lint:/ { p = 1; next }
        p && /^[^ \t]/ { p = 0 }
        p {
            line = $0
            if (buf == "") {
                sub(/^[ \t]+/, "", line)
                if (line ~ /^#/ || line == "") next
            } else {
                sub(/^[ \t]+/, " ", line)
            }
            if (sub(/\\[ \t]*$/, "", line)) { buf = buf line; next }
            print buf line
            buf = ""
        }
    '
}

# 1 when the recipe protects shellcheck's stdin, 0 otherwise.
_gate_lint_redirect_ok() { # stdin: justfile text
    local text tokens bearing
    text="$(_gate_lint_exec_text)"
    # The bare word `shellcheck`, however many times it appears in real commands.
    tokens="$(grep -oE '(^|[^A-Za-z0-9_.@/-])shellcheck([^A-Za-z0-9_.@/-]|$)' <<<"$text" | wc -l | tr -d '[:space:]')"
    [[ "${tokens:-0}" == 1 ]] || { echo 0; return 0; }
    # That one occurrence must BE the command that owns the redirect. Starting the
    # line is not enough: every shell control operator hands the redirect to a
    # LATER command while shellcheck keeps the inherited fd — `&& true`, `|| true`,
    # `| cat` and `& wait` all did exactly that against the previous version of
    # this predicate. So the SIMPLE-COMMAND segment between the token and the
    # redirect must contain none of `;`, `&`, `|` (which also covers `&&` and
    # `||`, since the class matches their single characters), and the segment must
    # end at the redirect.
    # The `<` must also be BARE — at a token boundary, or the explicit `0<`. A
    # NUMERIC fd prefix redirects the wrong descriptor and leaves stdin exactly as
    # inherited: measured, `printf X | bash -c 'cat 2< /dev/null'` still prints X,
    # and `1< /dev/null` only makes stdout read-only, which a run with no findings
    # never notices. Both spellings end in `< /dev/null` and both keep the wedge.
    # Deliberately loud in the false-positive direction, twice over: a legitimate
    # `2>&1` on this line is rejected (its `&` is indistinguishable here from a
    # backgrounding one), and so is `shellcheck ae< /dev/null` with no space,
    # which is valid shell. If either day comes, split the redirection onto its
    # own construct or widen this with a case that is MEASURED, not assumed — do
    # not delete the check to make a recipe pass.
    bearing="$(grep -cE '^shellcheck[^;&|]*[[:space:]]0?<[[:space:]]*/dev/null[[:space:]]*$' <<<"$text" | tr -d '[:space:]')"
    [[ "${bearing:-0}" == 1 ]] && echo 1 || echo 0
    return 0
}

# 1 when the pin recipe asks whether shellcheck EXISTS before probing its version.
_gate_pin_availability_ok() { # stdin: justfile text
    local text avail probe
    text="$(awk '
        /^_shellcheck-pin:/ { p = 1; next }
        p && /^[^ \t]/ { p = 0 }
        p {
            line = $0
            sub(/^[ \t]+/, "", line)
            if (line ~ /^#/ || line == "") next
            print line
        }
    ')"
    # Under `set -e` with pipefail, `have="$(shellcheck --version | awk ...)"` ABORTS at
    # rc 127 when the binary is absent: the probe's stderr is already redirected, so the
    # recipe dies with a bare exit code and none of the install guidance ever prints —
    # on exactly the fresh machine that needs it. Caught in review after it shipped here.
    # Order is the invariant, not mere presence: the availability question must come
    # FIRST, so a later reordering that reintroduces the abort is caught.
    avail="$(grep -nE 'command -v[[:space:]]+shellcheck' <<<"$text" | head -1 | cut -d: -f1)"
    probe="$(grep -nE 'shellcheck[[:space:]]+--version' <<<"$text" | head -1 | cut -d: -f1)"
    if [[ -n "$avail" && -n "$probe" ]] && (( avail < probe )); then echo 1; else echo 0; fi
    return 0
}

