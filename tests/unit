# ══ ae compact, phase (b): the semantic handover ═════════════════════════════════
eval "$(awk '/^(_compact_actor|_compact_memo_offset|_compact_memo_after|_compact_reply_seen|_compact_find_outstanding|_compact_baseline_of|_compact_request_text)\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"

# ── the reserved return address is a WHITELIST, not a namespace ─────────────────
# compact is a command, not a pane, so a reply to it must be RECORDED rather than
# delivered. The failure this family can produce is a SILENT NO-OP DELIVERY, which is why
# the match is one exact prefix: an agent that mistypes an ae:-shaped target must still
# fail loudly instead of having its message swallowed into the log.
# The send-side whitelist is the core's since B move 1 (src/send.rs: an external sink
# is event-only, decided before target resolution). What this block still owns, and
# what the failure mode actually needs, is the shape of the rule: ONE exact prefix per
# family, so a mistyped ae:-shaped target fails loudly instead of being swallowed. That
# is driven below against the same condition the product uses.
_cp48_sink_match() { # <target> -> yes|no, using the product's own condition
    local target_ref="$1"
    if [[ "$target_ref" == telegram:* || "$target_ref" == discord:* || "$target_ref" == ae:compact:* ]]; then
        echo yes
    else
        echo no
    fi
}
assert_eq "compact-sink: the reserved actor matches" "yes" "$(_cp48_sink_match "ae:compact:$(printf 'u')")"
assert_eq "compact-sink: a bare ae: target does NOT (it would be a silent no-op)" "no" "$(_cp48_sink_match "ae:lead")"
assert_eq "compact-sink: nor a near-miss prefix" "no" "$(_cp48_sink_match "ae:compactx:u")"
assert_eq "compact-sink: nor one that merely contains it" "no" "$(_cp48_sink_match "xae:compact:u")"
assert_eq "compact-sink: nor an ordinary agent name" "no" "$(_cp48_sink_match "claude:lead")"
# MUTATION: broadening the family to ae:* must FAIL the near-miss pins above, or they are
# decoration rather than protection.
_cp48_broad_match() { # the shape we must NOT ship
    local target_ref="$1"
    if [[ "$target_ref" == telegram:* || "$target_ref" == discord:* || "$target_ref" == ae:* ]]; then
        echo yes
    else
        echo no
    fi
}
assert_eq "compact-sink (mutation): the broadened form would swallow a mistyped ae: target" "yes" \
    "$(_cp48_broad_match "ae:lead")"
assert_eq "compact-actor: the return address is derived from the source uuid" "ae:compact:U-1" "$(_compact_actor U-1)"

