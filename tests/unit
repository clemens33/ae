# Extract a named heredoc body from ae into a target file (bash + awk only —
# the project's "no deps" rule applies to the test suite too).
_extract_heredoc() {
    local src="$1" eof="$2" out="$3"
    awk -v eof="$eof" -v outfile="$out" '
        $0 ~ ("<<\047" eof "\047") { inside=1; next }
        inside && $0 == eof { exit }
        inside { print > outfile }
    ' "$src"
}
# Build a functional _lib from the declare-f source layout: the emitted
# prologue (LIBPROLOGUE heredoc) + EXACTLY the fn set named by the real
# emission's declare -f list, parsed from the emission block itself. The
# synthetic _lib must never be BROADER than the runtime one — a superset
# (e.g. including helper_* template fns) could mask an accidental _lib
# dependency that generated sessions would only hit at runtime.
_build_lib_from_source() {
    local src="$1" out="$2" fn
    {
        awk "/<<'LIBPROLOGUE'/{f=1;next} /^LIBPROLOGUE\$/{f=0} f" "$src"
        while IFS= read -r fn; do
            [[ -n "$fn" ]] || continue
            awk "/^${fn}\\(\\) \\{/,/^\\}\$/" "$src"
        done < <(awk '/^ *declare -f ae_resolve /{f=1} f{l=$0; stop=(l !~ /\\ *$/); gsub(/\\ *$/,"",l); sub(/^ *declare -f /,"",l); print l; if (stop) exit}' "$src" | tr ' ' '\n')
    } >"$out"
}
_build_lib_from_source "$(dirname "$0")/../ae" "$_req_helper_dir/_lib"
assert_eq "_lib builder: mirrors the emission list (no helper_* leakage, non-empty)" \
