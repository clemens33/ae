#!/usr/bin/env bash
# Test suite for ae pure functions
# shellcheck disable=SC2016
# Run: ./test (or: bash test)
# No dependencies beyond bash.

set -euo pipefail

PASS=0
FAIL=0
ERRORS=()

assert_eq() {
    local label="$1" expected="$2" actual="$3"
    if [[ "$expected" == "$actual" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected: \"$expected\"\n  actual:   \"$actual\"")
    fi
}

AE_SOURCE="$(cat "$(dirname "$0")/../ae")"

# Isolate config from user's real ~/.ae/config
CONFIG_FILE="/dev/null"
AE_LOCAL_CONFIG=""

# Extract pure function definitions from ae (matches "func() {" but not "func() ${BODY}" heredoc copies)
eval "$(awk '
    /^(parse_config|get_config|build_ae_context|strip_session_flags|strip_opencode_session_flags|strip_gemini_prompt_flags|resume_cmd_from_cmd|inject_session_id|inject_ae_context|initial_prompt_for_cmd|gen_uuid|tool_kind_from_cmd|tool_name_from_cmd|tool_kind_supports_launch_id|read_launch_id_for_slot|read_launch_time_for_slot|default_session_name|sanitize_branch_name|shell_quote|build_launch_command|extract_binary_from_cmd)\(\) \{/ { printing=1 }
    printing { print }
    printing && /^\}$/ { printing=0 }
' "$(dirname "$0")/../ae")"

# ── strip_session_flags ──────────────────────────────────────────────

assert_eq "strip: --session-id with =" \
    "claude --model opus" \
    "$(strip_session_flags "claude --session-id=abc-123 --model opus")"

assert_eq "strip: --session-id with space" \
    "claude --model opus" \
    "$(strip_session_flags "claude --session-id abc-123 --model opus")"

assert_eq "strip: --resume with =" \
    "claude --model opus" \
    "$(strip_session_flags "claude --resume=abc-123 --model opus")"

assert_eq "strip: --resume with space" \
    "claude --model opus" \
    "$(strip_session_flags "claude --resume abc-123 --model opus")"

assert_eq "strip: --continue alone" \
    "claude --model opus" \
    "$(strip_session_flags "claude --continue --model opus")"

assert_eq "strip: --continue at end" \
    "claude --model opus" \
    "$(strip_session_flags "claude --model opus --continue")"

assert_eq "strip: preserves --continue-on-error" \
    "claude --continue-on-error --model opus" \
    "$(strip_session_flags "claude --continue-on-error --model opus")"

assert_eq "strip: preserves --continuation" \
    "sometool --continuation" \
    "$(strip_session_flags "sometool --continuation")"

assert_eq "strip: multiple flags at once" \
    "claude --model opus" \
    "$(strip_session_flags "claude --session-id abc --resume def --continue --model opus")"

assert_eq "strip: no flags to strip" \
    "codex --yolo -m gpt-5" \
    "$(strip_session_flags "codex --yolo -m gpt-5")"

assert_eq "strip: only --continue" \
    "claude" \
    "$(strip_session_flags "claude --continue")"

assert_eq "strip: --session not stripped by generic strip (avoids collisions)" \
    "opencode --session ses_abc123 -m model" \
    "$(strip_session_flags "opencode --session ses_abc123 -m model")"

assert_eq "strip: -s not stripped by generic strip (avoids collisions)" \
    "codex -s something -m model" \
    "$(strip_session_flags "codex -s something -m model")"

assert_eq "strip: -c not stripped by generic strip (avoids collisions)" \
    "codex -c model_reasoning_effort=high" \
    "$(strip_session_flags "codex -c model_reasoning_effort=high")"

assert_eq "strip-opencode: --session with space" \
    "opencode -m model" \
    "$(strip_opencode_session_flags "opencode --session ses_abc123 -m model")"

assert_eq "strip-opencode: --session with =" \
    "opencode -m model" \
    "$(strip_opencode_session_flags "opencode --session=ses_abc123 -m model")"

assert_eq "strip-opencode: -s short flag" \
    "opencode -m model" \
    "$(strip_opencode_session_flags "opencode -s ses_abc123 -m model")"

assert_eq "strip-opencode: -c short flag" \
    "opencode -m model" \
    "$(strip_opencode_session_flags "opencode -c -m model")"

assert_eq "strip-opencode: -c at end" \
    "opencode -m model" \
    "$(strip_opencode_session_flags "opencode -m model -c")"

assert_eq "strip-opencode: --continue" \
    "opencode -m model" \
    "$(strip_opencode_session_flags "opencode --continue -m model")"

# ── tool_kind_from_cmd ───────────────────────────────────────────────

assert_eq "kind: claude" "claude" "$(tool_kind_from_cmd "claude --model opus")"
assert_eq "kind: codex"  "codex"  "$(tool_kind_from_cmd "codex --yolo")"
assert_eq "kind: opencode" "opencode" "$(tool_kind_from_cmd "opencode")"
assert_eq "kind: unknown" "unknown" "$(tool_kind_from_cmd "sometool --flag")"

