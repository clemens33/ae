# rather than being re-extracted inside each locale — awk itself fails to read
# ae under SJIS/GB18030, which would make those probes pass vacuously.
_cap_fn_file="$(mktemp)"
awk '/^ae_cap_summary\(\) \{/,/^\}$/' <<<"$AE_SOURCE" >"$_cap_fn_file"

_cap_emdash=$'\xe2\x80\x94'

# Every alignment where a 3-byte character crosses the cap: the call must
# succeed AND the result must never end in a partial sequence.
_cap_bad=""
for _off in 197 198 199 200; do
    _cap_in="$(printf "%${_off}s" "" | tr ' ' 'x')${_cap_emdash}tail"
    ae_cap_summary "$_cap_in" 200 || _cap_bad+="rc@${_off} "
    # A partial em-dash would leave a trailing 0xE2 or 0xE2 0x80.
    case "$_EV_SUMMARY" in
        *$'\xe2' | *$'\xe2\x80') _cap_bad+="partial@${_off} " ;;
    esac
