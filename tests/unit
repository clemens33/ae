assert_eq "portability guard: date -Iseconds is a known false positive" "date-d" \
    "$(_port_mutation 'ts="$(date -Iseconds)"')"
# The pair-shape exemption is GONE — these are the cases that killed it. A
# `GNU || BSD` pattern cannot verify the two halves are EQUIVALENT, and it
# suppressed per-LINE rather than per-hit.
assert_eq "portability guard fires: mismatched field/operand pair" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$fileA" || stat -f %z "$fileB")"')"
assert_eq "portability guard fires: a valid pair does not cover a second bad hit" "stat-c" \
