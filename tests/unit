    "$(resume_cmd_from_cmd "codex --yolo" "pending")"

assert_eq "resume: gemini with session_id → --resume UUID" \
    "gemini --yolo --resume abc-123-uuid" \
    "$(resume_cmd_from_cmd "gemini --yolo" "abc-123-uuid")"

assert_eq "resume: gemini without session_id → --resume latest" \
    "gemini --yolo --resume latest" \
    "$(resume_cmd_from_cmd "gemini --yolo")"

assert_eq "resume: gemini with pending → --resume latest (fallback)" \
    "gemini --yolo --resume latest" \
    "$(resume_cmd_from_cmd "gemini --yolo" "pending")"

assert_eq "resume: gemini strips old -i flag with quoted value" \
    "gemini --yolo --resume latest" \
    "$(resume_cmd_from_cmd "gemini --yolo -i 'old context with spaces'")"

assert_eq "resume: gemini strips --prompt-interactive" \
    "gemini --yolo --resume latest" \
    "$(resume_cmd_from_cmd "gemini --yolo --prompt-interactive 'old context'")"

assert_eq "strip: -i not stripped from non-gemini commands" \
    "codex --yolo -i input.txt" \
    "$(strip_session_flags "codex --yolo -i input.txt")"

assert_eq "resume: opencode no session → --continue fallback" \
    "opencode --continue" \
    "$(resume_cmd_from_cmd "opencode")"

assert_eq "resume: opencode with session ID → --session" \
    "opencode --session ses_abc123" \
    "$(resume_cmd_from_cmd "opencode" "ses_abc123")"

assert_eq "resume: opencode with flags + session ID" \
    "opencode -m model --session ses_xyz" \
    "$(resume_cmd_from_cmd "opencode -m model" "ses_xyz")"

assert_eq "resume: opencode pending session → --continue fallback" \
    "opencode -m model --continue" \
    "$(resume_cmd_from_cmd "opencode -m model" "pending")"

assert_eq "resume: unknown agent → fresh start (clean cmd)" \
    "sometool" \
    "$(resume_cmd_from_cmd "sometool")"

assert_eq "resume: strips old flags before building resume cmd" \
    "claude --model opus --resume new-uuid" \
    "$(resume_cmd_from_cmd "claude --resume old-uuid --model opus" "new-uuid")"

