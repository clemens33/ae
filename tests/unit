# _sgr_parse must ADVANCE on a non-CSI ESC. The old loop matched an empty text run
# there and spun forever; a hung sensor hangs the send path, so this test is the
# liveness guard (timeout, not an assertion on the parse). tmux -e reconstructs SGR,
# so this is defensive — but a hang is unrecoverable, unlike a bad read.
_sgr_esc_terminates() { # -> ok|HUNG|leaked:<text>
    local out rc=0
    out="$(_timeout 5 "${BASH:-bash}" -c '
        eval "$(awk "/^_sgr_parse\(\) \{/,/^\}\$/" "$1")"
        _sgr_parse "$(printf "%b" "\033(B\0337\033[1m›\033[0m staged")"
        printf "%s" "${_SGR_TEXT[*]}"
    ' _ "$(dirname "$0")/../ae" 2>/dev/null)" || rc=$?
    # 124 is timeout's own "killed" code — the hang this guards. Any other nonzero is
    # a broken probe, not a hang, and must not masquerade as one.
    ((rc == 124)) && {
        echo HUNG
        return 0
    }
    ((rc == 0)) || {
        echo "probe-broken:rc=$rc"
        return 0
    }
    # the designator's final byte must NOT leak into the text (false OCCUPIED risk)
    [[ "$out" != *'(B'* && "$out" != *'7'* ]] && echo ok || echo "leaked:$out"
    return 0
}
