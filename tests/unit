# ── end: the plan is resolved BEFORE the prompt ──────────────────────
# The confirmation has to name the exact archive path (or the exact refusal), so the
# plan is a query the prompt and the action both call — not two guesses that agree by
# luck. `_AE_PURGE_HISTORY_CLI` is the CLI override; empty means "ask this session's
# own config", which is why the resolution is per-target and not per-caller.
_ar48_plan() { # <purge-cli> <session-dir-name> [config-body]
    local cli="$1" name="$2" cfg="${3:-}"
    local home="$_ar48_root/plan.$RANDOM"
    mkdir -p "$home/sessions/$name" "$home/arch"
    _ar48_session "$home/sessions/$name"
    if [[ -n "$cfg" ]]; then
        printf '%s\n' "$cfg" >"$home/session-config"
        _sed_i -e "s|^config=.*|config=$home/session-config|" "$home/sessions/$name/meta"
    fi
    (
        SESSIONS_DIR="$home/sessions"
        WORKTREES_DIR="$home/worktrees"
        AE_HOME="$home/arch"
        _AE_PURGE_HISTORY_CLI="$cli"
        _end_archive_plan "$name"
    )
}
