# v2 rule (ruled 2026-09-02): name validation is the CORE's — `_launch-plan` refuses a
# seat name outside the grammar (the BadName violation) before the launch's first side
# effect — so the bash-side provenance flags (_MAIN_NAME_RESTORED / _ROSTER_NAMES_RESTORED)
# and the `_validate_agent_name "$MAIN_NAME" || exit 1` call site are retired, and so is
# the tolerance compact's frozen roster used to get: its names were minted by a v2 config,
# so they are validated as FRESH and a refusal is loud with the archive still there for
# `--from`. What remains bash's is the RESTORED-on-resume case, which never reaches the
# core's grammar at all — a legacy row on disk predates it — and is handled at the
# interpolation guard below.
# The frozen-roster provenance branch was the launch flow's, and the launch flow
# is the core's: a compact child re-proves its `--from` archive and validates the
# frozen roster before publishing meta. The pin that the retired provenance flags
# were gone from the wrapper went with the wrapper itself in slice Z3 — an absence
# in a deleted file is not an assertion.
# The behaviour: a non-conforming restored name reaches the sink and is suppressed
# there, quietly, with the rest of the context intact.
_c32_dir="$(mktemp -d)"
printf 'schema=2\nmode=local\nseat.main=legacy name\nprofile.main=cl\n' >"$_c32_dir/meta"
_c32_ctx="$(CONFIG_FILE=/dev/null build_ae_context "$_c32_dir" sess /work main)"
assert_eq "#59 C3-2: a legacy non-conforming main gets NO identity line" "0" \
    "$([[ "$_c32_ctx" == *"You are agent"* ]] && echo 1 || echo 0)"
assert_eq "#59 C3-2: ...but still gets the full context, so the agent launches" "1" \
    "$([[ "$_c32_ctx" == *"REQUIRED RULES"* && "$_c32_ctx" == *"LEAD ROLE"* && "$_c32_ctx" == *"WORKING TREE"* ]] && echo 1 || echo 0)"
rm -rf "$_c32_dir"
unset _c32_ctx

