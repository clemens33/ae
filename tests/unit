# ── 4th review: authoritative launch server + tri-state kill verify ──
# B1: meta must record where the launch ACTUALLY lands. Bare tmux follows
# AE_TMUX_SERVER, else inherited $TMUX, else default — recording the raw env var made
# a foreign-pane launch write "" while living on the named server; every exact-server
# consumer then faithfully read the lie.
# The resolver asks tmux ITSELF for #{socket_path} + #{pid}; identity of a relative
# socket is proven by a PID ROUND-TRIP (7th review B1: readlink in the caller's cwd
# recorded a same-named decoy). Result is a TYPED PAIR in globals: kind|value.
_rls() { # $1 = query answer ('' = query fails), env via _RLS_*
    local ans="$1"
    # shellcheck disable=SC2317,SC2329
    tmux() { [[ -n "$ans" ]] && printf '%s' "$ans"; [[ -n "$ans" ]]; }
    AE_TMUX_SERVER="${_RLS_SHIM:-}" TMUX="${_RLS_TMUX:-}" resolve_launch_tmux_server
    unset -f tmux
    printf '%s|%s' "$_LAUNCH_SRV_KIND" "$_LAUNCH_SRV_VALUE"
    return 0
}
