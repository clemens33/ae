# Fixture bundle for the atomic publication check: wrapper, core, frozen glue,
# and immutable sibling installer. No network or repository path is involved.
_remote_make_bundle() {
    local version="$1" root="$2" dir digest
    dir="$_remote_fixture/$root"
    mkdir -p "$dir"
    printf '#!/usr/bin/env bash\nprintf "ae %s\\n" --version\n' "$version" >"$dir/ae-core"
    cp "$(dirname "$AE_BIN")/ae-entry" "$dir/ae"
    _sed_i -e "s/^_AE_ENTRY_VERSION=.*/_AE_ENTRY_VERSION=\"${version}\"/" "$dir/ae"
    cp "$AE_BIN" "$dir/ae-glue"
    _sed_i -e "s/^AE_VERSION=.*/AE_VERSION=\"${version}\"/" "$dir/ae-glue"
    cp "$_remote_installer" "$dir/install"
    chmod +x "$dir/ae-core" "$dir/ae" "$dir/ae-glue" "$dir/install"
    tar -czf "$_remote_fixture/$root.tar.gz" -C "$_remote_fixture" "$root"
    digest="$(remote_sha256 "$_remote_fixture/$root.tar.gz")"
    printf '%s  %s.tar.gz\n' "$digest" "$root" >"$_remote_fixture/$root-SHA256SUMS"
}
