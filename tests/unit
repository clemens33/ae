# ── the byte-count truncation must not come back (issue #7 round 2, item 3) ──
# The spawn site kept the original idiom and reproduced the abort verbatim; a second
# copy of a fixed bug is still the bug. That site is the core's since B move 2, so what
# survives here is the CLASS guard — no `printf '%.200s' … | tr` anywhere in the glue —
# which is the half that would catch the idiom being reintroduced at a new site.
assert_eq "cap: the byte-count truncate-then-tr idiom appears nowhere in the glue" "1" \
    "$([[ "$AE_SOURCE" != *"printf '%.200s' \"\${user_prompt:-}\" | tr"* ]] && echo 1 || echo 0)"

# No byte-count truncation feeding tr may return anywhere in ae: that pairing IS
# the bug (byte cut -> partial sequence -> BSD tr aborts under a UTF-8 locale).
#
# THREAT MODEL, stated because it decides how far this goes: accidental
# reintroduction — a copy-paste of the old idiom, or a new site written in the
# old habit. Not adversarial evasion. After three rounds of chasing spellings
# the honest position is that a regex over shell text will always have another
# spelling, so this is a cheap tripwire and NOT what makes the invariant true.
# What makes it true is behavioural: ae_cap_summary is exercised across five
# locales for boundary safety AND enforced byte length, and the emit path is
# driven end-to-end through a regenerated _lib. If this guard and those tests
# ever disagree, the tests are right.
#
# COVERED, each mutation-pinned:
#   count  : head -c N | head -c "$v" | head -c $v | head -cN (attached)
#            printf '%.Ns' and printf "%.Ns"
#   sink   : tr | command tr | /usr/bin/tr (any path prefix), piped DIRECTLY
#            from the truncation
#   layout : one line, split after |, split after \, comment-only lines
#            interleaved in the continuation
# NOT COVERED, deliberately, and the claim does not pretend otherwise:
#   - an INTERVENING pipeline stage between the cut and tr (head -c200 | cat | tr)
#   - a truncation whose result reaches tr through an intermediate VARIABLE
#   - indirection (eval, aliases, a wrapper function under another name)
# The spelling space is provably unbounded, so coverage is settled by
# SUBTRACTION: the assertion below claims the direct pipe and nothing more.
#
# Continuations are joined first, comment-only lines dropped as they are joined:
# a pipeline broken after `|` or `\` is one logical line to the shell, and a
# comment sitting inside it does not end the pipeline.
_bc_src="$(LC_ALL=C awk '
    {
        line = $0
        while (line ~ /\\[[:space:]]*$/ || line ~ /\|[[:space:]]*$/) {
            sub(/\\[[:space:]]*$/, "", line)
            if ((getline nxt) <= 0) break
            sub(/^[[:space:]]+/, "", nxt)
            if (nxt ~ /^#/) continue
            line = line " " nxt
        }
        print line
    }' <<<"$AE_SOURCE")"
_bc_cut='(head[[:space:]]+-c[[:space:]]*["'"'"']?\$?\{?[A-Za-z0-9_]+\}?["'"'"']?|printf[[:space:]]+["'"'"']%\.[0-9]+s["'"'"'])'
_bc_tr='(command[[:space:]]+)?([A-Za-z0-9_./-]*/)?tr[[:space:]]'
assert_eq "no byte-count truncation pipes DIRECTLY into tr (count literal/var/attached; tr bare/command/path; continued lines; intervening stages NOT claimed)" "0" \
    "$(LC_ALL=C grep -cE "${_bc_cut}[^|]*\|[[:space:]]*${_bc_tr}" <<<"$_bc_src" || true)"

