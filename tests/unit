# ── Stage 0 — external actor protocol + session UUID ─────────────────
# Two infrastructure changes that prepare ae for out-of-band chat bridges:
# (1) external actor prefixes (telegram:*, discord:*) flow through the send
#     and ask/review helpers as event-only sinks — no tmux paste, no
#     ae_resolve failure.
# (2) every ae session gets a stable UUID (session_id=) in meta at creation,
#     preserved across resume + rename + transfer.

# The three structural pins that stood here read the frozen send body for the
# event-only sink family, its position before target resolution, and the fall-
# through that still resolves an ordinary name. B move 1 took all three into the
# core (src/send.rs: an external sink is event-only, decided before resolution),
# and the bash body they read is gone. The core pins them in its own suite; the
# glue's remaining half — that the internal delivery entry which used to bypass
# this rule is not generated at all — is pinned with the helper emission set.

# Session UUID: meta written at session creation includes session_id= line.
assert_eq "session-uuid: meta template includes session_id field" "1" \
    "$([[ "$AE_SOURCE" == *'session=${SESSION}'*'session_id=${SESSION_ID}'* ]] && echo 1 || echo 0)"

# Session UUID: backfill — resume preserves any existing session_id, fresh
# session generates a new UUID via gen_uuid.
assert_eq "session-uuid: backfill via PRESERVED_SESSION_ID + gen_uuid fallback" "1" \
    "$([[ "$AE_SOURCE" == *'PRESERVED_SESSION_ID="$(grep'*'^session_id='*'${PRESERVED_SESSION_ID:-$(gen_uuid)}'* ]] && echo 1 || echo 0)"

# Session UUID: cmd_rename only edits session= line; session_id is preserved
# implicitly because sed doesn't touch it.
assert_eq "session-uuid: cmd_rename preserves session_id (sed only edits session= line)" "1" \
    "$([[ "$AE_SOURCE" == *'_ae_sed_inplace "s/^session=.*/session=${new_name}/"'* && "$AE_SOURCE" != *'_ae_sed_inplace "s/^session_id='* ]] && echo 1 || echo 0)"

# Behavioral: gen_uuid produces something matching UUID-shape (so the new
# field's value passes downstream consumers' validation).
_t_uuid_out="$(gen_uuid)"
assert_eq "session-uuid: gen_uuid produces UUID-shaped output" "1" \
    "$([[ "$_t_uuid_out" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] && echo 1 || echo 0)"
unset _t_uuid_out

