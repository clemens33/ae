# ── callee lexer: END-OF-LIFE, DO NOT EXTEND ────────────────────────
# Recorded ruling (2026-08-02): this hand-written lexer over canonical
# `declare -f` output is the last hand-rolled parser in the guard, and it is
# where the final three defects of the night lived. Its remaining failures are
# a QUOTE-AWARENESS dimension — a quoted operand that merely LOOKS like shell
# syntax arms the matcher — and that dimension is unbounded, so the next patch
# would be #14 of the same class. The component is therefore frozen: its
# replacement (a real parser) is queued as a DESIGN DECISION, because a parser
# means shfmt-AST or a python-tier walker and tests/unit's "bash, no deps"
# contract is not ours to amend.
#
# DO NOT PATCH THESE. The two known specimens are pinned as assertions below,
# deliberately asserting the WRONG-BUT-CURRENT behaviour so they turn hard-red
# the day a quote-aware replacement lands:
#     A. a quoted operand that looks like an opener:  command echo "<<FAKE_H"
#     B. a fake and a real opener on one line:        command echo "<<FAKE_H" <<REAL
#
# Everything else in this guard is generated-artifact ground truth; this is the
# one remaining place that reads shell text as text.
_closure_strip_heredocs() {
    # LC_ALL=C: `declare -f` re-prints ae_sanitize_utf8's 0x80-0xFF bracket
    # literals as RAW bytes, and a multibyte-aware awk refuses them
    # ("towc: multibyte conversion failure"), truncating the body stream at that
    # function. Every canonical-body stage runs in byte semantics for that
    # reason — see the doctrine note at the closure guard.
    LC_ALL=C awk '
        nq > 0 {
            t = $0
            if (dash[qi]) { sub(/^\t+/, "", t) }
            if (t == q[qi]) { qi++; if (qi > nq) { nq = 0; qi = 1 } }
            next
        }
        {
            rest = $0
            # Neutralise herestrings FIRST. `match()` scans forward, so on
            # `<<< "$s"` it starts at the SECOND `<`, reads `<< "$s"` as a
            # heredoc opener, and arms the filter with a delimiter that never
            # arrives — swallowing every remaining line of every body. ae is
            # full of `<<<`, so this silently emptied the whole analysis.
            gsub(/<<</, "@@@", rest)
            nq = 0; qi = 1
            while (match(rest, /<<-?[ \t]*("[^"]*"|\047[^\047]*\047|[A-Za-z_][A-Za-z0-9_.-]*)/)) {
                tok = substr(rest, RSTART, RLENGTH)
                d = (tok ~ /^<<-/) ? 1 : 0
                sub(/^<<-?[ \t]*/, "", tok)
                gsub(/^["\047]|["\047]$/, "", tok)
                nq++; q[nq] = tok; dash[nq] = d
                rest = substr(rest, RSTART + RLENGTH)
            }
            print
        }'
}

# Command position over canonical re-prints: plain, $( ), backtick, and both
# directions of process substitution.
_closure_tokens() {
    # STATUS, not a flag. The previous version set _CLOSURE_LEX_ERR from inside
    # `{ ... } | sed` — the left side of a pipeline is a SUBSHELL — and this
    # function is itself called through $( ), another subshell. The write could
    # never reach the reader, so a real grep rc=2 arrived as rc 0 with an empty
    # flag. Who writes it, who reads it, same process? It was not.
    # Each stage now runs in THIS shell with its status inspected, and the
    # function RETURNS non-zero so the caller can see the failure.
    local _b _one _rc _st=0 _out="" _pat _norm
    _b="$(cat)"
    for _pat in \
        '\$\([a-z_][a-zA-Z0-9_]*' \
        '[<>]\([a-z_][a-zA-Z0-9_]*' \
        '`[a-z_][a-zA-Z0-9_]*' \
        '(^|[ \t;&|(])[a-z_][a-zA-Z0-9_]*([ \t;&]|$)'; do
        # Declaration and assignment are split on purpose: `local x="$(cmd)"`
        # reports the status of `local`, never of cmd.
        # `x="$(cmd)"` is a FAILING COMMAND under set -e: the shell aborts
        # before $? is ever read, so the status can only be captured from a
        # context where errexit is suspended. An `if` condition is such a
        # context; a bare assignment is not.
        if _one="$(LC_ALL=C grep -oE "$_pat" <<<"$_b")"; then
            _rc=0
        else
            _rc=$?
        fi
        # grep: 0 matched, 1 no match (legitimate), 2+ a real error.
        ((_rc <= 1)) || _st=1
        [[ -n "$_one" ]] && _out+="$_one"$'\n'
    done
    ((_st == 0)) || return 2
    _norm="$(LC_ALL=C sed -E 's/^[^a-zA-Z_]+//; s/[^a-zA-Z0-9_]+$//' <<<"$_out")" || return 2
    LC_ALL=C sort -u <<<"$_norm" || return 2
    return 0
}

# ── PINNED KNOWN EDGES of the end-of-life lexer ─────────────────────
if _unit_slow 'end-of-life lexer: the pinned known edges'; then
# These assert the WRONG-BUT-CURRENT behaviour on purpose. They are the visible
# form of the limitation — a quote-unaware filter drops every line after a
