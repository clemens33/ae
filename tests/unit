# ── lead-default Part 1: DEFAULT_CONFIG — model-named aliases, strict pins ──
# Extract the DEFAULT_CONFIG string from source, parse it with the real get_config.
# End on the FIRST line ending in a single quote (the closing quote), not a content
# sentinel — the value grew a trailing [prompt] section, and a fixed last-line marker
# would silently over-capture into ae's code if the layout shifts again.
eval "$(awk '/^DEFAULT_CONFIG=\047/{p=1} p{print} p&&/\047$/{exit}' <<<"$AE_SOURCE")"
_dc_cfg="$(mktemp)"
printf '%s\n' "$DEFAULT_CONFIG" >"$_dc_cfg"
# READ THROUGH THE CORE, not through a second parser. `get_config` went with the
# rest of the glue's config reading (pass 4), and replacing it with a test-local
# INI reader would put a SECOND implementation in front of the file the product
# parses — a fixture that could accept a config the core refuses. `_launch-plan`
# is the core's own resolver: it reads [profiles]/[roster]/[workspace], validates
# the whole workspace, and prints the seats a launch would create. So the seat
# half of this block is now asserted on what a real launch WOULD DO with the
# shipped default, which is a stronger claim than "this key holds this string".
# Rows are US-delimited: seat, slot, name, profile, tool, binary, harness-session,
# command — fields 1..8, which is why the command reads as field 8.
_dc_plan="$("$AE_CORE_BIN" _launch-plan --global "$_dc_cfg" 2>&1 || true)"
_dc_seat() { # <slot> <field-index> -> that field of that seat's row
    awk -v s="$1" -v f="$2" 'BEGIN{FS="\x1f"} $1=="seat" && $2==s {print $f; exit}' <<<"$_dc_plan"
}
# SPEC (identity v2): the seats are NAMES bound in [roster]; `main`/`workers` never
# carry a profile again. `alias:name` in a seat is the exact spelling v2 refuses.
assert_eq "default-config: the shipped default is LAUNCHABLE as written" "1" \
    "$([[ "$_dc_plan" == *"seat"* && "$_dc_plan" != *"not launchable"* ]] && echo 1 || echo 0)"
assert_eq "default-config: main = the lead NAME alone (never profile:name)" "lead" "$(_dc_seat main 3)"
# The standing roster is the JUDGMENT PAIR only (f07ec5f): builders and reviewers
# are spawned per slice and retired when the work is verified, so worker.0 — the
# colead seat — is the whole default worker list.
assert_eq "default-config: workers = the colead seat alone (builders/reviewers are spawned)" \
    "colead" "$(_dc_seat worker.0 3)"
assert_eq "default-config: ...and there is no second worker seat" "" "$(_dc_seat worker.1 3)"
# v2: every seat name is bound to a profile in [roster], and the binding is what
# carries the tool. A seat with no [roster] row would refuse the launch — which is
# now proven by the plan resolving at all, not by reading the key back.
assert_eq "default-config: [roster] binds lead → fable5" "fable5" "$(_dc_seat main 4)"
assert_eq "default-config: [roster] binds colead → gpt56sol" "gpt56sol" "$(_dc_seat worker.0 4)"
assert_eq "default-config: ...and each binding carries its TOOL" "claude|codex" \
    "$(printf '%s|%s' "$(_dc_seat main 5)" "$(_dc_seat worker.0 5)")"
# The MODEL the lead and colead seats actually launch with, out of the resolved
# command — the pin that a family alias or a silent model swap would break.
assert_eq "default-config: the lead seat launches --model fable" "1" \
    "$([[ "$(_dc_seat main 8)" == *'--model fable'* ]] && echo 1 || echo 0)"
assert_eq "default-config: the colead seat launches gpt-5.6-sol" "1" \
    "$([[ "$(_dc_seat worker.0 8)" == *'gpt-5.6-sol'* ]] && echo 1 || echo 0)"
unset -f _dc_seat
unset _dc_plan
# The legacy section is GONE from the shipped default — a file carrying [agents] is
# refused at launch, so shipping one would make a fresh install unlaunchable.
assert_eq "default-config: no [agents] section survives (v2 refuses it at launch)" "0" \
    "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -c '^\[agents\]')"
assert_eq "default-config: the profiles section is the one command table" "1" \
    "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -c '^\[profiles\]')"
assert_eq "default-config: layout = lead-pair" "1" \
    "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -cE '^layout = lead-pair$')"
# STRICT model pins for the profiles NOT in the default roster. These are template
# rows — no seat resolves them, so the core's plan cannot report on them and the
# assertion is necessarily on the shipped text. Matched as a DEFINITION line
# (`name = "…"`), never as a bare substring, so the commentary above each row
# cannot satisfy the pin.
_dc_profile() { printf '%s\n' "$DEFAULT_CONFIG" | sed -n "s/^$1 = //p"; }
assert_eq "default-config: opus5 pins exact --model claude-opus-5 (family alias would drift)" "1" "$([[ "$(_dc_profile opus5)" == *'--model claude-opus-5'* ]] && echo 1 || echo 0)"
