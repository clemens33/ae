# ── lead-default Part 1: DEFAULT_CONFIG — model-named aliases, strict pins, opus48:lead ──
# Extract the DEFAULT_CONFIG string from source, parse it with the real get_config.
eval "$(awk "/^DEFAULT_CONFIG='/{p=1} p{print} p&&/watchdog = true'/{exit}" <<<"$AE_SOURCE")"
_dc_cfg="$(mktemp)"
printf '%s\n' "$DEFAULT_CONFIG" >"$_dc_cfg"
_dc_xdg="$(mktemp -d)"
_dc_get() { CONFIG_FILE="$_dc_cfg" AE_LOCAL_CONFIG="" XDG_RUNTIME_DIR="$_dc_xdg" get_config "$1"; }
# SPEC: Opus is the everyday default lead (Fable left the plans); distinct worker role names.
assert_eq "default-config: main = fable5:lead (frontier lead, cross-model colead beside it)" "fable5:lead" "$(_dc_get workspace.main)"
assert_eq "default-config: workers = colead (worker.0 seat) + builder" "gpt56sol:colead, opus48:builder" "$(_dc_get workspace.workers)"
assert_eq "default-config: layout = lead-pair" "lead-pair" "$(_dc_get workspace.layout)"
# STRICT model pins — a model-named alias must never silently run another model.
assert_eq "default-config: opus48 pins --model opus" "1" "$([[ "$(_dc_get agents.opus48)" == *'--model opus'* ]] && echo 1 || echo 0)"
assert_eq "default-config: fable5 defined + pins --model fable (premium tier)" "1" "$([[ "$(_dc_get agents.fable5)" == *'--model fable'* ]] && echo 1 || echo 0)"
assert_eq "default-config: sonnet5 pins --model sonnet" "1" "$([[ "$(_dc_get agents.sonnet5)" == *'--model sonnet'* ]] && echo 1 || echo 0)"
assert_eq "default-config: gpt56sol pins gpt-5.6-sol" "1" "$([[ "$(_dc_get agents.gpt56sol)" == *'gpt-5.6-sol'* ]] && echo 1 || echo 0)"
assert_eq "default-config: gpt56terra pins gpt-5.6-terra" "1" "$([[ "$(_dc_get agents.gpt56terra)" == *'gpt-5.6-terra'* ]] && echo 1 || echo 0)"
assert_eq "default-config: gpt56luna pins gpt-5.6-luna" "1" "$([[ "$(_dc_get agents.gpt56luna)" == *'gpt-5.6-luna'* ]] && echo 1 || echo 0)"
# NO alias-definition line uses --model best (comments may mention the anti-pattern).
assert_eq "default-config: no alias uses --model best (strict pins only)" "0" "$(printf '%s\n' "$DEFAULT_CONFIG" | grep -E '^[a-z0-9]+ = ' | grep -c -- '--model best')"
# Old tier-named aliases retired.
assert_eq "default-config: tier alias 'optimal' retired" "" "$(_dc_get agents.optimal)"
assert_eq "default-config: tier alias 'fast' retired" "" "$(_dc_get agents.fast)"
rm -f "$_dc_cfg"

# ── get_config: NO disk cache — every call parses fresh (cache races removed) ──────
# The old UID-global cache file (a) served same-second config rewrites STALE (mtime
# keying, 1s resolution — bit the integration suite: a later test read the prior
# test's layout) and (b) raced wrong-owner across concurrent ae invocations with
# different configs (codex repro: 99/300 cross-config reads — check/write/read was
# not one transaction). Direct parse of the <1 KB config cannot lie.
