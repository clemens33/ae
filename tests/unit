#!/usr/bin/env bash
# Test suite for ae pure functions
# shellcheck disable=SC2016
#
# SC2329 ("this function is never invoked") is suppressed SITE BY SITE below, and
# deliberately NOT file-wide. The suite's central idiom is to define a test double
# (tmux(), ssh(), rsync(), _transfer_*(), a pane-capture stub) and then let ae's
# own code call it, and that code arrives via `eval "$(awk ... ae)"` — the call
# site lives inside a STRING, so no static analyser can see it. That makes the
# check unanswerable AT THOSE SITES, which is a statement about 175 censused
# doubles (2026-08-20), not about the file.
# A file-wide disable would be FAIL-OPEN: it also silences the check for every
# double written after today, including ones that really are dead. Site-scoped
# keeps each suppression next to the thing it excuses and leaves the rest of the
# file analyzable — the difference is measurable, and a new dead function added
# below is still reported.
# Note what is NOT bought back, so nobody over-reads a green run: SC2329 is a
# SCOPE check, not a dead-code detector. Measured on shellcheck 0.11.0, it
# reports a function only where nothing could reach it — inside a `$( )`/subshell,
# nested in another body, in unreachable code, or in a script that provably
# terminates. A plain dead TOP-LEVEL function in a script that might be sourced is
# reported in NO file, `ae` included (measured at ae:120, ae:2180, ae:14934,
# ae:14963 and at EOF) — see issue #89.
# Run: ./test (or: bash test)
# No dependencies beyond bash.

set -euo pipefail
# bash >= 4 or refuse NOW. /bin/bash on macOS is 3.2; run under it, this suite gets
# thousands of lines in and dies on an associative array or `${v,,}` in a way that reads
# as a product bug (measured 2026-09-03: a long detour). ae itself re-execs under a newer
# bash; a test harness must not — it would test a different interpreter than it reports.
if [[ -z "${BASH_VERSINFO[0]:-}" ]] || ((BASH_VERSINFO[0] < 4)); then
    echo "$0: needs bash >= 4 (this is ${BASH_VERSION:-unknown}); try /opt/homebrew/bin/bash $0" >&2
    exit 2
fi

# ── Per-block timing (AE_UNIT_TIMING=1) ──────────────────────────────
# "Which of the 194 blocks is the four minutes in?" used to be unanswerable without
# bisecting by hand, so nobody asked it and the suite got slower one block at a time.
#
# ZERO EDITS PER BLOCK, deliberately. The obvious instrumentation — a `_time_block`
# call under every `# ── … ──` header — is 194 edits through a file other people are
# editing, and it puts harness plumbing inside the test bodies. This does it from one
# place instead: a DEBUG trap watches $LINENO cross the header lines that are already
# in the file, so a block is timed because of its header and not because someone
# remembered to annotate it. A renamed or added block needs nothing.
#
# The trap body is one integer comparison and no fork, and it is installed ONLY when
# the timing report is asked for, so the default run pays nothing at all. Note what is
# measured: the trap is not inherited by functions (no `set -T`) and a `$( )` subshell
# gets its own throwaway copy of the counters, so what advances the clock is the
# TOP-LEVEL statement — which is exactly the granularity a block header describes.
# Time is charged to the block whose header was last crossed; a helper defined at the
# top of the file and called from block 180 reports its DEFINITION line, which is
# before every header and therefore advances nothing.
_UB_ON=""
_UB_N=0
_UB_I=0
_UB_CUR=-1
_UB_START=0
_UB_LINE=()
_UB_NAME=()
_UB_USEC=()
# Microseconds as an integer. EPOCHREALTIME renders with the LOCALE's decimal point, so
# the separator is stripped by class rather than by matching a literal '.'; bash 4 has
# no EPOCHREALTIME at all and falls back to whole seconds.
_ub_usec() {
    if [[ -n "${EPOCHREALTIME:-}" ]]; then
        printf '%s' "${EPOCHREALTIME//[!0-9]/}"
    else
        printf '%s000000' "$SECONDS"
    fi
}
_ub_tick() {
    local ln="$1" now
    ((_UB_I < _UB_N)) || return 0
    ((ln >= _UB_LINE[_UB_I])) || return 0
    now="$(_ub_usec)"
    if ((_UB_CUR >= 0)); then _UB_USEC[_UB_CUR]=$((now - _UB_START)); fi
    # A single statement can be past several headers at once (an empty block, or the
    # first statement after a run of them); charge the time to the last one crossed.
    while ((_UB_I < _UB_N)) && ((ln >= _UB_LINE[_UB_I])); do
        _UB_CUR=$_UB_I
        _UB_I=$((_UB_I + 1))
    done
    _UB_START="$now"
    return 0
}
_ub_report() {
    [[ -n "$_UB_ON" ]] || return 0
    local now i
    now="$(_ub_usec)"
    if ((_UB_CUR >= 0)); then _UB_USEC[_UB_CUR]=$((now - _UB_START)); fi
    echo ""
    echo "── slowest blocks (AE_UNIT_TIMING=1) ────────────────────────────────"
    for ((i = 0; i < _UB_N; i++)); do
        printf '%s\t%s\t%s\n' "${_UB_USEC[i]:-0}" "${_UB_LINE[i]}" "${_UB_NAME[i]}"
    done | sort -rn -k1,1 | head -"${AE_UNIT_TIMING_TOP:-10}" |
        awk -F'\t' '{printf "  %7.2fs  line %-6s %s\n", $1/1000000, $2, $3}'
    echo ""
}
if [[ "${AE_UNIT_TIMING:-}" == "1" ]]; then
    # grep -n on the FILE, so the numbers are the file's own — $LINENO is compared
    # against them directly.
    while IFS=: read -r _ubl _ubn; do
        [[ "$_ubl" =~ ^[0-9]+$ ]] || continue
        _UB_LINE+=("$_ubl")
        _UB_NAME+=("$(printf '%s' "$_ubn" | sed 's/^# ── //; s/ *─*$//')")
        _UB_USEC+=(0)
    done < <(grep -n '^# ── ' "$0" || true)
    _UB_N=${#_UB_LINE[@]}
    if ((_UB_N > 0)); then
        _UB_ON=1
        _UB_START="$(_ub_usec)"
        trap '_ub_tick $LINENO' DEBUG
    fi
fi

# ── Slow-block gate (AE_UNIT_FULL=1 runs everything) ─────────────────
# 125 seconds of this suite is 85 seconds of seven rigs that spawn processes, build
# fixture installs and wait on them. Paid once per commit that is a fair price; paid on
# every inner-loop rerun it is most of the reason people stop running the suite.
#
# So the DEFAULT run skips them and `AE_UNIT_FULL=1` runs them — which is the opposite
# polarity from tests/integration's filter, deliberately. There a filter NARROWS an
# unnarrowable gate, so the gate must ignore it; here the gate is the thing that asks
# for more, and `just test-unit` asks. A skipped block cannot make a gate green by
# accident, because the gate sets the variable itself.
#
# THE SUMMARY LINE CARRIES THE SCOPE, on the counts line and not above it: `tail -1` is
# how a result reaches a report, and a warning on the previous line is the one that gets
# cut off. Same reasoning as the integration suite's SCOPED RUN marker.
#
# The gate is used ONLY as `if _unit_slow '<what>'; then … fi` — a condition position,
# where errexit is disabled by definition, so returning 1 to mean "skip" can never abort
# the suite. Nothing inside a gated block may be depended on by a later one; that is a
# property of WHICH blocks are gated (a tail region and six self-contained rigs) and it
# is checked by running the fast suite green, not by hoping.
_UNIT_SKIPPED_N=0
_UNIT_SKIPPED=""
_unit_slow() {
    if [[ "${AE_UNIT_FULL:-}" == "1" ]]; then return 0; fi
    _UNIT_SKIPPED_N=$((_UNIT_SKIPPED_N + 1))
    _UNIT_SKIPPED="${_UNIT_SKIPPED}$1"$'\n'
    return 1
}

PASS=0
FAIL=0
ERRORS=()

assert_eq() {
    local label="$1" expected="$2" actual="$3"
    if [[ "$expected" == "$actual" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected: \"$expected\"\n  actual:   \"$actual\"")
    fi
}

# `timeout` is coreutils — absent on stock macOS. Same contract: 124 on expiry.
_timeout() {
    local secs="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
        return $?
    fi
    if command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
        return $?
    fi
    "$@" &
    local pid=$! i=0
    while ((i < secs * 10)); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        return 124
    fi
    wait "$pid"
}

# Set a file's mtime to an absolute epoch. `touch -d <human date>` is GNU-only;
# `touch -t` takes [[CC]YY]MMDDhhmm[.SS] and is understood by both.
_touch_epoch() {
    local epoch="$1" stamp
    shift
    stamp="$(date -d "@$epoch" +%Y%m%d%H%M.%S 2>/dev/null || date -r "$epoch" +%Y%m%d%H%M.%S)"
    touch -t "$stamp" "$@"
}

# Set a file's mtime to N seconds in the past.
_touch_ago() {
    local secs="$1"
    shift
    _touch_epoch "$(($(date +%s) - secs))" "$@"
}

# Strip the leading whitespace BSD wc pads its counts with (GNU does not).
_count() { tr -d '[:space:]'; }

# Portable in-place sed for the harness: `sed -i EXPR FILE` is GNU-only (BSD
# reads EXPR as the backup suffix). Usage: _sed_i [-e EXPR]... FILE
_sed_i() {
    local file="${!#}" tmp
    local -a args=("${@:1:$#-1}")
    tmp="${file}.sedtmp.$$"
    sed "${args[@]}" "$file" >"$tmp" && mv "$tmp" "$file"
}

# Portable "N seconds ago" as an ISO-8601 UTC stamp. GNU renders an epoch with
# -d @EPOCH, BSD/macOS with -r EPOCH; ae's own code never needs this, only tests.
_utc_ago() {
    local secs="$1" epoch
    epoch=$(($(date -u +%s) - secs))
    date -u -d "@$epoch" +%FT%TZ 2>/dev/null || date -u -r "$epoch" +%FT%TZ
}

# THE PRODUCT HAS NO BASH FILE ANY MORE. Slice Z3 deleted `ae-entry`, the last
# one, so the public `ae` IS the core and this suite drives that binary directly —
# in the CHECKOUT shape, which the core decides from its own location rather than
# from a variable. There is no AE_SOURCE, because there is no product source to
# read: the pins that grepped the wrapper are retired below, block by block, and
# the ones that survive read a FILE (install, the justfile, the workflows).
#
# AE_ROOT is the checkout. AE_BIN is the core binary, and it is the same path as
# AE_CORE_BIN below — one name for the thing the suite runs, one for the tree it
# reads.
AE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
AE_INSTALL_SOURCE="$(cat "$AE_ROOT/install")"

# The core is a PREREQUISITE of this suite, not a fixture some tests opt into: since
# A.1 the glue has no coreless mode, and since A.2c the seat context and the workspace
# manifest are core calls reached through ordinary glue functions (build_ae_context,
# inject_ae_context, regenerate_manifest). The debug build from this tree is bound for
# the whole run, and built here if missing so `bash tests/unit` works on a fresh clone.
#
# EXPORTED, unlike before A.2c. It was kept unexported so the core-binding tests could
# assert an unset variable; every one of them sets AE_CORE_BIN explicitly on its own
# command (including the empty and bogus cases), so the export changes none of them —
# and the alternative, a suite whose DEFAULT is a shape the product refuses, made every
# render test abort instead of asserting.
_AE_UNIT_CORE="$AE_ROOT/target/debug/ae"
if [[ ! -x "$_AE_UNIT_CORE" ]]; then
    (cd "$AE_ROOT" && cargo build --locked --quiet) || {
        echo "tests/unit: could not build the core (cargo build --locked)" >&2
        exit 1
    }
fi
_AE_UNIT_CORE_VER="$("$_AE_UNIT_CORE" --version 2>/dev/null | head -1)"
_AE_UNIT_CORE_VER="${_AE_UNIT_CORE_VER##* }"
export AE_CORE_BIN="$_AE_UNIT_CORE"
AE_BIN="$_AE_UNIT_CORE"

# Isolate config from user's real ~/.ae/config. This suite is run from inside an ae agent
# pane, which EXPORTS the session's identity and config (AE_DIR, AE_HOME, AE_MODE,
# AE_ORIGIN, AE_SESSION, CONFIG_FILE); assigning CONFIG_FILE below keeps the inherited
# export alive, so the pane-exported set is unset first — the same rule as the
# integration preamble.
#
# AE_HOME JOINED THAT LIST IN SLICE Z1, and it is load-bearing rather than tidy: the
# wrapper's CHECKOUT shape HONOURS an inherited AE_HOME (that is what makes `ae-dev`
# and this suite possible), so a fixture that sets only HOME would otherwise reach the
# REAL ~/.ae — and a test expecting "no core here" would find the operator's.
unset AE_DIR AE_HOME AE_MODE AE_ORIGIN AE_SESSION CONFIG_FILE
CONFIG_FILE="/dev/null"
AE_LOCAL_CONFIG=""

# Nothing is extracted from the product any more. The two `eval "$(awk ... )"`
# lifts that stood here pulled the wrapper's tmux sensor, its tmux shim and its
# three core-resolution readers into this shell; slice Z3 deleted all five with
# the file that held them. `_ae_inside_tmux` and the server pair are env DOORS in
# the core now, and the core binds itself, so there is no bash function left for
# this suite to call — only a binary to run.
_IDENT_US=$'\x1f'

# THE SUITE'S OWN CORE CALL, not the product's — and since slice Z3 that is the
# whole of what it is. It was the glue's resolve-and-run; the glue went in Z1, the
# wrapper's frozen-preamble exec replaced it, and Z3 deleted that too. Several
# blocks below still need to CALL a core entry directly (`_context`, `_roster`,
# `_launch-plan`) to assert the document or record it renders, so this runs the
# bound core with the argv the caller gave. It resolves nothing: AE_CORE_BIN is a
# PREREQUISITE of this suite, set in the preamble, and a suite that cannot find
# its core has a broken harness rather than an interesting product state.
_ae_core_preflight_try() {
    local exec_mode=0
    if [[ "${1:-}" == --exec ]]; then
        exec_mode=1
        shift
    fi
    local sub="$1"
    shift
    local bin="${AE_CORE_BIN:-}"
    if [[ -z "$bin" || ! -x "$bin" ]]; then
        printf "ae: the ae core is required for '%s'\n" "$sub" >&2
        exit 2
    fi
    ((exec_mode)) && exec "$bin" "$sub" "$@"
    local crc=0
    "$bin" "$sub" "$@" || crc=$?
    return "$crc"
}

# The seat-context render, as a TEST-LOCAL call onto the core entry the glue used
# to wrap. `build_ae_context` was that wrapper; B glue cut 2 retired it with the
# launch flow, because the core's `_launch` renders each seat's context itself and
# no bash caller is left. The DOCUMENT is still a contract, and the prose pins
# below are its only assertion, so the suite calls `_context` the way the glue did
# — same argv, same overlay order.
build_ae_context() {
    local meta_dir="$1" session="${2:-}" work_dir="${3:-}" slot="${4:-}"
    local -a cfg=()
    [[ -n "${CONFIG_FILE:-}" && -f "${CONFIG_FILE:-}" ]] && cfg+=(--global "$CONFIG_FILE")
    [[ -n "${AE_LOCAL_CONFIG:-}" && -f "${AE_LOCAL_CONFIG:-}" ]] && cfg+=(--local "$AE_LOCAL_CONFIG")
    _ae_core_preflight_try _context "$meta_dir" "$session" "$work_dir" "$slot" ${cfg[@]+"${cfg[@]}"}
}

