# The kind is TRANSPORTED at the one call site that holds a wrapped command — driven
# through the REAL send_agent_cmd rather than asserted from the source, because what
# matters is the kind that reaches the readiness wait, not the shape of a line. The
# stub records the argument it was handed.
_oc_kind() { # <cmd> <pre-injection-cmd> -> the tool kind send_agent_cmd resolved
    local _md
    _md="$(mktemp -d)"
    cat >"${_md}/probe.sh" <<'PROBE'
set -uo pipefail
AE_SOURCE="$(cat "$AE_BIN")"
for fn in shell_quote _cmd_split_binary _cmd_strip_env_prefix _cmd_binary_kind tool_kind_from_cmd _launch_id_probeable \
    _launch_injected_head _launch_is_resume _launch_probe_claude _launch_probe_codex \
    _launch_resume_decider build_launch_command send_agent_cmd; do
    eval "$(awk "/^${fn}\(\) \{/,/^\}\$/" <<<"$AE_SOURCE")"
done
write_launch_script() { printf '%s/launch.sh' "$MD"; }
tmux_paste_submit() { return 0; }
wait_for_agent_start() { printf '%s' "$2" >"${MD}/kind"; return 0; }
exec 8>"${MD}/lock"
send_agent_cmd '%0' "$CMD" "" "$MD" main "" "$PRE" >/dev/null 2>&1
PROBE
    AE_BIN="$AE_BIN" MD="$_md" CMD="$1" PRE="$2" "${BASH:-bash}" "${_md}/probe.sh" >/dev/null 2>&1 || true
    command cat "${_md}/kind" 2>/dev/null || printf 'NONE'
    rm -rf "$_md"
}
assert_eq "#53: the readiness wait receives the transported kind, not a re-parsed one" "opencode" \
    "$(_oc_kind "env OPENCODE_CONFIG=/tmp/a\\ b/oc.json opencode --auto" "opencode --auto")"
# Control: with nothing transported it must still work for an unwrapped command, or the
