    "$(AE_END_SERVER='L:rescue' _eot '')"
assert_eq "end override: AE_END_SERVER ignored when meta has a typed record" "S:/real" \
    "$(AE_END_SERVER='L:rescue' _eot 'S:/real')"
_eok() { local mv="$1" kv="$2"
    # shellcheck disable=SC2317,SC2329
    read_session_meta() { case "$2" in tmux_server) printf '%s' "$mv" ;; tmux_server_kind) printf '%s' "$kv" ;; esac; }
    _end_target_kind ghost; unset -f read_session_meta; return 0
}
