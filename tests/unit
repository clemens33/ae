_ar48_c_multi="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-multi","target":"b:two","summary":"q"}' \
    '{"ts":"2","actor":"a:one","action":"cancel","ref":"c-multi","summary":"first withdrawal"}' \
