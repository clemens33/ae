assert_eq "transfer-orch: spaces-variant — path check was reached" "1" "$_orch_path_check_seen"

# Self-stop guard regression: detect_current_session returns target → exit 2.
# shellcheck disable=SC2317
detect_current_session() { echo "$_orch_session"; return 0; }
ORCH_CALL_LOG=()
