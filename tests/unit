# ── ae end: resolve BEFORE the destructive prompt (Clemens 2026-07-21) ──
# `ae end <bogus>` used to PROMPT the destructive confirm, then error "not found"
# after y. The classifier resolves the target up front; not-found returns empty so
# the caller errors WITHOUT prompting. (Ordering itself is pinned by an integration
# CALLER PROBE — round-6 lesson: source text cannot prove a runtime order. These
# unit checks pin the classifier's decisions.)
_end_sdir="$(mktemp -d)"; _end_wdir="$(mktemp -d)"
# _end_target_class resolves liveness via the server-aware _end_live_id (which runs
# `command tmux` on the target's OWN server, bypassing any tmux() shim), so stub
# _end_live_id itself: one exact live session 'livesess', nothing else. A prefix like
# 'livese' must NOT match (review B1: exact id, never a prefix).
# shellcheck disable=SC2317  # invoked indirectly by _end_target_class
_end_live_id() { [[ "$1" == livesess ]] && printf '$0'; return 0; }
# Under the Option-B invariant the classifier consults the RECORD first: only a
# positive record earns a live probe; blank/ambiguous classifies from dirs alone.
# shellcheck disable=SC2317  # invoked indirectly by _end_target_class
_end_target_server() { [[ "$1" == livesess || "$1" == livese ]] && printf 'somesrv'; return 0; }
# shellcheck disable=SC2317  # invoked indirectly by _end_target_class
_end_target_kind() { [[ "$1" == livesess || "$1" == livese ]] && printf 'name'; return 0; }
mkdir -p "$_end_sdir/stopped-one" "$_end_wdir/wt-one"
_ec() { SESSIONS_DIR="$_end_sdir" WORKTREES_DIR="$_end_wdir" _end_target_class "$1"; }
# B1 — exact live-session match, never a prefix.
assert_eq "end class: an EXACT live session → live" "live" "$(_ec livesess)"
assert_eq "end class: a PREFIX of a live session → NOT live (review B1)" "" "$(_ec livese)"
assert_eq "end class: a session dir → stopped" "stopped" "$(_ec stopped-one)"
assert_eq "end class: a worktree dir with no session dir → worktree" "worktree" "$(_ec wt-one)"
assert_eq "end class: an unknown name → empty (caller errors, no prompt)" "" "$(_ec ghost)"
assert_eq "end class: empty target → empty, never 'stopped' (guard)" "" "$(_ec "")"
# B2 — dot components rejected BEFORE the filesystem lookup: '.' → SESSIONS_DIR itself,
# '..' → its parent, both real dirs that used to misclassify as 'stopped'.
assert_eq "end class: '.' → empty (dot-component rejected, review B2)" "" "$(_ec .)"
assert_eq "end class: '..' → empty (dot-component rejected, review B2)" "" "$(_ec ..)"
# Path-traversal guard: a name with '/' is never a valid session/worktree basename.
mkdir -p "$_end_sdir/sub/evil"
assert_eq "end class: a slash-bearing name is never resolved (traversal guard)" "" "$(_ec sub/evil)"
unset -f tmux _ec _end_live_id _end_target_server _end_target_kind
rm -rf "$_end_sdir" "$_end_wdir"
# Truthful prompt body (pure, no read): "pushes" appears ONLY when the end will push.
# Local sessions (the default) never push. I2: the branch shown is SANITIZED (matches
# end_session's sanitize_branch_name), and the wording no longer overclaims an
# unconditional push (end_session only pushes when there are unpushed commits).
assert_eq "end prompt: pushing target shows a commit+push line with the SANITIZED branch" "1" \
    "$([[ "$(_end_confirm_body proj live push "")" == *"ae/proj"* \
        && "$(_end_confirm_body 'feat/x y' live push "")" == *"ae/feat-x-y"* ]] && echo 1 || echo 0)"
assert_eq "end prompt: push wording is conditional, not an unconditional claim (I2)" "1" \
    "$([[ "$(_end_confirm_body proj live push "")" == *"unpushed"* ]] && echo 1 || echo 0)"
# 2nd-delta IMPORTANT: a git worktree with NO origin remote COMMITS but cannot push —
# the prompt must say exactly that, not claim a push (overclaim) nor stay silent about
# the commit (underclaim). Three-valued contract: push | commit | ''.
