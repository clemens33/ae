assert_eq "say: only the non-chat branch flattens newlines" "1" \
    "$(awk '/if \[\[ "\$action" == "chat" \]\]; then/{c=1} c&&/^    else$/{e=1} c&&!e&&/summary\/\/\$.\\n./{bad=1} END{print (bad?0:1)}' <<<"$AE_SOURCE")"

# ── ae_cap_summary: multibyte-safe truncation (issue #7) ────────────
# The shipped bug: `head -c 200 | tr` cut at a BYTE boundary, and when an
# em-dash (3 bytes) straddled it the partial sequence reached BSD tr under a
# UTF-8 locale — "Illegal byte sequence", rc 1, and the whole ask failed with no
# delivery and no event. Alignment-dependent, so the same text one byte over
# worked. These exercise the real function, at every straddling offset.
eval "$(awk '/^ae_cap_summary\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
eval "$(awk '/^ae_sanitize_utf8\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
