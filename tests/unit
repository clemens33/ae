# (B1) AN EMPTY CONFIRMED SET MUST EXECUTE NOTHING. A count cannot tell "the human
# confirmed nothing" from "no one was asked" — an interactive `ae end all` with nothing
# to end legitimately confirms an empty list, and reading that zero as "no confirmation"
# sent execution back to a fresh enumeration.
_ar48_empty_confirm_probe() { # <force: yes|no> -> what was ended
    (
        declare -A _AE_END_FROZEN_PLAN=()
        declare -A _AE_END_FROZEN_AUTHORITY=()
        declare -a _AE_END_CONFIRMED_TARGETS=()
        _AE_END_TARGETS_CONFIRMED=false
        _AE_END_PLAN_LINE=""
        local calls="${TMPDIR:-/tmp}/ae48-empty.$$"
        : >"$calls"
        # shellcheck disable=SC2317,SC2329  # invoked by cmd_end, not lexically here
        _end_archive_plan() { printf 'keep\t/arch/%s\tfalse\n' "$1"; }
        # shellcheck disable=SC2317,SC2329
        _end_target_class() { printf 'live'; }
        # shellcheck disable=SC2317,SC2329
        _end_will_push() { printf ''; }
        # In the PROMPT case: nothing exists when the prompt is built, and a session
        # appears while it waits — so anything ended came from a re-enumeration.
        # In the FORCE case: a session exists all along, because there the enumeration at
        # action time IS the only list there is and it must still work.
        local _probe_force="$1"
        # shellcheck disable=SC2317,SC2329
        list_ae_sessions() {
            if [[ "$_probe_force" == yes ]]; then
                printf 'exists-all-along\n'
            elif [[ -s "$calls" ]]; then
                printf 'appeared-later\n'
            fi
            printf 'x' >>"$calls"
            return 0
        }
        # shellcheck disable=SC2317,SC2329
        iter_stopped_sessions() { :; }
        # shellcheck disable=SC2317,SC2329
        end_session() { printf 'ENDED %s\n' "$1"; }
        local outfile="${TMPDIR:-/tmp}/ae48-empty.$$.out"
        if [[ "$1" == yes ]]; then
            cmd_end -f all >"$outfile" 2>&1 || true
        else
            cmd_end all <<<'y' >"$outfile" 2>&1 || true
        fi
        grep -c '^ENDED' "$outfile" | tr -d '[:space:]'
        rm -f "$outfile" "$calls"
    )
}
