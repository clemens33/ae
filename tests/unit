# live neighbour that merely starts with the same letters.
assert_eq "session-id: a gone session resolves to EMPTY, not to its neighbour" "" "$(printf '%s' "$_ls_dump" | _roster_session_id foo)"
assert_eq "session-id: session names may contain spaces" '$3' "$(printf '%s' "$_ls_dump" | _roster_session_id 'has spaces')"
assert_eq "session-id: an id passes through unchanged" '$7' "$(printf '%s' "$_ls_dump" | _roster_session_id '$7')"
assert_eq "session-id: empty name resolves to empty" "" "$(printf '%s' "$_ls_dump" | _roster_session_id '')"
# EMPTY MUST MEAN SKIP. A bare '-t ""' resolves to tmux's CURRENT session — i.e. someone
# else's bar — so every writer guards on a non-empty id before touching anything.
assert_eq "session-id: writers SKIP when the id is empty (never a bare target)" "1" \
    "$([[ "$AE_SOURCE" == *'_sid="$(_watchdog_session_id)"'* \
        && "$AE_SOURCE" == *'[[ -n "$_sid" ]] || return 0'* \
        && "$AE_SOURCE" == *'tmux set-option -t "$_sid" "$1" "$2"'* \
        && "$AE_SOURCE" == *'tmux set-option -t "$_sid" -u "$_o"'* ]] && echo 1 || echo 0)"
# D1: the bar THEMING writes are the same class, resolved through the same tmux command.
assert_eq "session-id: _ae_apply_status_bar themes by resolved id, and bails if gone" "1" \
    "$([[ "$AE_SOURCE" == *"list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id \"\$session\""* \
        && "$AE_SOURCE" == *'"${_t[@]}" set-option -t "$_st" status-left'* \
        && "$AE_SOURCE" != *'"${_t[@]}" set-option -t "$session" status-left'* ]] && echo 1 || echo 0)"
# No name-targeted option write may survive anywhere in the watchdog.
assert_eq "session-id: no NAME-targeted option write remains in the watchdog" "1" \
