set -euo pipefail
eval "$(awk '/^_deliver_launch_prompt\(\) \{/,/^\}$/' "$AE_BIN")"
_wait_input_ready() { return 0; }
tmux() { return 1; }                      # the pane is gone: every tmux call fails
tmux_paste_submit() { return "$WANT"; }
_spawn_emit_event() { printf 'EVENT %s\n' "$4" >>"${MD}/events"; return 0; }
_deliver_launch_prompt "%9" codex "the brief" "$MD" worker.0 >/dev/null 2>&1
PROBE
    AE_BIN="$AE_BIN" MD="$_md" WANT="$1" "${BASH:-bash}" "${_md}/probe.sh" || _rc=$?
    printf 'rc=%s|file=%s|event=%s' "$_rc" \
        "$([[ -s "${_md}/undelivered.launch-worker.0.txt" ]] && echo 1 || echo 0)" \
        "$(command grep -c 'launch-delivery-failed' "${_md}/events" 2>/dev/null | tr -d '[:space:]' || echo 0)"
    rm -rf "$_md"
}
