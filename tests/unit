# THE ESCAPING PROOF. Every argv path wraps the context in single quotes with `'\''`
# doubling; an input carrying an apostrophe is the only one that exercises it. The
# specimen is the WORK DIRECTORY, not an agent name: since the #59 round-2 grammar an
# apostrophe in a name is refused at the boundary and suppressed at the sink, so a name
# can no longer reach the escaper — but a human's checkout path legitimately can, and it
# is interpolated into the very same sentence. The assertion parses the shipped command
# the way the SHELL will (`set --` parses, it does not run) and reads the text back out
# of the real argument, rather than substring-matching a string that was never
# round-tripped.
_idq_dir="$(mktemp -d)"
printf 'schema=2\nmode=local\nseat.main=lead\nprofile.main=cl\n' >"$_idq_dir/meta"
_idq_work="/tmp/o'brien/my proj"
_idq_sent="Directory: ${_idq_work}."
assert_eq "#59: the apostrophe specimen is really built (fixture is the hazard)" "1" \
    "$([[ "$(CONFIG_FILE=/dev/null build_ae_context "$_idq_dir" "sess" "$_idq_work" "main")" == *"$_idq_sent"* ]] && echo 1 || echo 0)"
# ...and the identity sentence still rides alongside it, so this pin cannot pass on a
# build that silently dropped the #59 line.
assert_eq "#59: the specimen also carries the identity line (not a degraded build)" "1" \
    "$([[ "$(CONFIG_FILE=/dev/null build_ae_context "$_idq_dir" "sess" "$_idq_work" "main")" == *"You are agent lead (slot main)."* ]] && echo 1 || echo 0)"
for _idq in "claude:3" "gemini:3" "grok:2"; do
    _idq_tool="${_idq%%:*}"
    _idq_pos="${_idq##*:}"
    _idq_cmd="$(CONFIG_FILE=/dev/null inject_ae_context "$_idq_tool" "$_idq_dir" "sess" "$_idq_work" "main")"
    assert_eq "#59: ${_idq_tool} argv survives the quote (parsed as the shell would)" "1" \
        "$(eval "set -- ${_idq_cmd}"
           [[ "${!_idq_pos}" == *"$_idq_sent"* && "${!_idq_pos}" == *"You are agent lead (slot main)."* ]] && echo 1 || echo 0)"
done
# codex puts it inside `developer_instructions=<ctx>`, so the arg is the whole assignment.
_idq_codex="$(CONFIG_FILE=/dev/null inject_ae_context "codex" "$_idq_dir" "sess" "$_idq_work" "main")"
assert_eq "#59: codex argv survives the quote (parsed as the shell would)" "1" \
    "$(eval "set -- ${_idq_codex}"
       [[ "$3" == developer_instructions=* && "$3" == *"$_idq_sent"* ]] && echo 1 || echo 0)"
# opencode's transport is a FILE, so the quote never meets an escaper — but the bytes
# must still arrive intact, and the config path itself is shell_quote'd into the command.
_idq_oc="$(CONFIG_FILE=/dev/null inject_ae_context "opencode" "$_idq_dir" "sess" "$_idq_work" "main")"
assert_eq "#59: opencode instructions file carries the apostrophe path verbatim" "1" \
