{
    # Single chronological call log — captures every ssh + rsync in order.
    # SSH calls record both argv and the stdin-streamed heredoc body, so tests
    # can assert that %q-quoted values reached the remote script intact.
    declare -ag ORCH_CALL_LOG=()
    ssh() {
        local script=""
        if [[ ! -t 0 ]]; then script="$(cat)"; fi
        ORCH_CALL_LOG+=("ssh-argv: $*")
        [[ -n "$script" ]] && ORCH_CALL_LOG+=("ssh-stdin: $script")
        return 0
    }
    rsync() {
        ORCH_CALL_LOG+=("rsync: $*")
        return 0
