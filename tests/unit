# ── the shared request sensor learns a THIRD terminal state ──────────────────────
# `cancelled` is how a WITHDRAWN request stops reading as outstanding work. It is
# identity-checked exactly as `replied` is, because a state that closes a request is as
# consequential when it closes it without an answer as with one. This sensor is shared by
# construction between the `requests` helper (live in every session) and the archive
# digest, so each rule below is asserted on the one definition both of them read.
_ar48_cancel_fixture() { # <lines...> -> events file path
    local f="$_ar48_root/cancel.$RANDOM.jsonl"
    printf '%s\n' "$@" >"$f"
    printf '%s' "$f"
}
_ar48_status_of() { # <events-file> <ref>
    _ar_request_states "$1" | command grep -F "$2" | cut -d$'\x1f' -f1
}
_ar48_summary_of() { # <events-file> <ref>
    _ar_request_states "$1" | command grep -F "$2" | cut -d$'\x1f' -f12
}

_ar48_c_own="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"ae:compact:op1","action":"ask","ref":"c-own","target":"c:main","summary":"hand over"}' \
    '{"ts":"2","actor":"ae:compact:op1","action":"cancel","ref":"c-own","summary":"digest-only"}')"
assert_eq "sensor-cancel: the request's OWN sender may withdraw it" "cancelled" "$(_ar48_status_of "$_ar48_c_own" c-own)"
assert_eq "sensor-cancel: and the row carries the withdrawal's own text" "digest-only" "$(_ar48_summary_of "$_ar48_c_own" c-own)"

_ar48_c_other="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"ae:compact:op1","action":"ask","ref":"c-other","target":"c:main","summary":"hand over"}' \
    '{"ts":"2","actor":"someone:else","action":"cancel","ref":"c-other","summary":"not yours to withdraw"}')"
assert_eq "sensor-cancel: a cancel from anyone ELSE leaves the request pending" "pending" \
    "$(_ar48_status_of "$_ar48_c_other" c-other)"

# RECENCY AMONG THE VALID ONES, both directions — an invalid newer event must not mask a
# valid older one.
# CROSS-KIND: an older invalid cancel alongside a newer valid reply. (This fixture used
# to carry the label of the SAME-KIND masking case below while never building it — the
# invalid event was older than the valid one, so it could not have masked anything.)
_ar48_c_repwins="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-repwins","target":"b:two","summary":"q"}' \
    '{"ts":"2","actor":"nobody","action":"cancel","ref":"c-repwins","summary":"bogus"}' \
    '{"ts":"3","actor":"b:two","action":"reply","ref":"c-repwins","target":"a:one","summary":"the answer"}')"
assert_eq "sensor-cancel: an older invalid cancel does not disturb a newer valid reply" "replied" \
    "$(_ar48_status_of "$_ar48_c_repwins" c-repwins)"

# SAME-KIND MASKING, both directions. Keeping only the NEWEST RAW event of each kind and
# validating it afterwards let an invalid newer event bury a valid older one — measured
# in both kinds before the fix, and the reason validity is now decided over EVERY
# retained candidate rather than over whichever happened to be newest.
_ar48_c_cancelmask="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-cancelmask","target":"b:two","summary":"q"}' \
    '{"ts":"2","actor":"a:one","action":"cancel","ref":"c-cancelmask","summary":"valid withdrawal"}' \
    '{"ts":"3","actor":"stranger","action":"cancel","ref":"c-cancelmask","summary":"not yours"}')"
assert_eq "sensor-cancel: a NEWER INVALID cancel cannot bury an older VALID cancel" "cancelled" \
    "$(_ar48_status_of "$_ar48_c_cancelmask" c-cancelmask)"
assert_eq "sensor-cancel: and the valid withdrawal's own text is what the row carries" "valid withdrawal" \
    "$(_ar48_summary_of "$_ar48_c_cancelmask" c-cancelmask)"
_ar48_c_replymask="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-replymask","target":"b:two","summary":"q"}' \
    '{"ts":"2","actor":"b:two","action":"reply","ref":"c-replymask","target":"a:one","summary":"the answer"}' \
    '{"ts":"3","actor":"stranger","action":"reply","ref":"c-replymask","target":"nobody","summary":"noise"}')"
assert_eq "sensor-cancel: a NEWER INVALID reply cannot bury an older VALID reply either" "replied" \
    "$(_ar48_status_of "$_ar48_c_replymask" c-replymask)"
assert_eq "sensor-cancel: and the answer that counted is the one shown" "the answer" \
    "$(_ar48_summary_of "$_ar48_c_replymask" c-replymask)"
# Slot-qualified, same shape: an older wrong-session cancel then a newer right-session one.
_ar48_c_slotmask="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-slotmask","target":"b:two","actor_slot":"main","target_slot":"worker.0","actor_session":"S","target_session":"S","summary":"q"}' \
    '{"ts":"2","actor":"a:one","action":"cancel","ref":"c-slotmask","actor_slot":"main","actor_session":"OTHER","summary":"wrong session"}' \
    '{"ts":"3","actor":"a:one","action":"cancel","ref":"c-slotmask","actor_slot":"main","actor_session":"S","summary":"right session"}')"
assert_eq "sensor-cancel: the newest VALID candidate wins under slot qualification too" "right session" \
    "$(_ar48_summary_of "$_ar48_c_slotmask" c-slotmask)"
_ar48_c_canwins="$(_ar48_cancel_fixture \
    '{"ts":"1","actor":"a:one","action":"ask","ref":"c-canwins","target":"b:two","summary":"q"}' \
    '{"ts":"2","actor":"b:two","action":"reply","ref":"c-canwins","target":"a:one","summary":"answered"}' \
    '{"ts":"3","actor":"a:one","action":"cancel","ref":"c-canwins","summary":"withdrawn after all"}')"
assert_eq "sensor-cancel: a valid cancel NEWER than a valid reply is the terminal state" "cancelled" \
