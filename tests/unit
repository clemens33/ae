AE_SOURCE="$(cat "$AE_BIN")"

# The core is a PREREQUISITE of this suite, not a fixture some tests opt into: since
# A.1 the glue has no coreless mode, and since A.2c the seat context and the workspace
# manifest are core calls reached through ordinary glue functions (build_ae_context,
# inject_ae_context, regenerate_manifest). The debug build from this tree is bound for
# the whole run, and built here if missing so `bash tests/unit` works on a fresh clone.
#
# EXPORTED, unlike before A.2c. It was kept unexported so the core-binding tests could
# assert an unset variable; every one of them sets AE_CORE_BIN explicitly on its own
# command (including the empty and bogus cases), so the export changes none of them —
# and the alternative, a suite whose DEFAULT is a shape the product refuses, made every
# render test abort instead of asserting.
_AE_UNIT_CORE="$(cd "$(dirname "$0")/.." && pwd)/target/debug/ae"
if [[ ! -x "$_AE_UNIT_CORE" ]]; then
    (cd "$(dirname "$0")/.." && cargo build --locked --quiet) || {
        echo "tests/unit: could not build the core (cargo build --locked)" >&2
        exit 1
    }
fi
_AE_UNIT_CORE_VER="$("$_AE_UNIT_CORE" --version 2>/dev/null | head -1)"
_AE_UNIT_CORE_VER="${_AE_UNIT_CORE_VER##* }"
export AE_CORE_BIN="$_AE_UNIT_CORE"

# Isolate config from user's real ~/.ae/config. This suite is run from inside an ae agent
# pane, which EXPORTS the session's identity and config (AE_DIR, AE_MODE, AE_ORIGIN,
# AE_SESSION, CONFIG_FILE); assigning CONFIG_FILE below keeps the inherited export alive,
# so the pane-exported set is unset first — the same rule as the integration preamble.
unset AE_DIR AE_MODE AE_ORIGIN AE_SESSION CONFIG_FILE
CONFIG_FILE="/dev/null"
AE_LOCAL_CONFIG=""

# Extract pure function definitions from ae (matches "func() {" but not "func() ${BODY}" heredoc copies)
eval "$(awk '
    /^(_ae_stat|_ae_json_first|_ae_inside_tmux|_validate_session_name|_session_name_usable|_session_path_is_safe|_require_session_path_safe|_path_is_direct_child|parse_config|get_config|_ae_install_tmux_shim|read_session_meta|_cmd_split_binary|_cmd_binary_kind|tool_kind_from_cmd|read_launch_id_for_slot|read_launch_time_for_slot)\(\) \{/ { printing=1 }
    printing { print }
    printing && /^\}$/ { printing=0 }
' "$(dirname "$0")/../ae")"

# Identity v2: the core shim, extracted once here rather than per section. Several of
# the functions above now REACH it (_spawn_rollback, _cmd_spawn, _resolve_roster), and
# a shim that is merely undefined at their call site fails as command-not-found — which
# their `||` fallbacks swallow, so the test would read as "the product declined" when
# what happened is that the harness never offered it a core. `_IDENT_US` is the record
# separator the core and the glue share; it is a top-level assignment in ae, not a
# function, so it is restated rather than extracted.
eval "$(awk '/^(_identity_core|_ae_core_try|_ae_core_preflight_try|_ae_core_bin_input|_ae_core_current_input|_ae_core_bin_version)\(\) \{/{p=1} p{print} p&&/^\}$/{p=0}' "$(dirname "$0")/../ae")"
_IDENT_US=$'\x1f'

# The seat-context render, as a TEST-LOCAL call onto the core entry the glue used
# to wrap. `build_ae_context` was that wrapper; B glue cut 2 retired it with the
# launch flow, because the core's `_launch` renders each seat's context itself and
# no bash caller is left. The DOCUMENT is still a contract, and the prose pins
# below are its only assertion, so the suite calls `_context` the way the glue did
# — same argv, same overlay order.
build_ae_context() {
    local meta_dir="$1" session="${2:-}" work_dir="${3:-}" slot="${4:-}"
    local -a cfg=()
    [[ -n "${CONFIG_FILE:-}" && -f "${CONFIG_FILE:-}" ]] && cfg+=(--global "$CONFIG_FILE")
    [[ -n "${AE_LOCAL_CONFIG:-}" && -f "${AE_LOCAL_CONFIG:-}" ]] && cfg+=(--local "$AE_LOCAL_CONFIG")
    _ae_core_preflight_try _context "$meta_dir" "$session" "$work_dir" "$slot" ${cfg[@]+"${cfg[@]}"}
}

