# BOTH RENDERS ARE NOW TEST-LOCAL CALLS ONTO THE CORE ENTRY, for the reason
# `build_ae_context` already is: the final cut retired `regenerate_manifest`, the
# bash wrapper that assembled `_manifest-render`'s argv, because the core renders
# the manifest itself at launch and at refresh and no bash caller was left. The
# DOCUMENT is still a contract, so the suite calls the entry the way the glue did
# — same argv, same overlay order — rather than losing the prose pins with the
# wrapper.
regenerate_manifest() {
    local sess="$1" wdir="$2" origin="$3" mode="$4" main_pane="$5" sessions_dir="$6"
    local -a cfg=()
    [[ -n "${CONFIG_FILE:-}" && -f "${CONFIG_FILE:-}" ]] && cfg+=(--global "$CONFIG_FILE")
    [[ -n "${AE_LOCAL_CONFIG:-}" && -f "${AE_LOCAL_CONFIG:-}" ]] && cfg+=(--local "$AE_LOCAL_CONFIG")
    _ae_core_preflight_try _manifest-render "$sessions_dir" "$sess" "$wdir" "$origin" "$mode" \
        "$main_pane" ${cfg[@]+"${cfg[@]}"}
}
