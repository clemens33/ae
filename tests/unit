# Fixture bundle for the atomic publication check: core, immutable sibling
# installer, and the member manifest the installed core validates itself against
# — the THREE members a bundle carries since slice Z3 deleted the wrapper. No
# network or repository path is involved.
#
# The manifest is written the same way `just bundle` and `remote_manifest_write`
# write it (bare basenames, ae-core first), because it is the same contract: a
# fixture that spelled it differently would prove the installer accepts a shape
# nothing ships.
_remote_make_bundle() {
    local version="$1" root="$2" dir digest
    dir="$_remote_fixture/$root"
    mkdir -p "$dir"
    printf '#!/usr/bin/env bash\nprintf "ae %s\\n" --version\n' "$version" >"$dir/ae-core"
    cp "$_remote_installer" "$dir/install"
    chmod +x "$dir/ae-core" "$dir/install"
    printf '%s  ae-core\n%s  install\n' \
        "$(remote_sha256 "$dir/ae-core")" "$(remote_sha256 "$dir/install")" \
        >"$dir/SHA256SUMS"
    tar -czf "$_remote_fixture/$root.tar.gz" -C "$_remote_fixture" "$root"
    digest="$(remote_sha256 "$_remote_fixture/$root.tar.gz")"
    printf '%s  %s.tar.gz\n' "$digest" "$root" >"$_remote_fixture/$root-SHA256SUMS"
}
