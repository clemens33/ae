assert_eq "session-name: every hostile class refused by the grammar" \
    "REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT|REJECT" \
    "$(for _n in '../victim' '../../.ssh' 'a/b' '/abs' '..' '.' '-rf' 'a:b' '' \
        '.dotproject' '.lifecycle.foo.lock' 'a\b' '$HOME' '%s' '@x' 'a;rm -rf /' '#{pane_id}' 'has space'; do
           if _validate_session_name "$_n" 2>/dev/null; then printf 'ACCEPT|'; else printf 'REJECT|'; fi
       done | sed 's/|$//')"
# Control bytes were previously rejected only AFTER the lock file existed.
assert_eq "session-name: ASCII controls refused (newline, tab, CR)" "REJECT|REJECT|REJECT" \
    "$(for _n in $'a\nb' $'a\tb' $'a\rb'; do
           if _validate_session_name "$_n" 2>/dev/null; then printf 'ACCEPT|'; else printf 'REJECT|'; fi
       done | sed 's/|$//')"
# Length is bounded, and the bound was measured against real derived names: the
# longest default_session_name produces across 177 real project directories is
# 62, so a 63 cap would have sat one character from breaking a legitimate launch.
assert_eq "session-name: bounded at 128, and the measured 62-char derived name fits" \
    "ACCEPT|ACCEPT|ACCEPT|REJECT" \
    "$(_n62="$(printf 'a%.0s' {1..62})"
       _n128="$(printf 'a%.0s' {1..128})"
       _n129="$(printf 'a%.0s' {1..129})"
       for _n in "$_n62" "$_n128" 'a' "$_n129"; do
           if _validate_session_name "$_n" 2>/dev/null; then printf 'ACCEPT|'; else printf 'REJECT|'; fi
       done | sed 's/|$//')"
# The grammar is stated in exactly one place, and the error shows it.
assert_eq "session-name: the error message echoes the grammar verbatim" "1" \
    "$(_e="$(_validate_session_name '.dotproject' 2>&1 >/dev/null)"
       [[ "$_e" == *'^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$'* ]] && echo 1 || echo 0)"

# default_session_name GUARANTEES the grammar — a contract, not an aspiration.
# The old version rewrote only '/' and '.', so a no-name `ae` in 'My Project',
# café or a deep tree produced a name its own validator refuses: the validator
# would have broken ordinary launches in exactly those directories.
_dsn_root="$(mktemp -d)"
assert_eq "default-name: hostile working directories all yield valid names" \
    "OK|OK|OK|OK|OK|OK|OK" \
    "$(for _d in 'My Project' 'café' 'foo+bar' 'a b(c)d' '.hidden' 'ümlaut-Ünd' \
        "$(printf 'deep/%.0s' {1..40})leaf"; do
           mkdir -p "$_dsn_root/$_d" 2>/dev/null || { printf 'SKIP|'; continue; }
           _n="$(cd "$_dsn_root/$_d" && default_session_name)"
           if _validate_session_name "$_n" 2>/dev/null; then printf 'OK|'; else printf 'REFUSED|'; fi
       done | sed 's/|$//')"
# The BODY is capped, never the hash: two long sibling paths differ only in the
# hash, so truncating it would collide sessions instead of shortening a name.
assert_eq "default-name: deep paths cap at 128 and KEEP their distinguishing hash" "1|1|1" \
    "$(mkdir -p "$_dsn_root/$(printf 'deep/%.0s' {1..40})one" "$_dsn_root/$(printf 'deep/%.0s' {1..40})two"
       _a="$(cd "$_dsn_root/$(printf 'deep/%.0s' {1..40})one" && default_session_name)"
       _b="$(cd "$_dsn_root/$(printf 'deep/%.0s' {1..40})two" && default_session_name)"
       printf '%s|%s|%s' \
           "$([[ ${#_a} -le 128 ]] && echo 1 || echo 0)" \
