# ── CHOKEPOINT: one door for publishing executable artifacts ─────────
# This replaces an INVENTORY of writers, which was fail-open in three ways at
# once: it recognised two exact chmod spellings, `sort -u` collapsed a second
# writer that happened to share the variable name $dest, and `chmod 700`,
# `install -m 755` and `u+x` were invisible to it entirely. A registry is a
# parallel structure that drifts away from the thing it describes; a chokepoint
# cannot drift, because a new writer has to enter it in order to exist.
#
# THE INVARIANT: in COMMAND position, the only executable-mode chmod/install in
# ae is the chokepoint's own. Everything else is either a non-executable mode or
# a session-helper temp file. The session helpers are exempted BY SHAPE —
# "${AE_META}/<name>.tmp.$$" and nothing else — not by name: they already
# publish temp + chmod + mv, and they have their own guard family (emission
# completeness, template-vs-emitted parity, the doctor --refresh canary), so
# churning those 20+ emission sites would disturb exactly the artifacts that
# family protects for no behavioural gain. Their three former direct writes
# (mark-done, peak, loop) were converted to the same temp+mv shape rather than
# exempted, so the sentence above is true of ALL of them.
#
# SPELLINGS COVERED: bare `chmod`, `command chmod`, an absolute path
# (/bin/chmod, /usr/bin/chmod), a `--` separator, and `install [-m]`, in command
# position — line start, after ; && ||, after `!`, or first inside a `{` group.
# NOT COVERED, stated rather than implied: an executable bit acquired without a
# mode word — `cp -p` from an executable source, a permissive umask, `install`
# with no -m, a wrapper function that chmods on its caller's behalf, or an
# artifact that chmods itself at run time. Those are outside the pattern this
# guard can see; the chokepoint remains the contract, this is its enforcement.
_pub_raw="$(printf '%s' "$AE_SOURCE" \
    | command grep -nE '(^[[:space:]]*|[;&|{][[:space:]]*|![[:space:]]*)((command|/usr/bin/|/bin/)[[:space:]]*)?(chmod|install)([[:space:]]+--)?([[:space:]]+-m)?[[:space:]]+([0-7]{3,4}|[augo]*[+=][rwxXst]+|"\$mode")' \
    | command grep -v '^[0-9]*:[[:space:]]*#' \
    | command grep -vE 'chmod 0?6[0-7][0-7] ' \
    | command grep -vE 'chmod 0700 "\$AE_META"$' || true)"
# The session-helper exemption is DESTINATION-checked and BLOCK-LOCAL. Two holes
# closed here, both the same same-name-collapse class:
#   - operand-checked: an AE_META temp chmod'd here and mv'd to a machine-global
#     path there was exempted on the strength of the chmod alone;
#   - globally matched: a NEW writer borrowing an existing helper's name
#     (send.tmp.$$, mv to $CONFIG_DIR) was exempted by the LEGITIMATE send
#     helper's mv somewhere else in the file.
# So the matching mv must be the very NEXT LINE — which is the shape every real
# helper emission already has — and it must land the same <name> back under
# ${AE_META}. Line numbers are carried through the pipeline for exactly this.
_pub_left=""
while IFS= read -r _pl; do
    [[ -n "$_pl" ]] || continue
    _pnum="${_pl%%:*}"
    _ptext="${_pl#*:}"
    _ptext="${_ptext#"${_ptext%%[![:space:]]*}"}"
    if [[ "$_ptext" =~ ^chmod\ 0700\ \"\$\{AE_META\}/([A-Za-z0-9._-]+)\.tmp\.\$\$\"$ ]]; then
        _pn="${BASH_REMATCH[1]}"
        _pnext="$(printf '%s' "$AE_SOURCE" | sed -n "$((_pnum + 1))p")"
        _pnext="${_pnext#"${_pnext%%[![:space:]]*}"}"
        if [[ "$_pnext" == "mv \"\${AE_META}/${_pn}.tmp.\$\$\" \"\${AE_META}/${_pn}\"" ]]; then
            continue
        fi
    fi
    _pub_left+="${_ptext}"$'\n'
done <<<"$_pub_raw"
assert_eq "chokepoint: the only raw executable-mode chmod left in ae is its own" \
    'if ! chmod "$mode" "$tmp"; then' "${_pub_left%$'\n'}"
unset _pub_raw _pub_left _pl _pn _pnum _ptext _pnext
# FOUR callers now, all in the refresh shim writer: the passthrough loop,
# mark-done, and the two aliases. (The launch script and the DATA sibling went with
# the launch flow; the telegram daemon retired with the bash bridge.) A wrapper
# that enters the chokepoint is the discipline working, not a bypass; what the
# guard forbids is a second definition or a hand-rolled publish.
assert_eq "chokepoint: one definition, and every artifact writer enters it" "1|4" \
    "$(_d="$(printf '%s' "$AE_SOURCE" | command grep -c '^_publish_executable_artifact() {' || true)"
       _u="$(printf '%s' "$AE_SOURCE" | command grep -c '_publish_executable_artifact "' || true)"
       printf '%s|%s' "$_d" "$_u")"
# The data sibling (`_publish_data_artifact`, mode 0600) went with the opencode
# context files it published; the core writes those now, non-executable, through
# its own document publisher.

# Behavioural: atomicity BY CONSTRUCTION (#31). The generator is passed as a
# command, not piped in, precisely so its failure is visible before anything is
# renamed — a pipeline producer can die after emitting a prefix, and a `cat`
# downstream would publish that prefix over a live artifact.
_pub_dir="$(mktemp -d)"
# shellcheck disable=SC2317,SC2329
_pub_good() { printf '%s\n' '#!/bin/sh' 'echo NEW'; }
# shellcheck disable=SC2317,SC2329
_pub_partial() { printf '%s\n' '#!/bin/sh' 'echo HALF'; return 1; }
printf '%s\n' '#!/bin/sh' 'echo OLD' >"$_pub_dir/art"
chmod 0700 "$_pub_dir/art"
assert_eq "chokepoint: a good generator publishes, at the requested mode, no temp left" "NEW|700|0" \
    "$(_publish_executable_artifact "$_pub_dir/art" 0700 _pub_good
       _body="$(tail -1 "$_pub_dir/art")"
       _perm="$(_ae_stat mode "$_pub_dir/art")"
       _left="$(find "$_pub_dir" -name 'art.tmp.*' | wc -l | tr -d '[:space:]')"
       printf '%s|%s|%s' "${_body#echo }" "$_perm" "$_left")"
assert_eq "chokepoint: a generator that dies mid-write leaves the LIVE artifact whole" "NEW|1|0" \
    "$(_rc=0; _publish_executable_artifact "$_pub_dir/art" 0700 _pub_partial 2>/dev/null || _rc=$?
       _body="$(tail -1 "$_pub_dir/art")"
       _left="$(find "$_pub_dir" -name 'art.tmp.*' | wc -l | tr -d '[:space:]')"
       printf '%s|%s|%s' "${_body#echo }" "$_rc" "$_left")"
rm -rf "$_pub_dir"
unset _pub_dir
unset -f _pub_good _pub_partial

