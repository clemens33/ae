# Every existing-session boundary asks the PATH question, not only the name one.
# EIGHT now: launch, transfer, rename source+target, and #33's FOUR stop boundaries
# — the public dispatch (_stop_dispatch, which must validate before self-detection
# because the self branch promises a durable path), the two internal ones
# (_stop_one_session and the directly-callable _stop-supervisor), and round 10's
# _stop_refuse_unidentified, which writes events into a session directory and so
# builds a path from a name like any other. A new entrypoint does not INHERIT a
# boundary — it must ENTER it, and this count is what makes forgetting fail loudly.
# It did exactly that when the eighth arrived.
# Nine since #48: archive preview reads a session directory by name, so it asks the
# same question before touching it — a preview of a symlinked "session" would read
# whatever the link points at.
# Ten since slice 2: `ae compact` resolves a session by name and then ENDS it, which is
# the most consequential consumer yet — a symlinked "session" would be archived and
# deleted through the link.
# FOUR since B glue cut 2: the launch fall-through asks it again. The core owns
# the name grammar and derives an unnamed launch's name, but it does not look at
# the path OBJECT — so the half bash can still answer exactly, a name the caller
# TYPED, is answered before the core is handed anything.
assert_eq "path-safe: all four surviving boundaries consult it (launch, archive preview, rename x2)" "4" \
    "$(printf '%s' "$AE_SOURCE" | command grep -c '_require_session_path_safe ' || true)"
# ...and the two stop entrypoints ask BOTH questions, in the right order: before
# any lock, meta or event path is built from the name.
# The stop entrypoints' name+path validation pin went with `_stop`, which is one
# core operation now and refuses an unusable name before it reads anything.
rm -rf "$_sp_root" "$_sp_out"
unset _sp_root _sp_out
# `_canonical_dir` went with the derived-name ownership guard that used it: the
# core compares a derived name's owner against the caller's directory itself.
rm -rf "$_snu_root" "$_snu_outside"
unset _snu_root _snu_outside
# Transfer is a CREATION boundary on its destination in BOTH directions (pull
# builds sessions/<name>/ locally, push builds it on the peer), so a same-name
# copy cannot migrate a name into compliance — it takes the strict grammar and
# has no legacy arm at all. The escape survives only where a session is consumed
# IN PLACE: the rename source.
assert_eq "boundaries: rename target strict, source migratable" "1" \
    "$([[ "$AE_SOURCE" == *'_validate_session_name "$new_name" || return 1'* \
        && "$AE_SOURCE" == *'_session_name_usable "$old_name" || return 1'* \
        && "$AE_SOURCE" != *"cannot contain '/', ':', or '.'"* ]] && echo 1 || echo 0)"

# ── DERIVED NAMES: lossy body, hash over the RAW path — RETIRED (B glue cut 2) ─────────────────────
# 6 assertion(s) went with their subject: the whole launch and resume is ONE core operation now (`_launch`,
# src/session_launch.rs): the argv grammar, the resume decision, the command
# build, the context injection, the launch script and its paste all moved with
# it, and the bash bodies these assertions called are gone.

# ── SPAWN ROLLBACK — the whole operation is the core's ───────────────────
# The rollback used to be bash's: a spawn that failed after reserving its seat
# stripped the slot's meta rows under meta.lock, dropped the launch artifacts and
# killed the pane through the ownership guard. B move 2 took `_spawn` whole, and
# the rollback went with it — there is no `_spawn_rollback` left to hold to the
# locked-rewrite invariant, and the arms that drove it (a sentinel holding
# meta.lock, the byte-identical refusal, the strip-only-my-slot proof) went with
# their subject. The core owns the same order and pins it in its own suite;
# end to end it is the integration spawn-retire domain.

# The launch-script write and its checked assignment are the core's: `_launch` and
# `_spawn` both roll their whole operation back when one cannot be published.

# The bridge: an unusable core or a refused new-session must reach the caller,
# whose "autostart failed" warning was unreachable while a cosmetic `|| true`
# tail forced rc 0. The bash daemon artifact is retired — the spawn now resolves
# the RUST core (operator input, absolute, executable, reports a version) and
# hands tmux DIRECT ARGV.
eval "$(awk '/^(_telegram_spawn_daemon|_telegram_coexistence_guard|_telegram_coexistence_probe|_telegram_coexistence_same_bot|_telegram_coexistence_token|_ae_core_bin_input|_ae_core_current_input|_ae_core_bin_version)\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"

# ── COEXISTENCE (pre-P5): the core comes from three sources, in one order ────
# env AE_CORE_BIN -> <AE_HOME>/core/current -> config workspace.core. The middle
# one is what makes an install visible to every RE-ENTRY (a helper exec'ing its
# recorded ae path, the watchdog's `telegram _supervise`, compact's child) with
# no environment to go stale. Each case below differs from its neighbour by ONE
# fact, so a precedence that silently collapsed would show up as a wrong answer
# rather than as a still-green suite.
_cc_dir="$(mktemp -d)"
mkdir -p "$_cc_dir/core"
printf '%s\n' '[workspace]' 'core = /from/config' >"$_cc_dir/config"
printf '%s\n' '/from/current' >"$_cc_dir/core/current"
assert_eq "core input: env AE_CORE_BIN outranks core/current and the config" "/from/env" \
    "$(AE_CORE_BIN=/from/env AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
assert_eq "core input: core/current outranks the config when no env is set" "/from/current" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
# Leading/trailing whitespace is the installer's newline and a hand edit's tab —
# trimmed, because a path with a stray space is a path that will not execute.
printf '%s\n' '   /from/current   ' >"$_cc_dir/core/current"
assert_eq "core input: the current line is trimmed" "/from/current" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
# NOT ABSOLUTE = IGNORED, fail-quiet, exactly like an unusable config value. A
# relative path would resolve against whatever directory the caller happened to
# be in, and `~` is not expanded by this reader, so pinning either would pin a
# core that cannot be run.
# The tilde is DELIBERATELY unexpanded: this reader refuses a `~` value rather
# than expanding one, so the literal is the fixture.
# shellcheck disable=SC2088
for _cc_bad in 'relative/ae' '~/.ae-next/core/0.0.0/ae' '' '   '; do
    printf '%s\n' "$_cc_bad" >"$_cc_dir/core/current"
    assert_eq "core input: a non-absolute current ('$_cc_bad') falls through to the config" "/from/config" \
        "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
done
# A SYMLINK is not a pointer the installer published, and this reader is the one
# RE-ENTRY uses — helpers, the watchdog's supervise, compact's child, a bare `ae`
# with AE_HOME set. None of them pass through the wrapper's own refusal, so the
# check has to be here as well.
rm -f "$_cc_dir/core/current"
# THE LINK MUST POINT AT A READABLE POINTER FILE, or this test cannot fail. A
# DANGLING link is rejected by the `-f` test that follows anyway, so the symlink
# rule would never be the sole decider and dropping it would leave the row green
# — measured, on this very assertion.
printf '%s\n' '/from/the-link-target' >"$_cc_dir/core/real-current"
ln -s "$_cc_dir/core/real-current" "$_cc_dir/core/current"
assert_eq "core input: a SYMLINKED core/current is ignored, not followed" "/from/config" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
rm -f "$_cc_dir/core/current" "$_cc_dir/core/real-current"
assert_eq "core input: a missing core/current falls through to the config" "/from/config" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR="$_cc_dir" _ae_core_bin_input)"
# Nothing anywhere is a REFUSAL (rc 1), not an empty string that a caller might
# treat as a path.
assert_eq "core input: no env, no current, no config -> rc 1" "1" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE=/dev/null CONFIG_DIR="$_cc_dir" _ae_core_bin_input >/dev/null 2>&1; echo $?)"
# An unset CONFIG_DIR must not abort under `set -u` — the reader is called from
# paths that run before any session home is derived.
assert_eq "core input: an unset CONFIG_DIR is not an error" "/from/config" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cc_dir/config" CONFIG_DIR='' _ae_core_bin_input)"
rm -rf "$_cc_dir"
unset _cc_dir _cc_bad

# ── _ae_core_bind: NO OPERATOR INPUT NEVER TOUCHES AN EXISTING PIN ───────────
# Clearing the pair used to be the rollback to a bash body. There is no bash body
# any more, so clearing turns a working session into one where every core-owned
# command refuses — `end` included, which leaves it UNENDABLE with no way back
# except a refresh that has input. Repro that shipped: `doctor --refresh <name>`
# on an install with no core input at all (no core/current, no workspace.core, no
# AE_CORE_BIN) reached this function through sync_session_assets, cleared both
# keys, printed OK and exited 0.
eval "$(awk '/^(_ae_core_bind|set_session_meta_value|set_session_meta_values)\(\) \{/{p=1} p{print} p&&/^\}$/{p=0}' <<<"$AE_SOURCE")"
_cb_dir="$(mktemp -d)"
mkdir -p "$_cb_dir/core"
: >"$_cb_dir/config"
cat >"$_cb_dir/meta" <<CBMETA
session=cb
ae_core=$_AE_UNIT_CORE
ae_core_version=$_AE_UNIT_CORE_VER
CBMETA
_cb_before="$(cat "$_cb_dir/meta")"
(
    AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cb_dir/config" CONFIG_DIR="$_cb_dir" \
        _ae_core_bind "$_cb_dir"
) >/dev/null 2>&1
assert_eq "core bind: a USABLE pin survives a no-input refresh byte-identical" \
    "$_cb_before" "$(cat "$_cb_dir/meta")"

# An UNUSABLE existing pin is left alone too — meta is not the place that reports
# it, `ae doctor`'s core-pin check is. Rewriting it here would only turn one
# broken shape into another.
cat >"$_cb_dir/meta" <<CBMETA
session=cb
ae_core=/nonexistent/ae-core
ae_core_version=
CBMETA
_cb_before="$(cat "$_cb_dir/meta")"
(
    AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE="$_cb_dir/config" CONFIG_DIR="$_cb_dir" \
        _ae_core_bind "$_cb_dir"
) >/dev/null 2>&1
assert_eq "core bind: an UNUSABLE pin is left byte-identical, never cleared" \
    "$_cb_before" "$(cat "$_cb_dir/meta")"

# The positive arm is unchanged: real input still pins the PAIR it resolved.
cat >"$_cb_dir/meta" <<'CBMETA'
session=cb
ae_core=
ae_core_version=
CBMETA
(
    AE_CORE_BIN="$_AE_UNIT_CORE" AE_LOCAL_CONFIG='' CONFIG_FILE="$_cb_dir/config" \
        CONFIG_DIR="$_cb_dir" _ae_core_bind "$_cb_dir"
) >/dev/null 2>&1
assert_eq "core bind: usable operator input pins the path and the version it reports" \
    "${_AE_UNIT_CORE}|${_AE_UNIT_CORE_VER}" \
    "$(printf '%s|%s' "$(grep '^ae_core=' "$_cb_dir/meta" | cut -d= -f2-)" \
        "$(grep '^ae_core_version=' "$_cb_dir/meta" | cut -d= -f2-)")"

# An unusable INPUT still pins the path with an EMPTY version — the shape a
# helper reads as configured-but-unbindable, distinct from no pin at all.
(
    AE_CORE_BIN=/nonexistent/ae-core AE_LOCAL_CONFIG='' CONFIG_FILE="$_cb_dir/config" \
        CONFIG_DIR="$_cb_dir" _ae_core_bind "$_cb_dir"
) >/dev/null 2>&1
assert_eq "core bind: unusable operator input pins the path with an empty version" \
    "/nonexistent/ae-core|" \
    "$(printf '%s|%s' "$(grep '^ae_core=' "$_cb_dir/meta" | cut -d= -f2-)" \
        "$(grep '^ae_core_version=' "$_cb_dir/meta" | cut -d= -f2-)")"
rm -rf "$_cb_dir"
unset _cb_dir _cb_before

# ── doctor: a blank or unusable session pin is NAMED ─────────────────────────
# Since the core became required there is nothing behind an empty pin, so a
# session can sit unusable with `ae doctor` otherwise clean. WARN, not FAIL —
# `doctor --refresh` (with input) repairs it and the rest of the install is fine.
assert_eq "doctor: core-pin check warns per session and names the repair" "1" \
    "$([[ "$AE_SOURCE" == *'doctor_report "WARN" "core-pin" "session ${_cp_bad} has no core bound; end/archive will refuse"'* \
        && "$AE_SOURCE" == *'doctor_report "WARN" "core-pin-hint" "repair with '"'"'ae doctor --refresh'"'"'"'* \
        && "$AE_SOURCE" == *'if [[ -z "$_cpbin" || -z "$_cpver" || ! -x "$_cpbin" ]]; then'* ]] && echo 1 || echo 0)"

# ── COEXISTENCE (pre-P5): the guard is SKIPPED for a default-server instance ──
# The installed ae has no AE_TMUX_SERVER and must never be gated by the guard
# that exists to protect it. Asserted here rather than only in the integration
# section because this is the case that must never probe anything at all.
assert_eq "coexistence guard: no AE_TMUX_SERVER -> no probe, no refusal" "0" \
    "$(AE_TMUX_SERVER='' _telegram_coexistence_guard >/dev/null 2>&1; echo $?)"
# The refusal wording is the operator's only instruction, and both halves of it
# are load-bearing: stop the other bridge, or give this one its own bot.
assert_eq "coexistence guard: the refusal names both ways out" "1" \
    "$([[ "$AE_SOURCE" == *"run 'ae telegram stop', or give ae-next a distinct bot token"* ]] && echo 1 || echo 0)"
# The probe clears BOTH redirections. -L names the socket, TMUX_TMPDIR names the
# DIRECTORY it lives in, and $TMUX would hand the probe this pane's server: any
# one of the three left in place points "the default server" somewhere else.
assert_eq "coexistence guard: the probe clears TMUX and TMUX_TMPDIR and names -L default" "1" \
    "$([[ "$AE_SOURCE" == *"env -u TMUX -u TMUX_TMPDIR tmux -L default list-sessions -F '#{session_name}'"* ]] && echo 1 || echo 0)"
# ...and there is NO environment knob to point it elsewhere. An env-selectable
# default server would be a production bypass of the guard.
assert_eq "coexistence guard: no env knob selects the probed server" "0" \
    "$(command grep -c 'AE_COEXIST_DEFAULT_SERVER' <<<"$AE_SOURCE" || true)"
# The block is marked for deletion at the entry flip, where one ae returns.
assert_eq "coexistence guard: the block is marked for deletion at the entry flip" "1" \
    "$([[ "$AE_SOURCE" == *'COEXISTENCE (pre-P5): delete at the entry flip'* ]] && echo 1 || echo 0)"
# CHECK -> SPAWN -> RE-CHECK. The pre-check answers about a moment that has
# passed by the time the session exists, and the other instance is the FROZEN
# ae — it can honour no claim this side invents, so looking again and retreating
# is the only move available. TWO call sites, not one: a single guard call is the
# implementation this pair of assertions exists to keep from coming back.
assert_eq "coexistence guard: the spawn asks TWICE — before and after new-session" "2" \
    "$(command grep -c 'if ! _telegram_coexistence_guard; then' <<<"$AE_SOURCE" || true)"
# ...and the retreat kills OUR session, never the other instance's process.
assert_eq "coexistence guard: the retreat kills our own bridge, through our own shim" "1" \
    "$([[ "$AE_SOURCE" == *'tmux kill-session -t "$_TELEGRAM_TMUX_SESSION" 2>/dev/null || true'* ]] && echo 1 || echo 0)"
# The residual is DOCUMENTED rather than implied: a window in which both can poll.
assert_eq "coexistence guard: the residual window is stated at the site" "1" \
    "$([[ "$AE_SOURCE" == *'The window is BOUNDED by this re-check, not closed by it'* ]] && echo 1 || echo 0)"
# A default-server aewatch is REFUSED, never killed: it belongs to the other
# instance. The instruction has to name the session and the way to stop it.
assert_eq "coexistence guard: a default-server aewatch is refused with an instruction" "1" \
    "$([[ "$AE_SOURCE" == *'tmux kill-session -t ae-aewatch on the default server'* ]] && echo 1 || echo 0)"
# The one kill of ae-aewatch that remains is the NAMED-server retirement, which
# is our own sidecar on our own server — a different fact from the refusal above.
assert_eq "coexistence guard: our own named-server aewatch retirement still kills" "1" \
    "$(command grep -c 'tmux kill-session -t ae-aewatch 2>/dev/null || true' <<<"$AE_SOURCE" || true)"

# No core configured at all (empty AE_CORE_BIN, empty config) — refuse, don't spawn.
assert_eq "caller: spawn refuses when no ae core is configured" "1" \
    "$(AE_CORE_BIN='' AE_LOCAL_CONFIG='' CONFIG_FILE=/dev/null CONFIG_DIR="$(mktemp -d)" _telegram_spawn_daemon 2>/dev/null; echo $?)"
# Configured, but not an absolute executable: a relative path would resolve
# against wherever the caller happened to run.
assert_eq "caller: spawn refuses a core that is not an absolute executable" "1" \
    "$(AE_CORE_BIN=target/release/ae AE_LOCAL_CONFIG='' CONFIG_FILE=/dev/null CONFIG_DIR="$(mktemp -d)" _telegram_spawn_daemon 2>/dev/null; echo $?)"
# The fake cores live under a path holding a SPACE and a QUOTE, because argv
# survival is the whole point of the direct-argv spawn below.
_tg_core_dir="$(mktemp -d)/a b'c"
mkdir -p "$_tg_core_dir"
_tg_core="$_tg_core_dir/ae core"
printf '%s\n' '#!/bin/sh' 'echo "ae 0.0.0"' >"$_tg_core"
chmod 0700 "$_tg_core"
_tg_mute="$_tg_core_dir/mute core"
printf '%s\n' '#!/bin/sh' 'exit 1' >"$_tg_mute"
chmod 0700 "$_tg_mute"
# Executable, absolute — but it answers no version, so it is not a core.
assert_eq "caller: spawn refuses a core that reports no version" "1" \
    "$(AE_CORE_BIN="$_tg_mute" AE_LOCAL_CONFIG='' CONFIG_FILE=/dev/null CONFIG_DIR="$(mktemp -d)" _telegram_spawn_daemon 2>/dev/null; echo $?)"
# shellcheck disable=SC2317,SC2329
tmux() { case "$*" in new-session*) return 1 ;; *) return 0 ;; esac; }
assert_eq "caller: spawn returns non-zero when tmux refuses the session" "1" \
    "$(AE_CORE_BIN="$_tg_core" AE_LOCAL_CONFIG='' _TELEGRAM_TMUX_SESSION=ae-telegram CONFIG_FILE=/dev/null CONFIG_DIR="$(mktemp -d)" _telegram_spawn_daemon 2>/dev/null; echo $?)"
# ...and with both healthy it still reports success, cosmetic tmux calls or not.
# shellcheck disable=SC2317,SC2329
tmux() { case "$*" in set-option* | rename-window*) return 1 ;; *) return 0 ;; esac; }
assert_eq "caller: cosmetic tmux failures do NOT make a started bridge look failed" "0" \
    "$(AE_CORE_BIN="$_tg_core" AE_LOCAL_CONFIG='' _TELEGRAM_TMUX_SESSION=ae-telegram CONFIG_FILE=/dev/null CONFIG_DIR="$(mktemp -d)" _telegram_spawn_daemon 2>/dev/null; echo $?)"
# The daemon's argv, word for word. tmux gets the command as SEPARATE ARGUMENTS
# and execs it directly, so a path holding a space or a quote arrives intact; a
# one-string shell-command would be re-split by /bin/sh, and `printf %q` cannot
# fix that portably (its $'...' output is bash-only and dash mis-parses it).
_tg_argv_out="$(mktemp)"
_tg_home="$(mktemp -d)/x y'z"
mkdir -p "$_tg_home"
# shellcheck disable=SC2317,SC2329
tmux() {
    if [[ "$1" == new-session ]]; then
        shift 6 # new-session -d -s <session> -c <dir>
        printf '%s\n' "$@" >"$_tg_argv_out"
    fi
    return 0
}
AE_CORE_BIN="$_tg_core" AE_LOCAL_CONFIG='' _TELEGRAM_TMUX_SESSION=ae-telegram \
    CONFIG_FILE="$_tg_home/config file" CONFIG_DIR="$_tg_home" HOME="$_tg_home" \
    _telegram_spawn_daemon >/dev/null 2>&1 || true
assert_eq "caller: the daemon's argv survives spaces and quotes (direct argv, no shell)" \
    "$(printf '%s\n' "$_tg_core" _telegram-run "$_tg_home" --config "$_tg_home/config file" --home "$_tg_home")" \
    "$(cat "$_tg_argv_out")"
# The spawn line itself: the Rust subcommand, and no revived bash daemon.
assert_eq "caller: spawn launches the core's _telegram-run, not a bash daemon" "1" \
    "$([[ "$AE_SOURCE" == *'"$_core" _telegram-run "$CONFIG_DIR" --config "$CONFIG_FILE" --home "$HOME"'* \
        && "$AE_SOURCE" != *'_telegram_write_daemon'* ]] && echo 1 || echo 0)"
unset -f tmux _telegram_spawn_daemon
rm -rf "$_tg_core_dir" "$_tg_home" "$_tg_argv_out"
unset _tg_core_dir _tg_core _tg_mute _tg_argv_out _tg_home
# And the autostart warning the above unblocks is really on that branch.
assert_eq "caller: the autostart warning is gated on the spawn's status" "1" \
    "$([[ "$AE_SOURCE" == *'if ! _telegram_spawn_daemon 2>/dev/null; then'*'autostart failed (continuing without bridge)'* ]] && echo 1 || echo 0)"
