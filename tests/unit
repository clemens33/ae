# The pair-shape exemption is GONE — these are the cases that killed it. A
# `GNU || BSD` pattern cannot verify the two halves are EQUIVALENT, and it
# suppressed per-LINE rather than per-hit.
assert_eq "portability guard fires: mismatched field/operand pair" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$fileA" || stat -f %z "$fileB")"')"
assert_eq "portability guard fires: a valid pair does not cover a second bad hit" "stat-c" \
    "$(_port_mutation 'a="$(stat -c %Y "$f" || stat -f %m "$f")"; b="$(stat -c %s "$g")"')"
assert_eq "portability guard fires: stat -c with the BSD form only in a comment" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$f")"  # on BSD use stat -f instead')"
assert_eq "portability guard fires: 'mystat -f' is not a fallback" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$f" || mystat -f %m "$f")"')"
assert_eq "portability guard fires: stat -c with no fallback at all" "stat-c" \
    "$(_port_mutation 'm="$(stat -c %Y "$f")"')"
# ...and the marker is what exempts now, per line, with a stated reason.
assert_eq "portability guard quiet: a port-ok marked line is exempt" "" \
    "$(_port_mutation 'm="$(stat -c %y "$f" || stat -f %Sm "$f")" # port-ok: remote-host — no shim across ssh')"

# ── command-token boundary: suffix-named commands are not the command ──
# An identifier boundary treats `-` and `.` as separators, so each of these
# matched the real command name inside a LONGER one.
assert_eq "portability guard quiet: iso-date -d (suffix-named command)" "" \
    "$(_port_mutation 'iso-date -d "$x"')"
assert_eq "portability guard quiet: not.date -d (dot-separated name)" "" \
    "$(_port_mutation 'not.date -d "$x"')"
assert_eq "portability guard quiet: unused-sed -i (suffix-named command)" "" \
    "$(_port_mutation 'unused-sed -i "s/a/b/"')"
assert_eq "portability guard quiet: pcre-grep -Po (suffix-named command)" "" \
    "$(_port_mutation 'pcre-grep -Po "x"')"
# A PATH-qualified invocation is still the command — the prefix ends in `/`,
# which is exactly what a suffix-named command never does.
assert_eq "portability guard fires: /usr/bin/date -d (path-qualified)" "date-d" \
    "$(_port_mutation 'ts="$(/usr/bin/date -d "$x" +%s)"')"
assert_eq "portability guard fires: /usr/bin/stat -c (path-qualified)" "stat-c" \
    "$(_port_mutation 'm="$(/usr/bin/stat -c %Y "$f")"')"

# ── sed -i with an EMPTY quoted argument ──
# The shell strips the quotes, so sed receives a bare `-i` — the GNU spelling,
# which BSD rejects. `-i.bak` stays quiet (accepted risk, unchanged).
assert_eq "portability guard fires: sed -i'' (empty single-quoted arg)" "sed-i" \
    "$(_port_mutation "sed -i'' -e 's/a/b/' \"\$f\"")"
assert_eq "portability guard fires: sed -i\"\" (empty double-quoted arg)" "sed-i" \
    "$(_port_mutation 'sed -i"" -e "s/a/b/" "$f"')"
assert_eq "portability guard quiet: sed -i.bak (accepted risk, unchanged)" "" \
    "$(_port_mutation 'sed -i.bak "s/a/b/" "$f"')"
# Negative controls: the BSD-safe forms the shims actually use must stay quiet,
# or the guard would flag its own fix and get disabled.
assert_eq "portability guard quiet: stat -f (BSD form)" "" \
    "$(_port_mutation 'm="$(stat -f %m "$f")"')"
assert_eq "portability guard quiet: date -u -j -f (BSD form)" "" \
    "$(_port_mutation 'date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s')"
# The BSD adjust form must stay quiet WITHOUT an allow-list: [a-zA-Z]* cannot
# cross the `-` in `-v-1d`, so the trailing `d` never anchors. This is what lets
# the date exemption be deleted rather than narrowed.
assert_eq "portability guard quiet: date -u -v-1d (BSD adjust form)" "" \
    "$(_port_mutation 'date -u -v-1d +%Y/%m/%d')"
# And the shimmed call site itself must read clean.
assert_eq "portability guard quiet: _ae_yesterday call site" "" \
    "$(_port_mutation 'for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do')"

# The `_lib` membership pin for these shims is gone with `_lib` itself: a session
# helper is a thin core shim now and sources no library, so there is no emitted
# copy of a portability shim to keep in step.

# The shebang-rewrite pin went with the marker region: the core writes every
# helper, and its shims carry `#!/usr/bin/env bash` with a one-line `exec` body —
# no bash-4 syntax for a 3.2 to choke on, which is why the rewrite existed.
# No emitted helper may keep the PATH-resolved shebang: every prologue heredoc
# must be preceded by the printf of $_ae_sb. (ae's own line 1 and the telegram
# daemon are emitted outside the marker region and checked separately.)
_sb_region="$(awk '/^    # SYNC_SESSION_ASSETS_BODY_START$/{f=1} f{print} /^    # SYNC_SESSION_ASSETS_BODY_END$/{f=0}' <<<"$AE_SOURCE")"
# Catch BOTH emission shapes: a bare heredoc line, and a printf of the literal
# (the `state` helper used the printf form and slipped through a line-anchored
# check — the generated artifact is the oracle, so match either).
assert_eq "helpers: no PATH-resolved shebang emitted inside the marker region" "0" \
    "$(grep -vE '^[[:space:]]*#[^!]' <<<"$_sb_region" | grep -v 'local _ae_sb=' |
        grep -c '/usr/bin/env bash' || true)"

# The telegram daemon used to be an emitted bash artifact with its own writer and
# its own interpreter-pinning problem. The Rust core is that daemon now: it is
# not generated, not chmod'd, and not parsed by a shell — so the artifact whose
# shebang these two checks policed no longer exists.
assert_eq "telegram daemon: no emitted bash daemon survives in ae" "0" \
    "$(grep -c 'TELEGRAM_DAEMON_EOF' <<<"$AE_SOURCE" || true)"

# The `watchdog` helper is written by the core (a shim onto `_watchdog-run`), and
# the refresh guard above pins that it lands.

# A.3: the nudge itself, the quiet-state skip, the waiting-user/blocked escape
# hatch and the alert emission are the CORE's daemon — every one of them was a
# read of the loop's own bash body, which no longer exists. They are pinned
# behaviourally in the core's suite (src/watchdog_daemon.rs) and end to end by
# the integration watchdog section, not by grepping a body the glue no longer
# holds. What the glue still owns is asserted below: the knobs, the exec, and
# start/stop/status.
assert_eq "watchdog: the glue holds no second nudge/quiet/alert implementation" "1" \
    "$([[ "$AE_SOURCE" != *'AE_SENDER_OVERRIDE=watchdog'* \
        && "$AE_SOURCE" != *'_agent_quiet_reason'* \
        && "$AE_SOURCE" != *'_quiet_pane_decision'* \
        && "$AE_SOURCE" != *'ae_emit_event "alert"'* ]] && echo 1 || echo 0)"

# `command_is_shell` went with the launch flow's readiness wait: the core
# classifies a pane that has dropped to a bare shell, on both the send and the
# launch paths (src/deliver.rs).

assert_eq "watchdog: supports start/stop/status subcommands" \
    "1" \
    "$([[ "$AE_SOURCE" == *'_watchdog_start'* && "$AE_SOURCE" == *'_watchdog_stop'* && "$AE_SOURCE" == *'_watchdog_status'* ]] && echo 1 || echo 0)"

# ── A.3: `_run` is an exec of the core, and every knob crosses as a flag — RETIRED (B glue cut 2) ────
# 4 assertion(s) went with their subject: the watchdog DAEMON is the core's (`_watchdog-run`), and the session's
# `watchdog` helper is a thin shim onto it. Bash keeps only start/stop/status,
# which run through `_watchdog_manage` rather than that helper.

# ── status-right ownership: AE bakes the bar; the watchdog NEVER rewrites it ──────
# The old save/prepend/restore machinery (and its dedup strip) is GONE: _watchdog_start
# must not capture, save, or set status-right — idempotence now holds by shape, and a
# doubled indicator is structurally impossible. The watchdog only feeds user options.
_wds_fn="$(awk '/^_watchdog_start\(\) \{/{f=1} f{print} f && /^\}/{exit}' <<<"$AE_SOURCE")"
assert_eq "status-right ownership: _watchdog_start never sets/reads status-right (code, not comments)" "0" \
    "$(grep -vE '^\s*#' <<<"$_wds_fn" | grep -c 'status-right')"
assert_eq "status-right ownership: save/prepend/restore machinery deleted" "0" \
    "$(grep -c '_watchdog_restore_status_right\|_strip_watchdog_status_prefix\|status_right_prev' <<<"$AE_SOURCE")"

# ── P4.1a: single-starter mutual exclusion (no double-daemon on concurrent start) ──
# The launch auto-start (_start_session_watchdog -> "${AE_META}/watchdog" start) and an
# explicit `ae watchdog start` reach the SAME _watchdog_start; without a lock two
# concurrent callers each read is-running=false in the check->spawn window and BOTH
# split a daemon (measured: a burst of concurrent starts spawned 3 panes/round). The
# claim is an flock on .watchdog.start.lock ACQUIRED BEFORE the split-window spawn and
# HELD (fd open until exit) across a wait for the daemon's ASYNC pidfile, so a
# serialized next starter observes a fully-established watchdog and defers. flock (not
# mkdir) so the kernel releases it on any death — no stale-lock wedge.
assert_eq "P4.1a: _watchdog_start takes an flock start-lock (kernel-released, no stale wedge)" "1" \
    "$([[ "$_wds_fn" == *flock* && "$_wds_fn" == *'.watchdog.start.lock'* ]] && echo 1 || echo 0)"
_wds_lock_ln="$(grep -n '\.watchdog\.start\.lock' <<<"$_wds_fn" | head -1 | cut -d: -f1 || true)"
_wds_spawn_ln="$(grep -n 'split-window' <<<"$_wds_fn" | head -1 | cut -d: -f1 || true)"
_wds_wait_ln="$(grep -n -- '-f "$PIDFILE"' <<<"$_wds_fn" | head -1 | cut -d: -f1 || true)"
assert_eq "P4.1a: the start-lock is acquired BEFORE the split-window spawn" "1" \
    "$([[ -n "$_wds_lock_ln" && -n "$_wds_spawn_ln" && "$_wds_lock_ln" -lt "$_wds_spawn_ln" ]] && echo 1 || echo 0)"
assert_eq "P4.1a: the lock is HELD until the daemon publishes its pidfile (wait after spawn)" "1" \
    "$([[ -n "$_wds_wait_ln" && -n "$_wds_spawn_ln" && "$_wds_wait_ln" -gt "$_wds_spawn_ln" ]] && echo 1 || echo 0)"
# A FAILED/timed-out lock acquisition must DEFER (no spawn), never proceed unprotected
# (the removed `flock ... 201 || true` fall-through restored the concurrent-spawn race).
assert_eq "P4.1a: a failed/timed-out lock acquisition DEFERS (no bare-proceed fall-through)" "1" \
    "$([[ "$_wds_fn" != *'201 || true'* && "$_wds_fn" == *'could not acquire the start lock'* ]] && echo 1 || echo 0)"
# A pidfile-registration TIMEOUT must tear down the pane WE spawned and fail — never
# report success leaving a live-but-unregistered daemon the next starter duplicates.
assert_eq "P4.1a: pidfile-registration timeout tears down the spawned pane and aborts" "1" \
    "$([[ "$_wds_fn" == *'_registered'* && "$_wds_fn" == *'_kill_owned_pane "$watchdog_pane"'* && "$_wds_fn" == *'did not publish a pidfile'* ]] && echo 1 || echo 0)"
# Registration must wait for a VALIDATED published pid + our tagged pane, NOT mere
# file existence: `echo >file` yields a zero-byte pidfile mid-write; registering on
# existence would release the lock over it, and the next starter would read no pid,
# delete it, and spawn a duplicate (the empty-pidfile race). Non-destructive — it
# never deletes a partial file.
assert_eq "P4.1a: registration waits for a validated live pid + pane (not mere existence)" "1" \
    "$([[ "$_wds_fn" == *'kill -0 "$_rp"'* && "$_wds_fn" == *'_monitor_find_pane _watchdog'* ]] && echo 1 || echo 0)"
# And the daemon publishes the pidfile ATOMICALLY so it never appears empty at the
# source. The daemon is the core since A.3 (`PidFile::publish` writes a temp and
# renames, and Drop releases it on every exit path), so the glue's obligation
# inverted: it must never WRITE that file at all. A second writer would race the
# owner and hand the starter above a pid it never published. Reads — the
# existence check, the pid read, the stale cleanup — stay.
assert_eq "P4.1a: the glue never writes the watchdog pidfile (the core owns publication)" "0" \
    "$(grep -cE '(>[[:space:]]*"?\$\{?PIDFILE|(mv|cp)[^|]*"\$PIDFILE")' <<<"$AE_SOURCE" || true)"

# Root fix: _watchdog_is_running must require a live @ae_agent=_watchdog pane in
# its OWN session (not just a live pid) before reporting running — a recycled pid
# from a stale pidfile must not read as running, and a stale pidfile is cleaned.
# start/stop/status all inherit this. Extract the fn body so the pane check must
# live INSIDE it (the same call also appears in _watchdog_stop).
_wir_fn="$(awk '/^_watchdog_is_running\(\) \{/{f=1} f{print} f && /^\}/{exit}' <<<"$AE_SOURCE")"
assert_eq "watchdog: is_running requires a live _watchdog pane (not just a live pid)" "1" \
    "$([[ "$_wir_fn" == *'_monitor_find_pane _watchdog'* ]] && echo 1 || echo 0)"
assert_eq "watchdog: is_running cleans a stale pidfile" "1" \
    "$([[ "$_wir_fn" == *'kill -0'* && "$_wir_fn" == *'rm -f "$PIDFILE"'* ]] && echo 1 || echo 0)"

# doctor --refresh cycles a RUNNING watchdog so refreshed helper code goes live.
# Structural: the restart lives in the per-session refresh path (sync_existing_
# session_assets). Extract just that function body so the asserts can't be
# satisfied by an unrelated match elsewhere in the source.
_refresh_fn="$(awk '/^sync_existing_session_assets\(\) \{/{f=1} f{print} f && /^\}/{exit}' <<<"$AE_SOURCE")"
assert_eq "doctor-refresh: restarts a running watchdog in the refresh path" "1" \
    "$([[ "$_refresh_fn" == *'_watchdog_manage "$meta_dir" status'* ]] && echo 1 || echo 0)"
# BLOCKER gate: never stop a stale-pid session. Require genuine liveness first —
# exact-match tmux session on its own server AND a live @ae_agent=_watchdog pane —
# before trusting the pid-based 'is running' status.
assert_eq "doctor-refresh: gate proves the tmux session is live (exact match)" "1" \
    "$([[ "$_refresh_fn" == *"list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- \"\$session_name\""* ]] && echo 1 || echo 0)"
assert_eq "doctor-refresh: gate requires a live _watchdog pane" "1" \
    "$([[ "$_refresh_fn" == *"list-panes -s -t \"\$session_name\" -F '#{@ae_agent}' 2>/dev/null | grep -Fxq -- \"_watchdog\""* \
       && "$_refresh_fn" == *'"$wd_pane_live" == "yes"'* ]] && echo 1 || echo 0)"
# NOT through the session's `watchdog` helper any more: that file is the core's
# daemon shim and takes no subcommand, so the management runs in this script.
assert_eq "doctor-refresh: only stops a genuinely-running watchdog" "1" \
    "$([[ "$_refresh_fn" == *'"$wd_status" == *"is running"*'* \
       && "$_refresh_fn" == *'_watchdog_manage "$meta_dir" stop'* \
       && "$_refresh_fn" == *'_watchdog_manage "$meta_dir" start'* ]] && echo 1 || echo 0)"
# IMPORTANT verify: poll for the restart, announce success only on confirmation,
# and re-record watchdog=true (never leave it disabled) on failure.
assert_eq "doctor-refresh: verifies the restart before claiming success" "1" \
    "$([[ "$_refresh_fn" == *'wd_up="yes"'* \
       && "$_refresh_fn" == *'_watchdog_manage "$meta_dir" status 2>/dev/null || true'* ]] && echo 1 || echo 0)"
assert_eq "doctor-refresh: failed restart re-enables meta + warns, success is conditional" "1" \
    "$([[ "$_refresh_fn" == *'set_session_meta_value "${meta_dir}/meta" "watchdog" "true"'* \
       && "$_refresh_fn" == *'Warning: watchdog restart failed for ${session_name}'* \
       && "$_refresh_fn" == *'restarted watchdog for ${session_name}'* ]] && echo 1 || echo 0)"

# The per-session refresh runs in a SUBSHELL, at every call site. This is not
# style: the core shims are fail-closed and `_ae_core_preflight_try` EXITS 2 on an
# unusable core, which `if fn; then` cannot catch. Since A.2c the workspace render
# is one of those shims, so without the subshell the FIRST session with an
# unbindable core ends the whole process — every later session keeps its stale pin
# and no verdict is printed for any of them. `doctor --refresh` is the repair path
# the core-pin WARN sends the operator to, so it has to outlive that fault.
_drs_fn="$(awk '/^doctor_refresh_sessions\(\) \{/{f=1} f{print} f&&/^\}$/{exit}' <<<"$AE_SOURCE")"
assert_eq "doctor-refresh: every per-session refresh is called in a subshell (a shim exit cannot end the loop)" "3|0" \
    "$(printf '%s|%s' \
        "$(grep -c 'if (sync_existing_session_assets ' <<<"$_drs_fn" || true)" \
        "$(grep -c 'if sync_existing_session_assets ' <<<"$_drs_fn" || true)")"
# ...and the loop still reports a verdict per session, so a refusal is visible
# rather than merely survived.
assert_eq "doctor-refresh: a failed session is reported, not skipped silently" "1" \
    "$([[ "$_drs_fn" == *'doctor_report "FAIL" "refresh:${session_name}" "failed to refresh session assets"'* ]] && echo 1 || echo 0)"
unset _drs_fn

# The events.jsonl retention pins, the watchdog auto-start resolution and the
# events-tail emission pin all read the LAUNCH FLOW, which is the core's `_launch`
# since B glue cut 2. The trim, the events pane, the watchdog pane and the shim
# that runs it are written and ordered in src/session_launch.rs, and pinned there.
# `watchdog = true` in DEFAULT_CONFIG is still this script's, so it stays:
assert_eq "watchdog: DEFAULT_CONFIG advertises watchdog = true to new installs" "1" \
    "$([[ "$AE_SOURCE" == *'watchdog = true'* ]] && echo 1 || echo 0)"
# ── A.1: the shim is FAIL-CLOSED — no core, no command ──────────────────────
# Behavioural, not structural. Every subcommand behind the shim is core-owned, so
# each unusable shape must REFUSE (one line naming the subcommand, exit 2) rather
# than return a not-attempted code some caller could read as "do it in bash".
# `exit` is the contract, so the probe runs it in a subshell — which is exactly
# the shape every capture caller in ae uses.
_cq_probe() { # <sub> -> "rc=<n> err=<stderr>"
    (
        eval "$(awk '/^_ae_core_try\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
        # shellcheck disable=SC2034  # read by the eval'd _ae_core_try, invisible to the analyser
        META_DIR="$_cq_dir"
        rc=0
        err="$(_ae_core_try "$@" 2>&1 >/dev/null)" || rc=$?
        printf 'rc=%s err=%s' "$rc" "$err"
    )
}
_cq_dir="$(mktemp -d)"
: >"$_cq_dir/meta"
assert_eq "core shim: no binding at all refuses, naming the subcommand" \
    "rc=2 err=ae: the ae core is required for '_events-tail' — this session has no core bound" \
    "$(_cq_probe _events-tail)"
printf 'ae_core=/nonexistent/core\n' >"$_cq_dir/meta"
assert_eq "core shim: a path with no version refuses (the unbound shape doctor --refresh publishes)" \
    "rc=2 err=ae: the ae core is required for '_requests' — the configured core could not be bound when this session was created or refreshed: /nonexistent/core" \
    "$(_cq_probe _requests)"
assert_eq "core shim: it refuses EVERY time — there is no once-per-session marker to spend" \
    "rc=2 err=ae: the ae core is required for '_requests' — the configured core could not be bound when this session was created or refreshed: /nonexistent/core" \
    "$(_cq_probe _requests)"
printf 'ae_core=/nonexistent/core\nae_core_version=9.9.9\n' >"$_cq_dir/meta"
assert_eq "core shim: a pinned but missing binary refuses" \
    "rc=2 err=ae: the ae core is required for '_state' — the configured core is missing or not executable: /nonexistent/core" \
    "$(_cq_probe _state)"
printf 'ae_core=%s\nae_core_version=0.0.0-not-the-pin\n' "$_AE_UNIT_CORE" >"$_cq_dir/meta"
assert_eq "core shim: a real binary whose version is not the pin refuses" "rc=2 ver-mismatch" \
    "$(_cq_out="$(_cq_probe _goal)"; printf '%s %s' "${_cq_out%% *}" \
        "$([[ "$_cq_out" == *"core version mismatch: this session pins 0.0.0-not-the-pin"* ]] && echo ver-mismatch || echo no)")"
# The AE_CORE= set-but-empty escape is GONE: with a usable pinned core the shim
# reaches the binary even under it, so nothing it says can be our refusal line.
printf 'ae_core=%s\nae_core_version=%s\n' "$_AE_UNIT_CORE" "$_AE_UNIT_CORE_VER" >"$_cq_dir/meta"
assert_eq "core shim: a set-but-empty AE_CORE is no longer an escape — the pinned core is still used" "0" \
    "$(AE_CORE='' _cq_probe --capture _no-such-subcommand |
        grep -c 'the ae core is required for' | tr -d '[:space:]')"
rm -rf "$_cq_dir"
unset _cq_dir

# Monitor window with _events pane is always created on session start/resume,
# independent of watchdog on/off. Watchdog start splits the window to add the _watchdog pane.
assert_eq "monitor: ae-monitor + events pane created independently of watchdog" "1" \
    "$([[ "$AE_SOURCE" == *'_monitor_ensure_events_pane'* && "$AE_SOURCE" == *'_ensure-monitor'* ]] && echo 1 || echo 0)"

# The launch flow's unconditional `_ensure-monitor` went to the core, which
# creates the events pane itself before it starts the watchdog pane. The
# management path here still has the verb, because `watchdog start` needs the
# window to split against.
assert_eq "monitor: the management path still ensures the events pane" "1" \
    "$([[ "$AE_SOURCE" == *'_ensure-monitor) _watchdog_ensure_monitor ;;'* ]] && echo 1 || echo 0)"

assert_eq "monitor: _events pane runs events-tail" "1" \
    "$([[ "$AE_SOURCE" == *'new-window -da -t "$_AE_SESSION" -n "ae-monitor"'* && "$AE_SOURCE" == *'/events-tail'* ]] && echo 1 || echo 0)"

# The pane runs the helper with NO argument: it is the core's daemon shim now, and
# `_run` was the bash helper's own dispatcher arm — the core rejects it.
assert_eq "monitor: watchdog start splits to add _watchdog pane, does not create the window" "1" \
    "$([[ "$AE_SOURCE" == *'split-window -v -b -t "$MONITOR_EVENTS_PANE"'* && "$AE_SOURCE" == *'"${META_DIR}/watchdog" 2>/dev/null'* ]] && echo 1 || echo 0)"

assert_eq "monitor: watchdog stop kills only the _watchdog pane (window survives)" "1" \
    "$([[ "$AE_SOURCE" == *'_monitor_find_pane _watchdog'* && "$AE_SOURCE" == *'_kill_owned_pane "$watchdog_pane"'* ]] && echo 1 || echo 0)"
# Every pane kill goes through _kill_owned_pane, which reads the pane's session and
# @ae_agent at the moment of the kill and refuses a stranger: pane ids are server-local
# and reused after a server restart on the same socket name, so a process holding a
# stale id (a spawn rolling back, a retire, a watchdog stopping) killed a later
# session's freshly spawned pane in the integration suite. The ONE raw `tmux kill-pane`
# is the guard's own.
assert_eq "kill-pane: the only raw tmux kill-pane in ae is inside _kill_owned_pane" "1" \
    "$(grep -c 'tmux kill-pane' <<<"$AE_SOURCE")"
assert_eq "kill-pane: every surviving kill site goes through the guard (3: two watchdog, one legacy reaper)" "3" \
    "$(grep -c '^ *\(if \[\[ -n "\$watchdog_pane" \]\]; then \)\?_kill_owned_pane "\$\(resolved\|pane_id\|legacy_pane\|watchdog_pane\)"' <<<"$AE_SOURCE")"
# ── _kill_owned_pane FAILS CLOSED: a kill needs a POSITIVE owner match ──
# The stranger-kill this guard prevents is a destructive act, so the absence of a
# contradiction must not authorise it (colead gate f0a99784): a probe that fails, a
# probe that answers no session (tmux renders an empty format for an unknown pane,
# rc 0 — measured), a caller that cannot name the session it means, and a mismatch
# on either fact all end with ZERO kill calls. The two positive arms prove the guard
# still kills what it should. Every call is BARE under this suite's errexit — the
# only shape that proves the probe's non-zero rc cannot abort the caller.
eval "$(awk '/^_kill_owned_pane\(\) \{/,/^\}$/' <<<"$AE_SOURCE")"
_kop_log="$(mktemp)"
_KOP_RC=0
_KOP_ANSWER=""
# shellcheck disable=SC2317,SC2329
tmux() {
    case "${1:-}" in
        display-message)
            printf '%s' "$_KOP_ANSWER"
            return "$_KOP_RC"
            ;;
        kill-pane) printf 'kill-pane %s\n' "${3:-}" >>"$_kop_log" ;;
    esac
    return 0
}
