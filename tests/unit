# THE SWEEP, HELD AS AN ABSENCE — not as a list. The first version enumerated eight
# functions and omitted send_agent_cmd, whose raw codex classifier this very commit
# changed: reverting that one site left it GREEN. A list is fail-open by omission, and a
# listed name that goes missing yields an empty body and contributes zero SILENTLY.
#
# WHAT THIS GUARD ACTUALLY COVERS, stated plainly because a guard that overclaims is
# worse than a modest one — the next reader trusts the label:
#   caught   — case arms `claude*)` on their own line or inline after `case … in`,
#              and `[[ "$var" = claude* ]]` / `== claude*` / `== "claude"*` tests.
#   NOT caught — classification through a variable, an eval, or a helper that returns a
#              glob; a textual guard cannot see any of those, and no regex will fix that.
# It is deliberately anchored to `[[` tests and case arms rather than matching the words
# anywhere: this repo's own comments and printf strings quote the old forms constantly,
# and a guard that fires on prose is a guard someone disables.
_m32_classifier_hits() { # <source> -> count of raw tool globs in code positions
    local src="$1" code
    # Drop full-line comments AND trailing comments: a line that MENTIONS `claude*)` in
    # its explanation is documentation, not a classifier.
    code="$(command sed -E 's/[[:space:]]+#[^"'"'"']*$//' <<<"$src" | command grep -vE '^[[:space:]]*#' || true)"
    local n
    # Tool alternatives are matched at line start, after an optional opening paren, or
    # after a case-alternation pipe — so `(claude*)` and `custom* | claude*)` count too.
    n="$(command grep -cE '(^[[:space:]]*\(?|\|[[:space:]]*)(claude|codex|gemini|grok|opencode)\*[[:space:]]*[)|]|case[^#]*[[:space:]]in[[:space:]]+\(?(claude|codex|gemini|grok|opencode)\*[)|]|\[\[[^]]*\$[A-Za-z_][A-Za-z_0-9]*"?[[:space:]]*==?[[:space:]]*"?(claude|codex|gemini|grok|opencode)"?\*' <<<"$code" | tr -d '[:space:]')"
    printf '%s' "${n:-0}"
    return 0
}
assert_eq "#32 GUARD (textual): no case arm or [[ ]] test in ae classifies by globbing a raw command" "0" \
    "$(_m32_classifier_hits "$AE_SOURCE")"
# It catches the spellings that are actually reachable — including the one-line case and
# both [[ ]] forms, which the first version missed.
assert_eq "#32 GUARD: the reachable raw spellings are all caught" "1|1|1|1|1|1" \
    "$(printf '%s|%s|%s|%s|%s|%s' \
        "$(_m32_classifier_hits '        claude*) echo hi ;;')" \
        "$(_m32_classifier_hits '    case "$cmd" in claude*) echo hi ;; esac')" \
        "$(_m32_classifier_hits '    if [[ "$cmd" = claude* ]]; then :; fi')" \
        "$(_m32_classifier_hits '    if [[ "$cmd" == "claude"* ]]; then :; fi')" \
        "$(_m32_classifier_hits '        custom* | claude*) echo hi ;;')" \
        "$(_m32_classifier_hits '        (claude*) echo hi ;;')")"
# A real classifier that happens to carry a trailing comment must still count — the
# comment stripping must not swallow the code in front of it.
assert_eq "#32 GUARD: a real classifier with a trailing comment still counts" "1" \
    "$(_m32_classifier_hits '        claude*) echo hi ;; # the claude arm')"
# FALSE-POSITIVE CONTROLS. Both of these fired before, and both are prose: a guard that
# fires on documentation gets disabled, which is the #8 lesson exactly.
assert_eq "#32 GUARD: prose and strings that merely quote the old form do not fire" "0|0|0" \
    "$(printf '%s|%s|%s' \
        "$(_m32_classifier_hits '    printf "%s" "example == claude* is the old shape"')" \
        "$(_m32_classifier_hits '    tool_kind_from_cmd "$cmd" # replaces the old claude*) arm')" \
        "$(_m32_classifier_hits '# the arms used to read claude*) and codex*)')")"
