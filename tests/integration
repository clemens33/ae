#!/usr/bin/env bash
# Integration tests for ae (requires tmux, git)
# Run: ./test-integration
# Uses an isolated tmux server and temp HOME — safe to run alongside real sessions.
set -euo pipefail

PASS=0
FAIL=0
ERRORS=()
AE="$(cd "$(dirname "$0")/.." && pwd)/ae"

# Isolated environment
TMPDIR="$(mktemp -d)"
export AE_TMUX_SERVER="ae-test-$$"
export HOME="$TMPDIR/home"
mkdir -p "$HOME/.ae"

cleanup() {
    command tmux -L "$AE_TMUX_SERVER" kill-server 2>/dev/null || true
    rm -rf "$TMPDIR"
}
trap cleanup EXIT

tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }

# Dummy agent config (bash as agent — no real AI tool needed)
cat > "$HOME/.ae/config" <<'EOF'
[agents]
dummy = "bash"
dummy2 = "bash"

[workspace]
main = dummy
layout = vertical
EOF

assert_eq() {
    local label="$1" expected="$2" actual="$3"
    if [[ "$expected" == "$actual" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected: \"$expected\"\n  actual:   \"$actual\"")
    fi
}

assert_contains() {
    local label="$1" needle="$2" haystack="$3"
    if [[ "$haystack" == *"$needle"* ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected to contain: \"$needle\"\n  actual: \"$haystack\"")
    fi
}

assert_not_exists() {
    local label="$1" path="$2"
    if [[ ! -e "$path" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected not to exist: $path")
    fi
}

setup_repo() {
    local dir="$TMPDIR/repo-$$-$RANDOM"
    mkdir -p "$dir"
    git -C "$dir" init -q
    git -C "$dir" config user.email "test@test"
    git -C "$dir" config user.name "test"
    git -C "$dir" commit -q --allow-empty -m "init"
    echo "$dir"
}

wait_for_session() {
    local name="$1" max="${2:-5}"
    local i=0
    while ! tmux has-session -t "$name" 2>/dev/null; do
        sleep 0.5
        i=$((i + 1))
        if (( i >= max * 2 )); then
            echo "Timeout waiting for session $name" >&2
            return 1
        fi
    done
}

# ── Test 1: Lifecycle — create, list, end ────────────────────────

REPO="$(setup_repo)"
(cd "$REPO" && "$AE" --local test-life &) 2>/dev/null
wait_for_session "test-life"
sleep 1  # let session setup complete (meta, manifest)

# Session should be running
assert_eq "lifecycle: tmux session exists" "0" "$(tmux has-session -t test-life 2>/dev/null; echo $?)"

# ae list should show it
list_output="$("$AE" list 2>/dev/null)"
assert_contains "lifecycle: list shows running" "test-life" "$list_output"
assert_contains "lifecycle: list shows running status" "running" "$list_output"

# Meta should exist
assert_eq "lifecycle: meta exists" "1" "$([[ -f "$HOME/.ae/sessions/test-life/meta" ]] && echo 1 || echo 0)"

# End should clean up
"$AE" end -f test-life 2>/dev/null || true
sleep 0.5
assert_eq "lifecycle: tmux session gone after end" "1" "$(tmux has-session -t test-life 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "lifecycle: session dir cleaned" "$HOME/.ae/sessions/test-life"

# ── Test 2: Resume detection ─────────────────────────────────────────

REPO2="$(setup_repo)"
(cd "$REPO2" && "$AE" --local test-resume &) 2>/dev/null
wait_for_session "test-resume"

# Verify meta has session info
assert_eq "resume: meta created" "1" "$([[ -f "$HOME/.ae/sessions/test-resume/meta" ]] && echo 1 || echo 0)"

# Kill tmux session (simulate reboot)
tmux kill-session -t test-resume 2>/dev/null || true
sleep 0.5

# Meta should still exist (stopped session)
assert_eq "resume: meta survives tmux kill" "1" "$([[ -f "$HOME/.ae/sessions/test-resume/meta" ]] && echo 1 || echo 0)"

# ae list --all should show it as stopped (default view is running-only now)
list_output="$("$AE" list --all 2>/dev/null)"
assert_contains "resume: list --all shows stopped" "stopped" "$list_output"

# Re-launch should resume (reuse meta)
(cd "$REPO2" && "$AE" --local test-resume &) 2>/dev/null
wait_for_session "test-resume"
assert_eq "resume: session re-created" "0" "$(tmux has-session -t test-resume 2>/dev/null; echo $?)"

# Clean up
"$AE" end -f test-resume 2>/dev/null || true
sleep 0.5

# ── Test 3: Health check in list ─────────────────────────────────────

REPO3="$(setup_repo)"
(cd "$REPO3" && "$AE" --local test-health &) 2>/dev/null
wait_for_session "test-health"
sleep 1  # let agent (bash) start

# Agent is bash — health check sees shell = dead agent (correct behavior)
# Verify idle agent shows ! marker in agent detail row
list_output="$("$AE" list 2>/dev/null)"
assert_contains "health: idle agent shows ! marker" "!" "$list_output"
assert_contains "health: agent row shows name" "dummy" "$list_output"

# Clean up
"$AE" end -f test-health 2>/dev/null || true
sleep 0.5

# ── Test 3b: state column + session attn marker in list ──────────────

REPO3B="$(setup_repo)"
(cd "$REPO3B" && "$AE" --local test-state &) 2>/dev/null
wait_for_session "test-state"
sleep 1

STATE_EVENTS="$HOME/.ae/sessions/test-state/events.jsonl"
# Discover the real main agent name (alias:name) from meta.
main_agent="$(sed -n 's/^agent.main=//p' "$HOME/.ae/sessions/test-state/meta" | cut -d: -f1,2)"

# Real agent declares working; a retired/stray actor declares waiting-user.
printf '{"ts":"2026-05-29T10:00:00Z","actor":"%s","action":"state","ref":"working","summary":"on it"}\n' "$main_agent" >>"$STATE_EVENTS"
printf '%s\n' '{"ts":"2026-05-29T10:01:00Z","actor":"dummy:ghost","action":"state","ref":"waiting-user","summary":"stale"}' >>"$STATE_EVENTS"

list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: list shows agent working state" "working" "$list_output"
# Regression (codex IMPORTANT): a stray/retired actor that is not a current
# agent must NOT raise the session attn marker.
assert_eq "state: stray actor does not raise attn marker" "0" \
    "$(echo "$list_output" | grep -c 'attn:')"

# When the real current agent goes waiting-user, attn must appear.
printf '{"ts":"2026-05-29T10:02:00Z","actor":"%s","action":"state","ref":"waiting-user","summary":"need you"}\n' "$main_agent" >>"$STATE_EVENTS"
list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: current agent waiting-user raises attn marker" "attn:waiting-user" "$list_output"

# --needs-me surfaces the waiting-user session.
assert_contains "list: --needs-me shows the waiting-user session" "test-state" \
    "$("$AE" list --needs-me 2>/dev/null)"

# --needs-me implies running-only (codex IMPORTANT): combining with --all must
# not leak stopped rows. (test-resume from Test 2 is a stopped session here.)
allneeds_output="$("$AE" list --all --needs-me 2>/dev/null)"
assert_contains "list: --all --needs-me still shows the needing session" "test-state" "$allneeds_output"
assert_eq "list: --all --needs-me does not leak stopped rows" "0" \
    "$(echo "$allneeds_output" | grep -c 'stopped')"

# Once it goes back to working, --needs-me no longer lists it.
printf '{"ts":"2026-05-29T10:03:00Z","actor":"%s","action":"state","ref":"working","summary":"resumed"}\n' "$main_agent" >>"$STATE_EVENTS"
needs_output="$("$AE" list --needs-me 2>/dev/null)"
assert_eq "list: --needs-me drops the session once it is working again" "0" \
    "$(echo "$needs_output" | grep -c 'test-state')"

# Default view shows the running session.
assert_contains "list: default shows the running session" "test-state" \
    "$("$AE" list 2>/dev/null)"

# Stop it (kill tmux session, keep meta) → default omits it, --all/--stopped include it.
tmux kill-session -t test-state 2>/dev/null || true
sleep 0.5
assert_eq "list: default hides the stopped session" "0" \
    "$("$AE" list 2>/dev/null | grep -c 'test-state')"
assert_contains "list: --all includes the stopped session" "test-state" \
    "$("$AE" list --all 2>/dev/null)"
assert_contains "list: --stopped includes the stopped session" "test-state" \
    "$("$AE" list --stopped 2>/dev/null)"
# --stopped --needs-me is running-only by implication → the now-stopped session
# is not shown (stopped sessions can't need you).
assert_eq "list: --stopped --needs-me does not show the stopped session" "0" \
    "$("$AE" list --stopped --needs-me 2>/dev/null | grep -c 'test-state')"

# Clean up
"$AE" end -f test-state 2>/dev/null || true
sleep 0.5

# NOTE: the loop watchdog's quiet-state behaviour (done/waiting-user/blocked
# suppression + the waiting-user/blocked pane-activity escape hatch) is covered
# by unit tests of the extracted decision functions (_agent_quiet_reason,
# _quiet_pane_decision) in tests/unit. A live-loop integration test is not
# practical here: the watchdog runs in a tmux split-window pane that inherits
# tmux's environment, so AE_LOOP_* overrides set on the ae invocation do not
# reach it, leaving no way to drive a fast, deterministic cycle.

# ── Test 4: Spawn persistence ────────────────────────────────────────

REPO4="$(setup_repo)"
(cd "$REPO4" && "$AE" --local test-spawn &) 2>/dev/null
wait_for_session "test-spawn"
sleep 1

# Spawn a second agent
"$HOME/.ae/sessions/test-spawn/spawn" dummy2 "test prompt" 2>/dev/null || true
sleep 1

# Meta should have agent.spawned.0 in new unified format (alias:name:session_id)
spawned="$(grep '^agent\.spawned\.0=' "$HOME/.ae/sessions/test-spawn/meta" 2>/dev/null || echo "")"
assert_contains "spawn: recorded in meta" "agent.spawned.0=dummy2:helper-0:" "$spawned"

# Should now have 2 panes
pane_count="$(tmux list-panes -t test-spawn 2>/dev/null | wc -l)"
assert_eq "spawn: 2 panes after spawn" "2" "$pane_count"

# Alias-only helper resolution should target the unique spawned agent
"$HOME/.ae/sessions/test-spawn/send" dummy2 "printf 'alias-hit\n'" 2>/dev/null || true
sleep 0.5
spawn_output="$("$HOME/.ae/sessions/test-spawn/peek" dummy2 20 2>/dev/null || true)"
assert_contains "spawn: alias-only target resolves unique alias" "alias-hit" "$spawn_output"

# Shared memo helper should persist append-only shared context
"$HOME/.ae/sessions/test-spawn/memo" add --topic arch "use sqlite for the demo" 2>/dev/null || true
memo_output="$("$HOME/.ae/sessions/test-spawn/memo" read --topic arch 2>/dev/null || true)"
assert_contains "spawn: memo read shows topic entry" "use sqlite for the demo" "$memo_output"
assert_contains "spawn: memo read renders topic" "[arch]" "$memo_output"
memo_tail_output="$("$HOME/.ae/sessions/test-spawn/memo" tail 1 2>/dev/null || true)"
assert_contains "spawn: memo tail shows latest entry" "use sqlite for the demo" "$memo_tail_output"
assert_eq "spawn: memo file exists" "1" "$([[ -f "$HOME/.ae/sessions/test-spawn/memo.tsv" ]] && echo 1 || echo 0)"

# Request/reply tracking should use the invoking pane identity, not the active pane
main_pane="$(tmux list-panes -t test-spawn -F '#{pane_id} #{@ae_agent}' | awk '$2=="dummy:dummy"{print $1; exit}')"
worker_pane="$(tmux list-panes -t test-spawn -F '#{pane_id} #{@ae_agent}' | awk '$2=="dummy2:helper-0"{print $1; exit}')"
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/ask" dummy2 "check memo flow" 2>/dev/null || true
req_id="$(tac "$HOME/.ae/sessions/test-spawn/events.jsonl" 2>/dev/null | grep -m1 -E '"action":"(ask|review)"' | grep -oE '"ref":"[^"]+"' | cut -d'"' -f4)"
wrong_reply_status=0
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/reply" "$req_id" "wrong pane reply" >/dev/null 2>&1 || wrong_reply_status=$?
assert_eq "spawn: reply rejects wrong agent identity" "1" "$wrong_reply_status"
TMUX_PANE="$worker_pane" "$HOME/.ae/sessions/test-spawn/reply" "$req_id" "handled" >/dev/null 2>&1 || true
requests_output="$("$HOME/.ae/sessions/test-spawn/requests" all 2>/dev/null || true)"
assert_contains "spawn: requests show replied after correct reply" "replied" "$requests_output"

TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/ask" dummy2 "check override reply flow" 2>/dev/null || true
override_req_id="$(tac "$HOME/.ae/sessions/test-spawn/events.jsonl" 2>/dev/null | grep -m1 -E '"action":"(ask|review)"' | grep -oE '"ref":"[^"]+"' | cut -d'"' -f4)"
override_status=0
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/reply" --as "dummy2:helper-0" "$override_req_id" "override handled" >/dev/null 2>&1 || override_status=$?
assert_eq "spawn: reply --as allows tracked reply when pane identity is unavailable" "0" "$override_status"
requests_output="$("$HOME/.ae/sessions/test-spawn/requests" all 2>/dev/null || true)"
assert_contains "spawn: override reply recorded as replied" "$override_req_id" "$requests_output"
assert_contains "spawn: override reply summary updated" "override handled" "$requests_output"

# Kill tmux session (simulate reboot), re-launch
tmux kill-session -t test-spawn 2>/dev/null || true
sleep 0.5
(cd "$REPO4" && "$AE" --local test-spawn &) 2>/dev/null
wait_for_session "test-spawn"
sleep 1

# Should have 2 panes again (spawned agent restored)
pane_count="$(tmux list-panes -t test-spawn 2>/dev/null | wc -l)"
assert_eq "spawn: 2 panes after resume" "2" "$pane_count"

# Clean up
"$AE" end -f test-spawn 2>/dev/null || true
sleep 0.5

# ── Test 5: End session (worktree mode) ──────────────────────────────

REPO5="$(setup_repo)"
# Add a bare remote so 'ae end' can push
REMOTE5="$TMPDIR/remote5.git"
git -C "$REPO5" clone -q --bare "$REPO5" "$REMOTE5" 2>/dev/null
git -C "$REPO5" remote add origin "$REMOTE5" 2>/dev/null || git -C "$REPO5" remote set-url origin "$REMOTE5"

(cd "$REPO5" && "$AE" --worktree test-end &) 2>/dev/null
wait_for_session "test-end"
sleep 1

# Find the worktree dir
work_dir="$(grep '^work_dir=' "$HOME/.ae/sessions/test-end/meta" | cut -d= -f2-)"
if [[ -n "$work_dir" ]] && [[ -d "$work_dir" ]]; then
    # Set git identity in worktree
    git -C "$work_dir" config user.email "test@test"
    git -C "$work_dir" config user.name "test"
    # Also set origin in the worktree
    git -C "$work_dir" remote set-url origin "$REMOTE5" 2>/dev/null || git -C "$work_dir" remote add origin "$REMOTE5"

    # Create a file to commit
    echo "test" > "$work_dir/testfile.txt"
    git -C "$work_dir" add testfile.txt
    git -C "$work_dir" commit -q -m "test commit"

    # End session
    "$AE" end -f test-end 2>/dev/null || true
    sleep 1

    # Branch should exist in the remote
    branch_exists="$(git -C "$REMOTE5" branch -a 2>/dev/null | grep -c 'ae/test-end' || true)"
    assert_eq "end: branch pushed" "1" "${branch_exists// /}"

    # Session dir should be cleaned
    assert_not_exists "end: session dir cleaned" "$HOME/.ae/sessions/test-end"
else
    # Worktree creation may fail in some environments (nested git)
    PASS=$((PASS + 2))  # skip these tests gracefully
fi

