    awk '/^_telegram_expand_path\(\) \{/,/^\}$/' "$AE"
    awk '/^_ae_core_current_input\(\) \{/,/^\}$/' "$AE"
    awk '/^_ae_core_bin_input\(\) \{/,/^\}$/' "$AE"
    awk '/^_ae_core_bin_version\(\) \{/,/^\}$/' "$AE"
    awk '/^_tmux_err_is_clean_dead\(\) \{/,/^\}$/' "$AE"
    awk '/^daemon_session_running\(\) \{/,/^\}$/' "$AE"
    awk '/^_telegram_coexistence_token\(\) \{/,/^\}$/' "$AE"
    awk '/^_telegram_coexistence_probe\(\) \{/,/^\}$/' "$AE"
    awk '/^_telegram_coexistence_same_bot\(\) \{/,/^\}$/' "$AE"
    awk '/^_telegram_coexistence_guard\(\) \{/,/^\}$/' "$AE"
    awk '/^_telegram_spawn_daemon\(\) \{/,/^\}$/' "$AE"
} >"$TGG_FNS"

# The old instance's config lives at $HOME/.ae/config — the guard knows that path
# literally, which is a stated limit of the design (an old instance under a
# relocated AE_HOME is not detected).
printf '%s\n' 'BOT-TOKEN-OLD' >"$TGG_ROOT/token-old"
printf '%s\n' 'BOT-TOKEN-OLD' >"$TGG_ROOT/token-same"
printf '%s\n' 'BOT-TOKEN-NEW' >"$TGG_ROOT/token-different"
printf '[telegram]\ntoken_file = "%s"\n' "$TGG_ROOT/token-old" >"$TGG_HOME/.ae/config"
# shellcheck disable=SC2016
printf '%s\n' '#!/bin/sh' 'case "$1" in --version) echo "ae 9.9.9";; esac' >"$TGG_ROOT/core"
chmod 0755 "$TGG_ROOT/core"

# _tgg <present|absent|unknown> <mine-token-file|none> [pre-set env...] -> refused|spawned
_tgg() {
    local state="$1" mine="$2"
    shift 2
    rm -f "$TGG_FIX/present" "$TGG_FIX/unknown" "$TGG_FIX/flip" "$TGG_FIX/spawned" \
        "$TGG_FIX/kills" "$TGG_FIX/err" "$TGG_FIX/env.last"
    case "$state" in
        present)
            : >"$TGG_FIX/present"
            printf '%s\n' 'some-other-session' 'ae-telegram' 'yet-another' >"$TGG_FIX/sessions"
            ;;
        live-but-no-bridge)
            : >"$TGG_FIX/present"
            printf '%s\n' 'some-other-session' >"$TGG_FIX/sessions"
            ;;
        aewatch)
            : >"$TGG_FIX/present"
            printf '%s\n' 'some-other-session' 'ae-aewatch' >"$TGG_FIX/sessions"
            ;;
        flip)
            # Absent on the first probe, live on the second — the spawn goes
            # through and the re-check is what has to catch it.
            : >"$TGG_FIX/flip"
            printf '%s\n' 'ae-telegram' >"$TGG_FIX/sessions"
            ;;
        unknown) : >"$TGG_FIX/unknown" ;;
    esac
    if [[ "$mine" == none ]]; then
        printf '[telegram]\nenabled = true\n' >"$TGG_ROOT/next-config"
    else
        printf '[telegram]\nenabled = true\ntoken_file = "%s"\n' "$mine" >"$TGG_ROOT/next-config"
    fi
    cat >"$TGG_ROOT/drive" <<TGGDRIVE
#!/usr/bin/env bash
set -uo pipefail
CONFIG_DIR="$TGG_ROOT"
CONFIG_FILE="$TGG_ROOT/next-config"
AE_LOCAL_CONFIG=""
_TELEGRAM_TMUX_SESSION="ae-telegram"
# ae's OWN tmux calls (the aewatch probe, the spawn itself) go through the shell
# function, exactly as they do in the product. Only the guard's probe escapes to
# PATH — which is the distinction under test.
tmux() {
    case "\$1" in
        list-sessions) return 0 ;;
        new-session) echo spawned >"$TGG_FIX/spawned"; return 0 ;;
        kill-session) shift; printf '%s\n' "\$*" >>"$TGG_FIX/kills"; return 0 ;;
        *) return 0 ;;
    esac
}
source "$TGG_FNS"
_telegram_spawn_daemon
TGGDRIVE
    # THE VERDICT IS THE SPAWN'S OWN ANSWER, not a marker file. A re-check that
    # retreats has already run new-session, so reading the marker would report
    # "spawned" for exactly the case the retreat exists to prevent.
    local rc=0
    PATH="$TGG_BIN:$PATH" HOME="$TGG_HOME" AE_CORE_BIN="$TGG_ROOT/core" \
        env "$@" "${BASH:-bash}" "$TGG_ROOT/drive" >/dev/null 2>"$TGG_FIX/err" || rc=$?
    if [[ "$rc" -eq 0 ]]; then printf 'spawned'; else printf 'refused'; fi
}

# ── The five cases ──────────────────────────────────────────────────────────
# THE SAME BOT is the one that must not be polled twice.
assert_eq "tg guard: a live default-server bridge on the SAME token refuses the spawn" "refused" \
    "$(_tgg present "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next)"
# Two different bots are two different conversations, and both may run.
assert_eq "tg guard: a live bridge on a DIFFERENT token still spawns" "spawned" \
    "$(_tgg present "$TGG_ROOT/token-different" AE_TMUX_SERVER=ae-next)"
# Nothing over there: nothing to collide with.
assert_eq "tg guard: no default server at all -> spawn" "spawned" \
    "$(_tgg absent "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next)"
# A live default server WITHOUT a bridge is not a bridge. This separates "the
# server answered" from "the bridge is there" — a guard that refused on any live
# default server would block every canary on this machine.
assert_eq "tg guard: a live default server with no ae-telegram session -> spawn" "spawned" \
    "$(_tgg live-but-no-bridge "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next)"
# CANNOT TELL IS NOT ABSENT (#28). The cost of guessing wrong is a silently
# halved update stream, so the unknown answer fails closed.
assert_eq "tg guard: an unreadable default server (rc 2 / cannot tell) refuses" "refused" \
    "$(_tgg unknown "$TGG_ROOT/token-different" AE_TMUX_SERVER=ae-next)"
# An unreadable token cannot be PROVEN different, so it is treated as the same.
assert_eq "tg guard: a token this instance cannot read refuses" "refused" \
    "$(_tgg present none AE_TMUX_SERVER=ae-next)"
# THE INSTALLED ae IS NEVER GATED BY ITS OWN GUARD: no AE_TMUX_SERVER, no probe.
assert_eq "tg guard: a default-server instance is not gated at all" "spawned" \
    "$(_tgg present "$TGG_ROOT/token-same" AE_TMUX_SERVER=)"

# ── Bypass discriminator (1): the probe must not follow \$TMUX ───────────────
# The guard runs from INSIDE a pane of the named server during a canary, so an
# inherited $TMUX is the normal case, not an exotic one. If the probe followed
# it, it would interrogate ae-next's own server, find no old bridge there, and
# authorise the double poll it exists to prevent.
assert_eq "tg guard: a probe run from inside a named-server pane still refuses" "refused" \
    "$(_tgg present "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next TMUX=/tmp/tmux-501/ae-next,123,0)"
# ZERO occurrences: the probe's own environment carried no TMUX at all.
assert_eq "tg guard: ...and TMUX really was cleared for the probe" "0" \
    "$(command grep -c '^TMUX=' "$TGG_FIX/env.last" | tr -d '[:space:]')"

# ── Bypass discriminator (2): TMUX_TMPDIR is the same bypass, renamed ────────
# -L names the SOCKET; TMUX_TMPDIR names the DIRECTORY it is looked up in. With
# it left in place, `-L default` resolves inside whatever directory the caller
# supplied — a different server wearing the same name.
assert_eq "tg guard: an alternate TMUX_TMPDIR does not redirect the probe" "refused" \
    "$(_tgg present "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next TMUX_TMPDIR="$TGG_ROOT/empty-tmpdir")"
assert_eq "tg guard: ...and the probe's own environment carried NEITHER redirection" "0|0" \
    "$(printf '%s|%s' \
        "$(command grep -c '^TMUX=' "$TGG_FIX/env.last" | tr -d '[:space:]')" \
        "$(command grep -c '^TMUX_TMPDIR=' "$TGG_FIX/env.last" | tr -d '[:space:]')")"

# ── A retired aewatch on the DEFAULT server: refuse, never kill ────────────
# A live aewatch claims the bridge-owner marker and kills competing bridges on
# EVERY tmux server, so starting beside it means being killed seconds later. It
# belongs to the other instance, though, and killing another instance's process
# is not this command's to do — so this refuses and says how to stop it. The
# token here is DIFFERENT on purpose: this refusal does not depend on whose bot
# is configured, which a token-shaped implementation would have got wrong.
assert_eq "tg guard: a live aewatch on the default server refuses the spawn" "refused" \
    "$(_tgg aewatch "$TGG_ROOT/token-different" AE_TMUX_SERVER=ae-next)"
assert_contains "tg guard: ...naming ae-aewatch" "ae-aewatch" "$(cat "$TGG_FIX/err" 2>/dev/null || true)"
assert_not_exists "tg guard: ...and nothing was spawned" "$TGG_FIX/spawned"
assert_not_exists "tg guard: ...and nothing of THEIRS was killed" "$TGG_FIX/kills"

# ── The window: check -> spawn -> RE-CHECK, with self-retreat ──────────────
# The pre-check answers about a moment that has passed by the time the session
# exists, and the other instance is the frozen `ae` — it will never honour a
# claim this side invents, so there is no protocol to agree on. The only move
# left is to look again and take OUR OWN bridge down. The fixture makes the race
# deterministic: absent on the first probe, live on the second.
assert_eq "tg guard: a bridge that appears DURING the spawn makes us retreat" "refused" \
    "$(_tgg flip "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next)"
assert_eq "tg guard: ...the session really was created first (there WAS a window)" "1" \
    "$([[ -f "$TGG_FIX/spawned" ]] && echo 1 || echo 0)"
assert_contains "tg guard: ...and OUR OWN bridge is what got killed" "ae-telegram" \
    "$(cat "$TGG_FIX/kills" 2>/dev/null || true)"
assert_contains "tg guard: ...with the refusal the operator can act on" "distinct bot token" \
    "$(cat "$TGG_FIX/err" 2>/dev/null || true)"

# ── The refusal is a refusal: nothing was started ───────────────────────────
_tgg present "$TGG_ROOT/token-same" AE_TMUX_SERVER=ae-next >/dev/null
assert_not_exists "tg guard: a refused spawn creates no tmux session" "$TGG_FIX/spawned"

unset -f _tgg
unset TGG_ROOT TGG_BIN TGG_FIX TGG_HOME TGG_REAL_TMUX TGG_FNS
fi

# ── Slice B P-B1: oversized ask notices on an isolated real-tool rig ─────────
if _itest_section 'Slice B P-B1: oversized ask notices on an isolated real-tool rig'; then
# This is the product-shaped check for D1/D2: the two real TUIs receive a 9 KiB ask,
# only the <=300-byte pointer is pasted, the visible rows reconstruct byte-for-byte,
# and the transcript shows the agent opening its sender-owned body.  The rig is a
# different tmux server and uses pane ids for delivery, so neither a live-session name
# nor the harness's ambient server can be reached accidentally.
P1_RIG_BASH=/opt/homebrew/bin/bash
P1_RIG_OUT="$TMPDIR/pb1-rig.out"
P1_RIG_ERR="$TMPDIR/pb1-rig.err"

# Every rig command runs under the pinned bash.  The wrapper prepends the isolated
# server and requires callers to provide -t explicitly; no helper below can target the
# default server by accident.
p1_tmux() {
    "$P1_RIG_BASH" -c 'command tmux "$@"' p1-tmux -L "$P1_RIG_SRV" "$@"
}

# The real-tool rig is opt-in. This gate is deliberately the FIRST branch after the
# section selector: no credentials, repo, config, socket, or session may exist when a
# normal full suite does not explicitly request authenticated CLI work.
if [[ "${AE_ITEST_RIG:-}" != 1 ]]; then
    echo "  SKIP (P-B1 real rig): set AE_ITEST_RIG=1 to opt in; no rig side effects" >&2
elif [[ ! -x "$P1_RIG_BASH" || -z "$(command -v claude || true)" || -z "$(command -v codex || true)" ]]; then
    echo "  SKIP (P-B1 real rig): /opt/homebrew/bin/bash, claude and codex are required" >&2
else
    P1_RIG_SRV="ae-pb1-rig-$$"
    P1_RIG_SESS="pb1-rig-$$-${RANDOM}"
    # The rig owns credentials, repo, and server. Install an EXIT trap before any
    # launch or credential copy so an assertion abort deletes credential copies
    # immediately and still hands control back to suite cleanup. Normal completion
    # calls this same function before the variables are unset.
    P1_CLEANED=0
    p1_cleanup() {
        ((P1_CLEANED)) && return 0
        P1_CLEANED=1
        if [[ -n "${P1_RIG_SESS:-}" ]]; then p1_tmux kill-session -t "$P1_RIG_SESS" 2>/dev/null || true; fi
        if [[ -n "${P1_RIG_REPO:-}" && -d "$P1_RIG_REPO" ]]; then rm -rf "$P1_RIG_REPO"; fi
        if [[ -n "${P1_CLAUDE_CONFIG_DIR:-}" && -d "$P1_CLAUDE_CONFIG_DIR" ]]; then rm -rf "$P1_CLAUDE_CONFIG_DIR"; fi
        if [[ -n "${P1_CODEX_HOME:-}" && -d "$P1_CODEX_HOME" ]]; then rm -rf "$P1_CODEX_HOME"; fi
    }
    p1_cleanup_on_exit() {
        p1_cleanup
        cleanup
    }
    trap p1_cleanup_on_exit EXIT

    # Trust is granted by the injected per-tool stores, not by placing the repo under
    # the operator's projects root. Keeping the disposable repo under suite TMPDIR
    # prevents a stranded repo from polluting every checkout on an interrupted run.
    P1_RIG_TMP_ROOT="$(cd "$TMPDIR" && pwd -P)"
    P1_RIG_REPO="$(mktemp -d "$TMPDIR/pb1-rig-repo-XXXXXX")"
    P1_RIG_REPO="$(cd "$P1_RIG_REPO" && pwd -P)"
    git -C "$P1_RIG_REPO" init -q
    git -C "$P1_RIG_REPO" config user.email "test@test"
    git -C "$P1_RIG_REPO" config user.name "test"
    git -C "$P1_RIG_REPO" commit -q --allow-empty -m "init"
    assert_eq "P-B1 rig: disposable repo is under suite TMPDIR, not projects root" "1" \
        "$([[ "$P1_RIG_REPO" == "$P1_RIG_TMP_ROOT/"* && "$P1_RIG_REPO" != "$REAL_HOME/projects/"* ]] && echo 1 || echo 0)"
    P1_CLAUDE_CONFIG_DIR="$TMPDIR/pb1-claude-config"
    mkdir -p "$P1_CLAUDE_CONFIG_DIR"
    cp "$REAL_HOME/.claude.json" "$P1_CLAUDE_CONFIG_DIR/.claude.json"
    chmod 600 "$P1_CLAUDE_CONFIG_DIR/.claude.json"
    awk -v path="$P1_RIG_REPO" '
        !inserted && /"projects": \{/ {
            print
            printf "    \"%s\": {\"hasTrustDialogAccepted\": true},\n", path
            inserted = 1
            next
        }
        { print }
    ' "$P1_CLAUDE_CONFIG_DIR/.claude.json" >"$P1_CLAUDE_CONFIG_DIR/.claude.json.new"
    mv "$P1_CLAUDE_CONFIG_DIR/.claude.json.new" "$P1_CLAUDE_CONFIG_DIR/.claude.json"
    chmod 600 "$P1_CLAUDE_CONFIG_DIR/.claude.json"
    if ! grep -Fq "\"$P1_RIG_REPO\"" "$P1_CLAUDE_CONFIG_DIR/.claude.json"; then
        echo "P-B1 rig: Claude trust injection marker missing; refusing to launch" >&2
        exit 1
    fi
    P1_CODEX_HOME="$TMPDIR/pb1-codex-home"
    mkdir -p "$P1_CODEX_HOME"
    chmod 700 "$P1_CODEX_HOME"
    cp "$REAL_HOME/.codex/config.toml" "$P1_CODEX_HOME/config.toml"
    chmod 600 "$P1_CODEX_HOME/config.toml"
    cp "$REAL_HOME/.codex/auth.json" "$P1_CODEX_HOME/auth.json"
    chmod 600 "$P1_CODEX_HOME/auth.json"
    printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$P1_RIG_REPO" >>"$P1_CODEX_HOME/config.toml"
    if ! grep -Fq "[projects.\"$P1_RIG_REPO\"]" "$P1_CODEX_HOME/config.toml"; then
        echo "P-B1 rig: Codex trust injection marker missing; refusing to launch" >&2
        exit 1
    fi
    mkdir -p "$P1_RIG_REPO/.ae"
    # The suite's HOME is intentionally hermetic, but the real CLIs need the
    # operator's authenticated stores.  Scope that access to each rig process;
    # ae state remains under the suite HOME/AE_HOME.
    P1_CLAUDE_CMD="env HOME=$REAL_HOME CLAUDE_CONFIG_DIR=$P1_CLAUDE_CONFIG_DIR claude --no-chrome --permission-mode acceptEdits"
    P1_CODEX_CMD="env HOME=$REAL_HOME CODEX_HOME=$P1_CODEX_HOME codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust"
    printf '%s\n' '[profiles]' "claude = \"$P1_CLAUDE_CMD\"" "codex = \"$P1_CODEX_CMD\"" '' '[roster]' 'lead = claude' 'worker = codex' '' '[workspace]' 'main = lead' 'workers = worker' 'layout = lead-solo' >"$P1_RIG_REPO/.ae/config"
    (cd "$P1_RIG_REPO" && SHELL="$P1_RIG_BASH" CONFIG_FILE="$P1_RIG_REPO/.ae/config" AE_TMUX_SERVER="$P1_RIG_SRV" "$P1_RIG_BASH" "$AE" --local "$P1_RIG_SESS" >"$P1_RIG_OUT" 2>"$P1_RIG_ERR") 2>/dev/null &
    P1_LAUNCH_PID=$!
    P1_LAUNCH_RC=0
    wait "$P1_LAUNCH_PID" || P1_LAUNCH_RC=$?
    P1_RIG_READY=0
    for _p1_i in $(seq 1 90); do
        if p1_tmux has-session -t "$P1_RIG_SESS" 2>/dev/null; then P1_RIG_READY=1; break; fi
        sleep 0.5
    done
    assert_eq "P-B1 rig: isolated session starts on its own server" "1" "$P1_RIG_READY"
    P1_RIG_META="$HOME/.ae/sessions/$P1_RIG_SESS"
    for _p1_i in $(seq 1 90); do
        [[ -f "$P1_RIG_META/meta" ]] && break
        sleep 0.5
    done
    assert_eq "P-B1 rig: session metadata is published" "1" "$([[ -f "$P1_RIG_META/meta" ]] && echo 1 || echo 0)"

    if [[ -f "$P1_RIG_META/meta" ]]; then
        # Metadata lands before launch pastes.  Wait on the actual launcher process so
        # the helper probes never race the initial shell command still staged in a pane.
        # This harness has no current terminal client, so ae's final attach is
        # expected to fail after the detached session and launch commands exist.
        # Assert that known harness shape rather than mistaking attach's rc for a
        # launch failure.
        assert_eq "P-B1 rig: detached launcher reaches the no-client attach" "1" \
            "$([[ "$P1_LAUNCH_RC" -ne 0 ]] && echo 1 || echo 0)"
        # Resolve ids on the rig server, then assert each is non-empty before invoking
        # any helper.  The ask helpers are the only delivery mechanism; tmux is read-only.
        P1_CLAUDE_PANE="$(p1_tmux list-panes -s -t "$P1_RIG_SESS" -F '#{pane_id} #{@ae_agent}' 2>/dev/null | awk '$2=="lead"{print $1; exit}')"
        P1_CODEX_PANE="$(p1_tmux list-panes -s -t "$P1_RIG_SESS" -F '#{pane_id} #{@ae_agent}' 2>/dev/null | awk '$2=="worker"{print $1; exit}')"
        assert_eq "P-B1 rig: resolved Claude pane id is non-empty before paste" "1" "$([[ -n "$P1_CLAUDE_PANE" ]] && echo 1 || echo 0)"
        assert_eq "P-B1 rig: resolved Codex pane id is non-empty before paste" "1" "$([[ -n "$P1_CODEX_PANE" ]] && echo 1 || echo 0)"
        P1_TOOLS_READY=0
        P1_IDLE_STREAK=0
        for _p1_i in $(seq 1 180); do
            P1_CLAUDE_CAP="$(p1_tmux capture-pane -p -t "$P1_CLAUDE_PANE" 2>/dev/null || true)"
            P1_CODEX_CAP="$(p1_tmux capture-pane -p -t "$P1_CODEX_PANE" 2>/dev/null || true)"
            # Both TUIs draw an input prompt before their initial launch work is
            # finished.  Require three consecutive idle-shaped captures so the
            # oversized asks do not race that work and get classified as staged.
            P1_CLAUDE_TAIL="$(printf '%s\n' "$P1_CLAUDE_CAP" | tail -10)"
            P1_CODEX_TAIL="$(printf '%s\n' "$P1_CODEX_CAP" | tail -10)"
            if [[ "$P1_CLAUDE_CAP" == *❯* && "$P1_CODEX_CAP" == *›* ]] \
                && [[ "$P1_CLAUDE_TAIL" != *"Press up to edit"* ]] \
                && [[ "$P1_CLAUDE_TAIL" != *"Running"* && "$P1_CLAUDE_TAIL" != *"✢"* ]] \
                && [[ "$P1_CODEX_TAIL" == *"Ask Codex to do anything"* ]] \
                && [[ "$P1_CODEX_TAIL" != *"Working"* && "$P1_CODEX_TAIL" != *"Running"* ]]; then
                P1_IDLE_STREAK=$((P1_IDLE_STREAK + 1))
                if ((P1_IDLE_STREAK >= 3)); then
                    P1_TOOLS_READY=1
                    break
                fi
            else
                P1_IDLE_STREAK=0
            fi
            sleep 0.5
        done
