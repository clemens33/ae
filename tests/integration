# DECODE ONCE, THEN ENUMERATE. launch.<slot>.sh ends `exec <sh> -lc <shell-quoted
# command>`, so on disk every space and paren of the context is BACKSLASH-ESCAPED: a raw
# grep for "You are agent" in that file is ALWAYS zero, which made the first round's
# absence pins pass without testing anything. Decode the way the shell will (`set --`
# parses, it does not run), then count — and `head -1` is deliberately NOT used, because
# the failure worth catching is an artifact carrying its own identity FIRST and a second,
# wrong one after it.
_id59_decode() { # <launch script> -> the command string the pane will receive
    local q
    q="$(tail -1 "$1" 2>/dev/null || true)"
    q="${q#exec }"
    [[ -n "$q" ]] || return 0
    eval "set -- ${q}"
    printf '%s' "${3:-}"
    return 0
}
_id59_ids() { # <text> -> every identity sentence in it, one per line
    command grep -o 'You are agent [^(]*(slot [^)]*).' <<<"$1" || true
    return 0
}
_id59_n() { # <text> -> how many identity sentences it carries
    local v
    v="$(_id59_ids "$1")"
    if [[ -z "$v" ]]; then
        echo 0
        return 0
    fi
    printf '%s\n' "$v" | command grep -c '' | tr -d '[:space:]'
    return 0
}
_id59_singleton() { # <text> <expected> -> 1 iff EXACTLY one identity, and it is <expected>
    local n
    n="$(_id59_n "$1")"
    if [[ "$n" == "1" && "$(_id59_ids "$1")" == "$2" ]]; then echo 1; else echo 0; fi
    return 0
}

