sleep 1
lp_win0_panes="$(tmux list-windows -t test-leadpair -F '#{window_index} #{window_panes}' 2>/dev/null | awk '$1==0{print $2}')"
lp_win1_panes="$(tmux list-windows -t test-leadpair -F '#{window_index} #{window_panes}' 2>/dev/null | awk '$1==1{print $2}')"
