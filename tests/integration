# meta records no parseable session id is unsupported old state and is REFUSED with a
# refresh/migrate instruction — the frozen bash minted at freeze, the Rust core does not.
(cd "$C48_REPO" && "$AE" --local comp-mint &) 2>/dev/null
wait_for_session "comp-mint" 20
sleep 1
# The valid id ae assigned at launch — captured so the refusal can be shown NOT to have
# minted one in its place, and so end can resolve the session afterwards.
c48_mint_id="$(grep '^session_id=' "$HOME/.ae/sessions/comp-mint/meta" | cut -d= -f2- || true)"
_sed_i -e "/^session_id=/d" "$HOME/.ae/sessions/comp-mint/meta"
c48_mint_rc=0
c48_mint="$("$AE" compact comp-mint </dev/null 2>&1)" || c48_mint_rc=$?
assert_eq "compact: a session with no id is REFUSED, not minted one" "1" \
    "$([[ $c48_mint_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact: and says the session must be refreshed or migrated first" \
    "records no valid session id — refresh or migrate the session, then retry" "$c48_mint"
assert_eq "compact: nothing was minted — the meta still records no session id" "0" \
    "$(grep -c '^session_id=' "$HOME/.ae/sessions/comp-mint/meta" | tr -d '[:space:]')"
assert_eq "compact: and no minted-at-compact provenance was written" "0" \
    "$(grep -c '^session_id_origin=minted-at-compact' "$HOME/.ae/sessions/comp-mint/meta" | tr -d '[:space:]')"
# An unparseable id is the SAME unsupported state, refused the same way — never overwritten.
printf 'session_id=not-a-uuid\n' >>"$HOME/.ae/sessions/comp-mint/meta"
c48_badid_rc=0
c48_badid="$("$AE" compact comp-mint </dev/null 2>&1)" || c48_badid_rc=$?
assert_eq "compact: an unparseable id refuses" "1" "$([[ $c48_badid_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact: with the same refresh-or-migrate instruction" \
    "records no valid session id — refresh or migrate the session, then retry" "$c48_badid"
assert_eq "compact: the value survives untouched" "not-a-uuid" \
    "$(grep '^session_id=' "$HOME/.ae/sessions/comp-mint/meta" | cut -d= -f2-)"
# Restore the real id so end can resolve and tear the session down cleanly.
_sed_i -e "s|^session_id=.*|session_id=${c48_mint_id}|" "$HOME/.ae/sessions/comp-mint/meta"
"$AE" end -f --keep-history comp-mint >/dev/null 2>&1 || true
unset c48_ok_rc C48_REPO C48_GREPO C48_UUID c48_ok c48_pane c48_self_out c48_purge c48_purge_rc c48_git c48_git_rc c48_mint c48_mint_id c48_mint_rc c48_badid c48_badid_rc
export AE_CORE_BIN="$_ITEST_CORE_BIN"; unset _C48_CORE
fi  # ── P3.7 core-guard end ──
fi

# ── compact phase (b): the handover is a fact, not a claim ──────────────────────
if _itest_section 'compact phase (b): the handover is a fact, not a claim'; then
# ── P3.7 core-guard: compact is Rust-owned; bind the built core for this section ──
_C48_CORE="$(dirname "$AE")/target/debug/ae"
if [[ ! -x "$_C48_CORE" ]]; then
    echo "  SKIP (compact is Rust-owned): no built core at ${_C48_CORE} — build it first (cargo build)." >&2
else
export AE_CORE_BIN="$_C48_CORE"
# DELIVERY FAILURE: a main agent whose pane is gone. compact must refuse before anything
# is asked of anyone — no request recorded, nothing stopped, nothing archived.
B48_REPO="$(setup_repo)"
(cd "$B48_REPO" && "$AE" --local comp-dead &) 2>/dev/null
wait_for_session "comp-dead" 20
sleep 1
B48_DEAD_PANE="$(grep '^main_pane=' "$HOME/.ae/sessions/comp-dead/meta" | cut -d= -f2- || true)"
tmux kill-pane -t "$B48_DEAD_PANE" 2>/dev/null || true
sleep 2
b48_dead_rc=0
b48_dead="$(AE_COMPACT_HANDOVER_SECS=6 "$AE" compact -f comp-dead 2>&1)" || b48_dead_rc=$?
assert_eq "compact-deliver: a main agent with no pane refuses the whole operation" "1" \
    "$([[ $b48_dead_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-deliver: and says the session is untouched rather than half-done" \
    "Nothing was stopped and nothing was archived" "$b48_dead"
assert_eq "compact-deliver: and NO request was recorded — nothing was asked of anyone" "0" \
    "$(awk '/"action":"ask"/ { n++ } END { print n + 0 }' "$HOME/.ae/sessions/comp-dead/events.jsonl" 2>/dev/null || echo 0)"
assert_eq "compact-deliver: the session state survives" "1" \
    "$([[ -f "$HOME/.ae/sessions/comp-dead/meta" ]] && echo 1 || echo 0)"
"$AE" end -f --keep-history comp-dead >/dev/null 2>&1 || true
unset B48_DEAD_PANE b48_dead b48_dead_rc

# TIMEOUT, REUSE, WITHDRAWAL — the three states a handover request can be in.
(cd "$B48_REPO" && "$AE" --local comp-wait &) 2>/dev/null
wait_for_session "comp-wait" 20
sleep 1
B48_WDIR="$HOME/.ae/sessions/comp-wait"
B48_WUUID="$(grep '^session_id=' "$B48_WDIR/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
b48_to_rc=0
b48_to="$(AE_COMPACT_HANDOVER_SECS=6 "$AE" compact -f comp-wait 2>&1)" || b48_to_rc=$?
assert_eq "compact-wait: with neither fact, it times out" "1" "$([[ $b48_to_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-wait: and says BOTH facts are required" \
    "a reply AND a new handover memo are both required" "$b48_to"
assert_contains "compact-wait: and names the two ways forward" "--digest-only comp-wait" "$b48_to"
assert_eq "compact-wait: exactly one request was sent" "1" \
    "$(awk '/"action":"ask"/ { n++ } END { print n + 0 }' "$B48_WDIR/events.jsonl")"
assert_eq "compact-wait: the source is untouched" "0" "$(tmux has-session -t comp-wait 2>/dev/null; echo $?)"
# A retry REUSES the outstanding request rather than delivering a second one.
b48_retry="$(AE_COMPACT_HANDOVER_SECS=4 "$AE" compact -f comp-wait 2>&1 || true)"
assert_contains "compact-wait: a retry reuses the outstanding request" "reusing the outstanding handover request" "$b48_retry"
assert_eq "compact-wait: and still only one request exists" "1" \
    "$(awk '/"action":"ask"/ { n++ } END { print n + 0 }' "$B48_WDIR/events.jsonl")"
# A reply ALONE is an agent saying "done" with nothing written down. The agent must answer
# DURING compact's wait, on the ref compact is actually waiting on — replying between two
# invocations CLOSES the request, and the next run then asks afresh with a new ref, which
# is a different scenario than the one this arm means to test.
B48_REF="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' "$B48_WDIR/events.jsonl" | tail -1)"
B48_WPANE="$(grep '^main_pane=' "$B48_WDIR/meta" | cut -d= -f2- || true)"
# THE FIXTURE NEEDS CLEARING FIRST, and the reason is worth knowing. The dummy agent in
# this suite is `bash`, and compact's request text contains a literal example command
# (`memo add --topic handover "<what the next session must know>"`). Pasting the ask into
# a SHELL executes it, so a handover memo appears that no agent ever decided to write —
# which makes the reply-only state unreachable and would let this arm "pass" against a
# state it never entered. A real agent reads that line as an instruction; a shell runs it.
: >"$B48_WDIR/memo.tsv"
assert_eq "compact-wait: (setup) no handover memo exists, so reply-only is reachable" "0" \
    "$(awk -F'\t' '$3 == "handover" { n++ } END { print n + 0 }' "$B48_WDIR/memo.tsv")"
# The ASSIGNEE replies, identified by its pane — the suite's convention for driving a
# helper. `--as` would be wrong here: it names the SENDER, and the sender is compact.
(
    sleep 3
    TMUX_PANE="$B48_WPANE" "$B48_WDIR/reply" "$B48_REF" 'done, nothing written' >/dev/null 2>&1 || true
) &
b48_reply_only="$(AE_COMPACT_HANDOVER_SECS=12 "$AE" compact -f comp-wait 2>&1 || true)"
wait || true
# ASSERT THE PRECONDITION BEFORE THE BEHAVIOUR: a negative test that passes because its
# setup silently failed is indistinguishable from one that passes because the code is right.
assert_eq "compact-wait: (setup) the assignee's reply really was recorded" "1" \
    "$(awk '/"action":"reply"/ { n++ } END { print n + 0 }' "$B48_WDIR/events.jsonl")"
assert_contains "compact-wait: a reply with no handover memo is not enough" \
    "a reply AND a new handover memo are both required" "$b48_reply_only"
assert_contains "compact-wait: and it names WHICH of the two facts is missing" \
    "The reply arrived; the handover memo did not." "$b48_reply_only"
# The reply CLOSED the request, so the generic "re-run to keep waiting on it" would be a
# promise ae cannot keep — a re-run asks again from scratch.
assert_contains "compact-wait: and does not promise a closed request is still open" \
    "a re-run sends a FRESH request" "$b48_reply_only"
assert_eq "compact-wait: still nothing stopped" "0" "$(tmux has-session -t comp-wait 2>/dev/null; echo $?)"
# BOTH facts, in the shape a real handover has: the memo is written, and the agent replies
# to the request compact is waiting on — which is a NEW one, because the previous reply
# closed the old. Driven through the REAL reply helper, so this exercises
# reply -> send -> the reserved event-only sink, not a hand-built event that looks like one.
"$B48_WDIR/memo" add --topic handover "what the next session must know" >/dev/null 2>&1 || true
assert_eq "compact-wait: (setup) now exactly one handover memo exists" "1" \
    "$(awk -F'\t' '$3 == "handover" { n++ } END { print n + 0 }' "$B48_WDIR/memo.tsv")"
(
    for _b48_i in $(seq 1 25); do
        _b48_ref="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' "$B48_WDIR/events.jsonl" 2>/dev/null | tail -1)"
        [[ -n "$_b48_ref" && "$_b48_ref" != "$B48_REF" ]] && break
        sleep 1
    done
    TMUX_PANE="$B48_WPANE" "$B48_WDIR/reply" "$_b48_ref" 'handed over' >/dev/null 2>&1 || true
) &
b48_both="$(AE_COMPACT_HANDOVER_SECS=40 "$AE" compact -f comp-wait 2>&1 || true)"
wait || true
assert_contains "compact-wait: reply AND memo together complete the handover" "handover complete" "$b48_both"
# AND THE COMPACT ACTUALLY COMPLETED. This is the one arm where compact proceeds through
# archive, end and relaunch, and it used to assert only that compact SAID "handover
# complete" before tearing the session down — a label claiming a behaviour and an
# assertion proving a word, which is exactly what shipped the broken --keep-history
# override. The uuid was already computed here and then discarded; shellcheck's SC2034 on
# it is what surfaced the gap, so the warning was the signal and not the noise.
assert_eq "compact-wait: and the archive really was published under the source's id" "1" \
    "$([[ -f "$HOME/.ae/archive/${B48_WUUID}/digest.md" ]] && echo 1 || echo 0)"
assert_eq "compact-wait: with a live child back under the same name" "0" \
    "$(tmux has-session -t comp-wait 2>/dev/null; echo $?)"
assert_eq "compact-wait: and the child continues THAT archive" "1" \
    "$(grep -c "^parent_archive_id=${B48_WUUID}$" "$HOME/.ae/sessions/comp-wait/meta" 2>/dev/null | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-wait >/dev/null 2>&1 || true
unset b48_to b48_to_rc b48_retry b48_reply_only b48_both

# --digest-only WITHDRAWS an outstanding request through the sensor, so no later archive
# reports an open request nobody is waiting on.
(cd "$B48_REPO" && "$AE" --local comp-withdraw &) 2>/dev/null
wait_for_session "comp-withdraw" 20
sleep 1
B48_XDIR="$HOME/.ae/sessions/comp-withdraw"
AE_COMPACT_HANDOVER_SECS=6 "$AE" compact -f comp-withdraw >/dev/null 2>&1 || true
B48_XREF="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' "$B48_XDIR/events.jsonl" | tail -1)"
assert_eq "compact-withdraw: (setup) a request is outstanding" "1" \
    "$("$B48_XDIR/requests" all 2>/dev/null | grep -c "pending .*${B48_XREF}" | tr -d '[:space:]')"
B48_XUUID="$(grep '^session_id=' "$B48_XDIR/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
b48_wd="$(AE_COMPACT_HANDOVER_SECS=6 "$AE" compact -f --digest-only comp-withdraw 2>&1 || true)"
sleep 2
assert_contains "compact-withdraw: --digest-only withdraws it explicitly" "withdrew ${B48_XREF}" "$b48_wd"
assert_contains "compact-withdraw: and says the digest is the handover" "the digest is the handover" "$b48_wd"
# THE EVIDENCE IS IN THE ARCHIVE, not in the live session: the withdrawal is a step, and
# the same command goes on to end this session and start a fresh one under the same name.
# Reading `requests` afterwards would inspect the CHILD's empty ledger and pass vacuously.
B48_XARCH="$HOME/.ae/archive/${B48_XUUID}"
assert_eq "compact-withdraw: the archived log carries both the ask and its cancellation" "1 1" \
    "$(awk '/"action":"ask"/ { a++ } /"action":"cancel"/ { c++ } END { print (a + 0) " " (c + 0) }' "$B48_XARCH/events.jsonl")"
assert_contains "compact-withdraw: so the archive reports NOTHING unresolved — the point of withdrawing" \
    "Unresolved requests (0)" "$(cat "$B48_XARCH/digest.md")"
assert_eq "compact-withdraw: and the withdrawn ref is not listed as outstanding anywhere in it" "0" \
    "$(grep -c "pending" "$B48_XARCH/digest.md" | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-withdraw >/dev/null 2>&1 || true
unset B48_REPO B48_WDIR B48_WUUID B48_REF B48_WPANE B48_XDIR B48_XREF B48_XUUID B48_XARCH b48_wd

# THE ROLLBACK MUST BE OBSERVED TO RUN. _launch_rollback is called from the --from
# reproof in SCRIPT BODY, which bash executes top-to-bottom; the definition used to sit
# ~500 lines further down, so the call was a missing command (rc 127) and the cleanup
# provably never happened — the failure was correctly DETECTED and nothing was undone,
# leaving a half-built same-name session squatting the name the recovery command needs.
# A rollback nobody has watched run is not a rollback. Driven deterministically by handing
# the launch an expectation that cannot match, rather than racing a vanishing archive.
C48V_REPO="$(setup_repo)"
(cd "$C48V_REPO" && "$AE" --local comp-roll &) 2>/dev/null
wait_for_session "comp-roll" 20
sleep 1
C48V_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-roll/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
"$AE" end -f --keep-history comp-roll >/dev/null 2>&1 || true
sleep 1
assert_eq "compact-rollback: (setup) the parent archive exists to inherit from" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48V_UUID}/meta" ]] && echo 1 || echo 0)"
c48v_rc=0
c48v="$( (cd "$C48V_REPO" && _AE_FROM_EXPECTED="not-the-proof-this-archive-yields" \
    "$AE" --local comp-rolled --from "$C48V_UUID") 2>&1 )" || c48v_rc=$?
sleep 2
assert_eq "compact-rollback: a parent that no longer matches refuses the launch" "1" \
    "$([[ $c48v_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-rollback: and says the parent changed under the launch" \
    "changed while this session was being created" "$c48v"
# THE PART THAT WAS BROKEN: the handler itself. Before the definition was moved, this
# printed 'command not found' and left every one of these behind.
assert_eq "compact-rollback: the rollback RAN — no command-not-found" "0" \
    "$(grep -c "command not found" <<<"$c48v" | tr -d '[:space:]')"
assert_eq "compact-rollback: no half-built session state survives" "0" \
    "$([[ -e "$HOME/.ae/sessions/comp-rolled" ]] && echo 1 || echo 0)"
assert_eq "compact-rollback: and no tmux session squats the name" "1" \
    "$(tmux has-session -t comp-rolled 2>/dev/null && echo 0 || echo 1)"
assert_eq "compact-rollback: the archive it refused to inherit is untouched" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48V_UUID}/meta" ]] && echo 1 || echo 0)"
unset C48V_REPO C48V_UUID c48v c48v_rc

# A CONSUMER THAT EXITS BEFORE READING MUST NOT COST THE RELAUNCH. Past the boundary the
# archive is published and the source is gone, so the only thing left that matters is that
# the fresh session starts. SIGPIPE KILLS the writer rather than failing the write, so
# `|| true` cannot help — measured before the fix, 3/3: archived YES, session gone, NO
# relaunch, recovery lost down the same closed pipe, and the PIPELINE REPORTING 0 because
# its status is the consumer's. `| head -1` does NOT reproduce it: the writes fit the pipe
# buffer before head can exit, the same buffer-size determinism as the tac|grep -m1 class.
# So the fixture must be a consumer that exits IMMEDIATELY. Do not "simplify" it.
# The assertion is the PROPERTY (the child exists), not the mechanism (a trap), because a
# pin on the printf would need rewriting the day the mechanism changes and would not have
# caught the inheritance half below at all.
C48P_REPO="$(setup_repo)"
(cd "$C48P_REPO" && "$AE" --local comp-pipe &) 2>/dev/null
wait_for_session "comp-pipe" 20
sleep 1
C48P_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-pipe/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
(cd "$C48P_REPO" && "$AE" compact -f --digest-only comp-pipe 2>"$TMPDIR/c48p.err" | true) || true
sleep 4
assert_eq "compact-pipe: the archive was published" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48P_UUID}/digest.md" ]] && echo 1 || echo 0)"
assert_eq "compact-pipe: AND THE CHILD STILL STARTED — a reporting failure must never suppress the relaunch" "0" \
    "$(tmux has-session -t comp-pipe 2>/dev/null; echo $?)"
assert_eq "compact-pipe: the child records the archive it continues" "1" \
    "$(grep -c "^parent_archive_id=${C48P_UUID}$" "$HOME/.ae/sessions/comp-pipe/meta" 2>/dev/null | tr -d '[:space:]')"
assert_contains "compact-pipe: and the recovery command survived on stderr" \
    "Recovery: cd " "$(cat "$TMPDIR/c48p.err")"
# THE OTHER HALF is pinned in tests/unit, structurally, and the reason is a real limit
# rather than laziness: an ignored signal disposition is INHERITED ACROSS EXEC, so leaving
# the trap set would hand every child session a process that cannot die on a closed pipe —
# fixing compact by breaking what it launches. macOS exposes no signal mask for a running
# process (no /proc, and ps has no field for it), so this suite cannot observe the child's
# disposition directly. The unit pin asserts the restore precedes the exec, and the
# mechanism itself was verified by hand: with the trap set the writer survives, with it
# restored the exec'd child reports the default disposition.
"$AE" end -f --keep-history comp-pipe >/dev/null 2>&1 || true
unset C48P_REPO C48P_UUID

# --keep-history MUST BE ABLE TO COMPLETE A COMPACT. The old arm was labelled "proceeds
# and seals keep" and proved NEITHER: with no -f it declined at the prompt, so its needle
# ("conversation files: kept") came from the FROZEN PRE-PROMPT FACTS while nothing
# proceeded and nothing was archived. It could not reach the code the override was broken
# in — _end_archive_plan re-derived the policy from live config and the byte-compare
# refused, so the documented escape hatch could never be used. This drives a REAL end
# against a purge-configured origin and asserts BOTH halves of that old label.
C48K_REPO="$(setup_repo)"
mkdir -p "$C48K_REPO/.ae"
printf '[workspace]\npurge_agent_history = true\n' >"$C48K_REPO/.ae/config"
(cd "$C48K_REPO" && "$AE" --local comp-keep &) 2>/dev/null
wait_for_session "comp-keep" 20
sleep 1
C48K_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-keep/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
c48k="$( (cd "$C48K_REPO" && "$AE" compact -f --digest-only --keep-history comp-keep) 2>&1 || true )"
sleep 3
assert_eq "compact-keep: --keep-history PROCEEDS — the archive is published" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48K_UUID}/digest.md" ]] && echo 1 || echo 0)"
assert_eq "compact-keep: and the source was really torn down and replaced" "1" \
    "$(grep -c "^parent_archive_id=${C48K_UUID}$" "$HOME/.ae/sessions/comp-keep/meta" 2>/dev/null | tr -d '[:space:]')"
assert_eq "compact-keep: with a live child under the same name" "0" \
    "$(tmux has-session -t comp-keep 2>/dev/null; echo $?)"
assert_contains "compact-keep: and keep was SEALED — the conversation files were not purged" \
    "kept agent conversation files" "$c48k"
assert_eq "compact-keep: the plan never flipped under the shared planner" "0" \
    "$(grep -c "changed since it was authorized" <<<"$c48k" | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-keep >/dev/null 2>&1 || true
unset C48K_REPO C48K_UUID c48k

# THE ROSTER IS AUTHORIZED, NOT MERELY RESOLVABLE. It is PRINTED at the prompt as what the
# child will start, so a config rewritten during the window must refuse — proving that
# SOME roster still resolves would let a child start agents nobody approved. Edits made
# BEFORE compact are still adopted; only a change DURING the window is refused.
C48R_REPO="$(setup_repo)"
mkdir -p "$C48R_REPO/.ae"
printf '[profiles]\ndummy = "bash"\n\n[roster]\ndummy = dummy\n\n[workspace]\nmain = dummy\n' >"$C48R_REPO/.ae/config"
(cd "$C48R_REPO" && "$AE" --local comp-roster &) 2>/dev/null
wait_for_session "comp-roster" 20
sleep 1
C48R_FIFO="$TMPDIR/c48r.fifo"; rm -f "$C48R_FIFO"; mkfifo "$C48R_FIFO"
(
    exec 3>"$C48R_FIFO"
    sleep 5   # the prompt is on screen, promising main=dummy
    printf '[profiles]\ndummy2 = "bash"\n\n[roster]\ndummy2 = dummy2\n\n[workspace]\nmain = dummy2\n' >"$C48R_REPO/.ae/config"
    printf 'y' >&3
    exec 3>&-
) &
c48r_rc=0
c48r="$( (cd "$C48R_REPO" && "$AE" compact --digest-only comp-roster <"$C48R_FIFO") 2>&1 )" || c48r_rc=$?
wait || true
rm -f "$C48R_FIFO"
assert_eq "compact-roster: a roster rewritten under the answer refuses" "1" \
    "$([[ $c48r_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-roster: and says the child would start something else" \
    "would now start a different roster than the one shown" "$c48r"
assert_contains "compact-roster: naming what was shown" "main=dummy" "$c48r"
assert_eq "compact-roster: nothing was stopped" "0" "$(tmux has-session -t comp-roster 2>/dev/null; echo $?)"
"$AE" end -f --keep-history comp-roster >/dev/null 2>&1 || true
unset C48R_REPO C48R_FIFO c48r c48r_rc

# THE CHILD STARTS WHAT WAS AUTHORIZED — PINNED AT THE CHILD, not at the gates. Both
# gates already refuse a config rewritten before them; the window they cannot cover opens
# AFTER the second gate, while the end is archiving and tearing down, and closes when the
# child launches. In that window the source session is already gone, so a child starting
# the wrong roster is unrecoverable. The rewrite is therefore timed to the ARCHIVE
# APPEARING, which happens after gate 2 and before the exec. A fix must be pinned at the
# point it claims to protect, not where it was convenient to observe.
C48S_REPO="$(setup_repo)"
mkdir -p "$C48S_REPO/.ae"
printf '[profiles]\ndummy = "bash"\ndummy2 = "bash"\n\n[roster]\ndummy = dummy\n\n[workspace]\nmain = dummy\n' >"$C48S_REPO/.ae/config"
(cd "$C48S_REPO" && "$AE" --local comp-snap &) 2>/dev/null
wait_for_session "comp-snap" 20
sleep 1
C48S_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-snap/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
(
    for _c48s_i in $(seq 1 160); do
        [[ -d "$HOME/.ae/archive/${C48S_UUID}" ]] && break
        sleep 0.25
    done
