# test controls. Left to the caller's stdin it passed only because whatever the harness
# handed it happened not to be `y` — and the day that stdin was EOF instead, compact's
# bare `read` aborted under set -e and took the whole suite with it. EOF is now a clean
# decline in ae, and this asserts it rather than inheriting it.
c48_ok_rc=0
c48_ok="$("$AE" compact comp-ok </dev/null 2>&1)" || c48_ok_rc=$?
assert_contains "compact: no answer at all is not a crash" "could not obtain confirmation" "$c48_ok"
# `n` is a DECISION and exits 0; EOF is the ABSENCE of one and must not report success —
# stdout is empty either way, so the status is the caller's only way to tell them apart.
assert_eq "compact: EOF exits NONZERO — ae could not ask, which is not the operator saying no" "1" \
    "$([[ $c48_ok_rc -ne 0 ]] && echo 1 || echo 0)"
assert_eq "compact: while a typed 'n' is an answer, and answers exit 0" "0" \
    "$(printf 'n' | "$AE" compact comp-ok >/dev/null 2>&1; echo $?)"
assert_eq "compact: a decline writes NOTHING to stdout — the contract means the boundary was crossed" "0" \
    "$("$AE" compact comp-ok </dev/null 2>/dev/null || true | wc -c | tr -d '[:space:]')"
assert_contains "compact: it names the frozen session and mode" "compact: comp-ok (local) resolved and frozen." "$c48_ok"
assert_contains "compact: and the uuid it froze, with its provenance" "uuid: ${C48_UUID} (session)" "$c48_ok"
assert_contains "compact: and the exact archive path it would write" "archive: $HOME/.ae/archive/${C48_UUID}" "$c48_ok"
assert_contains "compact: and what happens to the conversation files" "conversation files: kept" "$c48_ok"
assert_eq "compact: resolving creates NO archive" "0" \
    "$([[ -e "$HOME/.ae/archive/${C48_UUID}" ]] && echo 1 || echo 0)"
assert_eq "compact: and takes no publisher claim" "0" \
    "$(find "$HOME/.ae/archive" -maxdepth 1 -name '.publishing.*' 2>/dev/null | grep -c . | tr -d '[:space:]')"
assert_eq "compact: and leaves the session running" "0" "$(tmux has-session -t comp-ok 2>/dev/null; echo $?)"

