    "$([[ "$gh_single" == *"cannot verify"* ]] && echo 1 || echo 0)"
if gh_out="$("$AE" stop all -y 2>&1)"; then gh_rc=0; else gh_rc=$?; fi
assert_eq "ghost (F6): 'stop all' does NOT write the target off as absent" "1" \
    "$([[ "$gh_out" != *"No running ae sessions."* ]] && echo 1 || echo 0)"
assert_eq "ghost (F6): the unverifiable target is carried into the fleet" "1" \
    "$([[ "$gh_out" == *"out of process"* ]] && echo 1 || echo 0)"
# F7, FAILURE DIRECTION — this caller is OUTSIDE the fleet, so it survives the
# handoff and owes a real exit code. Before the amendment its rc covered only the
# handoff, and a script driving `ae stop all` could not tell this apart from a
# clean run. It waits on the durable record, so the failure reaches it.
assert_eq "outside caller (F7): a target that could not be stopped makes the rc non-zero" "1" \
    "$([[ "$gh_rc" -ne 0 ]] && echo 1 || echo 0)"
assert_eq "outside caller (F7): and the failing session is NAMED, not just counted" "1" \
    "$([[ "$gh_out" == *"stop failed for:"*"ghsess"* ]] && echo 1 || echo 0)"
assert_eq "ghost (F6): its failure is recorded durably, not swallowed" "1" \
    "$(_gh_ev="$HOME/.ae/sessions/ghsess/events.jsonl"
       [[ -f "$_gh_ev" ]] && command grep -q '"action":"stop-result"' "$_gh_ev" 2>/dev/null \
        && command grep -q 'FAILED' "$_gh_ev" 2>/dev/null && echo 1 || echo 0)"
kill "$GH_PID" 2>/dev/null || true; sleep 0.3
printf 'y\n' | "$AE" end -f --assume-stopped ghsess >/dev/null 2>&1 || true
rm -rf "$HOME/.ae/sessions/ghsess" 2>/dev/null || true
unset GH REPO_GH GH_PID gh_out gh_rc gh_single _i

# (j) F7, SUCCESS DIRECTION — the outside caller's rc must be able to be ZERO. The
# ghost seed above only pins the failure direction, so on its own a mutant that
# always returns non-zero survives it; this is the other half of the vice.
# ISOLATED AE_HOME on purpose: the fleet must be exactly these two specimens, or
# the rc would depend on whatever metadata earlier seeds happened to leave behind
# rather than on the property under test. The tmux server is still the suite's.
OK_HOME="$TMPDIR/okhome"
mkdir -p "$OK_HOME"
command cp "$HOME/.ae/config" "$OK_HOME/config" 2>/dev/null || true
OK_R1="$(setup_repo)"; OK_R2="$(setup_repo)"
(cd "$OK_R1" && AE_HOME="$OK_HOME" "$AE" --local okone &) 2>/dev/null
wait_for_session "okone"
(cd "$OK_R2" && AE_HOME="$OK_HOME" "$AE" --local oktwo &) 2>/dev/null
wait_for_session "oktwo"
sleep 1
# Verify the SPECIMEN before trusting what it reports: an isolated home that
# silently picked up extra sessions would make the rc mean something else.
assert_eq "outside caller (F7): the isolated fleet is exactly the two specimens" "2" \
    "$(command ls -1 "$OK_HOME/sessions" 2>/dev/null | command grep -c '^ok' | tr -d '[:space:]')"
if ok_out="$(AE_HOME="$OK_HOME" "$AE" stop all -y 2>&1)"; then ok_rc=0; else ok_rc=$?; fi
assert_eq "outside caller (F7): every target stopped cleanly -> rc 0" "0" "$ok_rc"
# It WAITED: no pending note, no error, and the sessions are actually gone by the
# time it returned — which is the difference between folding outcomes and merely
# announcing a handoff.
assert_eq "outside caller (F7): it waited for the outcomes rather than only announcing" "1" \
    "$([[ "$ok_out" == *"out of process"* && "$ok_out" != *"still pending"* && "$ok_out" != *"Error:"* ]] && echo 1 || echo 0)"
assert_eq "outside caller (F7): both sessions are gone when the caller returns" "0" \
    "$(tmux list-sessions -F '#{session_name}' 2>/dev/null | command grep -c '^ok' | tr -d '[:space:]')"
for _n in okone oktwo; do AE_HOME="$OK_HOME" "$AE" end -f "$_n" >/dev/null 2>&1 || true; done
rm -rf "$OK_HOME"
unset OK_HOME OK_R1 OK_R2 ok_out ok_rc _n

# (k) F9 — WHAT WAS CONFIRMED IS WHAT GETS ACTED ON. The supervisor used to
# re-enumerate metadata after the handoff, so a session created in the gap was
# killed without ever having been confirmed. The gap is a RACE, and racing it would
# pin a property only on machines that happen to lose — so this drives the
# supervisor DIRECTLY with a frozen one-name list while a second session sits right
# beside it in the same metadata. Under the old code that second session was found
# by enumeration and died; under F9 the argv list is the whole world.
FZ_R1="$(setup_repo)"; FZ_R2="$(setup_repo)"
(cd "$FZ_R1" && "$AE" --local fzone &) 2>/dev/null
wait_for_session "fzone" || true
(cd "$FZ_R2" && "$AE" --local fztwo &) 2>/dev/null
wait_for_session "fztwo" || true
sleep 1
# Verify the SPECIMEN: both sessions really are in ae's metadata, so enumeration
# WOULD have found the bystander. Without this the seed could pass vacuously.
assert_eq "frozen set (F9): both sessions are enumerable before the stop" "1|1" \
    "$(printf '%s|%s' \
        "$([[ -f "$HOME/.ae/sessions/fzone/meta" ]] && echo 1 || echo 0)" \
        "$([[ -f "$HOME/.ae/sessions/fztwo/meta" ]] && echo 1 || echo 0)")"
fz_op="aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
# The payload is (name, instance) pairs since round 9 — a bare name is a truncated
# payload and is refused outright, which is its own pin further down.
fz_sid="$(command grep '^session_id=' "$HOME/.ae/sessions/fzone/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
"$AE" _stop-fleet-supervisor "$fz_op" fzone "$fz_sid" >/dev/null 2>&1 || true
for _i in $(seq 1 40); do tmux has-session -t "=fzone" 2>/dev/null || break; sleep 0.5; done
sleep 1
assert_eq "frozen set (F9): the named target is stopped" "1" \
    "$(tmux has-session -t "=fzone" 2>/dev/null && echo 0 || echo 1)"
assert_eq "frozen set (F9): the UNCONFIRMED bystander is untouched" "1" \
    "$(tmux has-session -t "=fztwo" 2>/dev/null && echo 1 || echo 0)"
# ...and the bystander has no stop event at all — not merely a surviving session,
# but an operation that never reached for it. Asked as a BOOLEAN: `grep -c` on a
# file that does not exist prints nothing rather than 0, so the counting spelling
# of this pin failed on correct behaviour.
assert_eq "frozen set (F9): the bystander was never even requested" "1" \
    "$(command grep -q 'stop-request' "$HOME/.ae/sessions/fztwo/events.jsonl" 2>/dev/null && echo 0 || echo 1)"
# F8/N4 — the durable record carries THIS operation's id, and says what actually
# happened: a fleet stop, not the self-stop the shared worker used to claim.
assert_eq "provenance (F8): the result is stamped with the operation id" "1" \
    "$(command grep '"action":"stop-result"' "$HOME/.ae/sessions/fzone/events.jsonl" 2>/dev/null \
        | command grep -Fq "[op ${fz_op}]" && echo 1 || echo 0)"
assert_eq "audit (N4): a fleet request is recorded as a fleet request, not a self-stop" "1" \
    "$(_fz_req="$(command grep '"action":"stop-request"' "$HOME/.ae/sessions/fzone/events.jsonl" 2>/dev/null | tail -1)"
       [[ "$_fz_req" == *"fleet stop requested"* && "$_fz_req" != *"from inside the session"* ]] && echo 1 || echo 0)"
# A malformed operation id is refused at the entrypoint — it reaches an event
# summary, so the boundary is entered here rather than trusted from the caller.
fz_sid2="$(command grep '^session_id=' "$HOME/.ae/sessions/fztwo/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
"$AE" _stop-fleet-supervisor "not-a-uuid" fztwo "$fz_sid2" >/dev/null 2>&1 || true
sleep 1
assert_eq "provenance (F8): a malformed operation id stops nothing" "1" \
    "$(tmux has-session -t "=fztwo" 2>/dev/null && echo 1 || echo 0)"
# ...and an UNPAIRED payload is refused outright rather than half-acted on: a list
# that does not pair is not a payload any part of which we may honour.
"$AE" _stop-fleet-supervisor "$fz_op" fztwo >/dev/null 2>&1 || true
sleep 1
assert_eq "frozen set (F9): a truncated (unpaired) payload stops nothing" "1" \
    "$(tmux has-session -t "=fztwo" 2>/dev/null && echo 1 || echo 0)"
for _n in fzone fztwo; do "$AE" end -f "$_n" >/dev/null 2>&1 || true; done
unset FZ_R1 FZ_R2 fz_op fz_sid fz_sid2 _n _i

# (m) F10 — A NAME IS A SLOT, NOT A THING. Freezing the SET (F9) still froze NAMES,
# and a name can be handed to a different session between confirmation and kill:
# end the original completely, launch a fresh one under the same name, and the
# frozen payload authorized killing the REPLACEMENT — with success recorded, and in
# flat contradiction of what the docs promise about a session started while you are
# deciding. Fully deterministic: no race, the substitution is performed outright.
AB_R1="$(setup_repo)"
(cd "$AB_R1" && "$AE" --local abasame &) 2>/dev/null
wait_for_session "abasame" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/abasame/meta" ]] && break; sleep 0.3; done
ab_old="$(command grep '^session_id=' "$HOME/.ae/sessions/abasame/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
# The payload is frozen HERE, against the ORIGINAL instance.
"$AE" end -f abasame >/dev/null 2>&1 || true
AB_R2="$(setup_repo)"
(cd "$AB_R2" && "$AE" --local abasame &) 2>/dev/null
wait_for_session "abasame" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/abasame/meta" ]] && break; sleep 0.3; done
ab_new="$(command grep '^session_id=' "$HOME/.ae/sessions/abasame/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
# SPECIMEN PRECONDITION: the name really was reused by a DIFFERENT instance. Without
# this the seed would pass just as happily if ae had reused the same id.
assert_eq "ABA (F10): the same name now carries a different instance" "1" \
    "$([[ -n "$ab_old" && -n "$ab_new" && "$ab_old" != "$ab_new" ]] && echo 1 || echo 0)"
ab_op="bbbbbbbb-cccc-dddd-eeee-ffffffffffff"
"$AE" _stop-fleet-supervisor "$ab_op" abasame "$ab_old" >/dev/null 2>&1 || true
sleep 2
assert_eq "ABA (F10): the REPLACEMENT is left running" "1" \
    "$(tmux has-session -t "=abasame" 2>/dev/null && echo 1 || echo 0)"
# ...and the refusal is durable and diagnosable: stamped with the operation, marked
# FAILED, naming both instances. A silent survivor would be indistinguishable from
# a stop that simply had not happened yet.
assert_eq "ABA (F10): the refusal is recorded, stamped, and names both instances" "1" \
    "$(_ab_ev="$HOME/.ae/sessions/abasame/events.jsonl"
       _ab_res="$(command grep '"action":"stop-result"' "$_ab_ev" 2>/dev/null | command grep -F "[op ${ab_op}]" | tail -1)"
       [[ "$_ab_res" == *FAILED* && "$_ab_res" == *"not the session that was confirmed"* \
        && "$_ab_res" == *"$ab_new"* && "$_ab_res" == *"$ab_old"* ]] && echo 1 || echo 0)"
# ...while the CURRENT instance is still stoppable by a payload that names it —
# the guard must refuse a stale authorization, not the session itself.
"$AE" _stop-fleet-supervisor "$ab_op" abasame "$ab_new" >/dev/null 2>&1 || true
for _i in $(seq 1 40); do tmux has-session -t "=abasame" 2>/dev/null || break; sleep 0.5; done
assert_eq "ABA (F10): the CURRENT instance is still stoppable when correctly named" "1" \
    "$(tmux has-session -t "=abasame" 2>/dev/null && echo 0 || echo 1)"
"$AE" end -f abasame >/dev/null 2>&1 || true
unset AB_R1 AB_R2 ab_old ab_new ab_op _i

# (n) F11 — A COMPLETE PAIR MUST NOT BE ACTED ON BEFORE THE PAYLOAD IS ACCEPTED.
# The shape check used to run AFTER the loop, so a payload of one good pair plus a
# dangling tail killed the good target and recorded it verified-gone, and only THEN
# returned non-zero. Round 9's seed passed over this because a single bare name is
# ZERO complete pairs — there was nothing for the loop to act on, so the specimen
# never reached the property it was supposed to protect.
OD_R="$(setup_repo)"
(cd "$OD_R" && "$AE" --local oddone &) 2>/dev/null
wait_for_session "oddone" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/oddone/meta" ]] && break; sleep 0.3; done
od_sid="$(command grep '^session_id=' "$HOME/.ae/sessions/oddone/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
od_op="cccccccc-dddd-eeee-ffff-000000000000"
# SPECIMEN PRECONDITION: the pair really is complete and valid, so the ONLY defect
# in this payload is the dangling tail. Without this the seed could refuse for the
# wrong reason and still look green.
assert_eq "odd payload (F11): the leading pair is itself well-formed" "1" \
    "$([[ -n "$od_sid" ]] && echo 1 || echo 0)"
"$AE" _stop-fleet-supervisor "$od_op" oddone "$od_sid" dangling >/dev/null 2>&1 || true
sleep 2
assert_eq "odd payload (F11): the complete pair is NOT acted on" "1" \
    "$(tmux has-session -t "=oddone" 2>/dev/null && echo 1 || echo 0)"
# (Round 10 asserted the target was never even REQUESTED. Round 11 ruled the
# opposite for the record: a refused payload must leave a durable stamped failure,
# or a dead worker reads as pending success. Both facts survive — nothing is
# STOPPED, and the refusal is TOLD. The pin follows the ruling.)
assert_eq "odd payload (F11): the refusal is recorded, and it is a refusal" "1" \
    "$(_od_res="$(command grep '"action":"stop-result"' "$HOME/.ae/sessions/oddone/events.jsonl" 2>/dev/null | command grep -F "[op ${od_op}]" | tail -1)"
       [[ "$_od_res" == *FAILED* && "$_od_res" == *"malformed"* ]] && echo 1 || echo 0)"
assert_eq "odd payload (F11): and no stop-request was ever issued for it" "1" \
    "$(command grep -q '"action":"stop-request"' "$HOME/.ae/sessions/oddone/events.jsonl" 2>/dev/null && echo 0 || echo 1)"
# ...and the same pair WITHOUT the tail still works, so the refusal is about the
# payload's shape and not about this target.
"$AE" _stop-fleet-supervisor "$od_op" oddone "$od_sid" >/dev/null 2>&1 || true
for _i in $(seq 1 40); do tmux has-session -t "=oddone" 2>/dev/null || break; sleep 0.5; done
assert_eq "odd payload (F11): the same pair alone is honoured" "1" \
    "$(tmux has-session -t "=oddone" 2>/dev/null && echo 0 || echo 1)"
"$AE" end -f oddone >/dev/null 2>&1 || true
unset OD_R od_sid od_op _i

# (o) F10(a)/F10(b) — A SENTINEL IS NOT AN IDENTITY. Two pre-feature sessions both
# freeze as "-", so ending one and renaming another into its name satisfied the
# frozen comparison exactly and killed the replacement with rc 0. `ae rename`
# preserves a missing session_id, which is what made the two indistinguishable.
# Legacy state is built by STRIPPING session_id from a real session's meta — the
# honest way to get a pre-feature specimen out of a current ae.
#
# ISOLATED AE_HOME, because this seed runs `stop all`: against the shared test home
# its exit status would depend on whatever metadata earlier seeds left behind rather
# than on the property under test.
LG_HOME="$TMPDIR/lghome"
mkdir -p "$LG_HOME"
command cp "$HOME/.ae/config" "$LG_HOME/config" 2>/dev/null || true
LG_R1="$(setup_repo)"; LG_R2="$(setup_repo)"
(cd "$LG_R1" && AE_HOME="$LG_HOME" "$AE" --local oldslot &) 2>/dev/null
wait_for_session "oldslot" || true
(cd "$LG_R2" && AE_HOME="$LG_HOME" "$AE" --local replacement &) 2>/dev/null
wait_for_session "replacement" || true
for _n in oldslot replacement; do
    for _i in $(seq 1 25); do [[ -f "$LG_HOME/sessions/$_n/meta" ]] && break; sleep 0.3; done
done
# A launch that never came up must FAIL here, loudly, rather than abort the suite at
# a bare wait_for_session — the "no FAIL lines = vacuous" trap, from the seed side.
assert_eq "legacy ABA (F10): both specimens launched" "1|1" \
    "$(printf '%s|%s' \
        "$([[ -f "$LG_HOME/sessions/oldslot/meta" ]] && echo 1 || echo 0)" \
        "$([[ -f "$LG_HOME/sessions/replacement/meta" ]] && echo 1 || echo 0)")"
for _n in oldslot replacement; do
    if [[ -f "$LG_HOME/sessions/$_n/meta" ]]; then
        command grep -v '^session_id=' "$LG_HOME/sessions/$_n/meta" >"$TMPDIR/lgm" 2>/dev/null || true
        command mv -f "$TMPDIR/lgm" "$LG_HOME/sessions/$_n/meta" 2>/dev/null || true
    fi
done
# Asked as BOOLEANS. `grep -c` prints "0" AND exits 1 on no-match, so the obvious
# `... | tr -d '[:space:]' || echo 0` spelling emits "00" — the same counting trap
# that bit the round-8 bystander pin, one spelling over. Counts from grep are a
# false friend here; presence is the actual question.
assert_eq "legacy ABA (F10): both specimens really are pre-feature (no session_id)" "1|1" \
    "$(printf '%s|%s' \
        "$(command grep -q '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null && echo 0 || echo 1)" \
        "$(command grep -q '^session_id=' "$LG_HOME/sessions/replacement/meta" 2>/dev/null && echo 0 || echo 1)")"
lg_op="dddddddd-eeee-ffff-0000-111111111111"
# The reviewer's exact sequence, driven with the STALE dash payload a pre-mint ae
# would have frozen: end the original, move the other into its name.
AE_HOME="$LG_HOME" "$AE" end -f oldslot >/dev/null 2>&1 || true
AE_HOME="$LG_HOME" "$AE" rename replacement oldslot >/dev/null 2>&1 || true
sleep 1
AE_HOME="$LG_HOME" "$AE" _stop-fleet-supervisor "$lg_op" oldslot - >/dev/null 2>&1 || true
sleep 2
assert_eq "legacy ABA (F10b): a frozen dash does not authorize the renamed session" "1" \
    "$(tmux has-session -t "=oldslot" 2>/dev/null && echo 1 || echo 0)"
assert_eq "legacy ABA (F10b): the refusal is durable, stamped, and names the fact" "1" \
    "$(_lg_res="$(command grep '"action":"stop-result"' "$LG_HOME/sessions/oldslot/events.jsonl" 2>/dev/null | command grep -F "[op ${lg_op}]" | tail -1)"
       [[ "$_lg_res" == *FAILED* && "$_lg_res" == *"no instance identity was frozen"* && "$_lg_res" == *"(F10)"* ]] && echo 1 || echo 0)"
# (a) MINT ON TOUCH: the same pre-feature session, taken through a real fleet
# confirmation, ACQUIRES an identity — and keeps it. From here it is defensible.
lg_before="$(command grep -q '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null && echo 1 || echo 0)"
# lg_out captures the command's output only to keep it out of the suite log; the
# assertions below read lg_rc and the meta file.
# shellcheck disable=SC2034
if lg_out="$(AE_HOME="$LG_HOME" "$AE" stop all -y 2>&1)"; then lg_rc=0; else lg_rc=$?; fi
lg_after="$(command grep '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
assert_eq "mint-at-freeze (F10a): a pre-feature session gains an identity on fleet contact" "0|1" \
    "$(printf '%s|%s' "$lg_before" "$([[ -n "$lg_after" ]] && echo 1 || echo 0)")"
assert_eq "mint-at-freeze (F10a): and the stop it was minted for then succeeds" "0|1" \
    "$(printf '%s|%s' "$lg_rc" "$(tmux has-session -t "=oldslot" 2>/dev/null && echo 0 || echo 1)")"
# ...and the minted identity SURVIVES a resume, which is what makes it an identity
# rather than a per-operation nonce.
(cd "$LG_R2" && AE_HOME="$LG_HOME" "$AE" oldslot &) 2>/dev/null
wait_for_session "oldslot" || true
sleep 1
assert_eq "mint-at-freeze (F10a): the minted identity survives stop and resume" "1" \
    "$(_lg_now="$(command grep '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
       [[ -n "$lg_after" && "$_lg_now" == "$lg_after" ]] && echo 1 || echo 0)"
AE_HOME="$LG_HOME" "$AE" end -f oldslot >/dev/null 2>&1 || true
rm -rf "$LG_HOME"
unset LG_HOME LG_R1 LG_R2 lg_op lg_before lg_after lg_out lg_rc _n _i

# (p) ROUND 11 — RENAME IS A LIFECYCLE OPERATION. It took no lifecycle lock, so a
# rename landing between a freeze and its lock rebuilt the F10 kill exactly. The
# interleave is FORCED rather than raced: hold the target's lifecycle lock from
# outside and assert the rename WAITS for it instead of walking through.
RN_HOME="$TMPDIR/rnhome"
mkdir -p "$RN_HOME"
command cp "$HOME/.ae/config" "$RN_HOME/config" 2>/dev/null || true
RN_R="$(setup_repo)"
(cd "$RN_R" && AE_HOME="$RN_HOME" "$AE" --local rnsrc &) 2>/dev/null
wait_for_session "rnsrc" || true
for _i in $(seq 1 25); do [[ -f "$RN_HOME/sessions/rnsrc/meta" ]] && break; sleep 0.3; done
assert_eq "rename lock: the specimen launched" "1" \
    "$([[ -f "$RN_HOME/sessions/rnsrc/meta" ]] && echo 1 || echo 0)"
if command -v flock >/dev/null 2>&1; then
    # Hold the TARGET name's lock — the one a concurrent freeze/stop would hold.
    mkdir -p "$RN_HOME/sessions"
    # HOLD LONGER THAN THE WAITER. rename waits 15s; a 12s hold meant it waited,
    # the holder released, and the rename legitimately succeeded — the seed was
    # measuring its own sleep rather than the lock. The lksess seed already had this
    # right (hold 20 against a 15s wait); this one now matches it.
    ( exec 9>"$RN_HOME/sessions/.lifecycle.rndst.lock"; flock 9; sleep 25 ) &
    rn_holder=$!
    sleep 1
    if rn_out="$(AE_HOME="$RN_HOME" _timeout 25 "$AE" rename rnsrc rndst 2>&1)"; then rn_rc=0; else rn_rc=$?; fi
    assert_eq "rename lock: rename REFUSES while a lifecycle lock is held, and renames nothing" "1" \
        "$([[ "$rn_rc" -ne 0 && "$rn_out" == *"lifecycle operation"* ]] && echo 1 || echo 0)"
    assert_eq "rename lock: the source session is untouched by the refusal" "1" \
        "$(tmux has-session -t "=rnsrc" 2>/dev/null && echo 1 || echo 0)"
    kill "$rn_holder" 2>/dev/null || true; wait "$rn_holder" 2>/dev/null || true
    sleep 0.5
else
    # NEVER count unexecuted assertions as passes — the round-7 lesson. A supported
    # shape without flock reports the skip out loud instead.
    printf 'NOTE: rename lifecycle-lock interleave SKIPPED — flock not available (2 assertions not executed).\n' >&2
fi
# ...and with nothing held, the same rename succeeds: the lock is a gate, not a wall.
if AE_HOME="$RN_HOME" "$AE" rename rnsrc rndst >/dev/null 2>&1; then rn_rc2=0; else rn_rc2=$?; fi
assert_eq "rename lock: an uncontended rename still succeeds" "0|1" \
    "$(printf '%s|%s' "$rn_rc2" "$(tmux has-session -t "=rndst" 2>/dev/null && echo 1 || echo 0)")"
AE_HOME="$RN_HOME" "$AE" end -f rndst >/dev/null 2>&1 || true
AE_HOME="$RN_HOME" "$AE" end -f rnsrc >/dev/null 2>&1 || true
rm -rf "$RN_HOME"
unset RN_HOME RN_R rn_holder rn_out rn_rc rn_rc2 _i

# (q) I4 — A DEAD WORKER MUST NOT READ AS PENDING SUCCESS. A malformed payload made
# the child return before emitting anything, while the parent had already announced
# the handoff and settled in to wait 30s for results no living process would write.
# Driven at the CHILD, which is where the silence was.
DW_R="$(setup_repo)"
(cd "$DW_R" && "$AE" --local deadw &) 2>/dev/null
wait_for_session "deadw" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/deadw/meta" ]] && break; sleep 0.3; done
assert_eq "dead worker (I4): the specimen launched" "1" \
    "$([[ -f "$HOME/.ae/sessions/deadw/meta" ]] && echo 1 || echo 0)"
dw_op="eeeeeeee-ffff-0000-1111-222222222222"
"$AE" _stop-fleet-supervisor "$dw_op" deadw not-a-uuid >/dev/null 2>&1 || true
sleep 2
assert_eq "dead worker (I4): the malformed payload stops nothing" "1" \
    "$(tmux has-session -t "=deadw" 2>/dev/null && echo 1 || echo 0)"
# The refusal is DURABLE and op-stamped, which is the only thing that lets the
# caller's wait tell a refusal apart from a result that has not arrived yet.
assert_eq "dead worker (I4): the refusal is recorded against the named target" "1" \
    "$(_dw="$(command grep '"action":"stop-result"' "$HOME/.ae/sessions/deadw/events.jsonl" 2>/dev/null | command grep -F "[op ${dw_op}]" | tail -1)"
       [[ "$_dw" == *FAILED* && "$_dw" == *"malformed"* && "$_dw" == *"(F11)"* ]] && echo 1 || echo 0)"
"$AE" end -f deadw >/dev/null 2>&1 || true
unset DW_R dw_op _i

# (l) I3 — THE NO-TTY REFUSAL MUST ACTUALLY PRINT ITS RETRY LINE. `[[ -r /dev/tty ]]`
# is TRUE on macOS inside a process with no controlling terminal while the OPEN
# fails with "Device not configured" — measured on this box under run-shell: -r
# TRUE, open FAILS. So the refusal branch never ran: the caller got the prompt, a
# shell diagnostic and "Not stopped", and never the one line it needed. `run-shell`
# is the seam because its child genuinely has no controlling terminal; a redirect
# would not reproduce it, since a controlling tty is a process property, not an fd.
TT_R="$(setup_repo)"
(cd "$TT_R" && "$AE" --local ttysess &) 2>/dev/null
wait_for_session "ttysess"
sleep 1
tt_out="$TMPDIR/tty.out"
tmux run-shell -t ttysess \
    "env HOME='$HOME' AE_HOME='$AE_HOME' '$AE' stop all >'$tt_out' 2>&1" || true
sleep 2
assert_eq "no-tty (I3): the refusal names the exact retry flag" "1" \
    "$([[ "$(cat "$tt_out" 2>/dev/null || true)" == *"Re-run with -y: ae stop all -y"* ]] && echo 1 || echo 0)"
# ...and it refused: an un-confirmable destructive fleet stop must not proceed.
assert_eq "no-tty (I3): nothing was stopped without a confirmation" "1" \
    "$(tmux has-session -t "=ttysess" 2>/dev/null && echo 1 || echo 0)"
# ...and it did not ask a question it could not receive an answer to.
assert_eq "no-tty (I3): no prompt is printed when there is no one to prompt" "1" \
    "$([[ "$(cat "$tt_out" 2>/dev/null || true)" != *"Continue?"* ]] && echo 1 || echo 0)"
"$AE" end -f ttysess >/dev/null 2>&1 || true
rm -f "$tt_out"
unset TT_R tt_out

# ── #34: end STOPS before it SNAPSHOTS ───────────────────────────────
# end used to add/commit/fetch/push while the agents were still live and only then
# kill, so a write landing after the snapshot and before the kill was neither
# committed nor left on disk — cleanup removed the directory it lived in.
#
# The seed asks the ORDER question directly rather than racing a writer into the
# window: a post-commit hook records whether the tmux session was still ALIVE at the
# moment end took its snapshot. Alive means agents could still be writing into a tree
# ae is about to commit and then delete. Deterministic — the hook fires on end's own
# commit, every run, with no timing assumption at all.
#
# WORKTREE mode, deliberately: --local never commits at all ("files are in the
# original dir"), so a local specimen never reaches the snapshot path and the seed
# would go red for the wrong reason. It did exactly that on the first red run.
E34_R="$(setup_repo)"
E34_REMOTE="$TMPDIR/e34-remote.git"
git -C "$E34_R" clone -q --bare "$E34_R" "$E34_REMOTE" 2>/dev/null
git -C "$E34_R" remote add origin "$E34_REMOTE" 2>/dev/null || git -C "$E34_R" remote set-url origin "$E34_REMOTE"
(cd "$E34_R" && "$AE" --worktree e34order &) 2>/dev/null
wait_for_session "e34order" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/e34order/meta" ]] && break; sleep 0.3; done
e34_wd="$(command grep '^work_dir=' "$HOME/.ae/sessions/e34order/meta" 2>/dev/null | cut -d= -f2-)"
assert_eq "end-order (#34): the worktree specimen launched" "1" \
    "$([[ -n "$e34_wd" && -d "$e34_wd" ]] && echo 1 || echo 0)"
if [[ -n "$e34_wd" && -d "$e34_wd" ]]; then
    git -C "$e34_wd" config user.email "test@test"
    git -C "$e34_wd" config user.name "test"
    e34_probe="$TMPDIR/e34-alive-at-snapshot"
    e34_hooks="$(git -C "$e34_wd" rev-parse --git-path hooks 2>/dev/null)"
    mkdir -p "$e34_hooks"
    cat >"$e34_hooks/post-commit" <<HOOK
#!/bin/sh
if tmux -L "$AE_TMUX_SERVER" has-session -t "=e34order" 2>/dev/null; then
    echo alive >"$e34_probe"
else
    echo gone >"$e34_probe"
fi
HOOK
    chmod +x "$e34_hooks/post-commit"
    # Ordinary work, so end has something to commit and the hook is reached at all.
    printf 'work\n' >"$e34_wd/agent-work.txt"
    "$AE" end -f e34order >/dev/null 2>&1 || true
    sleep 1
    # THE PROPERTY: at snapshot time the session is already gone, so nothing can
    # still be writing into the tree being committed. Red on the old order.
    assert_eq "end-order (#34): the session is already STOPPED when end takes its snapshot" "gone" \
        "$(cat "$e34_probe" 2>/dev/null || echo "hook-never-ran")"
    # ...control, so the seed cannot pass by the commit never happening.
    assert_eq "end-order (#34): the work reached the remote (the probe is live)" "1" \
        "$(git -C "$E34_REMOTE" log -1 --name-only --format= "ae/e34order" 2>/dev/null | command grep -qx 'agent-work.txt' && echo 1 || echo 0)"
    rm -f "$e34_probe"
fi
"$AE" end -f --assume-stopped e34order >/dev/null 2>&1 || true
rm -rf "$HOME/.ae/sessions/e34order" "$E34_REMOTE"
unset E34_R E34_REMOTE e34_wd e34_probe e34_hooks _i

# ── #34: a failed push leaves everything, and SAYS the session is stopped ──
# Before the reorder, "Session preserved" was accurate — the kill had not happened
# yet. After it, the same path leaves the session STOPPED, and "preserved" reads as
# "still running, go back to it". The message has to say which.
E34_R2="$(setup_repo)"
E34_REMOTE2="$TMPDIR/e34-remote2.git"
git -C "$E34_R2" clone -q --bare "$E34_R2" "$E34_REMOTE2" 2>/dev/null
git -C "$E34_R2" remote add origin "$E34_REMOTE2" 2>/dev/null || git -C "$E34_R2" remote set-url origin "$E34_REMOTE2"
# Refuse every push, deterministically — the same shape as a real pre-receive gate.
mkdir -p "$E34_REMOTE2/hooks"
printf '#!/bin/sh\necho "refused by policy" >&2\nexit 1\n' >"$E34_REMOTE2/hooks/pre-receive"
chmod +x "$E34_REMOTE2/hooks/pre-receive"
(cd "$E34_R2" && "$AE" --worktree e34push &) 2>/dev/null
wait_for_session "e34push" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/e34push/meta" ]] && break; sleep 0.3; done
e34_wd2="$(command grep '^work_dir=' "$HOME/.ae/sessions/e34push/meta" 2>/dev/null | cut -d= -f2-)"
assert_eq "end-push (#34): the worktree specimen launched" "1" \
    "$([[ -n "$e34_wd2" && -d "$e34_wd2" ]] && echo 1 || echo 0)"
if [[ -n "$e34_wd2" && -d "$e34_wd2" ]]; then
    git -C "$e34_wd2" config user.email "test@test"
    git -C "$e34_wd2" config user.name "test"
    printf 'work\n' >"$e34_wd2/agent-work.txt"
    if e34_out="$("$AE" end -f e34push 2>&1)"; then e34_rc=0; else e34_rc=$?; fi
    sleep 1
    assert_eq "end-push (#34): a refused push fails loudly" "1" \
        "$([[ "$e34_rc" -ne 0 ]] && echo 1 || echo 0)"
    # NOTHING is deleted: ae state and the working tree both survive.
    assert_eq "end-push (#34): ae state and the working tree are both preserved" "1|1" \
        "$(printf '%s|%s' \
            "$([[ -d "$HOME/.ae/sessions/e34push" ]] && echo 1 || echo 0)" \
            "$([[ -d "$e34_wd2" ]] && echo 1 || echo 0)")"
    # ...and the commit really is safe locally, which is what the message claims.
    assert_eq "end-push (#34): the work is committed locally despite the failed push" "1" \
        "$(git -C "$e34_wd2" log -1 --name-only --format= 2>/dev/null | command grep -qx 'agent-work.txt' && echo 1 || echo 0)"
    # THE MESSAGE: it must say STOPPED, must not claim the session is preserved as
    # if still running, and must name the resume path.
    assert_eq "end-push (#34): the message says STOPPED and names the resume" "1" \
        "$([[ "$e34_out" == *"session is STOPPED"* && "$e34_out" == *"nothing was deleted"* \
            && "$e34_out" == *"ae e34push"* && "$e34_out" != *"Session preserved"* ]] && echo 1 || echo 0)"
    # ...and it is telling the truth: the session really is gone.
    assert_eq "end-push (#34): the session really is stopped, not still running" "1" \
        "$(tmux has-session -t "=e34push" 2>/dev/null && echo 0 || echo 1)"
fi
"$AE" end -f --assume-stopped e34push >/dev/null 2>&1 || true
rm -rf "$HOME/.ae/sessions/e34push" "$E34_REMOTE2"
unset E34_R2 E34_REMOTE2 e34_wd2 e34_out e34_rc _i

# ── #36: launch-time delivery waits for READINESS, not for a clock ──────
# codex draws its input box before it can act on input — measured cold 2026-08-15:
# box at t=0.5s while the header still reads "model: loading", MCP servers still
# starting to t=2.5s, settled t=3.0s. The old readiness predicate answered READY from
# t=0.5s, so the bounded wait meant to protect the paste succeeded on its first poll.
#
# The seed uses a STUB tool that reproduces that shape deterministically and with no
# network: print a codex-shaped start-up screen, hold it, then settle. Asking the real
# predicate against a real pane is the point — a stubbed predicate would only test the
# stub.
r36_stub="$TMPDIR/slowtool.sh"
cat >"$r36_stub" <<'STUB'
#!/bin/sh
# Codex-shaped cold start, byte-faithful where it matters. The LIVE PROMPT is present
# in EVERY phase — bold U+203A then a DIM placeholder, exactly as captured from
# codex v0.147.0 — because that is the whole point: the input box looks ready the
# entire time, and only the START-UP markers tell the phases apart. A stub that drew
# a plain ASCII '>' proved nothing; the sensor found no live prompt and said
# indeterminate, which was the sensor being right about an unfaithful specimen.
prompt() {
    printf '\033[1m\342\200\272\033[0m \033[2mWrite tests for @filename\033[0m\n'
    printf '\n  \033[2mstub-model xhigh \302\267 /tmp\033[0m\n'
}
printf '\033[2J\033[H'
printf '\342\224\202 >_ OpenAI Codex (v0.147.0)              \342\224\202\n'
printf '\342\224\202 model:       loading   /model to change \342\224\202\n\n'
prompt
sleep 3
printf '\033[2J\033[H'
printf '\342\224\202 model:       stub-model xhigh   /model to change \342\224\202\n\n'
printf '\342\200\242 Starting MCP servers (0/7): alpha, beta\n\n'
prompt
sleep 3
printf '\033[2J\033[H'
printf '\342\224\202 model:       stub-model xhigh   /model to change \342\224\202\n\n'
prompt
while :; do sleep 5; done
STUB
chmod +x "$r36_stub"
tmux new-window -d -t "$AE_TMUX_SERVER:" -n r36 "$r36_stub" 2>/dev/null ||
    tmux new-session -d -s r36probe "$r36_stub" 2>/dev/null
r36_pane="$(tmux list-panes -a -F '#{pane_id} #{window_name}' 2>/dev/null | awk '$2=="r36"{print $1; exit}')"
if [[ -z "$r36_pane" ]]; then
    r36_pane="$(tmux list-panes -t r36probe -F '#{pane_id}' 2>/dev/null | head -1)"
fi
assert_eq "readiness (#36): the delayed-start stub pane exists" "1" \
    "$([[ -n "$r36_pane" ]] && echo 1 || echo 0)"
if [[ -n "$r36_pane" ]]; then
    # Drive ae's REAL predicate. Sampled across the stub's three phases; the verdict
    # must be NOT-READY while a start-up marker is on screen and READY once it clears.
    # The predicate is eval'd from ae rather than reached through a new subcommand:
    # adding `ae _readiness-probe` would be product surface existing only for this
    # test. What integration contributes over the unit fixtures is a REAL pane and a
    # REAL capture-pane — the suite's own tmux() already targets the test server, so
    # the sensor reads exactly what ae would read.
    r36_src="$(cat "$AE")"
    for _f in _capture_input_region _sgr_parse _input_region_prompt_seg \
        _input_region_is_border _input_region_content_end _input_region_occupied \
        _paste_input_busy _tool_initializing _spawn_input_ready; do
        eval "$(awk -v f="^${_f}\\(\\)" '$0 ~ f,/^\}$/' <<<"$r36_src")"
    done
    r36_probe() {
        if _spawn_input_ready "$1" codex; then echo READY; else echo NOTREADY; fi
    }
    sleep 1
    r36_early="$(r36_probe "$r36_pane")"
    sleep 3.5
    r36_mid="$(r36_probe "$r36_pane")"
    sleep 3.5
    r36_late="$(r36_probe "$r36_pane")"
    assert_eq "readiness (#36): 'model: loading' is NOT ready" "NOTREADY" "$r36_early"
    assert_eq "readiness (#36): an MCP start-up progress line is NOT ready" "NOTREADY" "$r36_mid"
    assert_eq "readiness (#36): the settled screen IS ready" "READY" "$r36_late"
    tmux kill-pane -t "$r36_pane" 2>/dev/null || true
fi
tmux kill-session -t r36probe 2>/dev/null || true
rm -f "$r36_stub"
unset r36_stub r36_pane r36_early r36_mid r36_late r36_src _f

# ── #30: a resumed pane reports the TOOL, not bash ───────────────────
# The acceptance measurement from the issue, run against real panes with a stub
# "tool" so no agent is involved — the question is process shape, not behaviour.
R30_SRV="ae-r30-$$"
# The suite's own interpreter, absolute. A hardcoded /opt/homebrew/bin/bash cannot
# run on the Linux/WSL half of ae's supported ground.
R30_SH="$BASH"
mkdir -p "$TMPDIR/r30" && : >"$TMPDIR/r30/present"
r30_dec() { # <probe> -> the decider command, built by ae's OWN function
    # shellcheck disable=SC2016  # deliberate: $1/$2 are the INNER shell's positional
    # args (ae's path and the probe), passed after the `_` below — not ours to expand.
    "$R30_SH" -c 'eval "$(awk "/^_launch_resume_decider\(\) \{/,/^\}\$/" "$1")"
        _launch_resume_decider "$2" "sleep 300" "sleep 301"' _ "$AE" "$1"
}
r30_hit="$(r30_dec "test -f $TMPDIR/r30/present")"
r30_miss="$(r30_dec "test -f $TMPDIR/r30/absent")"
command tmux -L "$R30_SRV" new-session -d -s s -n boot "$R30_SH -lc 'sleep 300'" 2>/dev/null
# default-shell is AMBIENT — inherited from whoever started the server (fish on this
# box) — and tmux runs each window's command through it. A shell that does not
# exec-optimise reports ITSELF for every window, hit miss and chain alike, and the
# control stops discriminating without failing. Pin it to the suite's bash.
command tmux -L "$R30_SRV" set-option -g default-shell "$R30_SH" >/dev/null 2>&1 || true
command tmux -L "$R30_SRV" new-window -d -t s -n hit "$R30_SH -lc $(printf %q "$r30_hit")" 2>/dev/null
command tmux -L "$R30_SRV" new-window -d -t s -n miss "$R30_SH -lc $(printf %q "$r30_miss")" 2>/dev/null
command tmux -L "$R30_SRV" new-window -d -t s -n chain "$R30_SH -lc 'sleep 300 || sleep 301'" 2>/dev/null
sleep 3
r30_read() { command tmux -L "$R30_SRV" list-panes -a -F '#{window_name} #{pane_current_command}' 2>/dev/null | awk -v w="$1" '$1==w{print $2; exit}'; }
# PRECONDITION, asserted before anything is concluded from the two arms: this is the
# defect's own signature. If a chain does NOT report bash here, the environment cannot
# tell the shapes apart and green below would mean nothing.
assert_eq "resume (#30) PRECONDITION: a '||' chain reports bash in this environment" "bash" "$(r30_read chain)"
assert_eq "resume (#30): the probe-HIT branch reports the tool, not bash" "sleep" "$(r30_read hit)"
assert_eq "resume (#30): the probe-MISS branch reports the tool, not bash" "sleep" "$(r30_read miss)"
command tmux -L "$R30_SRV" kill-server 2>/dev/null || true
rm -rf "$TMPDIR/r30"
unset R30_SRV R30_SH r30_hit r30_miss

# ── #48: session archives, end to end ────────────────────────────────
# The unit suite proves the pieces against fixtures. This proves the LIFECYCLE: that a
# real session, ended for real, leaves an archive that validates — and that when it
# cannot, the session is still there.
A48_REPO="$(setup_repo)"
(cd "$A48_REPO" && "$AE" --local arch-keep &) 2>/dev/null
wait_for_session "arch-keep" 20
sleep 1
A48_META="$HOME/.ae/sessions/arch-keep"
A48_UUID="$(grep '^session_id=' "$A48_META/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]')"
"$A48_META/goal" "ship the archive" >/dev/null 2>&1 || true
"$A48_META/memo" add --topic handover "the next agent should read this" >/dev/null 2>&1 || true
"$A48_META/memo" add --topic arch "we chose the mkdir claim" >/dev/null 2>&1 || true
mkdir -p "$A48_META/messages"
printf 'the stored body of a request\n' >"$A48_META/messages/ae-48.ask.txt"
# A pending request and a replied one, written as the helpers write them.
cat >>"$A48_META/events.jsonl" <<EOF
{"ts":"2026-08-01T00:00:00Z","actor":"dummy:dummy","action":"ask","ref":"ae-48-open","target":"dummy:other","actor_slot":"main","target_slot":"worker.0","actor_session":"arch-keep","target_session":"arch-keep","summary":"still open","body_file":"$A48_META/messages/ae-48.ask.txt"}
{"ts":"2026-08-01T00:01:00Z","actor":"dummy:dummy","action":"ask","ref":"ae-48-done","target":"dummy:other","actor_slot":"main","target_slot":"worker.0","actor_session":"arch-keep","target_session":"arch-keep","summary":"answered one"}
{"ts":"2026-08-01T00:02:00Z","actor":"dummy:other","action":"reply","ref":"ae-48-done","target":"dummy:dummy","actor_slot":"worker.0","target_slot":"main","actor_session":"arch-keep","target_session":"arch-keep","summary":"here is the answer"}
EOF

# PREVIEW FIRST, on the LIVE session: it must change nothing.
# THE DIRECTORY HAS A SECOND WRITER. The session's own watchdog drops runtime files
# (.watchdog.pid today) whenever it starts or restarts, so diffing the WHOLE listing asks
# "did anything appear" when the question is "did PREVIEW write anything". That made a
# shipped read-only guarantee pass or fail on watchdog timing — measured on identical
# bytes: 760/0 in one run, 759/1 in another, differing only in when the watchdog blinked.
# THE RULE, not the symptom: session RUNTIME state is owned by the watchdog and is not
# preview's to write; preview's only possible writes are session CONTENT and archive
# artifacts. Excluding one filename would pass until the watchdog wrote a second one.
_a48_content_tree() { # the files preview could plausibly touch, watchdog runtime excluded
    (cd "$A48_META" && find . -type f -o -type d) |
        grep -vE '/\.watchdog[^/]*$|/\.[^/]*\.pid$|/\.[^/]*\.lock$' | LC_ALL=C sort
}
a48_tree_before="$(_a48_content_tree)"
a48_prev_out="$("$AE" archive preview arch-keep 2>"$TMPDIR/a48.err")"
assert_contains "archive-preview: stdout is the digest" "# ae session archive" "$a48_prev_out"
assert_contains "archive-preview: it renders the live session's goal" "ship the archive" "$a48_prev_out"
assert_contains "archive-preview: stderr says PREVIEW ONLY" \
    "PREVIEW ONLY — nothing was written and nothing was stopped." "$(cat "$TMPDIR/a48.err")"
assert_contains "archive-preview: stderr reports what would be archived, not the digest's size" \
    "selected files:" "$(cat "$TMPDIR/a48.err")"
assert_contains "archive-preview: stderr names the canonical archive id" "$A48_UUID" "$(cat "$TMPDIR/a48.err")"
assert_eq "archive-preview: it wrote nothing into the live session" "$a48_tree_before" "$(_a48_content_tree)"
# CONTROL ON THE FILTER ITSELF: it must exclude watchdog runtime and NOTHING ELSE. If it
# over-excluded, the comparison above would go blind to exactly the writes it exists to
# catch, and would pass no matter what preview did. So assert the session's real content
# is still inside the measured set.
assert_eq "archive-preview: (control) the filter still measures the session's content" "3" \
    "$(_a48_content_tree | grep -cE '/meta$|/memo\.tsv$|/events\.jsonl$' | tr -d '[:space:]')"
assert_not_exists "archive-preview: it published no archive for this session" "$HOME/.ae/archive/$A48_UUID"
assert_eq "archive-preview: and took no publisher claim" "0" \
    "$(find "$HOME/.ae/archive" -maxdepth 1 -name '.publishing.*' 2>/dev/null | grep -c . | tr -d '[:space:]')"
assert_eq "archive-preview: the session is still running" "0" "$(tmux has-session -t arch-keep 2>/dev/null; echo $?)"

# A FRESH AE_HOME is where the read-only contract is actually testable: ae publishes a
# default config on a config-less home, and that notice used to land on STDOUT — in front
# of the digest, for a command whose stdout IS the contract.
A48_FRESH="$TMPDIR/a48-freshhome"
mkdir -p "$A48_FRESH/sessions/pv/messages"
cat >"$A48_FRESH/sessions/pv/meta" <<EOF
mode=local
origin=$TMPDIR
session=pv
session_id=aaaabbbb-cccc-dddd-eeee-ffff00001111
work_dir=$TMPDIR
layout=vertical
agent.main=dummy:dummy:pending
agent_bin.main=bash
EOF
: >"$A48_FRESH/sessions/pv/memo.tsv"
: >"$A48_FRESH/sessions/pv/events.jsonl"
a48_fresh_out="$(AE_HOME="$A48_FRESH" "$AE" archive preview pv 2>"$TMPDIR/a48-fresh.err")"
assert_eq "archive-preview: on a config-less home, stdout still starts with the digest" \
    "# ae session archive" "$(printf '%s\n' "$a48_fresh_out" | head -1)"
assert_eq "archive-preview: and the bootstrap notice is NOT on stdout" "0" \
    "$(printf '%s\n' "$a48_fresh_out" | grep -c 'Created default config' | tr -d '[:space:]')"
assert_contains "archive-preview: it went to stderr, where diagnostics belong" \
    "Created default config" "$(cat "$TMPDIR/a48-fresh.err")"
# An invalid --from against that same fresh home: no session, no worktree, no tmux.
a48_fresh_rc=0
(cd "$A48_REPO" && AE_HOME="$A48_FRESH" _timeout 30 "$AE" --local freshchild --from deadbeef-dead-beef-dead-beefdeadbeef) >/dev/null 2>&1 || a48_fresh_rc=$?
assert_eq "lineage: an invalid --from on a fresh home refuses" "1" \
    "$([[ $a48_fresh_rc -ne 0 ]] && echo 1 || echo 0)"
assert_not_exists "lineage: and creates no session state there" "$A48_FRESH/sessions/freshchild"
assert_not_exists "lineage: and no worktree" "$A48_FRESH/worktrees/freshchild"
assert_eq "lineage: and no tmux session" "1" \
    "$(tmux has-session -t freshchild 2>/dev/null && echo 0 || echo 1)"
unset a48_fresh_out a48_fresh_rc

# END, keeping history: the archive is mandatory and must land.
a48_end="$("$AE" end -f --keep-history arch-keep 2>&1)"
A48_ARCH="$HOME/.ae/archive/$A48_UUID"
assert_contains "archive-end: the outcome names the canonical UUID" "Archived $A48_UUID" "$a48_end"
assert_contains "archive-end: and the absolute path" "$A48_ARCH" "$a48_end"
assert_contains "archive-end: and the file count and byte total" "file(s)," "$a48_end"
assert_eq "archive-end: the live session state is gone" "0" "$([[ -d "$A48_META" ]] && echo 1 || echo 0)"
assert_eq "archive-end: the archive holds exactly the whitelisted tree" \
"digest.md
events.jsonl
memo.tsv
messages
messages/ae-48.ask.txt
meta" "$(cd "$A48_ARCH" && find . -mindepth 1 | sed 's|^\./||' | LC_ALL=C sort)"
# The forbidden set, named rather than implied: helpers, launch scripts, provider SID
# scratch files, locks and the generated manifest are all EXECUTABLE or RUNTIME state.
a48_forbidden=""
for a48_f in send ask review reply requests state memo goal peek agents focus interrupt spawn retire _lib watchdog workspace.md meta.lock; do
