for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/insidesess/meta" ]] && break; sleep 0.3; done
assert_eq "launch-inside (4th B1): session landed on the FOREIGN server" "1" \
    "$(command tmux -L "$FOREIGN" has-session -t "=insidesess" 2>/dev/null && echo 1 || echo 0)"
# Resolved path: macOS /tmp is a symlink to /private/tmp, and ae records the
