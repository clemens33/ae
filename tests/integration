# GATE 2 — THE POST-HANDOVER REVALIDATION, DRIVEN RATHER THAN COUNTED. Confirmed
# necessary by mutation: short-circuiting `_compact_revalidate` for "after the handover
# wait" left the whole section green, so two structural call-site counts proved the code
# EXISTS and nothing proved it ACTS.
# THE WINDOW MOVED when the lifecycle lock was extended to span gate 1 through publication:
# holding the lock now blocks compact BEFORE gate 1, so a mutation lands on the FIRST gate
# and the arm would pass while testing the wrong one. The window that reaches gate 2 is the
# BOUNDED WAIT, which runs unlocked by design — so the identity changes while compact is
# waiting for a handover it will actually receive. The refusal text is what distinguishes
# the gates ("after the handover wait" cannot be produced by the first), so this arm cannot
# pass by catching the wrong one.
C48G_REPO="$(setup_repo)"
(cd "$C48G_REPO" && "$AE" --local comp-gate2 &) 2>/dev/null
wait_for_session "comp-gate2" 20
sleep 1
C48G_DIR="$HOME/.ae/sessions/comp-gate2"
C48G_PANE="$(grep '^main_pane=' "$C48G_DIR/meta" | cut -d= -f2- || true)"
(
    # PROVEN SHAPE, measured in isolation before being written here: satisfy the memo,
    # change the identity, THEN reply. The reply helper is unaffected by the id change
    # (it routes on the request's slot, not the session id), so the wait sees both facts
    # and SUCCEEDS — which is the only way execution reaches gate 2 at all — and gate 2
    # then reads an identity that no longer matches the frozen tuple. No lock and no sleep:
    # ordering the writes is what makes it deterministic, not timing them.
    for _c48g_i in $(seq 1 60); do
        # `|| true`: events.jsonl DOES NOT EXIST until compact publishes its first event,
        # and awk exits 2 on a missing file. Under the suite's `set -e` that failed
        # ASSIGNMENT killed this background subshell outright on its first iteration — so
        # the reply was never attempted, no log was written, and the only visible symptom
        # was compact reporting "the reply did not arrive" 40s later. A silent death in a
        # backgrounded fixture looks exactly like a product defect.
        _c48g_ref="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' \
            "$C48G_DIR/events.jsonl" 2>/dev/null | tail -1 || true)"
        [[ -n "$_c48g_ref" ]] && break
        sleep 0.5
    done
    "$C48G_DIR/memo" add --topic handover "handing over" >/dev/null 2>&1 || true
    # REPLY FIRST, THEN MUTATE — measured, not assumed. Replying AFTER the identity change
    # works on a quiet box but NOT in this suite: comp-wait's arm replies the same way and
    # passes here, and the only difference is the mutation preceding it. Ordering the reply
    # ahead of the mutation keeps the fixture on the path that is known to work under load,
    # and the mutation still lands before gate 2 because the handover wait polls on a 2s
    # cycle — so it is observed by the poll AFTER the writes, not between them.
    # (Retry: workaround for #69 — the dummy is a shell left BUSY executing the pasted ask,
    # so one delivery attempt is not reliable. Delete when the ignores-input dummy lands.)
    for _c48g_try in $(seq 1 12); do
        TMUX_PANE="$C48G_PANE" "$C48G_DIR/reply" "$_c48g_ref" 'handed over' \
            >>"$TMPDIR/c48g-reply.log" 2>&1 || true
        grep -q '"action":"reply"' "$C48G_DIR/events.jsonl" 2>/dev/null && break
        sleep 1
    done
    _sed_i -e "s|^session_id=.*|session_id=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee|" "$C48G_DIR/meta"
) &
c48g_rc=0
c48g="$( (cd "$C48G_REPO" && AE_COMPACT_HANDOVER_SECS=40 "$AE" compact -f comp-gate2) 2>&1 )" || c48g_rc=$?
wait || true
