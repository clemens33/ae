    sleep 0.3
done
assert_eq "doctor orphan: test-orphan is a confirmed stopped orphan (dead + dir present)" "1" \
    "$([[ -d "$HOME/.ae/sessions/test-orphan" ]] && ! tmux has-session -t "=test-orphan" 2>/dev/null && echo 1 || echo 0)"
(cd "$REPO10B" && "$AE" doctor > "$TMPDIR/doctor-orphan.out" 2>/dev/null)
doctor_orphan_out="$(cat "$TMPDIR/doctor-orphan.out")"
