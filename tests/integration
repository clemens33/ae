# ── #48 P3.3: archive publish routes through the pinned core; AE_CORE= falls back ──
if _itest_section '#48 P3.3: archive publish routes through the core, AE_CORE= falls back'; then
# The Rust core owns publication when a session pins one. This proves the LIFECYCLE
# routing: a real ended session reaches the core, bash consumes its path/files/bytes
# line into the "Archived" summary, and the override forces the reference bash body.
# It needs the built core; a tree without one skips loudly rather than passing hollow.
P33_CORE="${AE_CORE_BIN:-$(dirname "$AE")/target/debug/ae}"
if [[ -x "$P33_CORE" ]]; then
    P33_VER="$("$P33_CORE" --version 2>/dev/null | awk '{print $NF}')"
    P33_MARK="$TMPDIR/p33-core-invoked"
    P33_WRAP="$TMPDIR/p33-core-wrapper"
    # A logging wrapper: records an _archive-publish invocation, then execs the real
    # core — so routing is observable even though a core and bash archive are identical.
    # shellcheck disable=SC2016  # single quotes are REQUIRED: $1/$@ must reach the generated shim unexpanded
    printf '#!/bin/sh\ncase "$1" in _archive-publish) echo "$@" >> "%s";; esac\nexec "%s" "$@"\n' \
        "$P33_MARK" "$P33_CORE" > "$P33_WRAP"
    chmod +x "$P33_WRAP"
    : > "$P33_MARK"

