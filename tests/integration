# ASK THE CORE WHAT THE PANE GETS, THEN ENUMERATE. There is no launch script to read
# since slice Z2: a pane runs `<core> _run <dir> <slot>` and the tool's argv is composed
# in process. `_run --print` reports exactly that vector as one JSON line and does NOT
# write the started marker or exec anything, so it is the artifact this section is about.
# The pins below grep that line RAW, which is safe because everything they look for —
# the identity sentence, "REQUIRED RULES" — is plain ASCII that JSON does not escape;
# only newlines elsewhere in the context are. `head -1` is deliberately NOT used, because
# the failure worth catching is an artifact carrying its own identity FIRST and a second,
# wrong one after it.
_id59_print() { # <session-dir> <slot> -> the argv line _run --print emits
    local core
    core="$(command grep '^ae_core=' "$1/meta" 2>/dev/null | cut -d= -f2- || true)"
    [[ -n "$core" && -x "$core" ]] || return 0
    "$core" _run --print "$1" "$2" 2>/dev/null || true
    return 0
}
_id59_ids() { # <text> -> every identity sentence in it, one per line
    command grep -o 'You are agent [^(]*(slot [^)]*).' <<<"$1" || true
    return 0
}
_id59_n() { # <text> -> how many identity sentences it carries
    local v
    v="$(_id59_ids "$1")"
    if [[ -z "$v" ]]; then
        echo 0
        return 0
    fi
    printf '%s\n' "$v" | command grep -c '' | tr -d '[:space:]'
    return 0
}
_id59_singleton() { # <text> <expected> -> 1 iff EXACTLY one identity, and it is <expected>
    local n
    n="$(_id59_n "$1")"
    if [[ "$n" == "1" && "$(_id59_ids "$1")" == "$2" ]]; then echo 1; else echo 0; fi
    return 0
}

