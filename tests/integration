# hold the lock externally; end must refuse within its 15s wait (we hold for 20s)
( exec 9>"$HOME/.ae/sessions/.lifecycle.lksess.lock"; flock 9; sleep 20 ) &
LK_HOLDER=$!
sleep 0.5
if lk_out="$(AE_TMUX_SERVER="$LK" _timeout 25 "$AE" end -f lksess 2>&1)"; then lk_rc=0; else lk_rc=$?; fi
assert_eq "lifecycle-lock (11th B2): end refuses while the lock is held, state preserved" "1" \
    "$([[ $lk_rc -ne 0 && "$lk_out" == *"lifecycle operation"* && -d "$HOME/.ae/sessions/lksess" ]] && echo 1 || echo 0)"
kill "$LK_HOLDER" 2>/dev/null || true; wait "$LK_HOLDER" 2>/dev/null || true
for _i in $(seq 1 15); do
    command tmux -L "$LK" has-session -t "=lksess" 2>/dev/null || break
    AE_TMUX_SERVER="$LK" "$AE" end -f lksess >/dev/null 2>&1 || true
