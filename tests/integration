P5I_PAT="${P5I_REST#*.}"
P5I_VER2="${P5I_MAJ}.${P5I_MIN}.$((P5I_PAT + 1))"
P5I_VER3="${P5I_MAJ}.${P5I_MIN}.$((P5I_PAT + 2))"
