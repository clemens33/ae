if _itest_section '#48: session archives, end to end'; then
# The unit suite proves the pieces against fixtures. This proves the LIFECYCLE: that a
# real session, ended for real, leaves an archive that validates — and that when it
# cannot, the session is still there.
A48_REPO="$(setup_repo)"
(cd "$A48_REPO" && "$AE" --local arch-keep &) 2>/dev/null
wait_for_session "arch-keep" 20
sleep 1
A48_META="$HOME/.ae/sessions/arch-keep"
A48_UUID="$(grep '^session_id=' "$A48_META/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
"$A48_META/goal" "ship the archive" >/dev/null 2>&1 || true
"$A48_META/memo" add --topic handover "the next agent should read this" >/dev/null 2>&1 || true
"$A48_META/memo" add --topic arch "we chose the mkdir claim" >/dev/null 2>&1 || true
mkdir -p "$A48_META/messages"
printf 'the stored body of a request\n' >"$A48_META/messages/ae-48.ask.txt"
# A pending request and a replied one, written as the helpers write them.
cat >>"$A48_META/events.jsonl" <<EOF
{"ts":"2026-08-01T00:00:00Z","actor":"dummy","action":"ask","ref":"ae-48-open","target":"other","actor_slot":"main","target_slot":"worker.0","actor_session":"arch-keep","target_session":"arch-keep","summary":"still open","body_file":"$A48_META/messages/ae-48.ask.txt"}
{"ts":"2026-08-01T00:01:00Z","actor":"dummy","action":"ask","ref":"ae-48-done","target":"other","actor_slot":"main","target_slot":"worker.0","actor_session":"arch-keep","target_session":"arch-keep","summary":"answered one"}
{"ts":"2026-08-01T00:02:00Z","actor":"other","action":"reply","ref":"ae-48-done","target":"dummy","actor_slot":"worker.0","target_slot":"main","actor_session":"arch-keep","target_session":"arch-keep","summary":"here is the answer"}
EOF

# PREVIEW FIRST, on the LIVE session: it must change nothing.
# THE DIRECTORY HAS A SECOND WRITER. The session's own watchdog drops runtime files
# (.watchdog.pid today) whenever it starts or restarts, so diffing the WHOLE listing asks
# "did anything appear" when the question is "did PREVIEW write anything". That made a
# shipped read-only guarantee pass or fail on watchdog timing — measured on identical
# bytes: 760/0 in one run, 759/1 in another, differing only in when the watchdog blinked.
# THE RULE, not the symptom: session RUNTIME state is owned by the watchdog and is not
# preview's to write; preview's only possible writes are session CONTENT and archive
# artifacts. Excluding one filename would pass until the watchdog wrote a second one.
_a48_content_tree() { # the files preview could plausibly touch, watchdog runtime excluded
    (cd "$A48_META" && find . -type f -o -type d) |
        grep -vE '/\.watchdog[^/]*$|/\.[^/]*\.pid$|/\.[^/]*\.lock$' | LC_ALL=C sort
}
a48_tree_before="$(_a48_content_tree)"
a48_prev_out="$("$AE" archive preview arch-keep 2>"$TMPDIR/a48.err")"
assert_contains "archive-preview: stdout is the digest" "# ae session archive" "$a48_prev_out"
assert_contains "archive-preview: it renders the live session's goal" "ship the archive" "$a48_prev_out"
assert_contains "archive-preview: stderr says PREVIEW ONLY" \
    "PREVIEW ONLY — nothing was written and nothing was stopped." "$(cat "$TMPDIR/a48.err")"
assert_contains "archive-preview: stderr reports what would be archived, not the digest's size" \
    "selected files:" "$(cat "$TMPDIR/a48.err")"
assert_contains "archive-preview: stderr names the canonical archive id" "$A48_UUID" "$(cat "$TMPDIR/a48.err")"
assert_eq "archive-preview: it wrote nothing into the live session" "$a48_tree_before" "$(_a48_content_tree)"
# CONTROL ON THE FILTER ITSELF: it must exclude watchdog runtime and NOTHING ELSE. If it
# over-excluded, the comparison above would go blind to exactly the writes it exists to
# catch, and would pass no matter what preview did. So assert the session's real content
# is still inside the measured set.
assert_eq "archive-preview: (control) the filter still measures the session's content" "3" \
    "$(_a48_content_tree | grep -cE '/meta$|/memo\.tsv$|/events\.jsonl$' | tr -d '[:space:]')"
assert_not_exists "archive-preview: it published no archive for this session" "$HOME/.ae/archive/$A48_UUID"
assert_eq "archive-preview: and took no publisher claim" "0" \
    "$(find "$HOME/.ae/archive" -maxdepth 1 -name '.publishing.*' 2>/dev/null | grep -c . | tr -d '[:space:]')"
assert_eq "archive-preview: the session is still running" "0" "$(tmux has-session -t arch-keep 2>/dev/null; echo $?)"

