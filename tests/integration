# and this section is about the aewatch retirement, not about coexistence. The
# harness exports AE_TMUX_SERVER for its own isolation, so it is cleared here
# deliberately rather than inherited by accident. The guard's own behaviour has
# its own section ("ae-next coexistence: Telegram ownership guard").
unset AE_TMUX_SERVER
tmux() {
    case "\$1" in
        list-sessions) [[ "$sidecar" == present ]] && echo ae-aewatch; return 0 ;;
