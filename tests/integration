assert_eq "archive-end: the archive root itself is 0700" "700" "$(stat -f '%Lp' "$HOME/.ae/archive" 2>/dev/null || stat -c '%a' "$HOME/.ae/archive")"
assert_eq "archive-end: no publisher claim is left behind" "0" \
