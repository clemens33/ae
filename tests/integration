# defect: if the reply never landed, compact's per-branch message says exactly that.
assert_contains "compact-gate2: (control) the handover completed, so the wait was passed" \
    "handover complete" "$c48g"
assert_eq "compact-gate2: an identity change during the unlocked wait is refused" "1" \
    "$([[ $c48g_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-gate2: and it is the SECOND gate that catches it" \
