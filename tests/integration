#!/usr/bin/env bash
# Integration tests for ae (requires tmux, git)
# Run: ./test-integration
# Uses an isolated tmux server and temp HOME — safe to run alongside real sessions.
set -euo pipefail

PASS=0
FAIL=0
ERRORS=()
AE="$(cd "$(dirname "$0")/.." && pwd)/ae"

# Isolated environment
TMPDIR="$(mktemp -d)"
export AE_TMUX_SERVER="ae-test-$$"
# Tripwire (2026-07-02 incident: the REAL ~/.ae/config was clobbered with a
# test fixture during a test window): fingerprint the real user's config
# BEFORE overriding HOME; cleanup screams and exits non-zero if it changed.
REAL_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
REAL_AE_CONFIG="${REAL_HOME}/.ae/config"
if [[ -f "$REAL_AE_CONFIG" ]]; then REAL_CONFIG_FPR="$(md5sum <"$REAL_AE_CONFIG")"; else REAL_CONFIG_FPR="absent"; fi
export HOME="$TMPDIR/home"
export AE_HOME="$HOME/.ae"
mkdir -p "$HOME/.ae"

cleanup() {
    command tmux -L "$AE_TMUX_SERVER" kill-server 2>/dev/null || true
    rm -rf "$TMPDIR"
    local now_fpr
    if [[ -f "$REAL_AE_CONFIG" ]]; then now_fpr="$(md5sum <"$REAL_AE_CONFIG")"; else now_fpr="absent"; fi
    if [[ "$now_fpr" != "$REAL_CONFIG_FPR" ]]; then
        echo "" >&2
        echo "FATAL: the REAL user config ($REAL_AE_CONFIG) CHANGED during this test run." >&2
        echo "A test escaped isolation. Investigate before trusting any results." >&2
        exit 97
    fi
}
trap cleanup EXIT

tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }

# Dummy agent config (bash as agent — no real AI tool needed)
cat > "$HOME/.ae/config" <<'EOF'
[agents]
dummy = "bash"
dummy2 = "bash"

[workspace]
main = dummy
layout = vertical
EOF

assert_eq() {
    local label="$1" expected="$2" actual="$3"
    if [[ "$expected" == "$actual" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected: \"$expected\"\n  actual:   \"$actual\"")
    fi
}

assert_contains() {
    local label="$1" needle="$2" haystack="$3"
    if [[ "$haystack" == *"$needle"* ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected to contain: \"$needle\"\n  actual: \"$haystack\"")
    fi
}

assert_not_exists() {
    local label="$1" path="$2"
    if [[ ! -e "$path" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected not to exist: $path")
    fi
}

setup_repo() {
    local dir="$TMPDIR/repo-$$-$RANDOM"
    mkdir -p "$dir"
    git -C "$dir" init -q
    git -C "$dir" config user.email "test@test"
    git -C "$dir" config user.name "test"
    git -C "$dir" commit -q --allow-empty -m "init"
    echo "$dir"
}

wait_for_session() {
    local name="$1" max="${2:-5}"
    local i=0
    while ! tmux has-session -t "$name" 2>/dev/null; do
        sleep 0.5
        i=$((i + 1))
        if (( i >= max * 2 )); then
            echo "Timeout waiting for session $name" >&2
            return 1
        fi
    done
}

# ── Test 1: Lifecycle — create, list, end ────────────────────────

REPO="$(setup_repo)"
(cd "$REPO" && "$AE" --local test-life &) 2>/dev/null
wait_for_session "test-life"
sleep 1  # let session setup complete (meta, manifest)

# Session should be running
assert_eq "lifecycle: tmux session exists" "0" "$(tmux has-session -t test-life 2>/dev/null; echo $?)"

# ae list should show it
list_output="$("$AE" list 2>/dev/null)"
assert_contains "lifecycle: list shows running" "test-life" "$list_output"
assert_contains "lifecycle: list shows running status" "running" "$list_output"

# Meta should exist
assert_eq "lifecycle: meta exists" "1" "$([[ -f "$HOME/.ae/sessions/test-life/meta" ]] && echo 1 || echo 0)"

# End should clean up
"$AE" end -f test-life 2>/dev/null || true
sleep 0.5
assert_eq "lifecycle: tmux session gone after end" "1" "$(tmux has-session -t test-life 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "lifecycle: session dir cleaned" "$HOME/.ae/sessions/test-life"

# ── Test 2: Resume detection ─────────────────────────────────────────

REPO2="$(setup_repo)"
(cd "$REPO2" && "$AE" --local test-resume &) 2>/dev/null
wait_for_session "test-resume"
sleep 1 # session setup writes meta shortly after tmux visibility (~200ms under load)

# Verify meta has session info
assert_eq "resume: meta created" "1" "$([[ -f "$HOME/.ae/sessions/test-resume/meta" ]] && echo 1 || echo 0)"

# Kill tmux session (simulate reboot)
tmux kill-session -t test-resume 2>/dev/null || true
sleep 0.5

# Meta should still exist (stopped session)
assert_eq "resume: meta survives tmux kill" "1" "$([[ -f "$HOME/.ae/sessions/test-resume/meta" ]] && echo 1 || echo 0)"

# ae list --all should show it as stopped (default view is running-only now)
list_output="$("$AE" list --all 2>/dev/null)"
assert_contains "resume: list --all shows stopped" "stopped" "$list_output"

# Re-launch should resume (reuse meta)
(cd "$REPO2" && "$AE" --local test-resume &) 2>/dev/null
wait_for_session "test-resume"
assert_eq "resume: session re-created" "0" "$(tmux has-session -t test-resume 2>/dev/null; echo $?)"

# Clean up
"$AE" end -f test-resume 2>/dev/null || true
sleep 0.5

# ── Test 2b: Rename moves session, window, and meta ──────────────────

REPO2B="$(setup_repo)"
(cd "$REPO2B" && "$AE" --local test-rename-old &) 2>/dev/null
wait_for_session "test-rename-old"
sleep 1 # session setup (window rename, meta write) completes shortly after visibility

# Window 0 is named after the session at creation.
assert_eq "rename: window 0 starts named after the session" "test-rename-old" \
    "$(tmux list-windows -t test-rename-old -F '#{window_index}:#{window_name}' 2>/dev/null | sed -n 's/^0://p')"

"$AE" rename test-rename-old test-rename-new 2>/dev/null
sleep 0.5

assert_eq "rename: tmux session renamed" "0" "$(tmux has-session -t test-rename-new 2>/dev/null; echo $?)"
assert_eq "rename: old tmux session gone" "1" "$(tmux has-session -t test-rename-old 2>/dev/null && echo 0 || echo 1)"
# The regression: the main window must follow the rename, not keep the old name.
assert_eq "rename: window 0 follows the session rename" "test-rename-new" \
    "$(tmux list-windows -t test-rename-new -F '#{window_index}:#{window_name}' 2>/dev/null | sed -n 's/^0://p')"
assert_eq "rename: meta session= updated" "1" \
    "$(grep -qx 'session=test-rename-new' "$HOME/.ae/sessions/test-rename-new/meta" && echo 1 || echo 0)"
assert_not_exists "rename: old session dir moved" "$HOME/.ae/sessions/test-rename-old"

"$AE" end -f test-rename-new 2>/dev/null || true
sleep 0.5

# ── Test 3: Health check in list ─────────────────────────────────────

REPO3="$(setup_repo)"
(cd "$REPO3" && "$AE" --local test-health &) 2>/dev/null
wait_for_session "test-health"
sleep 1  # let agent (bash) start

# Agent is bash — health check sees shell = dead agent (correct behavior)
# Verify idle agent shows ! marker in agent detail row
list_output="$("$AE" list 2>/dev/null)"
assert_contains "health: idle agent shows ! marker" "!" "$list_output"
assert_contains "health: agent row shows name" "dummy" "$list_output"

# Clean up
"$AE" end -f test-health 2>/dev/null || true
sleep 0.5

# ── Test 3a: --active (recently-active filter) ───────────────────────

REPO3A="$(setup_repo)"
(cd "$REPO3A" && "$AE" --local test-active &) 2>/dev/null
wait_for_session "test-active"
sleep 1

# A freshly-created session is recently active → --active includes it.
assert_contains "active: fresh session shows in --active" "test-active" \
    "$("$AE" list --active 2>/dev/null)"
assert_contains "active: --busy alias works" "test-active" \
    "$("$AE" list --busy 2>/dev/null)"

# Backdate its activity well past the window → --active drops it, but the
# unfiltered list still shows it (it's still running).
ACTIVE_EVENTS="$HOME/.ae/sessions/test-active/events.jsonl"
touch "$ACTIVE_EVENTS" 2>/dev/null || true
touch -d "1 hour ago" "$ACTIVE_EVENTS" "$HOME/.ae/sessions/test-active/workspace.md" \
    "$HOME/.ae/sessions/test-active/meta" 2>/dev/null || true
assert_eq "active: stale session dropped from --active" "0" \
    "$("$AE" list --active 2>/dev/null | grep -c 'test-active')"
assert_contains "active: stale session still shown in plain list" "test-active" \
    "$("$AE" list 2>/dev/null)"

# Clean up
"$AE" end -f test-active 2>/dev/null || true
sleep 0.5

# ── Test 3b: state column + session attn marker in list ──────────────

REPO3B="$(setup_repo)"
(cd "$REPO3B" && "$AE" --local test-state &) 2>/dev/null
wait_for_session "test-state"
sleep 1

STATE_EVENTS="$HOME/.ae/sessions/test-state/events.jsonl"
# Discover the real main agent name (alias:name) from meta.
main_agent="$(sed -n 's/^agent.main=//p' "$HOME/.ae/sessions/test-state/meta" | cut -d: -f1,2)"

# Real agent declares working; a retired/stray actor declares waiting-user.
printf '{"ts":"2026-05-29T10:00:00Z","actor":"%s","action":"state","ref":"working","summary":"on it"}\n' "$main_agent" >>"$STATE_EVENTS"
printf '%s\n' '{"ts":"2026-05-29T10:01:00Z","actor":"dummy:ghost","action":"state","ref":"waiting-user","summary":"stale"}' >>"$STATE_EVENTS"

list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: list shows agent working state" "working" "$list_output"
# Regression (codex IMPORTANT): a stray/retired actor that is not a current
# agent must NOT raise the session attn marker.
assert_eq "state: stray actor does not raise attn marker" "0" \
    "$(echo "$list_output" | grep -c 'attn:')"

# When the real current agent goes waiting-user, attn must appear.
printf '{"ts":"2026-05-29T10:02:00Z","actor":"%s","action":"state","ref":"waiting-user","summary":"need you"}\n' "$main_agent" >>"$STATE_EVENTS"
list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: current agent waiting-user raises attn marker" "attn:waiting-user" "$list_output"

# --needs-me surfaces the waiting-user session.
assert_contains "list: --needs-me shows the waiting-user session" "test-state" \
    "$("$AE" list --needs-me 2>/dev/null)"

# --json digest: versioned wrapper + the running session with its agents.
json_out="$("$AE" list --json 2>/dev/null)"
assert_contains "json: versioned wrapper" '"schema_version":1' "$json_out"
assert_contains "json: includes the running session" '"name":"test-state"' "$json_out"
assert_contains "json: marks it running" '"status":"running"' "$json_out"
assert_contains "json: has an agents array" '"agents":[' "$json_out"
# Strict parse when a JSON parser is available (no hard dependency).
if command -v python3 >/dev/null 2>&1; then
    assert_eq "json: output is valid JSON" "ok" \
        "$(printf '%s' "$json_out" | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
fi
# --needs-me --json: the waiting-user session appears with its attention reason.
needs_json="$("$AE" list --needs-me --json 2>/dev/null)"
assert_contains "json: --needs-me digest flags attention" '"attention":"waiting-user"' "$needs_json"
assert_contains "json: --needs-me digest marks needs_attention" '"needs_attention":true' "$needs_json"

# --needs-me implies running-only (codex IMPORTANT): combining with --all must
# not leak stopped rows. (test-resume from Test 2 is a stopped session here.)
allneeds_output="$("$AE" list --all --needs-me 2>/dev/null)"
assert_contains "list: --all --needs-me still shows the needing session" "test-state" "$allneeds_output"
assert_eq "list: --all --needs-me does not leak stopped rows" "0" \
    "$(echo "$allneeds_output" | grep -c 'stopped')"

# Once it goes back to working, --needs-me no longer lists it.
printf '{"ts":"2026-05-29T10:03:00Z","actor":"%s","action":"state","ref":"working","summary":"resumed"}\n' "$main_agent" >>"$STATE_EVENTS"
needs_output="$("$AE" list --needs-me 2>/dev/null)"
assert_eq "list: --needs-me drops the session once it is working again" "0" \
    "$(echo "$needs_output" | grep -c 'test-state')"

# Default view shows the running session.
assert_contains "list: default shows the running session" "test-state" \
    "$("$AE" list 2>/dev/null)"

# say helper: emits a chat event, preserving an embedded newline as escaped \n
# on a single JSON line (the events.jsonl one-object-per-line invariant).
state_main_pane="$(tmux list-panes -t test-state -F '#{pane_id} #{@ae_agent}' | awk -v a="$main_agent" '$2==a {print $1; exit}')"
TMUX_PANE="$state_main_pane" "$HOME/.ae/sessions/test-state/say" "$(printf 'hello from say\nsecond line')" >/dev/null 2>&1
say_line="$(tac "$STATE_EVENTS" 2>/dev/null | grep -m1 '"action":"chat"')"
assert_contains "say: emits a chat event" '"action":"chat"' "$say_line"
assert_contains "say: chat event carries the message" 'hello from say' "$say_line"
assert_contains "say: embedded newline kept as escaped \\n on one line" 'say\nsecond' "$say_line"
assert_eq "say: chat event is exactly one JSON line" "1" \
    "$(tac "$STATE_EVENTS" 2>/dev/null | grep -c '"action":"chat"')"

# Stop it (kill tmux session, keep meta) → default omits it, --all/--stopped include it.
tmux kill-session -t test-state 2>/dev/null || true
sleep 0.5
assert_eq "list: default hides the stopped session" "0" \
    "$("$AE" list 2>/dev/null | grep -c 'test-state')"
assert_contains "list: --all includes the stopped session" "test-state" \
    "$("$AE" list --all 2>/dev/null)"
assert_contains "list: --stopped includes the stopped session" "test-state" \
    "$("$AE" list --stopped 2>/dev/null)"
# --stopped --needs-me is running-only by implication → the now-stopped session
# is not shown (stopped sessions can't need you).
assert_eq "list: --stopped --needs-me does not show the stopped session" "0" \
    "$("$AE" list --stopped --needs-me 2>/dev/null | grep -c 'test-state')"

# --json over stopped/all sessions must stay valid JSON (regression for the
# set -u undeclared-map crash codex caught). A stopped session has agent rows.
assert_contains "json: --stopped digest includes the stopped session" '"name":"test-state"' \
    "$("$AE" list --stopped --json 2>/dev/null)"
assert_contains "json: stopped agents render alive false" '"alive":false' \
    "$("$AE" list --stopped --json 2>/dev/null)"
if command -v python3 >/dev/null 2>&1; then
    assert_eq "json: --stopped output is valid JSON" "ok" \
        "$("$AE" list --stopped --json 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
    assert_eq "json: --all output is valid JSON" "ok" \
        "$("$AE" list --all --json 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
fi

# Clean up
"$AE" end -f test-state 2>/dev/null || true
sleep 0.5

# ── Test 3c: derived rollup surfaces a watchdog alert (slice 2) ──────
# An agent with no declared state but a max-nudges alert from the watchdog must
# raise attn:stale — the rollup reuses the watchdog's own alert events.

REPO3C="$(setup_repo)"
(cd "$REPO3C" && "$AE" --local test-alert &) 2>/dev/null
wait_for_session "test-alert"
sleep 1

ALERT_EVENTS="$HOME/.ae/sessions/test-alert/events.jsonl"
alert_agent="$(sed -n 's/^agent.main=//p' "$HOME/.ae/sessions/test-alert/meta" | cut -d: -f1,2)"

# No declared state, but the watchdog raised a max-nudges alert → attn:stale.
printf '{"ts":"2026-05-29T11:00:00Z","actor":"watchdog","action":"alert","target":"%s","summary":"max nudges reached (idle 30m), needs attention"}\n' "$alert_agent" >>"$ALERT_EVENTS"
alert_output="$("$AE" list 2>/dev/null)"
assert_contains "rollup: max-nudges alert raises attn:stale" "attn:stale" "$alert_output"
assert_contains "rollup: --needs-me surfaces the stale (alerted) session" "test-alert" \
    "$("$AE" list --needs-me 2>/dev/null)"

# A newer activity event from the agent supersedes the alert → no longer attn.
printf '{"ts":"2026-05-29T11:05:00Z","actor":"%s","action":"state","ref":"working","summary":"resumed"}\n' "$alert_agent" >>"$ALERT_EVENTS"
assert_eq "rollup: newer activity clears the stale alert" "0" \
    "$("$AE" list --needs-me 2>/dev/null | grep -c 'test-alert')"

# Clean up
"$AE" end -f test-alert 2>/dev/null || true
sleep 0.5

# ── Test 3d: ae next — attention navigator (Layer 2, slice A) ────────
# `ae next` names the top-ranked running session needing attention, reusing the
# same rollup/ranking as `ae list`. Read-only (no tmux focus change).

REPO3D="$(setup_repo)"
(cd "$REPO3D" && "$AE" --local test-next &) 2>/dev/null
wait_for_session "test-next"
sleep 1
NEXT_EVENTS="$HOME/.ae/sessions/test-next/events.jsonl"
next_agent="$(sed -n 's/^agent.main=//p' "$HOME/.ae/sessions/test-next/meta" | cut -d: -f1,2)"

# No session needs attention yet → ae next exits non-zero with a clear message.
next_none_rc=0
next_none_out="$("$AE" next 2>&1)" || next_none_rc=$?
assert_eq "next: exits non-zero when nothing needs attention" "1" \
    "$([[ "$next_none_rc" -ne 0 ]] && echo 1 || echo 0)"
assert_contains "next: says nothing needs attention" "attention" "$next_none_out"

# --attach is accepted (not 'unknown arg') and guards on no-attention BEFORE any
# real tmux focus — so it exits non-zero with the no-attention message here, with
# nothing to attach to. (The happy-path switch/attach needs a live tmux client,
# so the inside/outside-tmux DECISION is unit-tested via _next_focus_argv; the
# thin exec is covered by manual QA — see the Layer-2 plan's test strategy.)
attach_none_rc=0
attach_none_out="$("$AE" next --attach 2>&1)" || attach_none_rc=$?
assert_eq "next: --attach with nothing-to-attend exits non-zero (no focus change)" "1" \
    "$([[ "$attach_none_rc" -ne 0 ]] && echo 1 || echo 0)"
assert_contains "next: --attach is parsed (no-attention message, not 'unknown arg')" "attention" "$attach_none_out"

# Declare waiting-user → ae next names that session + reason, exit 0.
printf '{"ts":"2026-06-15T12:00:00Z","actor":"%s","action":"state","ref":"waiting-user","summary":"need input"}\n' "$next_agent" >>"$NEXT_EVENTS"
next_rc=0
next_out="$("$AE" next 2>&1)" || next_rc=$?
assert_eq "next: exit 0 when an attention session exists" "0" "$next_rc"
assert_contains "next: names the attention session" "test-next" "$next_out"
assert_contains "next: shows the attention reason" "waiting-user" "$next_out"

# Read-only: ae next output must not advertise an attach/switch action.
assert_eq "next: output does not advertise attach (read-only)" "0" \
    "$(echo "$next_out" | grep -ci 'switch-client\|attach-session')"

# Arg handling (codex IMPORTANT): --help exits 0; unknown/unimplemented flags
# exit non-zero rather than silently behaving like plain `ae next`.
help_rc=0; help_out="$("$AE" next --help 2>&1)" || help_rc=$?
assert_eq "next: --help exits 0" "0" "$help_rc"
assert_contains "next: --help prints usage" "Usage: ae next" "$help_out"
bogus_rc=0; "$AE" next --bogus >/dev/null 2>&1 || bogus_rc=$?
assert_eq "next: unknown flag exits non-zero" "1" \
    "$([[ "$bogus_rc" -ne 0 ]] && echo 1 || echo 0)"

# Clean up
"$AE" end -f test-next 2>/dev/null || true
sleep 0.5

# NOTE: the watchdog's quiet-state behaviour (done/waiting-user/blocked
# suppression + the waiting-user/blocked pane-activity escape hatch) is covered
# by unit tests of the extracted decision functions (_agent_quiet_reason,
# _quiet_pane_decision) in tests/unit. A live-watchdog integration test is not
# practical here: the watchdog runs in a tmux split-window pane that inherits
# tmux's environment, so AE_WATCHDOG_* overrides set on the ae invocation do
# not reach it, leaving no way to drive a fast, deterministic cycle.

# ── Test 4: Spawn persistence ────────────────────────────────────────

REPO4="$(setup_repo)"
(cd "$REPO4" && "$AE" --local test-spawn &) 2>/dev/null
wait_for_session "test-spawn"
sleep 1

# Spawn a second agent
"$HOME/.ae/sessions/test-spawn/spawn" dummy2 "test prompt" 2>/dev/null || true
sleep 1

# Meta should have agent.spawned.0 in new unified format (alias:name:session_id)
spawned="$(grep '^agent\.spawned\.0=' "$HOME/.ae/sessions/test-spawn/meta" 2>/dev/null || echo "")"
assert_contains "spawn: recorded in meta" "agent.spawned.0=dummy2:helper-0:" "$spawned"

# Spawned worker lives in its OWN window (main window layout untouched):
# session-wide 2 agent panes, main window still 1, new window named after role.
pane_count="$(tmux list-panes -s -t test-spawn -F '#{@ae_agent}' 2>/dev/null | grep -c ':' || true)"
assert_eq "spawn: 2 agent panes session-wide after spawn" "2" "$pane_count"
main_win_panes="$(tmux list-windows -t test-spawn -F '#{window_name} #{window_panes}' 2>/dev/null | awk '$1=="test-spawn"{print $2; exit}' || true)"
assert_eq "spawn: main window keeps its single pane" "1" "$main_win_panes"
assert_contains "spawn: worker window named after its role" "helper-0" \
    "$(tmux list-windows -t test-spawn -F '#{window_name}' 2>/dev/null)"

# Alias-only helper resolution should target the unique spawned agent
"$HOME/.ae/sessions/test-spawn/send" dummy2 "printf 'alias-hit\n'" 2>/dev/null || true
sleep 0.5
spawn_output="$("$HOME/.ae/sessions/test-spawn/peek" dummy2 20 2>/dev/null || true)"
assert_contains "spawn: alias-only target resolves unique alias" "alias-hit" "$spawn_output"

# Shared memo helper should persist append-only shared context
"$HOME/.ae/sessions/test-spawn/memo" add --topic arch "use sqlite for the demo" 2>/dev/null || true
memo_output="$("$HOME/.ae/sessions/test-spawn/memo" read --topic arch 2>/dev/null || true)"
assert_contains "spawn: memo read shows topic entry" "use sqlite for the demo" "$memo_output"
assert_contains "spawn: memo read renders topic" "[arch]" "$memo_output"
memo_tail_output="$("$HOME/.ae/sessions/test-spawn/memo" tail 1 2>/dev/null || true)"
assert_contains "spawn: memo tail shows latest entry" "use sqlite for the demo" "$memo_tail_output"
assert_eq "spawn: memo file exists" "1" "$([[ -f "$HOME/.ae/sessions/test-spawn/memo.tsv" ]] && echo 1 || echo 0)"

# Request/reply tracking should use the invoking pane identity, not the active pane
main_pane="$(tmux list-panes -s -t test-spawn -F '#{pane_id} #{@ae_agent}' | awk '$2=="dummy:dummy"{print $1; exit}')"
worker_pane="$(tmux list-panes -s -t test-spawn -F '#{pane_id} #{@ae_agent}' | awk '$2=="dummy2:helper-0"{print $1; exit}')"
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/ask" dummy2 "check memo flow" 2>/dev/null || true
req_id="$(tac "$HOME/.ae/sessions/test-spawn/events.jsonl" 2>/dev/null | grep -m1 -E '"action":"(ask|review)"' | grep -oE '"ref":"[^"]+"' | cut -d'"' -f4)"
wrong_reply_status=0
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/reply" "$req_id" "wrong pane reply" >/dev/null 2>&1 || wrong_reply_status=$?
assert_eq "spawn: reply rejects wrong agent identity" "1" "$wrong_reply_status"
TMUX_PANE="$worker_pane" "$HOME/.ae/sessions/test-spawn/reply" "$req_id" "handled" >/dev/null 2>&1 || true
