git -C "$REPO_B2" remote add origin "$REMOTE_B2" 2>/dev/null || git -C "$REPO_B2" remote set-url origin "$REMOTE_B2"
(cd "$REPO_B2" && "$AE" --worktree wtend &) 2>/dev/null       # git/worktree target
wait_for_session "wtend"
(cd "$REPO_B2" && "$AE" --local wtendlocal &) 2>/dev/null      # LOCAL prefix-neighbor (wtend is a prefix)
