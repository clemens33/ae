# ── P1: `ae end` resolves the target BEFORE the destructive prompt ───
# shellcheck disable=SC2016 # the backticks are LITERAL text in a label, not
# a substitution: single quotes are the fix here, not the finding (see _itest_names).
if _itest_section 'P1: `ae end` resolves the target BEFORE the destructive prompt'; then
# Bug (Clemens 2026-07-21): `ae end <bogus>` PROMPTED the destructive confirm, then
# said "not found" after y. A nonexistent target must error with NO prompt. This is a
# CALLER PROBE (round-6 lesson: source text cannot prove a runtime order). Feed 'y' so
# that a lingering prompt WOULD consume it and proceed — a correct impl errors first.
# Capture output+rc WITHOUT aborting: these commands are EXPECTED to exit nonzero, and
# `x="$(cmd)"` under the suite's `set -euo pipefail` would take that nonzero and abort
# the whole run (AGENTS.md set-e hazard). The if/else keeps errexit from firing.
if end_bogus_out="$(printf 'y\n' | "$AE" end this-name-does-not-exist-xyz 2>&1)"; then
    end_bogus_rc=0
else
    end_bogus_rc=$?
fi
assert_eq "end bogus: exits nonzero" "1" "$([[ $end_bogus_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "end bogus: reports not found" "not found" "$end_bogus_out"
assert_eq "end bogus: does NOT prompt before resolving" "1" \
    "$([[ "$end_bogus_out" != *"Continue?"* && "$end_bogus_out" != *"Commits + pushes"* \
        && "$end_bogus_out" != *"Removes ae state"* ]] && echo 1 || echo 0)"
# Slash-bearing name → same not-found path, no prompt (traversal guard preserved).
if end_slash_out="$(printf 'y\n' | "$AE" end ../evil 2>&1)"; then
    end_slash_rc=0
else
    end_slash_rc=$?
fi
assert_eq "end slashed name: nonzero and no prompt" "1" \
    "$([[ $end_slash_rc -ne 0 && "$end_slash_out" != *"Continue?"* ]] && echo 1 || echo 0)"
fi

# ── P1 review B2: dot-component targets are rejected before any prompt ─
if _itest_section 'P1 review B2: dot-component targets are rejected before any prompt'; then
# `.` and `..` have no '/', so the slash guard alone accepted them and `ae end ..`
# prompted on `sessions/../` (a real dir → classified 'stopped'). Reject dot
# components at the same guard.
for dotname in . ..; do
    if end_dot_out="$(printf 'y\n' | "$AE" end "$dotname" 2>&1)"; then dot_rc=0; else dot_rc=$?; fi
    assert_eq "end '$dotname': nonzero and NO prompt (dot-component rejected)" "1" \
        "$([[ $dot_rc -ne 0 && "$end_dot_out" != *"Continue?"* && "$end_dot_out" != *"Removes ae state"* ]] && echo 1 || echo 0)"
done
fi

# ── P1 review B1: `ae end <prefix>` must not touch a live neighbour ───
# shellcheck disable=SC2016 # the backticks are LITERAL text in a label, not
# a substitution: single quotes are the fix here, not the finding (see _itest_names).
if _itest_section 'P1 review B1: `ae end <prefix>` must not touch a live neighbour'; then
# tmux -t PREFIX-MATCHES: with `lifeproj` live, `ae end lifepro` used to classify live
# (has-session -t lifepro matched lifeproj), prompt, and could kill lifeproj. Resolve
# the EXACT session id; a prefix that is not an exact session/dir is not-found.
REPO_B1="$(setup_repo)"
(cd "$REPO_B1" && "$AE" --local lifeproj &) 2>/dev/null
wait_for_session "lifeproj"
if end_pfx_out="$(printf 'y\n' | "$AE" end lifepro 2>&1)"; then end_pfx_rc=0; else end_pfx_rc=$?; fi
assert_eq "end prefix: 'lifepro' errors, no prompt (exact match required)" "1" \
    "$([[ $end_pfx_rc -ne 0 && "$end_pfx_out" != *"Continue?"* ]] && echo 1 || echo 0)"
assert_eq "end prefix: the live neighbour 'lifeproj' is STILL ALIVE (not prefix-killed)" "1" \
    "$(tmux has-session -t '=lifeproj' 2>/dev/null && echo 1 || echo 0)"
"$AE" end -f lifeproj 2>/dev/null || true
# Poll until fully torn down — a leaked lifeproj dir surfaces as an orphan in the
