    "pending  ask      canary-notyours" "$req_canary2"
unset REQ_HELPER req_canary req_canary2
# watchdog is declare-f generated too. A RUNNING watchdog keeps its loaded body
# until restarted — so smoke the regenerated artifact through a full
# stop → status → start → status cycle (real _lib, real panes). wd_poll/WD_HELPER
# were defined above (before the refresh) so the pid-change assertions could use
# them; the refresh already restarted it once, so it is running here.
assert_contains "doctor-refresh: watchdog carries emitted main fn" \
    "helper_watchdog_main" "$(cat "$WD_HELPER")"
wd_poll "$WD_HELPER" "is running" 20 || true # settle the launch autostart
"$WD_HELPER" stop >/dev/null 2>&1 || true
wd_poll "$WD_HELPER" "not running" 20 || true
assert_contains "doctor-refresh: regenerated watchdog status reports stopped" \
    "not running" "$("$WD_HELPER" status 2>&1 || true)"
"$WD_HELPER" start >/dev/null 2>&1 &
wd_poll "$WD_HELPER" "is running" 20 || true
assert_contains "doctor-refresh: regenerated watchdog starts and reports running" \
    "is running" "$("$WD_HELPER" status 2>&1 || true)"

# Clean up
"$AE" end -f test-sync 2>/dev/null || true
sleep 0.5
fi

# ── Test 11b: refresh must NOT stop a STOPPED session's stale-pid watchdog ──
if _itest_section 'Test 11b: refresh must NOT stop a STOPPED session'\''s stale-pid watchdog'; then
# The doctor --refresh liveness gate must veto the watchdog restart when the tmux
# side is gone, so a stale .watchdog.pid pointing at a recycled, unrelated live
# PID is never stopped/killed. (The status/start/stop root behavior — status must
# not lie, stop must not kill — is owned by Test 11d.)
REPO_STALE="$(setup_repo)"
(cd "$REPO_STALE" && "$AE" --local test-stale-wd &) 2>/dev/null
wait_for_session "test-stale-wd"
STALE_WD="$HOME/.ae/sessions/test-stale-wd/watchdog"
STALE_PIDFILE="$HOME/.ae/sessions/test-stale-wd/.watchdog.pid"
wd_poll "$STALE_WD" "is running" 20 || true # settle autostart before we kill it

# Stop the session at the tmux layer only — leave ~/.ae/sessions/test-stale-wd/
# (meta + generated helpers) on disk so doctor --refresh has something to refresh.
tmux kill-session -t test-stale-wd 2>/dev/null || true
sleep 0.5

# Fabricate the stale-pid hazard immediately before the refresh (no status
# preflight — that behavior is 11d's): a genuinely live, unrelated process whose
# PID is written into the watchdog pidfile.
sleep 300 &
dummy_pid=$!
printf '%s\n' "$dummy_pid" > "$STALE_PIDFILE"

(cd "$REPO_STALE" && "$AE" doctor --refresh test-stale-wd > "$TMPDIR/doctor-stale.out" 2>/dev/null)
stale_refresh_out="$(cat "$TMPDIR/doctor-stale.out")"

assert_eq "stale-wd: refresh did NOT kill the innocent recycled-pid process" \
    "1" "$(kill -0 "$dummy_pid" 2>/dev/null && echo 1 || echo 0)"
assert_eq "stale-wd: refresh did not announce a restart for a dead session" \
    "0" "$([[ "$stale_refresh_out" == *"restarted watchdog for test-stale-wd"* ]] && echo 1 || echo 0)"

kill "$dummy_pid" 2>/dev/null || true
"$AE" end -f test-stale-wd 2>/dev/null || true
rm -rf "$HOME/.ae/sessions/test-stale-wd" 2>/dev/null || true
sleep 0.5
fi

# ── Test 11c: resume trims events.jsonl to the newest AE_EVENTS_KEEP lines ──
if _itest_section 'Test 11c: resume trims events.jsonl to the newest AE_EVENTS_KEEP lines'; then
# The event log is append-only; a long-lived session accumulates it across every
# resume. Seed a stopped session with 1200 events, resume, and assert the log was
# capped to the newest 1000 (default) — oldest dropped, newest kept. Watchdog off
# so nothing appends after the trim and the count is deterministic.
REPO_EVR="$(setup_repo)"
(cd "$REPO_EVR" && "$AE" --local test-evretain &) 2>/dev/null
wait_for_session "test-evretain"
sleep 1
tmux kill-session -t test-evretain 2>/dev/null || true
sleep 0.5

EVR_EVENTS="$HOME/.ae/sessions/test-evretain/events.jsonl"
for n in $(seq 1 1200); do
    printf '{"ts":"2026-01-01T00:00:00Z","actor":"seed","action":"noop","summary":"seedmarker-%s"}\n' "$n"
done > "$EVR_EVENTS"
printf 'watchdog=false\n' >> "$HOME/.ae/sessions/test-evretain/meta"
assert_eq "events-retention: seeded 1200 events pre-resume" \
    "1200" "$(wc -l < "$EVR_EVENTS" | tr -d ' ')"

(cd "$REPO_EVR" && "$AE" --local test-evretain &) 2>/dev/null
wait_for_session "test-evretain"
# Trim runs during launch (before the events pane starts); poll until it lands.
for i in $(seq 1 20); do
    [[ "$(wc -l < "$EVR_EVENTS" 2>/dev/null || echo 0)" -le 1000 ]] && break
    sleep 0.5
done
evr_lines="$(wc -l < "$EVR_EVENTS" 2>/dev/null | tr -d ' ')"

assert_eq "events-retention: resume trimmed log to exactly 1000 lines" \
    "1000" "$evr_lines"
assert_eq "events-retention: newest event kept (seedmarker-1200)" \
    "1" "$(grep -q 'seedmarker-1200"' "$EVR_EVENTS" && echo 1 || echo 0)"
assert_eq "events-retention: oldest event trimmed away (seedmarker-1)" \
    "1" "$(grep -q 'seedmarker-1"' "$EVR_EVENTS" && echo 0 || echo 1)"
assert_eq "events-retention: newest-kept boundary present (seedmarker-201)" \
    "1" "$(grep -q 'seedmarker-201"' "$EVR_EVENTS" && echo 1 || echo 0)"
assert_eq "events-retention: oldest-dropped boundary gone (seedmarker-200)" \
    "1" "$(grep -q 'seedmarker-200"' "$EVR_EVENTS" && echo 0 || echo 1)"

"$AE" end -f test-evretain 2>/dev/null || true
rm -rf "$HOME/.ae/sessions/test-evretain" 2>/dev/null || true
sleep 0.5
fi

# ── Test 11d: watchdog status/start/stop reject a stale RECYCLED pid ──────
if _itest_section 'Test 11d: watchdog status/start/stop reject a stale RECYCLED pid'; then
# Root fix (beyond the doctor --refresh gate of 11b): _watchdog_is_running must
# require a live @ae_agent=_watchdog pane in its OWN session, not just a live pid.
# A stale .watchdog.pid pointing at a recycled, unrelated process must read as NOT
# running (status can't lie), must NOT be killed by stop, and must not make start
# wrongly defer. Exercised directly through the session's own watchdog helper.
REPO_WDR="$(setup_repo)"
(cd "$REPO_WDR" && "$AE" --local test-wd-root &) 2>/dev/null
wait_for_session "test-wd-root"
WDR="$HOME/.ae/sessions/test-wd-root/watchdog"
WDR_PID="$HOME/.ae/sessions/test-wd-root/.watchdog.pid"
wd_poll "$WDR" "is running" 20 || true            # settle the launch autostart
# Stop the watchdog: kills the _watchdog pane + pidfile, but the SESSION stays up.
"$WDR" stop >/dev/null 2>&1 || true
wd_poll "$WDR" "not running" 20 || true

# Fabricate the stale-recycled-pid hazard: a genuinely live, unrelated process
# whose pid we write into .watchdog.pid. There is NO _watchdog pane.
sleep 300 &
wdr_dummy=$!
printf '%s\n' "$wdr_dummy" > "$WDR_PID"

# (1) status must NOT lie: pid alive but no pane -> not running (+ cleans pidfile).
assert_contains "wd-root: status reports not-running on a recycled pid" \
    "not running" "$("$WDR" status 2>&1 || true)"
assert_eq "wd-root: status did NOT kill the innocent recycled process" \
    "1" "$(kill -0 "$wdr_dummy" 2>/dev/null && echo 1 || echo 0)"
assert_eq "wd-root: status cleaned the stale pidfile" \
    "1" "$([[ -f "$WDR_PID" ]] && echo 0 || echo 1)"

# (2) stop must NOT kill the recycled process (re-fabricate the stale pid).
printf '%s\n' "$wdr_dummy" > "$WDR_PID"
"$WDR" stop >/dev/null 2>&1 || true
assert_eq "wd-root: stop did NOT kill the innocent recycled process" \
    "1" "$(kill -0 "$wdr_dummy" 2>/dev/null && echo 1 || echo 0)"

# (3) start must NOT wrongly defer on a stale pid — it launches a fresh watchdog.
printf '%s\n' "$wdr_dummy" > "$WDR_PID"
"$WDR" start >/dev/null 2>&1 &
wd_poll "$WDR" "is running" 20 || true
assert_contains "wd-root: start launched a real watchdog (not deferred to stale pid)" \
    "is running" "$("$WDR" status 2>&1 || true)"
wdr_new="$(wd_pid "$WDR")"
assert_eq "wd-root: the running watchdog pid is NOT the recycled dummy" \
    "1" "$([[ -n "$wdr_new" && "$wdr_new" != "$wdr_dummy" ]] && echo 1 || echo 0)"

kill "$wdr_dummy" 2>/dev/null || true
"$AE" end -f test-wd-root 2>/dev/null || true
sleep 0.5
fi

# ── Test 11e: status bar is AE-OWNED — the watchdog never rewrites status-right ──
if _itest_section 'Test 11e: status bar is AE-OWNED — the watchdog never rewrites status-right'; then
# ae bakes '[<path><git>] [watch …]' once (_ae_apply_status_bar); the watchdog only
# feeds the @ae_watchdog_status user option. A stop/start cycle must leave the baked
# status-right byte-identical — the old save/prepend/restore (and its doubling bug)
# is structurally gone. The second status line carries the focused agent's identity.
REPO_WDD="$(setup_repo)"
(cd "$REPO_WDD" && "$AE" --local test-wd-own &) 2>/dev/null
wait_for_session "test-wd-own"
WDD="$HOME/.ae/sessions/test-wd-own/watchdog"
wd_poll "$WDD" "is running" 20 || true
wdo_sr0="$(tmux show-options -v -t test-wd-own status-right 2>/dev/null || true)"
assert_eq "status-bar: right is the ae-baked shape ([path…] + watch option at END)" \
    "1" "$([[ "$wdo_sr0" == "["*"] #{@ae_watchdog_status}" ]] && echo 1 || echo 0)"
assert_eq "status-bar: exactly ONE watch-option reference" \
    "1" "$(grep -oF '#{@ae_watchdog_status}' <<<"$wdo_sr0" | wc -l | tr -d ' ')"
assert_eq "status-bar: second line = focused agent identity" \
    "1" "$([[ "$(tmux show-options -v -t test-wd-own 'status-format[1]' 2>/dev/null)" == *'#{@ae_agent}'* ]] && echo 1 || echo 0)"
# Array-shadowing regression: session-scope [1] alone EMPTIES line 0 (tmux array
# options don't inherit per-index) — the standard bar must both exist at session
# scope AND actually RENDER non-empty (the live exhibit was two blank green lines).
assert_eq "status-bar: line 0 (standard bar) present at session scope" \
    "1" "$([[ -n "$(tmux show-options -v -t test-wd-own 'status-format[0]' 2>/dev/null)" ]] && echo 1 || echo 0)"
wdo_line0="$(tmux display-message -p -t test-wd-own:0 '#{T:status-format[0]}' 2>/dev/null || true)"
assert_eq "status-bar: line 0 RENDERS non-empty (bar visible, not a blank line)" \
    "1" "$([[ -n "$wdo_line0" && "$wdo_line0" == *"test-wd-own"* ]] && echo 1 || echo 0)"
"$WDD" stop >/dev/null 2>&1 || true
wd_poll "$WDD" "not running" 20 || true
"$WDD" start >/dev/null 2>&1 &
wd_poll "$WDD" "is running" 20 || true
wdo_sr1="$(tmux show-options -v -t test-wd-own status-right 2>/dev/null || true)"
assert_eq "status-bar: watchdog stop/start leaves status-right byte-identical" \
    "$wdo_sr0" "$wdo_sr1"
"$AE" end -f test-wd-own 2>/dev/null || true
sleep 0.5
fi

# ── Test 11f: agent roster (@ae_agents_status) with a LIVE watchdog ──
if _itest_section 'Test 11f: agent roster (@ae_agents_status) with a LIVE watchdog'; then
# The roster must be published by a real cycle (not just composable in a unit), must
# track a declared state change, and must be UNSET on stop — a frozen roster asserting
# a fleet that no longer exists is worse than no roster.
REPO_ROST="$(setup_repo)"
(cd "$REPO_ROST" && "$AE" --local test-roster &) 2>/dev/null
wait_for_session "test-roster"
ROSTD="$HOME/.ae/sessions/test-roster/watchdog"
wd_poll "$ROSTD" "is running" 20 || true
# Poll: the option appears once a cycle has judged the panes.
rost=""
for _i in $(seq 1 30); do
    rost="$(tmux show-options -v -t test-roster @ae_agents_status 2>/dev/null || true)"
    [[ -n "$rost" ]] && break
    sleep 1
done
assert_eq "roster: live watchdog publishes @ae_agents_status" "1" \
    "$([[ -n "$rost" ]] && echo 1 || echo 0)"
# Names render WITHOUT the alias prefix, and each carries exactly one verdict glyph.
assert_eq "roster: entry is '<name><glyph>' with no alias prefix" "1" \
    "$([[ "$rost" =~ ^[^:]*[●✔⏳⛔◌⚡✖·⚙] ]] && echo 1 || echo 0)"
assert_eq "roster: no alias prefix leaks into the bar" "1" \
    "$([[ "$rost" != *:* ]] && echo 1 || echo 0)"
# A declared 'done' must surface as ✔ — proves the roster reads the SAME verdicts the
# cycle already reaches, rather than re-deriving state of its own.
# The declaration must come FROM the agent's pane: `state` resolves its actor via
# ae_current_agent_ref -> #{@ae_agent} of TMUX_PANE, and _agent_quiet_reason only honours
# an agent's OWN declaration. Run from this test shell it would log actor=human and be
# correctly ignored — so set TMUX_PANE to the agent's pane and drive the real helper
# (no forged event: this is the same code path the agent itself runs).
ROST_PANE="$(tmux list-panes -s -t test-roster -F '#{pane_id} #{@ae_agent}' 2>/dev/null \
    | grep -v '_watchdog\|_events' | grep -E ' .+$' | head -1 | cut -d' ' -f1)"
assert_eq "roster: resolved an agent pane to declare from" "1" \
    "$([[ -n "$ROST_PANE" ]] && echo 1 || echo 0)"
# The watchdog cycles every AE_WATCHDOG_INTERVAL_SEC (default 60) and that env does NOT
# reach a tmux-spawned pane, so waiting for the NEXT cycle would mean a ~60s sleep here.
# Instead: stop, declare, restart. The verdict is derived from the EVENT LOG (durable),
# not from in-memory state, so the restarted watchdog's FIRST cycle already sees the
# declaration — same code path, seconds instead of a minute.
"$ROSTD" stop >/dev/null 2>&1 || true
wd_poll "$ROSTD" "not running" 20 || true
TMUX_PANE="$ROST_PANE" "$HOME/.ae/sessions/test-roster/state" "done" "roster integration probe" >/dev/null 2>&1 || true
"$ROSTD" start >/dev/null 2>&1 &
wd_poll "$ROSTD" "is running" 20 || true
rost_done=""
for _i in $(seq 1 30); do
    rost_done="$(tmux show-options -v -t test-roster @ae_agents_status 2>/dev/null || true)"
    [[ "$rost_done" == *"✔"* ]] && break
    sleep 1
done
assert_eq "roster: a declared done agent renders ✔" "1" \
    "$([[ "$rost_done" == *"✔"* ]] && echo 1 || echo 0)"
# status-format[1] carries identity + activity + roster.
rost_fmt="$(tmux show-options -v -t test-roster 'status-format[1]' 2>/dev/null || true)"
assert_eq "roster: line 1 wires identity and the roster" "1" \
    "$([[ "$rost_fmt" == *'#{@ae_agent}'* && "$rost_fmt" == *'#{@ae_agents_status}'* ]] && echo 1 || echo 0)"
# Line 0 must still render (array-shadowing regression guard, now with [1] extended).
rost_line0="$(tmux display-message -p -t test-roster:0 '#{T:status-format[0]}' 2>/dev/null || true)"
assert_eq "roster: line 0 still renders non-empty alongside the extended line 1" "1" \
    "$([[ -n "$rost_line0" && "$rost_line0" == *"test-roster"* ]] && echo 1 || echo 0)"
# PER-WINDOW glyphs: published window-scoped, and the window list must RENDER them.
# A source pin cannot prove tmux actually interpolates the option in window-status-format
# — only a render can (the array-shadowing blank-bar bug was invisible to source pins).
rost_wfmt="$(tmux show-options -v -t test-roster window-status-format 2>/dev/null || true)"
assert_eq "window: ae owns window-status-format at SESSION scope, keeping #F" "1" \
    "$([[ "$rost_wfmt" == '#I:#W#{@ae_window_status}#F' ]] && echo 1 || echo 0)"
assert_eq "window: current-format matches (the focused window is not left themeless)" "1" \
    "$([[ "$(tmux show-options -v -t test-roster window-status-current-format 2>/dev/null)" == '#I:#W#{@ae_window_status}#F' ]] && echo 1 || echo 0)"
# The GLOBAL format must be untouched — ae themes only its own sessions.
assert_eq "window: the GLOBAL window-status-format is not ae's (no theme leak)" "1" \
    "$([[ "$(tmux show-options -gv window-status-format 2>/dev/null)" != *'@ae_window_status'* ]] && echo 1 || echo 0)"
# Read back by WINDOW ID (@N), the same key the publisher uses — an index is a position
# and can renumber, which is exactly why the publisher stopped using it.
ROST_WID="$(tmux list-windows -t test-roster -F '#{window_id}' 2>/dev/null | head -1)"
rost_wopt=""
for _i in $(seq 1 30); do
    rost_wopt="$(tmux show-options -w -v -t "$ROST_WID" @ae_window_status 2>/dev/null || true)"
    [[ -n "$rost_wopt" ]] && break
    sleep 1
done
assert_eq "window: watchdog publishes a window-scoped @ae_window_status" "1" \
    "$([[ -n "$rost_wopt" ]] && echo 1 || echo 0)"
# RENDER: the window list, as tmux actually draws it, carries index:name + the glyph.
rost_wrender="$(tmux display-message -p -t test-roster:0 '#{W:#{E:window-status-format}}' 2>/dev/null || true)"
[[ -z "$rost_wrender" ]] && rost_wrender="$(tmux display-message -p -t test-roster:0 '#{E:window-status-format}' 2>/dev/null || true)"
assert_eq "window: the window list RENDERS the glyph (not just stores the option)" "1" \
    "$([[ "$rost_wrender" == *"$rost_wopt"* && "$rost_wrender" != *'@ae_window_status'* ]] && echo 1 || echo 0)"
# The monitor window holds only _watchdog/_events panes: it must render its NAME with no
# glyphs at all ('99:ae-monitor'), never '99:ae-monitor··'.
ROST_WID99="$(tmux list-windows -t test-roster -F '#{window_index} #{window_id}' 2>/dev/null | awk '$1==99{print $2}')"
assert_eq "window: the ae-monitor window carries NO glyphs (non-agent panes contribute none)" "" \
    "$(tmux show-options -w -v -t "${ROST_WID99:-test-roster:99}" @ae_window_status 2>/dev/null || true)"
# Stop clears it — session option AND every window option.
"$ROSTD" stop >/dev/null 2>&1 || true
wd_poll "$ROSTD" "not running" 20 || true
sleep 0.5
assert_eq "roster: @ae_agents_status unset on watchdog stop (no frozen fleet)" "" \
    "$(tmux show-options -v -t test-roster @ae_agents_status 2>/dev/null || true)"
assert_eq "window: @ae_window_status unset on stop for EVERY window (no frozen glyphs)" "" \
    "$(tmux list-windows -t test-roster -F '#{window_id}' 2>/dev/null \
        | while read -r _wi; do tmux show-options -w -v -t "$_wi" @ae_window_status 2>/dev/null || true; done | tr -d '\n')"
"$AE" end -f test-roster 2>/dev/null || true
sleep 0.5
fi
# ── input-region: REAL capture+sensor seam against live tmux (colead BLOCKER 2) ──
if _itest_section 'input-region: REAL capture+sensor seam against live tmux (colead BLOCKER 2)'; then
# The unit fixtures stub _capture_input_region, so they cannot prove GEOMETRY — the
# old source-text "geometry" assert was inert, and the old cy-8 look-back was an
# invented bound. Here the sensor runs against a REAL pane whose live prompt sits
# far ABOVE the cursor (a legal multiline input): with a fixed window the prompt is
# missed -> no live prompt -> post-submit maps that to clear -> FALSE SUCCESS, the
# silent loss this slice exists to kill. Capturing 0..cursor_y finds it.
eval "$(awk '/^_capture_input_region\(\) \{/,/^\}$/' "$AE")"
eval "$(awk '/^_sgr_parse\(\) \{/,/^\}$/' "$AE")"
eval "$(awk '/^_input_region_prompt_seg\(\) \{/,/^\}$/' "$AE")"
eval "$(awk '/^_input_region_is_border\(\) \{/,/^\}$/' "$AE")"
eval "$(awk '/^_input_region_content_end\(\) \{/,/^\}$/' "$AE")"
eval "$(awk '/^_input_region_occupied\(\) \{/,/^\}$/' "$AE")"
# The payload is the pane's OWN process (not typed into a shell): a shell would echo
# the command and redraw its prompt, polluting the region with an unstyled ornament.
ir_script="$TMPDIR/ir-geom.sh"
cat >"$ir_script" <<'IRSH'
printf '\033[1m›\033[0m AE_DIAG staged multiline\n'
for i in $(seq 1 12); do printf '  continuation row %s\n' "$i"; done
printf '  [Pasted Content 1016 chars][Pasted Content 1014 chars]'
sleep 300
IRSH
tmux kill-session -t ir-geom 2>/dev/null || true
tmux new-session -d -s ir-geom -x 80 -y 24 "bash $ir_script"
sleep 1
ir_pane="$(tmux list-panes -t ir-geom -F '#{pane_id}' 2>/dev/null | head -1)"
ir_cy="$(tmux display-message -p -t "$ir_pane" '#{cursor_y}' 2>/dev/null || echo 0)"
ir_region="$(_capture_input_region "$ir_pane")"
assert_eq "input-region: the live prompt really sits >8 rows above the cursor" "1" \
    "$([[ "$ir_cy" -gt 8 ]] && echo 1 || echo 0)"
assert_eq "input-region: real capture reaches that prompt (no invented look-back)" "1" \
    "$([[ "$ir_region" == *'›'* ]] && echo 1 || echo 0)"
ir_rc=0
_input_region_occupied "$ir_pane" codex || ir_rc=$?
assert_eq "input-region: real seam detects the staged multiline as OCCUPIED (not false-clear)" "0" "$ir_rc"
tmux kill-session -t ir-geom 2>/dev/null || true
rm -f "$ir_script"
fi

# ── input-region: CURSOR IS NOT THE REGION END (colead ROUND4 BLOCKER) ───────────
if _itest_section 'input-region: CURSOR IS NOT THE REGION END (colead ROUND4 BLOCKER)'; then
# cursor_y is the EDIT position, not the last row of the input. A multiline draft keeps
# real unsent rows BELOW the cursor after cursor navigation (or a leading blank line);
# bounding the capture at cursor_y dropped them, the sensor read IDLE, and the pre-paste
# guard would CLOBBER the draft. Reproduced on real tmux by colead: prompt on row 0,
# unsent continuation on row 1, cursor moved back to row 0 -> region held only the
# ornament row -> rc=1 (IDLE). This is that seam, with colead's required shape: a BLANK
# cursor row plus non-blank continuation below it.
ir2_script="$TMPDIR/ir-cursor.sh"
cat >"$ir2_script" <<'IRSH'
printf '\033[1m›\033[0m \n'                       # live prompt row, input BLANK
printf '  unsent continuation below cursor\n'     # real unsent input, BELOW the cursor
printf '\n'
printf '  gpt-5.6-sol xhigh \302\267 ~/projects/clemens33/ae\n'  # the codex footer (chrome)
printf '\033[H'                                   # park the edit cursor back on row 0
sleep 300
IRSH
tmux kill-session -t ir-cursor 2>/dev/null || true
tmux new-session -d -s ir-cursor -x 80 -y 24 "bash $ir2_script"
sleep 1
ir2_pane="$(tmux list-panes -t ir-cursor -F '#{pane_id}' 2>/dev/null | head -1)"
ir2_cy="$(tmux display-message -p -t "$ir2_pane" '#{cursor_y}' 2>/dev/null || echo 9)"
ir2_region="$(_capture_input_region "$ir2_pane")"
assert_eq "cursor-not-end: the cursor really sits ABOVE the unsent continuation" "1" \
    "$([[ "$ir2_cy" -lt 1 ]] && echo 1 || echo 0)"
assert_eq "cursor-not-end: region reaches rows BELOW the cursor (not -E cursor_y)" "1" \
    "$([[ "$ir2_region" == *'unsent continuation below cursor'* ]] && echo 1 || echo 0)"
ir2_rc=0
_input_region_occupied "$ir2_pane" codex || ir2_rc=$?
assert_eq "cursor-not-end: raw sensor reads OCCUPIED (draft below cursor is real input)" "0" "$ir2_rc"
# and the consumer that MATTERS for this blocker: pre-paste must refuse to clobber it
eval "$(awk '/^_paste_input_busy\(\) \{/,/^\}$/' "$AE")"
ir2_busy=0
_paste_input_busy "$ir2_pane" codex && ir2_busy=1
assert_eq "cursor-not-end: pre-paste consumer reads UNSAFE (no clobber of the draft)" "1" "$ir2_busy"
# The chrome bound must still hold on the same pane: the footer is NOT input content.
# (If it were counted, an idle pane would read OCCUPIED forever = the ri-3 send outage.)
tmux kill-session -t ir-cursor 2>/dev/null || true
ir3_script="$TMPDIR/ir-idle.sh"
cat >"$ir3_script" <<'IRSH'
printf '\033[1m›\033[0m \033[2mExplain this codebase\033[0m\n'   # idle: dim placeholder
printf '\n'
printf '  gpt-5.6-sol xhigh \302\267 ~/projects/clemens33/ae\n'  # footer chrome below
sleep 300
IRSH
tmux kill-session -t ir-idle 2>/dev/null || true
tmux new-session -d -s ir-idle -x 80 -y 24 "bash $ir3_script"
sleep 1
ir3_pane="$(tmux list-panes -t ir-idle -F '#{pane_id}' 2>/dev/null | head -1)"
ir3_rc=0
_input_region_occupied "$ir3_pane" codex || ir3_rc=$?
assert_eq "chrome-bound: real idle pane w/ footer below stays IDLE (no send outage)" "1" "$ir3_rc"
tmux kill-session -t ir-idle 2>/dev/null || true
rm -f "$ir2_script" "$ir3_script"
fi

