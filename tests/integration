assert_eq "launch-inside (4th B1): meta records the FOREIGN socket PATH + kind=socket" \
    "$(cd "$TMUX_SOCK_DIR" && pwd -P)/$FOREIGN|socket" \
    "$(sed -n 's/^tmux_server=//p' "$HOME/.ae/sessions/insidesess/meta" 2>/dev/null)|$(sed -n 's/^tmux_server_kind=//p' "$HOME/.ae/sessions/insidesess/meta" 2>/dev/null)"
# ...and an end from a PLAIN shell finds it there (the full round trip the lie broke).
for _i in $(seq 1 15); do
    command tmux -L "$FOREIGN" has-session -t "=insidesess" 2>/dev/null || break
    env -u AE_TMUX_SERVER "$AE" end -f insidesess >/dev/null 2>&1 || true
    sleep 0.4
