    sleep 1
    assert_eq "p3.6 setup: the worktree session records mode=git" "1" \
        "$(grep -qx 'mode=git' "$HOME/.ae/sessions/p36-wt/meta" && echo 1 || echo 0)"
    _p36_pin_core p36-wt
