assert_not_exists "launch-inside (4th B1): state removed" "$HOME/.ae/sessions/insidesess"
command tmux -L "$FOREIGN" kill-server 2>/dev/null || true
fi

# ── 5th review B1: -S socket vs same-basename -L server collision round-trip ──
if _itest_section '5th review B1: -S socket vs same-basename -L server collision round-trip'; then
# A `-S /path/collide.sock` server and a `-L collide.sock` server are DIFFERENT servers
# sharing a basename. The recorded identity must be the PATH: end the -S target, decoy
# on -L untouched — the old basename record killed the wrong-server lookup.
SC_NAME="aesc-$$-$RANDOM.sock"
SC_DIR="$SOCK_DIR/sprobe"; mkdir -p "$SC_DIR"; SC_PATH="$SC_DIR/$SC_NAME"
command tmux -S "$SC_PATH" new-session -d -s schost 2>/dev/null
command tmux -L "$SC_NAME" new-session -d -s decoyhost 2>/dev/null
REPO_SC="$(setup_repo)"
command tmux -S "$SC_PATH" send-keys -t schost \
    "cd '$REPO_SC' && env -u AE_TMUX_SERVER HOME='$HOME' AE_HOME='$HOME/.ae' '$AE' --local scoll >/dev/null 2>&1" Enter
for _i in $(seq 1 30); do command tmux -S "$SC_PATH" has-session -t "=scoll" 2>/dev/null && break; sleep 0.4; done
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/scoll/meta" ]] && break; sleep 0.3; done
assert_eq "S-collision (5th B1): meta records the -S socket PATH + kind=socket" "$SC_PATH|socket" \
    "$(sed -n 's/^tmux_server=//p' "$HOME/.ae/sessions/scoll/meta" 2>/dev/null)|$(sed -n 's/^tmux_server_kind=//p' "$HOME/.ae/sessions/scoll/meta" 2>/dev/null)"
# Retry budget cut 15 -> 3 on evidence (issue #4). This loop is the FOSSIL the
# issue cites: someone met the lifecycle race here and bounded it by calling
# `end` again until the tmux session went away. That mitigation covered tmux
# TEARDOWN but never asset GENERATION, which is why the session assertion below
# passed while the DIRECTORY assertion still failed intermittently.
#
# With the lock now held through session creation, this was measured at exactly
# ONE attempt on a loaded box (12 live sessions). The remaining budget is not
# for the race — that is fixed, and separately pinned by the race (#4) block
# below. What it still covers: `end` legitimately returning non-zero when it
# cannot take the lifecycle lock within flock's 15s, and tmux teardown latency
# on the foreign -S server. Three attempts is headroom for those; fifteen was
# headroom for a bug.
for _i in $(seq 1 3); do
    command tmux -S "$SC_PATH" has-session -t "=scoll" 2>/dev/null || break
    env -u AE_TMUX_SERVER "$AE" end -f scoll >/dev/null 2>&1 || true
    sleep 0.4
done
assert_eq "S-collision (5th B1): target killed on ITS -S server" "1" \
    "$(command tmux -S "$SC_PATH" has-session -t "=scoll" 2>/dev/null && echo 0 || echo 1)"
assert_eq "S-collision (5th B1): the same-basename -L decoy is UNTOUCHED" "1" \
    "$(command tmux -L "$SC_NAME" has-session -t "=decoyhost" 2>/dev/null && echo 1 || echo 0)"
assert_not_exists "S-collision (5th B1): state removed" "$HOME/.ae/sessions/scoll"
command tmux -S "$SC_PATH" kill-server 2>/dev/null || true
command tmux -L "$SC_NAME" kill-server 2>/dev/null || true
fi

# ── issue #4 BLOCKER: prompt-delivery children must not inherit fd 8 ──
if _itest_section 'issue #4 BLOCKER: prompt-delivery children must not inherit fd 8'; then
# send_agent_cmd's codex-resume branch spawns a subshell with `&` (the opencode branch
# did too until #53 moved its context to OPENCODE_CONFIG and deleted the paste)
# that sleeps 3s before pasting. A child INHERITS open descriptors, so while the
# lifecycle lock is held across agent launch those children kept it alive: the
# parent's `exec 8>&-` closes only its own copy, and a competing `ae end` blocked
# on a launch that had already finished.
#
# This is an EXECUTION probe, deliberately. The ordering assertions in
# tests/unit pin WHERE the release sits among the top-level call sites, and they
# pass the violating shape without complaint — position cannot see descriptor
# inheritance. Measured before the fix: competitor waited 3016ms (codex) and
# 3006ms (opencode, since retired); after: 4ms both.
if command -v flock >/dev/null 2>&1; then
    # codex only since #53: opencode's context rides OPENCODE_CONFIG as system-level
    # instructions, so it has no launch-time paste and therefore no backgrounded
    # delivery child to inherit fd 8. The loop is gone with it — one tool needs no
    # iteration, and a single-item loop is a lie about what varies. (Removing opencode
    # did not weaken this probe quietly: its extractor returned an EMPTY fragment and
    # took the whole suite down, which is the extractor working as designed.)
    _fdb=codex
    _FD_ROOT="$(mktemp -d "$TMPDIR/aefd.XXXXXX")"
    _FD_LOCK="$_FD_ROOT/lock"
    : >"$_FD_LOCK"
    # Scope to send_agent_cmd FIRST: ae mentions codex resume in more than one
    # place and the others have no subshell at all. Extracting one of those made an
    # earlier version of this probe pass against unfixed ae.
    #
    # ANCHORED ON THE DELIVERY CALL, not on a `case` label. The first version
    # matched the arm `        codex*resume*)`; when that classification moved into
    # an `if` — the built command can no longer be trusted to classify itself — the
    # extractor silently produced an EMPTY fragment, so the probe stopped testing
    # anything and took the suite down with it. What this probe is about is the
    # backgrounded subshell around _deliver_launch_prompt, so that is what it finds:
    # the enclosing `if [[ -n "$prompt" ]]` block, whatever encloses THAT.
    awk -v b="$_fdb" '
        /^send_agent_cmd\(\) \{/ { infn = 1 }
        infn && /if \[\[ -n "\$prompt" \]\]; then/ { buf = $0 "\n"; cap = 1; want = 0; next }
        infn && cap { buf = buf $0 "\n" }
        infn && cap && $0 ~ ("_deliver_launch_prompt \"\\$pane\" " b) { want = 1 }
        infn && cap && /^ *fi$/ { if (want) { printf "%s", buf; exit } cap = 0 }
    ' "$AE" >"$_FD_ROOT/branch.sh"
    assert_eq "fd8 probe ($_fdb): extracted a backgrounded subshell to test" "1" \
        "$(command grep -qF ') &' "$_FD_ROOT/branch.sh" && echo 1 || echo 0)"
    # The fragment is already a complete `if … fi`, so it runs as extracted.
    command cp "$_FD_ROOT/branch.sh" "$_FD_ROOT/body.sh"
    # Quoted heredoc: the branch body must NOT be expanded while writing this.
    #
    # THE CHILD MUST STAY ALIVE while containment is measured. Delivery is what
    # keeps it alive in production (a bounded readiness wait, then a paste); here it
    # blocks. Without meta_dir/slot defined and _deliver_launch_prompt stubbed, the
    # fragment aborted on the first unbound expansion under `set -u` — so the lock
    # came free because the child DIED, not because it closed fd 8, and this leg was
    # green against a product with `exec 8>&-` deleted. The control below is the
    # only reason we know it is not green like that again.
    cat >"$_FD_ROOT/run.sh" <<'FDSTUB'
set -uo pipefail
pane_current_command() { printf '%s' "$BRANCHNAME"; }
tmux() { :; }
tmux_paste_submit() { :; }
_deliver_launch_prompt() { sleep 3; }
pane="p"; prompt="x"; meta_dir="$FD_META"; slot="probe"
exec 8>"$LOCKPATH"
flock -n 8 || exit 2
source "$BODYFILE"
exec 8>&-
FDSTUB
    # The FACT is blocked-vs-immediate; the millisecond count was
    # ornamentation. EPOCHREALTIME is Bash 5 only and ae's floor is 4.0,
    # where under set -u reading it aborts unbound — so a short flock
    # timeout carries the whole assertion. The child sleeps 3s, so a
    # half-second budget cleanly separates "already free" from "still held".
    _fd_free() { # <body-file> <lock-file> -> 1 = free within the budget
        : >"$2"
        BRANCHNAME="$_fdb" LOCKPATH="$2" BODYFILE="$1" FD_META="$_FD_ROOT" \
            "${BASH:-bash}" "$_FD_ROOT/run.sh" >/dev/null 2>&1
        if flock -w 0.5 "$2" true 2>/dev/null; then echo 1; else echo 0; fi
    }
    assert_eq "fd8 ($_fdb): lock is free once send_agent_cmd returns (child closed fd 8)" "1" \
        "$(_fd_free "$_FD_ROOT/body.sh" "$_FD_ROOT/lock.real")"
    # MUTATION CONTROL, in the suite rather than in someone's head: strip the close
    # and the same probe must go RED. A guard never observed to fail is not a guard.
    command grep -v '^ *exec 8>&-$' "$_FD_ROOT/body.sh" >"$_FD_ROOT/body.mutant.sh"
    assert_eq "fd8 ($_fdb): the control fragment really lost its close" "1" \
        "$(command cmp -s "$_FD_ROOT/body.sh" "$_FD_ROOT/body.mutant.sh" && echo 0 || echo 1)"
    assert_eq "fd8 ($_fdb) CONTROL: without exec 8>&- the child holds the lock" "0" \
        "$(_fd_free "$_FD_ROOT/body.mutant.sh" "$_FD_ROOT/lock.mutant")"
    rm -rf "$_FD_ROOT"
else
    printf 'NOTE: fd8 inheritance probe SKIPPED — flock not available.\n' >&2
fi
fi

# ── issue #4: `ae end` racing a launch must not leave a recreated session ──
# shellcheck disable=SC2016 # the backticks are LITERAL text in a label, not
# a substitution: single quotes are the fix here, not the finding (see _itest_names).
if _itest_section 'issue #4: `ae end` racing a launch must not leave a recreated session'; then
# The lifecycle lock used to be released immediately after the meta mv, while
# ~20 helpers, the loop shim, workspace.md and launch.<slot>.sh were still being
# written. A concurrent `ae end` rm -rf'd the directory mid-generation and the
# next atomic temp+mv RECREATED it, so end returned 0 having left a partial
# session on disk. Proven by timestamp ordering before the fix: end-rm-begin
# landed 1.7s before the last asset write, and the directory came back carrying
# 22 artifacts.
#
# This DRIVES the race rather than waiting for it: launch in the background,
# wait only until meta exists — precisely as far as the old lock protected — and
# end at that instant. With the lock held through session creation, end blocks
# until the session is complete and then removes it.
#
# REPEATED on purpose. A single attempt is FLAKY: the first version of this test
# passed against unfixed ae, and only started failing when an unrelated debug
# line shifted the timing by a few milliseconds. One attempt proves nothing on a
# miss, so the assertion is over ALL attempts — every one of them must leave
# nothing behind, and on unfixed ae it takes only one hit to go red.
RACE_SURVIVORS=""
RACE_META_MISSES=0
RACE_INCONCLUSIVE=""
RACE_END_RC=0
for _rn in 1 2 3; do
    RACE_SESS="racefix-$$-${_rn}"
    RACE_WORK="$TMPDIR/racework-$$-${_rn}"
    mkdir -p "$RACE_WORK"
    (cd "$RACE_WORK" && AE_NO_AUTOSTART=1 "$AE" --local "$RACE_SESS" >/dev/null 2>&1) &
    RACE_LAUNCH_PID=$!
    for _i in $(seq 1 200); do
        [[ -f "$HOME/.ae/sessions/$RACE_SESS/meta" ]] && break
        sleep 0.05
    done
    [[ -f "$HOME/.ae/sessions/$RACE_SESS/meta" ]] || RACE_META_MISSES=$((RACE_META_MISSES + 1))
    # end's rc is LOAD-BEARING and must not be discarded. If post-meta work
    # outruns flock's 15s, end times out and PRESERVES the session by contract —
    # a correct refusal, not a race survivor. Treating those alike would make a
    # slow CI runner (issue #10's ubuntu box) indistinguishable from a
    # regression: the directory is legitimately still there, and a resurrection
    # check would call it a failure.
    # An if-condition, not a bare call: under the suite's set -e a nonzero `end`
    # aborts BEFORE the assignment, so RACE_END_RC is never set and the NOTE,
    # the cleanup and the all-inconclusive assertion below are all unreachable
    # on exactly the path they exist to handle. Same shape as the lexer status
    # capture — errexit is only suspended in a condition.
    if "$AE" end -f "$RACE_SESS" >/dev/null 2>&1; then
        RACE_END_RC=0
    else
        RACE_END_RC=$?
    fi
    wait "$RACE_LAUNCH_PID" 2>/dev/null || true
    # Grace for any generation still in flight to recreate the directory.
    # Before the fix it needed none — the writes were already running.
    sleep 1
    if ((RACE_END_RC != 0)); then
        # end declined (almost certainly the lock timeout). The session SHOULD
        # still exist — that is the state-preserving contract — so this attempt
        # proves nothing either way. Recorded as inconclusive, never counted as
        # a survivor and never silently passed.
        RACE_INCONCLUSIVE+="${_rn}:rc=${RACE_END_RC} "
    elif [[ -d "$HOME/.ae/sessions/$RACE_SESS" ]]; then
        _race_left=""
        for _rf in "$HOME/.ae/sessions/$RACE_SESS"/*; do
            [[ -e "$_rf" ]] || continue
            _race_left+="$(basename "$_rf") "
        done
        RACE_SURVIVORS+="${_rn}:[${_race_left}] "
    fi
    # Thorough teardown: this test deliberately launches real sessions, so an
    # incompletely-reaped one leaves the harness's own temp HOME non-empty and
    # its final rm -rf complains AFTER the summary line — green suite, noisy
    # exit. Kill the tmux session, let it die, then clear any residue.
    "$AE" end -f "$RACE_SESS" >/dev/null 2>&1 || true
    command tmux kill-session -t "=$RACE_SESS" 2>/dev/null || true
    for _k in 1 2 3 4 5; do
        command tmux has-session -t "=$RACE_SESS" 2>/dev/null || break
        sleep 0.2
    done
    rm -rf "$RACE_WORK" "$HOME/.ae/sessions/$RACE_SESS" 2>/dev/null || true
done
# Liveness: if the launch never reached meta, the race was never driven and a
# clean result would mean nothing.
assert_eq "race (#4): every attempt reached the meta write" "0" "$RACE_META_MISSES"
assert_eq "race (#4): no attempt leaves a session directory behind after a SUCCESSFUL end" \
    "" "$RACE_SURVIVORS"
# Inconclusive attempts are surfaced, not swallowed: if every attempt timed out
# the suite would otherwise report a clean race test having tested nothing.
[[ -z "$RACE_INCONCLUSIVE" ]] ||
    printf 'NOTE: race (#4) attempts inconclusive (end declined, session preserved by contract): %s\n' \
        "$RACE_INCONCLUSIVE" >&2
assert_eq "race (#4): at least one attempt actually completed an end" "1" \
    "$([[ "$(printf '%s' "$RACE_INCONCLUSIVE" | wc -w | tr -d ' ')" -lt 3 ]] && echo 1 || echo 0)"
fi

