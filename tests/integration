# ── session-shape: layout = lead-pair (colead seat in window 0, real tmux) ──
cat >"$HOME/.ae/config" <<'EOF'
[agents]
dummy = "bash"
dummy2 = "bash"
dummy3 = "bash"
dummy4 = "bash"

[workspace]
