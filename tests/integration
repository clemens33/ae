# ── Results ──────────────────────────────────────────────────────────

echo ""
if [[ ${#ERRORS[@]} -gt 0 ]]; then
    for err in "${ERRORS[@]}"; do
        echo -e "$err"
        echo ""
    done
fi
# A scoped result must never be readable as a full one (#64). The marker goes ON the
# counts line, not above it: `tail -1` is how a suite result reaches a report or a gate
# log, and a warning printed on the previous line is exactly the line that gets cut off.
# So the last line of a scoped run is never mistakable for the last line of a full one.
# The braces to the name-scan's belt. `_itest_names` reads the guard lines as TEXT, and
# B5's lesson is that text inside a heredoc body can be indistinguishable from the real
# thing — so a name could in principle be LISTED and selectable without any reachable
# guard behind it, and the run would report a serene "0 passed, 0 failed". This check
# does not care how that happens: if a filter was given and no section actually
# executed, the run failed to do what it was asked, and says so instead of going green.
if [[ -n "$_itest_filter" ]] && ((_ITEST_RAN_N == 0)); then
    echo "" >&2
    echo "FILTER SELECTED A NAME THAT NEVER RAN: '$_itest_filter' matched the section list," >&2
    echo "  but ZERO sections executed. Nothing was tested. This is reported as a failure" >&2
    echo "  rather than as '0 passed, 0 failed', which is indistinguishable from success." >&2
    exit 2
fi
if [[ -n "$_itest_filter" ]]; then
    echo "${PASS} passed, ${FAIL} failed" \
        "— SCOPED RUN (#64), filter '$_itest_filter': ${_ITEST_RAN_N} of $((_ITEST_RAN_N + _ITEST_SKIPPED_N)) sections ran," \
        "${_ITEST_SKIPPED_N} SKIPPED. NOT a full suite — gates run it unfiltered."
elif [[ -n "$_ITEST_FILTER_IGNORED" ]]; then
    # A full run, and the fact that it had to override an inherited filter belongs on
    # the line people read — otherwise the only trace is a warning far up the log.
    echo "${PASS} passed, ${FAIL} failed" \
        "— FULL RUN (every section); inherited filter '${_ITEST_FILTER_IGNORED}' was IGNORED."
else
    echo "${PASS} passed, ${FAIL} failed"
fi
[[ $FAIL -eq 0 ]] && exit 0 || exit 1
