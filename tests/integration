# GATE 2 — THE POST-HANDOVER REVALIDATION, DRIVEN RATHER THAN COUNTED. Confirmed
# necessary by mutation: short-circuiting `_compact_revalidate` for "after the handover
# wait" left the whole section green, so two structural call-site counts proved the code
# EXISTS and nothing proved it ACTS.
# THE WINDOW MOVED when the lifecycle lock was extended to span gate 1 through publication:
# holding the lock now blocks compact BEFORE gate 1, so a mutation lands on the FIRST gate
# and the arm would pass while testing the wrong one. The window that reaches gate 2 is the
# BOUNDED WAIT, which runs unlocked by design — so the identity changes while compact is
# waiting for a handover it will actually receive. The refusal text is what distinguishes
# the gates ("after the handover wait" cannot be produced by the first), so this arm cannot
# pass by catching the wrong one.
C48G_REPO="$(setup_repo)"
(cd "$C48G_REPO" && "$AE" --local comp-gate2 &) 2>/dev/null
wait_for_session "comp-gate2" 20
sleep 1
C48G_DIR="$HOME/.ae/sessions/comp-gate2"
C48G_PANE="$(grep '^main_pane=' "$C48G_DIR/meta" | cut -d= -f2- || true)"
(
    # PROVEN SHAPE, measured in isolation before being written here: satisfy the memo,
    # change the identity, THEN reply. The reply helper is unaffected by the id change
    # (it routes on the request's slot, not the session id), so the wait sees both facts
    # and SUCCEEDS — which is the only way execution reaches gate 2 at all — and gate 2
    # then reads an identity that no longer matches the frozen tuple. No lock and no sleep:
    # ordering the writes is what makes it deterministic, not timing them.
    for _c48g_i in $(seq 1 60); do
        # `|| true`: events.jsonl DOES NOT EXIST until compact publishes its first event,
        # and awk exits 2 on a missing file. Under the suite's `set -e` that failed
        # ASSIGNMENT killed this background subshell outright on its first iteration — so
        # the reply was never attempted, no log was written, and the only visible symptom
        # was compact reporting "the reply did not arrive" 40s later. A silent death in a
        # backgrounded fixture looks exactly like a product defect.
        _c48g_ref="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' \
            "$C48G_DIR/events.jsonl" 2>/dev/null | tail -1 || true)"
        [[ -n "$_c48g_ref" ]] && break
        sleep 0.5
    done
    "$C48G_DIR/memo" add --topic handover "handing over" >/dev/null 2>&1 || true
    # REPLY FIRST, THEN MUTATE — measured, not assumed. Replying AFTER the identity change
    # works on a quiet box but NOT in this suite: comp-wait's arm replies the same way and
    # passes here, and the only difference is the mutation preceding it. Ordering the reply
    # ahead of the mutation keeps the fixture on the path that is known to work under load,
    # and the mutation still lands before gate 2 because the handover wait polls on a 2s
    # cycle — so it is observed by the poll AFTER the writes, not between them.
    # (Retry: workaround for #69 — the dummy is a shell left BUSY executing the pasted ask,
    # so one delivery attempt is not reliable. Delete when the ignores-input dummy lands.)
    for _c48g_try in $(seq 1 12); do
        TMUX_PANE="$C48G_PANE" "$C48G_DIR/reply" "$_c48g_ref" 'handed over' \
            >>"$TMPDIR/c48g-reply.log" 2>&1 || true
        grep -q '"action":"reply"' "$C48G_DIR/events.jsonl" 2>/dev/null && break
        sleep 1
    done
    _sed_i -e "s|^session_id=.*|session_id=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee|" "$C48G_DIR/meta"
) &
c48g_rc=0
c48g="$( (cd "$C48G_REPO" && AE_COMPACT_HANDOVER_SECS=40 "$AE" compact -f comp-gate2) 2>&1 )" || c48g_rc=$?
wait || true
# CONTROL: the handover must actually have completed, or compact refused for the wrong
# reason and this arm never reached gate 2 at all.
# The control names the fixture's own failure so a red here is not mistaken for a product
# defect: if the reply never landed, compact's per-branch message says exactly that.
assert_contains "compact-gate2: (control) the handover completed, so the wait was passed" \
    "handover complete" "$c48g"
assert_eq "compact-gate2: an identity change during the unlocked wait is refused" "1" \
    "$([[ $c48g_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-gate2: and it is the SECOND gate that catches it" \
    "after the handover wait" "$c48g"
assert_contains "compact-gate2: naming the session it was authorized for" \
    "is not the session that was authorized" "$c48g"
assert_eq "compact-gate2: the replacement was never STOPPED" "0" \
    "$(tmux has-session -t comp-gate2 2>/dev/null; echo $?)"
assert_eq "compact-gate2: and nothing was archived under the id it was never authorized for" "0" \
    "$([[ -e "$HOME/.ae/archive/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" ]] && echo 1 || echo 0)"
_sed_i -e "s|^session_id=.*|session_id=cccccccc-dddd-eeee-ffff-000000000000|" "$C48G_DIR/meta"
"$AE" end -f --keep-history comp-gate2 >/dev/null 2>&1 || true
unset C48G_REPO C48G_DIR C48G_PANE c48g c48g_rc

# --keep-history MUST BE ABLE TO COMPLETE A COMPACT. The old arm was labelled "proceeds
# and seals keep" and proved NEITHER: with no -f it declined at the prompt, so its needle
# ("conversation files: kept") came from the FROZEN PRE-PROMPT FACTS while nothing
# proceeded and nothing was archived. It could not reach the code the override was broken
# in — _end_archive_plan re-derived the policy from live config and the byte-compare
# refused, so the documented escape hatch could never be used. This drives a REAL end
# against a purge-configured origin and asserts BOTH halves of that old label.
C48K_REPO="$(setup_repo)"
mkdir -p "$C48K_REPO/.ae"
printf '[workspace]\npurge_agent_history = true\n' >"$C48K_REPO/.ae/config"
(cd "$C48K_REPO" && "$AE" --local comp-keep &) 2>/dev/null
wait_for_session "comp-keep" 20
sleep 1
C48K_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-keep/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
c48k="$( (cd "$C48K_REPO" && "$AE" compact -f --digest-only --keep-history comp-keep) 2>&1 || true )"
sleep 3
assert_eq "compact-keep: --keep-history PROCEEDS — the archive is published" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48K_UUID}/digest.md" ]] && echo 1 || echo 0)"
assert_eq "compact-keep: and the source was really torn down and replaced" "1" \
    "$(grep -c "^parent_archive_id=${C48K_UUID}$" "$HOME/.ae/sessions/comp-keep/meta" 2>/dev/null | tr -d '[:space:]')"
assert_eq "compact-keep: with a live child under the same name" "0" \
    "$(tmux has-session -t comp-keep 2>/dev/null; echo $?)"
assert_contains "compact-keep: and keep was SEALED — the conversation files were not purged" \
    "kept agent conversation files" "$c48k"
assert_eq "compact-keep: the plan never flipped under the shared planner" "0" \
    "$(grep -c "changed since it was authorized" <<<"$c48k" | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-keep >/dev/null 2>&1 || true
unset C48K_REPO C48K_UUID c48k

# THE ROSTER IS AUTHORIZED, NOT MERELY RESOLVABLE. It is PRINTED at the prompt as what the
# child will start, so a config rewritten during the window must refuse — proving that
# SOME roster still resolves would let a child start agents nobody approved. Edits made
# BEFORE compact are still adopted; only a change DURING the window is refused.
C48R_REPO="$(setup_repo)"
mkdir -p "$C48R_REPO/.ae"
printf '[profiles]\ndummy = "bash"\n\n[roster]\ndummy = dummy\n\n[workspace]\nmain = dummy\n' >"$C48R_REPO/.ae/config"
(cd "$C48R_REPO" && "$AE" --local comp-roster &) 2>/dev/null
wait_for_session "comp-roster" 20
sleep 1
C48R_FIFO="$TMPDIR/c48r.fifo"; rm -f "$C48R_FIFO"; mkfifo "$C48R_FIFO"
(
    exec 3>"$C48R_FIFO"
    sleep 5   # the prompt is on screen, promising main=dummy
    printf '[profiles]\ndummy2 = "bash"\n\n[roster]\ndummy2 = dummy2\n\n[workspace]\nmain = dummy2\n' >"$C48R_REPO/.ae/config"
    printf 'y' >&3
    exec 3>&-
) &
c48r_rc=0
c48r="$( (cd "$C48R_REPO" && "$AE" compact --digest-only comp-roster <"$C48R_FIFO") 2>&1 )" || c48r_rc=$?
wait || true
rm -f "$C48R_FIFO"
assert_eq "compact-roster: a roster rewritten under the answer refuses" "1" \
    "$([[ $c48r_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-roster: and says the child would start something else" \
    "would now start a different roster than the one shown" "$c48r"
assert_contains "compact-roster: naming what was shown" "main=dummy" "$c48r"
assert_eq "compact-roster: nothing was stopped" "0" "$(tmux has-session -t comp-roster 2>/dev/null; echo $?)"
"$AE" end -f --keep-history comp-roster >/dev/null 2>&1 || true
unset C48R_REPO C48R_FIFO c48r c48r_rc

# THE CHILD STARTS WHAT WAS AUTHORIZED — PINNED AT THE CHILD, not at the gates. Both
# gates already refuse a config rewritten before them; the window they cannot cover opens
# AFTER the second gate, while the end is archiving and tearing down, and closes when the
# child launches. In that window the source session is already gone, so a child starting
# the wrong roster is unrecoverable. The rewrite is therefore timed to the ARCHIVE
# APPEARING, which happens after gate 2 and before the exec. A fix must be pinned at the
# point it claims to protect, not where it was convenient to observe.
C48S_REPO="$(setup_repo)"
mkdir -p "$C48S_REPO/.ae"
printf '[profiles]\ndummy = "bash"\ndummy2 = "bash"\n\n[roster]\ndummy = dummy\n\n[workspace]\nmain = dummy\n' >"$C48S_REPO/.ae/config"
(cd "$C48S_REPO" && "$AE" --local comp-snap &) 2>/dev/null
wait_for_session "comp-snap" 20
sleep 1
C48S_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-snap/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
(
    for _c48s_i in $(seq 1 160); do
        [[ -d "$HOME/.ae/archive/${C48S_UUID}" ]] && break
        sleep 0.25
    done
    printf '[profiles]\ndummy = "bash"\ndummy2 = "bash"\n\n[roster]\ndummy2 = dummy2\n\n[workspace]\nmain = dummy2\n' >"$C48S_REPO/.ae/config"
) &
(cd "$C48S_REPO" && "$AE" compact -f --digest-only comp-snap >/dev/null 2>&1) || true
wait || true
sleep 3
# THE CONTROL FIRST: if the rewrite did not land, everything below passes for free.
assert_eq "compact-snapshot: (control) the live config really was rewritten under the launch" "dummy2" \
    "$(sed -n 's/^main = *//p' "$C48S_REPO/.ae/config" | tail -1)"
assert_eq "compact-snapshot: the child starts the roster the human was SHOWN" "dummy" \
    "$(sed -n 's/^seat.main=//p' "$HOME/.ae/sessions/comp-snap/meta" 2>/dev/null)"
assert_eq "compact-snapshot: and it really is the child, not the survivor" "1" \
    "$(grep -c "^parent_archive_id=${C48S_UUID}$" "$HOME/.ae/sessions/comp-snap/meta" 2>/dev/null | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-snap >/dev/null 2>&1 || true
unset C48S_REPO C48S_UUID
export AE_CORE_BIN="$_ITEST_CORE_BIN"; unset _C48_CORE
fi  # ── P3.7 core-guard end ──
fi


# ── compact (c)+(d): it hands over, it ends, it comes back ─────────────────────
if _itest_section 'compact (c)+(d): it hands over, it ends, it comes back'; then

# ── P3.7 core-guard: compact is Rust-owned; bind the built core for this section ──
_C48_CORE="$(dirname "$AE")/target/debug/ae"
if [[ ! -x "$_C48_CORE" ]]; then
    echo "  SKIP (compact is Rust-owned): no built core at ${_C48_CORE} — build it first (cargo build)." >&2
else
export AE_CORE_BIN="$_C48_CORE"
# The happy path proves the WHOLE boundary in one run: the five-line stdout contract
# in order, the archive published with the session's own semantics inside it, the
# source gone, and a genuinely NEW session under the same name that knows its parent.
C48B_REPO="$(setup_repo)"
mkdir -p "$C48B_REPO/.ae"
printf '[workspace]\npurge_agent_history = false\n' >"$C48B_REPO/.ae/config"
(cd "$C48B_REPO" && "$AE" --local comp-full &) 2>/dev/null
wait_for_session "comp-full" 20
sleep 1
C48B_DIR="$HOME/.ae/sessions/comp-full"
C48B_UUID="$(grep '^session_id=' "$C48B_DIR/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
"$C48B_DIR/memo" add --topic handover "the thing the next session must know" >/dev/null 2>&1 || true
"$C48B_DIR/goal" "prove compact end to end" >/dev/null 2>&1 || true
c48b_out="$TMPDIR/c48b.out"
(cd "$C48B_REPO" && "$AE" compact -f --digest-only comp-full >"$c48b_out" 2>"$TMPDIR/c48b.err") &
for _c48b_i in $(seq 1 90); do
    grep -q "Starting fresh session" "$c48b_out" 2>/dev/null && break
    sleep 1
done
wait || true
sleep 2
# THE OUTPUT CONTRACT: five lines, this order. Recovery is printed BEFORE the relaunch
# because after that line the process may exec and never return.
assert_eq "compact-out: line 1 names the archive id" "1" \
    "$(sed -n '1p' "$c48b_out" | grep -c "^Archived ${C48B_UUID}$" | tr -d '[:space:]')"
assert_eq "compact-out: line 2 the archive path" "1" \
    "$(sed -n '2p' "$c48b_out" | grep -c "^Archive: .*/archive/${C48B_UUID}$" | tr -d '[:space:]')"
assert_eq "compact-out: line 3 the digest path" "1" \
    "$(sed -n '3p' "$c48b_out" | grep -c "^Digest: .*/archive/${C48B_UUID}/digest.md$" | tr -d '[:space:]')"
# The core SHELL-QUOTES every word it interpolates (src/lifecycle/compaction.rs
# `recovery_command` -> `shell_quote`), so the origin and the name arrive as 'dir'
# and 'comp-full'. That is the improvement — a session whose origin holds a space
# used to emit a recovery line that pasted as two arguments — so the pattern
# tolerates the quotes rather than the quoting being reverted to match it.
assert_eq "compact-out: line 4 the recovery command, BEFORE the relaunch" "1" \
    "$(sed -n '4p' "$c48b_out" | grep -c "^Recovery: cd .* 'comp-full' --from ${C48B_UUID}$" | tr -d '[:space:]')"
# THE CONTRACT STOPS AT WHAT IS TRUE AT THAT INSTANT. "Starting fresh session" was on
# stdout and claimed a launch that can still refuse — the name is claimable in the release
# window — so a caller could read "replaced" from a run that only archived. What stdout
# now promises is exactly what holds: THE ARCHIVE EXISTS AND THE PRINTED RECOVERY COMMAND
# WILL WORK. The relaunch announcement is progress, and progress is stderr.
# COMPACT'S OWN stdout is four lines — but it EXECS into the launch, and the child
# inherits the same stdout, so anything after line 4 belongs to the fresh session and is
# not compact speaking. Assert the boundary rather than a total count: the four contract
# lines come first, and nothing compact prints follows them.
assert_eq "compact-out: the four contract lines come first, and are all compact writes to stdout" "4" \
    "$(head -4 "$c48b_out" | grep -cE '^(Archived |Archive: |Digest: |Recovery: )' | tr -d '[:space:]')"
assert_eq "compact-out: anything after them is the CHILD, not compact — no further contract lines" "0" \
    "$(tail -n +5 "$c48b_out" | grep -cE '^(Archived |Archive: |Digest: |Recovery: )' | tr -d '[:space:]')"
assert_eq "compact-out: it does NOT claim a relaunch that can still refuse" "0" \
    "$(grep -c "Starting fresh session" "$c48b_out" | tr -d '[:space:]')"
assert_eq "compact-out: the relaunch announcement is progress, so it is on stderr" "1" \
    "$(grep -c "^Starting fresh session comp-full from archive ${C48B_UUID}" "$TMPDIR/c48b.err" | tr -d '[:space:]')"
assert_eq "compact-out: and the recovery command reaches stderr too, so a broken stdout cannot lose it" "1" \
    "$(grep -c "^Recovery: cd .* 'comp-full' --from ${C48B_UUID}$" "$TMPDIR/c48b.err" | tr -d '[:space:]')"
assert_eq "compact-out: end's own progress stays off the contract (no duplicate Archived)" "1" \
    "$(grep -c '^Archived ' "$c48b_out" | tr -d '[:space:]')"
# THE ARCHIVE
assert_eq "compact: the archive is published" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48B_UUID}/digest.md" ]] && echo 1 || echo 0)"
assert_contains "compact: the handover memo travelled into the digest" \
    "the thing the next session must know" "$(cat "$HOME/.ae/archive/${C48B_UUID}/digest.md")"
assert_contains "compact: and the goal" "prove compact end to end" \
    "$(cat "$HOME/.ae/archive/${C48B_UUID}/digest.md")"
assert_contains "compact: the archive keeps the id's real provenance" "archive_id_origin=session" \
    "$(cat "$HOME/.ae/archive/${C48B_UUID}/meta")"
# THE CHILD
assert_eq "compact: a fresh session is live under the same name" "0" \
    "$(tmux has-session -t comp-full 2>/dev/null; echo $?)"
C48B_NEWUUID="$(grep '^session_id=' "$C48B_DIR/meta" 2>/dev/null | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
assert_eq "compact: the child is a NEW session, not the old one resumed" "1" \
    "$([[ -n "$C48B_NEWUUID" && "$C48B_NEWUUID" != "$C48B_UUID" ]] && echo 1 || echo 0)"
assert_contains "compact: and it records the archive it continues" \
    "parent_archive_id=${C48B_UUID}" "$(cat "$C48B_DIR/meta")"
assert_eq "compact: every agent sees the pointer in workspace.md" "1" \
    "$(grep -c '^## Parent archive' "$C48B_DIR/workspace.md" | tr -d '[:space:]')"
assert_eq "compact: the child carries no spawned slot from the source" "0" \
    "$(grep -c '^agent\.spawned\.' "$C48B_DIR/meta" | tr -d '[:space:]')"
assert_eq "compact: conversation history was kept (nothing purged)" "0" \
    "$(grep -c 'removed claude conversation' "$TMPDIR/c48b.err" | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-full >/dev/null 2>&1 || true
unset C48B_DIR C48B_UUID C48B_NEWUUID c48b_out

# THE HISTORY POLICY IS A CONTRADICTION, NOT A DETAIL. compact exists to keep the
# record; a session configured to purge it must be resolved by the human, and a flip
# to purge WHILE the human is answering must refuse rather than carry out a different
# operation than the one on screen.
C48B_PREPO="$(setup_repo)"
mkdir -p "$C48B_PREPO/.ae"
printf '[workspace]\npurge_agent_history = true\n' >"$C48B_PREPO/.ae/config"
(cd "$C48B_PREPO" && "$AE" --local comp-purge &) 2>/dev/null
wait_for_session "comp-purge" 20
sleep 1
c48b_purge_rc=0
c48b_purge="$( (cd "$C48B_PREPO" && "$AE" compact -f --digest-only comp-purge) 2>&1 )" || c48b_purge_rc=$?
assert_eq "compact-purge: a purge_agent_history session refuses up front" "1" \
    "$([[ $c48b_purge_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-purge: and says why it contradicts compact" \
    "which contradicts compact" "$c48b_purge"
assert_contains "compact-purge: and offers the explicit way through" \
    "ae compact --keep-history comp-purge" "$c48b_purge"
C48B_PUUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-purge/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]' || true)"
assert_eq "compact-purge: it refused before publishing anything" "0" \
    "$([[ -e "$HOME/.ae/archive/${C48B_PUUID}" ]] && echo 1 || echo 0)"
assert_eq "compact-purge: and the session is still running" "0" \
    "$(tmux has-session -t comp-purge 2>/dev/null; echo $?)"
# Now the flip case: keep at the prompt, purge by the time the answer lands.
printf '[workspace]\npurge_agent_history = false\n' >"$C48B_PREPO/.ae/config"
C48B_PFIFO="$TMPDIR/c48b-purge.fifo"
rm -f "$C48B_PFIFO"
mkfifo "$C48B_PFIFO"
(
    exec 3>"$C48B_PFIFO"
    sleep 5 # the prompt is on screen by now, promising the history is kept
    printf '[workspace]\npurge_agent_history = true\n' >"$C48B_PREPO/.ae/config"
    printf 'y' >&3
    exec 3>&-
) &
c48b_flip_rc=0
c48b_flip="$( (cd "$C48B_PREPO" && "$AE" compact --digest-only comp-purge <"$C48B_PFIFO") 2>&1 )" || c48b_flip_rc=$?
wait || true
rm -f "$C48B_PFIFO"
assert_eq "compact-flip: a policy flip under the answer refuses" "1" \
    "$([[ $c48b_flip_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-flip: and names what changed" \
    "now has purge_agent_history enabled" "$c48b_flip"
assert_contains "compact-flip: caught at the first revalidation, before anything was messaged" \
    "after confirmation" "$c48b_flip"
assert_eq "compact-flip: the session is still running" "0" \
    "$(tmux has-session -t comp-purge 2>/dev/null; echo $?)"
"$AE" end -f --keep-history comp-purge >/dev/null 2>&1 || true
unset C48B_PREPO C48B_PFIFO C48B_PUUID c48b_purge c48b_purge_rc c48b_flip c48b_flip_rc

# SPAWN CLOSURE is strict, and --digest-only does not weaken it.
(cd "$C48B_REPO" && "$AE" --local comp-spawn &) 2>/dev/null
wait_for_session "comp-spawn" 20
sleep 1
printf 'seat.spawned.2=helper\nprofile.spawned.2=dummy\nagent_bin.spawned.2=bash\nharness_session.spawned.2=pending\n' \
    >>"$HOME/.ae/sessions/comp-spawn/meta"
c48b_spawn_rc=0
c48b_spawn="$( (cd "$C48B_REPO" && "$AE" compact -f --digest-only comp-spawn) 2>&1 )" || c48b_spawn_rc=$?
assert_eq "compact-spawn: a spawned agent refuses the compact, even with --digest-only" "1" \
    "$([[ $c48b_spawn_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-spawn: and it never retires someone else's worker" \
    "compact never retires someone else's worker" "$c48b_spawn"
assert_eq "compact-spawn: the session is untouched" "0" \
    "$(tmux has-session -t comp-spawn 2>/dev/null; echo $?)"
_sed_i -e "/^agent\.spawned\./d" "$HOME/.ae/sessions/comp-spawn/meta"
"$AE" end -f --keep-history comp-spawn >/dev/null 2>&1 || true
unset c48b_spawn c48b_spawn_rc

# ABA: the identity changes while the human is answering. The replacement must not be
# messaged and must not be stopped.
(cd "$C48B_REPO" && "$AE" --local comp-aba &) 2>/dev/null
wait_for_session "comp-aba" 20
sleep 1
C48B_AFIFO="$TMPDIR/c48b-aba.fifo"
rm -f "$C48B_AFIFO"
mkfifo "$C48B_AFIFO"
(
    exec 3>"$C48B_AFIFO"
    sleep 5
    _sed_i -e "s|^session_id=.*|session_id=99999999-8888-7777-6666-555555555555|" \
        "$HOME/.ae/sessions/comp-aba/meta"
    printf 'y' >&3
    exec 3>&-
) &
c48b_aba_rc=0
c48b_aba="$( (cd "$C48B_REPO" && "$AE" compact comp-aba <"$C48B_AFIFO") 2>&1 )" || c48b_aba_rc=$?
wait || true
rm -f "$C48B_AFIFO"
assert_eq "compact-aba: an identity change between the prompt and the answer refuses" "1" \
    "$([[ $c48b_aba_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-aba: and names the session it was authorized for" \
    "is not the session that was authorized" "$c48b_aba"
assert_contains "compact-aba: nothing was stopped and nothing was archived" \
    "Nothing was stopped and nothing was archived" "$c48b_aba"
# Nothing was sent AS compact: its actor is the only sender it ever uses, so the
# absence of that string is the absence of the message. `|| echo 0` because a session
# that never emitted an event has no log at all, and no log is also "never messaged".
assert_eq "compact-aba: the replacement was never messaged" "0" \
    "$( { grep -c 'ae:compact:' "$HOME/.ae/sessions/comp-aba/events.jsonl" 2>/dev/null || echo 0; } | head -1 | tr -d '[:space:]')"
assert_eq "compact-aba: and never stopped" "0" \
    "$(tmux has-session -t comp-aba 2>/dev/null; echo $?)"
_sed_i -e "s|^session_id=.*|session_id=77777777-8888-9999-aaaa-bbbbbbbbbbbb|" \
    "$HOME/.ae/sessions/comp-aba/meta"
"$AE" end -f --keep-history comp-aba >/dev/null 2>&1 || true
unset C48B_REPO C48B_AFIFO c48b_aba c48b_aba_rc

# COVERAGE IS PROVED, NOT ASSUMED. Every arm in this section is straight-line — no loops,
# no conditionals — so the number of assertions that RAN must equal the number that EXIST.
# The expected count is read from this file at runtime rather than hardcoded, so adding an
# arm cannot silently leave the check behind. This exists because an ABORT skips arms
# without printing a single failure (ERRORS[] is flushed at the end, which an abort never
# reaches), so "no FAIL lines" is evidence of nothing; and because a shortfall a human has
# to notice is a shortfall a human will eventually stop noticing.
_C48_RAN=$((PASS + FAIL - _C48_BEFORE))
# THE RANGE IS BOUNDED BY ITS OWN END MARKER, not by the file's tail. It used to stop at
# '# .. Results', which silently means "everything from here to the bottom of the file" —
# i.e. an assumption that this is the LAST section. The first section appended after it
# (#59's) landed inside the range: expected 139, ran 133, and the failure named compact,
# which had not changed. The Results stop is kept as a fallback so a deleted end marker
# degrades to the old behaviour rather than counting the whole file from line 1.
_C48_EXPECTED="$(awk '
    /^# .. ae compact, phase \(a\)/     { on = 1 }
    /^# .. end of the ae compact section/ { on = 0 }
    /^# .. Results/                       { on = 0 }
    on && /^assert_(eq|contains) "compact-coverage:/ { next }
    on && /^assert_(eq|contains) /   { n++ }
    END { print n + 0 }' "$0")"
assert_eq "compact-coverage: every arm in this section actually ran" "$_C48_EXPECTED" "$_C48_RAN"
unset _C48_BEFORE _C48_RAN _C48_EXPECTED
export AE_CORE_BIN="$_ITEST_CORE_BIN"; unset _C48_CORE
fi  # ── P3.7 core-guard end ──
fi

