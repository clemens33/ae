# Watchdog probe helpers (used both before and after refresh). Bounded polling,
# not fixed sleeps — the launch autostarts the watchdog in the background.
wd_poll() { # wd_poll <helper> <needle> [tries] — bounded status poll
    local h="$1" needle="$2" tries="${3:-20}" i=0
    while ((i < tries)); do
        [[ "$("$h" status 2>&1 || true)" == *"$needle"* ]] && return 0
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}
wd_pid() { "$1" status 2>&1 | sed -n 's/.*pid \([0-9]*\).*/\1/p'; }
WD_HELPER="$HOME/.ae/sessions/test-sync/watchdog"

# Settle the launch autostart so the watchdog is genuinely running before refresh,
# then snapshot its pid — refresh must restart it (new pid), not merely leave it.
wd_poll "$WD_HELPER" "is running" 20 || true
wd_pid_before="$(wd_pid "$WD_HELPER")"

printf '#!/usr/bin/env bash\necho stale-helper\n' > "$HOME/.ae/sessions/test-sync/reply"
chmod 0700 "$HOME/.ae/sessions/test-sync/reply"
printf '#!/usr/bin/env bash\necho stale-helper\n' > "$HOME/.ae/sessions/test-sync/state"
chmod 0700 "$HOME/.ae/sessions/test-sync/state"
printf '# stale lib\n' > "$HOME/.ae/sessions/test-sync/_lib"
printf 'stale manifest\n' > "$HOME/.ae/sessions/test-sync/workspace.md"

(cd "$REPO11" && "$AE" doctor --refresh test-sync > "$TMPDIR/doctor-sync.out" 2>/dev/null)
doctor_sync_output="$(cat "$TMPDIR/doctor-sync.out")"
reply_output="$("$HOME/.ae/sessions/test-sync/reply" 2>&1 || true)"
workspace_output="$(cat "$HOME/.ae/sessions/test-sync/workspace.md")"
meta_ae_path="$(grep '^ae_path=' "$HOME/.ae/sessions/test-sync/meta" | cut -d= -f2-)"

