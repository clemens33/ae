    "$([[ -n "$rost" ]] && echo 1 || echo 0)"
# Names render WITHOUT the alias prefix, and each carries exactly one verdict glyph.
assert_eq "roster: entry is '<name><glyph>' with no alias prefix" "1" \
    "$([[ "$rost" =~ ^[^:]*[●✔⏳⛔◌⚡✖·⚙] ]] && echo 1 || echo 0)"
assert_eq "roster: no alias prefix leaks into the bar" "1" \
    "$([[ "$rost" != *:* ]] && echo 1 || echo 0)"
# A declared 'done' must surface as ✔ — proves the roster reads the SAME verdicts the
# cycle already reaches, rather than re-deriving state of its own.
# The declaration must come FROM the agent's pane: `state` resolves its actor via
# ae_current_agent_ref -> #{@ae_agent} of TMUX_PANE, and _agent_quiet_reason only honours
# an agent's OWN declaration. Run from this test shell it would log actor=human and be
