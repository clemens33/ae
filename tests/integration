    | grep -v '_watchdog\|_events' | grep -E ' .+$' | head -1 | cut -d' ' -f1)"
assert_eq "roster: resolved an agent pane to declare from" "1" \
    "$([[ -n "$ROST_PANE" ]] && echo 1 || echo 0)"
# The watchdog cycles every AE_WATCHDOG_INTERVAL_SEC (default 60) and that env does NOT
# reach a tmux-spawned pane, so waiting for the NEXT cycle would mean a ~60s sleep here.
# Instead: stop, declare, restart. The verdict is derived from the EVENT LOG (durable),
# not from in-memory state, so the restarted watchdog's FIRST cycle already sees the
# declaration — same code path, seconds instead of a minute.
"$ROSTD" stop >/dev/null 2>&1 || true
wd_poll "$ROSTD" "not running" 20 || true
TMUX_PANE="$ROST_PANE" "$HOME/.ae/sessions/test-roster/state" "done" "roster integration probe" >/dev/null 2>&1 || true
"$ROSTD" start >/dev/null 2>&1 &
wd_poll "$ROSTD" "is running" 20 || true
rost_done=""
for _i in $(seq 1 30); do
