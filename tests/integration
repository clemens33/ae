# Load-bearing: the sentinel's awk range stops HERE. Anything appended below is a new
# section and must not be counted as a compact arm. Do not delete or reword the marker.

# ── tracked resolution: a paneless request routes on the recorded server ──
if _itest_section 'tracked resolution: a paneless request routes on the recorded server, not the ambient one'; then
_TR_CORE="$(dirname "$AE")/target/debug/ae"
if [[ ! -x "$_TR_CORE" ]]; then
    echo "  SKIP (tracked resolution is Rust-owned): no built core at ${_TR_CORE} — build it first (cargo build)." >&2
else
export AE_CORE_BIN="$_TR_CORE"
# The compact handover delivers its ask PANELESS (no TMUX_PANE). The resolver must read the
# TARGET session's OWN recorded tmux server to enumerate it: pane-less there is no ambient
# TMUX pointing at the custom server, so an ambient enumeration would miss it entirely, and
# on the default server it would silently mis-route a colliding name. Two sessions with the
# SAME agent ref on one custom server make only the server+session distinguish them.
TR_SRV="ae-tr-$$"
TR_RA="$(setup_repo)"
TR_RB="$(setup_repo)"
(cd "$TR_RA" && AE_TMUX_SERVER="$TR_SRV" "$AE" --local tr-a &) 2>/dev/null
(cd "$TR_RB" && AE_TMUX_SERVER="$TR_SRV" "$AE" --local tr-b &) 2>/dev/null
