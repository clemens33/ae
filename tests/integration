REQ_HELPER="$HOME/.ae/sessions/test-sync/requests"
assert_contains "doctor-refresh: requests helper carries the core shim" \
    "_ae_core_try _requests" "$(cat "$REQ_HELPER")"
cat >>"$HOME/.ae/sessions/test-sync/events.jsonl" <<'REQEV'
{"ts":"2026-08-01T00:00:00Z","actor":"a:one","action":"ask","ref":"canary-open","target":"b:two","summary":"still open"}
{"ts":"2026-08-01T00:01:00Z","actor":"a:one","action":"ask","ref":"canary-done","target":"b:two","summary":"answered"}
{"ts":"2026-08-01T00:02:00Z","actor":"b:two","action":"reply","ref":"canary-done","target":"a:one","summary":"the answer"}
REQEV
req_canary="$("$REQ_HELPER" all 2>&1 || true)"
assert_contains "doctor-refresh: regenerated requests renders its table" "STATUS" "$req_canary"
assert_contains "doctor-refresh: regenerated requests keeps an unanswered ask pending" \
    "pending  ask      canary-open" "$req_canary"
assert_contains "doctor-refresh: regenerated requests closes a properly replied one" \
    "replied  ask      canary-done" "$req_canary"
