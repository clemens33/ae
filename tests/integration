# ── Test: ae steward (legacy hub scaffold) — config isolation + hub compat ──
# The launcher must reproduce the start-steward wrapper's FULL isolation: a
# project's ./.ae/config must NOT override the standalone config (the worker-leak
# class codex flagged as a BLOCKER). We run the DEPRECATED `ae hub` alias with a
# legacy AE_HUB_DIR scaffold and assert (a) isolation holds and (b) the legacy
# scaffold keeps its `hub` session name (back-compat contract).
HUB_DIR="$TMPDIR/meta-hub"
mkdir -p "$HUB_DIR"
cat >"$HUB_DIR/hub.config" <<'EOF'
[agents]
dummy = "bash"

[workspace]
main = dummy:meta
copy = local
layout = vertical
hub = true
EOF
HOSTILE="$(setup_repo)"
mkdir -p "$HOSTILE/.ae"
cat >"$HOSTILE/.ae/config" <<'EOF'
[agents]
dummy2 = "bash"

[workspace]
main = dummy2:evil
workers = dummy2:leaked
layout = vertical
EOF
hub_launch_out="$(cd "$HOSTILE" && AE_HUB_DIR="$HUB_DIR" "$AE" hub 2>&1)"
wait_for_session "hub"
sleep 1
assert_contains "hub-compat: bare launch starts detached (no attach/switch needed)" "Session 'hub' started." "$hub_launch_out"
assert_contains "hub-compat: legacy scaffold prints the migration hint" "legacy hub scaffold" "$hub_launch_out"
_hub_meta="$HOME/.ae/sessions/hub/meta"
assert_contains "hub: hub-config main wins over hostile local main" "agent.main=dummy:meta:" \
    "$(cat "$_hub_meta" 2>/dev/null)"
assert_eq "hub: hostile local 'workers' does NOT leak in" "0" \
    "$(grep -c '^agent.worker' "$_hub_meta" 2>/dev/null || true)"
assert_contains "hub: config pinned to the standalone hub.config" "config=$HUB_DIR/hub.config" \
    "$(cat "$_hub_meta" 2>/dev/null)"
assert_contains "hub: work_dir pinned to the hub dir (cd isolation)" "work_dir=$HUB_DIR" \
    "$(cat "$_hub_meta" 2>/dev/null)"
assert_contains "hub: meta_agent mode on via 'hub = true' alias" "meta_agent=true" \
    "$(cat "$_hub_meta" 2>/dev/null)"
tmux kill-session -t hub 2>/dev/null || true

# Reserved-name contract: `ae hub <extra>` must be rejected, NOT turned into a
# session named <extra> using the hub config (the generic parser's last-positional
# -wins leak codex flagged).
assert_eq "hub: rejects an extra positional (reserved-name leak guard)" "1" \
    "$(AE_HUB_DIR="$HUB_DIR" "$AE" hub other 2>/dev/null; echo $?)"
assert_eq "hub: the extra-arg name was NOT created as a session" "1" \
    "$(tmux has-session -t other 2>/dev/null && echo 0 || echo 1)"

# `ae steward --init` with a RELATIVE AE_STEWARD_DIR must still bake an ABSOLUTE
# charter path into steward.config (else `ae steward` cd's in and rel/CHARTER.md
# → rel/rel/...).
REL_BASE="$TMPDIR/relbase"
mkdir -p "$REL_BASE"
(cd "$REL_BASE" && AE_STEWARD_DIR="relstw" "$AE" steward --init >/dev/null 2>&1)
assert_contains "steward --init: relative AE_STEWARD_DIR yields an absolute CHARTER path" \
    "$REL_BASE/relstw/CHARTER.md" "$(cat "$REL_BASE/relstw/steward.config" 2>/dev/null)"

# `ae help` (the in-tool discovery surface) lists the new first-class command.
assert_contains "help: lists 'ae steward'" "ae steward" "$("$AE" help 2>/dev/null)"

# Canonical steward path: AE_STEWARD_DIR scaffold → session named 'steward'.
STW_DIR="$TMPDIR/steward-canon"
(AE_STEWARD_DIR="$STW_DIR" "$AE" steward --init >/dev/null 2>&1)
assert_eq "steward --init: scaffolds steward.config + CHARTER.md" "1" \
    "$([[ -f "$STW_DIR/steward.config" && -f "$STW_DIR/CHARTER.md" ]] && echo 1 || echo 0)"
assert_contains "steward --init: config marks steward = true" "steward = true" \
    "$(cat "$STW_DIR/steward.config" 2>/dev/null)"
# Swap in the dummy agent so the session can actually launch in the harness.
sed -i 's|^claude = .*|claude = "bash"|' "$STW_DIR/steward.config"
stw_launch_out="$(AE_STEWARD_DIR="$STW_DIR" "$AE" steward 2>&1)"
wait_for_session "steward"
sleep 1
assert_contains "steward: bare launch starts detached as session 'steward'" "Session 'steward' started." "$stw_launch_out"
assert_contains "steward: meta_agent mode on via 'steward = true'" "meta_agent=true" \
    "$(cat "$HOME/.ae/sessions/steward/meta" 2>/dev/null)"
assert_eq "steward: rejects an extra positional (reserved-name leak guard)" "1" \
    "$(AE_STEWARD_DIR="$STW_DIR" "$AE" steward other2 2>/dev/null; echo $?)"
tmux kill-session -t steward 2>/dev/null || true

# AE_HOME relocates ALL ae state away from $HOME/.ae WITHOUT swapping $HOME — the
# isolation primitive for real-agent e2e (keep real $HOME for CLI auth, isolate ae
# state elsewhere). CONFIG_FILE stays on the dummy-agent config so the session can
# launch; only AE_HOME moves. Regression for the e2e-AI isolation fix.
ALT_AE_HOME="$TMPDIR/alt-aehome"
REPO_AEH="$(setup_repo)"
(cd "$REPO_AEH" && AE_HOME="$ALT_AE_HOME" CONFIG_FILE="$HOME/.ae/config" "$AE" --local aehome-test &) 2>/dev/null
wait_for_session "aehome-test"
sleep 1
assert_eq "AE_HOME: session state lands under AE_HOME, not \$HOME/.ae" "1" \
    "$([[ -f "$ALT_AE_HOME/sessions/aehome-test/meta" && ! -e "$HOME/.ae/sessions/aehome-test" ]] && echo 1 || echo 0)"
tmux kill-session -t aehome-test 2>/dev/null || true

# `ae steward --init` under AE_HOME must scaffold into $AE_HOME/steward, not live
# ~/.ae (codex BLOCKER class: the dir previously defaulted to $HOME/.ae).
HUB_AEH="$TMPDIR/stw-aehome"
(cd "$TMPDIR" && AE_HOME="$HUB_AEH" "$AE" steward --init >/dev/null 2>&1)
assert_eq "AE_HOME: steward --init scaffolds under AE_HOME, not \$HOME/.ae" "1" \
    "$([[ -f "$HUB_AEH/steward/steward.config" && ! -e "$HOME/.ae/steward" ]] && echo 1 || echo 0)"
# The charter's helper paths must point at the ISOLATED hub session dir, never the
# live ~/.ae (the charter-path fix that unblocks hub e2e scenarios).
assert_eq "AE_HOME: scaffolded charter helper paths point under AE_HOME, not ~/.ae" "1" \
    "$([[ -f "$HUB_AEH/steward/CHARTER.md" ]] &&
        grep -q "$HUB_AEH/sessions/steward/say" "$HUB_AEH/steward/CHARTER.md" &&
        ! grep -q '[~]/.ae/sessions/steward' "$HUB_AEH/steward/CHARTER.md" && echo 1 || echo 0)"

# ae end conversation-file cleanup flag: KEEP by default, --purge-history opts in.
REPO_KEEP="$(setup_repo)"
(cd "$REPO_KEEP" && "$AE" --local end-keep &) 2>/dev/null
wait_for_session "end-keep"
sleep 1
end_keep_out="$("$AE" end -f end-keep 2>&1)"
assert_contains "ae end (default) KEEPS agent conversation files" \
    "kept agent conversation files" "$end_keep_out"
REPO_PURGE="$(setup_repo)"
(cd "$REPO_PURGE" && "$AE" --local end-purge &) 2>/dev/null
wait_for_session "end-purge"
sleep 1
end_purge_out="$("$AE" end -f --purge-history end-purge 2>&1)"
assert_eq "ae end --purge-history takes the purge path (no keep-note)" "1" \
    "$([[ "$end_purge_out" != *'kept agent conversation files'* ]] && echo 1 || echo 0)"

# Per-session config decides the default (codex IMPORTANT) — NOT the caller's cwd.
# (A) a session whose OWN config sets purge_agent_history=true purges even when
# ended from a cwd with no such flag.
PURGE_CFG="$TMPDIR/purge-on.config"
cat >"$PURGE_CFG" <<'EOF'
[agents]
dummy = "bash"

[workspace]
main = dummy:main
purge_agent_history = true
EOF
REPO_A="$(setup_repo)"
(cd "$REPO_A" && CONFIG_FILE="$PURGE_CFG" "$AE" --local end-persess-purge &) 2>/dev/null
wait_for_session "end-persess-purge"
sleep 1
persess_purge_out="$("$AE" end -f end-persess-purge 2>&1)" # ended from default cwd (no flag)
assert_eq "ae end: a session's own purge_agent_history=true purges from a no-flag cwd" "1" \
    "$([[ "$persess_purge_out" != *'kept agent conversation files'* ]] && echo 1 || echo 0)"
# (B) a default (keep) session ended from a cwd whose .ae/config sets purge=true
# must still KEEP — the cwd's policy must not bleed onto an unrelated session.
REPO_B="$(setup_repo)"
(cd "$REPO_B" && "$AE" --local end-persess-keep &) 2>/dev/null
wait_for_session "end-persess-keep"
sleep 1
PURGE_CWD="$TMPDIR/purge-cwd"
mkdir -p "$PURGE_CWD/.ae"
printf '[workspace]\npurge_agent_history = true\n' >"$PURGE_CWD/.ae/config"
persess_keep_out="$(cd "$PURGE_CWD" && "$AE" end -f end-persess-keep 2>&1)"
assert_contains "ae end: a purge=true cwd does NOT override the target's keep default" \
    "kept agent conversation files" "$persess_keep_out"
# (C) a session whose stored config is missing/unusable (transferred/old) must
# still KEEP — never fall back to the caller's purge=true cwd.
REPO_C="$(setup_repo)"
(cd "$REPO_C" && "$AE" --local end-noconfig &) 2>/dev/null
wait_for_session "end-noconfig"
sleep 1
sed -i 's|^config=.*|config=/nonexistent/ae/config|' "$HOME/.ae/sessions/end-noconfig/meta"
noconfig_out="$(cd "$PURGE_CWD" && "$AE" end -f end-noconfig 2>&1)"
assert_contains "ae end: session with no usable stored config KEEPS (no cwd fallback)" \
    "kept agent conversation files" "$noconfig_out"

# Destructive command rejects a stray second positional rather than dropping it.
assert_eq "ae end: rejects a second positional argument" "1" \
    "$("$AE" end -f foo bar 2>/dev/null; echo $?)"

# ── ae list robustness: a per-session helper returning non-zero must NOT abort
#    the listing. Regression: cmd_list ran under `set -e`, so when
#    `_agent_alert_reason` returned non-zero (a scanned event targets an agent
#    whose actor is someone else — e.g. an inbound send/nudge), the assignment
#    `r="$(_agent_alert_reason …)"` killed the whole command mid-output —
#    truncating `--json` to INVALID (no closing `]}`, exit 1) and dropping rows
#    from the human table.
REPO_JR="$(setup_repo)"
(cd "$REPO_JR" && "$AE" --local jsonrobust &) 2>/dev/null
wait_for_session "jsonrobust"
sleep 1
jr_agent="$(sed -n 's/^agent.main=//p' "$HOME/.ae/sessions/jsonrobust/meta" | cut -d: -f1,2)"
# A lone target-only event (actor != agent) drives _agent_alert_reason to a
# non-zero return for this session's live agent.
printf '{"actor":"other:sender","target":"%s","action":"send","summary":"hi"}\n' \
    "$jr_agent" >"$HOME/.ae/sessions/jsonrobust/events.jsonl"
json_rc="$("$AE" list --json >/dev/null 2>&1; echo $?)"
assert_eq "list --json: exits 0 when a per-session helper returns non-zero" "0" "$json_rc"
json_out="$("$AE" list --json 2>/dev/null || true)"
assert_contains "list --json: emits the top-level open" '"schema_version":1' "$json_out"
if command -v python3 >/dev/null 2>&1; then
    json_valid="$(printf '%s' "$json_out" | python3 -c 'import sys,json; json.load(sys.stdin)' 2>/dev/null && echo ok || echo invalid)"
    assert_eq "list --json: stays valid JSON when a per-session helper returns non-zero" "ok" "$json_valid"
fi
human_rc="$("$AE" list >/dev/null 2>&1; echo $?)"
assert_eq "list (human): exits 0 when a per-session helper returns non-zero" "0" "$human_rc"
"$AE" end -f jsonrobust 2>/dev/null || true

# ── steward companion autostart: scaffold → any launch brings it up ──
mkdir -p "$HOME/.ae/steward"
cat > "$HOME/.ae/steward/steward.config" <<'EOF'
[agents]
dummy = "bash"

[workspace]
main = dummy:steward
steward = true
watchdog = false
EOF
REPO_AS="$(setup_repo)"
(cd "$REPO_AS" && "$AE" --local autostart-host &) 2>/dev/null
wait_for_session "autostart-host"
as_i=0
while ! tmux has-session -t steward 2>/dev/null && ((as_i < 20)); do
    sleep 0.5
    as_i=$((as_i + 1))
done
assert_eq "autostart: steward companion comes up with a fleet launch" "0" \
    "$(tmux has-session -t steward 2>/dev/null; echo $?)"
# Existing-session fast path (codex IMPORTANT): steward down + re-running
# 'ae <existing>' must bring it back (previously only the bridge was ensured).
"$AE" stop steward 2>/dev/null || true
sleep 0.5
(cd "$REPO_AS" && "$AE" --local autostart-host &) 2>/dev/null
as_i=0
while ! tmux has-session -t steward 2>/dev/null && ((as_i < 20)); do
    sleep 0.5
    as_i=$((as_i + 1))
done
assert_eq "autostart: existing-session relaunch revives the steward" "0" \
    "$(tmux has-session -t steward 2>/dev/null; echo $?)"
"$AE" stop steward 2>/dev/null || true
"$AE" end -f autostart-host 2>/dev/null || true
sleep 0.5
# Opt-out honoured: AE_NO_AUTOSTART=1 must not bring the steward back.
REPO_AS2="$(setup_repo)"
(cd "$REPO_AS2" && AE_NO_AUTOSTART=1 "$AE" --local autostart-off &) 2>/dev/null
wait_for_session "autostart-off"
sleep 2
assert_eq "autostart: AE_NO_AUTOSTART=1 keeps the steward down" "1" \
    "$(tmux has-session -t steward 2>/dev/null && echo 0 || echo 1)"
"$AE" end -f autostart-off 2>/dev/null || true
rm -rf "$HOME/.ae/steward"
sleep 0.5

# ── Results ──────────────────────────────────────────────────────────

echo ""
if [[ ${#ERRORS[@]} -gt 0 ]]; then
    for err in "${ERRORS[@]}"; do
        echo -e "$err"
        echo ""
    done
fi
echo "${PASS} passed, ${FAIL} failed"
[[ $FAIL -eq 0 ]] && exit 0 || exit 1
