run_capture transfer_unknown "$AE" transfer no-such-session-xyz vm.invalid
assert_eq "transfer: unknown local session exits 1" "1" "$transfer_unknown_rc"
assert_contains "transfer: unknown session prints actionable error" "no session 'no-such-session-xyz'" "$transfer_unknown_out"

