fi
assert_eq "readiness (#36): the delayed-start stub pane exists" "1" \
    "$([[ -n "$r36_pane" ]] && echo 1 || echo 0)"
if [[ -n "$r36_pane" ]]; then
    # Drive ae's REAL predicate. Sampled across the stub's three phases; the verdict
    # must be NOT-READY while a start-up marker is on screen and READY once it clears.
    # The predicate is eval'd from ae rather than reached through a new subcommand:
    # adding `ae _readiness-probe` would be product surface existing only for this
    # test. What integration contributes over the unit fixtures is a REAL pane and a
    # REAL capture-pane — the suite's own tmux() already targets the test server, so
    # the sensor reads exactly what ae would read.
    r36_src="$(cat "$AE")"
    for _f in _capture_input_region _sgr_parse _input_region_prompt_seg \
        _input_region_is_border _input_region_content_end _input_region_occupied \
        _paste_input_busy _tool_initializing _spawn_input_ready; do
        eval "$(awk -v f="^${_f}\\(\\)" '$0 ~ f,/^\}$/' <<<"$r36_src")"
    done
    r36_probe() {
        if _spawn_input_ready "$1" codex; then echo READY; else echo NOTREADY; fi
    }
    sleep 1
    r36_early="$(r36_probe "$r36_pane")"
    sleep 3.5
    r36_mid="$(r36_probe "$r36_pane")"
    sleep 3.5
    r36_late="$(r36_probe "$r36_pane")"
    assert_eq "readiness (#36): 'model: loading' is NOT ready" "NOTREADY" "$r36_early"
    assert_eq "readiness (#36): an MCP start-up progress line is NOT ready" "NOTREADY" "$r36_mid"
    assert_eq "readiness (#36): the settled screen IS ready" "READY" "$r36_late"
