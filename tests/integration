if _itest_section 'refresh reproduces the CORE'\''s helper set, link for link'; then
# A session's helper set has TWO writers: the core at launch
# (src/session_launch/assets.rs) and `ae doctor --refresh`, which reaches the same
# writer through `_shims-render`. Two writers of one artifact is a divergence
# waiting to happen, and the unit suite can only hold one side against a string it
# also owns. This holds the two against EACH OTHER: launch with the core, take the
# set and each entry's LINK TARGET, refresh, take them again.
#
# The comparison is the target, not the bytes, since slice Z2: a helper is a
# symlink to the core binary, so hashing it would hash the same 20MB core 21 times
# and prove only that the core did not change under us. The link is the artifact.
REPO_BP="$(setup_repo)"
(cd "$REPO_BP" && "$AE" --local test-shimparity &) 2>/dev/null
wait_for_session "test-shimparity"
sleep 1
BP_DIR="$HOME/.ae/sessions/test-shimparity"
# The HELPER set: every symlink the session owns. Nothing else in the directory is
# executable any more — the per-slot launch scripts went with slice Z2, and what is
# left beside the links is data.
bp_snapshot() { # -> "<name> <link target>" per helper, sorted by name
    local f n
    for f in "$BP_DIR"/*; do
        n="${f##*/}"
        if [[ -L "$f" ]]; then
            printf '%s %s\n' "$n" "$(readlink "$f" || echo '?')"
        fi
    done | sort
    return 0
}
bp_before="$(bp_snapshot)"
# `_register-sid` is in the set and is the one name no human runs: ae tells codex,
