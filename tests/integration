    "$(_id59_singleton "$ID59_DEC_MAIN" "You are agent boss (slot main).")"
assert_eq "#59: the spawned slot's argv carries EXACTLY ONE identity, and it is that agent's" "1" \
    "$(_id59_singleton "$ID59_DEC_SP0" "You are agent helper (slot spawned.0).")"
assert_eq "#59: opencode.worker.0.md carries EXACTLY ONE identity, and it is the WORKER's" "1" \
    "$(_id59_singleton "$ID59_OC_W0" "You are agent sidekick (slot worker.0).")"
