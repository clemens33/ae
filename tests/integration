for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/wtend/meta" ]] && break; sleep 0.3; done
wtend_wt="$(grep '^work_dir=' "$HOME/.ae/sessions/wtend/meta" | cut -d= -f2- || true)"
if [[ -n "$wtend_wt" ]]; then
    git -C "$wtend_wt" config user.email "test@test" 2>/dev/null || true
    git -C "$wtend_wt" config user.name "test" 2>/dev/null || true
fi
for _i in $(seq 1 20); do
    tmux has-session -t "=wtend" 2>/dev/null || break
    "$AE" end -f wtend 2>/dev/null || true
    sleep 0.4
done
assert_eq "end (B2): the git target's worktree is REMOVED (not leaked via a local neighbor)" "1" \
    "$([[ -n "$wtend_wt" && ! -d "$wtend_wt" ]] && echo 1 || echo 0)"
assert_eq "end (B2): the local prefix-neighbor is UNTOUCHED and still live" "1" \
    "$(tmux has-session -t "=wtendlocal" 2>/dev/null && echo 1 || echo 0)"
"$AE" end -f wtendlocal 2>/dev/null || true
sleep 0.3
