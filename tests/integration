fi

# ── Test 4: Spawn persistence ────────────────────────────────────────
if _itest_section 'Test 4: Spawn persistence'; then

REPO4="$(setup_repo)"
(cd "$REPO4" && "$AE" --local test-spawn &) 2>/dev/null
wait_for_session "test-spawn"
# ── WHO KILLED THE SPAWNED PANE ──────────────────────────────────────────────
# The open question this section keeps raising is whether the worker's pane dies on its
# own or is killed, and a pane list cannot tell those apart: with remain-on-exit off, an
# exited process and a kill-pane both leave the same absence. remain-on-exit WOULD
# discriminate, and is exactly the instrument that must not be used here — a corpse keeps
# its @ae_slot, so the assertion below would pass on a dead agent and the failure would be
# erased by the act of measuring it. So both halves of the answer are collected without
# touching the product's behaviour:
#
#   the SHIM   — a pane-killing call reaches tmux through the word `tmux`, so a script of
#                that name first on PATH sees the ones made by processes that start AFTER
#                it is installed. It logs only the destructive verbs and then execs the
#                real binary, resolved BEFORE the shim is on PATH so it cannot find itself.
#                READ THE EMPTY LOG NARROWLY: it says only that nothing started in this
#                section after the shim went on PATH killed the pane. It is NOT proof that
#                nothing killed it. A process that started earlier carries the pre-shim
#                PATH and never sees the shim at all — this session's own watchdog, which
#                `ae --local test-spawn` launched above, and any leftover process from an
#                earlier section both fall in that blind spot. The leading hypothesis for
#                this defect (a stale process holding a recycled pane id from a previous
#                tmux server generation) is exactly a pre-shim process, so the shim cannot
#                see it BY CONSTRUCTION. The evidence there is different: the pane
#                SURVIVING, plus the guard's refusal on the stale caller's own stderr.
#   the HOOK   — tmux's own pane-exited fires when the pane's PROCESS exits, and needs no
#                remain-on-exit, so it reports a self-inflicted death without preserving
#                the corpse.
#
# Read together: exit line and no kill line means the launched shell died by itself; a kill
# line means the caller is named in the log. The verb is found by scanning for the first
# non-option word, NOT by looking at $1 — every caller here reaches tmux through a wrapper
# that prepends `-L <server>`, so the subcommand is never the first argument.
SP_KILLLOG="$TMPDIR/spawn-kills.log"
SP_EXITLOG="$TMPDIR/spawn-exits.log"
: >"$SP_KILLLOG"
: >"$SP_EXITLOG"
SP_SHIMDIR="$TMPDIR/binspawnshim"
mkdir -p "$SP_SHIMDIR"
# `type -P`, NOT `command -v`, and this is the whole reason the first attempt fork-bombed
# the machine. The suite defines `tmux` as a FUNCTION, and `command -v` answers about the
# function — it prints the bare word `tmux`. Baking that into the shim made the shim exec
# `tmux`, which PATH then resolved back to the shim, forever. `type -P` forces a PATH
# search and ignores functions, builtins and aliases, so it yields the real binary. The
# shim also refuses to run if what it was handed is not an executable file, because a
# recursive exec is not a failure anyone reads as a bug — it presents as a hang.
SP_REAL_TMUX="$(type -P tmux)"
cat >"$SP_SHIMDIR/tmux" <<SPSHIM
#!${BASH:-/bin/bash}
_verb=""
_skip=0
for _a in "\$@"; do
    if [[ "\$_skip" == 1 ]]; then
        _skip=0
        continue
    fi
    case "\$_a" in
        -L | -S | -f | -c) _skip=1 ;;
        -*) ;;
        *)
            _verb="\$_a"
            break
            ;;
    esac
done
case "\$_verb" in
    kill-pane | kill-window | kill-session | respawn-pane)
        {
            _pp="\$(ps -o ppid= -p "\$PPID" 2>/dev/null | tr -d '[:space:]')"
            printf '%s %s\\n  by pid %s: %s\\n  parent %s: %s\\n  args: %s\\n' \\
                "\${EPOCHREALTIME:-\$(date +%s)}" "\$_verb" \\
                "\$PPID" "\$(ps -o command= -p "\$PPID" 2>/dev/null | tr '\\n' ' ')" \\
                "\${_pp:-?}" "\$(ps -o command= -p "\${_pp:-1}" 2>/dev/null | tr '\\n' ' ')" \\
                "\$*"
        } >>"$SP_KILLLOG" 2>/dev/null || true
        ;;
esac
if [[ ! -x "$SP_REAL_TMUX" ]]; then
    echo "itest tmux shim: the real tmux was not resolved (got '$SP_REAL_TMUX')" >&2
    exit 127
fi
exec "$SP_REAL_TMUX" "\$@"
SPSHIM
chmod 0755 "$SP_SHIMDIR/tmux"
cat >"$SP_SHIMDIR/paneexit" <<PEEOF
#!/bin/sh
printf '%s pane-exited %s\\n' "\$(date +%s)" "\$1" >>"$SP_EXITLOG" 2>/dev/null || true
PEEOF
chmod 0755 "$SP_SHIMDIR/paneexit"
tmux set-hook -t test-spawn pane-exited "run-shell '$SP_SHIMDIR/paneexit \"#{pane_id}\"'" 2>/dev/null || true
SP_OLD_PATH="$PATH"
PATH="$SP_SHIMDIR:$PATH"
export PATH
sleep 1

# Spawn a second agent. Identity v2: the NAME is required and the profile is named by
# --using — there is no helper-<n> default and no alias-shaped first argument any more.
#
# ITS OUTPUT IS KEPT. `2>/dev/null || true` on the one call every later arm depends on
# makes a partial spawn — seat registered, pane never created — arrive as three unrelated
# failures further down with nothing to explain them. rc is deliberately not asserted to
# be 0: the tool is `bash`, which has no readiness marker, so spawn correctly reports
# SPAWN INCOMPLETE (rc 1) with the pane live (see the focus probe below). What must hold
# is that the PANE exists, and the spawn's own words ride on that assertion's label.
# POST-MORTEM for the intermittent spawned-pane disappearance, and it is deliberately
# READ-ONLY. The obvious instrument, `remain-on-exit on`, cannot be used: it keeps the
# corpse, a corpse still carries @ae_slot, and the assertion below would then pass on a
# pane whose process had died — the instrument would erase the very failure it exists to
# record. A poller only reads the server, so it changes nothing it observes. It gets its
# own output file because a backgrounded fixture that dies under errexit is invisible, and
# its silence gets blamed on whatever it was feeding.
sp0_watch="$TMPDIR/spawnwatch.log"
: >"$sp0_watch"
(
    set +e
    _t=0
    while [[ "$_t" -lt 200 ]]; do
        printf 't=%s ' "$_t"
        tmux list-panes -a -F '#{session_name}:#{window_index}:#{window_name} #{pane_id} dead=#{pane_dead} slot=#{@ae_slot}' 2>&1 | tr '\n' '~'
        printf '\n'
        _t=$((_t + 1))
        sleep 0.2
    done
) >>"$sp0_watch" 2>&1 &
sp0_watch_pid=$!

sp0_rc=0
sp0_out="$("$HOME/.ae/sessions/test-spawn/spawn" helper-0 --using dummy2 "test prompt" 2>&1)" || sp0_rc=$?
# SETTLE, DO NOT SLEEP. The pane inventory below is read only once the seat's pane
# has actually been stamped. spawn returns rc 1 here on SPAWN INCOMPLETE (the tool is
# `bash`, which has no readiness marker), and the fixed `sleep 1` that used to follow
# was a guess at how long tmux needs to finish creating the window and setting its
# @ae_slot. On a loaded machine that guess is sometimes short, and the section then
# reads as "the product lost the pane and left the seat in meta" — an intermittent red
# that appeared only in full runs and never once under a scoped run or instrumentation.
# Waiting for the FACT costs nothing when the pane is already there, and it cannot mask
# a real absence: the loop simply gives up and the assertion below still fails.
sp0_deadline=$((SECONDS + 15))
while ((SECONDS < sp0_deadline)); do
    if tmux list-panes -s -t test-spawn -F '#{@ae_slot}' 2>/dev/null | command grep -qx 'spawned.0'; then
        break
    fi
    sleep 0.2
done
# The inventory rides on the label too: when this goes red the question is always
# "is the pane missing, or merely unstamped", and only a dump answers it.
sp0_panes="$(tmux list-panes -s -t test-spawn -F '#{window_index}:#{window_name} #{pane_id} agent=#{@ae_agent} slot=#{@ae_slot} cmd=#{pane_current_command}' 2>/dev/null | tr '\n' '~')"
kill "$sp0_watch_pid" 2>/dev/null || true
wait "$sp0_watch_pid" 2>/dev/null || true
if ! tmux list-panes -s -t test-spawn -F '#{@ae_slot}' 2>/dev/null | command grep -qx 'spawned.0'; then
    {
        echo "=== SPAWN POST-MORTEM: the seat's pane never settled ==="
        echo "-- spawn rc ${sp0_rc}, and it said:"
        printf '%s\n' "$sp0_out"
        echo "-- windows now:"
        tmux list-windows -t test-spawn -F '#{window_index}:#{window_name} panes=#{window_panes}' 2>&1
        echo "-- meta seat rows:"
        command grep -E '^(seat|profile|agent_bin)\.' "$HOME/.ae/sessions/test-spawn/meta" 2>&1
        echo "-- destructive tmux calls from processes started after the shim (empty does"
        echo "   NOT mean nothing killed it — a pre-shim process never reaches the shim):"
        cat "$SP_KILLLOG"
        echo "-- pane-exited hook (a line here means the pane's own process exited):"
        cat "$SP_EXITLOG"
        echo "-- server timeline (0.2s per tick, every pane on the server):"
        cat "$sp0_watch"
        echo "=== SPAWN POST-MORTEM END ==="
    } >&2
fi
assert_eq "spawn: the worker pane was created [rc ${sp0_rc}] SAID: ${sp0_out//$'\n'/ | } PANES: ${sp0_panes}" "1" \
    "$(tmux list-panes -s -t test-spawn -F '#{@ae_slot}' 2>/dev/null | command grep -cx 'spawned.0' | tr -d '[:space:]')"
assert_eq "spawn: ...and its status is one of the two known outcomes" "1" \
    "$([[ "$sp0_rc" == "0" || "$sp0_rc" == "1" ]] && echo 1 || echo 0)"

# Meta should carry the spawned seat as its own rows: the name in seat.<slot>, the
# profile beside it. (The single agent.<slot>=alias:name:sid line is never written now.)
spawned="$(grep -E '^(seat|profile)\.spawned\.0=' "$HOME/.ae/sessions/test-spawn/meta" 2>/dev/null || echo "")"
assert_contains "spawn: name recorded in meta" "seat.spawned.0=helper-0" "$spawned"
assert_contains "spawn: profile recorded beside it" "profile.spawned.0=dummy2" "$spawned"
assert_eq "spawn: the retired alias:name roster line is not written" "0" \
    "$(grep -c '^agent\.spawned\.0=' "$HOME/.ae/sessions/test-spawn/meta" 2>/dev/null || true)"

# Spawned worker lives in its OWN window (main window layout untouched):
# session-wide 2 agent panes, main window still 1, new window named after role.
# COUNT SEATS, NOT LABELLED PANES. The hidden ae-monitor window's panes carry an
# @ae_agent too (_watchdog, _events) and no @ae_slot; under v1 the alias:name colon
# excluded them by accident, and a bare name does not. The slot is what makes a pane a
# seat, so it is what this counts.
pane_count="$(tmux list-panes -s -t test-spawn -F '#{@ae_slot}' 2>/dev/null | command grep -c . || true)"
assert_eq "spawn: 2 agent panes session-wide after spawn" "2" "$pane_count"
main_win_panes="$(tmux list-windows -t test-spawn -F '#{window_name} #{window_panes}' 2>/dev/null | awk '$1=="test-spawn"{print $2; exit}' || true)"
assert_eq "spawn: main window keeps its single pane" "1" "$main_win_panes"
assert_contains "spawn: worker window named after its role" "helper-0" \
    "$(tmux list-windows -t test-spawn -F '#{window_name}' 2>/dev/null)"

# #38: a spawn must deliver its brief WITHOUT taking focus — under lead-pair a spawn
# firing while the human types routes their in-flight keystrokes into the new worker.
sp_active_before="$(tmux list-panes -s -t test-spawn -F '#{pane_active} #{pane_id}' 2>/dev/null | awk '$1==1{print $2}' | head -1)"
sp_rc=0
"$HOME/.ae/sessions/test-spawn/spawn" focusprobe --using dummy2 "brief for the focus probe" >/dev/null 2>&1 || sp_rc=$?
sleep 2
# LIVENESS BEFORE THE BEHAVIOURAL CLAIM: "the active pane did not change" is trivially
# true when nothing was spawned. The liveness that makes the focus claim meaningful is
# that a PANE WAS CREATED — if none was, focus could not have moved.
#
# rc is deliberately NOT asserted to be 0 here, and the reason is worth recording: the
# test tool is `bash`, which has no readiness marker, so _spawn_input_ready can never
# confirm it idle and the brief is correctly NOT pasted — spawn reports SPAWN
# INCOMPLETE (rc 1) with the pane live. That is ae refusing to paste into a pane it
# cannot confirm, which is the behaviour #36 built. Demanding rc 0 would encode an
# expectation that is wrong for every dummy-tool spawn in this suite.
assert_eq "spawn-focus (#38): a worker pane really was created (claim is not vacuous)" "1" \
    "$(tmux list-panes -s -t test-spawn -F '#{@ae_agent}' 2>/dev/null | command grep -qx 'focusprobe' && echo 1 || echo 0)"
# ...and the status is still inspected rather than swallowed: a dummy spawn is expected
# to be 0 (delivered) or 1 (pane live, brief unconfirmed) — anything else is a real
# regression, and `|| true` alone would hide all three cases alike.
assert_eq "spawn-focus (#38): spawn's status is one of the two known outcomes" "1" \
    "$([[ "$sp_rc" == "0" || "$sp_rc" == "1" ]] && echo 1 || echo 0)"
sp_active_after="$(tmux list-panes -s -t test-spawn -F '#{pane_active} #{pane_id}' 2>/dev/null | awk '$1==1{print $2}' | head -1)"
assert_eq "spawn-focus (#38): spawning does not change the active pane" "$sp_active_before" "$sp_active_after"
"$HOME/.ae/sessions/test-spawn/retire" focusprobe >/dev/null 2>&1 || true
unset sp_active_before sp_active_after sp_rc
# (RETIRED: "alias-only target resolves unique alias" — identity v2 resolves the EXACT
# name only, so the same round-trip is driven by the spawned agent's name.)
"$HOME/.ae/sessions/test-spawn/send" helper-0 "printf 'name-hit\n'" 2>/dev/null || true
sleep 0.5
spawn_output="$("$HOME/.ae/sessions/test-spawn/peek" helper-0 20 2>/dev/null || true)"
assert_contains "spawn: the exact spawned name resolves" "name-hit" "$spawn_output"
# ...and the PROFILE is not an address: 'dummy2' names a launch recipe, never an agent.
assert_eq "spawn: a profile name is NOT a target (alias-only resolution is gone)" "1" \
    "$("$HOME/.ae/sessions/test-spawn/send" dummy2 "printf 'must-not-arrive\n'" >/dev/null 2>&1 && echo 0 || echo 1)"

# Shared memo helper should persist append-only shared context
"$HOME/.ae/sessions/test-spawn/memo" add --topic arch "use sqlite for the demo" 2>/dev/null || true
memo_output="$("$HOME/.ae/sessions/test-spawn/memo" read --topic arch 2>/dev/null || true)"
assert_contains "spawn: memo read shows topic entry" "use sqlite for the demo" "$memo_output"
assert_contains "spawn: memo read renders topic" "[arch]" "$memo_output"
memo_tail_output="$("$HOME/.ae/sessions/test-spawn/memo" tail 1 2>/dev/null || true)"
assert_contains "spawn: memo tail shows latest entry" "use sqlite for the demo" "$memo_tail_output"
assert_eq "spawn: memo file exists" "1" "$([[ -f "$HOME/.ae/sessions/test-spawn/memo.tsv" ]] && echo 1 || echo 0)"

# Request/reply tracking should use the invoking pane identity, not the active pane
main_pane="$(tmux list-panes -s -t test-spawn -F '#{pane_id} #{@ae_agent}' | awk '$2=="dummy"{print $1; exit}')"
worker_pane="$(tmux list-panes -s -t test-spawn -F '#{pane_id} #{@ae_agent}' | awk '$2=="helper-0"{print $1; exit}')"
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/ask" helper-0 "check memo flow" 2>/dev/null || true
# `|| true` is load-bearing, not decoration. Under `set -e` + `pipefail` a grep that
# matches NOTHING makes this assignment fail, and the whole suite dies here — which is
# exactly what happens when the spawn above produced no pane: the real failure is four
# assertions back, and every later section is then never run at all. A missing request id
# must arrive as the assertions below going red, not as an abort that hides the rest.
req_id="$(grep -E '"action":"(ask|review)"' "$HOME/.ae/sessions/test-spawn/events.jsonl" 2>/dev/null | tail -1 | grep -oE '"ref":"[^"]+"' | cut -d'"' -f4 || true)"
wrong_reply_status=0
TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/reply" "$req_id" "wrong pane reply" >/dev/null 2>&1 || wrong_reply_status=$?
assert_eq "spawn: reply rejects wrong agent identity" "1" "$wrong_reply_status"
TMUX_PANE="$worker_pane" "$HOME/.ae/sessions/test-spawn/reply" "$req_id" "handled" >/dev/null 2>&1 || true
requests_output="$("$HOME/.ae/sessions/test-spawn/requests" all 2>/dev/null || true)"
assert_contains "spawn: requests show replied after correct reply" "replied" "$requests_output"

TMUX_PANE="$main_pane" "$HOME/.ae/sessions/test-spawn/ask" helper-0 "check override reply flow" 2>/dev/null || true
override_req_id="$(grep -E '"action":"(ask|review)"' "$HOME/.ae/sessions/test-spawn/events.jsonl" 2>/dev/null | tail -1 | grep -oE '"ref":"[^"]+"' | cut -d'"' -f4 || true)"
# codex BLOCKER: --as CANNOT bypass the slot proof on a SLOTTED request. The WRONG pane
# (main) with --as impersonating the target is rejected; the RIGHT pane (the target) with a
