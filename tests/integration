# agent must NOT raise the session attn marker.
assert_eq "state: stray actor does not raise attn marker" "0" \
    "$(echo "$list_output" | grep -c 'attn:')"

# When the real current agent goes waiting-user, attn must appear.
printf '{"ts":"2026-05-29T10:02:00Z","actor":"%s","action":"state","ref":"waiting-user","summary":"need you"}\n' "$main_agent" >>"$STATE_EVENTS"
list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: current agent waiting-user raises attn marker" "attn:waiting-user" "$list_output"

# --needs-me surfaces the waiting-user session.
assert_contains "list: --needs-me shows the waiting-user session" "test-state" \
    "$("$AE" list --needs-me 2>/dev/null)"

# --json digest: versioned wrapper + the running session with its agents.
json_out="$("$AE" list --json 2>/dev/null)"
assert_contains "json: versioned wrapper" '"schema_version":1' "$json_out"
assert_contains "json: includes the running session" '"name":"test-state"' "$json_out"
assert_contains "json: marks it running" '"status":"running"' "$json_out"
assert_contains "json: has an agents array" '"agents":[' "$json_out"
# Strict parse when a JSON parser is available (no hard dependency).
if command -v python3 >/dev/null 2>&1; then
    assert_eq "json: output is valid JSON" "ok" \
        "$(printf '%s' "$json_out" | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
fi
# --needs-me --json: the waiting-user session appears with its attention reason.
needs_json="$("$AE" list --needs-me --json 2>/dev/null)"
assert_contains "json: --needs-me digest flags attention" '"attention":"waiting-user"' "$needs_json"
assert_contains "json: --needs-me digest marks needs_attention" '"needs_attention":true' "$needs_json"

# --needs-me implies running-only (codex IMPORTANT): combining with --all must
# not leak stopped rows. (test-resume from Test 2 is a stopped session here.)
allneeds_output="$("$AE" list --all --needs-me 2>/dev/null)"
assert_contains "list: --all --needs-me still shows the needing session" "test-state" "$allneeds_output"
assert_eq "list: --all --needs-me does not leak stopped rows" "0" \
    "$(echo "$allneeds_output" | grep -c 'stopped')"

# Once it goes back to working, --needs-me no longer lists it.
printf '{"ts":"2026-05-29T10:03:00Z","actor":"%s","action":"state","ref":"working","summary":"resumed"}\n' "$main_agent" >>"$STATE_EVENTS"
needs_output="$("$AE" list --needs-me 2>/dev/null)"
assert_eq "list: --needs-me drops the session once it is working again" "0" \
    "$(echo "$needs_output" | grep -c 'test-state')"

# Default view shows the running session.
assert_contains "list: default shows the running session" "test-state" \
    "$("$AE" list 2>/dev/null)"

# say helper: emits a chat event, preserving an embedded newline as escaped \n
# on a single JSON line (the events.jsonl one-object-per-line invariant).
state_main_pane="$(tmux list-panes -t test-state -F '#{pane_id} #{@ae_agent}' | awk -v a="$main_agent" '$2==a {print $1; exit}')"
TMUX_PANE="$state_main_pane" "$HOME/.ae/sessions/test-state/say" "$(printf 'hello from say\nsecond line')" >/dev/null 2>&1
# LAST-MATCH LOOKUPS READ THE FILE AND KEEP THE LAST LINE — never `tac | grep -m1`.
# `grep -m1` exits on its first match and closes the pipe under `tac`; if `tac` is still
# writing it takes SIGPIPE, `pipefail` makes the pipeline 141, and `set -e` kills the whole
# suite with no failing assertion and no summary. It fires only when the log is large
# enough not to fit the pipe buffer, which is why it read as a random flake (#37).
# `grep ... | tail -1` has the same semantics, never exits early, and drops raw `tac`
# (GNU-only) as a bonus.
say_line="$(grep '"action":"chat"' "$STATE_EVENTS" 2>/dev/null | tail -1 || true)"
assert_contains "say: emits a chat event" '"action":"chat"' "$say_line"
assert_contains "say: chat event carries the message" 'hello from say' "$say_line"
assert_contains "say: embedded newline kept as escaped \\n on one line" 'say\nsecond' "$say_line"
assert_eq "say: chat event is exactly one JSON line" "1" \
    "$(tac "$STATE_EVENTS" 2>/dev/null | grep -c '"action":"chat"')"

# Stop it (kill tmux session, keep meta) → default omits it, --all/--stopped include it.
tmux kill-session -t test-state 2>/dev/null || true
sleep 0.5
assert_eq "list: default hides the stopped session" "0" \
    "$("$AE" list 2>/dev/null | grep -c 'test-state')"
assert_contains "list: --all includes the stopped session" "test-state" \
    "$("$AE" list --all 2>/dev/null)"
assert_contains "list: --stopped includes the stopped session" "test-state" \
    "$("$AE" list --stopped 2>/dev/null)"
# --stopped --needs-me is running-only by implication → the now-stopped session
# is not shown (stopped sessions can't need you).
assert_eq "list: --stopped --needs-me does not show the stopped session" "0" \
    "$("$AE" list --stopped --needs-me 2>/dev/null | grep -c 'test-state')"

# --json over stopped/all sessions must stay valid JSON (regression for the
# set -u undeclared-map crash codex caught). A stopped session has agent rows.
assert_contains "json: --stopped digest includes the stopped session" '"name":"test-state"' \
    "$("$AE" list --stopped --json 2>/dev/null)"
assert_contains "json: stopped agents render alive false" '"alive":false' \
    "$("$AE" list --stopped --json 2>/dev/null)"
if command -v python3 >/dev/null 2>&1; then
    assert_eq "json: --stopped output is valid JSON" "ok" \
        "$("$AE" list --stopped --json 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
    assert_eq "json: --all output is valid JSON" "ok" \
        "$("$AE" list --all --json 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
fi
fi

# ── P1: `ae end` resolves the target BEFORE the destructive prompt ───
# shellcheck disable=SC2016 # the backticks are LITERAL text in a label, not
# a substitution: single quotes are the fix here, not the finding (see _itest_names).
if _itest_section 'P1: `ae end` resolves the target BEFORE the destructive prompt'; then
# Bug (Clemens 2026-07-21): `ae end <bogus>` PROMPTED the destructive confirm, then
# said "not found" after y. A nonexistent target must error with NO prompt. This is a
# CALLER PROBE (round-6 lesson: source text cannot prove a runtime order). Feed 'y' so
# that a lingering prompt WOULD consume it and proceed — a correct impl errors first.
# Capture output+rc WITHOUT aborting: these commands are EXPECTED to exit nonzero, and
# `x="$(cmd)"` under the suite's `set -euo pipefail` would take that nonzero and abort
# the whole run (AGENTS.md set-e hazard). The if/else keeps errexit from firing.
if end_bogus_out="$(printf 'y\n' | "$AE" end this-name-does-not-exist-xyz 2>&1)"; then
    end_bogus_rc=0
else
    end_bogus_rc=$?
fi
assert_eq "end bogus: exits nonzero" "1" "$([[ $end_bogus_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "end bogus: reports not found" "not found" "$end_bogus_out"
assert_eq "end bogus: does NOT prompt before resolving" "1" \
    "$([[ "$end_bogus_out" != *"Continue?"* && "$end_bogus_out" != *"Commits + pushes"* \
        && "$end_bogus_out" != *"Removes ae state"* ]] && echo 1 || echo 0)"
# Slash-bearing name → same not-found path, no prompt (traversal guard preserved).
if end_slash_out="$(printf 'y\n' | "$AE" end ../evil 2>&1)"; then
    end_slash_rc=0
else
    end_slash_rc=$?
fi
assert_eq "end slashed name: nonzero and no prompt" "1" \
    "$([[ $end_slash_rc -ne 0 && "$end_slash_out" != *"Continue?"* ]] && echo 1 || echo 0)"
fi

# ── P1 review B2: dot-component targets are rejected before any prompt ─
if _itest_section 'P1 review B2: dot-component targets are rejected before any prompt'; then
# `.` and `..` have no '/', so the slash guard alone accepted them and `ae end ..`
# prompted on `sessions/../` (a real dir → classified 'stopped'). Reject dot
# components at the same guard.
for dotname in . ..; do
    if end_dot_out="$(printf 'y\n' | "$AE" end "$dotname" 2>&1)"; then dot_rc=0; else dot_rc=$?; fi
    assert_eq "end '$dotname': nonzero and NO prompt (dot-component rejected)" "1" \
        "$([[ $dot_rc -ne 0 && "$end_dot_out" != *"Continue?"* && "$end_dot_out" != *"Removes ae state"* ]] && echo 1 || echo 0)"
done
fi

# ── P1 review B1: `ae end <prefix>` must not touch a live neighbour ───
# shellcheck disable=SC2016 # the backticks are LITERAL text in a label, not
# a substitution: single quotes are the fix here, not the finding (see _itest_names).
if _itest_section 'P1 review B1: `ae end <prefix>` must not touch a live neighbour'; then
# tmux -t PREFIX-MATCHES: with `lifeproj` live, `ae end lifepro` used to classify live
# (has-session -t lifepro matched lifeproj), prompt, and could kill lifeproj. Resolve
# the EXACT session id; a prefix that is not an exact session/dir is not-found.
REPO_B1="$(setup_repo)"
(cd "$REPO_B1" && "$AE" --local lifeproj &) 2>/dev/null
wait_for_session "lifeproj"
if end_pfx_out="$(printf 'y\n' | "$AE" end lifepro 2>&1)"; then end_pfx_rc=0; else end_pfx_rc=$?; fi
assert_eq "end prefix: 'lifepro' errors, no prompt (exact match required)" "1" \
    "$([[ $end_pfx_rc -ne 0 && "$end_pfx_out" != *"Continue?"* ]] && echo 1 || echo 0)"
assert_eq "end prefix: the live neighbour 'lifeproj' is STILL ALIVE (not prefix-killed)" "1" \
    "$(tmux has-session -t '=lifeproj' 2>/dev/null && echo 1 || echo 0)"
"$AE" end -f lifeproj 2>/dev/null || true
# Poll until fully torn down — a leaked lifeproj dir surfaces as an orphan in the
# doctor-orphan test far below (teardown can lag under full-suite contention).
for _i in $(seq 1 20); do tmux has-session -t "=lifeproj" 2>/dev/null || break; sleep 0.3; done
"$AE" end -f lifeproj 2>/dev/null || true
fi

# ── P1: truthful prompt + stopped-dir end-by-name regression ─────────
if _itest_section 'P1: truthful prompt + stopped-dir end-by-name regression'; then
# test-state is a LOCAL, now-STOPPED session. Ending it removes leftover state with NO
# commit/push (local never pushes) — the prompt must not claim otherwise, and the
# stopped-dir path must still end it (the elif we hoist resolution past).
if end_stopped_out="$(printf 'y\n' | "$AE" end test-state 2>&1)"; then
    end_stopped_rc=0
else
    end_stopped_rc=$?
fi
assert_eq "end stopped local: succeeds (stopped-dir path preserved through the hoist)" "1" \
    "$([[ $end_stopped_rc -eq 0 ]] && echo 1 || echo 0)"
assert_eq "end stopped local: prompt does NOT claim a push (local never pushes)" "1" \
    "$([[ "$end_stopped_out" != *"Commits + pushes"* ]] && echo 1 || echo 0)"
assert_not_exists "end stopped local: session dir removed" "$HOME/.ae/sessions/test-state"

# Clean up (already ended above; harmless if so)
"$AE" end -f test-state 2>/dev/null || true
sleep 0.5
fi

# ── P1 review B1: end a session on a DIFFERENT tmux server (named-server) ──
if _itest_section 'P1 review B1: end a session on a DIFFERENT tmux server (named-server)'; then
# `_ae_session_id` lists only the AMBIENT server. A session live on a NAMED server, ended
# from a shell whose ambient server is different, was misclassified as stopped: rc0, its
# state deleted, the agent left ALIVE (orphaned). The end path must resolve the target's
# OWN server from meta and target its exact id there. Server B here is the harness ambient
# ("$AE_TMUX_SERVER"); server A is a distinct one the session actually runs on.
SRV_A="ae-nsrv-$$"
REPO_NS="$(setup_repo)"
(cd "$REPO_NS" && AE_TMUX_SERVER="$SRV_A" "$AE" --local nsrv &) 2>/dev/null
for _i in $(seq 1 25); do command tmux -L "$SRV_A" has-session -t nsrv 2>/dev/null && break; sleep 0.4; done
# Wait for the META too, not just the tmux session: the session comes up on server A
# before its dir/meta (with tmux_server=A) is written, and `ae end` resolves the target
# server FROM meta — ending in that window would (correctly) fail to find it. This is a
# test-setup race, not the behavior under test.
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/nsrv/meta" ]] && break; sleep 0.3; done
assert_eq "end named-server: session came up on server A with meta" "1" \
    "$([[ -f "$HOME/.ae/sessions/nsrv/meta" ]] && command tmux -L "$SRV_A" has-session -t "=nsrv" 2>/dev/null && echo 1 || echo 0)"
# End from the harness ambient server (B, != A). Must resolve A from meta and kill there.
# Poll: retry the end until the agent is actually gone (teardown can lag under load).
for _i in $(seq 1 20); do
    command tmux -L "$SRV_A" has-session -t "=nsrv" 2>/dev/null || break
    "$AE" end -f nsrv 2>/dev/null || true
    sleep 0.4
done
assert_eq "end named-server: the agent is KILLED on its own server (not orphaned)" "1" \
    "$(command tmux -L "$SRV_A" has-session -t "=nsrv" 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "end named-server: state removed" "$HOME/.ae/sessions/nsrv"
command tmux -L "$SRV_A" kill-server 2>/dev/null || true
fi

# ── 2nd-delta B1 MIRROR: DEFAULT-server target, ended from a NAMED-ambient shell ──
if _itest_section '2nd-delta B1 MIRROR: DEFAULT-server target, ended from a NAMED-ambient shell'; then
# The symmetric case: a session whose meta records an EMPTY tmux_server (= the default
# socket) ended from a shell with a NAMED ambient AE_TMUX_SERVER. Empty must resolve the
# pinned default socket, never the ambient shim and never inherited $TMUX.
# ISOLATION (3rd review B4): the REAL default server must never be touched — probing it
# live is how the fleet died once. AE_TMUX_DEFAULT_SOCKET points "default" at a mock
# socket; the session is launched on that mock via AE_TMUX_SERVER, then its meta's
# tmux_server line is BLANKED (fixture surgery: this is exactly what a default-server
# session's meta looks like), so the end path must resolve empty → the mock default.
DEFMOCK="ae-defmock-$$"
REPO_DEF="$(setup_repo)"
(cd "$REPO_DEF" && AE_TMUX_SERVER="$DEFMOCK" "$AE" --local dsrv &) 2>/dev/null
for _i in $(seq 1 25); do command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && break; sleep 0.4; done
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/dsrv/meta" ]] && break; sleep 0.3; done
_sed_i -e 's/^tmux_server=.*/tmux_server=/' -e '/^tmux_server_kind=/d' "$HOME/.ae/sessions/dsrv/meta"
assert_eq "end default-mock: session live on the mock-default with EMPTY meta server" "1" \
    "$([[ "$(sed -n 's/^tmux_server=//p' "$HOME/.ae/sessions/dsrv/meta")" == "" ]] \
        && command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && echo 1 || echo 0)"
# Option-B invariant: a BLANK record never queries any server — not even the pinned
# default. Plain end fails closed; the explicit AE_END_SERVER override (typed by shape,
# a name here) is the resolution, and it must ignore ambient + inherited $TMUX.
if TMUX="$TMUX_SOCK_DIR/ae-elsewhere-$$,999,0" AE_TMUX_SERVER="ae-mirror-$$" \
    AE_TMUX_DEFAULT_SOCKET="$DEFMOCK" "$AE" end -f dsrv >/dev/null 2>&1; then dm_rc=0; else dm_rc=$?; fi
assert_eq "end default-mock (invariant): blank record fails closed — default is NOT queried" "1" \
    "$([[ $dm_rc -ne 0 ]] && command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && echo 1 || echo 0)"
for _i in $(seq 1 20); do
    command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null || break
    TMUX="$TMUX_SOCK_DIR/ae-elsewhere-$$,999,0" AE_TMUX_SERVER="ae-mirror-$$" \
        AE_END_SERVER="$DEFMOCK" "$AE" end -f dsrv 2>/dev/null || true
    sleep 0.4
done
assert_eq "end default-mock (invariant): AE_END_SERVER override ends it on the RIGHT server" "1" \
    "$(command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "end default-mock (invariant): state removed" "$HOME/.ae/sessions/dsrv"
command tmux -L "$DEFMOCK" kill-server 2>/dev/null || true
fi

# ── 4th review B1: launch INSIDE a foreign tmux pane records the REAL server ──
if _itest_section '4th review B1: launch INSIDE a foreign tmux pane records the REAL server'; then
# AE_TMUX_SERVER unset + $TMUX inherited → the session lands on the pane's server; meta
# must record THAT server, not "" (which every exact-server consumer reads as default).
FOREIGN="ae-foreign-$$"
REPO_FOR="$(setup_repo)"
command tmux -L "$FOREIGN" new-session -d -s host 2>/dev/null
command tmux -L "$FOREIGN" send-keys -t host \
