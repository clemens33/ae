        AE_BUNDLE="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}.tar.gz" \
        AE_SUMS="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}-SHA256SUMS" \
        AE_INSTALL_TEST_FAIL_AFTER=pause-mkdir-versions \
        AE_INSTALL_TEST_RELEASE="$P5I_C102_REL" \
        "${BASH:-bash}" "$P5I_SRC/install" >/dev/null 2>"$P5I_C102_ERR" || _c102_rc=$?
    printf '%s\n' "$_c102_rc" >"$P5I_C102_RC"
) &
P5I_C102_BG=$!
P5I_C102_I=0
while [ "$P5I_C102_I" -lt 200 ]; do
