# ── _aewatch_autostart_if_available behavior (slice 18) ────────────────
# Extract the hook to a file and run it in a controlled env: a FAKE sidecar under a temp
# $0 dir (records its `up` argv), a stubbed daemon_session_running, and a controlled
# heartbeat. Proves start / silent no-op / existing-session fast path / STALE-restart.
_AW_HOOK="$TMPDIR/aw-hook.sh"
{
    # _ae_stat too: the fresh-heartbeat fast path reads the heartbeat's mtime
    # through it, and a missing definition breaks the age arithmetic — the hook
    # then starts a SECOND daemon on top of a live one.
    awk '/^_ae_stat\(\) \{/,/^\}$/' "$AE"
    awk '/^_aewatch_autostart_if_available\(\) \{/{f=1} f{print} f&&/^\}$/{exit}' "$AE"
} >"$_AW_HOOK"

# _aw_run <running_rc> <heartbeat: none|fresh|stale> <no_autostart> [no_sidecar] [impl]
# echoes "invoked:<recorded argv>" or "noop". impl defaults to uv (the opt-in that ARMS
# the hook); any other value / empty must be a no-op (the exclusivity opt-in gate).
_aw_run() {
    local running_rc="$1" hb="$2" noauto="$3" no_sidecar="${4:-}" impl="${5-uv}"
    local d; d="$(mktemp -d "$TMPDIR/aw.XXXXXX")"
    mkdir -p "$d/home/aewatch"
    if [[ -z "$no_sidecar" ]]; then
        mkdir -p "$d/contrib/aewatch"
        cat > "$d/contrib/aewatch/aewatch" <<'FAKE'
#!/usr/bin/env python3
import sys, pathlib
pathlib.Path(sys.argv[0] + ".rec").write_text(" ".join(sys.argv[1:]))
FAKE
        chmod +x "$d/contrib/aewatch/aewatch"
    fi
    case "$hb" in
        fresh) : > "$d/home/aewatch/heartbeat" ;;
        stale) : > "$d/home/aewatch/heartbeat"; _touch_ago 7200 "$d/home/aewatch/heartbeat" ;;
    esac
    cat > "$d/wrapper" <<WRAP
#!/usr/bin/env bash
AE_NO_AUTOSTART=$noauto
AE_WATCHDOG_IMPL=$impl
CONFIG_DIR="$d/home"
daemon_session_running() { return $running_rc; }
source "$_AW_HOOK"
_aewatch_autostart_if_available
WRAP
    "${BASH:-bash}" "$d/wrapper" >/dev/null 2>&1
    # Poll, don't sleep-and-hope: the hook backgrounds `uv run`, whose first-run
    # bootstrap can exceed a fixed 0.3s (measured ~0.4s on macOS) — a flake that
    # reads as "the hook never fired".
    for _i in $(seq 1 25); do
        [[ -f "$d/contrib/aewatch/aewatch.rec" ]] && break
        sleep 0.2
    done
    if [[ -f "$d/contrib/aewatch/aewatch.rec" ]]; then
        echo "invoked:$(cat "$d/contrib/aewatch/aewatch.rec")"
    else
        echo "noop"
    fi
}

_AW_START="$(_aw_run 1 none 0)"   # not running, sidecar present, impl=uv -> start
assert_eq "aewatch-autostart: invokes up when available + not running (opt-in uv)" "yes" "$([[ "$_AW_START" == invoked:* ]] && echo yes || echo no)"
assert_eq "aewatch-autostart: passes up --ae-home + --runner" "yes" "$(grep -qE 'up --ae-home .* --runner (uv|python3)' <<<"$_AW_START" && echo yes || echo no)"
assert_eq "aewatch-autostart: silent no-op when sidecar script absent" "noop" "$(_aw_run 1 none 0 nosidecar)"
assert_eq "aewatch-autostart: no-op when running + FRESH heartbeat (fast path)" "noop" "$(_aw_run 0 fresh 0)"
assert_eq "aewatch-autostart: RESTARTS when running + STALE heartbeat (blocker guard)" "yes" "$([[ "$(_aw_run 0 stale 0)" == invoked:* ]] && echo yes || echo no)"
assert_eq "aewatch-autostart: AE_NO_AUTOSTART=1 skips" "noop" "$(_aw_run 1 none 1)"
# Exclusivity opt-in gate: WITHOUT AE_WATCHDOG_IMPL=uv the daemon must NOT start, even
# fully available + not running (default = bash watchdog only, no live double-run).
assert_eq "aewatch-autostart: no-op under AE_WATCHDOG_IMPL=bash (default path)" "noop" "$(_aw_run 1 none 0 '' bash)"
assert_eq "aewatch-autostart: no-op when AE_WATCHDOG_IMPL unset/empty" "noop" "$(_aw_run 1 none 0 '' '')"

# ── s19: Telegram bridge ownership / no-double-send (the MANDATORY guard test) ──
# All THREE bash-bridge revive paths (launch, reattach, watchdog _supervise) funnel through
# _telegram_autostart_if_enabled. Ownership is a DURABLE MARKER + fresh heartbeat (NOT env —
# a concurrent bash reviver never shares the uv-launcher's env). Drive the REAL
# _aewatch_owns_bridge + _telegram_autostart_if_enabled with stubbed lifecycle deps: a
# bridge-owner marker + FRESH heartbeat suppresses the bash bridge for ANY caller (codex's
# concurrent-revive assertion); marker+STALE or NO-marker leaves the bash fallback unchanged.
# (Stopping a RUNNING bash bridge is the aewatch daemon's handoff, tested aewatch-side.)
_TG_FNS="$TMPDIR/tg-fns.sh"
{
    # _ae_stat too: _aewatch_owns_bridge calls it for the heartbeat mtime, and a
    # missing definition makes the age arithmetic fail -> "not owned" -> a bash
    # bridge spawns under a live aewatch.
    awk '/^_ae_stat\(\) \{/,/^\}$/' "$AE"
    awk '/^_aewatch_owns_bridge\(\) \{/,/^\}$/' "$AE"
    awk '/^_telegram_autostart_if_enabled\(\) \{/,/^\}$/' "$AE"
} >"$_TG_FNS"

# _tg_run <marker: yes|no> <hb: none|fresh|stale> <bash_running_rc> -> spawned|nospawn
_tg_run() {
    local marker="$1" hb="$2" bashrc="$3" d
    d="$(mktemp -d "$TMPDIR/tg.XXXXXX")"
    mkdir -p "$d/aewatch"
    [[ "$marker" == yes ]] && : >"$d/aewatch/bridge-owner"
    case "$hb" in
        fresh) : >"$d/aewatch/heartbeat" ;;
        stale) : >"$d/aewatch/heartbeat"; _touch_ago 7200 "$d/aewatch/heartbeat" ;;
    esac
    cat >"$d/wrapper" <<WRAP
#!/usr/bin/env bash
CONFIG_DIR="$d"
_TELEGRAM_TMUX_SESSION="ae-telegram"
_telegram_daemon_running() { return $bashrc; }
_telegram_intent_enabled() { echo true; }
_telegram_intent_enabled_uncached() { echo true; }
_telegram_missing_deps() { :; }
_telegram_validate_token_file() { :; }
_telegram_control_lock_file() { echo "$d/lock"; }
_telegram_spawn_daemon() { echo spawned >"$d/spawned"; }
get_config() { :; }
source "$_TG_FNS"
_telegram_autostart_if_enabled
WRAP
    "${BASH:-bash}" "$d/wrapper" >/dev/null 2>&1
    { [[ -f "$d/spawned" ]] && echo spawned; } || echo nospawn
    rm -rf "$d"
}
# Concurrent-revive guard (the mandatory invariant, ae side): marker + fresh heartbeat
# suppresses the bash bridge even for a non-uv reviver (_supervise/reattach/launch).
assert_eq "s19: bridge-owner + fresh heartbeat -> NO bash bridge spawned (any caller)" "nospawn" "$(_tg_run yes fresh 1)"
# marker present but bash somehow already running: the guard still refuses a SECOND spawn.
assert_eq "s19: bridge-owner + fresh + bash already running -> no second spawn" "nospawn" "$(_tg_run yes fresh 0)"
# Fallback: aewatch died (STALE heartbeat) -> bash revives, single-sender restored.
assert_eq "s19: bridge-owner + STALE heartbeat -> bash bridge spawns (fallback revive)" "spawned" "$(_tg_run yes stale 1)"
# Default path zero-diff: no marker -> bash autostarts exactly as before.
assert_eq "s19: no marker + enabled -> bash bridge spawns (default path unchanged)" "spawned" "$(_tg_run no none 1)"

