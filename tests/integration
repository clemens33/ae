# #35: an EMPTY body is refused loudly at the helper — the shape that lost a verdict.
lp_empty_rc=0
"$HOME/.ae/sessions/test-leadpair/send" colead "" >/dev/null 2>&1 || lp_empty_rc=$?
assert_eq "empty-body (#35): send refuses an empty body instead of delivering a header" "1" \
    "$([[ "$lp_empty_rc" -ne 0 ]] && echo 1 || echo 0)"
lp_ws_rc=0
"$HOME/.ae/sessions/test-leadpair/send" colead "   " >/dev/null 2>&1 || lp_ws_rc=$?
assert_eq "empty-body (#35): whitespace-only is refused too" "1" \
    "$([[ "$lp_ws_rc" -ne 0 ]] && echo 1 || echo 0)"
# #35: a body far past the OLD argv ceiling (set-buffer carried 16000 and failed at
# 32000) is delivered and RECOVERABLE. Arrival is asserted at the sidecar rather than
# in the pane: these test panes run a shell, whose line discipline caps a single
# unbroken line — a real agent TUI reads raw and takes the whole thing (measured:
# 60004 chars staged exactly by codex).
lp_big="$(head -c 40000 </dev/zero | tr '\0' 'B')"
lp_big_rc=0
"$HOME/.ae/sessions/test-leadpair/send" colead "BIGSTART${lp_big}BIGEND" >/dev/null 2>&1 || lp_big_rc=$?
sleep 1
# `|| true`: this is an ASSIGNMENT FROM A PIPELINE, and a failing pipeline here
# aborts the whole suite under set -e instead of failing the assertion below — no
# summary, no FAIL line, no information. A seed must fail loudly, never vanish.
lp_big_file="$(command ls -t "$HOME/.ae/sessions/test-leadpair/messages"/*.txt 2>/dev/null | head -1 || true)"
assert_eq "large-body (#35): a 40KB message is delivered, not silently dropped" "0" "$lp_big_rc"
assert_eq "large-body (#35): the full body is recoverable from the session" "1" \
    "$(_n="$(wc -c <"${lp_big_file:-/nonexistent}" 2>/dev/null | tr -d ' ')"
       [[ -n "$_n" && "$_n" -ge 40000 ]] && echo 1 || echo 0)"
# #35: a request and its reply keep SEPARATE recovery artifacts. They share a request
# id by design, so a ref-named file let the reply overwrite the ask — and the ask's
# pointer then resolved to the reply's body.
lp_msgs="$HOME/.ae/sessions/test-leadpair/messages"
lp_before="$(command ls "$lp_msgs" 2>/dev/null | wc -l | tr -d ' ' || true)"
"$HOME/.ae/sessions/test-leadpair/send" colead "FIRST-DELIVERY-BODY" >/dev/null 2>&1 || true
"$HOME/.ae/sessions/test-leadpair/send" colead "SECOND-DELIVERY-BODY" >/dev/null 2>&1 || true
sleep 1
lp_after="$(command ls "$lp_msgs" 2>/dev/null | wc -l | tr -d ' ' || true)"
assert_eq "recovery (#35): each delivery gets its own artifact, none overwritten" "1" \
    "$([[ -n "$lp_before" && -n "$lp_after" && "$lp_after" -ge $((lp_before + 2)) ]] && echo 1 || echo 0)"
assert_eq "recovery (#35): both bodies survive side by side" "1|1" \
    "$(printf '%s|%s' \
        "$(command grep -rlq 'FIRST-DELIVERY-BODY' "$lp_msgs" 2>/dev/null && echo 1 || echo 0)" \
        "$(command grep -rlq 'SECOND-DELIVERY-BODY' "$lp_msgs" 2>/dev/null && echo 1 || echo 0)")"
# B glue cut 1: the internal `_send-deliver` entry is GONE — the core delivers a
# tracked request in-process, so there is no delivery-only shim to drive here. The
# properties that entry existed to prove are asserted through the SHIPPED helpers
# instead: an `ask` reaches the target's pane and records exactly one event, a plain
# `send` always records, and an event-only sink is recorded without a paste.
lp_ev="$HOME/.ae/sessions/test-leadpair/events.jsonl"
assert_eq "send-deliver: the internal delivery-only helper is not generated any more" "0" \
    "$([[ -e "$HOME/.ae/sessions/test-leadpair/_send-deliver" ]] && echo 1 || echo 0)"
"$HOME/.ae/sessions/test-leadpair/ask" colead "DELIVER-ONLY-BODY-7c1e" >/dev/null 2>&1 || true
sleep 1
assert_eq "ask: the paste reached the target's pane" "1" \
    "$([[ "$(tmux capture-pane -p -t "$lp_colead_pane" 2>/dev/null | tr -d '\n')" == *DELIVER-ONLY-BODY-7c1e* ]] && echo 1 || echo 0)"
assert_eq "ask: exactly one event is recorded for it (the core writes it, nothing double-books)" "1" \
    "$(command grep -c 'DELIVER-ONLY-BODY-7c1e' "$lp_ev" 2>/dev/null || true)"
# The ACTION depends on the caller's identity, and this rig deliberately has none:
# the suite runs from its own shell with no @ae_agent stamp, so the core takes its
# no-identity fallback and the delivery is recorded as a plain send. Either way it is
# recorded EXACTLY once, which is the property the retired internal entry existed to
# protect — its whole reason for printing a path instead of recording was that the
# core would write the event itself, and a second writer would double-book the ledger.
assert_eq "ask: the one event is an ask or the no-identity send, never both" "1" \
    "$(command grep 'DELIVER-ONLY-BODY-7c1e' "$lp_ev" 2>/dev/null |
        command grep -cE '"action":"(ask|send)"' || true)"
# The public `send` ALWAYS records, and no ambient variable can make it deliver
# silently — the switch that once selected a finisher is not a variable any more.
lp_amb_out="$(env _AE_DELIVER_ONLY=1 _ae_send_finish=helper_send_deliver_finish "$HOME/.ae/sessions/test-leadpair/send" colead "AMBIENT-SWITCH-BODY-7c1e" 2>/dev/null || true)"
sleep 1
assert_eq "send: an ambient deliver-only variable changes nothing — the send event is recorded" "1" \
    "$(command grep -q '"action":"send".*AMBIENT-SWITCH-BODY-7c1e' "$lp_ev" 2>/dev/null && echo 1 || echo 0)"
assert_eq "send: and no recovery path leaks onto stdout" "" "$lp_amb_out"
# An event-only sink is RECORDED, never pasted — and it is the core that decides so.
"$HOME/.ae/sessions/test-leadpair/send" telegram:x "SINK-BODY-7c1e" >/dev/null 2>&1 || true
sleep 1
assert_eq "send: an event-only sink is recorded" "1" \
    "$(command grep -c 'SINK-BODY-7c1e' "$lp_ev" 2>/dev/null || true)"
assert_eq "send: ...and never pasted into a pane" "0" \
    "$([[ "$(tmux capture-pane -p -t "$lp_colead_pane" 2>/dev/null | tr -d '\n')" == *SINK-BODY-7c1e* ]] && echo 1 || echo 0)"
unset lp_ev lp_amb_out
unset lp_msgs lp_before lp_after
unset lp_empty_rc lp_ws_rc lp_big lp_big_rc lp_big_file
# Rename regression (codex): under lead-pair the window-0 role name must SURVIVE a
# session rename (layout fact decides — even the nastiest case, a session named 'lead'),
# and status-left must refresh to the new name (it carries the session name now).
"$AE" rename test-leadpair lead >/dev/null 2>&1 || true
"$AE" rename lead test-leadpair2 >/dev/null 2>&1 || true
lp2_win0_name="$(tmux list-windows -t test-leadpair2 -F '#{window_index} #{window_name}' 2>/dev/null | awk '$1==0{print $2}')"
assert_eq "lead-pair rename: window 0 keeps role name 'leads' (survives rename, even session named 'lead')" "leads" "$lp2_win0_name"
lp2_status_left="$(tmux show-options -t test-leadpair2 -v status-left 2>/dev/null || true)"
assert_eq "lead-pair rename: status-left refreshed to the new session name" "[ae test-leadpair2] " "$lp2_status_left"
"$AE" end -f test-leadpair2 >/dev/null 2>&1 || true
"$AE" end -f test-leadpair >/dev/null 2>&1 || true
mv "$HOME/.ae/config.ls-bak" "$HOME/.ae/config"
fi

# ── #27: a pane command survives being re-run ────────────────────────
if _itest_section '#27: a pane command survives being re-run'; then
# The human /exits the TUI (to pick up a globally-updated MCP config, say) and
# arrow-ups the pane's command. It bakes `--session-id UUID` — creation semantics
# — so before the fix every re-run died with "Session ID <uuid> is already in
# use" and the conversation was unreachable. Stand-in for claude: --session-id
# is create-once and COLLIDES on a second create, --resume replays. The command
# must literally begin with "claude" — that prefix is what makes ae inject an
# upfront UUID at all — so it goes on PATH rather than being named absolutely.
#
# Since slice Z2 the pane command is not a script but the core entry
# `<core> _run <session-dir> <slot>`, and the re-run decision is the core's own:
# it reads the `launch.<slot>.started` marker it wrote before its first exec. So
# this drives exactly what the human's arrow-up would.
RR_BIN="$TMPDIR/bin27"
mkdir -p "$RR_BIN" "$TMPDIR/rr-state"
: >"$TMPDIR/rr.log"
{
    printf '#!/usr/bin/env bash\n'
    printf 'log=%q\n' "$TMPDIR/rr.log"
    printf 'state=%q\n' "$TMPDIR/rr-state"
    cat <<'RRSTUB'
mode=""; id=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --session-id) mode=create; id="$2"; shift 2 ;;
        --resume) mode=resume; id="$2"; shift 2 ;;
        *) shift ;;
    esac
done
case "$mode" in
    create)
        if [[ -e "$state/$id" ]]; then
            printf 'COLLIDE %s\n' "$id" >>"$log"
            echo "Error: Session ID $id is already in use." >&2
            exit 1
        fi
        : >"$state/$id"
        printf 'CREATE %s\n' "$id" >>"$log"
        ;;
    resume) printf 'RESUME %s\n' "$id" >>"$log" ;;
    *) printf 'NOID\n' >>"$log" ;;
esac
RRSTUB
} >"$RR_BIN/claude"
chmod 0755 "$RR_BIN/claude"
RR_REPO="$(setup_repo)"
mkdir -p "$RR_REPO/.ae"
cat >"$RR_REPO/.ae/config" <<'EOF'
[profiles]
stubclaude = "claude --model stub"

[roster]
stubclaude = stubclaude

[workspace]
main = stubclaude
layout = vertical
EOF
(cd "$RR_REPO" && PATH="$RR_BIN:$PATH" "$AE" --local rerun27 >/dev/null 2>&1 || true)
wait_for_session "rerun27"
sleep 2
RR_DIR="$HOME/.ae/sessions/rerun27"
RR_UUID="$(sed -n 's/^harness_session.main=//p' "$RR_DIR/meta" 2>/dev/null | head -1 || true)"
# The command the human would arrow up, composed the way the pane's is: the core
# meta pins, then `_run`, then this session and this slot.
RR_CORE="$(grep '^ae_core=' "$RR_DIR/meta" | cut -d= -f2- || true)"
assert_eq "#27: launch baked an upfront session id into meta" "1" \
    "$([[ "$RR_UUID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] && echo 1 || echo 0)"
assert_eq "#27: the pane's own first launch CREATED that session" "CREATE $RR_UUID" \
    "$(head -1 "$TMPDIR/rr.log" 2>/dev/null || true)"
# The marker is the discriminator, and it is `_run`'s own file — written before
# the exec of the first run, which is why the second run can see it.
assert_eq "#27: the first run left the started marker behind" "1" \
    "$([[ -e "$RR_DIR/launch.main.started" ]] && echo 1 || echo 0)"
# Re-run it exactly as the human would.
RR_ERR="$(PATH="$RR_BIN:$PATH" "$RR_CORE" _run "$RR_DIR" main 2>&1 >/dev/null || true)"
assert_eq "#27: re-running the pane command RESUMES the ORIGINAL id" "RESUME $RR_UUID" \
    "$(tail -1 "$TMPDIR/rr.log" 2>/dev/null || true)"
assert_eq "#27: ...and a second re-run still resumes it" "RESUME $RR_UUID" \
    "$(PATH="$RR_BIN:$PATH" "$RR_CORE" _run "$RR_DIR" main >/dev/null 2>&1 || true
       tail -1 "$TMPDIR/rr.log" 2>/dev/null || true)"
assert_eq "#27: the collision was never hit" "0" \
    "$(command grep -c '^COLLIDE ' "$TMPDIR/rr.log" 2>/dev/null || true)"
assert_contains "#27: the fallback announces itself" "re-run" "$RR_ERR"
"$AE" end -f rerun27 >/dev/null 2>&1 || true
unset RR_BIN RR_REPO RR_DIR RR_UUID RR_CORE RR_ERR
fi

# ── #28 boundary: ONE definition, in the runtime that calls it — RETIRED (final glue cut) ───
# 3 assertion(s) went with their subject: the tri-state liveness probe and its tmux error classifier moved into the core with the companions they gated (src/liveness.rs). No bash runtime calls them, so 'one definition, in the runtime that calls it' has no second runtime to be about.


# ── ROLLBACK: a failed launch must not leave debris behind ───────────
if _itest_section 'ROLLBACK: a failed launch must not leave debris behind'; then
# Driven through the REAL launch, not a stand-in. Since B glue cut 2 the launch
# is the core's and it publishes with std::fs, so the fault this section used to
# inject — a `chmod` earlier on PATH failing only for a launch script's temp —
# no longer reaches anything. Each arm now injects the fault ITS OWN branch
# needs; everything before that point (tmux session, panes, meta, every helper)
# is still built for real, which is the state the rollback has to undo.

# (a) FRESH launch: nothing here has history worth keeping, and anything left
# behind reclassifies the next `ae <name>` as a resume of debris — or lets the
# existing-session fast path attach to a session whose agent never started.
#
# THE FAULT: more worker seats than an 80x24 window can hold. The split fails
# partway down the roster, and that is a failure the core meets AFTER it has
# created the session directory — so `dir_created` is true and the FRESH branch
# is the one that runs. The resume arm's decoy cannot serve here: planting it
# means the directory already exists, which is by definition the other branch.
RB_REPO="$(setup_repo)"
mkdir -p "$RB_REPO/.ae"
{
    printf '[profiles]\ndummy = "bash"\n\n[roster]\nm = dummy\n'
    seq 0 24 | sed 's/^/w/;s/$/ = dummy/'
    printf '\n[workspace]\nmain = m\nworkers = %s\nlayout = vertical\n' \
        "$(seq 0 24 | sed 's/^/w/' | paste -sd, - | sed 's/,/, /g')"
} >"$RB_REPO/.ae/config"
rb_rc=0
rb_out="$( (cd "$RB_REPO" && _timeout 90 "$AE" --local rbfresh) 2>&1 )" || rb_rc=$?
assert_eq "rollback (fresh): ae exits non-zero" "1" "$([[ $rb_rc -ne 0 ]] && echo 1 || echo 0)"
# LIVENESS: absence assertions pass for free if the launch died somewhere else
# entirely, so pin that the injected fault is the one that fired AND that the
# rollback itself ran and took the fresh-launch branch.
assert_eq "rollback (fresh): the injected fault is the one that fired" "1" \
    "$([[ "$rb_out" == *"could not create a pane for worker"* ]] && echo 1 || echo 0)"
assert_eq "rollback (fresh): the rollback ran and took the FRESH branch" "1" \
    "$([[ "$rb_out" == *"session state removed"* && "$rb_out" == *"this launch created it"* ]] && echo 1 || echo 0)"
assert_eq "rollback (fresh): the tmux session is gone" "1" \
    "$(tmux has-session -t rbfresh 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "rollback (fresh): on-disk session state removed" "$HOME/.ae/sessions/rbfresh"
assert_eq "rollback (fresh): the lifecycle lock is free afterwards" "0" \
    "$(if command -v flock >/dev/null 2>&1; then
           (flock -n 7 || exit 1) 7>"$HOME/.ae/sessions/.lifecycle.rbfresh.lock"
           echo $?
       else echo 0; fi)"

# (b) RESUME: the tmux session goes, the session DIRECTORY stays — that
# conversation history belongs to the user, and the next attempt must resume it
# rather than silently start a fresh one.
#
# THE FAULT is a HELPER the core cannot publish. `write_helpers` symlinks each
# name to a temp beside it and renames over the destination, and a rename onto a
# non-empty DIRECTORY fails — it runs after the meta is published and after the
# session and its panes exist, which is exactly the state the rollback has to
# undo. (Before slice Z2 this arm planted <meta>/launch.<slot>.sh, published at
# the same point; that artifact is gone and the helper publish replaced it.)
# Here the session directory predates the attempt, so the rollback must KEEP it.
RB_REPO2="$(setup_repo)"
(cd "$RB_REPO2" && "$AE" --local rbresume &) 2>/dev/null
wait_for_session "rbresume"
sleep 1
"$AE" stop rbresume >/dev/null 2>&1 || true
sleep 0.5
rm -f "$HOME/.ae/sessions/rbresume/peek"
mkdir -p "$HOME/.ae/sessions/rbresume/peek"
: >"$HOME/.ae/sessions/rbresume/peek/decoy"
rb2_rc=0
rb2_out="$( (cd "$RB_REPO2" && _timeout 90 "$AE" rbresume) 2>&1 )" || rb2_rc=$?
assert_eq "rollback (resume): ae exits non-zero" "1" "$([[ $rb2_rc -ne 0 ]] && echo 1 || echo 0)"
assert_eq "rollback (resume): the rollback ran and took the RESUME branch" "1" \
    "$([[ "$rb2_out" == *"rolling back 'rbresume'"* && "$rb2_out" == *"state KEPT"* ]] && echo 1 || echo 0)"
assert_eq "rollback (resume): the tmux session is gone" "1" \
    "$(tmux has-session -t rbresume 2>/dev/null && echo 0 || echo 1)"
assert_eq "rollback (resume): on-disk state PRESERVED (history is the user's)" "1" \
    "$([[ -f "$HOME/.ae/sessions/rbresume/meta" ]] && echo 1 || echo 0)"
assert_eq "rollback (resume): the lifecycle lock is free afterwards" "0" \
    "$(if command -v flock >/dev/null 2>&1; then
           (flock -n 7 || exit 1) 7>"$HOME/.ae/sessions/.lifecycle.rbresume.lock"
           echo $?
       else echo 0; fi)"
rm -rf "$HOME/.ae/sessions/rbresume/peek"
"$AE" end -f rbresume >/dev/null 2>&1 || true

# (c) SPAWN: the window/pane and the meta registration both precede the launch,
# so a failure that simply returned would leave a roster entry with an empty
# pane — addressable by every helper, retirable only by hand.
RB_REPO3="$(setup_repo)"
(cd "$RB_REPO3" && "$AE" --local rbspawn &) 2>/dev/null
wait_for_session "rbspawn"
sleep 1
# THE FAULT, injected where the core's spawn can still roll back: the re-run
# marker for the slot it is creating. Since slice Z2 that marker is the
# create-vs-resume discriminator, so spawn CLEARS it as a hard error rather than
# best-effort — a slot whose stale marker survived would be RESUMED into a
# conversation that does not exist. `remove_file` cannot take a non-empty
# DIRECTORY, so this decoy fails the clear AFTER the seat is reserved and the pane
# exists, which is exactly the state the rollback has to undo. A brief that fails
# to deliver would NOT do: the core treats pane-created and brief-delivered as
# different truths and records spawn-failed rather than rolling back, by design.
mkdir -p "$HOME/.ae/sessions/rbspawn/launch.spawned.0.started"
: >"$HOME/.ae/sessions/rbspawn/launch.spawned.0.started/decoy"
rb3_rc=0
rb3_out="$(_timeout 90 "$HOME/.ae/sessions/rbspawn/spawn" rbworker --using dummy2 "brief" 2>&1)" || rb3_rc=$?
assert_eq "rollback (spawn): the spawn reports failure" "1" "$([[ $rb3_rc -ne 0 ]] && echo 1 || echo 0)"
assert_eq "rollback (spawn): the rollback ran and said so" "1" \
    "$([[ "$rb3_out" == *"spawn rolled back"* ]] && echo 1 || echo 0)"
assert_eq "rollback (spawn): no phantom agent registered in meta" "0" \
    "$(command grep -cE '^(seat|profile|agent_bin|harness_session)\.spawned\.' "$HOME/.ae/sessions/rbspawn/meta" 2>/dev/null || true)"
# One SEAT, the main one. @ae_agent is a bare NAME under identity v2, and the monitor
# panes carry one as well, so the seat count reads @ae_slot — see the note in Test 4.
assert_eq "rollback (spawn): no orphan agent pane left in the session" "1" \
    "$(tmux list-panes -s -t rbspawn -F '#{@ae_slot}' 2>/dev/null | command grep -c . || true)"
# The decoy directory is the TEST's and stays; what the rollback owns is every
# other artifact of the slot it was creating — the codex first-message file and
# any temp a publisher left mid-write.
assert_eq "rollback (spawn): no slot artifact and no publish temp left behind" "0" \
    "$(command ls -a "$HOME/.ae/sessions/rbspawn" 2>/dev/null |
        command grep -c -e '^launch\.spawned\.0\.prompt$' -e '\.tmp\.' || true)"
rm -rf "$HOME/.ae/sessions/rbspawn/launch.spawned.0.started"
"$AE" end -f rbspawn >/dev/null 2>&1 || true

# (d) THE DELETION BOUNDARY. $SESSION becomes a directory name, and since the
# rollback landed that directory is also removed — so a name tmux happily accepts
# ('../victim', '../../.ssh') aimed an rm -rf outside the sessions root. The
# sentinel must be untouched whatever the launch then does.
mkdir -p "$HOME/.ae/rbvictim"
: >"$HOME/.ae/rbvictim/CANARY"
RB_REPO4="$(setup_repo)"
rb4_rc=0
rb4_out="$( (cd "$RB_REPO4" && _timeout 90 "$AE" --local ../rbvictim) 2>&1 )" || rb4_rc=$?
assert_eq "deletion boundary: a traversal name is refused" "1" "$([[ $rb4_rc -ne 0 ]] && echo 1 || echo 0)"
assert_eq "deletion boundary: refused as a NAME, before any side effect" "1" \
    "$([[ "$rb4_out" == *"invalid session name"* ]] && echo 1 || echo 0)"
assert_eq "deletion boundary: the sentinel OUTSIDE the sessions root survives" "1" \
    "$([[ -f "$HOME/.ae/rbvictim/CANARY" ]] && echo 1 || echo 0)"
assert_eq "deletion boundary: no tmux session was created for it" "1" \
    "$(tmux has-session -t ../rbvictim 2>/dev/null && echo 0 || echo 1)"
rm -rf "$HOME/.ae/rbvictim"

# (d2) TARGET-safety, not just path-safety. '.dotproject' passed the old
# blacklist: tmux CREATED the session, ae could not then address it ("can't find
# pane: dotproject"), and the failure landed BEFORE the rollback exists — a live
# orphan session plus a stranded .lifecycle..dotproject.lock. The allowlist must
# refuse before EITHER artifact is made, so both absences are asserted.
RB_REPO6="$(setup_repo)"
# shellcheck disable=SC2016  # these are hostile LITERALS, expansion is the point of refusing them
for _bad in '.dotproject' 'a;rm' 'has space' '#{pane_id}' '$HOME'; do
    _brc=0
    _bout="$( (cd "$RB_REPO6" && _timeout 60 "$AE" --local "$_bad") 2>&1 )" || _brc=$?
    assert_eq "target-safety [$_bad]: refused, no tmux session, no lock file" "1|1|1|1" \
        "$(printf '%s|%s|%s|%s' \
            "$([[ $_brc -ne 0 ]] && echo 1 || echo 0)" \
            "$([[ "$_bout" == *'invalid session name'* ]] && echo 1 || echo 0)" \
            "$(tmux has-session -t "$_bad" 2>/dev/null && echo 0 || echo 1)" \
            "$([[ ! -e "$HOME/.ae/sessions/.lifecycle.${_bad}.lock" ]] && echo 1 || echo 0)")"
done
# Nothing malformed was left in the sessions root by any of them. The NAME
# portion is what must satisfy the grammar — the surrounding ".lifecycle." and
# ".lock" carry dots of their own, so the whole filename never can.
assert_eq "target-safety: every lock file in the sessions root has a well-formed name" "0" \
    "$(_n=0
       for _lf in "$HOME/.ae/sessions"/.lifecycle.*.lock; do
           [[ -e "$_lf" ]] || continue
           _b="${_lf##*/}"
           _b="${_b#.lifecycle.}"
           _b="${_b%.lock}"
           [[ "$_b" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]] || _n=$((_n + 1))
       done
       echo "$_n")"
unset _bad _brc _bout

# (d3) THE REGRESSION THE VALIDATOR WOULD HAVE CAUSED. A no-name `ae` in a
# directory with a space used to derive a name its own validator refuses. Real
# launch, real derivation, no stubs.
NM_DIR="$TMPDIR/My Project (v2)"
mkdir -p "$NM_DIR"
git -C "$NM_DIR" init -q
git -C "$NM_DIR" config user.email "test@test"
git -C "$NM_DIR" config user.name "test"
git -C "$NM_DIR" commit -q --allow-empty -m init
(cd "$NM_DIR" && "$AE" --local &) 2>/dev/null
sleep 4
nm_name="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | command grep -E '^ae-.*My-Project' | head -1 || true)"
assert_eq "no-name launch: a space-bearing directory still launches" "1" \
    "$([[ -n "$nm_name" ]] && echo 1 || echo 0)"
assert_eq "no-name launch: ...under a name the validator itself accepts" "1" \
    "$([[ "$nm_name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]] && echo 1 || echo 0)"
assert_eq "no-name launch: and its session directory exists under the root" "1" \
    "$([[ -n "$nm_name" && -d "$HOME/.ae/sessions/$nm_name" ]] && echo 1 || echo 0)"
[[ -n "$nm_name" ]] && "$AE" end -f "$nm_name" >/dev/null 2>&1
unset NM_DIR nm_name

# (d4) THE PATH OBJECT, checked INDEPENDENTLY of the name. Every specimen here
# is GRAMMAR-VALID on purpose: an earlier version of this block used dotted
# names, so the grammar refused them before the symlink property was ever
# reached — the pins passed while a symlink named 'valid-name' walked through
# every boundary and a --delete followed it out of the sessions root. A pin must
# fail when ONLY the property under test is broken; these do.
#
# `ae transfer` was the third consumer of this guard and was ruled CUT in B glue
# cut 2, so the boundary is exercised through the two that remain: `ae rename`
# (source and target) and launch's existing-state path.
mkdir -p "$TMPDIR/outside-canary"
: >"$TMPDIR/outside-canary/CANARY"
# The symlink target is SESSION-SHAPED on purpose: without a meta a consumer can
# exit on its own existence check and the pin would pass without the path guard
# doing anything.
printf 'session=valid-name\nmode=local\norigin=%s\nwork_dir=%s\nschema=2\nseat.main=solo\nprofile.main=dummy\nagent_bin.main=bash\n' \
    "$TMPDIR" "$TMPDIR" >"$TMPDIR/outside-canary/meta"
mkdir -p "$HOME/.ae/sessions/real-dir"                          # physical: allowed
ln -s "$TMPDIR/outside-canary" "$HOME/.ae/sessions/valid-name"  # GRAMMATICAL symlink
ln -s "$TMPDIR/outside-canary/nope" "$HOME/.ae/sessions/dangling-name"
: >"$HOME/.ae/sessions/a-file"
# RENAME's SOURCE, over all three specimens: a symlink, a dangling symlink and a
# plain file are each a grammar-valid name whose PATH is not a directory.
# RENAME IS THE CORE'S at the final cut, and it kept the guard with its own
# wording. The SAFETY half is unchanged and is what these rows assert: all three
# shapes refuse, and nothing is renamed through them. The two SYMLINK shapes name
# the symlink explicitly, which is the message an operator can act on; the plain
# FILE is refused earlier, by the liveness check, because a file has no meta to be
# a running session — a weaker message for the same outcome, recorded here rather
# than smoothed over.
for _bad in 'valid-name' 'dangling-name'; do
    _trc=0
    _tout="$(_timeout 30 "$AE" rename "$_bad" "migrated-$_bad" 2>&1)" || _trc=$?
    assert_eq "rename [$_bad]: grammar-valid, refused on the PATH, and the symlink is named" "1|1" \
        "$(printf '%s|%s' \
            "$([[ $_trc -ne 0 ]] && echo 1 || echo 0)" \
            "$([[ "$_tout" == *'is a symlink'* ]] && echo 1 || echo 0)")"
done
_trc=0
_tout="$(_timeout 30 "$AE" rename 'a-file' 'migrated-a-file' 2>&1)" || _trc=$?
assert_eq "rename [a-file]: grammar-valid, still refused (earlier, and for a weaker reason)" "1|1" \
    "$(printf '%s|%s' \
        "$([[ $_trc -ne 0 ]] && echo 1 || echo 0)" \
        "$([[ "$_tout" == *"Error:"* ]] && echo 1 || echo 0)")"
# ...and its TARGET, which is the other half of the same guard.
assert_eq "rename: a grammar-valid SYMLINK is refused as a target too" "1" \
    "$(_o2="$("$AE" rename 'real-dir' 'valid-name' 2>&1)" || true
       [[ "$_o2" == *'is a symlink'* ]] && echo 1 || echo 0)"
assert_eq "path guard: the canary behind the grammatical symlink is untouched" "1" \
    "$([[ -f "$TMPDIR/outside-canary/CANARY" ]] && echo 1 || echo 0)"
# LAUNCH's existing-state path: same symlink, reached by an explicit name so the
# ownership check cannot be what refuses it.
LP_REPO="$(setup_repo)"
lp_rc=0
lp_out="$( (cd "$LP_REPO" && _timeout 60 "$AE" --local valid-name) 2>&1 )" || lp_rc=$?
assert_eq "launch: a symlinked session directory is refused before anything runs" "1|1|1" \
    "$(printf '%s|%s|%s' \
        "$([[ $lp_rc -ne 0 ]] && echo 1 || echo 0)" \
        "$([[ "$lp_out" == *'not a plain directory'* ]] && echo 1 || echo 0)" \
        "$(tmux has-session -t valid-name 2>/dev/null && echo 0 || echo 1)")"
assert_eq "launch: ...and the canary behind it is still there" "1" \
    "$([[ -f "$TMPDIR/outside-canary/CANARY" ]] && echo 1 || echo 0)"
# The control: a PHYSICAL directory of the same grammatical shape is accepted, so
# these pins cannot be passing merely because everything is refused.
assert_eq "control: a physical session directory is NOT refused on the path check" "0" \
    "$(_c="$(_timeout 30 "$AE" rename real-dir migrated-real 2>&1)" || true
       [[ "$_c" == *'not a plain directory'* ]] && echo 1 || echo 0)"
rm -rf "$HOME/.ae/sessions/real-dir" "$HOME/.ae/sessions/migrated-real" \
    "$TMPDIR/outside-canary" "$LP_REPO"
rm -f "$HOME/.ae/sessions/valid-name" "$HOME/.ae/sessions/dangling-name" "$HOME/.ae/sessions/a-file"
unset _bad _trc _tout _o2 _c LP_REPO lp_rc lp_out

# (d4c) DERIVED-NAME OWNERSHIP. A typed name means "that session, wherever I am";
# a DERIVED one means "the session for this directory", and the body is lossy
# ('A ~"B' and 'A#==B' both reduce to 'A-B'). The reviewer's pair, end to end:
# the second directory must NOT attach to the first one's session.
DN_ROOT="$TMPDIR/dnpair"
mkdir -p "$DN_ROOT/A ~\"B" "$DN_ROOT/A#==B"
for _d in "$DN_ROOT/A ~\"B" "$DN_ROOT/A#==B"; do
    git -C "$_d" init -q
    git -C "$_d" config user.email "test@test"
    git -C "$_d" config user.name "test"
    git -C "$_d" commit -q --allow-empty -m init
done
(cd "$DN_ROOT/A ~\"B" && "$AE" --local &) 2>/dev/null
sleep 4
dn1="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | command grep -E '^ae-.*A-B' | head -1 || true)"
(cd "$DN_ROOT/A#==B" && "$AE" --local &) 2>/dev/null
sleep 4
dn_all="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | command grep -cE '^ae-.*A-B' | tr -d '[:space:]' || true)"
dn2="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | command grep -E '^ae-.*A-B' | command grep -v "^${dn1}\$" | head -1 || true)"
assert_eq "derived pair: both directories launch, into DISTINCT sessions" "1|2|1" \
    "$(printf '%s|%s|%s' \
        "$([[ -n "$dn1" ]] && echo 1 || echo 0)" "$dn_all" \
        "$([[ -n "$dn2" && "$dn2" != "$dn1" ]] && echo 1 || echo 0)")"
"$AE" end -f "$dn1" >/dev/null 2>&1 || true
[[ -n "$dn2" ]] && "$AE" end -f "$dn2" >/dev/null 2>&1
# THE GUARD ITSELF. Plant a session under the name the second directory derives,
# owned by somewhere else — the state a real collision would produce — and prove
# a NO-NAME launch there refuses instead of silently joining it.
mkdir -p "$DN_ROOT/foreign" "$HOME/.ae/sessions/$dn2"
printf 'session=%s\norigin=%s\nwork_dir=%s\nmode=local\n' "$dn2" "$DN_ROOT/foreign" "$DN_ROOT/foreign" \
    >"$HOME/.ae/sessions/$dn2/meta"
dn_rc=0
dn_out="$( (cd "$DN_ROOT/A#==B" && _timeout 60 "$AE" --local) 2>&1 )" || dn_rc=$?
assert_eq "derived ownership: a foreign-owned derived name is REFUSED, with the 12-hex retry" "1|1|1" \
    "$(_retry="$(printf '%s\n' "$dn_out" | command grep -oE 'ae ae-[A-Za-z0-9_-]+' | head -1 | cut -d' ' -f2 || true)"
       printf '%s|%s|%s' \
        "$([[ $dn_rc -ne 0 ]] && echo 1 || echo 0)" \
        "$([[ "$dn_out" == *'derived name of a DIFFERENT directory'* ]] && echo 1 || echo 0)" \
        "$([[ "${_retry%-*}" == "${dn2%-*}" && ${#_retry} -eq $((${#dn2} + 6)) ]] && echo 1 || echo 0)")"
assert_eq "derived ownership: it did not attach — no session was created" "1" \
    "$(tmux has-session -t "$dn2" 2>/dev/null && echo 0 || echo 1)"
# A TYPED name is deliberately NOT ownership-checked: attaching from anywhere is
# the entire point of naming a session.
dn3_out="$( (cd "$DN_ROOT/A#==B" && _timeout 60 "$AE" --local "$dn2" >/dev/null) 2>&1 )" || true
assert_eq "derived ownership: a TYPED name is not ownership-checked" "0" \
    "$([[ "$dn3_out" == *'derived name of a DIFFERENT directory'* ]] && echo 1 || echo 0)"
"$AE" end -f "$dn2" >/dev/null 2>&1 || true
rm -rf "$HOME/.ae/sessions/$dn2"

# (d4d) OWNERSHIP COMPARES PLACES, NOT SPELLINGS. On macOS $TMPDIR already lives
# under a symlink (/var -> /private/var), so a stored origin written in canonical
# form and a $PWD written in the symlinked form are the same directory spelled two
# ways. A raw string compare refuses the RIGHTFUL owner and sends it to a
# duplicate; canonicalizing both sides is the fix, and these two pins fail if
# either side stops being canonicalized.
CN_DIR="$TMPDIR/canonproj"
mkdir -p "$CN_DIR"
git -C "$CN_DIR" init -q
git -C "$CN_DIR" config user.email "test@test"
git -C "$CN_DIR" config user.name "test"
git -C "$CN_DIR" commit -q --allow-empty -m init
(cd "$CN_DIR" && "$AE" --local &) 2>/dev/null
sleep 4
cn_name="$(tmux list-sessions -F '#{session_name}' 2>/dev/null | command grep -E 'canonproj' | head -1 || true)"
cn_meta="$HOME/.ae/sessions/${cn_name}/meta"
"$AE" stop "$cn_name" >/dev/null 2>&1 || true
sleep 0.5
# Spelling 1: the fully resolved path (what `pwd -P` gives).
cn_phys="$(cd "$CN_DIR" && pwd -P)"
_sed_i -e "s|^origin=.*|origin=${cn_phys}|" "$cn_meta"
cn_out1="$( (cd "$CN_DIR" && _timeout 60 "$AE" --local) 2>&1 )" || true
# Spelling 2: a trailing slash.
"$AE" stop "$cn_name" >/dev/null 2>&1 || true
sleep 0.5
_sed_i -e "s|^origin=.*|origin=${cn_phys}/|" "$cn_meta"
cn_out2="$( (cd "$CN_DIR" && _timeout 60 "$AE" --local) 2>&1 )" || true
assert_eq "ownership: a resolved-path origin and a trailing slash both still OWN it" "0|0" \
    "$(printf '%s|%s' \
        "$([[ "$cn_out1" == *'DIFFERENT directory'* ]] && echo 1 || echo 0)" \
        "$([[ "$cn_out2" == *'DIFFERENT directory'* ]] && echo 1 || echo 0)")"
# Control: a genuinely different place still refuses, so the pins above cannot be
# passing because the check was simply removed.
"$AE" stop "$cn_name" >/dev/null 2>&1 || true
sleep 0.5
mkdir -p "$TMPDIR/elsewhere"
_sed_i -e "s|^origin=.*|origin=$TMPDIR/elsewhere|" "$cn_meta"
cn_out3="$( (cd "$CN_DIR" && _timeout 60 "$AE" --local) 2>&1 )" || true
assert_eq "ownership control: a genuinely different origin is still refused" "1" \
    "$([[ "$cn_out3" == *'DIFFERENT directory'* ]] && echo 1 || echo 0)"
# (d4e) A RECORDED ORIGIN THAT NO LONGER RESOLVES FAILS CLOSED. The "a collision
# needs two live directories" argument holds only AT CREATION: the owner's
# directory can be deleted afterwards while its session state and conversation
# history persist, and a colliding live directory then lands exactly here.
# Assuming "moved" would resume a FOREIGN conversation. Refusing strands nothing,
# because the typed name is the deliberate bypass — pinned in both directions.
"$AE" stop "$cn_name" >/dev/null 2>&1 || true
sleep 0.5
_sed_i -e "s|^origin=.*|origin=$TMPDIR/vanished-owner|" "$cn_meta"
cn_out4="$( (cd "$CN_DIR" && _timeout 60 "$AE" --local) 2>&1 )" || true
assert_eq "ownership: an unresolvable recorded origin REFUSES the no-name launch" "1|1|1" \
    "$(printf '%s|%s|%s' \
        "$([[ "$cn_out4" == *'no longer exists'* ]] && echo 1 || echo 0)" \
        "$([[ "$cn_out4" == *"ae ${cn_name}"* ]] && echo 1 || echo 0)" \
        "$(tmux has-session -t "$cn_name" 2>/dev/null && echo 0 || echo 1)")"
# ...and the override the message names actually works: the SAME name, TYPED.
(cd "$CN_DIR" && "$AE" --local "$cn_name" &) 2>/dev/null
sleep 4
assert_eq "ownership: the typed name named in that message is a real bypass" "1" \
    "$(tmux has-session -t "$cn_name" 2>/dev/null && echo 1 || echo 0)"
# An EMPTY origin keeps the historical proceed-with-note: a pre-tracking session
# never recorded a claim there is anything to violate.
"$AE" stop "$cn_name" >/dev/null 2>&1 || true
sleep 0.5
_sed_i -e "/^origin=/d" "$cn_meta"
cn_out5="$( (cd "$CN_DIR" && _timeout 60 "$AE" --local) 2>&1 )" || true
assert_eq "ownership: a MISSING origin still proceeds, with the note" "1|0" \
    "$(printf '%s|%s' \
        "$([[ "$cn_out5" == *'pre-dates ownership tracking'* ]] && echo 1 || echo 0)" \
        "$([[ "$cn_out5" == *'no longer exists'* ]] && echo 1 || echo 0)")"
"$AE" end -f "$cn_name" >/dev/null 2>&1 || true
rm -rf "$CN_DIR" "$TMPDIR/elsewhere"
unset CN_DIR cn_name cn_meta cn_phys cn_out1 cn_out2 cn_out3 cn_out4 cn_out5
rm -rf "$DN_ROOT"
unset DN_ROOT dn1 dn2 dn_all dn_rc dn_out dn3_out _d

# (d5) RENAME is a CREATION boundary. Its old blacklist accepted 'has space' and
# returned 0, persisting a session that launch and resume then refused.
RN_REPO="$(setup_repo)"
(cd "$RN_REPO" && "$AE" --local rntest &) 2>/dev/null
wait_for_session "rntest"
sleep 1
rn_rc=0
rn_out="$("$AE" rename rntest 'has space' 2>&1)" || rn_rc=$?
assert_eq "rename: a target the launcher would refuse is refused here too" "1|1" \
    "$(printf '%s|%s' \
        "$([[ $rn_rc -ne 0 ]] && echo 1 || echo 0)" \
        "$([[ "$rn_out" == *'invalid session name'* ]] && echo 1 || echo 0)")"
assert_eq "rename: the original session is untouched by the refusal" "1" \
    "$(tmux has-session -t rntest 2>/dev/null && echo 1 || echo 0)"
assert_eq "rename: no directory was created for the refused name" "1" \
    "$([[ ! -d "$HOME/.ae/sessions/has space" ]] && echo 1 || echo 0)"
# ...and a valid rename still works.
"$AE" rename rntest rntest2 >/dev/null 2>&1 || true
assert_eq "rename: a grammatical target still renames" "1" \
    "$(tmux has-session -t rntest2 2>/dev/null && echo 1 || echo 0)"
"$AE" end -f rntest2 >/dev/null 2>&1 || true
"$AE" end -f rntest >/dev/null 2>&1 || true
unset RN_REPO rn_rc rn_out

# (e) OWNERSHIP, not RESUMING. A directory left by an earlier attempt that died
# before writing meta reads as a "fresh" launch — the old proxy would have
# deleted a directory this attempt never created.
# The fault is the resume arm's decoy, for the same reason: the launch must FAIL
# with the directory already there, or there is no rollback to classify.
mkdir -p "$HOME/.ae/sessions/rbpre/peek"
: >"$HOME/.ae/sessions/rbpre/peek/decoy"
: >"$HOME/.ae/sessions/rbpre/PREEXISTING"
RB_REPO5="$(setup_repo)"
rb5_rc=0
rb5_out="$( (cd "$RB_REPO5" && _timeout 90 "$AE" --local rbpre) 2>&1 )" || rb5_rc=$?
assert_eq "ownership: the launch still fails" "1" "$([[ $rb5_rc -ne 0 ]] && echo 1 || echo 0)"
assert_eq "ownership: a pre-existing directory is classified NOT ours and kept" "1" \
    "$([[ -f "$HOME/.ae/sessions/rbpre/PREEXISTING" ]] && echo 1 || echo 0)"
assert_eq "ownership: ...and the rollback said so rather than deleting" "1" \
    "$([[ "$rb5_out" == *"state KEPT"* && "$rb5_out" == *"predates this attempt"* ]] && echo 1 || echo 0)"
"$AE" end -f rbpre >/dev/null 2>&1 || true
rm -rf "$HOME/.ae/sessions/rbpre"
unset RB_REPO RB_REPO2 RB_REPO3 RB_REPO4 RB_REPO5 \
    rb_rc rb2_rc rb3_rc rb4_rc rb5_rc rb_out rb2_out rb3_out rb4_out rb5_out
fi

# ── #33: stop targets the RECORDED server by EXACT id, and verifies ──
if _itest_section '#33: stop targets the RECORDED server by EXACT id, and verifies'; then
# Measured on main before the fix: `ae stop <prefix>` returned rc=0, printed
# "Stopped <prefix>", and killed the LONGER-named session — tmux -t <name>
# prefix-matches. Each seed below is written so that ONLY its own property can
# make it pass.

# (a) PREFIX SIBLING. 'stopsib-project' is live; nothing named 'stopsib-proj'
# exists. The wrong-kill is the failure mode, so the sibling's survival is the
# assertion — not merely the exit code.
SS_REPO="$(setup_repo)"
(cd "$SS_REPO" && "$AE" --local stopsib-project &) 2>/dev/null
wait_for_session "stopsib-project"
sleep 1
ss_rc=0
ss_out="$("$AE" stop stopsib-proj 2>&1)" || ss_rc=$?
assert_eq "stop (a) prefix sibling: refused, and the LONGER-named session survives" "1|1" \
    "$(printf '%s|%s' \
        "$([[ $ss_rc -ne 0 ]] && echo 1 || echo 0)" \
        "$(tmux has-session -t "=stopsib-project" 2>/dev/null && echo 1 || echo 0)")"
assert_eq "stop (a): and it never claimed success" "0" \
    "$([[ "$ss_out" == *"Stopped"* ]] && echo 1 || echo 0)"

# (b) RECORDED SERVER, not the ambient one. The session lives on the suite's
# private server; stop is invoked with AE_TMUX_SERVER unset, so an ambient-server
# implementation cannot see it (pre-fix it said "is not running" and orphaned it).
ss2_rc=0
ss2_out="$(env -u AE_TMUX_SERVER "$AE" stop stopsib-project 2>&1)" || ss2_rc=$?
assert_eq "stop (b) recorded server: found and stopped from a foreign ambient server" "0|1|1" \
    "$(printf '%s|%s|%s' "$ss2_rc" \
        "$([[ "$ss2_out" == *"Stopped stopsib-project"* ]] && echo 1 || echo 0)" \
        "$(tmux has-session -t "=stopsib-project" 2>/dev/null && echo 0 || echo 1)")"
assert_eq "stop (b): session STATE preserved — stop destroys nothing" "1" \
    "$([[ -f "$HOME/.ae/sessions/stopsib-project/meta" ]] && echo 1 || echo 0)"
"$AE" end -f stopsib-project >/dev/null 2>&1 || true

# (c) UNVERIFIED KILL must never print "Stopped". The recorded socket is made
# unreadable, so the server can neither confirm nor deny — the tri-state's third
# arm. Same technique the ack-block seeds use.
SS_REPO3="$(setup_repo)"
SS_SRV="ae-stopunv-$$"
(cd "$SS_REPO3" && AE_TMUX_SERVER="$SS_SRV" "$AE" --local stopunv &) 2>/dev/null
for _i in $(seq 1 25); do command tmux -L "$SS_SRV" has-session -t "=stopunv" 2>/dev/null && break; sleep 0.4; done
sleep 1
chmod 000 "$TMUX_SOCK_DIR/$SS_SRV" 2>/dev/null || true
ss3_rc=0
ss3_out="$("$AE" stop stopunv 2>&1)" || ss3_rc=$?
chmod 700 "$TMUX_SOCK_DIR/$SS_SRV" 2>/dev/null || true
# NOTE what this actually reaches: with the socket unreadable the id lookup fails
# FIRST, so this is the PRE-kill unreachable branch. The post-kill arm of
# _lifecycle_kill_verified is unreachable from here without racing a server into
# unreachability mid-operation — it is pinned deterministically in tests/unit.
assert_eq "stop (c) unverifiable server (pre-kill branch): fails loudly, never prints Stopped" "1|1|0" \
    "$(printf '%s|%s|%s' \
        "$([[ $ss3_rc -ne 0 ]] && echo 1 || echo 0)" \
        "$([[ "$ss3_out" == *"cannot verify"* || "$ss3_out" == *"no positive server record"* ]] && echo 1 || echo 0)" \
        "$([[ "$ss3_out" == *"Stopped"* ]] && echo 1 || echo 0)")"
assert_eq "stop (c): everything preserved after the refusal" "1" \
    "$([[ -f "$HOME/.ae/sessions/stopunv/meta" ]] && echo 1 || echo 0)"
command tmux -L "$SS_SRV" kill-server 2>/dev/null || true
rm -rf "$HOME/.ae/sessions/stopunv"

# (d) SELF-STOP: the initiator pane dies with the session, so the supervisor —
# not the caller — must finish the job and record it. NOTE the limit of this seed,
# measured: it does NOT discriminate on detachment (it passes with nohup removed,
# because the post-kill window is milliseconds). Detachment is pinned structurally
# in tests/unit; this proves the FLOW end to end.
SS_REPO4="$(setup_repo)"
(cd "$SS_REPO4" && "$AE" --local stopself &) 2>/dev/null
wait_for_session "stopself"
sleep 2
ss_pane="$(tmux list-panes -t stopself -F '#{pane_id}' 2>/dev/null | head -1)"
tmux send-keys -t "$ss_pane" "AE_HOME=$AE_HOME $AE stop stopself -y" Enter
for _i in $(seq 1 50); do tmux has-session -t "=stopself" 2>/dev/null || break; sleep 0.4; done
sleep 2
ss_ev="$HOME/.ae/sessions/stopself/events.jsonl"
# TWO stop-request rows, ONE stop-result, and both counts are deliberate. A
# self-stop crosses a process boundary, so the intent is recorded TWICE by two
# different writers about two different facts: the dying caller records "ae was
# asked from inside this session" BEFORE the handover (so a human whose pane
# vanished can tell being asked from never being asked), and the detached
# supervisor records its own "stop requested" when it picks the work up. A
# supervisor that started and died leaves the first row without the second — the
# distinction the pair exists to make — so collapsing them would cost the
# diagnosis. The RESULT is single because there is one outcome.
assert_eq "stop (d) self-stop: session gone, both writers recorded, one outcome, state preserved" "1|2|1|1" \
    "$(printf '%s|%s|%s|%s' \
