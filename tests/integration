ID59_DEC_SP0="$(_id59_decode "$ID59_META/launch.spawned.0.sh")"
ID59_OC_W0="$(cat "$ID59_META/opencode.worker.0.md" 2>/dev/null || true)"
# The decode instrument must have decoded SOMETHING, or every count below reads 0 and the
