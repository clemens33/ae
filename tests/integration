cat >>"$HOME/.ae/sessions/test-sync/events.jsonl" <<'CANEV'
{"ts":"2026-08-01T00:03:00Z","actor":"ae:compact:op1","action":"ask","ref":"canary-withdrawn","target":"a:one","summary":"handover please"}
{"ts":"2026-08-01T00:04:00Z","actor":"ae:compact:op1","action":"cancel","ref":"canary-withdrawn","summary":"digest-only"}
{"ts":"2026-08-01T00:05:00Z","actor":"ae:compact:op2","action":"ask","ref":"canary-notyours","target":"a:one","summary":"still open"}
{"ts":"2026-08-01T00:06:00Z","actor":"someone:else","action":"cancel","ref":"canary-notyours","summary":"not yours"}
