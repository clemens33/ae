# REFUSES with the refresh/migrate instruction and records nothing — never a silent fallback
# to the ambient server, which is the mis-route the clean cut forbids.
tr_before="$(awk '/"action":"ask"/ { n++ } END { print n + 0 }' "$TR_A/events.jsonl")"
_sed_i -e 's|^tmux_server=.*|tmux_server=|' -e '/^tmux_server_kind=/d' "$TR_A/meta"
tr_bad_rc=0
tr_bad="$(AE_SENDER_OVERRIDE="ae:probe:tr" "$TR_A/ask" dummy "should refuse" 2>&1)" || tr_bad_rc=$?
assert_eq "tracked-resolution: a broken server pointer refuses" "1" "$([[ $tr_bad_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "tracked-resolution: and says to refresh or migrate the session" \
    "records no usable tmux server" "$tr_bad"
assert_eq "tracked-resolution: the refused ask recorded nothing new" "$tr_before" \
    "$(awk '/"action":"ask"/ { n++ } END { print n + 0 }' "$TR_A/events.jsonl")"
