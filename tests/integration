assert_contains "doctor orphan: hints resume-or-end" "finish teardown with 'ae end" "$doctor_orphan_out"
assert_contains "doctor orphan: an orphan is a WARN, not a FAIL (summary still 0 failures)" \
    "Summary: 0 failure(s)" "$doctor_orphan_out"
"$AE" end -f test-orphan 2>/dev/null || true
# With it ended, doctor no longer lists it (the orphan cleared).
