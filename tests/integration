# ── C102: ownership is recorded AFTER the syscall, never before ──────────
# The window is between the journal row that CLAIMS a directory and the mkdir
# that creates it. An operator (or a second installer) can create that exact
# path inside it — the install lock does not serialize direct operator writes.
# Recording ownership first makes the inverse remove a directory this install
# never created, which is the irreversible mistake; recording it after leaves a
# pending intent, and the inverse then preserves what it cannot prove is ours.
#
# The gate is ANY created_dir row naming the path, deliberately: that row exists
# in the record-first shape too, so ONE fixture drives both worlds and the only
# difference is what the row claims. Measured against install.pre-c102 (the same
# file with the two-state split reverted):
#   record-first  row=rmdir   dir REMOVED  inode NO   journal deleted
#   two-state     row=intent  dir SURVIVED inode yes  journal RETAINED
P5I_C102="$P5I_ROOT/c102home"
mkdir -p "$P5I_C102"
_p5i_make_bundle "$P5I_VER" "" 0555
P5I_C102_REL="$P5I_ROOT/c102.release"
P5I_C102_RC="$P5I_ROOT/c102.rc"
P5I_C102_ERR="$P5I_ROOT/c102.err"
rm -f "$P5I_C102_REL" "$P5I_C102_RC" "$P5I_C102_ERR"
P5I_C102_J="$P5I_C102/.ae/.ae-install.journal"
# The backgrounded installer gets its OWN error surface. A subshell that dies
# under errexit is silent, and its failure then surfaces as a wrong verdict
# about the product instead of about the fixture.
(
    _c102_rc=0
    HOME="$P5I_C102" AE_VERSION="$P5I_VER" TMPDIR="$P5I_TMP" \
        AE_BUNDLE="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}.tar.gz" \
        AE_SUMS="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}-SHA256SUMS" \
        AE_INSTALL_TEST_FAIL_AFTER=pause-mkdir-versions \
        AE_INSTALL_TEST_RELEASE="$P5I_C102_REL" \
        "${BASH:-bash}" "$P5I_SRC/install" >/dev/null 2>"$P5I_C102_ERR" || _c102_rc=$?
    printf '%s\n' "$_c102_rc" >"$P5I_C102_RC"
) &
P5I_C102_BG=$!
P5I_C102_I=0
while [ "$P5I_C102_I" -lt 200 ]; do
    if [ -f "$P5I_C102_J" ] && command grep -Fq "|$P5I_C102/.ae/versions" "$P5I_C102_J" 2>/dev/null; then
        break
    fi
    P5I_C102_I=$((P5I_C102_I + 1))
    sleep 0.05
done
assert_eq "C102: the fixture reached the journal row, so the plant is not vacuous" "1" \
    "$([[ "$P5I_C102_I" -lt 200 ]] && echo 1 || echo 0)"
P5I_C102_ROW="$(command grep -F "|$P5I_C102/.ae/versions" "$P5I_C102_J" 2>/dev/null | tail -1 |
    sed 's/^created_dir=//; s/|.*//')"
assert_eq "C102: the row inside the window is a pending INTENT, not ownership" "intent" "$P5I_C102_ROW"
P5I_C102_PLANT=0
mkdir "$P5I_C102/.ae/versions" 2>/dev/null && P5I_C102_PLANT=1
assert_eq "C102: the foreign directory was planted inside the window" "1" "$P5I_C102_PLANT"
P5I_C102_INO="$(_p5i_inode "$P5I_C102/.ae/versions")"
: >"$P5I_C102_REL"
wait "$P5I_C102_BG" 2>/dev/null || true
assert_eq "C102: the installer reported its own exit status" "1" \
    "$([[ -f "$P5I_C102_RC" ]] && echo 1 || echo 0)"
assert_eq "C102: the install exits nonzero — it could not create what it claimed" "1" \
    "$([[ "$(cat "$P5I_C102_RC" 2>/dev/null || echo 0)" -ne 0 ]] && echo 1 || echo 0)"
assert_eq "C102: the foreign directory SURVIVED the inverse" "1" \
    "$([[ -d "$P5I_C102/.ae/versions" ]] && echo 1 || echo 0)"
assert_eq "C102: ...and it is the SAME directory, not a recreated one" \
    "$P5I_C102_INO" "$(_p5i_inode "$P5I_C102/.ae/versions" 2>/dev/null || echo GONE)"
assert_eq "C102: nothing was published under the foreign directory" "0" \
    "$([[ -e "$P5I_C102/.ae/versions/$P5I_VER" ]] && echo 1 || echo 0)"
assert_eq "C102: the journal is RETAINED, so the inverse claimed no completion" "1" \
    "$([[ -f "$P5I_C102_J" ]] && echo 1 || echo 0)"
assert_eq "C102: the refusal is LOUD and names what it preserved" "1" \
    "$(command grep -q 'not provably ours' "$P5I_C102_ERR" && echo 1 || echo 0)"

# Control: directories this install DID create still reverse, and in reverse
# creation order. ~/.local and ~/.local/bin are nested and are both ours here,
# so a forward-order inverse would fail to rmdir the non-empty parent and keep
# the journal. Absent parent + deleted journal is the order proof.
P5I_C102C="$P5I_ROOT/c102ctrl"
mkdir -p "$P5I_C102C"
P5I_RC=0
HOME="$P5I_C102C" AE_VERSION="$P5I_VER" TMPDIR="$P5I_TMP" \
    AE_BUNDLE="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}.tar.gz" \
    AE_SUMS="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}-SHA256SUMS" \
    AE_INSTALL_TEST_FAIL_AFTER=link \
    "${BASH:-bash}" "$P5I_SRC/install" >/dev/null 2>&1 || P5I_RC=$?
assert_eq "C102 control: the late-boundary injection is nonzero" "1" \
    "$([[ "$P5I_RC" -ne 0 ]] && echo 1 || echo 0)"
assert_eq "C102 control: the nested link parent was removed CHILD FIRST" "0" \
    "$([[ -e "$P5I_C102C/.local" ]] && echo 1 || echo 0)"
# MEASURED asymmetry, pinned as behaviour and raised with the batch: the
# PUBLISHED version directory is retained (it is immutable and its members are
# re-verified byte-for-byte on the next run), while core/ — created by this
# install and left empty — is reversed like any other created directory.
assert_eq "C102 control: the published version directory is RETAINED" "1" \
    "$([[ -d "$P5I_C102C/.ae/versions/$P5I_VER" ]] && echo 1 || echo 0)"
assert_eq "C102 control: the empty core directory we created is reversed" "0" \
    "$([[ -e "$P5I_C102C/.ae/core" ]] && echo 1 || echo 0)"
assert_eq "C102 control: the journal is deleted — the inverse completed honestly" "0" \
    "$([[ -e "$P5I_C102C/.ae/.ae-install.journal" ]] && echo 1 || echo 0)"

# ── C51/C62/C67: the bundle triple refuses a MUTABLE EXTERNAL member ─────
# `-f` and `-x` both FOLLOW symlinks, so before this lift a version-dir member
# that was a symlink to a mutable external file passed every check and was then
# grepped or EXECUTED as if it were ours. Each arm swaps exactly one member and
# restores it, so the three reds are independent and the green control is the
# unmutated wrapper run at the top.
P5I_LIFT="$P5I_ROOT/lifthome"
mkdir -p "$P5I_LIFT"
_p5i_make_bundle "$P5I_VER"
P5I_RC=0
HOME="$P5I_LIFT" AE_VERSION="$P5I_VER" TMPDIR="$P5I_TMP" \
    AE_BUNDLE="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}.tar.gz" \
    AE_SUMS="$P5I_ROOT/ae-${P5I_VER}-${P5I_PLAT}-SHA256SUMS" \
    "${BASH:-bash}" "$P5I_SRC/install" >/dev/null 2>&1 || P5I_RC=$?
assert_eq "C51/C62/C67: the lift fixture installs" "0" "$P5I_RC"
P5I_VD="$P5I_LIFT/.ae/versions/$P5I_VER"
chmod u+w "$P5I_VD"
P5I_RC=0
HOME="$P5I_LIFT" "$P5I_LIFT/.local/bin/ae" _probe >/dev/null 2>&1 || P5I_RC=$?
assert_eq "C51/C62/C67 control: the unmutated bundle wrapper runs" "0" "$P5I_RC"

# C51 — sibling ae-core GONE, core/current pointed at an external SAME-VERSION
# core. Keying bundle mode off `[ -x ae-core ]` skipped the identity refusal
# entirely and this degraded silently into checkout semantics.
mkdir -p "$P5I_ROOT/extcore"
cp "$P5I_VD/ae-core" "$P5I_ROOT/extcore/ae-core"
chmod 0755 "$P5I_ROOT/extcore/ae-core"
mv "$P5I_VD/ae-core" "$P5I_ROOT/ae-core.away"
