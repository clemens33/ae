    "$(tmux has-session -t "=foalpha" 2>/dev/null && echo 0 || echo 1)"
assert_eq "stop all (caller is a target): the OTHER target is NOT abandoned" "1" \
    "$(tmux has-session -t "=fozeta" 2>/dev/null && echo 0 || echo 1)"
# ...and both outcomes are readable AFTERWARDS, which is the whole point of
# detaching: the pane that asked is gone, so the record is the only witness left.
assert_eq "stop all (caller is a target): both outcomes recorded durably" "1|1" \
    "$(printf '%s|%s' \
        "$(command grep -c '"action":"stop-result"' "$HOME/.ae/sessions/foalpha/events.jsonl" 2>/dev/null | tr -d '[:space:]')" \
        "$(command grep -c '"action":"stop-result"' "$HOME/.ae/sessions/fozeta/events.jsonl" 2>/dev/null | tr -d '[:space:]')")"
