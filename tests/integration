# ── ae transfer — phase 1 failure paths ──────────────────────────────
# Full end-to-end SSH-transfer testing requires a second machine. These
# scenarios cover the failure paths cmd_transfer guards against, which
# are exercise-able without a real remote.

# Helper: capture both stdout and exit code from a command without losing rc
# to subshell scope (the naïve `$(... || rc=$?)` pattern doesn't propagate rc back).
run_capture() {
    # Args: variable-prefix command...
    # Sets <prefix>_out and <prefix>_rc as globals via eval.
    local _prefix="$1"; shift
    local _out _rc=0
    if _out="$("$@" 2>&1)"; then :; else _rc=$?; fi
    eval "${_prefix}_out=\"\$_out\""
    eval "${_prefix}_rc=\$_rc"
}

# Pre-declare the run_capture target globals so shellcheck doesn't flag
# eval-set assignments as references-without-assignment (SC2154).
transfer_no_args_out="" transfer_no_args_rc=0
transfer_one_arg_out="" transfer_one_arg_rc=0
transfer_unknown_out="" transfer_unknown_rc=0
transfer_pull_out="" transfer_pull_rc=0
transfer_workdir_out="" transfer_workdir_rc=0
transfer_dryrun_out="" transfer_dryrun_rc=0
transfer_badflag_out="" transfer_badflag_rc=0
transfer_help_out="" transfer_help_rc=0

# Missing args → exit 1 + usage
run_capture transfer_no_args "$AE" transfer
assert_eq "transfer: no args exits 1" "1" "$transfer_no_args_rc"
assert_contains "transfer: no args prints usage" "Usage: ae transfer" "$transfer_no_args_out"

# Missing session arg only → exit 1
run_capture transfer_one_arg "$AE" transfer some-session
assert_eq "transfer: missing target exits 1" "1" "$transfer_one_arg_rc"
assert_contains "transfer: missing target prints usage" "Usage: ae transfer" "$transfer_one_arg_out"

# Unknown session → exit 1 with actionable error
run_capture transfer_unknown "$AE" transfer no-such-session-xyz vm.invalid
assert_eq "transfer: unknown local session exits 1" "1" "$transfer_unknown_rc"
assert_contains "transfer: unknown session prints actionable error" "no session 'no-such-session-xyz'" "$transfer_unknown_out"

# --pull is accepted in phase 2; behavior tested via orchestration test in tests/unit
# and via real SSH wire in manual smoke testing. Here we just confirm the flag
# parses without producing a "not yet implemented" message — anything past the
# SSH-probe failure is expected for an unreachable host.
run_capture transfer_pull "$AE" transfer some-session vm.invalid --pull
assert_eq "transfer: --pull rejected for unknown-host preflight (not future-phase rejection)" "1" "$transfer_pull_rc"
assert_eq "transfer: --pull does NOT print future-phase message in phase 2" "1" \
    "$([[ "$transfer_pull_out" != *'phase 2'* ]] && echo 1 || echo 0)"

run_capture transfer_workdir "$AE" transfer some-session vm.invalid --with-workdir
assert_eq "transfer: --with-workdir flag rejected in phase 1" "1" "$transfer_workdir_rc"
assert_contains "transfer: --with-workdir rejection mentions phase 3" "phase 3" "$transfer_workdir_out"

run_capture transfer_dryrun "$AE" transfer some-session vm.invalid --dry-run
assert_eq "transfer: --dry-run flag rejected in phase 1" "1" "$transfer_dryrun_rc"
assert_contains "transfer: --dry-run rejection mentions phase 3" "phase 3" "$transfer_dryrun_out"

# Unknown flag → exit 1
run_capture transfer_badflag "$AE" transfer --no-such-flag
assert_eq "transfer: unknown flag exits 1" "1" "$transfer_badflag_rc"
assert_contains "transfer: unknown flag prints error" "unknown flag" "$transfer_badflag_out"

# --help → exit 0 with full help
run_capture transfer_help "$AE" transfer --help
assert_eq "transfer: --help exits 0" "0" "$transfer_help_rc"
assert_contains "transfer: --help mentions --pull" "--pull" "$transfer_help_out"
assert_contains "transfer: --help mentions --with-workdir" "--with-workdir" "$transfer_help_out"
assert_contains "transfer: --help mentions --dry-run" "--dry-run" "$transfer_help_out"
assert_contains "transfer: --help mentions --yes" "--yes" "$transfer_help_out"

# ── Test: ae hub — config isolation from a hostile project-local .ae/config ──
# The launcher must reproduce the start-hub wrapper's FULL isolation: a project's
# ./.ae/config must NOT override the standalone hub config (the worker-leak class
# codex flagged as a BLOCKER). We run `ae hub` from a hostile repo and assert the
# hub config wins and work_dir/config are pinned to the hub dir.
HUB_DIR="$TMPDIR/meta-hub"
mkdir -p "$HUB_DIR"
cat >"$HUB_DIR/hub.config" <<'EOF'
[agents]
dummy = "bash"

[workspace]
main = dummy:meta
copy = local
layout = vertical
hub = true
EOF
HOSTILE="$(setup_repo)"
mkdir -p "$HOSTILE/.ae"
cat >"$HOSTILE/.ae/config" <<'EOF'
[agents]
dummy2 = "bash"

[workspace]
main = dummy2:evil
workers = dummy2:leaked
layout = vertical
EOF
(cd "$HOSTILE" && AE_HUB_DIR="$HUB_DIR" "$AE" hub &) 2>/dev/null
wait_for_session "hub"
sleep 1
_hub_meta="$HOME/.ae/sessions/hub/meta"
assert_contains "hub: hub-config main wins over hostile local main" "agent.main=dummy:meta:" \
    "$(cat "$_hub_meta" 2>/dev/null)"
assert_eq "hub: hostile local 'workers' does NOT leak in" "0" \
    "$(grep -c '^agent.worker' "$_hub_meta" 2>/dev/null || true)"
assert_contains "hub: config pinned to the standalone hub.config" "config=$HUB_DIR/hub.config" \
    "$(cat "$_hub_meta" 2>/dev/null)"
assert_contains "hub: work_dir pinned to the hub dir (cd isolation)" "work_dir=$HUB_DIR" \
    "$(cat "$_hub_meta" 2>/dev/null)"
assert_contains "hub: meta_agent mode on via 'hub = true' alias" "meta_agent=true" \
    "$(cat "$_hub_meta" 2>/dev/null)"
tmux kill-session -t hub 2>/dev/null || true

# Reserved-name contract: `ae hub <extra>` must be rejected, NOT turned into a
# session named <extra> using the hub config (the generic parser's last-positional
# -wins leak codex flagged).
assert_eq "hub: rejects an extra positional (reserved-name leak guard)" "1" \
    "$(AE_HUB_DIR="$HUB_DIR" "$AE" hub other 2>/dev/null; echo $?)"
assert_eq "hub: the extra-arg name was NOT created as a session" "1" \
    "$(tmux has-session -t other 2>/dev/null && echo 0 || echo 1)"

# `ae hub --init` with a RELATIVE AE_HUB_DIR must still bake an ABSOLUTE charter
# path into hub.config (else `ae hub` cd's in and rel/CHARTER.md → rel/rel/...).
REL_BASE="$TMPDIR/relbase"
mkdir -p "$REL_BASE"
(cd "$REL_BASE" && AE_HUB_DIR="relhub" "$AE" hub --init >/dev/null 2>&1)
assert_contains "hub --init: relative AE_HUB_DIR yields an absolute CHARTER path" \
    "$REL_BASE/relhub/CHARTER.md" "$(cat "$REL_BASE/relhub/hub.config" 2>/dev/null)"

# `ae help` (the in-tool discovery surface) lists the new first-class command.
assert_contains "help: lists 'ae hub'" "ae hub" "$("$AE" help 2>/dev/null)"

# AE_HOME relocates ALL ae state away from $HOME/.ae WITHOUT swapping $HOME — the
# isolation primitive for real-agent e2e (keep real $HOME for CLI auth, isolate ae
# state elsewhere). CONFIG_FILE stays on the dummy-agent config so the session can
# launch; only AE_HOME moves. Regression for the e2e-AI isolation fix.
ALT_AE_HOME="$TMPDIR/alt-aehome"
REPO_AEH="$(setup_repo)"
(cd "$REPO_AEH" && AE_HOME="$ALT_AE_HOME" CONFIG_FILE="$HOME/.ae/config" "$AE" --local aehome-test &) 2>/dev/null
wait_for_session "aehome-test"
sleep 1
assert_eq "AE_HOME: session state lands under AE_HOME, not \$HOME/.ae" "1" \
    "$([[ -f "$ALT_AE_HOME/sessions/aehome-test/meta" && ! -e "$HOME/.ae/sessions/aehome-test" ]] && echo 1 || echo 0)"
tmux kill-session -t aehome-test 2>/dev/null || true

# `ae hub --init` under AE_HOME must scaffold into $AE_HOME/meta-hub, not live ~/.ae
# (codex BLOCKER: the hub dir previously defaulted to $HOME/.ae/meta-hub).
HUB_AEH="$TMPDIR/hub-aehome"
(cd "$TMPDIR" && AE_HOME="$HUB_AEH" "$AE" hub --init >/dev/null 2>&1)
assert_eq "AE_HOME: hub --init scaffolds under AE_HOME, not \$HOME/.ae" "1" \
    "$([[ -f "$HUB_AEH/meta-hub/hub.config" && ! -e "$HOME/.ae/meta-hub" ]] && echo 1 || echo 0)"
# The charter's helper paths must point at the ISOLATED hub session dir, never the
# live ~/.ae (the charter-path fix that unblocks hub e2e scenarios).
assert_eq "AE_HOME: scaffolded charter helper paths point under AE_HOME, not ~/.ae" "1" \
    "$([[ -f "$HUB_AEH/meta-hub/CHARTER.md" ]] &&
        grep -q "$HUB_AEH/sessions/hub/say" "$HUB_AEH/meta-hub/CHARTER.md" &&
        ! grep -q '[~]/.ae/sessions/hub' "$HUB_AEH/meta-hub/CHARTER.md" && echo 1 || echo 0)"

# ae end conversation-file cleanup flag: KEEP by default, --purge-history opts in.
REPO_KEEP="$(setup_repo)"
(cd "$REPO_KEEP" && "$AE" --local end-keep &) 2>/dev/null
wait_for_session "end-keep"
sleep 1
end_keep_out="$("$AE" end -f end-keep 2>&1)"
assert_contains "ae end (default) KEEPS agent conversation files" \
    "kept agent conversation files" "$end_keep_out"
REPO_PURGE="$(setup_repo)"
(cd "$REPO_PURGE" && "$AE" --local end-purge &) 2>/dev/null
wait_for_session "end-purge"
sleep 1
end_purge_out="$("$AE" end -f --purge-history end-purge 2>&1)"
assert_eq "ae end --purge-history takes the purge path (no keep-note)" "1" \
    "$([[ "$end_purge_out" != *'kept agent conversation files'* ]] && echo 1 || echo 0)"

# Per-session config decides the default (codex IMPORTANT) — NOT the caller's cwd.
# (A) a session whose OWN config sets purge_agent_history=true purges even when
# ended from a cwd with no such flag.
PURGE_CFG="$TMPDIR/purge-on.config"
cat >"$PURGE_CFG" <<'EOF'
[agents]
dummy = "bash"

[workspace]
main = dummy:main
purge_agent_history = true
EOF
REPO_A="$(setup_repo)"
(cd "$REPO_A" && CONFIG_FILE="$PURGE_CFG" "$AE" --local end-persess-purge &) 2>/dev/null
wait_for_session "end-persess-purge"
sleep 1
persess_purge_out="$("$AE" end -f end-persess-purge 2>&1)" # ended from default cwd (no flag)
assert_eq "ae end: a session's own purge_agent_history=true purges from a no-flag cwd" "1" \
    "$([[ "$persess_purge_out" != *'kept agent conversation files'* ]] && echo 1 || echo 0)"
# (B) a default (keep) session ended from a cwd whose .ae/config sets purge=true
# must still KEEP — the cwd's policy must not bleed onto an unrelated session.
REPO_B="$(setup_repo)"
(cd "$REPO_B" && "$AE" --local end-persess-keep &) 2>/dev/null
wait_for_session "end-persess-keep"
sleep 1
PURGE_CWD="$TMPDIR/purge-cwd"
mkdir -p "$PURGE_CWD/.ae"
printf '[workspace]\npurge_agent_history = true\n' >"$PURGE_CWD/.ae/config"
persess_keep_out="$(cd "$PURGE_CWD" && "$AE" end -f end-persess-keep 2>&1)"
assert_contains "ae end: a purge=true cwd does NOT override the target's keep default" \
    "kept agent conversation files" "$persess_keep_out"
# (C) a session whose stored config is missing/unusable (transferred/old) must
# still KEEP — never fall back to the caller's purge=true cwd.
REPO_C="$(setup_repo)"
(cd "$REPO_C" && "$AE" --local end-noconfig &) 2>/dev/null
wait_for_session "end-noconfig"
sleep 1
sed -i 's|^config=.*|config=/nonexistent/ae/config|' "$HOME/.ae/sessions/end-noconfig/meta"
noconfig_out="$(cd "$PURGE_CWD" && "$AE" end -f end-noconfig 2>&1)"
assert_contains "ae end: session with no usable stored config KEEPS (no cwd fallback)" \
    "kept agent conversation files" "$noconfig_out"

# Destructive command rejects a stray second positional rather than dropping it.
assert_eq "ae end: rejects a second positional argument" "1" \
    "$("$AE" end -f foo bar 2>/dev/null; echo $?)"

# ── Results ──────────────────────────────────────────────────────────

echo ""
if [[ ${#ERRORS[@]} -gt 0 ]]; then
    for err in "${ERRORS[@]}"; do
        echo -e "$err"
        echo ""
    done
fi
echo "${PASS} passed, ${FAIL} failed"
[[ $FAIL -eq 0 ]] && exit 0 || exit 1
