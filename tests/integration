# actually running — rather than a path the wrapper hands it, so a shim shared by
# both versions would record the same file for both and every pin assertion below
# would be vacuous.
_nxu_make_bundle() {
    local version="$1" root dir digest
    root="ae-${version}-${NXU_PLAT}"
    dir="$NXU_ROOT/$root"
    rm -rf "$dir"
    mkdir -p "$dir"
    cp "$NXU_REAL_CORE" "$NXU_ROOT/real-${version}"
    chmod 0755 "$NXU_ROOT/real-${version}"
    cp "$NXU_SRC/ae-entry" "$dir/ae"
    _sed_i -e "s/^_AE_ENTRY_VERSION=.*/_AE_ENTRY_VERSION=\"${version}\"/" "$dir/ae"
    printf '%s\n' '#!/bin/sh' \
        "case \"\$1\" in --version) echo \"ae ${version}\";; *) exec \"$NXU_ROOT/real-${version}\" \"\$@\";; esac" \
        >"$dir/ae-core"
    cp "$NXU_SRC/install" "$dir/install"
    chmod 0755 "$dir/ae" "$dir/ae-core" "$dir/install"
    tar -czf "$NXU_ROOT/${root}.tar.gz" -C "$NXU_ROOT" "$root"
    digest="$(_nxu_sha "$NXU_ROOT/${root}.tar.gz")"
    printf '%s  %s.tar.gz\n' "$digest" "$root" >"$NXU_ROOT/${root}-SHA256SUMS"
}
_nxu_install() {
    local version="$1"
    _nxu_make_bundle "$version"
    HOME="$NXU_HOME" AE_VERSION="$version" \
        AE_BUNDLE="$NXU_ROOT/ae-${version}-${NXU_PLAT}.tar.gz" \
        AE_SUMS="$NXU_ROOT/ae-${version}-${NXU_PLAT}-SHA256SUMS" \
        "${BASH:-bash}" "$NXU_SRC/install" 2>&1
}

mkdir -p "$NXU_HOME/.ae"
cat >"$NXU_HOME/.ae/config" <<'EOF'
[telegram]
enabled = false

[profiles]
dummy = "bash"

[roster]
dummy = dummy

[workspace]
main = dummy
layout = vertical
EOF

# ── v1: install, then a real session that pins it ────────────────────────
NXU_RC=0
_nxu_install "$NXU_V1" >/dev/null || NXU_RC=$?
assert_eq "P5 upgrade: v1 install succeeds" "0" "$NXU_RC"
assert_eq "P5 upgrade: v1 is the published core" \
    "$NXU_HOME/.ae/versions/$NXU_V1/ae-core" \
    "$(cat "$NXU_HOME/.ae/core/current" 2>/dev/null || true)"

NXU_GIT="$(setup_repo)"
(cd "$NXU_GIT" && HOME="$NXU_HOME" "$NXU_HOME/.local/bin/ae" --local nxup1 >/dev/null 2>&1 &) 2>/dev/null
NXU_I=0
NXU_META1="$NXU_HOME/.ae/sessions/nxup1"
while [[ ! -f "$NXU_META1/meta" ]]; do
    sleep 0.5
    NXU_I=$((NXU_I + 1))
    if ((NXU_I >= 40)); then break; fi
done
sleep 2
# The v1-glue pin is RETIRED with the `ae_path` row. The version-pinning claim it
# carried is unchanged and is asserted by the two rows below it — the v1 session
# pinned the v1 CORE, and recorded the v1 version — which is what an upgrade must
# not disturb.
assert_eq "P5 upgrade: the v1 session pinned v1 core" "1" \
    "$([[ "$(command grep '^ae_core=' "$NXU_META1/meta" 2>/dev/null | cut -d= -f2- || true)" -ef "$NXU_ROOT/real-$NXU_V1" ]] && echo 1 || echo 0)"
assert_eq "P5 upgrade: ...and recorded its version" "$NXU_V1" \
    "$(command grep '^ae_core_version=' "$NXU_META1/meta" 2>/dev/null | cut -d= -f2- || true)"

# ── v2: install beside it ────────────────────────────────────────────────
NXU_RC=0
_nxu_install "$NXU_V2" >/dev/null || NXU_RC=$?
assert_eq "P5 upgrade: v2 install succeeds" "0" "$NXU_RC"
assert_eq "P5 upgrade: current now names v2" \
    "$NXU_HOME/.ae/versions/$NXU_V2" \
    "$(readlink "$NXU_HOME/.ae/current" 2>/dev/null || true)"
assert_eq "P5 upgrade: the v1 leaf is still there" "1" \
    "$([[ -x "$NXU_HOME/.ae/versions/$NXU_V1/ae-core" ]] && echo 1 || echo 0)"
assert_eq "P5 upgrade: the live v1 session's pin did not move" "1" \
    "$([[ "$(command grep '^ae_core=' "$NXU_META1/meta" 2>/dev/null | cut -d= -f2- || true)" -ef "$NXU_ROOT/real-$NXU_V1" ]] && echo 1 || echo 0)"
assert_eq "P5 upgrade: ...and that binary still reports v1" "$NXU_V1" \
    "$("$NXU_HOME/.ae/versions/$NXU_V1/ae-core" --version 2>/dev/null | awk '{print $NF}')"

# ── A new session gets the new core ──────────────────────────────────────
(cd "$NXU_GIT" && HOME="$NXU_HOME" "$NXU_HOME/.local/bin/ae" --local nxup2 >/dev/null 2>&1 &) 2>/dev/null
NXU_I=0
NXU_META2="$NXU_HOME/.ae/sessions/nxup2"
while [[ ! -f "$NXU_META2/meta" ]]; do
    sleep 0.5
    NXU_I=$((NXU_I + 1))
    if ((NXU_I >= 40)); then break; fi
done
sleep 2
assert_eq "P5 upgrade: a NEW session pins v2 core" "1" \
    "$([[ "$(command grep '^ae_core=' "$NXU_META2/meta" 2>/dev/null | cut -d= -f2- || true)" -ef "$NXU_ROOT/real-$NXU_V2" ]] && echo 1 || echo 0)"
assert_eq "P5 upgrade: ...while the older session still pins v1" "1" \
    "$([[ "$(command grep '^ae_core=' "$NXU_META1/meta" 2>/dev/null | cut -d= -f2- || true)" -ef "$NXU_ROOT/real-$NXU_V1" ]] && echo 1 || echo 0)"

# ── Re-entry: core/current with empty AE_CORE_BIN ───────────────────────
# The published pointer is what a re-entry with no environment resolves through,
# and after an upgrade it must name the NEW core. (The bundle arm never reads it
# for resolution — an installed wrapper runs its own sibling — but the pointer is
# still the identity the pair check proves against, so it has to be right.)
eval "$(awk '/^(_ae_core_current_input|_ae_core_bin_input)\(\) \{/,/^\}$/' "$AE")"
assert_eq "P5 re-entry: core/current names the upgraded core" \
    "$NXU_HOME/.ae/versions/$NXU_V2/ae-core" \
    "$(cat "$NXU_HOME/.ae/core/current")"
assert_eq "P5 re-entry: empty env through core/current resolves v2" "1" \
    "$([[ "$(AE_CORE_BIN='' AE_HOME="$NXU_HOME/.ae" _ae_core_bin_input)" -ef "$NXU_HOME/.ae/versions/$NXU_V2/ae-core" ]] && echo 1 || echo 0)"
assert_eq "P5 re-entry: ...and never an empty one" "0" \
    "$(AE_CORE_BIN='' AE_HOME="$NXU_HOME/.ae" _ae_core_bin_input | command grep -c '^$' || true)"
unset -f _ae_core_current_input _ae_core_bin_input

HOME="$NXU_HOME" "$NXU_HOME/.local/bin/ae" end -f nxup1 >/dev/null 2>&1 || true
HOME="$NXU_HOME" "$NXU_HOME/.local/bin/ae" end -f nxup2 >/dev/null 2>&1 || true
chmod -R u+w "$NXU_ROOT" 2>/dev/null || true
unset -f _nxu_sha _nxu_make_bundle _nxu_install
unset NXU_SRC NXU_ROOT NXU_HOME NXU_V1 NXU_V2 NXU_MAJ NXU_REST NXU_MIN NXU_PAT \
    NXU_PLAT NXU_REAL_CORE NXU_RC NXU_GIT NXU_I NXU_META1 NXU_META2
fi

# ── Results ──────────────────────────────────────────────────────────

echo ""
if [[ ${#ERRORS[@]} -gt 0 ]]; then
    for err in "${ERRORS[@]}"; do
        echo -e "$err"
        echo ""
    done
fi
# A scoped result must never be readable as a full one (#64). The marker goes ON the
# counts line, not above it: `tail -1` is how a suite result reaches a report or a gate
# log, and a warning printed on the previous line is exactly the line that gets cut off.
# So the last line of a scoped run is never mistakable for the last line of a full one.
# The braces to the name-scan's belt. `_itest_names` reads the guard lines as TEXT, and
# B5's lesson is that text inside a heredoc body can be indistinguishable from the real
# thing — so a name could in principle be LISTED and selectable without any reachable
# guard behind it, and the run would report a serene "0 passed, 0 failed". This check
# does not care how that happens: if a filter was given and no section actually
# executed, the run failed to do what it was asked, and says so instead of going green.
if [[ -n "$_itest_filter" ]] && ((_ITEST_RAN_N == 0)); then
    echo "" >&2
    echo "FILTER SELECTED A NAME THAT NEVER RAN: '$_itest_filter' matched the section list," >&2
    echo "  but ZERO sections executed. Nothing was tested. This is reported as a failure" >&2
    echo "  rather than as '0 passed, 0 failed', which is indistinguishable from success." >&2
    exit 2
fi
if [[ -n "$_itest_filter" ]]; then
    echo "${PASS} passed, ${FAIL} failed" \
        "— SCOPED RUN (#64), filter '$_itest_filter': ${_ITEST_RAN_N} of $((_ITEST_RAN_N + _ITEST_SKIPPED_N)) sections ran," \
        "${_ITEST_SKIPPED_N} SKIPPED. NOT a full suite — gates run it unfiltered."
elif [[ -n "$_ITEST_FILTER_IGNORED" ]]; then
    # A full run, and the fact that it had to override an inherited filter belongs on
    # the line people read — otherwise the only trace is a warning far up the log.
    echo "${PASS} passed, ${FAIL} failed" \
        "— FULL RUN (every section); inherited filter '${_ITEST_FILTER_IGNORED}' was IGNORED."
else
    echo "${PASS} passed, ${FAIL} failed"
fi
[[ $FAIL -eq 0 ]] && exit 0 || exit 1
