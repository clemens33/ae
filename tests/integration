# THE CHILD STARTS WHAT WAS AUTHORIZED — PINNED AT THE CHILD, not at the gates. Both
# gates already refuse a config rewritten before them; the window they cannot cover opens
# AFTER the second gate, while the end is archiving and tearing down, and closes when the
# child launches. In that window the source session is already gone, so a child starting
# the wrong roster is unrecoverable. The rewrite is therefore timed to the ARCHIVE
# APPEARING, which happens after gate 2 and before the exec. A fix must be pinned at the
# point it claims to protect, not where it was convenient to observe.
C48S_REPO="$(setup_repo)"
mkdir -p "$C48S_REPO/.ae"
printf '[agents]\ndummy = "bash"\ndummy2 = "bash"\n\n[workspace]\nmain = dummy\n' >"$C48S_REPO/.ae/config"
(cd "$C48S_REPO" && "$AE" --local comp-snap &) 2>/dev/null
