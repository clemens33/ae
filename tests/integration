            # arms the second. That is the race the re-check exists for, and a
            # fixture is the only way to observe it without timing luck.
            rm -f "$TGG_FIX/flip"
            : >"$TGG_FIX/present"
            echo "no server running on /tmp/tmux-501/default" >&2
            exit 1
