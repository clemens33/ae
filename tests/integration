(cd "$REPO10B" && "$AE" --local test-orphan &) 2>/dev/null
wait_for_session "test-orphan"
# Wait for the META/dir to be written before killing: the tmux session comes up first,
# and killing in that window can race the launch into leaving no dir (no orphan) — the
# same setup race as the named-server probe.
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/test-orphan/meta" ]] && break; sleep 0.3; done
# Kill and confirm both invariants of a stopped orphan: tmux dead AND dir present. Retry
# the kill until it takes (contention can drop the first one).
for _i in $(seq 1 20); do
    tmux has-session -t "=test-orphan" 2>/dev/null || break
