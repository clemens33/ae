_nxu_sha() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk 'NR == 1 { print $1; exit }'
    else
        shasum -a 256 "$1" | awk 'NR == 1 { print $1; exit }'
    fi
}
_nxu_make_bundle() {
    local version="$1" root dir digest
    root="ae-${version}-${NXU_PLAT}"
    dir="$NXU_ROOT/$root"
    rm -rf "$dir"
    mkdir -p "$dir"
    cp "$NXU_SRC/ae-entry" "$dir/ae"
    _sed_i -e "s/^_AE_ENTRY_VERSION=.*/_AE_ENTRY_VERSION=\"${version}\"/" "$dir/ae"
    sed "s/^AE_VERSION=.*/AE_VERSION=\"${version}\"/" "$NXU_SRC/ae" >"$dir/ae-glue"
    chmod 0755 "$dir/ae-glue"
    printf '%s\n' '#!/bin/sh' \
        "case \"\$1\" in --version) echo \"ae ${version}\";; *) exec \"$NXU_REAL_CORE\" \"\$@\";; esac" \
        >"$dir/ae-core"
    cp "$NXU_SRC/install" "$dir/install"
    chmod 0755 "$dir/ae" "$dir/ae-glue" "$dir/ae-core" "$dir/install"
    tar -czf "$NXU_ROOT/${root}.tar.gz" -C "$NXU_ROOT" "$root"
    digest="$(_nxu_sha "$NXU_ROOT/${root}.tar.gz")"
    printf '%s  %s.tar.gz\n' "$digest" "$root" >"$NXU_ROOT/${root}-SHA256SUMS"
}
_nxu_install() {
    local version="$1"
    _nxu_make_bundle "$version"
    HOME="$NXU_HOME" AE_VERSION="$version" \
        AE_BUNDLE="$NXU_ROOT/ae-${version}-${NXU_PLAT}.tar.gz" \
        AE_SUMS="$NXU_ROOT/ae-${version}-${NXU_PLAT}-SHA256SUMS" \
