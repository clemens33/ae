# send-focus regression (codex): a send to the INACTIVE seat-mate must deliver WITHOUT
# changing the window's active pane — select-pane mid-send routed the human's in-flight
# keystrokes into the target (acute exactly here, where lead+colead share window 0).
lp_lead_pane="$(tmux list-panes -s -t test-leadpair -F '#{@ae_agent} #{pane_id}' 2>/dev/null | awk '$1=="dummy:lead"{print $2}')"
tmux select-pane -t "$lp_lead_pane" 2>/dev/null || true
"$HOME/.ae/sessions/test-leadpair/send" colead "focus-regression-ping" >/dev/null 2>&1 || true
sleep 1
lp_active_after="$(tmux list-panes -t test-leadpair:0 -F '#{pane_active} #{pane_id}' 2>/dev/null | awk '$1==1{print $2}')"
# (Behavioral smoke: post-send active pane is the lead. The DISTINGUISHING guard for
# zero-select-pane is the unit pin on the helper source — a select+restore would also
# pass this after-the-fact check; this assert documents delivery without focus.)
assert_eq "send-focus: active pane is the lead after send to the same-window seat-mate" "$lp_lead_pane" "$lp_active_after"
lp_colead_pane="$(tmux list-panes -s -t test-leadpair -F '#{@ae_agent} #{pane_id}' 2>/dev/null | awk '$1=="dummy2:colead"{print $2}')"
