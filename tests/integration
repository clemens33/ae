assert_contains "doctor-refresh: summary still succeeds" "Summary: 0 failure(s)" "$doctor_sync_output"

# The refresh must have cycled the running watchdog so the regenerated helper
# body goes live: it announces the restart and comes back up under a NEW pid.
assert_contains "doctor-refresh: announces the watchdog restart" \
    "restarted watchdog for test-sync" "$doctor_sync_output"
wd_poll "$WD_HELPER" "is running" 20 || true
assert_contains "doctor-refresh: watchdog running again after refresh" \
    "is running" "$("$WD_HELPER" status 2>&1 || true)"
wd_pid_after="$(wd_pid "$WD_HELPER")"
assert_eq "doctor-refresh: watchdog restarted (before pid captured)" \
