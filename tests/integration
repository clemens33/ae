rm -f "$C48R_FIFO"
assert_eq "compact-roster: a roster rewritten under the answer refuses" "1" \
    "$([[ $c48r_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "compact-roster: and says the child would start something else" \
    "would now start a different roster than the one shown" "$c48r"
