    # root 0555, and a 0755 fixture cannot see the defect that packaging causes.
    local version="$1" extra_core="${2:-}" pack_mode="${3:-0755}" root dir digest
    root="ae-${version}-${P5I_PLAT}"
    dir="$P5I_ROOT/$root"
    rm -rf "$dir"
