    "$(_fz_req="$(command grep '"action":"stop-request"' "$HOME/.ae/sessions/fzone/events.jsonl" 2>/dev/null | tail -1)"
       [[ "$_fz_req" == *"fleet stop requested"* && "$_fz_req" != *"from inside the session"* ]] && echo 1 || echo 0)"
# A malformed operation id is refused at the entrypoint — it reaches an event
# summary, so the boundary is entered here rather than trusted from the caller.
fz_sid2="$(command grep '^session_id=' "$HOME/.ae/sessions/fztwo/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
"$AE" _stop-fleet-supervisor "not-a-uuid" fztwo "$fz_sid2" >/dev/null 2>&1 || true
sleep 1
assert_eq "provenance (F8): a malformed operation id stops nothing" "1" \
    "$(tmux has-session -t "=fztwo" 2>/dev/null && echo 1 || echo 0)"
# ...and an UNPAIRED payload is refused outright rather than half-acted on: a list
# that does not pair is not a payload any part of which we may honour.
"$AE" _stop-fleet-supervisor "$fz_op" fztwo >/dev/null 2>&1 || true
sleep 1
assert_eq "frozen set (F9): a truncated (unpaired) payload stops nothing" "1" \
    "$(tmux has-session -t "=fztwo" 2>/dev/null && echo 1 || echo 0)"
for _n in fzone fztwo; do "$AE" end -f "$_n" >/dev/null 2>&1 || true; done
unset FZ_R1 FZ_R2 fz_op fz_sid fz_sid2 _n _i

# (m) F10 — A NAME IS A SLOT, NOT A THING. Freezing the SET (F9) still froze NAMES,
# and a name can be handed to a different session between confirmation and kill:
# end the original completely, launch a fresh one under the same name, and the
# frozen payload authorized killing the REPLACEMENT — with success recorded, and in
# flat contradiction of what the docs promise about a session started while you are
# deciding. Fully deterministic: no race, the substitution is performed outright.
AB_R1="$(setup_repo)"
(cd "$AB_R1" && "$AE" --local abasame &) 2>/dev/null
wait_for_session "abasame" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/abasame/meta" ]] && break; sleep 0.3; done
ab_old="$(command grep '^session_id=' "$HOME/.ae/sessions/abasame/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
# The payload is frozen HERE, against the ORIGINAL instance.
"$AE" end -f abasame >/dev/null 2>&1 || true
AB_R2="$(setup_repo)"
(cd "$AB_R2" && "$AE" --local abasame &) 2>/dev/null
wait_for_session "abasame" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/abasame/meta" ]] && break; sleep 0.3; done
ab_new="$(command grep '^session_id=' "$HOME/.ae/sessions/abasame/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
# SPECIMEN PRECONDITION: the name really was reused by a DIFFERENT instance. Without
# this the seed would pass just as happily if ae had reused the same id.
assert_eq "ABA (F10): the same name now carries a different instance" "1" \
    "$([[ -n "$ab_old" && -n "$ab_new" && "$ab_old" != "$ab_new" ]] && echo 1 || echo 0)"
ab_op="bbbbbbbb-cccc-dddd-eeee-ffffffffffff"
"$AE" _stop-fleet-supervisor "$ab_op" abasame "$ab_old" >/dev/null 2>&1 || true
sleep 2
assert_eq "ABA (F10): the REPLACEMENT is left running" "1" \
    "$(tmux has-session -t "=abasame" 2>/dev/null && echo 1 || echo 0)"
# ...and the refusal is durable and diagnosable: stamped with the operation, marked
# FAILED, naming both instances. A silent survivor would be indistinguishable from
# a stop that simply had not happened yet.
assert_eq "ABA (F10): the refusal is recorded, stamped, and names both instances" "1" \
    "$(_ab_ev="$HOME/.ae/sessions/abasame/events.jsonl"
       _ab_res="$(command grep '"action":"stop-result"' "$_ab_ev" 2>/dev/null | command grep -F "[op ${ab_op}]" | tail -1)"
       [[ "$_ab_res" == *FAILED* && "$_ab_res" == *"not the session that was confirmed"* \
        && "$_ab_res" == *"$ab_new"* && "$_ab_res" == *"$ab_old"* ]] && echo 1 || echo 0)"
# ...while the CURRENT instance is still stoppable by a payload that names it —
# the guard must refuse a stale authorization, not the session itself.
"$AE" _stop-fleet-supervisor "$ab_op" abasame "$ab_new" >/dev/null 2>&1 || true
for _i in $(seq 1 40); do tmux has-session -t "=abasame" 2>/dev/null || break; sleep 0.5; done
assert_eq "ABA (F10): the CURRENT instance is still stoppable when correctly named" "1" \
    "$(tmux has-session -t "=abasame" 2>/dev/null && echo 0 || echo 1)"
"$AE" end -f abasame >/dev/null 2>&1 || true
unset AB_R1 AB_R2 ab_old ab_new ab_op _i

# (n) F11 — A COMPLETE PAIR MUST NOT BE ACTED ON BEFORE THE PAYLOAD IS ACCEPTED.
# The shape check used to run AFTER the loop, so a payload of one good pair plus a
# dangling tail killed the good target and recorded it verified-gone, and only THEN
# returned non-zero. Round 9's seed passed over this because a single bare name is
# ZERO complete pairs — there was nothing for the loop to act on, so the specimen
# never reached the property it was supposed to protect.
OD_R="$(setup_repo)"
(cd "$OD_R" && "$AE" --local oddone &) 2>/dev/null
wait_for_session "oddone" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/oddone/meta" ]] && break; sleep 0.3; done
od_sid="$(command grep '^session_id=' "$HOME/.ae/sessions/oddone/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
od_op="cccccccc-dddd-eeee-ffff-000000000000"
# SPECIMEN PRECONDITION: the pair really is complete and valid, so the ONLY defect
# in this payload is the dangling tail. Without this the seed could refuse for the
# wrong reason and still look green.
assert_eq "odd payload (F11): the leading pair is itself well-formed" "1" \
    "$([[ -n "$od_sid" ]] && echo 1 || echo 0)"
"$AE" _stop-fleet-supervisor "$od_op" oddone "$od_sid" dangling >/dev/null 2>&1 || true
sleep 2
assert_eq "odd payload (F11): the complete pair is NOT acted on" "1" \
    "$(tmux has-session -t "=oddone" 2>/dev/null && echo 1 || echo 0)"
# (Round 10 asserted the target was never even REQUESTED. Round 11 ruled the
# opposite for the record: a refused payload must leave a durable stamped failure,
# or a dead worker reads as pending success. Both facts survive — nothing is
# STOPPED, and the refusal is TOLD. The pin follows the ruling.)
assert_eq "odd payload (F11): the refusal is recorded, and it is a refusal" "1" \
    "$(_od_res="$(command grep '"action":"stop-result"' "$HOME/.ae/sessions/oddone/events.jsonl" 2>/dev/null | command grep -F "[op ${od_op}]" | tail -1)"
       [[ "$_od_res" == *FAILED* && "$_od_res" == *"malformed"* ]] && echo 1 || echo 0)"
assert_eq "odd payload (F11): and no stop-request was ever issued for it" "1" \
    "$(command grep -q '"action":"stop-request"' "$HOME/.ae/sessions/oddone/events.jsonl" 2>/dev/null && echo 0 || echo 1)"
# ...and the same pair WITHOUT the tail still works, so the refusal is about the
# payload's shape and not about this target.
"$AE" _stop-fleet-supervisor "$od_op" oddone "$od_sid" >/dev/null 2>&1 || true
for _i in $(seq 1 40); do tmux has-session -t "=oddone" 2>/dev/null || break; sleep 0.5; done
assert_eq "odd payload (F11): the same pair alone is honoured" "1" \
    "$(tmux has-session -t "=oddone" 2>/dev/null && echo 0 || echo 1)"
"$AE" end -f oddone >/dev/null 2>&1 || true
unset OD_R od_sid od_op _i

# (o) F10(a)/F10(b) — A SENTINEL IS NOT AN IDENTITY. Two pre-feature sessions both
# freeze as "-", so ending one and renaming another into its name satisfied the
# frozen comparison exactly and killed the replacement with rc 0. `ae rename`
# preserves a missing session_id, which is what made the two indistinguishable.
# Legacy state is built by STRIPPING session_id from a real session's meta — the
# honest way to get a pre-feature specimen out of a current ae.
#
# ISOLATED AE_HOME, because this seed runs `stop all`: against the shared test home
# its exit status would depend on whatever metadata earlier seeds left behind rather
# than on the property under test.
LG_HOME="$TMPDIR/lghome"
mkdir -p "$LG_HOME"
command cp "$HOME/.ae/config" "$LG_HOME/config" 2>/dev/null || true
LG_R1="$(setup_repo)"; LG_R2="$(setup_repo)"
(cd "$LG_R1" && AE_HOME="$LG_HOME" "$AE" --local oldslot &) 2>/dev/null
wait_for_session "oldslot" || true
(cd "$LG_R2" && AE_HOME="$LG_HOME" "$AE" --local replacement &) 2>/dev/null
wait_for_session "replacement" || true
for _n in oldslot replacement; do
    for _i in $(seq 1 25); do [[ -f "$LG_HOME/sessions/$_n/meta" ]] && break; sleep 0.3; done
done
# A launch that never came up must FAIL here, loudly, rather than abort the suite at
# a bare wait_for_session — the "no FAIL lines = vacuous" trap, from the seed side.
assert_eq "legacy ABA (F10): both specimens launched" "1|1" \
    "$(printf '%s|%s' \
        "$([[ -f "$LG_HOME/sessions/oldslot/meta" ]] && echo 1 || echo 0)" \
        "$([[ -f "$LG_HOME/sessions/replacement/meta" ]] && echo 1 || echo 0)")"
for _n in oldslot replacement; do
    if [[ -f "$LG_HOME/sessions/$_n/meta" ]]; then
        command grep -v '^session_id=' "$LG_HOME/sessions/$_n/meta" >"$TMPDIR/lgm" 2>/dev/null || true
        command mv -f "$TMPDIR/lgm" "$LG_HOME/sessions/$_n/meta" 2>/dev/null || true
    fi
done
# Asked as BOOLEANS. `grep -c` prints "0" AND exits 1 on no-match, so the obvious
# `... | tr -d '[:space:]' || echo 0` spelling emits "00" — the same counting trap
# that bit the round-8 bystander pin, one spelling over. Counts from grep are a
# false friend here; presence is the actual question.
assert_eq "legacy ABA (F10): both specimens really are pre-feature (no session_id)" "1|1" \
    "$(printf '%s|%s' \
        "$(command grep -q '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null && echo 0 || echo 1)" \
        "$(command grep -q '^session_id=' "$LG_HOME/sessions/replacement/meta" 2>/dev/null && echo 0 || echo 1)")"
lg_op="dddddddd-eeee-ffff-0000-111111111111"
# The reviewer's exact sequence, driven with the STALE dash payload a pre-mint ae
# would have frozen: end the original, move the other into its name.
AE_HOME="$LG_HOME" "$AE" end -f oldslot >/dev/null 2>&1 || true
AE_HOME="$LG_HOME" "$AE" rename replacement oldslot >/dev/null 2>&1 || true
sleep 1
AE_HOME="$LG_HOME" "$AE" _stop-fleet-supervisor "$lg_op" oldslot - >/dev/null 2>&1 || true
sleep 2
assert_eq "legacy ABA (F10b): a frozen dash does not authorize the renamed session" "1" \
    "$(tmux has-session -t "=oldslot" 2>/dev/null && echo 1 || echo 0)"
assert_eq "legacy ABA (F10b): the refusal is durable, stamped, and names the fact" "1" \
    "$(_lg_res="$(command grep '"action":"stop-result"' "$LG_HOME/sessions/oldslot/events.jsonl" 2>/dev/null | command grep -F "[op ${lg_op}]" | tail -1)"
       [[ "$_lg_res" == *FAILED* && "$_lg_res" == *"no instance identity was frozen"* && "$_lg_res" == *"(F10)"* ]] && echo 1 || echo 0)"
# (a) MINT ON TOUCH: the same pre-feature session, taken through a real fleet
# confirmation, ACQUIRES an identity — and keeps it. From here it is defensible.
lg_before="$(command grep -q '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null && echo 1 || echo 0)"
# lg_out captures the command's output only to keep it out of the suite log; the
# assertions below read lg_rc and the meta file.
# shellcheck disable=SC2034
if lg_out="$(AE_HOME="$LG_HOME" "$AE" stop all -y 2>&1)"; then lg_rc=0; else lg_rc=$?; fi
lg_after="$(command grep '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
assert_eq "mint-at-freeze (F10a): a pre-feature session gains an identity on fleet contact" "0|1" \
    "$(printf '%s|%s' "$lg_before" "$([[ -n "$lg_after" ]] && echo 1 || echo 0)")"
assert_eq "mint-at-freeze (F10a): and the stop it was minted for then succeeds" "0|1" \
    "$(printf '%s|%s' "$lg_rc" "$(tmux has-session -t "=oldslot" 2>/dev/null && echo 0 || echo 1)")"
# ...and the minted identity SURVIVES a resume, which is what makes it an identity
# rather than a per-operation nonce.
(cd "$LG_R2" && AE_HOME="$LG_HOME" "$AE" oldslot &) 2>/dev/null
wait_for_session "oldslot" || true
sleep 1
assert_eq "mint-at-freeze (F10a): the minted identity survives stop and resume" "1" \
    "$(_lg_now="$(command grep '^session_id=' "$LG_HOME/sessions/oldslot/meta" 2>/dev/null | head -1 | cut -d= -f2-)"
       [[ -n "$lg_after" && "$_lg_now" == "$lg_after" ]] && echo 1 || echo 0)"
AE_HOME="$LG_HOME" "$AE" end -f oldslot >/dev/null 2>&1 || true
rm -rf "$LG_HOME"
unset LG_HOME LG_R1 LG_R2 lg_op lg_before lg_after lg_out lg_rc _n _i

# (p) ROUND 11 — RENAME IS A LIFECYCLE OPERATION. It took no lifecycle lock, so a
# rename landing between a freeze and its lock rebuilt the F10 kill exactly. The
# interleave is FORCED rather than raced: hold the target's lifecycle lock from
# outside and assert the rename WAITS for it instead of walking through.
RN_HOME="$TMPDIR/rnhome"
mkdir -p "$RN_HOME"
command cp "$HOME/.ae/config" "$RN_HOME/config" 2>/dev/null || true
RN_R="$(setup_repo)"
(cd "$RN_R" && AE_HOME="$RN_HOME" "$AE" --local rnsrc &) 2>/dev/null
wait_for_session "rnsrc" || true
for _i in $(seq 1 25); do [[ -f "$RN_HOME/sessions/rnsrc/meta" ]] && break; sleep 0.3; done
assert_eq "rename lock: the specimen launched" "1" \
    "$([[ -f "$RN_HOME/sessions/rnsrc/meta" ]] && echo 1 || echo 0)"
if command -v flock >/dev/null 2>&1; then
    # Hold the TARGET name's lock — the one a concurrent freeze/stop would hold.
    mkdir -p "$RN_HOME/sessions"
    # HOLD LONGER THAN THE WAITER. rename waits 15s; a 12s hold meant it waited,
    # the holder released, and the rename legitimately succeeded — the seed was
    # measuring its own sleep rather than the lock. The lksess seed already had this
    # right (hold 20 against a 15s wait); this one now matches it.
    ( exec 9>"$RN_HOME/sessions/.lifecycle.rndst.lock"; flock 9; sleep 25 ) &
    rn_holder=$!
    sleep 1
    if rn_out="$(AE_HOME="$RN_HOME" _timeout 25 "$AE" rename rnsrc rndst 2>&1)"; then rn_rc=0; else rn_rc=$?; fi
    assert_eq "rename lock: rename REFUSES while a lifecycle lock is held, and renames nothing" "1" \
        "$([[ "$rn_rc" -ne 0 && "$rn_out" == *"lifecycle operation"* ]] && echo 1 || echo 0)"
    assert_eq "rename lock: the source session is untouched by the refusal" "1" \
        "$(tmux has-session -t "=rnsrc" 2>/dev/null && echo 1 || echo 0)"
    kill "$rn_holder" 2>/dev/null || true; wait "$rn_holder" 2>/dev/null || true
    sleep 0.5
else
    # NEVER count unexecuted assertions as passes — the round-7 lesson. A supported
    # shape without flock reports the skip out loud instead.
    printf 'NOTE: rename lifecycle-lock interleave SKIPPED — flock not available (2 assertions not executed).\n' >&2
fi
# ...and with nothing held, the same rename succeeds: the lock is a gate, not a wall.
if AE_HOME="$RN_HOME" "$AE" rename rnsrc rndst >/dev/null 2>&1; then rn_rc2=0; else rn_rc2=$?; fi
assert_eq "rename lock: an uncontended rename still succeeds" "0|1" \
    "$(printf '%s|%s' "$rn_rc2" "$(tmux has-session -t "=rndst" 2>/dev/null && echo 1 || echo 0)")"
AE_HOME="$RN_HOME" "$AE" end -f rndst >/dev/null 2>&1 || true
AE_HOME="$RN_HOME" "$AE" end -f rnsrc >/dev/null 2>&1 || true
rm -rf "$RN_HOME"
unset RN_HOME RN_R rn_holder rn_out rn_rc rn_rc2 _i

# (q) I4 — A DEAD WORKER MUST NOT READ AS PENDING SUCCESS. A malformed payload made
# the child return before emitting anything, while the parent had already announced
# the handoff and settled in to wait 30s for results no living process would write.
# Driven at the CHILD, which is where the silence was.
DW_R="$(setup_repo)"
(cd "$DW_R" && "$AE" --local deadw &) 2>/dev/null
wait_for_session "deadw" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/deadw/meta" ]] && break; sleep 0.3; done
assert_eq "dead worker (I4): the specimen launched" "1" \
    "$([[ -f "$HOME/.ae/sessions/deadw/meta" ]] && echo 1 || echo 0)"
dw_op="eeeeeeee-ffff-0000-1111-222222222222"
"$AE" _stop-fleet-supervisor "$dw_op" deadw not-a-uuid >/dev/null 2>&1 || true
sleep 2
assert_eq "dead worker (I4): the malformed payload stops nothing" "1" \
    "$(tmux has-session -t "=deadw" 2>/dev/null && echo 1 || echo 0)"
# The refusal is DURABLE and op-stamped, which is the only thing that lets the
# caller's wait tell a refusal apart from a result that has not arrived yet.
assert_eq "dead worker (I4): the refusal is recorded against the named target" "1" \
    "$(_dw="$(command grep '"action":"stop-result"' "$HOME/.ae/sessions/deadw/events.jsonl" 2>/dev/null | command grep -F "[op ${dw_op}]" | tail -1)"
       [[ "$_dw" == *FAILED* && "$_dw" == *"malformed"* && "$_dw" == *"(F11)"* ]] && echo 1 || echo 0)"
"$AE" end -f deadw >/dev/null 2>&1 || true
unset DW_R dw_op _i

# (l) I3 — THE NO-TTY REFUSAL MUST ACTUALLY PRINT ITS RETRY LINE. `[[ -r /dev/tty ]]`
# is TRUE on macOS inside a process with no controlling terminal while the OPEN
# fails with "Device not configured" — measured on this box under run-shell: -r
# TRUE, open FAILS. So the refusal branch never ran: the caller got the prompt, a
# shell diagnostic and "Not stopped", and never the one line it needed. `run-shell`
# is the seam because its child genuinely has no controlling terminal; a redirect
# would not reproduce it, since a controlling tty is a process property, not an fd.
TT_R="$(setup_repo)"
(cd "$TT_R" && "$AE" --local ttysess &) 2>/dev/null
wait_for_session "ttysess"
sleep 1
tt_out="$TMPDIR/tty.out"
tmux run-shell -t ttysess \
    "env HOME='$HOME' AE_HOME='$AE_HOME' '$AE' stop all >'$tt_out' 2>&1" || true
sleep 2
assert_eq "no-tty (I3): the refusal names the exact retry flag" "1" \
    "$([[ "$(cat "$tt_out" 2>/dev/null || true)" == *"Re-run with -y: ae stop all -y"* ]] && echo 1 || echo 0)"
# ...and it refused: an un-confirmable destructive fleet stop must not proceed.
assert_eq "no-tty (I3): nothing was stopped without a confirmation" "1" \
    "$(tmux has-session -t "=ttysess" 2>/dev/null && echo 1 || echo 0)"
# ...and it did not ask a question it could not receive an answer to.
assert_eq "no-tty (I3): no prompt is printed when there is no one to prompt" "1" \
    "$([[ "$(cat "$tt_out" 2>/dev/null || true)" != *"Continue?"* ]] && echo 1 || echo 0)"
"$AE" end -f ttysess >/dev/null 2>&1 || true
rm -f "$tt_out"
unset TT_R tt_out
fi

# ── #34: end STOPS before it SNAPSHOTS ───────────────────────────────
if _itest_section '#34: end STOPS before it SNAPSHOTS'; then
# end used to add/commit/fetch/push while the agents were still live and only then
# kill, so a write landing after the snapshot and before the kill was neither
# committed nor left on disk — cleanup removed the directory it lived in.
#
# The seed asks the ORDER question directly rather than racing a writer into the
# window: a post-commit hook records whether the tmux session was still ALIVE at the
# moment end took its snapshot. Alive means agents could still be writing into a tree
# ae is about to commit and then delete. Deterministic — the hook fires on end's own
# commit, every run, with no timing assumption at all.
#
# WORKTREE mode, deliberately: --local never commits at all ("files are in the
# original dir"), so a local specimen never reaches the snapshot path and the seed
# would go red for the wrong reason. It did exactly that on the first red run.
E34_R="$(setup_repo)"
E34_REMOTE="$TMPDIR/e34-remote.git"
git -C "$E34_R" clone -q --bare "$E34_R" "$E34_REMOTE" 2>/dev/null
git -C "$E34_R" remote add origin "$E34_REMOTE" 2>/dev/null || git -C "$E34_R" remote set-url origin "$E34_REMOTE"
(cd "$E34_R" && "$AE" --worktree e34order &) 2>/dev/null
wait_for_session "e34order" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/e34order/meta" ]] && break; sleep 0.3; done
e34_wd="$(command grep '^work_dir=' "$HOME/.ae/sessions/e34order/meta" 2>/dev/null | cut -d= -f2- || true)"
assert_eq "end-order (#34): the worktree specimen launched" "1" \
    "$([[ -n "$e34_wd" && -d "$e34_wd" ]] && echo 1 || echo 0)"
if [[ -n "$e34_wd" && -d "$e34_wd" ]]; then
    git -C "$e34_wd" config user.email "test@test"
    git -C "$e34_wd" config user.name "test"
    e34_probe="$TMPDIR/e34-alive-at-snapshot"
    e34_hooks="$(git -C "$e34_wd" rev-parse --git-path hooks 2>/dev/null)"
    mkdir -p "$e34_hooks"
    cat >"$e34_hooks/post-commit" <<HOOK
#!/bin/sh
if tmux -L "$AE_TMUX_SERVER" has-session -t "=e34order" 2>/dev/null; then
    echo alive >"$e34_probe"
else
    echo gone >"$e34_probe"
fi
HOOK
    chmod +x "$e34_hooks/post-commit"
    # Ordinary work, so end has something to commit and the hook is reached at all.
    printf 'work\n' >"$e34_wd/agent-work.txt"
    "$AE" end -f e34order >/dev/null 2>&1 || true
    sleep 1
    # THE PROPERTY: at snapshot time the session is already gone, so nothing can
    # still be writing into the tree being committed. Red on the old order.
    assert_eq "end-order (#34): the session is already STOPPED when end takes its snapshot" "gone" \
        "$(cat "$e34_probe" 2>/dev/null || echo "hook-never-ran")"
    # ...control, so the seed cannot pass by the commit never happening.
    assert_eq "end-order (#34): the work reached the remote (the probe is live)" "1" \
        "$(git -C "$E34_REMOTE" log -1 --name-only --format= "ae/e34order" 2>/dev/null | command grep -qx 'agent-work.txt' && echo 1 || echo 0)"
    rm -f "$e34_probe"
fi
"$AE" end -f --assume-stopped e34order >/dev/null 2>&1 || true
rm -rf "$HOME/.ae/sessions/e34order" "$E34_REMOTE"
unset E34_R E34_REMOTE e34_wd e34_probe e34_hooks _i
fi

# ── #34: a failed push leaves everything, and SAYS the session is stopped ──
if _itest_section '#34: a failed push leaves everything, and SAYS the session is stopped'; then
# Before the reorder, "Session preserved" was accurate — the kill had not happened
# yet. After it, the same path leaves the session STOPPED, and "preserved" reads as
# "still running, go back to it". The message has to say which.
E34_R2="$(setup_repo)"
E34_REMOTE2="$TMPDIR/e34-remote2.git"
git -C "$E34_R2" clone -q --bare "$E34_R2" "$E34_REMOTE2" 2>/dev/null
git -C "$E34_R2" remote add origin "$E34_REMOTE2" 2>/dev/null || git -C "$E34_R2" remote set-url origin "$E34_REMOTE2"
# Refuse every push, deterministically — the same shape as a real pre-receive gate.
mkdir -p "$E34_REMOTE2/hooks"
printf '#!/bin/sh\necho "refused by policy" >&2\nexit 1\n' >"$E34_REMOTE2/hooks/pre-receive"
chmod +x "$E34_REMOTE2/hooks/pre-receive"
(cd "$E34_R2" && "$AE" --worktree e34push &) 2>/dev/null
wait_for_session "e34push" || true
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/e34push/meta" ]] && break; sleep 0.3; done
e34_wd2="$(command grep '^work_dir=' "$HOME/.ae/sessions/e34push/meta" 2>/dev/null | cut -d= -f2- || true)"
