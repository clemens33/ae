(cd "$A48_REPO" && "$AE" --local arch-lonely &) 2>/dev/null
wait_for_session "arch-lonely" 20
sleep 1
"$HOME/.ae/sessions/arch-lonely/memo" add --topic handover "kept even with no roster" >/dev/null 2>&1 || true
