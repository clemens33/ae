    "$(tmux has-session -t comp-gate2 2>/dev/null; echo $?)"
assert_eq "compact-gate2: and nothing was archived under the id it was never authorized for" "0" \
    "$([[ -e "$HOME/.ae/archive/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee" ]] && echo 1 || echo 0)"
_sed_i -e "s|^session_id=.*|session_id=cccccccc-dddd-eeee-ffff-000000000000|" "$C48G_DIR/meta"
"$AE" end -f --keep-history comp-gate2 >/dev/null 2>&1 || true
unset C48G_REPO C48G_DIR C48G_PANE c48g c48g_rc

# --keep-history MUST BE ABLE TO COMPLETE A COMPACT. The old arm was labelled "proceeds
