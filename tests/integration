# ── identity v2: resuming a v1 meta MIGRATES it in place ─────────────
if _itest_section 'identity v2: resuming a v1 meta migrates the roster in place'; then
# Every session on disk before P34 carries `agent.<slot>=<alias>:<name>[:<sid>]`, and the
# glue no longer reads that row at all. So resume has to convert it, in the session's own
# meta, before anything else looks at the roster — otherwise a human's existing sessions
# become unresumable the day they upgrade. This drives the real path: a session ae itself
# created, rewritten BACK to the v1 shape, then resumed for real.
REPO_MIG="$(setup_repo)"
(cd "$REPO_MIG" && "$AE" --local test-migrate &) 2>/dev/null
wait_for_session "test-migrate"
sleep 1
MIG_META="$HOME/.ae/sessions/test-migrate/meta"
tmux kill-session -t test-migrate 2>/dev/null || true
sleep 0.5
# Rewrite to the v1 shape: drop every v2 roster row, put the single alias:name:sid line
# back, and add a spawned entry so the migration is proven on more than one slot.
# awk + mv by hand: `sed -i EXPR FILE` reads EXPR as a backup suffix on BSD.
awk '
    /^schema=/ || /^seat\./ || /^profile\./ || /^harness_session\./ { next }
    /^agent_bin\.spawned\./ { next }
    { print }
    END { print "agent.main=dummy:dummy:pending"
          print "agent.spawned.3=dummy2:ghost:pending"
          print "agent_bin.spawned.3=bash" }
' "$MIG_META" >"$MIG_META.v1" && mv "$MIG_META.v1" "$MIG_META"
# THE CONTROL: the fixture really is v1 now, or the migration below proves nothing.
assert_eq "v1-migrate: (control) the fixture carries the v1 roster and no v2 rows" "1|0" \
    "$(printf '%s|%s' \
        "$(command grep -qxF 'agent.main=dummy:dummy:pending' "$MIG_META" && echo 1 || echo 0)" \
        "$(grep -cE '^(schema|seat\.|profile\.|harness_session\.)' "$MIG_META" | tr -d '[:space:]')")"
(cd "$REPO_MIG" && "$AE" --local test-migrate &) 2>/dev/null
wait_for_session "test-migrate"
sleep 2
assert_eq "v1-migrate: the session really resumed" "0" "$(tmux has-session -t test-migrate 2>/dev/null; echo $?)"
assert_eq "v1-migrate: the meta is schema 2 afterwards" "1" \
    "$(command grep -qxF 'schema=2' "$MIG_META" && echo 1 || echo 0)"
assert_eq "v1-migrate: main became seat + profile rows" "1" \
    "$(command grep -qxF 'seat.main=dummy' "$MIG_META" &&
       command grep -qxF 'profile.main=dummy' "$MIG_META" && echo 1 || echo 0)"
assert_eq "v1-migrate: the spawned slot kept its INDEX through the migration" "1" \
    "$(command grep -qxF 'seat.spawned.3=ghost' "$MIG_META" &&
       command grep -qxF 'profile.spawned.3=dummy2' "$MIG_META" && echo 1 || echo 0)"
assert_eq "v1-migrate: the harness session id moved to its own row" "1" \
    "$(command grep -qxF 'harness_session.main=pending' "$MIG_META" && echo 1 || echo 0)"
# IN PLACE means the v1 rows are GONE, not shadowed. A meta carrying both is a roster in
# doubt, and the core refuses it — so leaving them would break the NEXT resume.
assert_eq "v1-migrate: no agent.<slot> row survives the migration" "0" \
    "$(grep -c '^agent\.' "$MIG_META" | tr -d '[:space:]')"
# ...and the running pane carries the migrated NAME, not the old alias:name reference.
assert_eq "v1-migrate: the resumed pane is labelled with the bare name" "dummy" \
    "$(tmux list-panes -s -t test-migrate -F '#{@ae_agent} #{@ae_slot}' 2>/dev/null | awk '$2=="main"{print $1}')"
"$AE" end -f test-migrate >/dev/null 2>&1 || true
sleep 0.5
unset REPO_MIG MIG_META
fi

