    _sed_i -e "s/^_AE_ENTRY_VERSION=.*/_AE_ENTRY_VERSION=\"${version}\"/" "$dir/ae"
    # ONE FIXTURE MEMBER ANSWERS EVERYTHING since slice Z1: the wrapper execs the
    # core for every command, so the stub core carries its own `--version` (which the
    # pair validation reads), the `_probe` these assertions consume, and a launch
    # marker. The caller's argv follows the frozen preamble's `--`.
    cat >"$dir/ae-core" <<EOF
#!/usr/bin/env bash
if [ "\${1:-}" = "--version" ]; then echo "ae ${version}"; exit 0; fi
${extra_core:+# different bytes}
_seen=0
_argv=()
for _w in "\$@"; do
    if [ "\$_seen" = 1 ]; then _argv[\${#_argv[@]}]="\$_w"; continue; fi
    if [ "\$_w" = "--" ]; then _seen=1; fi
done
if [ "\${_argv[0]:-}" = "_probe" ]; then
    echo "AE_HOME=\${AE_HOME-UNSET}"
    echo "CONFIG_FILE=\${CONFIG_FILE-UNSET}"
    if [ -n "\${AE_TMUX_SERVER+x}" ]; then echo "AE_TMUX_SERVER=\$AE_TMUX_SERVER"; else echo "AE_TMUX_SERVER=UNSET"; fi
    if [ -n "\${AE_CORE_BIN+x}" ]; then echo "AE_CORE_BIN=\$AE_CORE_BIN"; else echo "AE_CORE_BIN=UNSET"; fi
    exit 0
fi
echo "launched \${_argv[0]:-}"
EOF
    cp "$P5I_SRC/install" "$dir/install"
    chmod "$pack_mode" "$dir/ae" "$dir/ae-core" "$dir/install"
    chmod "$pack_mode" "$dir"
    tar -czf "$P5I_ROOT/${root}.tar.gz" -C "$P5I_ROOT" "$root"
    chmod u+w "$dir" 2>/dev/null || true
    digest="$(_p5i_sha "$P5I_ROOT/${root}.tar.gz")"
    printf '%s  %s.tar.gz\n' "$digest" "$root" >"$P5I_ROOT/${root}-SHA256SUMS"
}
_p5i_install() {
    local version="$1" extra="${2:-}" pack_mode="${3:-0755}"
    _p5i_make_bundle "$version" "$extra" "$pack_mode"
    HOME="$P5I_HOME" AE_VERSION="$version" TMPDIR="$P5I_TMP" \
        AE_BUNDLE="$P5I_ROOT/ae-${version}-${P5I_PLAT}.tar.gz" \
        AE_SUMS="$P5I_ROOT/ae-${version}-${P5I_PLAT}-SHA256SUMS" \
        "${BASH:-bash}" "$P5I_SRC/install" 2>&1
}

