for _i in $(seq 1 40); do [[ -f "$HOME/.ae/sessions/tr-a/meta" && -f "$HOME/.ae/sessions/tr-b/meta" ]] && break; sleep 0.4; done
sleep 1
TR_A="$HOME/.ae/sessions/tr-a"
TR_B="$HOME/.ae/sessions/tr-b"
assert_eq "tracked-resolution: (setup) both sessions carry the same colliding agent ref" "dummy dummy" \
    "$(sed -n 's/^seat.main=//p' "$TR_A/meta" "$TR_B/meta" | tr '\n' ' ' | sed 's/ $//')"
# A PANELESS ask from tr-a, explicitly naming tr-b: it must reach tr-b on its recorded
# server. Before the recorded-server fix a pane-less caller enumerated the ambient (default)
# server, which holds neither session, so this could not resolve at all.
tr_rc=0
AE_SENDER_OVERRIDE="ae:probe:tr" "$TR_A/ask" tr-b:dummy "routed on the recorded server" >/dev/null 2>&1 || tr_rc=$?
assert_eq "tracked-resolution: the paneless cross-session ask resolves and delivers" "0" \
    "$([[ $tr_rc -eq 0 ]] && echo 0 || echo 1)"
# The ask is recorded in the CALLER's (tr-a's) log; its target_session names tr-b — proof it
# reached the session it named and not tr-a's identically-named twin.
assert_eq "tracked-resolution: it routed to tr-b, the session it named, not the caller's twin" "1" \
    "$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "target_session") print $(i + 2) }' "$TR_A/events.jsonl" 2>/dev/null | grep -c '^tr-b$' | tr -d '[:space:]')"
