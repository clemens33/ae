tmux send-keys -t "$lp_lead_pane" "$HOME/.ae/sessions/test-leadpair/send colead envelope-probe-body" Enter 2>/dev/null || true
sleep 3
lp_env_content="$(tmux capture-pane -p -t "$lp_colead_pane" 2>/dev/null | tr -d '\n')"
assert_eq "envelope (#39): a send FROM an agent pane carries that agent as sender" "1" \
