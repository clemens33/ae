# codex draws its input box before it can act on input — measured cold 2026-08-15:
# box at t=0.5s while the header still reads "model: loading", MCP servers still
# starting to t=2.5s, settled t=3.0s. The old readiness predicate answered READY from
# t=0.5s, so the bounded wait meant to protect the paste succeeded on its first poll.
#
# The seed uses a STUB tool that reproduces that shape deterministically and with no
# network: print a codex-shaped start-up screen, hold it, then settle. Asking the real
# predicate against a real pane is the point — a stubbed predicate would only test the
# stub.
r36_stub="$TMPDIR/slowtool.sh"
cat >"$r36_stub" <<'STUB'
#!/bin/sh
# Codex-shaped cold start, byte-faithful where it matters. The LIVE PROMPT is present
# in EVERY phase — bold U+203A then a DIM placeholder, exactly as captured from
# codex v0.147.0 — because that is the whole point: the input box looks ready the
# entire time, and only the START-UP markers tell the phases apart. A stub that drew
# a plain ASCII '>' proved nothing; the sensor found no live prompt and said
# indeterminate, which was the sensor being right about an unfaithful specimen.
prompt() {
    printf '\033[1m\342\200\272\033[0m \033[2mWrite tests for @filename\033[0m\n'
    printf '\n  \033[2mstub-model xhigh \302\267 /tmp\033[0m\n'
}
printf '\033[2J\033[H'
printf '\342\224\202 >_ OpenAI Codex (v0.147.0)              \342\224\202\n'
printf '\342\224\202 model:       loading   /model to change \342\224\202\n\n'
prompt
sleep 3
printf '\033[2J\033[H'
printf '\342\224\202 model:       stub-model xhigh   /model to change \342\224\202\n\n'
printf '\342\200\242 Starting MCP servers (0/7): alpha, beta\n\n'
prompt
sleep 3
printf '\033[2J\033[H'
printf '\342\224\202 model:       stub-model xhigh   /model to change \342\224\202\n\n'
prompt
while :; do sleep 5; done
STUB
chmod +x "$r36_stub"
tmux new-window -d -t "$AE_TMUX_SERVER:" -n r36 "$r36_stub" 2>/dev/null ||
    tmux new-session -d -s r36probe "$r36_stub" 2>/dev/null
r36_pane="$(tmux list-panes -a -F '#{pane_id} #{window_name}' 2>/dev/null | awk '$2=="r36"{print $1; exit}')"
if [[ -z "$r36_pane" ]]; then
