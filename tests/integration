# a fleet that no longer exists is worse than no roster.
REPO_ROST="$(setup_repo)"
(cd "$REPO_ROST" && "$AE" --local test-roster &) 2>/dev/null
wait_for_session "test-roster"
ROSTD="$HOME/.ae/sessions/test-roster/watchdog"
