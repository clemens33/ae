assert_eq "send-focus: active pane is the lead after send to the same-window seat-mate" "$lp_lead_pane" "$lp_active_after"
lp_colead_pane="$(tmux list-panes -s -t test-leadpair -F '#{@ae_agent} #{pane_id}' 2>/dev/null | awk '$1=="colead"{print $2}')"
lp_colead_content="$(tmux capture-pane -p -t "$lp_colead_pane" 2>/dev/null | tr -d '\n')"
assert_eq "send-focus: inactive seat-mate RECEIVED the paste" "1" "$([[ "$lp_colead_content" == *focus-regression-ping* ]] && echo 1 || echo 0)"
# #39: an unbindable caller is MARKED UNVERIFIED, never left bare and never given
# somebody else's name. The send above ran from the suite's own shell, which cannot be
# positively bound to a stamped pane — previously that resolved to "human" (bare), which
# is the accidental authority grant the envelope exists to prevent.
assert_eq "envelope (#39): an unbindable sender is marked unverified, not bare" "1" \
    "$([[ "$lp_colead_content" == *"⟦ae:msg from unverified⟧"* ]] && echo 1 || echo 0)"
# ...and a send issued FROM an agent pane is marked with that agent. Driven through
