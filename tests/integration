if _itest_section '#28 boundary: ONE definition, in the runtime that calls it'; then
# Round-3 BLOCKER. daemon_session_running lived ONLY inside the telegram daemon's
# single-quoted heredoc, so ae's own top-level callers invoked an
# UNDEFINED command: rc 127, swallowed by their `2>/dev/null`, which is neither
# "running" nor "unknown" and therefore fell straight through to CREATE — the
# fix for #28 never ran on the live attach path at all. The generated daemon is
# gone with the bash bridge, so only ae's own runtime is left to check — and it
# is the one the callers were always in. It is checked by SOURCING real bytes and
# asking bash's own function table, never by awk-extracting a specimen that exists
# in no runtime.
TGB="$TMPDIR/tgboundary"
mkdir -p "$TGB/fakehome/.ae"
cat >"$TGB/trap.sh" <<'TRAPEOF'
{
    for f in daemon_session_running _tmux_err_is_clean_dead; do
        if declare -F "$f" >/dev/null 2>&1; then echo "top:PRESENT $f"; else echo "top:MISSING $f"; fi
    done
    # ...and the tri-state actually answers, both error directions. The rc is
    # captured explicitly: ae runs under errexit, where a bare `absent` probe
    # would abort the trap instead of reporting 1.
    _dsr_probe() { local rc=0; daemon_session_running "$1" || rc=$?; echo "$2=$rc"; }
    tmux() { printf "aedev\norchestrator\n"; }
    _dsr_probe orchestrator running
    _dsr_probe hub absent
    tmux() { echo "no server running on /tmp/x" >&2; return 1; }
    _dsr_probe orchestrator stale
    tmux() { echo "error connecting to /tmp/x (No such file or directory)" >&2; return 1; }
    _dsr_probe orchestrator enoent
} >&9
TRAPEOF
# ae runs on source, so the probe rides an EXIT trap (which fires on ae's own
# exit, with every top-level definition in scope) and reports on a saved fd.
# shellcheck disable=SC2016  # $1/$2 are the INNER shell's positional args, by design
tg_top="$(HOME="$TGB/fakehome" AE_HOME="$TGB/fakehome/.ae" "${BASH:-bash}" -c '
    exec 9>&1
    trap ". $2" EXIT
    source "$1" version >/dev/null 2>&1
' _ "$AE" "$TGB/trap.sh")"
assert_eq "#28 boundary: ae's OWN top level defines the probe its autostarts call" "1" \
    "$([[ "$tg_top" == *'top:PRESENT daemon_session_running'* ]] && echo 1 || echo 0)"
assert_eq "#28 boundary: ...and the classifier that probe depends on" "1" \
    "$([[ "$tg_top" == *'top:PRESENT _tmux_err_is_clean_dead'* ]] && echo 1 || echo 0)"
assert_eq "#28 boundary: tri-state answers in ae's runtime (stale=absent, ENOENT=unknown)" \
    "running=0|absent=1|stale=1|enoent=2" \
    "$(printf '%s\n' "$tg_top" | command grep -E '^(running|absent|stale|enoent)=' | paste -sd'|' -)"
