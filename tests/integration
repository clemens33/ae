    P36_BARE="$TMPDIR/p36-bare.git"
    git init --bare -q "$P36_BARE"
    P36_REPO="$(setup_repo)"
    git -C "$P36_REPO" remote add origin "$P36_BARE"
    git -C "$P36_REPO" push -q origin HEAD:refs/heads/main 2>/dev/null || true

