    assert_not_exists "p3.6 route: the copy session state is gone" "$HOME/.ae/sessions/p36-copy"
    assert_not_exists "p3.6 route: the copy workdir is gone" "$HOME/.ae/worktrees/p36-copy"
    assert_not_exists "p3.6 route: no session tombstone" "$HOME/.ae/sessions/.ending.p36-copy"
