    P1_LONG_BODY="$(printf '%8193s' '' | tr ' ' x)"
    # One ask into each real renderer.  The target is a pane id, never a name from the
    # live session.  Since A.1 the helper EXECs the pinned core, which owns resolution,
    # the id and the event and calls BACK into this session's `_send-deliver` for the
    # paste — so the transport under test is still the frozen bash send body.
    # AE_SENDER_OVERRIDE supplies the caller identity a paneless rig has no stamp for.
    P1_ASK_CLAUDE_RC=0
    AE_SEND_DEFER_SEC=90 AE_SENDER_OVERRIDE=worker "$P1_RIG_BASH" "$P1_RIG_META/ask" "$P1_CLAUDE_PANE" "$P1_LONG_BODY" >"$TMPDIR/pb1-ask-claude.out" 2>"$TMPDIR/pb1-ask-claude.err" || P1_ASK_CLAUDE_RC=$?
    P1_ASK_CODEX_RC=0
    AE_SEND_DEFER_SEC=90 AE_SENDER_OVERRIDE=lead "$P1_RIG_BASH" "$P1_RIG_META/ask" "$P1_CODEX_PANE" "$P1_LONG_BODY" >"$TMPDIR/pb1-ask-codex.out" 2>"$TMPDIR/pb1-ask-codex.err" || P1_ASK_CODEX_RC=$?
        assert_eq "P-B1 rig: Claude oversized ask helper exits successfully" "0" "$P1_ASK_CLAUDE_RC"
        assert_eq "P-B1 rig: Codex oversized ask helper exits successfully" "0" "$P1_ASK_CODEX_RC"
        P1_ASK_N="$(grep -c '"action":"ask"' "$P1_RIG_META/events.jsonl" 2>/dev/null || true)"
        assert_eq "P-B1 rig: both oversized asks record delivery events" "2" "$P1_ASK_N"
        if [[ -f "$P1_RIG_META/events.jsonl" ]]; then

        # Load the notice helpers from the exact current ae for receiver-side proof.
        eval "$(awk '/^_notice_reconstruct\(\) \{/,/^\}$/' "$AE")"
        eval "$(awk '/^_notice_prove\(\) \{/,/^\}$/' "$AE")"
        eval "$(awk '/^_notice_compose\(\) \{/,/^\}$/' "$AE")"
        P1_ASK_REF_CLAUDE="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' "$P1_RIG_META/events.jsonl" | head -1)"
        P1_ASK_REF_CODEX="$(awk -F'"' '/"action":"ask"/ { for (i = 1; i <= NF; i++) if ($i == "ref") print $(i + 2) }' "$P1_RIG_META/events.jsonl" | tail -1)"
        P1_BODY_CLAUDE="$(find "$P1_RIG_META/messages" -type f -name "${P1_ASK_REF_CLAUDE}.ask.*.txt" -print -quit 2>/dev/null || true)"
        P1_BODY_CODEX="$(find "$P1_RIG_META/messages" -type f -name "${P1_ASK_REF_CODEX}.ask.*.txt" -print -quit 2>/dev/null || true)"
        _AE_SESSION="$P1_RIG_SESS"; _AE_META_DIR="$P1_RIG_META"; _AE_SESSIONS_DIR="$(dirname "$P1_RIG_META")"
        _notice_compose ask "$P1_ASK_REF_CLAUDE" worker "$P1_BODY_CLAUDE" "$P1_RIG_SESS"; P1_NOTICE_CLAUDE="$_NOTICE_PAYLOAD"
        _notice_compose ask "$P1_ASK_REF_CODEX" lead "$P1_BODY_CODEX" "$P1_RIG_SESS"; P1_NOTICE_CODEX="$_NOTICE_PAYLOAD"
        # The helper returns only after its pre-Enter proof and submit.  Wait for each
        # real TUI to echo the submitted notice into its transcript, then reconstruct
        # only the prompt-to-terminal-sentinel rows; status/tool rows below it are not
        # part of the notice and must not be fed to the input-region proof function.
        p1_transcript_prove() {
            local tool="$1" capture="$2" intended="$3" head line rows="" started=0 orn tail candidate
            head="${intended%% LONG BODY*}"
            [[ "$head" != "$intended" ]] || return 1
            if [[ "$head" =~ \[([^]]+)\] ]]; then
                tail="⟧${BASH_REMATCH[1]}⟧"
            else
                return 1
            fi
            case "$tool" in claude) orn='❯' ;; codex) orn='›' ;; *) return 1 ;; esac
            if [[ "$tool" == codex ]]; then
                candidate="$(_notice_reconstruct "$tool" "$capture" "$intended")" || return 1
                [[ "$candidate" == "$head"* && "$candidate" == *"$tail" ]] || return 1
                [[ "$candidate" == "$intended" ]] || return 1
                return 0
            fi
            while IFS= read -r line || [[ -n "$line" ]]; do
                if ((started == 0)); then
                    [[ "$line" == *"$orn"*"$head"* ]] || continue
                    started=1
                fi
                rows+="$line"$'\n'
                [[ "$line" == *"$tail"* ]] || continue
                candidate="$(_notice_reconstruct "$tool" "$rows" "$intended")" || return 1
                [[ "$candidate" == "$head"* && "$candidate" == *"$tail" ]] || return 1
                [[ "$candidate" == "$intended" ]] || return 1
                return 0
            done <<<"$capture"
            return 1
        }
        p1_body_read() {
            local capture="$1" body="$2" base line
            base="${body##*/}"
            while IFS= read -r line || [[ -n "$line" ]]; do
                [[ "$line" == *"$base"* ]] || continue
                [[ "$line" == *cat* || "$line" == *Read* || "$line" == *read* ]] && return 0
            done <<<"$capture"
            return 1
        }
        P1_TRANSCRIPT_CLAUDE=0 P1_TRANSCRIPT_CODEX=0
        P1_READ_CLAUDE=0 P1_READ_CODEX=0
        for _p1_i in $(seq 1 60); do
            P1_CAP_CLAUDE="$(p1_tmux capture-pane -S - -p -t "$P1_CLAUDE_PANE" 2>/dev/null || true)"
            P1_CAP_CODEX="$(p1_tmux capture-pane -S - -p -t "$P1_CODEX_PANE" 2>/dev/null || true)"
            p1_transcript_prove claude "$P1_CAP_CLAUDE" "$P1_NOTICE_CLAUDE" && P1_TRANSCRIPT_CLAUDE=1 || true
            p1_transcript_prove codex "$P1_CAP_CODEX" "$P1_NOTICE_CODEX" && P1_TRANSCRIPT_CODEX=1 || true
            p1_body_read "$P1_CAP_CLAUDE" "$P1_BODY_CLAUDE" && P1_READ_CLAUDE=1 || true
            p1_body_read "$P1_CAP_CODEX" "$P1_BODY_CODEX" && P1_READ_CODEX=1 || true
            ((P1_TRANSCRIPT_CLAUDE && P1_TRANSCRIPT_CODEX && P1_READ_CLAUDE && P1_READ_CODEX)) && break
            sleep 1
        done
        assert_eq "P-B1 rig: Claude transcript reconstructs the exact notice" "1" "$P1_TRANSCRIPT_CLAUDE"
        assert_eq "P-B1 rig: Codex transcript reconstructs the exact notice" "1" "$P1_TRANSCRIPT_CODEX"

        assert_eq "P-B1 rig: Claude's first tool call names the sender body" "1" "$P1_READ_CLAUDE"
        assert_eq "P-B1 rig: Codex's first tool call names the sender body" "1" "$P1_READ_CODEX"
        else
            assert_eq "P-B1 rig: ask helpers leave an event log" "1" "0"
        fi
    else
        assert_eq "P-B1 rig: missing metadata is a launch failure, not an awk abort" "1" "0"
    fi
fi
# The rig is disposable and isolated. Run the same cleanup registered in the EXIT
# trap before unsetting its paths, then restore the suite trap. Credential copies are
# asserted absent immediately after the opted-in run, not deferred to suite teardown.
if [[ "${P1_CLEANED:-}" == 0 ]]; then
