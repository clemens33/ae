env >"$TGG_FIX/env.last"
case "\$*" in
    "-L default list-sessions"*)
        if [ -f "$TGG_FIX/unknown" ]; then
            echo "error connecting to /tmp/tmux-501/default (Permission denied)" >&2
            exit 1
        fi
        if [ -f "$TGG_FIX/flip" ]; then
