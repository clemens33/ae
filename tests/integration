sleep 1
C48S_UUID="$(grep '^session_id=' "$HOME/.ae/sessions/comp-snap/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]')"
(
    for _c48s_i in $(seq 1 160); do
        [[ -d "$HOME/.ae/archive/${C48S_UUID}" ]] && break
        sleep 0.25
    done
    printf '[agents]\ndummy = "bash"\ndummy2 = "bash"\n\n[workspace]\nmain = dummy2\n' >"$C48S_REPO/.ae/config"
) &
(cd "$C48S_REPO" && "$AE" compact -f --digest-only comp-snap >/dev/null 2>&1) || true
wait || true
sleep 3
# THE CONTROL FIRST: if the rewrite did not land, everything below passes for free.
assert_eq "compact-snapshot: (control) the live config really was rewritten under the launch" "dummy2" \
    "$(sed -n 's/^main = *//p' "$C48S_REPO/.ae/config" | tail -1)"
assert_eq "compact-snapshot: the child starts the roster the human was SHOWN" "dummy" \
    "$(grep '^agent.main=' "$HOME/.ae/sessions/comp-snap/meta" 2>/dev/null | cut -d= -f2- | cut -d: -f1)"
assert_eq "compact-snapshot: and it really is the child, not the survivor" "1" \
    "$(grep -c "^parent_archive_id=${C48S_UUID}$" "$HOME/.ae/sessions/comp-snap/meta" 2>/dev/null | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-snap >/dev/null 2>&1 || true
unset C48S_REPO C48S_UUID


# ── compact (c)+(d): it hands over, it ends, it comes back ─────────────────────
# The happy path proves the WHOLE boundary in one run: the five-line stdout contract
# in order, the archive published with the session's own semantics inside it, the
# source gone, and a genuinely NEW session under the same name that knows its parent.
C48B_REPO="$(setup_repo)"
mkdir -p "$C48B_REPO/.ae"
printf '[workspace]\npurge_agent_history = false\n' >"$C48B_REPO/.ae/config"
(cd "$C48B_REPO" && "$AE" --local comp-full &) 2>/dev/null
wait_for_session "comp-full" 20
sleep 1
C48B_DIR="$HOME/.ae/sessions/comp-full"
C48B_UUID="$(grep '^session_id=' "$C48B_DIR/meta" | cut -d= -f2- | tr '[:upper:]' '[:lower:]')"
"$C48B_DIR/memo" add --topic handover "the thing the next session must know" >/dev/null 2>&1 || true
"$C48B_DIR/goal" "prove compact end to end" >/dev/null 2>&1 || true
c48b_out="$TMPDIR/c48b.out"
(cd "$C48B_REPO" && "$AE" compact -f --digest-only comp-full >"$c48b_out" 2>"$TMPDIR/c48b.err") &
for _c48b_i in $(seq 1 90); do
    grep -q "Starting fresh session" "$c48b_out" 2>/dev/null && break
    sleep 1
done
wait || true
sleep 2
# THE OUTPUT CONTRACT: five lines, this order. Recovery is printed BEFORE the relaunch
# because after that line the process may exec and never return.
assert_eq "compact-out: line 1 names the archive id" "1" \
    "$(sed -n '1p' "$c48b_out" | grep -c "^Archived ${C48B_UUID}$" | tr -d '[:space:]')"
assert_eq "compact-out: line 2 the archive path" "1" \
    "$(sed -n '2p' "$c48b_out" | grep -c "^Archive: .*/archive/${C48B_UUID}$" | tr -d '[:space:]')"
assert_eq "compact-out: line 3 the digest path" "1" \
    "$(sed -n '3p' "$c48b_out" | grep -c "^Digest: .*/archive/${C48B_UUID}/digest.md$" | tr -d '[:space:]')"
assert_eq "compact-out: line 4 the recovery command, BEFORE the relaunch" "1" \
    "$(sed -n '4p' "$c48b_out" | grep -c "^Recovery: cd .* comp-full --from ${C48B_UUID}$" | tr -d '[:space:]')"
# THE CONTRACT STOPS AT WHAT IS TRUE AT THAT INSTANT. "Starting fresh session" was on
# stdout and claimed a launch that can still refuse — the name is claimable in the release
# window — so a caller could read "replaced" from a run that only archived. What stdout
# now promises is exactly what holds: THE ARCHIVE EXISTS AND THE PRINTED RECOVERY COMMAND
# WILL WORK. The relaunch announcement is progress, and progress is stderr.
# COMPACT'S OWN stdout is four lines — but it EXECS into the launch, and the child
# inherits the same stdout, so anything after line 4 belongs to the fresh session and is
# not compact speaking. Assert the boundary rather than a total count: the four contract
# lines come first, and nothing compact prints follows them.
assert_eq "compact-out: the four contract lines come first, and are all compact writes to stdout" "4" \
    "$(head -4 "$c48b_out" | grep -cE '^(Archived |Archive: |Digest: |Recovery: )' | tr -d '[:space:]')"
assert_eq "compact-out: anything after them is the CHILD, not compact — no further contract lines" "0" \
    "$(tail -n +5 "$c48b_out" | grep -cE '^(Archived |Archive: |Digest: |Recovery: )' | tr -d '[:space:]')"
assert_eq "compact-out: it does NOT claim a relaunch that can still refuse" "0" \
    "$(grep -c "Starting fresh session" "$c48b_out" | tr -d '[:space:]')"
assert_eq "compact-out: the relaunch announcement is progress, so it is on stderr" "1" \
    "$(grep -c "^Starting fresh session comp-full from archive ${C48B_UUID}" "$TMPDIR/c48b.err" | tr -d '[:space:]')"
assert_eq "compact-out: and the recovery command reaches stderr too, so a broken stdout cannot lose it" "1" \
    "$(grep -c "^Recovery: cd .* comp-full --from ${C48B_UUID}$" "$TMPDIR/c48b.err" | tr -d '[:space:]')"
assert_eq "compact-out: end's own progress stays off the contract (no duplicate Archived)" "1" \
    "$(grep -c '^Archived ' "$c48b_out" | tr -d '[:space:]')"
# THE ARCHIVE
assert_eq "compact: the archive is published" "1" \
    "$([[ -f "$HOME/.ae/archive/${C48B_UUID}/digest.md" ]] && echo 1 || echo 0)"
assert_contains "compact: the handover memo travelled into the digest" \
    "the thing the next session must know" "$(cat "$HOME/.ae/archive/${C48B_UUID}/digest.md")"
assert_contains "compact: and the goal" "prove compact end to end" \
    "$(cat "$HOME/.ae/archive/${C48B_UUID}/digest.md")"
assert_contains "compact: the archive keeps the id's real provenance" "archive_id_origin=session" \
    "$(cat "$HOME/.ae/archive/${C48B_UUID}/meta")"
# THE CHILD
assert_eq "compact: a fresh session is live under the same name" "0" \
    "$(tmux has-session -t comp-full 2>/dev/null; echo $?)"
C48B_NEWUUID="$(grep '^session_id=' "$C48B_DIR/meta" 2>/dev/null | cut -d= -f2- | tr '[:upper:]' '[:lower:]')"
assert_eq "compact: the child is a NEW session, not the old one resumed" "1" \
    "$([[ -n "$C48B_NEWUUID" && "$C48B_NEWUUID" != "$C48B_UUID" ]] && echo 1 || echo 0)"
assert_contains "compact: and it records the archive it continues" \
    "parent_archive_id=${C48B_UUID}" "$(cat "$C48B_DIR/meta")"
assert_eq "compact: every agent sees the pointer in workspace.md" "1" \
    "$(grep -c '^## Parent archive' "$C48B_DIR/workspace.md" | tr -d '[:space:]')"
assert_eq "compact: the child carries no spawned slot from the source" "0" \
    "$(grep -c '^agent\.spawned\.' "$C48B_DIR/meta" | tr -d '[:space:]')"
assert_eq "compact: conversation history was kept (nothing purged)" "0" \
    "$(grep -c 'removed claude conversation' "$TMPDIR/c48b.err" | tr -d '[:space:]')"
"$AE" end -f --keep-history comp-full >/dev/null 2>&1 || true
unset C48B_DIR C48B_UUID C48B_NEWUUID c48b_out

# THE HISTORY POLICY IS A CONTRADICTION, NOT A DETAIL. compact exists to keep the
# record; a session configured to purge it must be resolved by the human, and a flip
# to purge WHILE the human is answering must refuse rather than carry out a different
# operation than the one on screen.
C48B_PREPO="$(setup_repo)"
mkdir -p "$C48B_PREPO/.ae"
printf '[workspace]\npurge_agent_history = true\n' >"$C48B_PREPO/.ae/config"
