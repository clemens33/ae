tmux run-shell -t foalpha \
    "env HOME='$HOME' AE_HOME='$AE_HOME' '$AE' stop all -y --pane=#{pane_id} >'$TMPDIR/fo.out' 2>&1" || true
for _i in $(seq 1 90); do
