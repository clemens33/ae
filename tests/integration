# ── #27: launch.<slot>.sh survives being re-run ──────────────────────
# The human /exits the TUI (to pick up a globally-updated MCP config, say) and
# arrow-ups the launch script. It bakes `--session-id UUID` — creation semantics
# — so before the fix every re-run died with "Session ID <uuid> is already in
# use" and the conversation was unreachable. Stand-in for claude: --session-id
# is create-once and COLLIDES on a second create, --resume replays. The command
# must literally begin with "claude" — that prefix is what makes ae inject an
# upfront UUID at all — so it goes on PATH rather than being named absolutely.
RR_BIN="$TMPDIR/bin27"
mkdir -p "$RR_BIN" "$TMPDIR/rr-state"
: >"$TMPDIR/rr.log"
{
    printf '#!/usr/bin/env bash\n'
    printf 'log=%q\n' "$TMPDIR/rr.log"
    printf 'state=%q\n' "$TMPDIR/rr-state"
    cat <<'RRSTUB'
mode=""; id=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --session-id) mode=create; id="$2"; shift 2 ;;
        --resume) mode=resume; id="$2"; shift 2 ;;
        *) shift ;;
    esac
done
case "$mode" in
    create)
        if [[ -e "$state/$id" ]]; then
            printf 'COLLIDE %s\n' "$id" >>"$log"
            echo "Error: Session ID $id is already in use." >&2
            exit 1
        fi
        : >"$state/$id"
        printf 'CREATE %s\n' "$id" >>"$log"
        ;;
    resume) printf 'RESUME %s\n' "$id" >>"$log" ;;
    *) printf 'NOID\n' >>"$log" ;;
esac
RRSTUB
} >"$RR_BIN/claude"
chmod 0755 "$RR_BIN/claude"
RR_REPO="$(setup_repo)"
mkdir -p "$RR_REPO/.ae"
cat >"$RR_REPO/.ae/config" <<'EOF'
