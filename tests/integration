assert_eq "archive-retry: and left the session whole for the retry" "1" \
    "$([[ -f "$HOME/.ae/sessions/arch-retry/meta" ]] && echo 1 || echo 0)"
"$AE" end -f --keep-history arch-retry >/dev/null 2>&1 || true
assert_eq "archive-retry: the RETRY publishes once the obstruction is gone" "1" \
    "$([[ -n "$A48_RUUID" && -f "$HOME/.ae/archive/$A48_RUUID/meta" ]] && echo 1 || echo 0)"
assert_contains "archive-retry: ...and the archive records the id the session RAN under" \
    "source_session_id=$A48_RRAW" "$(cat "$HOME/.ae/archive/$A48_RUUID/meta" 2>/dev/null || echo MISSING)"
unset a48_retry_rc A48_RUUID A48_RRAW

# (I2) A session with no agents is still a session: its memo and events are worth
