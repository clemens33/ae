    Darwin:arm64) P5I_PLAT=darwin-arm64 ;;
    Linux:x86_64) P5I_PLAT=linux-x86_64-musl ;;
    *) P5I_PLAT=unknown ;;
esac

_p5i_mode() {
    if [[ "$(uname)" == "Darwin" ]]; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi
}
_p5i_inode() {
    if [[ "$(uname)" == "Darwin" ]]; then stat -f '%i' "$1"; else stat -c '%i' "$1"; fi
}
_p5i_sha() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk 'NR == 1 { print $1; exit }'
    else
        shasum -a 256 "$1" | awk 'NR == 1 { print $1; exit }'
