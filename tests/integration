a48_forbidden=""
for a48_f in send ask review reply requests state memo goal peek agents focus interrupt spawn retire _lib watchdog workspace.md meta.lock; do
    [[ -e "$A48_ARCH/$a48_f" ]] && a48_forbidden+="$a48_f "
done
[[ -n "$(find "$A48_ARCH" -name 'launch.*' -o -name '*.sid' -o -name '*.lock' 2>/dev/null)" ]] && a48_forbidden+="launch/sid/lock "
assert_eq "archive-end: no helper, launch script, SID or lock is in the archive" "" "$a48_forbidden"
a48_exec=""
while IFS= read -r a48_p; do
    a48_m="$(stat -f '%Lp' "$a48_p" 2>/dev/null || stat -c '%a' "$a48_p" 2>/dev/null)"
    if [[ -d "$a48_p" ]]; then [[ "$a48_m" == 700 ]] || a48_exec+="$a48_p=$a48_m "; else [[ "$a48_m" == 600 ]] || a48_exec+="$a48_p=$a48_m "; fi
