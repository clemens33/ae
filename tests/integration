        "$(tmux has-session -t "=stopself" 2>/dev/null && echo 0 || echo 1)" \
        "$(command grep -c '"action":"stop-request"' "$ss_ev" 2>/dev/null || echo 0)" \
        "$(command grep -c '"action":"stop-result"' "$ss_ev" 2>/dev/null || echo 0)" \
        "$([[ -f "$HOME/.ae/sessions/stopself/meta" ]] && echo 1 || echo 0)")"
assert_eq "stop (d): the recorded outcome is a VERIFIED kill, not an assumed one" "1" \
    "$(command grep '"action":"stop-result"' "$ss_ev" 2>/dev/null | tail -1 | command grep -qF 'verified gone' && echo 1 || echo 0)"
"$AE" end -f stopself >/dev/null 2>&1 || true
unset SS_REPO SS_REPO3 SS_REPO4 SS_SRV ss_rc ss_out ss2_rc ss2_out ss3_rc ss3_out ss_pane ss_ev

# (e) `ae stop all` FROM INSIDE one of the sessions, at fleet size 3. Rounds 2-6
# read this as an ORDERING (finish the others, kill this pane last); round 7's F4
# moved the loop out of the caller entirely, so what it proves now is COMPLETION
# and ACCOUNTING with no ordering claim at all — every target stopped, and every
# outcome durable, including the two the dying pane never got to report.
SA_REPO="$(setup_repo)"
for _n in sa0self sa1 sa2; do
