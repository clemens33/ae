#!/usr/bin/env bash
# Integration tests for ae (requires tmux, git)
# Run: ./test-integration
# Uses an isolated tmux server and temp HOME — safe to run alongside real sessions.
set -euo pipefail

PASS=0
FAIL=0
ERRORS=()
AE="$(cd "$(dirname "$0")/.." && pwd)/ae"

# Isolated environment
TMPDIR="$(mktemp -d)"
# Unix socket paths must fit sun_path (104 bytes on macOS, 108 on Linux) and
# macOS mktemp hands out /var/folders/<20 chars>/T/tmp.XXXXXXXX — long enough to
# blow the limit on its own. Socket-path tests get this short dir instead.
SOCK_DIR="/tmp/ae-itest-$$"
mkdir -p "$SOCK_DIR"
export AE_TMUX_SERVER="ae-test-$$"
# Tripwire (2026-07-02 incident: the REAL ~/.ae/config was clobbered with a
# test fixture during a test window): fingerprint the real user's config
# BEFORE overriding HOME; cleanup screams and exits non-zero if it changed.
# Resolve the real home from the account DB, not $HOME (a nested run may already
# have overridden it). getent is glibc-only; macOS answers via dscl. $HOME is the
# last resort — still correct here, since this runs before the override below.
REAL_HOME="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)"
[[ -n "$REAL_HOME" ]] || REAL_HOME="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
[[ -n "$REAL_HOME" ]] || REAL_HOME="$HOME"
REAL_AE_CONFIG="${REAL_HOME}/.ae/config"
# Content fingerprint — GNU has md5sum, macOS md5; cksum is the POSIX floor.
_fpr() { md5sum 2>/dev/null || md5 2>/dev/null || cksum; }
if [[ -f "$REAL_AE_CONFIG" ]]; then REAL_CONFIG_FPR="$(_fpr <"$REAL_AE_CONFIG")"; else REAL_CONFIG_FPR="absent"; fi
# SUBJECT TRIPWIRE: the thing under test must not move while it is being tested. Python
# and friends rewrite the WHOLE file while bash reads a script INCREMENTALLY, so an `ae`
# invocation in flight can read a torn file — half old, half new — and fail, or far worse
# SUCCEED in a way that corresponds to no version anyone wrote. "It was only a comment" is
# irrelevant: the tear is in the BYTES, not the semantics. This has happened twice, both
# times to someone who knew the rule, which is why it is a mechanism here and not a habit:
# detection you cannot forget beats prevention you can.
AE_FPR_START="$(_fpr <"$AE")"
export HOME="$TMPDIR/home"
export AE_HOME="$HOME/.ae"
mkdir -p "$HOME/.ae"

cleanup() {
    command tmux -L "$AE_TMUX_SERVER" kill-server 2>/dev/null || true
    rm -rf "$TMPDIR" "$SOCK_DIR"
    local now_fpr
    if [[ -f "$REAL_AE_CONFIG" ]]; then now_fpr="$(_fpr <"$REAL_AE_CONFIG")"; else now_fpr="absent"; fi
    local ae_fpr_end
    ae_fpr_end="$(_fpr <"$AE" 2>/dev/null || echo missing)"
    if [[ "$ae_fpr_end" != "$AE_FPR_START" ]]; then
        echo "" >&2
        echo "FATAL: ae CHANGED WHILE THIS SUITE WAS RUNNING — the subject moved under the test." >&2
        echo "  Every result above is untrustworthy, including the passes: a script being" >&2
        echo "  rewritten can be read torn. Re-run against a tree nobody is editing." >&2
        exit 1
    fi
    if [[ "$now_fpr" != "$REAL_CONFIG_FPR" ]]; then
        echo "" >&2
        echo "FATAL: the REAL user config ($REAL_AE_CONFIG) CHANGED during this test run." >&2
        echo "A test escaped isolation. Investigate before trusting any results." >&2
        exit 97
    fi
}
trap cleanup EXIT
# A suite that dies under `set -e` says NOTHING — no failure line, no summary, just a
# truncated log and a non-zero status, which is indistinguishable from "the box killed
# it". Name the abort instead: the ERR trap fires exactly where errexit would, so a bare
# statement that returned non-zero (a timed-out launch, a grep that matched nothing, a
# missing meta) is reported with its line and its text rather than guessed at afterwards.
_abort_ec=0
trap '_abort_ec=$?; echo "" >&2; echo "ABORTED at tests/integration:${LINENO} (status ${_abort_ec}) — the suite died under set -e, it did not fail an assertion." >&2; echo "  command: ${BASH_COMMAND}" >&2' ERR

tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }

# Portability for the harness itself (ae's own code uses its _ae_* shims).
# BSD/macOS has no tac; tail -r is the equivalent.
command -v tac >/dev/null 2>&1 || tac() { tail -r "$@"; }
# `sed -i EXPR FILE` is GNU-only — BSD reads EXPR as the backup suffix.
# Usage: _sed_i [-e EXPR]... FILE
_sed_i() {
    local file="${!#}" tmp
    local -a args=("${@:1:$#-1}")
    tmp="${file}.sedtmp.$$"
    sed "${args[@]}" "$file" >"$tmp" && mv "$tmp" "$file"
}
# `touch -d <human date>` is GNU-only; `touch -t [[CC]YY]MMDDhhmm[.SS]` is not.
_touch_epoch() {
    local epoch="$1" stamp
    shift
    stamp="$(date -d "@$epoch" +%Y%m%d%H%M.%S 2>/dev/null || date -r "$epoch" +%Y%m%d%H%M.%S)"
    touch -t "$stamp" "$@"
}
_touch_ago() {
    local secs="$1"
    shift
    _touch_epoch "$(($(date +%s) - secs))" "$@"
}
# `timeout` is coreutils — absent on stock macOS. Same contract: 124 on expiry.
_timeout() {
    local secs="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$secs" "$@"
        return $?
    fi
    if command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$secs" "$@"
        return $?
    fi
    "$@" &
    local pid=$! i=0
    while ((i < secs * 10)); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        return 124
    fi
    wait "$pid"
}

# Dummy agent config (bash as agent — no real AI tool needed)
cat > "$HOME/.ae/config" <<'EOF'
[agents]
dummy = "bash"
dummy2 = "bash"

[workspace]
main = dummy
layout = vertical
EOF

assert_eq() {
    local label="$1" expected="$2" actual="$3"
    if [[ "$expected" == "$actual" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected: \"$expected\"\n  actual:   \"$actual\"")
    fi
}

assert_contains() {
    local label="$1" needle="$2" haystack="$3"
    if [[ "$haystack" == *"$needle"* ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected to contain: \"$needle\"\n  actual: \"$haystack\"")
    fi
}

assert_not_exists() {
    local label="$1" path="$2"
    if [[ ! -e "$path" ]]; then
        PASS=$((PASS + 1))
    else
        FAIL=$((FAIL + 1))
        ERRORS+=("FAIL: $label\n  expected not to exist: $path")
    fi
}

setup_repo() {
    local dir="$TMPDIR/repo-$$-$RANDOM"
    mkdir -p "$dir"
    git -C "$dir" init -q
    git -C "$dir" config user.email "test@test"
    git -C "$dir" config user.name "test"
    git -C "$dir" commit -q --allow-empty -m "init"
    echo "$dir"
}

wait_for_session() {
    local name="$1" max="${2:-5}"
    local i=0
    while ! tmux has-session -t "$name" 2>/dev/null; do
        sleep 0.5
        i=$((i + 1))
        if (( i >= max * 2 )); then
            echo "Timeout waiting for session $name" >&2
            return 1
        fi
    done
    # Also wait for META: the write lands after tmux creation, and under load the gap
    # exceeds every fixed post-wait sleep in this suite — dozens of tests then race a
    # missing meta (the suite's documented flake class, now closed at the one helper
    # every launch goes through). Callers that never read meta lose ~nothing.
    i=0
    while [[ ! -f "$HOME/.ae/sessions/$name/meta" ]]; do
        if (( i >= 30 )); then break; fi   # metaless launches exist (failed launches under test)
        sleep 0.4
        i=$((i + 1))
    done
    return 0
}

# ── Test 1: Lifecycle — create, list, end ────────────────────────

REPO="$(setup_repo)"
(cd "$REPO" && "$AE" --local test-life &) 2>/dev/null
wait_for_session "test-life"
sleep 1  # let session setup complete (meta, manifest)

# Session should be running
assert_eq "lifecycle: tmux session exists" "0" "$(tmux has-session -t test-life 2>/dev/null; echo $?)"

# ae list should show it
list_output="$("$AE" list 2>/dev/null)"
assert_contains "lifecycle: list shows running" "test-life" "$list_output"
assert_contains "lifecycle: list shows running status" "running" "$list_output"

# Meta should exist
assert_eq "lifecycle: meta exists" "1" "$([[ -f "$HOME/.ae/sessions/test-life/meta" ]] && echo 1 || echo 0)"

# Every generated helper must be RUNNABLE by its own shebang. `#!/usr/bin/env bash`
# picks /bin/bash 3.2 under a macOS login shell, and 3.2 cannot parse the bash-4
# bodies declare -f emits — the helper then dies with a bare "syntax error near
# unexpected token `;;'". Assert the interpreter exists, is bash >= 4, and that
# each helper actually parses under it.
_sb_bad=""
for _sb in "$HOME/.ae/sessions/test-life"/*; do
    [[ -f "$_sb" && -x "$_sb" ]] || continue
    IFS= read -r _sb_line <"$_sb" || continue
    [[ "$_sb_line" == '#!'* ]] || continue
    _sb_interp="${_sb_line#\#!}"
    _sb_interp="${_sb_interp%% *}"
    [[ -x "$_sb_interp" ]] || { _sb_bad+="$(basename "$_sb"):no-interp "; continue; }
    # shellcheck disable=SC2016 # single quotes are the point: the expression is
    # evaluated by the HELPER'S interpreter, not by this shell.
    "$_sb_interp" -c 'exit $((BASH_VERSINFO[0] < 4))' 2>/dev/null ||
        { _sb_bad+="$(basename "$_sb"):bash<4 "; continue; }
    "$_sb_interp" -n "$_sb" 2>/dev/null || _sb_bad+="$(basename "$_sb"):parse "
done
assert_eq "helpers: every shebang names a bash >= 4 that can parse the helper" "" "$_sb_bad"

# ── hostile PATH: ae must survive its own re-exec marker ──────────────
# On a macOS login shell path_helper puts /bin first, so ae's own
# `#!/usr/bin/env bash` resolves to 3.2 and ae re-execs itself under a modern
# bash. Anything ae then spawns that re-invokes ae through that same shebang
# INHERITS the marker. While the marker was a boolean, the child saw it, skipped
# the re-exec that would have saved it, and refused — and the steward autostart
# child discards stderr, so it died in silence and the steward never came up.
# The absolute-path ladder is what makes this recoverable: brew's bash is found
# even though it is not on PATH here.
_hostile_path="/usr/bin:/bin:/usr/sbin:/sbin"
assert_eq "hostile PATH: ae runs with no marker" "0" \
    "$(PATH="$_hostile_path" "$AE" --version >/dev/null 2>&1; echo $?)"
assert_eq "hostile PATH: ae runs when a STALE re-exec marker is inherited" "0" \
    "$(PATH="$_hostile_path" AE_BASH_REEXEC=1 "$AE" --version >/dev/null 2>&1; echo $?)"
# Loop safety survives the recovery: a runaway count still refuses, loudly.
assert_eq "hostile PATH: runaway re-exec count still refuses" "1" \
    "$(PATH="$_hostile_path" AE_BASH_REEXEC=9 "$AE" --version >/dev/null 2>&1; echo $?)"
assert_contains "hostile PATH: the refusal names the fix" "brew install bash" \
    "$(PATH="$_hostile_path" AE_BASH_REEXEC=9 "$AE" --version 2>&1 || true)"
# Non-leakage into children is asserted structurally in tests/unit (`unset
# AE_BASH_REEXEC`); its BEHAVIOURAL proof is the steward autostart block below,
# which spawns exactly such a child — run this suite under a hostile PATH and
# that block exercises the real path end to end.

# End should clean up
"$AE" end -f test-life 2>/dev/null || true
sleep 0.5
assert_eq "lifecycle: tmux session gone after end" "1" "$(tmux has-session -t test-life 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "lifecycle: session dir cleaned" "$HOME/.ae/sessions/test-life"

# ── Test 2: Resume detection ─────────────────────────────────────────

REPO2="$(setup_repo)"
(cd "$REPO2" && "$AE" --local test-resume &) 2>/dev/null
wait_for_session "test-resume"
sleep 1 # session setup writes meta shortly after tmux visibility (~200ms under load)

# Verify meta has session info
assert_eq "resume: meta created" "1" "$([[ -f "$HOME/.ae/sessions/test-resume/meta" ]] && echo 1 || echo 0)"

# Kill tmux session (simulate reboot)
tmux kill-session -t test-resume 2>/dev/null || true
sleep 0.5

# Meta should still exist (stopped session)
assert_eq "resume: meta survives tmux kill" "1" "$([[ -f "$HOME/.ae/sessions/test-resume/meta" ]] && echo 1 || echo 0)"

# ae list --all should show it as stopped (default view is running-only now)
list_output="$("$AE" list --all 2>/dev/null)"
assert_contains "resume: list --all shows stopped" "stopped" "$list_output"

# Re-launch should resume (reuse meta)
(cd "$REPO2" && "$AE" --local test-resume &) 2>/dev/null
wait_for_session "test-resume"
assert_eq "resume: session re-created" "0" "$(tmux has-session -t test-resume 2>/dev/null; echo $?)"

# Clean up
"$AE" end -f test-resume 2>/dev/null || true
sleep 0.5

# ── Test 2b: Rename moves session, window, and meta ──────────────────

REPO2B="$(setup_repo)"
(cd "$REPO2B" && "$AE" --local test-rename-old &) 2>/dev/null
wait_for_session "test-rename-old"
sleep 1 # session setup (window rename, meta write) completes shortly after visibility

# Window 0 is named after the session at creation.
assert_eq "rename: window 0 starts named after the session" "test-rename-old" \
    "$(tmux list-windows -t test-rename-old -F '#{window_index}:#{window_name}' 2>/dev/null | sed -n 's/^0://p')"

"$AE" rename test-rename-old test-rename-new 2>/dev/null
sleep 0.5

assert_eq "rename: tmux session renamed" "0" "$(tmux has-session -t test-rename-new 2>/dev/null; echo $?)"
assert_eq "rename: old tmux session gone" "1" "$(tmux has-session -t test-rename-old 2>/dev/null && echo 0 || echo 1)"
# The regression: the main window must follow the rename, not keep the old name.
assert_eq "rename: window 0 follows the session rename" "test-rename-new" \
    "$(tmux list-windows -t test-rename-new -F '#{window_index}:#{window_name}' 2>/dev/null | sed -n 's/^0://p')"
assert_eq "rename: meta session= updated" "1" \
    "$(grep -qx 'session=test-rename-new' "$HOME/.ae/sessions/test-rename-new/meta" && echo 1 || echo 0)"
assert_not_exists "rename: old session dir moved" "$HOME/.ae/sessions/test-rename-old"

"$AE" end -f test-rename-new 2>/dev/null || true
sleep 0.5

# ── Test 3: Health check in list ─────────────────────────────────────

REPO3="$(setup_repo)"
(cd "$REPO3" && "$AE" --local test-health &) 2>/dev/null
wait_for_session "test-health"
sleep 1  # let agent (bash) start

# Agent is bash — health check sees shell = dead agent (correct behavior)
# Verify idle agent shows ! marker in agent detail row
list_output="$("$AE" list 2>/dev/null)"
assert_contains "health: idle agent shows ! marker" "!" "$list_output"
assert_contains "health: agent row shows name" "dummy" "$list_output"

# Clean up
"$AE" end -f test-health 2>/dev/null || true
sleep 0.5

# ── Test 3a: --active (recently-active filter) ───────────────────────

REPO3A="$(setup_repo)"
(cd "$REPO3A" && "$AE" --local test-active &) 2>/dev/null
wait_for_session "test-active"
sleep 1

# A freshly-created session is recently active → --active includes it.
assert_contains "active: fresh session shows in --active" "test-active" \
    "$("$AE" list --active 2>/dev/null)"
assert_contains "active: --busy alias works" "test-active" \
    "$("$AE" list --busy 2>/dev/null)"

# Backdate its activity well past the window → --active drops it, but the
# unfiltered list still shows it (it's still running).
ACTIVE_EVENTS="$HOME/.ae/sessions/test-active/events.jsonl"
touch "$ACTIVE_EVENTS" 2>/dev/null || true
_touch_ago 3600 "$ACTIVE_EVENTS" "$HOME/.ae/sessions/test-active/workspace.md" \
    "$HOME/.ae/sessions/test-active/meta" 2>/dev/null || true
assert_eq "active: stale session dropped from --active" "0" \
    "$("$AE" list --active 2>/dev/null | grep -c 'test-active')"
assert_contains "active: stale session still shown in plain list" "test-active" \
    "$("$AE" list 2>/dev/null)"

# Clean up
"$AE" end -f test-active 2>/dev/null || true
sleep 0.5

# ── Test 3b: state column + session attn marker in list ──────────────

REPO3B="$(setup_repo)"
(cd "$REPO3B" && "$AE" --local test-state &) 2>/dev/null
wait_for_session "test-state"
sleep 1

STATE_EVENTS="$HOME/.ae/sessions/test-state/events.jsonl"
# Discover the real main agent name (alias:name) from meta.
main_agent="$(sed -n 's/^agent.main=//p' "$HOME/.ae/sessions/test-state/meta" | cut -d: -f1,2)"

# Real agent declares working; a retired/stray actor declares waiting-user.
printf '{"ts":"2026-05-29T10:00:00Z","actor":"%s","action":"state","ref":"working","summary":"on it"}\n' "$main_agent" >>"$STATE_EVENTS"
printf '%s\n' '{"ts":"2026-05-29T10:01:00Z","actor":"dummy:ghost","action":"state","ref":"waiting-user","summary":"stale"}' >>"$STATE_EVENTS"

list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: list shows agent working state" "working" "$list_output"
# Regression (codex IMPORTANT): a stray/retired actor that is not a current
# agent must NOT raise the session attn marker.
assert_eq "state: stray actor does not raise attn marker" "0" \
    "$(echo "$list_output" | grep -c 'attn:')"

# When the real current agent goes waiting-user, attn must appear.
printf '{"ts":"2026-05-29T10:02:00Z","actor":"%s","action":"state","ref":"waiting-user","summary":"need you"}\n' "$main_agent" >>"$STATE_EVENTS"
list_output="$("$AE" list 2>/dev/null)"
assert_contains "state: current agent waiting-user raises attn marker" "attn:waiting-user" "$list_output"

# --needs-me surfaces the waiting-user session.
assert_contains "list: --needs-me shows the waiting-user session" "test-state" \
    "$("$AE" list --needs-me 2>/dev/null)"

# --json digest: versioned wrapper + the running session with its agents.
json_out="$("$AE" list --json 2>/dev/null)"
assert_contains "json: versioned wrapper" '"schema_version":1' "$json_out"
assert_contains "json: includes the running session" '"name":"test-state"' "$json_out"
assert_contains "json: marks it running" '"status":"running"' "$json_out"
assert_contains "json: has an agents array" '"agents":[' "$json_out"
# Strict parse when a JSON parser is available (no hard dependency).
if command -v python3 >/dev/null 2>&1; then
    assert_eq "json: output is valid JSON" "ok" \
        "$(printf '%s' "$json_out" | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
fi
# --needs-me --json: the waiting-user session appears with its attention reason.
needs_json="$("$AE" list --needs-me --json 2>/dev/null)"
assert_contains "json: --needs-me digest flags attention" '"attention":"waiting-user"' "$needs_json"
assert_contains "json: --needs-me digest marks needs_attention" '"needs_attention":true' "$needs_json"

# --needs-me implies running-only (codex IMPORTANT): combining with --all must
# not leak stopped rows. (test-resume from Test 2 is a stopped session here.)
allneeds_output="$("$AE" list --all --needs-me 2>/dev/null)"
assert_contains "list: --all --needs-me still shows the needing session" "test-state" "$allneeds_output"
assert_eq "list: --all --needs-me does not leak stopped rows" "0" \
    "$(echo "$allneeds_output" | grep -c 'stopped')"

# Once it goes back to working, --needs-me no longer lists it.
printf '{"ts":"2026-05-29T10:03:00Z","actor":"%s","action":"state","ref":"working","summary":"resumed"}\n' "$main_agent" >>"$STATE_EVENTS"
needs_output="$("$AE" list --needs-me 2>/dev/null)"
assert_eq "list: --needs-me drops the session once it is working again" "0" \
    "$(echo "$needs_output" | grep -c 'test-state')"

# Default view shows the running session.
assert_contains "list: default shows the running session" "test-state" \
    "$("$AE" list 2>/dev/null)"

# say helper: emits a chat event, preserving an embedded newline as escaped \n
# on a single JSON line (the events.jsonl one-object-per-line invariant).
state_main_pane="$(tmux list-panes -t test-state -F '#{pane_id} #{@ae_agent}' | awk -v a="$main_agent" '$2==a {print $1; exit}')"
TMUX_PANE="$state_main_pane" "$HOME/.ae/sessions/test-state/say" "$(printf 'hello from say\nsecond line')" >/dev/null 2>&1
# LAST-MATCH LOOKUPS READ THE FILE AND KEEP THE LAST LINE — never `tac | grep -m1`.
# `grep -m1` exits on its first match and closes the pipe under `tac`; if `tac` is still
# writing it takes SIGPIPE, `pipefail` makes the pipeline 141, and `set -e` kills the whole
# suite with no failing assertion and no summary. It fires only when the log is large
# enough not to fit the pipe buffer, which is why it read as a random flake (#37).
# `grep ... | tail -1` has the same semantics, never exits early, and drops raw `tac`
# (GNU-only) as a bonus.
say_line="$(grep '"action":"chat"' "$STATE_EVENTS" 2>/dev/null | tail -1)"
assert_contains "say: emits a chat event" '"action":"chat"' "$say_line"
assert_contains "say: chat event carries the message" 'hello from say' "$say_line"
assert_contains "say: embedded newline kept as escaped \\n on one line" 'say\nsecond' "$say_line"
assert_eq "say: chat event is exactly one JSON line" "1" \
    "$(tac "$STATE_EVENTS" 2>/dev/null | grep -c '"action":"chat"')"

# Stop it (kill tmux session, keep meta) → default omits it, --all/--stopped include it.
tmux kill-session -t test-state 2>/dev/null || true
sleep 0.5
assert_eq "list: default hides the stopped session" "0" \
    "$("$AE" list 2>/dev/null | grep -c 'test-state')"
assert_contains "list: --all includes the stopped session" "test-state" \
    "$("$AE" list --all 2>/dev/null)"
assert_contains "list: --stopped includes the stopped session" "test-state" \
    "$("$AE" list --stopped 2>/dev/null)"
# --stopped --needs-me is running-only by implication → the now-stopped session
# is not shown (stopped sessions can't need you).
assert_eq "list: --stopped --needs-me does not show the stopped session" "0" \
    "$("$AE" list --stopped --needs-me 2>/dev/null | grep -c 'test-state')"

# --json over stopped/all sessions must stay valid JSON (regression for the
# set -u undeclared-map crash codex caught). A stopped session has agent rows.
assert_contains "json: --stopped digest includes the stopped session" '"name":"test-state"' \
    "$("$AE" list --stopped --json 2>/dev/null)"
assert_contains "json: stopped agents render alive false" '"alive":false' \
    "$("$AE" list --stopped --json 2>/dev/null)"
if command -v python3 >/dev/null 2>&1; then
    assert_eq "json: --stopped output is valid JSON" "ok" \
        "$("$AE" list --stopped --json 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
    assert_eq "json: --all output is valid JSON" "ok" \
        "$("$AE" list --all --json 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin); print("ok")' 2>/dev/null || echo "invalid")"
fi

# ── P1: `ae end` resolves the target BEFORE the destructive prompt ───
# Bug (Clemens 2026-07-21): `ae end <bogus>` PROMPTED the destructive confirm, then
# said "not found" after y. A nonexistent target must error with NO prompt. This is a
# CALLER PROBE (round-6 lesson: source text cannot prove a runtime order). Feed 'y' so
# that a lingering prompt WOULD consume it and proceed — a correct impl errors first.
# Capture output+rc WITHOUT aborting: these commands are EXPECTED to exit nonzero, and
# `x="$(cmd)"` under the suite's `set -euo pipefail` would take that nonzero and abort
# the whole run (AGENTS.md set-e hazard). The if/else keeps errexit from firing.
if end_bogus_out="$(printf 'y\n' | "$AE" end this-name-does-not-exist-xyz 2>&1)"; then
    end_bogus_rc=0
else
    end_bogus_rc=$?
fi
assert_eq "end bogus: exits nonzero" "1" "$([[ $end_bogus_rc -ne 0 ]] && echo 1 || echo 0)"
assert_contains "end bogus: reports not found" "not found" "$end_bogus_out"
assert_eq "end bogus: does NOT prompt before resolving" "1" \
    "$([[ "$end_bogus_out" != *"Continue?"* && "$end_bogus_out" != *"Commits + pushes"* \
        && "$end_bogus_out" != *"Removes ae state"* ]] && echo 1 || echo 0)"
# Slash-bearing name → same not-found path, no prompt (traversal guard preserved).
if end_slash_out="$(printf 'y\n' | "$AE" end ../evil 2>&1)"; then
    end_slash_rc=0
else
    end_slash_rc=$?
fi
assert_eq "end slashed name: nonzero and no prompt" "1" \
    "$([[ $end_slash_rc -ne 0 && "$end_slash_out" != *"Continue?"* ]] && echo 1 || echo 0)"

# ── P1 review B2: dot-component targets are rejected before any prompt ─
# `.` and `..` have no '/', so the slash guard alone accepted them and `ae end ..`
# prompted on `sessions/../` (a real dir → classified 'stopped'). Reject dot
# components at the same guard.
for dotname in . ..; do
    if end_dot_out="$(printf 'y\n' | "$AE" end "$dotname" 2>&1)"; then dot_rc=0; else dot_rc=$?; fi
    assert_eq "end '$dotname': nonzero and NO prompt (dot-component rejected)" "1" \
        "$([[ $dot_rc -ne 0 && "$end_dot_out" != *"Continue?"* && "$end_dot_out" != *"Removes ae state"* ]] && echo 1 || echo 0)"
done

# ── P1 review B1: `ae end <prefix>` must not touch a live neighbour ───
# tmux -t PREFIX-MATCHES: with `lifeproj` live, `ae end lifepro` used to classify live
# (has-session -t lifepro matched lifeproj), prompt, and could kill lifeproj. Resolve
# the EXACT session id; a prefix that is not an exact session/dir is not-found.
REPO_B1="$(setup_repo)"
(cd "$REPO_B1" && "$AE" --local lifeproj &) 2>/dev/null
wait_for_session "lifeproj"
if end_pfx_out="$(printf 'y\n' | "$AE" end lifepro 2>&1)"; then end_pfx_rc=0; else end_pfx_rc=$?; fi
assert_eq "end prefix: 'lifepro' errors, no prompt (exact match required)" "1" \
    "$([[ $end_pfx_rc -ne 0 && "$end_pfx_out" != *"Continue?"* ]] && echo 1 || echo 0)"
assert_eq "end prefix: the live neighbour 'lifeproj' is STILL ALIVE (not prefix-killed)" "1" \
    "$(tmux has-session -t '=lifeproj' 2>/dev/null && echo 1 || echo 0)"
"$AE" end -f lifeproj 2>/dev/null || true
# Poll until fully torn down — a leaked lifeproj dir surfaces as an orphan in the
# doctor-orphan test far below (teardown can lag under full-suite contention).
for _i in $(seq 1 20); do tmux has-session -t "=lifeproj" 2>/dev/null || break; sleep 0.3; done
"$AE" end -f lifeproj 2>/dev/null || true

# ── P1: truthful prompt + stopped-dir end-by-name regression ─────────
# test-state is a LOCAL, now-STOPPED session. Ending it removes leftover state with NO
# commit/push (local never pushes) — the prompt must not claim otherwise, and the
# stopped-dir path must still end it (the elif we hoist resolution past).
if end_stopped_out="$(printf 'y\n' | "$AE" end test-state 2>&1)"; then
    end_stopped_rc=0
else
    end_stopped_rc=$?
fi
assert_eq "end stopped local: succeeds (stopped-dir path preserved through the hoist)" "1" \
    "$([[ $end_stopped_rc -eq 0 ]] && echo 1 || echo 0)"
assert_eq "end stopped local: prompt does NOT claim a push (local never pushes)" "1" \
    "$([[ "$end_stopped_out" != *"Commits + pushes"* ]] && echo 1 || echo 0)"
assert_not_exists "end stopped local: session dir removed" "$HOME/.ae/sessions/test-state"

# Clean up (already ended above; harmless if so)
"$AE" end -f test-state 2>/dev/null || true
sleep 0.5

# ── P1 review B1: end a session on a DIFFERENT tmux server (named-server) ──
# `_ae_session_id` lists only the AMBIENT server. A session live on a NAMED server, ended
# from a shell whose ambient server is different, was misclassified as stopped: rc0, its
# state deleted, the agent left ALIVE (orphaned). The end path must resolve the target's
# OWN server from meta and target its exact id there. Server B here is the harness ambient
# ("$AE_TMUX_SERVER"); server A is a distinct one the session actually runs on.
SRV_A="ae-nsrv-$$"
REPO_NS="$(setup_repo)"
(cd "$REPO_NS" && AE_TMUX_SERVER="$SRV_A" "$AE" --local nsrv &) 2>/dev/null
for _i in $(seq 1 25); do command tmux -L "$SRV_A" has-session -t nsrv 2>/dev/null && break; sleep 0.4; done
# Wait for the META too, not just the tmux session: the session comes up on server A
# before its dir/meta (with tmux_server=A) is written, and `ae end` resolves the target
# server FROM meta — ending in that window would (correctly) fail to find it. This is a
# test-setup race, not the behavior under test.
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/nsrv/meta" ]] && break; sleep 0.3; done
assert_eq "end named-server: session came up on server A with meta" "1" \
    "$([[ -f "$HOME/.ae/sessions/nsrv/meta" ]] && command tmux -L "$SRV_A" has-session -t "=nsrv" 2>/dev/null && echo 1 || echo 0)"
# End from the harness ambient server (B, != A). Must resolve A from meta and kill there.
# Poll: retry the end until the agent is actually gone (teardown can lag under load).
for _i in $(seq 1 20); do
    command tmux -L "$SRV_A" has-session -t "=nsrv" 2>/dev/null || break
    "$AE" end -f nsrv 2>/dev/null || true
    sleep 0.4
done
assert_eq "end named-server: the agent is KILLED on its own server (not orphaned)" "1" \
    "$(command tmux -L "$SRV_A" has-session -t "=nsrv" 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "end named-server: state removed" "$HOME/.ae/sessions/nsrv"
command tmux -L "$SRV_A" kill-server 2>/dev/null || true

# ── 2nd-delta B1 MIRROR: DEFAULT-server target, ended from a NAMED-ambient shell ──
# The symmetric case: a session whose meta records an EMPTY tmux_server (= the default
# socket) ended from a shell with a NAMED ambient AE_TMUX_SERVER. Empty must resolve the
# pinned default socket, never the ambient shim and never inherited $TMUX.
# ISOLATION (3rd review B4): the REAL default server must never be touched — probing it
# live is how the fleet died once. AE_TMUX_DEFAULT_SOCKET points "default" at a mock
# socket; the session is launched on that mock via AE_TMUX_SERVER, then its meta's
# tmux_server line is BLANKED (fixture surgery: this is exactly what a default-server
# session's meta looks like), so the end path must resolve empty → the mock default.
DEFMOCK="ae-defmock-$$"
REPO_DEF="$(setup_repo)"
(cd "$REPO_DEF" && AE_TMUX_SERVER="$DEFMOCK" "$AE" --local dsrv &) 2>/dev/null
for _i in $(seq 1 25); do command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && break; sleep 0.4; done
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/dsrv/meta" ]] && break; sleep 0.3; done
_sed_i -e 's/^tmux_server=.*/tmux_server=/' -e '/^tmux_server_kind=/d' "$HOME/.ae/sessions/dsrv/meta"
assert_eq "end default-mock: session live on the mock-default with EMPTY meta server" "1" \
    "$([[ "$(sed -n 's/^tmux_server=//p' "$HOME/.ae/sessions/dsrv/meta")" == "" ]] \
        && command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && echo 1 || echo 0)"
# Option-B invariant: a BLANK record never queries any server — not even the pinned
# default. Plain end fails closed; the explicit AE_END_SERVER override (typed by shape,
# a name here) is the resolution, and it must ignore ambient + inherited $TMUX.
if TMUX="/tmp/tmux-$(id -u)/ae-elsewhere-$$,999,0" AE_TMUX_SERVER="ae-mirror-$$" \
    AE_TMUX_DEFAULT_SOCKET="$DEFMOCK" "$AE" end -f dsrv >/dev/null 2>&1; then dm_rc=0; else dm_rc=$?; fi
assert_eq "end default-mock (invariant): blank record fails closed — default is NOT queried" "1" \
    "$([[ $dm_rc -ne 0 ]] && command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && echo 1 || echo 0)"
for _i in $(seq 1 20); do
    command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null || break
    TMUX="/tmp/tmux-$(id -u)/ae-elsewhere-$$,999,0" AE_TMUX_SERVER="ae-mirror-$$" \
        AE_END_SERVER="$DEFMOCK" "$AE" end -f dsrv 2>/dev/null || true
    sleep 0.4
done
assert_eq "end default-mock (invariant): AE_END_SERVER override ends it on the RIGHT server" "1" \
    "$(command tmux -L "$DEFMOCK" has-session -t "=dsrv" 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "end default-mock (invariant): state removed" "$HOME/.ae/sessions/dsrv"
command tmux -L "$DEFMOCK" kill-server 2>/dev/null || true

# ── 4th review B1: launch INSIDE a foreign tmux pane records the REAL server ──
# AE_TMUX_SERVER unset + $TMUX inherited → the session lands on the pane's server; meta
# must record THAT server, not "" (which every exact-server consumer reads as default).
FOREIGN="ae-foreign-$$"
REPO_FOR="$(setup_repo)"
command tmux -L "$FOREIGN" new-session -d -s host 2>/dev/null
command tmux -L "$FOREIGN" send-keys -t host \
    "cd '$REPO_FOR' && env -u AE_TMUX_SERVER HOME='$HOME' AE_HOME='$HOME/.ae' '$AE' --local insidesess >/dev/null 2>&1" Enter
for _i in $(seq 1 30); do command tmux -L "$FOREIGN" has-session -t "=insidesess" 2>/dev/null && break; sleep 0.4; done
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/insidesess/meta" ]] && break; sleep 0.3; done
assert_eq "launch-inside (4th B1): session landed on the FOREIGN server" "1" \
    "$(command tmux -L "$FOREIGN" has-session -t "=insidesess" 2>/dev/null && echo 1 || echo 0)"
# Resolved path: macOS /tmp is a symlink to /private/tmp, and ae records the
# socket path exactly as tmux reports it in $TMUX (already resolved).
assert_eq "launch-inside (4th B1): meta records the FOREIGN socket PATH + kind=socket" \
    "$(cd "/tmp/tmux-$(id -u)" && pwd -P)/$FOREIGN|socket" \
    "$(sed -n 's/^tmux_server=//p' "$HOME/.ae/sessions/insidesess/meta" 2>/dev/null)|$(sed -n 's/^tmux_server_kind=//p' "$HOME/.ae/sessions/insidesess/meta" 2>/dev/null)"
# ...and an end from a PLAIN shell finds it there (the full round trip the lie broke).
for _i in $(seq 1 15); do
    command tmux -L "$FOREIGN" has-session -t "=insidesess" 2>/dev/null || break
    env -u AE_TMUX_SERVER "$AE" end -f insidesess >/dev/null 2>&1 || true
    sleep 0.4
done
assert_eq "launch-inside (4th B1): plain-shell end kills it on the foreign server" "1" \
    "$(command tmux -L "$FOREIGN" has-session -t "=insidesess" 2>/dev/null && echo 0 || echo 1)"
assert_not_exists "launch-inside (4th B1): state removed" "$HOME/.ae/sessions/insidesess"
command tmux -L "$FOREIGN" kill-server 2>/dev/null || true

# ── 5th review B1: -S socket vs same-basename -L server collision round-trip ──
# A `-S /path/collide.sock` server and a `-L collide.sock` server are DIFFERENT servers
# sharing a basename. The recorded identity must be the PATH: end the -S target, decoy
# on -L untouched — the old basename record killed the wrong-server lookup.
SC_NAME="aesc-$$-$RANDOM.sock"
SC_DIR="$SOCK_DIR/sprobe"; mkdir -p "$SC_DIR"; SC_PATH="$SC_DIR/$SC_NAME"
command tmux -S "$SC_PATH" new-session -d -s schost 2>/dev/null
command tmux -L "$SC_NAME" new-session -d -s decoyhost 2>/dev/null
REPO_SC="$(setup_repo)"
command tmux -S "$SC_PATH" send-keys -t schost \
    "cd '$REPO_SC' && env -u AE_TMUX_SERVER HOME='$HOME' AE_HOME='$HOME/.ae' '$AE' --local scoll >/dev/null 2>&1" Enter
for _i in $(seq 1 30); do command tmux -S "$SC_PATH" has-session -t "=scoll" 2>/dev/null && break; sleep 0.4; done
for _i in $(seq 1 25); do [[ -f "$HOME/.ae/sessions/scoll/meta" ]] && break; sleep 0.3; done
assert_eq "S-collision (5th B1): meta records the -S socket PATH + kind=socket" "$SC_PATH|socket" \
    "$(sed -n 's/^tmux_server=//p' "$HOME/.ae/sessions/scoll/meta" 2>/dev/null)|$(sed -n 's/^tmux_server_kind=//p' "$HOME/.ae/sessions/scoll/meta" 2>/dev/null)"
# Retry budget cut 15 -> 3 on evidence (issue #4). This loop is the FOSSIL the
# issue cites: someone met the lifecycle race here and bounded it by calling
# `end` again until the tmux session went away. That mitigation covered tmux
# TEARDOWN but never asset GENERATION, which is why the session assertion below
# passed while the DIRECTORY assertion still failed intermittently.
#
# With the lock now held through session creation, this was measured at exactly
# ONE attempt on a loaded box (12 live sessions). The remaining budget is not
# for the race — that is fixed, and separately pinned by the race (#4) block
# below. What it still covers: `end` legitimately returning non-zero when it
# cannot take the lifecycle lock within flock's 15s, and tmux teardown latency
# on the foreign -S server. Three attempts is headroom for those; fifteen was
# headroom for a bug.
for _i in $(seq 1 3); do
    command tmux -S "$SC_PATH" has-session -t "=scoll" 2>/dev/null || break
    env -u AE_TMUX_SERVER "$AE" end -f scoll >/dev/null 2>&1 || true
    sleep 0.4
done
assert_eq "S-collision (5th B1): target killed on ITS -S server" "1" \
    "$(command tmux -S "$SC_PATH" has-session -t "=scoll" 2>/dev/null && echo 0 || echo 1)"
assert_eq "S-collision (5th B1): the same-basename -L decoy is UNTOUCHED" "1" \
    "$(command tmux -L "$SC_NAME" has-session -t "=decoyhost" 2>/dev/null && echo 1 || echo 0)"
assert_not_exists "S-collision (5th B1): state removed" "$HOME/.ae/sessions/scoll"
command tmux -S "$SC_PATH" kill-server 2>/dev/null || true
command tmux -L "$SC_NAME" kill-server 2>/dev/null || true

# ── issue #4 BLOCKER: prompt-delivery children must not inherit fd 8 ──
# send_agent_cmd's codex-resume branch spawns a subshell with `&` (the opencode branch
# did too until #53 moved its context to OPENCODE_CONFIG and deleted the paste)
# that sleeps 3s before pasting. A child INHERITS open descriptors, so while the
# lifecycle lock is held across agent launch those children kept it alive: the
# parent's `exec 8>&-` closes only its own copy, and a competing `ae end` blocked
# on a launch that had already finished.
#
# This is an EXECUTION probe, deliberately. The ordering assertions in
# tests/unit pin WHERE the release sits among the top-level call sites, and they
# pass the violating shape without complaint — position cannot see descriptor
# inheritance. Measured before the fix: competitor waited 3016ms (codex) and
# 3006ms (opencode, since retired); after: 4ms both.
if command -v flock >/dev/null 2>&1; then
    # codex only since #53: opencode's context rides OPENCODE_CONFIG as system-level
    # instructions, so it has no launch-time paste and therefore no backgrounded
    # delivery child to inherit fd 8. The loop is gone with it — one tool needs no
    # iteration, and a single-item loop is a lie about what varies. (Removing opencode
    # did not weaken this probe quietly: its extractor returned an EMPTY fragment and
    # took the whole suite down, which is the extractor working as designed.)
    _fdb=codex
    _FD_ROOT="$(mktemp -d "$TMPDIR/aefd.XXXXXX")"
    _FD_LOCK="$_FD_ROOT/lock"
    : >"$_FD_LOCK"
    # Scope to send_agent_cmd FIRST: ae mentions codex resume in more than one
    # place and the others have no subshell at all. Extracting one of those made an
    # earlier version of this probe pass against unfixed ae.
    #
    # ANCHORED ON THE DELIVERY CALL, not on a `case` label. The first version
    # matched the arm `        codex*resume*)`; when that classification moved into
    # an `if` — the built command can no longer be trusted to classify itself — the
    # extractor silently produced an EMPTY fragment, so the probe stopped testing
    # anything and took the suite down with it. What this probe is about is the
    # backgrounded subshell around _deliver_launch_prompt, so that is what it finds:
    # the enclosing `if [[ -n "$prompt" ]]` block, whatever encloses THAT.
    awk -v b="$_fdb" '
        /^send_agent_cmd\(\) \{/ { infn = 1 }
        infn && /if \[\[ -n "\$prompt" \]\]; then/ { buf = $0 "\n"; cap = 1; want = 0; next }
        infn && cap { buf = buf $0 "\n" }
        infn && cap && $0 ~ ("_deliver_launch_prompt \"\\$pane\" " b) { want = 1 }
        infn && cap && /^ *fi$/ { if (want) { printf "%s", buf; exit } cap = 0 }
    ' "$AE" >"$_FD_ROOT/branch.sh"
    assert_eq "fd8 probe ($_fdb): extracted a backgrounded subshell to test" "1" \
        "$(command grep -qF ') &' "$_FD_ROOT/branch.sh" && echo 1 || echo 0)"
    # The fragment is already a complete `if … fi`, so it runs as extracted.
    command cp "$_FD_ROOT/branch.sh" "$_FD_ROOT/body.sh"
    # Quoted heredoc: the branch body must NOT be expanded while writing this.
    #
    # THE CHILD MUST STAY ALIVE while containment is measured. Delivery is what
    # keeps it alive in production (a bounded readiness wait, then a paste); here it
    # blocks. Without meta_dir/slot defined and _deliver_launch_prompt stubbed, the
    # fragment aborted on the first unbound expansion under `set -u` — so the lock
    # came free because the child DIED, not because it closed fd 8, and this leg was
    # green against a product with `exec 8>&-` deleted. The control below is the
    # only reason we know it is not green like that again.
    cat >"$_FD_ROOT/run.sh" <<'FDSTUB'
set -uo pipefail
pane_current_command() { printf '%s' "$BRANCHNAME"; }
tmux() { :; }
tmux_paste_submit() { :; }
_deliver_launch_prompt() { sleep 3; }
pane="p"; prompt="x"; meta_dir="$FD_META"; slot="probe"
exec 8>"$LOCKPATH"
flock -n 8 || exit 2
source "$BODYFILE"
exec 8>&-
FDSTUB
    # The FACT is blocked-vs-immediate; the millisecond count was
    # ornamentation. EPOCHREALTIME is Bash 5 only and ae's floor is 4.0,
    # where under set -u reading it aborts unbound — so a short flock
    # timeout carries the whole assertion. The child sleeps 3s, so a
    # half-second budget cleanly separates "already free" from "still held".
    _fd_free() { # <body-file> <lock-file> -> 1 = free within the budget
        : >"$2"
        BRANCHNAME="$_fdb" LOCKPATH="$2" BODYFILE="$1" FD_META="$_FD_ROOT" \
            "${BASH:-bash}" "$_FD_ROOT/run.sh" >/dev/null 2>&1
        if flock -w 0.5 "$2" true 2>/dev/null; then echo 1; else echo 0; fi
    }
    assert_eq "fd8 ($_fdb): lock is free once send_agent_cmd returns (child closed fd 8)" "1" \
        "$(_fd_free "$_FD_ROOT/body.sh" "$_FD_ROOT/lock.real")"
    # MUTATION CONTROL, in the suite rather than in someone's head: strip the close
    # and the same probe must go RED. A guard never observed to fail is not a guard.
    command grep -v '^ *exec 8>&-$' "$_FD_ROOT/body.sh" >"$_FD_ROOT/body.mutant.sh"
    assert_eq "fd8 ($_fdb): the control fragment really lost its close" "1" \
        "$(command cmp -s "$_FD_ROOT/body.sh" "$_FD_ROOT/body.mutant.sh" && echo 0 || echo 1)"
    assert_eq "fd8 ($_fdb) CONTROL: without exec 8>&- the child holds the lock" "0" \
        "$(_fd_free "$_FD_ROOT/body.mutant.sh" "$_FD_ROOT/lock.mutant")"
    rm -rf "$_FD_ROOT"
else
    printf 'NOTE: fd8 inheritance probe SKIPPED — flock not available.\n' >&2
fi

# ── issue #4: `ae end` racing a launch must not leave a recreated session ──
# The lifecycle lock used to be released immediately after the meta mv, while
# ~20 helpers, the loop shim, workspace.md and launch.<slot>.sh were still being
# written. A concurrent `ae end` rm -rf'd the directory mid-generation and the
# next atomic temp+mv RECREATED it, so end returned 0 having left a partial
# session on disk. Proven by timestamp ordering before the fix: end-rm-begin
# landed 1.7s before the last asset write, and the directory came back carrying
# 22 artifacts.
#
# This DRIVES the race rather than waiting for it: launch in the background,
# wait only until meta exists — precisely as far as the old lock protected — and
# end at that instant. With the lock held through session creation, end blocks
# until the session is complete and then removes it.
#
# REPEATED on purpose. A single attempt is FLAKY: the first version of this test
# passed against unfixed ae, and only started failing when an unrelated debug
# line shifted the timing by a few milliseconds. One attempt proves nothing on a
# miss, so the assertion is over ALL attempts — every one of them must leave
# nothing behind, and on unfixed ae it takes only one hit to go red.
RACE_SURVIVORS=""
RACE_META_MISSES=0
RACE_INCONCLUSIVE=""
RACE_END_RC=0
for _rn in 1 2 3; do
    RACE_SESS="racefix-$$-${_rn}"
    RACE_WORK="$TMPDIR/racework-$$-${_rn}"
    mkdir -p "$RACE_WORK"
    (cd "$RACE_WORK" && AE_NO_AUTOSTART=1 "$AE" --local "$RACE_SESS" >/dev/null 2>&1) &
    RACE_LAUNCH_PID=$!
    for _i in $(seq 1 200); do
        [[ -f "$HOME/.ae/sessions/$RACE_SESS/meta" ]] && break
        sleep 0.05
    done
    [[ -f "$HOME/.ae/sessions/$RACE_SESS/meta" ]] || RACE_META_MISSES=$((RACE_META_MISSES + 1))
    # end's rc is LOAD-BEARING and must not be discarded. If post-meta work
    # outruns flock's 15s, end times out and PRESERVES the session by contract —
    # a correct refusal, not a race survivor. Treating those alike would make a
    # slow CI runner (issue #10's ubuntu box) indistinguishable from a
    # regression: the directory is legitimately still there, and a resurrection
    # check would call it a failure.
    # An if-condition, not a bare call: under the suite's set -e a nonzero `end`
    # aborts BEFORE the assignment, so RACE_END_RC is never set and the NOTE,
    # the cleanup and the all-inconclusive assertion below are all unreachable
    # on exactly the path they exist to handle. Same shape as the lexer status
    # capture — errexit is only suspended in a condition.
    if "$AE" end -f "$RACE_SESS" >/dev/null 2>&1; then
        RACE_END_RC=0
    else
        RACE_END_RC=$?
    fi
    wait "$RACE_LAUNCH_PID" 2>/dev/null || true
    # Grace for any generation still in flight to recreate the directory.
    # Before the fix it needed none — the writes were already running.
    sleep 1
    if ((RACE_END_RC != 0)); then
        # end declined (almost certainly the lock timeout). The session SHOULD
        # still exist — that is the state-preserving contract — so this attempt
        # proves nothing either way. Recorded as inconclusive, never counted as
        # a survivor and never silently passed.
        RACE_INCONCLUSIVE+="${_rn}:rc=${RACE_END_RC} "
    elif [[ -d "$HOME/.ae/sessions/$RACE_SESS" ]]; then
        _race_left=""
        for _rf in "$HOME/.ae/sessions/$RACE_SESS"/*; do
            [[ -e "$_rf" ]] || continue
            _race_left+="$(basename "$_rf") "
        done
        RACE_SURVIVORS+="${_rn}:[${_race_left}] "
    fi
    # Thorough teardown: this test deliberately launches real sessions, so an
    # incompletely-reaped one leaves the harness's own temp HOME non-empty and
    # its final rm -rf complains AFTER the summary line — green suite, noisy
    # exit. Kill the tmux session, let it die, then clear any residue.
    "$AE" end -f "$RACE_SESS" >/dev/null 2>&1 || true
    command tmux kill-session -t "=$RACE_SESS" 2>/dev/null || true
    for _k in 1 2 3 4 5; do
        command tmux has-session -t "=$RACE_SESS" 2>/dev/null || break
        sleep 0.2
    done
    rm -rf "$RACE_WORK" "$HOME/.ae/sessions/$RACE_SESS" 2>/dev/null || true
done
# Liveness: if the launch never reached meta, the race was never driven and a
# clean result would mean nothing.
assert_eq "race (#4): every attempt reached the meta write" "0" "$RACE_META_MISSES"
