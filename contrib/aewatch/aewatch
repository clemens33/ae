# ── Secret redaction (shared) ────────────────────────────────────────────
# Security-critical and CENTRAL: no Telegram bot token / bot<TOKEN> URL may reach
# daemon.log OR any log.write EFFECT payload. Every log.write effect (AewatchLogger
# AND recorder.log call sites like discovery/backoff warnings) runs through this.
# A Telegram bot token is <id>:<secret>; the secret run is consumed to the next
# '/' or whitespace, NOT the standard charset, so a non-standard secret (e.g. one
# containing '.') cannot be partially redacted and slip the tail past the detector.
# A residual match triggers a fail-closed whole-line drop. Bias to over-redact.
_TOKEN_RE = re.compile(r"\d{4,}:[^\s/]{15,}")
_BOT_URL_TOKEN_RE = re.compile(r"(bot)\d{4,}:[^\s/]+")
_RESIDUAL_TOKEN_RE = re.compile(r"\d{4,}:\S{15,}")


def redact_generic(text: str) -> str:
    """Redact Telegram tokens / bot-URL tokens from arbitrary text (no configured
    literal secrets — that context lives in AewatchLogger). The minimum every
    log.write effect payload must pass through."""
    text = _BOT_URL_TOKEN_RE.sub(r"\1<REDACTED-TOKEN>", text)
    text = _TOKEN_RE.sub("<REDACTED-TOKEN>", text)
    if _RESIDUAL_TOKEN_RE.search(text):
        return "<REDACTED-LINE: residual token pattern>"
    return text


# ── Contract fixture matrix ──────────────────────────────────────────────
# CONTRACTS.md is human-readable prose, but the machine source of truth is ONE
# JSON object between these literal markers. Prose outside the block is never
# asserted. See CONTRACTS.md and tests/aewatch_tests/test_01_contracts.py.
CONTRACTS_JSON_START = "<!-- AEWATCH_CONTRACTS_JSON_START -->"
CONTRACTS_JSON_END = "<!-- AEWATCH_CONTRACTS_JSON_END -->"

# Every future behavior family must have at least one placeholder fixture id in
# phase 1, so phase 2/3 cannot silently shrink the contract surface. The
# validator (not just the test suite) owns this coverage check.
REQUIRED_FIXTURE_FAMILIES = (
    "session.discovery",
    "watchdog.status",
    "watchdog.nudge",
    "watchdog.alert",
    "watchdog.meta",
    "telegram.outbound",
    "telegram.inbound",
    "telegram.security",
    "daemon.runtime",
)

# Lowercase dotted/kebab token: dotted families + kebab leaf names, no uppercase,
# no empty segments, no doubled separators.
_FIXTURE_ID_RE = re.compile(r"^[a-z0-9]+([.-][a-z0-9]+)*$")

_FENCED_JSON_RE = re.compile(r"```json\s*\n(.*?)\n```", re.DOTALL)

_DEFAULT_CONTRACTS = Path(__file__).resolve().parent / "CONTRACTS.md"


def extract_contracts_json(text: str) -> dict:
    """Extract and parse the single marked JSON object from CONTRACTS.md text.

    Raises ValueError on missing markers, a missing fenced ```json block, invalid
    JSON, or a non-object top level. This is the ONLY contract parser — the CLI
    and the test suite both call it.
    """
    start = text.find(CONTRACTS_JSON_START)
    if start == -1:
        raise ValueError(f"contracts: start marker not found ({CONTRACTS_JSON_START})")
    end = text.find(CONTRACTS_JSON_END, start + len(CONTRACTS_JSON_START))
    if end == -1:
        raise ValueError(f"contracts: end marker not found ({CONTRACTS_JSON_END})")
    between = text[start + len(CONTRACTS_JSON_START):end]
    blocks = _FENCED_JSON_RE.findall(between)
    if not blocks:
        raise ValueError("contracts: no ```json fenced block between markers")
    if len(blocks) > 1:
        # Exactly one matrix between the markers — a duplicate/stale block must
        # fail fast rather than silently using the first (codex NIT).
        raise ValueError(
            f"contracts: expected exactly one ```json block between markers, found {len(blocks)}"
        )
    try:
        obj = json.loads(blocks[0])
    except json.JSONDecodeError as exc:
        raise ValueError(f"contracts: invalid JSON in marked block: {exc}") from exc
    if not isinstance(obj, dict):
        raise ValueError("contracts: marked JSON must be an object")
    return obj


def validate_contracts(obj: dict) -> list[str]:
    """Validate the contracts object against the phase-1 schema.

    Returns a list of human-readable error strings; an empty list means valid.
    """
    errors: list[str] = []
    if not isinstance(obj, dict):
        return ["contracts: top-level value must be an object"]
    if obj.get("schema_version") != 1:
        errors.append(f"schema_version must be 1, got {obj.get('schema_version')!r}")

    fixtures = obj.get("fixtures")
    if not isinstance(fixtures, list):
        errors.append("fixtures must be a list")
        return errors

    required_keys = ("time", "config", "sessions", "telegram", "expect")
    seen_ids: set[str] = set()
    ids: list[str] = []
    for idx, fixture in enumerate(fixtures):
        where = f"fixtures[{idx}]"
        if not isinstance(fixture, dict):
            errors.append(f"{where}: must be an object")
            continue
        fid = fixture.get("id")
        if not isinstance(fid, str) or not fid:
            errors.append(f"{where}: missing string 'id'")
        else:
            where = f"fixture {fid!r}"
            ids.append(fid)
            if not _FIXTURE_ID_RE.match(fid):
                errors.append(f"{where}: id is not a lowercase dotted/kebab token")
            if fid in seen_ids:
                errors.append(f"{where}: duplicate id")
            seen_ids.add(fid)
        for key in required_keys:
            if key not in fixture:
                errors.append(f"{where}: missing required key '{key}'")
        # Type-check the schema keys the prose already promises, so phase 2 can
        # rely on shape (a non-object `expect` must not slip past effects checks).
        for key in ("time", "config", "telegram"):
            if key in fixture and not isinstance(fixture[key], dict):
                errors.append(f"{where}: '{key}' must be an object")
        if "sessions" in fixture and not isinstance(fixture["sessions"], list):
            errors.append(f"{where}: 'sessions' must be a list")
        if "expect" in fixture:
            expect = fixture["expect"]
            if not isinstance(expect, dict):
                errors.append(f"{where}: 'expect' must be an object")
            elif "effects" not in expect:
                errors.append(f"{where}: expect.effects must be present (even if empty)")
            elif not isinstance(expect["effects"], list):
                errors.append(f"{where}: expect.effects must be a list")
        # Optional phase-2 field: `ticks`. If present it must be a list of objects,
        # each with a numeric (non-bool) epoch — otherwise a valid-looking fixture
        # would crash the multi-tick oracle before it reaches behavior diffing.
        if "ticks" in fixture:
            ticks = fixture["ticks"]
            if not isinstance(ticks, list):
                errors.append(f"{where}: 'ticks' must be a list")
            elif not ticks:
                # An explicit empty ticks list is a bad contract (it would run zero
                # cycles / mask a fixture that meant to omit ticks). Reject it.
                errors.append(f"{where}: 'ticks' must not be empty (omit the key for a single time tick)")
            else:
                for tidx, tick in enumerate(ticks):
                    if not isinstance(tick, dict):
                        errors.append(f"{where}: ticks[{tidx}] must be an object")
                        continue
                    epoch = tick.get("epoch")
                    if not isinstance(epoch, (int, float)) or isinstance(epoch, bool):
                        errors.append(f"{where}: ticks[{tidx}] 'epoch' must be numeric")

    for family in REQUIRED_FIXTURE_FAMILIES:
        if not any(i == family or i.startswith(family + ".") for i in ids):
            errors.append(f"required fixture family {family!r} has no fixture")
    return errors


def cmd_contracts_validate(args: argparse.Namespace) -> int:
    path = Path(args.contracts) if args.contracts else _DEFAULT_CONTRACTS
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"aewatch: cannot read contracts {path}: {exc}", file=sys.stderr)
        return 2
    try:
        obj = extract_contracts_json(text)
    except ValueError as exc:
        print(f"aewatch: {exc}", file=sys.stderr)
        return 1
    errors = validate_contracts(obj)
    if errors:
        for err in errors:
            print(f"aewatch: contract error: {err}", file=sys.stderr)
        return 1
    print(f"aewatch: contracts OK ({len(obj['fixtures'])} fixtures) — {path}")
    return 0


# ── Effect model (the parity oracle schema) ──────────────────────────────
# Every OBSERVABLE side effect — and nothing else — is normalized into one of
# these record shapes. Reads (list_sessions/list_panes/capture_pane/
# display_option) are NOT observable and record no effect. This schema is the
# single source of truth: the phase-2 real subprocess TmuxClient and the bash
# fake_tmux shim must emit byte-identical records, so the dual-run diff oracle
# has one format. The RECORDER preserves order (paste/submit/nudge sequencing
# matters); canonical_effects() is a deterministic *presentation* sort only —
# never the primary comparison, and it never collapses duplicates.
EFFECT_KINDS = frozenset(
    {
        "event.append",     # append a record to a session's events.jsonl
        "tmux.paste",        # paste (optionally submit) text into a pane
        "tmux.set_option",   # set a tmux option on a target (session or pane)
        "tmux.unset_option", # unset a tmux option on a target
        "tmux.display_message",  # user-visible `tmux display-message -d <ms> <text>` alert
        "telegram.send",     # outbound Telegram message
        "telegram.supervise",  # best-effort bridge-revive ATTEMPT (scheduler; NOT a send)
        "file.write",        # write an aewatch-owned runtime file ($AE_HOME/aewatch/*)
        "log.write",         # emit a daemon.log line
    }
)


def make_effect(kind: str, **fields: object) -> dict:
    """Build one normalized, JSON-serializable effect record.

    Raises ValueError for any kind outside the observable surface (EFFECT_KINDS).
    """
    if kind not in EFFECT_KINDS:
        raise ValueError(f"unknown effect kind: {kind!r}")
    return {"kind": kind, **fields}


def canonical_effects(effects: list[dict]) -> list[dict]:
    """Deterministic presentation ordering for effect lists.

    Order-independent and stable, but DUPLICATE-PRESERVING — it is a summary
    helper, not the oracle. Sequence-sensitive comparisons use the recorder's
    ordered list (EffectRecorder.as_list()).
    """
    return sorted(effects, key=lambda e: json.dumps(e, sort_keys=True))


class EffectRecorder:
    """Ordered, duplicate-preserving sink for normalized effects.

    as_list() is the first-class oracle: it keeps insertion order and repeated
    identical records as distinct entries.
    """

    def __init__(self) -> None:
        self._effects: list[dict] = []

    def record(self, kind: str, **fields: object) -> dict:
        # Central guarantee: EVERY log.write effect payload is generic-redacted,
        # regardless of caller (discovery/backoff warnings, AewatchLogger, ...).
        # A message already redacted by AewatchLogger passes through unchanged.
        if kind == "log.write" and isinstance(fields.get("message"), str):
            fields["message"] = redact_generic(fields["message"])
        effect = make_effect(kind, **fields)
        self._effects.append(effect)
        return effect

    def log(self, level: str, message: str) -> dict:
        return self.record("log.write", level=level, message=message)

    def as_list(self) -> list[dict]:
        return list(self._effects)


class TmuxClient(abc.ABC):
    """Interface both the fake (tests) and the real subprocess client implement.

    READ methods return data and record NO effect. MUTATION methods each append
    exactly one normalized effect via the client's recorder. `target` is the raw
    tmux target string — a session name, window, or pane id — never pane-only.
    """

    @abc.abstractmethod
    def list_sessions(self, server: str | None = None) -> list[str]: ...

    @abc.abstractmethod
    def list_panes(self, session: str, server: str | None = None) -> list: ...

    @abc.abstractmethod
    def capture_pane(self, pane_id: str) -> str: ...

    @abc.abstractmethod
    def display_option(self, target: str, option: str) -> str | None: ...

    @abc.abstractmethod
    def set_option(self, target: str, option: str, value: str) -> None: ...

    @abc.abstractmethod
    def unset_option(self, target: str, option: str) -> None: ...

    @abc.abstractmethod
    def paste(self, target: str, text: str, submit: bool) -> None: ...

    @abc.abstractmethod
    def display_message(self, text: str, *, duration_ms: int | None = None) -> None: ...


class NullTmuxClient(TmuxClient):
    """Phase-1 placeholder: no live tmux. Reads return empty (discovery still works
    off meta, liveness=False); mutations RAISE so phase 1 can never accidentally
    grow a tmux write."""

    def list_sessions(self, server=None):
        return []

    def list_panes(self, session, server=None):
        return []

    def capture_pane(self, pane_id):
        return ""

    def display_option(self, target, option):
        return None

    def set_option(self, target, option, value):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def unset_option(self, target, option):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def paste(self, target, text, submit):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def display_message(self, text, *, duration_ms=None):
        raise NotImplementedError("phase 1 must not mutate tmux")


def collect_inputs(ae_home: Path, tmux: TmuxClient, recorder: EffectRecorder) -> list[str]:
    """Phase-1 no-op input collector: READ-ONLY.

    Lists the session directories that carry a `meta` file under $AE_HOME/sessions
    and records a single log line. It performs NO mutations (no tmux writes, no
    event appends, no runtime-file or Telegram effects). `tmux` is accepted so the
    signature is stable for the discovery slice; the read below also proves reads
    never record an effect.
    """
    sessions_dir = Path(ae_home) / "sessions"
    names: list[str] = []
    if sessions_dir.is_dir():
        for child in sorted(sessions_dir.iterdir()):
            if (child / "meta").is_file():
                names.append(child.name)
    tmux.list_sessions(None)  # read-only probe; must not record an effect
    recorder.log("INFO", f"collect-inputs: {len(names)} session dir(s)")
    return names


# ── ae-compatible INI parser (parity port) ───────────────────────────────
# Mirrors ae's own parse_config regex semantics EXACTLY so aewatch reads the same
# config ae does — NOT a general TOML/YAML parser. Notably: only literal spaces
# (never tabs) around '='; quoted values kept verbatim (a '#' inside quotes is not
# a comment); unquoted values strip an inline '#...' then right-trim; last
# duplicate wins; section names are [a-zA-Z_-]+ (no digits); keys before any
# section land in the "" bucket; non-matching lines are ignored.
_INI_SECTION_RE = re.compile(r"\[([a-zA-Z_-]+)\]")
_INI_KV_QUOTED_RE = re.compile(r'([a-zA-Z_][a-zA-Z0-9_-]*) *= *"(.*)"')
_INI_KV_UNQUOTED_RE = re.compile(r"([a-zA-Z_][a-zA-Z0-9_-]*) *= *(.+)")


def parse_ae_ini(text: str) -> dict[str, dict[str, str]]:
    """Parse ae INI text into {section: {key: value}} (all values are strings)."""
    result: dict[str, dict[str, str]] = {}
    section = ""
    if not text:
        return result
    # ae reads with `while IFS= read -r line`: it splits ONLY on '\n' and DROPS a
    # final line lacking a trailing newline (read returns non-zero at EOF without
    # a delimiter). Mirror both so phase-2 diffing has no hidden exception — do
    # not use str.splitlines() (splits on more separators and keeps the last line).
    lines = text.split("\n")
    if not text.endswith("\n"):
        lines = lines[:-1]
    for raw_line in lines:
        line = raw_line.strip()
        if not line:
            continue
        m = _INI_SECTION_RE.fullmatch(line)
        if m:
            section = m.group(1)
            continue
        m = _INI_KV_QUOTED_RE.fullmatch(line)
        if m:
            # Quoted value: verbatim, no comment stripping.
            result.setdefault(section, {})[m.group(1)] = m.group(2)
            continue
        m = _INI_KV_UNQUOTED_RE.fullmatch(line)
        if m:
            # Unquoted value: strip an inline '#...' comment, then right-trim.
            value = m.group(2).split("#", 1)[0].rstrip()
            result.setdefault(section, {})[m.group(1)] = value
            continue
        # Anything else (incl. full-line '#' comments) is ignored.
    return result


def load_config(ae_home) -> dict[str, dict[str, str]]:
    """Load and parse $AE_HOME/config. Missing file -> empty dict.

    Phase 1 is single-file by design: a local .ae/config overlay is cwd/session
    dependent and belongs to a later explicit-path loader, not a singleton daemon.
    """
    config_path = Path(ae_home) / "config"
    if not config_path.is_file():
        return {}
    return parse_ae_ini(config_path.read_text(encoding="utf-8"))


# ── Session discovery (per-meta tmux_server) ─────────────────────────────
# Session `meta` is a FLAT key=value file (no sections/quotes/comments), and its
# agent.* keys contain '.', which the config key grammar rejects — so meta has
# its own parser, distinct from parse_ae_ini.


def _parse_session_meta(text: str) -> dict[str, str]:
    """Parse a flat ae session meta (key=value per line, split on the first '=')."""
    out: dict[str, str] = {}
    for line in text.split("\n"):
        if "=" in line:
            key, value = line.split("=", 1)
            out[key] = value
    return out


@dataclasses.dataclass
class DiscoveredAgent:
    slot: str        # the key after 'agent.' — e.g. main, worker.0, spawned.1
    ref: str         # 'alias:name'
    session_id: str  # the agent's own tool session id (may be empty)


@dataclasses.dataclass
class DiscoveredSession:
    name: str
    session_id: str
    work_dir: str
    tmux_server: str
    running: bool
    agents: list

    def to_dict(self) -> dict:
        return {
            "name": self.name,
            "session_id": self.session_id,
            "work_dir": self.work_dir,
            "tmux_server": self.tmux_server,
            "running": self.running,
            "agents": [
                {"slot": a.slot, "ref": a.ref, "session_id": a.session_id}
                for a in self.agents
            ],
        }


def discover_sessions(ae_home, tmux, recorder=None) -> list:
    """Discover sessions from $AE_HOME/sessions/*/meta.

    Liveness is read through EACH session's OWN tmux_server — never a global
    server. One bad meta cannot hide good sessions: a malformed dir is skipped
    with a recorded warning (not stderr). A directory without a meta file is not
    a session and is ignored silently. Returns DiscoveredSession sorted by name
    (stable for phase-2 oracle snapshots); each is JSON-serializable via to_dict().
    """
    sessions_dir = Path(ae_home) / "sessions"
    result: list = []
    if not sessions_dir.is_dir():
        return result
    for child in sorted(sessions_dir.iterdir()):
        meta_file = child / "meta"
        if not meta_file.is_file():
            continue  # not a session directory
        try:
            meta = _parse_session_meta(meta_file.read_text(encoding="utf-8"))
        except OSError as exc:
            if recorder is not None:
                recorder.log("WARNING", f"discovery: unreadable meta in {child.name}: {exc}")
            continue
        name = meta.get("session", "").strip()
        if not name:
            if recorder is not None:
                recorder.log("WARNING", f"discovery: meta missing 'session' in {child.name}, skipped")
            continue
        agents = []
        for key in sorted(meta):
            if key.startswith("agent."):
                parts = meta[key].split(":")
                ref = ":".join(parts[:2]) if len(parts) >= 2 else meta[key]
                agent_session_id = parts[2] if len(parts) >= 3 else ""
                agents.append(
                    DiscoveredAgent(slot=key[len("agent.") :], ref=ref, session_id=agent_session_id)
                )
        server = meta.get("tmux_server", "")
        running = name in tmux.list_sessions(server)
        result.append(
            DiscoveredSession(
                name=name,
                session_id=meta.get("session_id", ""),
                work_dir=meta.get("work_dir", ""),
                tmux_server=server,
                running=running,
                agents=agents,
            )
        )
    result.sort(key=lambda s: s.name)
    return result


# ── Watchdog cycle (phase-2 parity port of ae's `watchdog _run`) ─────────
# The Python side of the dual-run oracle. Each function mirrors a NAMED bash
# helper so the ordered effect stream is byte-identical to the generated
# watchdog. Slice 4 covers the status side channel (bootstrap + end-of-cycle
# @ae_watchdog_status / @ae_branch_status / @ae_branch_name); later slices fill
# activity, nudges, alerts, throttle, and sweep on the same WatchdogState.

# Panes that are never counted as agents (ae:7682-7684 case + the empty guard).
_SYSTEM_AGENTS = frozenset({"", "(null)", "_watchdog", "_shepherd", "_loop", "_events"})


def _env_int(env, *names, default: int) -> int:
    """First present AE_WATCHDOG_*/AE_LOOP_* name wins. A set-but-non-numeric
    override falls back to `default` — mirrors bash `${VAR:-${LEGACY:-N}}` plus the
    SWEEP numeric guard (ae:7608). An unset/empty name is skipped, not a fallback."""
    for name in names:
        raw = env.get(name)
        if raw is None or raw == "":
            continue
        return int(raw) if raw.isdigit() else default
    return default


@dataclasses.dataclass
class WatchdogConfig:
    """Watchdog tunables (ae:7595-7608). Values do not affect the slice-4 status
    stream (they gate sleep/nudge/sweep, added later) but the seam is here now."""

    interval: int = 60
    stale_min: int = 15
    max_nudges: int = 2
    throttle_alert_cycles: int = 5
    tg_supervise_secs: int = 120
    sweep_secs: int = 300

    @property
    def stale_secs(self) -> int:
        return self.stale_min * 60

    @classmethod
    def from_env(cls, env=None) -> "WatchdogConfig":
        env = os.environ if env is None else env
        return cls(
            interval=_env_int(env, "AE_WATCHDOG_INTERVAL_SEC", "AE_LOOP_INTERVAL_SEC", default=60),
            stale_min=_env_int(env, "AE_WATCHDOG_STALE_MIN", "AE_LOOP_STALE_MIN", default=15),
            max_nudges=_env_int(env, "AE_WATCHDOG_MAX_NUDGES", "AE_LOOP_MAX_NUDGES", default=2),
            throttle_alert_cycles=_env_int(
                env, "AE_WATCHDOG_THROTTLE_ALERT_CYCLES", "AE_LOOP_THROTTLE_ALERT_CYCLES", default=5
            ),
            tg_supervise_secs=_env_int(env, "AE_WATCHDOG_TG_SUPERVISE_SEC", "AE_LOOP_TG_SUPERVISE_SEC", default=120),
            sweep_secs=_env_int(env, "AE_WATCHDOG_SWEEP_SEC", "AE_LOOP_SWEEP_SEC", default=300),
        )


@dataclasses.dataclass
class WatchdogState:
    """Per-session mutable state carried across cycles (ae's `declare -A` maps).
    Mostly dormant in slice 4; later slices populate the hash/nudge/alert maps."""

    cycle: int = 0
    prev_hash: dict = dataclasses.field(default_factory=dict)
    last_hash_change: dict = dataclasses.field(default_factory=dict)
    nudge_count: dict = dataclasses.field(default_factory=dict)
    dead_agents: dict = dataclasses.field(default_factory=dict)
    alerted_missing: dict = dataclasses.field(default_factory=dict)
    throttle_streak: dict = dataclasses.field(default_factory=dict)
    # Per-pane quiet baseline for waiting-user/blocked: the declaration's full-tuple
    # key + the pane hash captured when it was first observed (ae's quiet_base_*).
    quiet_base_key: dict = dataclasses.field(default_factory=dict)
    quiet_base_hash: dict = dataclasses.field(default_factory=dict)
    # Meta-agent (steward) sweep cadence + wedge latches (ae's last_sweep_nudge /
    # first_sweep_nudge / meta_wedge_alerted / meta_reconciled).
    last_sweep_nudge: dict = dataclasses.field(default_factory=dict)
    first_sweep_nudge: dict = dataclasses.field(default_factory=dict)
    meta_wedge_alerted: dict = dataclasses.field(default_factory=dict)
    meta_reconciled: dict = dataclasses.field(default_factory=dict)
    # Telegram bridge supervise cadence (ae's last_tg_supervise; init 0 -> cycle 1 due).
    last_tg_supervise: int = 0


def default_git_runner(work_dir, args, *, timeout: int = 2):
    """Run `git -C work_dir <args>` with a 2s cap, stderr discarded; return
    (returncode, stdout). Any spawn/timeout failure -> (1, ''). Mirrors bash
    `timeout 2 git -C "$work_dir" ... 2>/dev/null` (ae:7438). Injectable so branch
    fixtures (slice 5+) can drive deterministic branch/dirty state without ambient
    git/timeout/repo/filesystem dependence (codex)."""
    import subprocess

    try:
        proc = subprocess.run(
            ["git", "-C", str(work_dir), *args],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.returncode, proc.stdout
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def _trim_branch(text: str, max_len: int = 24) -> str:
    """Port of ae:7427 `_watchdog_trim`: newline/CR -> space; overflow ->
    first (max_len - 1) chars + '~'."""
    text = text.replace("\n", " ").replace("\r", " ")
    if len(text) > max_len:
        return text[: max_len - 1] + "~"
    return text


def _write_branch_segment(tmux, session, work_dir, *, git) -> str:
    """Port of ae:7454 `_watchdog_branch_segment`. Writes the @ae_branch_name
    machine side channel (set FULL untrimmed branch, or unset) and RETURNS the
    display segment the caller pushes into @ae_branch_status: ' <branch><dirty>'
    for a git work_dir, '' otherwise."""
    if not work_dir or git(work_dir, ["rev-parse", "--is-inside-work-tree"])[0] != 0:
        tmux.unset_option(session, "@ae_branch_name")
        return ""
    rc, out = git(work_dir, ["symbolic-ref", "--quiet", "--short", "HEAD"])
    full = out.strip() if rc == 0 else ""
    if not full:
        rc2, out2 = git(work_dir, ["rev-parse", "--short", "HEAD"])
        full = out2.strip() if rc2 == 0 else ""
    branch = _trim_branch(full, 24)
    if not branch:
        tmux.unset_option(session, "@ae_branch_name")
        return ""
    tmux.set_option(session, "@ae_branch_name", full)
    dirty = "*" if git(work_dir, ["status", "--porcelain", "--untracked-files=no"])[1].strip() else ""
    return f" {branch}{dirty}"


def _push_status(tmux, session, status_value, work_dir, *, git) -> None:
    """The ae per-cycle status push (ae:7633-7634 / 8008-8009), IN ORDER:
    set @ae_watchdog_status, then the branch segment (which unsets/sets
    @ae_branch_name), then set @ae_branch_status to that segment."""
    tmux.set_option(session, "@ae_watchdog_status", status_value)
    segment = _write_branch_segment(tmux, session, work_dir, git=git)
    tmux.set_option(session, "@ae_branch_status", segment)


def watchdog_bootstrap(tmux, session, *, work_dir, git=default_git_runner) -> None:
    """The pre-loop status write (ae:7633-7634): '[watch ◌ starting]' + branch."""
    _push_status(tmux, session, "[watch ◌ starting]", work_dir, git=git)


def _pane_hash(buf: str) -> str:
    """md5 of the pane buffer with trailing newlines stripped — mirrors ae's
    `printf '%s' "$(tmux capture-pane -p -J -S -40 -E -)" | md5sum` (ae:7805-7806):
    command substitution strips trailing LFs; spaces/tabs/CR are kept."""
    return hashlib.md5(buf.rstrip("\n").encode("utf-8")).hexdigest()


_NO_EVENT_AGE = 999999  # ae's sentinel when no matching event exists (ae:7314/7320)


def _parse_event_ts(ts: str):
    """Parse ae's `date -u +%FT%TZ` ts (2026-07-05T07:00:00Z) to a UTC epoch int,
    or None on any malformed value (caller treats as no-event)."""
    try:
        dt = datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ")
    except (ValueError, TypeError):
        return None
    return int(dt.replace(tzinfo=datetime.timezone.utc).timestamp())


def _last_event_age(session_dir, agent: str, now) -> int:
    """Age (s) of the NEWEST events.jsonl line whose actor == agent, read from the
    session's ACTUAL file so slice-2's feed-forward holds (an event.append effect
    mutates the file; a later tick sees it here). Port of ae:7310-7327, but
    json.loads + exact actor match instead of the grep-substring. Returns the
    _NO_EVENT_AGE sentinel when the file/agent/ts is absent or unparseable (stale)."""
    if session_dir is None:
        return _NO_EVENT_AGE
    events_file = Path(session_dir) / "events.jsonl"
    if not events_file.is_file():
        return _NO_EVENT_AGE
    try:
        lines = events_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return _NO_EVENT_AGE
    last_ts = None
    for line in lines:  # chronological file order — last actor match is newest
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("actor") == agent:
            last_ts = event.get("ts")
    if not last_ts:
        return _NO_EVENT_AGE
    epoch = _parse_event_ts(last_ts)
    if epoch is None:
        return _NO_EVENT_AGE
    return int(now) - epoch


def _latest_relevant_event(session_dir, agent: str, session_name: str):
    """Newest events.jsonl line (by append order) MENTIONING agent — actor==agent,
    target==agent, or target==f'@{session}:{agent}'. Port of ae:7329
    _latest_relevant_event; json.loads instead of the grep/tac scan. Returns a dict
    {action,ts,ref,actor,summary} or None."""
    if session_dir is None:
        return None
    events_file = Path(session_dir) / "events.jsonl"
    if not events_file.is_file():
        return None
    try:
        lines = events_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    at_ref = f"@{session_name}:{agent}"
    for line in reversed(lines):  # newest-in-file wins
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        actor = ev.get("actor", "")
        target = ev.get("target", "")
        if actor == agent or target == agent or target == at_ref:
            return {
                "action": ev.get("action", ""),
                "ts": ev.get("ts", ""),
                "ref": ev.get("ref", ""),
                "actor": actor,
                "summary": ev.get("summary", ""),
            }
    return None


_QUIET_REASONS = frozenset({"done", "waiting-user", "blocked"})


def _agent_quiet_reason(session_dir, agent: str, session_name: str):
    """(reason, key) of the agent's current self-declared quiet state, or None.
    Port of ae:7364. ONLY the agent's OWN declaration is quiet (actor==agent); a
    newer inbound event (actor!=agent targeting it) invalidates it. Legacy
    action==done -> 'done'; action==state with ref in {done,waiting-user,blocked}
    -> ref. key = 'action|ts|ref|actor|summary' (full tuple, so a fresh
    declaration re-arms even within one second)."""
    row = _latest_relevant_event(session_dir, agent, session_name)
    if row is None or row["actor"] != agent:
        return None
    if row["action"] == "done":
        reason = "done"
    elif row["action"] == "state" and row["ref"] in _QUIET_REASONS:
        reason = row["ref"]
    else:
        return None
    key = f'{row["action"]}|{row["ts"]}|{row["ref"]}|{row["actor"]}|{row["summary"]}'
    return reason, key


def _quiet_pane_decision(cur_hash, armed_key, armed_hash, decl_key) -> str:
    """arm (new/different declaration) | hold (pane unchanged since baseline) |
    yield (pane changed -> no longer quiet). Port of ae:7411."""
    if armed_key != decl_key:
        return "arm"
    if cur_hash == armed_hash:
        return "hold"
    return "yield"


_SHELL_COMMANDS = frozenset({"bash", "zsh", "fish", "sh", "dash", ""})
_ALERT_DURATION_MS = 10000


def default_has_descendant(pane_pid, agent_bin) -> bool:
    """Whether `agent_bin` runs as a descendant of `pane_pid` — ae's
    _pane_has_descendant_named (pgrep -x + /proc ancestor walk, ae:7489). The fake
    oracle has no real process tree, and dead fixtures use a nonexistent agent_bin,
    so bash's `pgrep -x` is empty (dead); the default here returns False to match.
    Injectable for a future process-shim slice (alive-via-descendant)."""
    return False


def _load_agent_bins(session_dir) -> dict:
    """Map 'alias:name' label -> agent binary from meta agent_bin.<slot>, keyed by
    slot via the agent.<slot> entries; fallback to the alias. Port of ae:7567."""
    agents: dict = {}
    if session_dir is None:
        return agents
    meta_file = Path(session_dir) / "meta"
    if not meta_file.is_file():
        return agents
    try:
        lines = meta_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return agents
    slot_to_bin: dict = {}
    for line in lines:
        if "=" in line:
            key, val = line.split("=", 1)
            if key.startswith("agent_bin."):
                slot_to_bin[key[len("agent_bin."):]] = val
    for line in lines:
        if "=" in line:
            key, val = line.split("=", 1)
            if key.startswith("agent."):
                slot = key[len("agent."):]
                label = val.rsplit(":", 1)[0]  # strip trailing :session_id -> alias:name
                agents[label] = slot_to_bin.get(slot, val.split(":", 1)[0])
    return agents


def _meta_agent_refs(session_dir) -> list:
    """Registered agent refs (alias:name) from meta agent.<slot> lines, in file
    order. agent_ref = the first two colon fields of the value (ae:7957)."""
    if session_dir is None:
        return []
    meta_file = Path(session_dir) / "meta"
    if not meta_file.is_file():
        return []
    refs: list = []
    try:
        lines = meta_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return refs
    for line in lines:
        if "=" in line:
            key, val = line.split("=", 1)
            if key.startswith("agent."):
                parts = val.split(":")
                refs.append(f"{parts[0]}:{parts[1]}" if len(parts) >= 2 else val)
    return refs


def _watchdog_event(now, action: str, target: str, summary: str) -> dict:
    """A watchdog event emitted DIRECTLY (not via send), so actor is 'human'
    (ae_current_agent_ref is empty in the _run subprocess) — NOT 'watchdog'. Omits
    empty ref, matching ae's direct ae_emit_event. Used for alert / throttled /
    throttle-cleared (the nudge, routed through send, is actor 'watchdog')."""
    return {"ts": _now_iso(now), "actor": "human", "action": action, "target": target, "summary": summary}


def _alert_event(now, target: str, summary: str) -> dict:
    return _watchdog_event(now, "alert", target, summary)


# Verbatim per-tool throttle catalogs (ae:7517) — opencode is the UNION; refactor
# here, never duplicate. The generic 429/503 patterns always apply.
_THROTTLE_CLAUDE = ("Server is temporarily limiting requests", "API Error: Overloaded", "Anthropic API error")
_THROTTLE_CODEX = ("Rate limit exceeded", "RateLimitError", "ratelimit_exceeded")
_THROTTLE_GEMINI = ("RESOURCE_EXHAUSTED", "Quota exceeded")
_THROTTLE_GENERIC = ("429 Too Many Requests", "503 Service Unavailable")
_THROTTLE_CATALOGS = {
    "claude": _THROTTLE_CLAUDE,
    "codex": _THROTTLE_CODEX,
    "gemini": _THROTTLE_GEMINI,
    "opencode": _THROTTLE_CLAUDE + _THROTTLE_CODEX + _THROTTLE_GEMINI,
}


def _buf_shows_throttle(buf: str, agent_bin: str) -> bool:
    """True if the pane buffer shows an upstream throttle / overload phrase for this
    tool. Verbatim port of ae:7517 _buf_shows_throttle — the per-tool catalog
    (opencode = the union) plus the generic patterns; an empty buffer is never
    throttled; substring match."""
    if not buf:
        return False
    for pattern in _THROTTLE_CATALOGS.get(agent_bin, ()) + _THROTTLE_GENERIC:
        if pattern in buf:
            return True
    return False


# The exact steward sweep prompt (ae:7788-7790). Fixed text — no runtime paths.
_SWEEP_TEXT = (
    "Run your sweep now: ae list --json, diff your state file, and report ONLY "
    "new/changed attention to Clemens via say (stay silent if nothing changed). "
    "Stay in 'working'."
)


def _meta_main_agent(session_dir) -> str:
    """The meta session's main agent ref (alias:name) — agent.main's first two colon
    fields (ae:7612 `cut -d: -f1,2`)."""
    val = _meta_value(session_dir, "agent.main")
    parts = val.split(":")
    return f"{parts[0]}:{parts[1]}" if len(parts) >= 2 else val


def _heartbeat_mtime(session_dir) -> int:
    """The steward heartbeat file's mtime as INTEGER seconds (bash `stat -c %Y`), or
    0 when absent. int() cast so (now - hb) // 60 matches bash exactly (ae:7738)."""
    if session_dir is None:
        return 0
    hb = Path(session_dir) / "meta-agent-state.json"
    if not hb.is_file():
        return 0
    try:
        return int(hb.stat().st_mtime)
    except OSError:
        return 0


def _agent_alert_reason(session_dir, agent: str, session_name: str) -> str:
    """Newest decisive alert/recovery reason for `agent` from events.jsonl, or ''.
    Port of ae:1628. Newest-first: an `alert` maps by summary (not sweeping->stale,
    dead/dropped/missing->dead, throttl->throttled, else stale); `throttled`->
    throttled; a clear (throttle-cleared/alert-cleared) or the agent's OWN other
    event -> '' (recovered); a target-only event (nudge/inbound) keeps scanning."""
    if session_dir is None:
        return ""
    events_file = Path(session_dir) / "events.jsonl"
    if not events_file.is_file():
        return ""
    try:
        lines = events_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    at_ref = f"@{session_name}:{agent}"
    for line in reversed(lines):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        actor = ev.get("actor", "")
        target = ev.get("target", "")
        if not (actor == agent or target == agent or target == at_ref):
            continue
        action = ev.get("action", "")
        if action == "alert":
            summary = ev.get("summary", "")
            if "not sweeping" in summary:
                return "stale"
            if any(x in summary for x in ("dead", "dropped", "missing", "MISSING")):
                return "dead"
            if "throttl" in summary:
                return "throttled"
            return "stale"
        if action == "throttled":
            return "throttled"
        if action in ("throttle-cleared", "alert-cleared"):
            return ""
        if actor == agent:  # the agent's OWN activity -> recovered
            return ""
        # target-only event (a nudge / inbound send) is not recovery — keep scanning.
    return ""


def _meta_value(session_dir, key: str) -> str:
    """First `key=` value from session_dir/meta, '' when absent. Port of ae:7422
    _watchdog_meta_value (grep '^key=' | head -1 | cut -d= -f2-)."""
    if session_dir is None:
        return ""
    meta_file = Path(session_dir) / "meta"
    if not meta_file.is_file():
        return ""
    try:
        for line in meta_file.read_text(encoding="utf-8").splitlines():
            if line.startswith(key + "="):
                return line[len(key) + 1:]
    except OSError:
        return ""
    return ""


def _now_iso(epoch) -> str:
    """UTC epoch -> ae's `date -u +%FT%TZ` string (2026-07-05T07:00:00Z)."""
    return datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _nudge_text(session_dir, goal: str) -> str:
    """The exact user-visible nudge message (ae:7933-7939). The Session-goal prefix
    is present only when a goal is set; ${META_DIR} is the session dir (session_dir),
    matching bash — the parity harness normalizes that runtime path."""
    goal_line = f"Session goal: {goal}. " if goal else ""
    return (
        f"{goal_line}Status check: if you have more work, continue. Otherwise declare "
        f'your state so I stop nudging: {session_dir}/state <waiting-user|blocked|done> "<reason>"'
    )


def run_watchdog_cycle(
    config, state, tmux, session, *, work_dir, session_dir=None, tmux_server="",
    now=None, git=default_git_runner, emit_event=None, has_descendant=default_has_descendant,
    recover_pending=None, supervise_bridge=None,
) -> None:
    """One watchdog cycle for `session`. Counts live @ae_agent panes, classifies
    each (dead / throttled / quiet / active / recent / stale) and acts on them,
    then checks for missing panes, and finally pushes the end-of-cycle status +
    branch.

    Per-agent order mirrors ae:7679-7952. IMPLEMENTED: dead check (shell foreground
    + no descendant -> alert, latched via dead_agents); throttle detect + clear
    (before quiet) and react (after quiet, before active) — pause nudges, `throttled`
    once, `alert` at THROTTLE_ALERT_CYCLES, `throttle-cleared` on recovery; quiet
    states (done event-only / waiting-user / blocked arm-hold-yield); active/recent
    (pure cycle_active bumps); stale -> nudge under MAX_NUDGES (tmux.paste +
    event.append(nudge) via emit_event, actor 'watchdog') then a single max-nudge
    ALERT at count==MAX_NUDGES. After the loop, registered agents with no pane raise
    a missing alert (latched via alerted_missing), then pending session-ids are
    recovered via the injected recover_pending boundary (recover events) — both run
    BEFORE the status push. Meta-agent sweep + wedge (slice 10) run in branch 1b.
    Alerts / throttle / recover events are DIRECT emits (actor 'human') + a
    tmux.display_message where applicable. Finally, the telegram bridge supervise
    scheduler (branch 10, throttled to TG_SUPERVISE_SECS) fires the injected
    supervise_bridge boundary when due -> a telegram.supervise effect. All watchdog
    branches are now ported; phase 3 owns the real tmux/bridge clients."""
    state.cycle += 1
    goal = _meta_value(session_dir, "goal")
    agent_bins = _load_agent_bins(session_dir)
    meta_agent = _meta_value(session_dir, "meta_agent")
    meta_main_agent = _meta_main_agent(session_dir)
    live_agents: dict = {}
    total = active = stale = dead = 0
    for pane in tmux.list_panes(session, tmux_server):
        agent = (pane.agent or "").strip()
        if agent in _SYSTEM_AGENTS:
            continue
        total += 1
        pane_id = pane.pane_id
        live_agents[agent] = pane_id
        # Skip already-dead agents — no further checks (ae:7688-7693).
        if pane_id in state.dead_agents:
            dead += 1
            continue
        # 1. Dead check (ae:7703-7717) — foreground is a shell and the agent is not
        #    a live descendant -> dead alert (once), then latched via dead_agents.
        agent_bin = agent_bins.get(agent, agent.split(":")[0])
        if pane.current_command in _SHELL_COMMANDS and not has_descendant(pane.pane_pid, agent_bin):
            state.dead_agents[pane_id] = True
            dead += 1
            if emit_event is not None:
                emit_event(session, _alert_event(now, agent, "agent process dead — dropped to shell"))
            tmux.display_message(
                f"[ae watchdog] {agent} is DEAD — process dropped to shell", duration_ms=_ALERT_DURATION_MS
            )
            continue
        # 1b. Meta-agent (steward) sweep cadence + wedge (ae:7719-7798) — ONLY the
        #     meta session's main agent. Idle between sweeps is NORMAL, not stale:
        #     prompt a sweep every SWEEP_SECS, and guard liveness via the steward's
        #     heartbeat file (wedge alert if it stops advancing, cleared on recovery).
        if meta_agent == "true" and agent == meta_main_agent and config.sweep_secs > 0:
            hb = _heartbeat_mtime(session_dir)
            wedge_secs = config.sweep_secs * 2 + 60
            first_nudge = state.first_sweep_nudge.get(pane_id, 0)
            if hb > 0 and now - hb <= wedge_secs:
                # Fresh heartbeat -> recovery. Clear via the in-memory latch, OR once
                # per lifetime reconcile the durable event log (a restart that lost
                # the latch after alerting still emits a clear).
                if pane_id in state.meta_wedge_alerted:
                    del state.meta_wedge_alerted[pane_id]
                    state.meta_reconciled[pane_id] = True
                    if emit_event is not None:
                        emit_event(session, _watchdog_event(
                            now, "alert-cleared", agent, "meta-agent sweeping again (heartbeat resumed)"))
                elif pane_id not in state.meta_reconciled:
                    # Once per watchdog lifetime, reconcile the DURABLE event log: a
                    # restart that lost the in-memory latch after alerting still emits
                    # a clear if the log shows an active alert (ae:7757-7762). ae now
                    # emits _agent_alert_reason into _lib (slice 10b), so this fires.
                    state.meta_reconciled[pane_id] = True
                    if _agent_alert_reason(session_dir, agent, session) and emit_event is not None:
                        emit_event(session, _watchdog_event(
                            now, "alert-cleared", agent, "meta-agent sweeping again (heartbeat resumed)"))
            elif first_nudge > 0 and now - first_nudge > wedge_secs:
                # Prompted long enough but the heartbeat is stale/absent -> wedge.
                if pane_id not in state.meta_wedge_alerted:
                    state.meta_wedge_alerted[pane_id] = True
                    if hb > 0:
                        wedge_detail = f"no heartbeat for {(now - hb) // 60}m"
                    else:
                        wedge_detail = f"never wrote a heartbeat in {(now - first_nudge) // 60}m of sweep prompts"
                    if emit_event is not None:
                        emit_event(session, _alert_event(
                            now, agent, f"meta-agent not sweeping — {wedge_detail} (may be stuck)"))
                    tmux.display_message(
                        f"[ae watchdog] {agent} (meta-agent) not sweeping — may be stuck",
                        duration_ms=_ALERT_DURATION_MS)
            # Sweep cadence. Record the first nudge time so the wedge guard has a
            # reference point even before any heartbeat file exists.
            if now - state.last_sweep_nudge.get(pane_id, 0) >= config.sweep_secs:
                if state.first_sweep_nudge.get(pane_id, 0) == 0:
                    state.first_sweep_nudge[pane_id] = now
                tmux.paste(pane_id, _SWEEP_TEXT, submit=True)
                if emit_event is not None:
                    emit_event(session, {
                        "ts": _now_iso(now), "actor": "watchdog", "action": "nudge",
                        "target": agent, "summary": "sweep cadence",
                    })
                state.last_sweep_nudge[pane_id] = now
            active += 1
            continue
        buf = tmux.capture_pane(pane_id)
        h = _pane_hash(buf)
        # Throttle detect + clear (ae:7808-7819) — BEFORE quiet, every cycle: a
        # recovered pane with a live streak emits throttle-cleared no matter which
        # branch the agent later exits on. The REACT is after quiet (below).
        is_throttled = _buf_shows_throttle(buf, agent_bin)
        if not is_throttled and pane_id in state.throttle_streak:
            if emit_event is not None:
                emit_event(session, _watchdog_event(
                    now, "throttle-cleared", agent,
                    f"throttling cleared after {state.throttle_streak[pane_id]} cycles",
                ))
            del state.throttle_streak[pane_id]
        # Quiet state (ae:7821-7864) — evaluated BEFORE active so a declared agent
        # is not nudged. done is event-only (pane churn never invalidates it);
        # waiting-user/blocked arm a per-declaration pane baseline, hold while the
        # pane is untouched, and yield (fall through) once it changes.
        quiet = _agent_quiet_reason(session_dir, agent, session)
        if quiet is not None:
            reason, decl_key = quiet
            if reason == "done":
                state.nudge_count[pane_id] = 0
                active += 1
                continue
            decision = _quiet_pane_decision(
                h, state.quiet_base_key.get(pane_id), state.quiet_base_hash.get(pane_id), decl_key
            )
            if decision == "arm":
                state.quiet_base_key[pane_id] = decl_key
                state.quiet_base_hash[pane_id] = h
            if decision in ("arm", "hold"):
                state.nudge_count[pane_id] = 0
                active += 1
                continue
            # yield -> fall through to active/recent/stale (post-reply hang caught).
        # Throttled react (ae:7867-7892) — AFTER quiet, BEFORE active. React first
        # so the alert cadence starts immediately (before pane-hash early-continues
        # mask it). Updating prev_hash/last_hash_change here means a later recovery
        # is seen as ACTIVITY, not a stale first-time hash diff.
        if is_throttled:
            prev_streak = state.throttle_streak.get(pane_id, 0)
            if prev_streak == 0 and emit_event is not None:
                emit_event(session, _watchdog_event(
                    now, "throttled", agent, "upstream throttling detected — pausing nudges"))
            state.throttle_streak[pane_id] = prev_streak + 1
            if state.throttle_streak[pane_id] == config.throttle_alert_cycles:
                if emit_event is not None:
                    emit_event(session, _alert_event(
                        now, agent,
                        f"throttled for {config.throttle_alert_cycles * config.interval}s — may need attention"))
                tmux.display_message(
                    f"[ae watchdog] {agent} throttled persistently", duration_ms=_ALERT_DURATION_MS)
            state.prev_hash[pane_id] = h
            state.last_hash_change[pane_id] = now
            state.nudge_count[pane_id] = 0
            active += 1
            continue
        # 5. Active — pane content hash changed since last cycle (ae:7894).
        if h != state.prev_hash.get(pane_id):
            state.prev_hash[pane_id] = h
            state.last_hash_change[pane_id] = now
            state.nudge_count[pane_id] = 0
            active += 1
            continue
        # 6. Recently visible — changed within the stale window (ae:7906).
        last_change = state.last_hash_change.get(pane_id, 0)
        if last_change and now - last_change < config.stale_secs:
            active += 1
            continue
        # 7. Recently alive — recent ae event from this actor (ae:7913).
        event_age = _last_event_age(session_dir, agent, now)
        if event_age < config.stale_secs:
            active += 1
            continue
        # 8. Stale — nudge under MAX_NUDGES (ae:7921-7941).
        stale += 1
        count = state.nudge_count.get(pane_id, 0)
        stale_min = event_age // 60
        stale_display = "no recent events" if stale_min > 9999 else f"idle {stale_min}m"
        if count < config.max_nudges:
            # Paste THEN event, matching the send helper's order (ae:6468/6473).
            tmux.paste(pane_id, _nudge_text(session_dir, goal), submit=True)
            if emit_event is not None:
                emit_event(session, {
                    "ts": _now_iso(now),
                    "actor": "watchdog",
                    "action": "nudge",
                    "target": agent,
                    "summary": f"{stale_display}, no recent ae activity",
                })
            state.nudge_count[pane_id] = count + 1
        elif count == config.max_nudges:
            # Max-nudge alert (ae:7942-7947) — once; count > MAX_NUDGES is silent.
            if emit_event is not None:
                emit_event(session, _alert_event(now, agent, f"max nudges reached ({stale_display}), needs attention"))
            tmux.display_message(
                f"[ae watchdog] {agent} may need attention — stale after {config.max_nudges} nudges",
                duration_ms=_ALERT_DURATION_MS,
            )
            state.nudge_count[pane_id] = count + 1

    # 8. Missing pane check (ae:7954-7963) — registered agents whose panes are gone.
    for agent_ref in _meta_agent_refs(session_dir):
        if agent_ref not in live_agents and agent_ref not in state.alerted_missing:
            state.alerted_missing[agent_ref] = True
            if emit_event is not None:
                emit_event(session, _alert_event(now, agent_ref, "pane missing — agent no longer visible in session"))
            tmux.display_message(f"[ae watchdog] {agent_ref} pane is MISSING", duration_ms=_ALERT_DURATION_MS)

    # 9. Recover pending session IDs (ae:7966-7975) — retry the post-launch capture
    #    for codex/gemini/opencode. NO-OP when ae_path is absent or non-executable.
    #    recover_pending(session) is the injected boundary: the oracle returns the
    #    fixture rows; production shells `ae _recover-pending` and parses the TSV.
    ae_path = _meta_value(session_dir, "ae_path")
    if ae_path and os.access(ae_path, os.X_OK) and recover_pending is not None:
        for row in recover_pending(session):
            if row.get("kind") == "ok" and row.get("captured"):
                captured = row["captured"]
                if emit_event is not None:
                    emit_event(session, {
                        "ts": _now_iso(now), "actor": "human", "action": "recover",
                        "target": row.get("agent", ""), "ref": captured,
                        "summary": f"captured {row.get('tool', '')} session id ({captured[:8]})",
                    })

    # 10. Telegram bridge supervise (ae:7977-7997) — scheduler only, throttled to
    #     TG_SUPERVISE_SECS. Best-effort revive of the machine-global bridge; NO-OP
    #     when ae_path is absent/non-executable. supervise_bridge(tmux_server) is the
    #     injected boundary (oracle records telegram.supervise; production reboots the
    #     bridge with AE_TMUX_SERVER=<server>). No network / offset / send here.
    if (
        config.tg_supervise_secs > 0
        and ae_path and os.access(ae_path, os.X_OK)
        and supervise_bridge is not None
        and now - state.last_tg_supervise >= config.tg_supervise_secs
    ):
        state.last_tg_supervise = now
        supervise_bridge(_meta_value(session_dir, "tmux_server"))

    glyph = "✖" if dead else ("⚠" if stale else "●")
    _push_status(tmux, session, f"[watch {glyph} {active}/{total}]", work_dir, git=git)


class WatchdogRunner:
    """Runs one watchdog cycle per session for the daemon tick, owning the long-lived
    per-session WatchdogState + bootstrap-once — exactly ae's `_run` shape (bootstrap
    before the loop, then a cycle each pass), but for MANY sessions in one process.

    Injected into run_daemon_tick. `sessions_dir` is $AE_HOME/sessions (each session's
    meta/events live under <sessions_dir>/<name>). The boundaries are the same seams
    run_watchdog_cycle takes; the oracle binds fixture-backed ones, a later phase binds
    real tmux/ae clients."""

    def __init__(self, config, tmux, *, sessions_dir, git=default_git_runner, emit_event=None,
                 has_descendant=default_has_descendant, recover_pending=None, supervise_bridge=None):
        self.config = config
        self.tmux = tmux
        self._sessions_dir = Path(sessions_dir)
        self._git = git
        self._emit_event = emit_event
        self._has_descendant = has_descendant
        self._recover_pending = recover_pending
        self._supervise_bridge = supervise_bridge
        self._states: dict = {}
        self._bootstrapped: set = set()

    def run_cycle(self, session, now) -> None:
        name = session.name
        session_dir = self._sessions_dir / name
        if name not in self._bootstrapped:
            watchdog_bootstrap(self.tmux, name, work_dir=session.work_dir, git=self._git)
            self._bootstrapped.add(name)
        state = self._states.setdefault(name, WatchdogState())
        run_watchdog_cycle(
            self.config, state, self.tmux, name,
            work_dir=session.work_dir, session_dir=session_dir, tmux_server=session.tmux_server,
            now=now, git=self._git, emit_event=self._emit_event, has_descendant=self._has_descendant,
            recover_pending=self._recover_pending, supervise_bridge=self._supervise_bridge,
        )


# ── Runtime: per-AE_HOME singleton + heartbeat ───────────────────────────
# One supervisor per ae state root (NOT per machine): every runtime artifact
# lives under $AE_HOME/aewatch/, so isolated roots (tests, e2e) can never collide
# with a live one. Stale-lock handling belongs to the supervisor and is deferred.


class SingletonLock:
    """Non-blocking singleton via fcntl.flock on a lock file.

    acquire() returns True if this instance took the lock, False if another
    holder already has it — contention is an expected state, not an exception.
    The lock is held for the lifetime of the open fd and released on release().
    """

    def __init__(self, path: Path) -> None:
        self.path = Path(path)
        self._fd: int | None = None

    def acquire(self) -> bool:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            os.close(fd)
            # Only genuine contention means "already running". Any other flock
            # failure (e.g. ENOLCK / no-locks-available) must propagate, not
            # masquerade as a held lock and silently suppress work.
            if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK, errno.EACCES):
                return False
            raise
        self._fd = fd
        return True

    def release(self) -> None:
        if self._fd is not None:
            try:
                fcntl.flock(self._fd, fcntl.LOCK_UN)
            finally:
                os.close(self._fd)
                self._fd = None


class AewatchRuntime:
    """Resolves and owns the per-AE_HOME runtime paths under $AE_HOME/aewatch/.

    Creates a missing directory with private (0700) permissions. All aewatch
    state — lock, heartbeat, daemon log, backoff — lives here and nowhere else.
    """

    def __init__(self, ae_home) -> None:
        self.ae_home = Path(ae_home)
        self.dir = self.ae_home / "aewatch"
        self.lock_path = self.dir / "aewatch.lock"
        self.heartbeat_path = self.dir / "heartbeat"
        self.daemon_log_path = self.dir / "daemon.log"
        self.backoff_path = self.dir / "backoff.json"
        self.dir.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(self.dir, 0o700)
        except OSError:
            pass

    def singleton(self) -> SingletonLock:
        return SingletonLock(self.lock_path)

    def write_heartbeat(self) -> Path:
        """Atomically refresh the heartbeat (same-dir temp + os.replace).

        Readers never see partial content, and mtime/inode move cleanly each tick
        — the mtime IS the supervisor's freshness signal. The payload is a
        wall-clock nanosecond stamp (advisory; may not be monotonic).
        """
        self.dir.mkdir(parents=True, exist_ok=True)
        tmp = self.dir / f".heartbeat.{os.getpid()}.tmp"
        try:
            tmp.write_text(f"{time.time_ns()}\n", encoding="utf-8")
            os.replace(tmp, self.heartbeat_path)
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            raise
        return self.heartbeat_path


# ── daemon.log: size-capped rotation + secret redaction ──────────────────
# Security-critical: the daemon log must NEVER contain a raw Telegram bot token,
# a bot<TOKEN> API URL, or configured token-file contents — in the live file OR
# any rotated backup. Redaction runs on EVERY line BEFORE the byte-size / write
# decision, so a secret can never be split across a rotation boundary. Rotation
# params are constants with a per-instance test override, not config keys.
_LOG_MAX_BYTES = 1_000_000
_LOG_BACKUPS = 3


class AewatchLogger:
    """Append lines to $AE_HOME/aewatch/daemon.log with redaction + rotation."""

    def __init__(
        self,
        path,
        *,
        max_bytes: int = _LOG_MAX_BYTES,
        backups: int = _LOG_BACKUPS,
        secrets=None,
        stderr_on_error: bool = False,
        recorder=None,
    ) -> None:
        self.path = Path(path)
        self.max_bytes = max_bytes
        self.backups = backups
        self._stderr_on_error = stderr_on_error
        self._recorder = recorder
        # Redaction literals: each configured secret AND its CR/LF-stripped form,
        # empties dropped (str.replace("") would corrupt every line), longest first
        # so a longer secret wins over any of its substrings.
        literals: set[str] = set()
        for secret in secrets or []:
            for variant in (secret, secret.strip()):
                if variant:
                    literals.add(variant)
        self._literals = sorted(literals, key=len, reverse=True)

    def _redact(self, text: str) -> str:
        # Configured literal secrets first (the strong guarantee), then the shared
        # generic token redaction + fail-closed drop used by every log.write effect.
        for literal in self._literals:
            text = text.replace(literal, "<REDACTED>")
        return redact_generic(text)

    def _rotate(self) -> None:
        oldest = Path(f"{self.path}.{self.backups}")
        if oldest.exists():
            oldest.unlink()
        for i in range(self.backups - 1, 0, -1):
            src = Path(f"{self.path}.{i}")
            if src.exists():
                src.replace(Path(f"{self.path}.{i + 1}"))
        if self.path.exists():
            self.path.replace(Path(f"{self.path}.1"))

    def log(self, level: str, message: str) -> None:
        # Redact the MESSAGE (the level is a safe constant). The SAME redacted text
        # is recorded as the log.write effect payload AND written to daemon.log, so
        # no secret can reach either channel (watch item: effect payloads redacted).
        redacted = self._redact(message)
        if self._recorder is not None:
            self._recorder.record("log.write", level=level, message=redacted)
        data = f"{level} {redacted}\n".encode("utf-8")
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            if self.path.exists() and self.path.stat().st_size + len(data) > self.max_bytes:
                self._rotate()
            with self.path.open("ab") as handle:
                handle.write(data)
        except OSError as exc:
            # Best-effort: never crash the caller. In CLI mode warn with the path +
            # error ONLY — never echo the (possibly secret-bearing) log line.
            if self._stderr_on_error:
                print(f"aewatch: daemon.log write failed ({self.path}): {exc}", file=sys.stderr)


# ── Crash-loop backoff state ─────────────────────────────────────────────
# The supervisor (a later slice) restarts a dead daemon but must give up after
# too many crashes within a rolling window rather than hot-loop forever. This
# owns only the STATE; the supervisor loop and crash recording come later. Epochs
# are injected/persisted wall-clock (a monotonic clock would not survive restart).
_BACKOFF_WINDOW_SECS = 3600
_BACKOFF_BUDGET = 5


class BackoffState:
    """Rolling-window crash counter persisted to $AE_HOME/aewatch/backoff.json."""

    def __init__(self, path, *, window_secs=_BACKOFF_WINDOW_SECS, budget=_BACKOFF_BUDGET, recorder=None):
        self.path = Path(path)
        self.window_secs = window_secs
        self.budget = budget
        self._recorder = recorder

    def _warn_corrupt(self) -> None:
        if self._recorder is not None:
            self._recorder.log("WARNING", f"backoff: corrupt state at {self.path}, resetting to fresh")

    def _load(self) -> list:
        try:
            raw = self.path.read_text(encoding="utf-8")
        except FileNotFoundError:
            return []
        except OSError:
            self._warn_corrupt()
            return []
        try:
            crashes = json.loads(raw)["crashes"]
            # Valid JSON but wrong shape must degrade to fresh, not poison the count.
            if not isinstance(crashes, list) or not all(
                isinstance(c, (int, float)) and not isinstance(c, bool) for c in crashes
            ):
                raise ValueError("bad crashes schema")
        except (json.JSONDecodeError, KeyError, TypeError, ValueError):
            self._warn_corrupt()
            return []
        return [float(c) for c in crashes]

    def _prune(self, crashes: list, now) -> list:
        # A crash exactly window_secs old is still IN-window (inclusive boundary).
        return [c for c in crashes if now - c <= self.window_secs]

    def _save(self, crashes: list) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.parent / f".backoff.{os.getpid()}.tmp"
        try:
            tmp.write_text(json.dumps({"crashes": crashes}), encoding="utf-8")
            os.replace(tmp, self.path)
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            raise

    def count(self, now) -> int:
        return len(self._prune(self._load(), now))

    def record_crash(self, now) -> bool:
        """Record a crash; return True if over budget within the window ('should stop')."""
        crashes = self._prune(self._load(), now)
        crashes.append(now)
        self._save(crashes)
        over = len(crashes) > self.budget
        if over and self._recorder is not None:
            self._recorder.log(
                "ERROR",
                f"backoff: {len(crashes)} crashes within {self.window_secs}s — over budget "
                f"({self.budget}), should stop",
            )
        return over

    def record_success(self, now) -> None:
        """A healthy tick clears the crash counter."""
        self._save([])


def run_daemon_tick(runtime: "AewatchRuntime", tmux, recorder, *, now, watchdog_runner=None) -> dict:
    """Compose one daemon tick, recording every observable effect.

    acquire singleton -> parse config -> discover sessions (read-only, per-meta
    tmux_server) -> [optionally run one watchdog cycle per session via
    watchdog_runner] -> refresh heartbeat -> write daemon.log -> reset backoff.

    watchdog_runner is the injection seam: when None (the default CLI path) the tick
    is a SMOKE path that only emits file.write (heartbeat/backoff) + log.write —
    NEVER a tmux mutation, event.append, or telegram, and never mutates a session.
    When provided (tests / a later real-client phase) it runs run_watchdog_cycle for
    each discovered session, in discovery (name-sorted) order, so the full watchdog
    branch surface executes through the recorder.

    If the singleton is already held, it does NOTHING and returns acquired=False.
    Returns {acquired, sessions, config}.
    """
    lock = runtime.singleton()
    if not lock.acquire():
        return {"acquired": False, "sessions": [], "config": {}}
    try:
        config = load_config(runtime.ae_home)
        # Redact any configured Telegram token from the log (generic patterns cover
        # the rest); telegram config is not wired until phase 3, so this is usually
        # empty and harmless.
        secrets = [config.get("telegram", {}).get("token", "")]
        logger = AewatchLogger(
            runtime.daemon_log_path, secrets=secrets, recorder=recorder, stderr_on_error=True
        )
        sessions = discover_sessions(runtime.ae_home, tmux, recorder)
        logger.log(
            "INFO",
            f"tick: {len(config)} config section(s), discovered {len(sessions)} session(s)",
        )
        if watchdog_runner is not None:
            for session in sessions:  # already name-sorted by discover_sessions
                # Only LIVE sessions get a cycle. discover_sessions also returns
                # stopped session dirs (stale meta); the watchdog only exists inside a
                # live tmux session, and a real client would fail/noise trying to
                # bootstrap or set-option on a dead one (codex).
                if session.running:
                    watchdog_runner.run_cycle(session, now)
        try:
            runtime.write_heartbeat()
            recorder.record("file.write", path=str(runtime.heartbeat_path), redacted=False)
        except OSError:
            logger.log("WARNING", "heartbeat write failed")
        try:
            BackoffState(runtime.backoff_path).record_success(now)
            recorder.record("file.write", path=str(runtime.backoff_path), redacted=False)
        except OSError:
            logger.log("WARNING", "backoff reset failed")
        return {"acquired": True, "sessions": sessions, "config": config}
    finally:
        lock.release()


def cmd_daemon(args: argparse.Namespace) -> int:
    if not args.once:
        print(
            "aewatch: daemon requires --once in phase 1 (loop/supervisor mode is not implemented)",
            file=sys.stderr,
        )
        return 2
    runtime = AewatchRuntime(args.ae_home)
    # Phase 1 has no live tmux client (that lands in phase 2); discovery still reads
    # meta and reports liveness=False. Effects go to a throwaway recorder — the real
    # side effects are the heartbeat/daemon.log/backoff files themselves.
    result = run_daemon_tick(runtime, NullTmuxClient(), EffectRecorder(), now=time.time())
    if not result["acquired"]:
        print(f"aewatch: already running (lock held): {runtime.lock_path}", file=sys.stderr)
        return 3
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aewatch",
        description="Optional sidecar for ae's watchdog + telegram bridge (phase 1).",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"aewatch {__version__}",
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")

    contracts = sub.add_parser("contracts", help="contract fixture-matrix operations")
    contracts_sub = contracts.add_subparsers(
        dest="contracts_command", metavar="<subcommand>", required=True
    )
    validate = contracts_sub.add_parser("validate", help="validate CONTRACTS.md")
    validate.add_argument(
        "--contracts",
        default=None,
        help="path to CONTRACTS.md (default: alongside this script)",
    )

    daemon = sub.add_parser("daemon", help="run a supervisor tick (phase 1: --once only)")
    daemon.add_argument("--ae-home", dest="ae_home", required=True, help="ae state root ($AE_HOME)")
    daemon.add_argument("--once", action="store_true", help="run a single tick and exit")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        # No behavior wired without a subcommand; print usage and exit non-zero.
        parser.print_help(sys.stderr)
        return 2
    if args.command == "contracts":
        # contracts_command is required=True, so argparse guarantees it is set.
        if args.contracts_command == "validate":
            return cmd_contracts_validate(args)
    if args.command == "daemon":
        return cmd_daemon(args)
    parser.error(f"unknown command: {args.command}")
    return 2  # unreachable (parser.error exits), kept for type-clarity.


if __name__ == "__main__":
    raise SystemExit(main())
