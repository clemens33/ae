# ── Secret redaction (shared) ────────────────────────────────────────────
# Security-critical and CENTRAL: no Telegram bot token / bot<TOKEN> URL may reach
# daemon.log OR any log.write EFFECT payload. Every log.write effect (AewatchLogger
# AND recorder.log call sites like discovery/backoff warnings) runs through this.
# A Telegram bot token is <id>:<secret>; the secret run is consumed to the next
# '/' or whitespace, NOT the standard charset, so a non-standard secret (e.g. one
# containing '.') cannot be partially redacted and slip the tail past the detector.
# A residual match triggers a fail-closed whole-line drop. Bias to over-redact.
_TOKEN_RE = re.compile(r"\d{4,}:[^\s/]{15,}")
_BOT_URL_TOKEN_RE = re.compile(r"(bot)\d{4,}:[^\s/]+")
_RESIDUAL_TOKEN_RE = re.compile(r"\d{4,}:\S{15,}")


def redact_generic(text: str) -> str:
    """Redact Telegram tokens / bot-URL tokens from arbitrary text (no configured
    literal secrets — that context lives in AewatchLogger). The minimum every
    log.write effect payload must pass through."""
    text = _BOT_URL_TOKEN_RE.sub(r"\1<REDACTED-TOKEN>", text)
    text = _TOKEN_RE.sub("<REDACTED-TOKEN>", text)
    if _RESIDUAL_TOKEN_RE.search(text):
        return "<REDACTED-LINE: residual token pattern>"
    return text


# ── Contract fixture matrix ──────────────────────────────────────────────
# CONTRACTS.md is human-readable prose, but the machine source of truth is ONE
# JSON object between these literal markers. Prose outside the block is never
# asserted. See CONTRACTS.md and tests/aewatch_tests/test_01_contracts.py.
CONTRACTS_JSON_START = "<!-- AEWATCH_CONTRACTS_JSON_START -->"
CONTRACTS_JSON_END = "<!-- AEWATCH_CONTRACTS_JSON_END -->"

# Every future behavior family must have at least one placeholder fixture id in
# phase 1, so phase 2/3 cannot silently shrink the contract surface. The
# validator (not just the test suite) owns this coverage check.
REQUIRED_FIXTURE_FAMILIES = (
    "session.discovery",
    "watchdog.status",
    "watchdog.nudge",
    "watchdog.alert",
    "watchdog.meta",
    "watchdog.telegram-supervise",
    "telegram.outbound",
    "telegram.inbound",
    "telegram.security",
    "telegram.command-menu",
    "daemon.runtime",
)

# s20 source anchor: ae:<line> (bash impl) or aewatch:<line> (python-only behavior, e.g. the
# s19 handoff marker->kill->send which has no bash twin). Every fixture must cite >=1 so no
# expectation floats free of the implementation it is a contract for.
_SOURCE_ANCHOR_RE = re.compile(r"^(?:ae|aewatch):(\d+)(?:-(\d+))?$")

# Lowercase dotted/kebab token: dotted families + kebab leaf names, no uppercase,
# no empty segments, no doubled separators.
_FIXTURE_ID_RE = re.compile(r"^[a-z0-9]+([.-][a-z0-9]+)*$")

_FENCED_JSON_RE = re.compile(r"```json\s*\n(.*?)\n```", re.DOTALL)

_DEFAULT_CONTRACTS = Path(__file__).resolve().parent / "CONTRACTS.md"


def extract_contracts_json(text: str) -> dict:
    """Extract and parse the single marked JSON object from CONTRACTS.md text.

    Raises ValueError on missing markers, a missing fenced ```json block, invalid
    JSON, or a non-object top level. This is the ONLY contract parser — the CLI
    and the test suite both call it.
    """
    start = text.find(CONTRACTS_JSON_START)
    if start == -1:
        raise ValueError(f"contracts: start marker not found ({CONTRACTS_JSON_START})")
    end = text.find(CONTRACTS_JSON_END, start + len(CONTRACTS_JSON_START))
    if end == -1:
        raise ValueError(f"contracts: end marker not found ({CONTRACTS_JSON_END})")
    between = text[start + len(CONTRACTS_JSON_START):end]
    blocks = _FENCED_JSON_RE.findall(between)
    if not blocks:
        raise ValueError("contracts: no ```json fenced block between markers")
    if len(blocks) > 1:
        # Exactly one matrix between the markers — a duplicate/stale block must
        # fail fast rather than silently using the first (codex NIT).
        raise ValueError(
            f"contracts: expected exactly one ```json block between markers, found {len(blocks)}"
        )
    try:
        obj = json.loads(blocks[0])
    except json.JSONDecodeError as exc:
        raise ValueError(f"contracts: invalid JSON in marked block: {exc}") from exc
    if not isinstance(obj, dict):
        raise ValueError("contracts: marked JSON must be an object")
    return obj


def validate_contracts(obj: dict) -> list[str]:
    """Validate the contracts object against the phase-1 schema.

    Returns a list of human-readable error strings; an empty list means valid.
    """
    errors: list[str] = []
    if not isinstance(obj, dict):
        return ["contracts: top-level value must be an object"]
    if obj.get("schema_version") != 1:
        errors.append(f"schema_version must be 1, got {obj.get('schema_version')!r}")

    fixtures = obj.get("fixtures")
    if not isinstance(fixtures, list):
        errors.append("fixtures must be a list")
        return errors

    required_keys = ("time", "config", "sessions", "telegram", "expect")
    seen_ids: set[str] = set()
    ids: list[str] = []
    for idx, fixture in enumerate(fixtures):
        where = f"fixtures[{idx}]"
        if not isinstance(fixture, dict):
            errors.append(f"{where}: must be an object")
            continue
        fid = fixture.get("id")
        if not isinstance(fid, str) or not fid:
            errors.append(f"{where}: missing string 'id'")
        else:
            where = f"fixture {fid!r}"
            ids.append(fid)
            if not _FIXTURE_ID_RE.match(fid):
                errors.append(f"{where}: id is not a lowercase dotted/kebab token")
            if fid in seen_ids:
                errors.append(f"{where}: duplicate id")
            seen_ids.add(fid)
        for key in required_keys:
            if key not in fixture:
                errors.append(f"{where}: missing required key '{key}'")
        # Type-check the schema keys the prose already promises, so phase 2 can
        # rely on shape (a non-object `expect` must not slip past effects checks).
        for key in ("time", "config", "telegram"):
            if key in fixture and not isinstance(fixture[key], dict):
                errors.append(f"{where}: '{key}' must be an object")
        if "sessions" in fixture and not isinstance(fixture["sessions"], list):
            errors.append(f"{where}: 'sessions' must be a list")
        if "expect" in fixture:
            expect = fixture["expect"]
            if not isinstance(expect, dict):
                errors.append(f"{where}: 'expect' must be an object")
            elif "effects" not in expect:
                errors.append(f"{where}: expect.effects must be present (even if empty)")
            elif not isinstance(expect["effects"], list):
                errors.append(f"{where}: expect.effects must be a list")
            else:
                # s20: each effect entry must be a well-formed record with a KNOWN kind — an
                # unknown/malformed effect would let a fixture claim coverage the recorder can
                # never emit (codex).
                for eidx, eff in enumerate(expect["effects"]):
                    if not isinstance(eff, dict) or not isinstance(eff.get("kind"), str):
                        errors.append(f"{where}: expect.effects[{eidx}] must be an object with a string 'kind'")
                    elif eff["kind"] not in EFFECT_KINDS:
                        errors.append(f"{where}: expect.effects[{eidx}] unknown effect kind {eff['kind']!r}")
        # s20: every fixture must cite its SOURCE — a non-empty list of ae:<line> and/or
        # aewatch:<line> anchors — so no expectation is un-anchored (codex B2).
        src = fixture.get("source")
        if not isinstance(src, list) or not src:
            errors.append(f"{where}: missing 'source' — a non-empty list of ae:/aewatch: anchors")
        else:
            for a in src:
                if not (isinstance(a, str) and _SOURCE_ANCHOR_RE.match(a)):
                    errors.append(f"{where}: source anchor {a!r} is not ae:NNNN / aewatch:NNNN")
        # Optional phase-2 field: `ticks`. If present it must be a list of objects,
        # each with a numeric (non-bool) epoch — otherwise a valid-looking fixture
        # would crash the multi-tick oracle before it reaches behavior diffing.
        if "ticks" in fixture:
            ticks = fixture["ticks"]
            if not isinstance(ticks, list):
                errors.append(f"{where}: 'ticks' must be a list")
            elif not ticks:
                # An explicit empty ticks list is a bad contract (it would run zero
                # cycles / mask a fixture that meant to omit ticks). Reject it.
                errors.append(f"{where}: 'ticks' must not be empty (omit the key for a single time tick)")
            else:
                for tidx, tick in enumerate(ticks):
                    if not isinstance(tick, dict):
                        errors.append(f"{where}: ticks[{tidx}] must be an object")
                        continue
                    epoch = tick.get("epoch")
                    if not isinstance(epoch, (int, float)) or isinstance(epoch, bool):
                        errors.append(f"{where}: ticks[{tidx}] 'epoch' must be numeric")
                    # Phase-3: tick inputs are SESSION-KEYED (no first-session
                    # shortcut). events -> [{session,event}]; heartbeats/recover ->
                    # dicts keyed by session; the phase-2 singular heartbeat_age is
                    # gone; telegram (if present) is a dict (subfields land in slice 7).
                    tw = f"{where}: ticks[{tidx}]"
                    # Session refs in tick inputs must name a KNOWN fixture session —
                    # an unknown/empty key would write outside any session or silently
                    # route nowhere (codex). Build the fixture's session-name set.
                    known_sessions = {
                        s["name"] for s in fixture.get("sessions", [])
                        if isinstance(s, dict) and isinstance(s.get("name"), str) and s["name"]
                    }
                    if "heartbeat_age" in tick:
                        errors.append(f"{tw} 'heartbeat_age' is removed — use heartbeats {{session:{{age}}}}")
                    events = tick.get("events")
                    if events is not None:
                        if not isinstance(events, list):
                            errors.append(f"{tw} 'events' must be a list of {{session,event}} objects")
                        else:
                            for eidx, entry in enumerate(events):
                                if not isinstance(entry, dict):
                                    errors.append(f"{tw} events[{eidx}] must be a {{session,event}} object")
                                    continue
                                sess = entry.get("session")
                                if not isinstance(sess, str) or sess not in known_sessions:
                                    errors.append(f"{tw} events[{eidx}] session {sess!r} is not a known session")
                                if not isinstance(entry.get("event"), dict):
                                    errors.append(f"{tw} events[{eidx}] must have an 'event' object")
                    heartbeats = tick.get("heartbeats")
                    if heartbeats is not None:
                        if not isinstance(heartbeats, dict):
                            errors.append(f"{tw} 'heartbeats' must be a dict keyed by session")
                        else:
                            for sess, spec in heartbeats.items():
                                if not isinstance(sess, str) or sess not in known_sessions:
                                    errors.append(f"{tw} heartbeats key {sess!r} is not a known session")
                                age = spec.get("age") if isinstance(spec, dict) else None
                                if not isinstance(age, (int, float)) or isinstance(age, bool):
                                    errors.append(f"{tw} heartbeats[{sess!r}] must be {{age:<number>}}")
                    recover = tick.get("recover")
                    if recover is not None:
                        if not isinstance(recover, dict):
                            errors.append(f"{tw} 'recover' must be a dict keyed by session")
                        else:
                            for sess, rows in recover.items():
                                if not isinstance(sess, str) or sess not in known_sessions:
                                    errors.append(f"{tw} recover key {sess!r} is not a known session")
                                if not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows):
                                    errors.append(f"{tw} recover[{sess!r}] must be a list of row objects")
                    telegram = tick.get("telegram")
                    if telegram is not None and not isinstance(telegram, dict):
                        errors.append(f"{tw} 'telegram' must be an object")

    for family in REQUIRED_FIXTURE_FAMILIES:
        if not any(i == family or i.startswith(family + ".") for i in ids):
            errors.append(f"required fixture family {family!r} has no fixture")
    # s20 EFFECT coverage: every EFFECT_KIND must have >=1 representative in some fixture's
    # expect.effects — else the matrix could go green with empty placeholders (blind to a kind).
    represented: set = set()
    for fixture in fixtures:
        if isinstance(fixture, dict) and isinstance(fixture.get("expect"), dict):
            for eff in fixture["expect"].get("effects") or []:
                if isinstance(eff, dict) and isinstance(eff.get("kind"), str):
                    represented.add(eff["kind"])
    for kind in sorted(EFFECT_KINDS):
        if kind not in represented:
            errors.append(f"effect kind {kind!r} has no representative fixture (expect.effects)")

    # s20 NON-EFFECT assertion coverage: behaviors outside EFFECT_KINDS must be documented
    # explicitly (codex B1) — command-menu via expect.telegram_commands; the s19 bridge handoff
    # via expect.handoff_order + expect.killed_sessions (kill_session is off the effect stream).
    def _fixture_for(prefix: str):
        for fx in fixtures:
            if isinstance(fx, dict) and isinstance(fx.get("id"), str):
                if fx["id"] == prefix or fx["id"].startswith(prefix + "."):
                    return fx
        return None

    cm = _fixture_for("telegram.command-menu")
    if cm is not None and isinstance(cm.get("expect"), dict):
        tc = cm["expect"].get("telegram_commands")
        if not (isinstance(tc, list) and tc
                and all(isinstance(c, dict)
                        and isinstance(c.get("command"), str) and c["command"]
                        and isinstance(c.get("description"), str) and c["description"] for c in tc)):
            errors.append("telegram.command-menu expect.telegram_commands must be a non-empty list of "
                          "{command:<non-empty str>, description:<non-empty str>} objects")
    ho = _fixture_for("daemon.runtime.bridge-handoff")
    if ho is not None and isinstance(ho.get("expect"), dict):
        if ho["expect"].get("handoff_order") != ["bridge-owner-marker", "stop-bash", "send"]:
            errors.append("daemon.runtime.bridge-handoff expect.handoff_order must be exactly "
                          "['bridge-owner-marker', 'stop-bash', 'send'] (the s19 no-double-send order)")
        ks = ho["expect"].get("killed_sessions")
        if not (isinstance(ks, list) and all(isinstance(x, str) for x in ks) and "ae-telegram" in ks):
            errors.append("daemon.runtime.bridge-handoff expect.killed_sessions must be a list of strings "
                          "containing 'ae-telegram'")
    return errors


# A bash-daemon source anchor: `ae:<line>` or `ae:<start>-<end>`. The lead's binding
# rule — EVERY bridge fixture expectation must cite the ae:NNNN it is a contract for —
# is machine-checked here so an un-anchored bridge expectation is an automatic failure.
_BRIDGE_ANCHOR_RE = re.compile(r"^ae:(\d+)(?:-(\d+))?$")


def _valid_bridge_anchor(ref) -> bool:
    """A real 1-based bash-daemon anchor: `ae:N` or `ae:N-M` with N >= 1 and M >= N.
    Rejects impossible forms like ae:0 or ae:99-12 that still look anchored."""
    if not isinstance(ref, str):
        return False
    m = _BRIDGE_ANCHOR_RE.match(ref)
    if not m:
        return False
    start = int(m.group(1))
    end = int(m.group(2)) if m.group(2) else start
    return start >= 1 and end >= start


def validate_bridge_fixture(fixture: dict) -> list:
    """Validate one bridge fixture's expectation anchors. Returns human-readable errors
    ([] = valid). Each entry in `expect` must be an object carrying a `source` anchor —
    a single `ae:NNNN[-MMM]` string or a non-empty list of them — tying the expectation
    to the bash daemon behavior it reproduces (the fake models the API; these refs prove
    each expectation is grounded in real code, not invented)."""
    errors: list = []
    fid = fixture.get("id")
    if not isinstance(fid, str) or not fid:
        errors.append("bridge fixture: missing 'id'")
        fid = "<no-id>"
    expect = fixture.get("expect")
    if not isinstance(expect, list) or not expect:
        errors.append(f"{fid}: 'expect' must be a non-empty list of expectations")
        return errors
    for i, exp in enumerate(expect):
        where = f"{fid}.expect[{i}]"
        if not isinstance(exp, dict):
            errors.append(f"{where}: expectation must be an object")
            continue
        src = exp.get("source")
        refs = src if isinstance(src, list) else [src]
        if not src or not all(_valid_bridge_anchor(r) for r in refs):
            errors.append(f"{where}: missing/invalid ae:NNNN source anchor (got {src!r})")
    return errors


def cmd_contracts_validate(args: argparse.Namespace) -> int:
    path = Path(args.contracts) if args.contracts else _DEFAULT_CONTRACTS
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"aewatch: cannot read contracts {path}: {exc}", file=sys.stderr)
        return 2
    try:
        obj = extract_contracts_json(text)
    except ValueError as exc:
        print(f"aewatch: {exc}", file=sys.stderr)
        return 1
    errors = validate_contracts(obj)
    if errors:
        for err in errors:
            print(f"aewatch: contract error: {err}", file=sys.stderr)
        return 1
    print(f"aewatch: contracts OK ({len(obj['fixtures'])} fixtures) — {path}")
    return 0


# ── Effect model (the parity oracle schema) ──────────────────────────────
# Every OBSERVABLE side effect — and nothing else — is normalized into one of
# these record shapes. Reads (list_sessions/list_panes/capture_pane/
# display_option) are NOT observable and record no effect. This schema is the
# single source of truth: the phase-2 real subprocess TmuxClient and the bash
# fake_tmux shim must emit byte-identical records, so the dual-run diff oracle
# has one format. The RECORDER preserves order (paste/submit/nudge sequencing
# matters); canonical_effects() is a deterministic *presentation* sort only —
# never the primary comparison, and it never collapses duplicates.
EFFECT_KINDS = frozenset(
    {
        "event.append",     # append a record to a session's events.jsonl
        "tmux.paste",        # paste (optionally submit) text into a pane
        "tmux.set_option",   # set a tmux option on a target (session or pane)
        "tmux.unset_option", # unset a tmux option on a target
        "tmux.display_message",  # user-visible `tmux display-message -d <ms> <text>` alert
        "telegram.send",     # outbound Telegram message
        "telegram.supervise",  # best-effort bridge-revive ATTEMPT (scheduler; NOT a send)
        "file.write",        # write an aewatch-owned runtime file ($AE_HOME/aewatch/*)
        "log.write",         # emit a daemon.log line
    }
)


def make_effect(kind: str, **fields: object) -> dict:
    """Build one normalized, JSON-serializable effect record.

    Raises ValueError for any kind outside the observable surface (EFFECT_KINDS).
    """
    if kind not in EFFECT_KINDS:
        raise ValueError(f"unknown effect kind: {kind!r}")
    return {"kind": kind, **fields}


def canonical_effects(effects: list[dict]) -> list[dict]:
    """Deterministic presentation ordering for effect lists.

    Order-independent and stable, but DUPLICATE-PRESERVING — it is a summary
    helper, not the oracle. Sequence-sensitive comparisons use the recorder's
    ordered list (EffectRecorder.as_list()).
    """
    return sorted(effects, key=lambda e: json.dumps(e, sort_keys=True))


class EffectRecorder:
    """Ordered, duplicate-preserving sink for normalized effects.

    as_list() is the first-class oracle: it keeps insertion order and repeated
    identical records as distinct entries.
    """

    def __init__(self) -> None:
        self._effects: list[dict] = []

    def record(self, kind: str, **fields: object) -> dict:
        # Central guarantee: EVERY log.write effect payload is generic-redacted,
        # regardless of caller (discovery/backoff warnings, AewatchLogger, ...).
        # A message already redacted by AewatchLogger passes through unchanged.
        if kind == "log.write" and isinstance(fields.get("message"), str):
            fields["message"] = redact_generic(fields["message"])
        effect = make_effect(kind, **fields)
        self._effects.append(effect)
        return effect

    def log(self, level: str, message: str) -> dict:
        return self.record("log.write", level=level, message=message)

    def as_list(self) -> list[dict]:
        return list(self._effects)


class TmuxClient(abc.ABC):
    """Interface both the fake (tests) and the real subprocess client implement.

    READ methods return data and record NO effect. MUTATION methods each append
    exactly one normalized effect via the client's recorder. `target` is the raw
    tmux target string — a session name, window, or pane id — never pane-only.
    """

    @abc.abstractmethod
    def list_sessions(self, server: str | None = None) -> list[str]: ...

    @abc.abstractmethod
    def list_panes(self, session: str, server: str | None = None) -> list: ...

    @abc.abstractmethod
    def capture_pane(self, pane_id: str, server: str | None = None) -> str: ...

    @abc.abstractmethod
    def display_option(self, target: str, option: str, server: str | None = None) -> str | None: ...

    @abc.abstractmethod
    def set_option(self, target: str, option: str, value: str, server: str | None = None) -> None: ...

    @abc.abstractmethod
    def unset_option(self, target: str, option: str, server: str | None = None) -> None: ...

    @abc.abstractmethod
    def paste(self, target: str, text: str, submit: bool, server: str | None = None) -> None: ...

    @abc.abstractmethod
    def display_message(self, text: str, *, duration_ms: int | None = None, server: str | None = None) -> None: ...

    @abc.abstractmethod
    def kill_session(self, session: str, server: str | None = None) -> None: ...


class NullTmuxClient(TmuxClient):
    """Phase-1 placeholder: no live tmux. Reads return empty (discovery still works
    off meta, liveness=False); mutations RAISE so phase 1 can never accidentally
    grow a tmux write."""

    def list_sessions(self, server=None):
        return []

    def list_panes(self, session, server=None):
        return []

    def capture_pane(self, pane_id, server=None):
        return ""

    def display_option(self, target, option, server=None):
        return None

    def set_option(self, target, option, value, server=None):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def unset_option(self, target, option, server=None):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def paste(self, target, text, submit, server=None):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def display_message(self, text, *, duration_ms=None, server=None):
        raise NotImplementedError("phase 1 must not mutate tmux")

    def kill_session(self, session, server=None):
        raise NotImplementedError("phase 1 must not mutate tmux")


@dataclasses.dataclass
class Pane:
    """A tmux pane as the watchdog cycle consumes it — duck-typed on pane_id / agent /
    current_command / pane_pid. `capture` is filled SEPARATELY via capture_pane (not
    from the list-panes `-F` row), so RealTmuxClient leaves it empty. This is the one
    production pane type; the test harness aliases it so both sides stay in lockstep."""

    pane_id: str
    agent: str = ""
    current_command: str = ""
    capture: str = ""
    pane_pid: str = ""


# The watchdog's per-session pane enumeration format (ae:7952) — pipe-delimited so a
# tab inside a value can never split a field, matching bash `IFS='|' read`.
_PANE_LIST_FORMAT = "#{pane_id}|#{@ae_agent}|#{pane_current_command}|#{pane_pid}"

# The staged-paste token Claude shows for a large paste (ae:147); its presence in the
# last 15 captured lines means the paste needs one extra Enter to submit.
_PASTED_TEXT_RE = re.compile(r"\[Pasted text #[0-9]+ \+[0-9]+ lines\]")


class RealTmuxClient(TmuxClient):
    """Subprocess-backed TmuxClient for the live daemon (slice 16-17).

    Slice 3 = the READ half. Every read shells a real `tmux`, and swallows a nonzero
    exit / spawn failure / timeout into []/""/None — mirroring the bash watchdog's
    `2>/dev/null || true`, so a stopped or absent session degrades instead of raising.
    Reads record NO effect. MUTATION methods land in slice 4.

    Server model: aewatch is a SINGLETON reaching sessions on their per-meta
    `tmux_server`, so every read takes an optional `server` — None (ambient) and ""
    (a meta's default) both mean the default server (no `-L`); a named server prefixes
    `-L <server>`."""

    def __init__(self, recorder, *, tmux_bin: str = "tmux", timeout: int = 2, sleep=None):
        self._rec = recorder
        self._tmux_bin = tmux_bin
        self._timeout = timeout
        if sleep is None:
            import time

            sleep = time.sleep
        # Injected so the paste readiness pauses (ae's 0.1/0.2 sleeps) never wait in tests.
        self._sleep = sleep

    @staticmethod
    def _server_args(server) -> list:
        # None (ambient) and "" (a meta's default tmux_server) -> the SAME default
        # server. Only a truthy name adds `-L <server>`.
        return [] if not server else ["-L", server]

    def _run(self, args) -> tuple:
        """Run `tmux <args>`; return (returncode, stdout). Spawn failure / timeout ->
        (1, '') so every read degrades to its empty value instead of propagating."""
        import subprocess

        try:
            proc = subprocess.run(
                [self._tmux_bin, *args],
                capture_output=True,
                text=True,
                timeout=self._timeout,
            )
            return proc.returncode, proc.stdout
        except (OSError, subprocess.SubprocessError):
            return 1, ""

    # ── reads: return data, record nothing ──────────────────────────────
    def list_sessions(self, server=None):
        rc, out = self._run([*self._server_args(server), "list-sessions", "-F", "#{session_name}"])
        if rc != 0:
            return []
        return [ln for ln in out.split("\n") if ln.strip()]

    def list_panes(self, session, server=None):
        rc, out = self._run(
            [*self._server_args(server), "list-panes", "-s", "-t", session, "-F", _PANE_LIST_FORMAT]
        )
        if rc != 0:
            return []
        panes = []
        for line in out.split("\n"):
            if not line.strip():
                continue
            # bash `IFS='|' read -r pane agent proc pane_pid_val`: the LAST field
            # absorbs any extra pipes; a short row leaves later vars empty.
            parts = line.split("|", 3)
            parts += [""] * (4 - len(parts))
            panes.append(Pane(pane_id=parts[0], agent=parts[1], current_command=parts[2], pane_pid=parts[3]))
        return panes

    def capture_pane(self, pane_id, server=None):
        rc, out = self._run(
            [*self._server_args(server), "capture-pane", "-p", "-J", "-S", "-40", "-E", "-", "-t", pane_id]
        )
        return out if rc == 0 else ""

    def display_option(self, target, option, server=None):
        rc, out = self._run([*self._server_args(server), "show-options", "-t", target, "-qv", option])
        if rc != 0:
            return None
        # `-qv` prints the value + newline (or nothing when unset); `$(...)` in bash
        # strips the trailing newline. Empty (unset or set-empty) -> None.
        out = out.strip()
        return out or None

    # ── mutations: run the tmux write, then record exactly one effect ───
    def _run_write(self, args) -> str:
        """A mutation subprocess. A nonzero exit / spawn failure / timeout RAISES
        (loud) — unlike bash's `2>/dev/null || true`, a long-lived daemon must know a
        write failed rather than record a phantom effect. Returns stdout on success."""
        rc, out = self._run(args)
        if rc != 0:
            raise RuntimeError(f"tmux write failed (rc={rc}): {args}")
        return out

    def _pane_command(self, target, server=None) -> str:
        """The pane's foreground command (ae:157) — drives the paste dialect. A read:
        degrades to '' on failure, so paste falls back to the plain (non-codex) path."""
        rc, out = self._run(
            [*self._server_args(server), "display-message", "-p", "-t", target, "#{pane_current_command}"]
        )
        return out.strip() if rc == 0 else ""

    def set_option(self, target, option, value, server=None):
        self._run_write([*self._server_args(server), "set-option", "-t", target, option, value])
        self._rec.record("tmux.set_option", target=target, option=option, value=value)

    def unset_option(self, target, option, server=None):
        self._run_write([*self._server_args(server), "set-option", "-t", target, "-u", option])
        self._rec.record("tmux.unset_option", target=target, option=option)

    def display_message(self, text, *, duration_ms=None, server=None):
        args = [*self._server_args(server), "display-message"]
        if duration_ms is not None:
            args += ["-d", str(duration_ms)]
        args.append(text)
        self._run_write(args)
        self._rec.record("tmux.display_message", text=text, duration_ms=duration_ms)

    def kill_session(self, session, server=None):
        # Tolerant (like bash's `kill-session ... 2>/dev/null || true`): a bridge that
        # isn't running is fine. Records NO effect — a daemon-lifecycle handoff, not a
        # watchdog-cycle mutation, so it never enters the dual-run oracle stream.
        self._run([*self._server_args(server), "kill-session", "-t", session])

    def paste(self, target, text, submit, server=None):
        """Port of tmux_paste_submit (ae:120-151). Stage via set-buffer+paste-buffer
        (bracketed `-p` for codex), then submit with Enter and — for claude — one
        bounded readiness retry when the staged-paste token is in the last 15 lines.
        Every internal tmux process carries the SAME server args. Records ONE
        tmux.paste effect only after the full logical mutation succeeds."""
        sa = self._server_args(server)
        cmd = self._pane_command(target, server)
        buf = f"ae-ps-{os.getpid()}-{target}"
        bracketed = ["-p"] if cmd == "codex" else []
        self._run_write(
            [*sa, "set-buffer", "-b", buf, "--", text, ";", "paste-buffer", "-d", *bracketed, "-b", buf, "-t", target]
        )
        if submit:
            self._sleep(0.1)
            self._run_write([*sa, "send-keys", "-t", target, "Enter"])
            if cmd == "claude":
                self._sleep(0.2)
                rc, out = self._run([*sa, "capture-pane", "-p", "-t", target])
                if rc == 0 and _PASTED_TEXT_RE.search("\n".join(out.splitlines()[-15:])):
                    self._run_write([*sa, "send-keys", "-t", target, "Enter"])
        self._rec.record("tmux.paste", target=target, text=text, submit=submit)


_TELEGRAM_TRUTHY = frozenset({"1", "true", "yes", "on"})  # ae:3001-3006
_TG_INCLUDE_DEFAULT = "send,ask,review,reply,done,alert,throttled,chat"  # ae:3135


def _telegram_enabled(value) -> bool:
    return isinstance(value, str) and value.strip().lower() in _TELEGRAM_TRUTHY


@dataclasses.dataclass
class TelegramConfig:
    """The validated [telegram] config. A DISABLED config (enabled=False) carries a
    leak-free `disabled_reason` and NO token — non-secret required config is checked
    before the token file is ever opened, so a disabled config never reads or retains
    the secret. `secrets` feeds AewatchLogger so the token is redacted in logs even when
    it isn't a <id>:<secret>-shaped generic match."""

    enabled: bool = False
    token: str = ""
    chat_id: str = ""
    allowed_user_ids: str = ""
    include: str = _TG_INCLUDE_DEFAULT
    exclude: str = ""
    disabled_reason: str = ""

    @property
    def secrets(self) -> list:
        return [self.token] if self.token else []


def load_telegram_config(config, *, geteuid=None, stat_fn=None) -> "TelegramConfig":
    """Load + validate the [telegram] block (ae:3154-3198 read_config + load_runtime_config).
    Returns a DISABLED config with a leak-free reason on any failure. Order matters: the
    NON-SECRET required config (enabled, token_file, chat_id presence) is validated BEFORE
    the token file is opened, so a missing-chat_id config never touches the secret (codex).
    BEYOND ae's readable-only check (ae:3187), the token file must be a REGULAR file OWNED
    by the running user with mode EXACTLY 400 or 600 — a secret must never be group/world
    readable. Token strip mirrors ae (ae:3189-3190): ONE trailing newline, then all CRs."""
    import os as _os
    import stat as _stat

    geteuid = geteuid or _os.geteuid
    stat_fn = stat_fn or _os.stat
    tg = config.get("telegram", {}) if isinstance(config, dict) else {}

    def disabled(reason):
        return TelegramConfig(enabled=False, disabled_reason=reason)

    if not _telegram_enabled(tg.get("enabled", "")):
        return disabled("telegram not enabled")
    token_file = tg.get("token_file", "")
    if not token_file:
        return disabled("missing telegram.token_file")
    chat_id = tg.get("chat_id", "")
    if not chat_id:  # checked BEFORE the token file is ever touched
        return disabled("missing telegram.chat_id")  # ae:3192-3193
    path = _os.path.expanduser(token_file)  # ae:3186
    try:
        st = stat_fn(path)
    except OSError:
        return disabled(f"token file not readable: {path}")
    if not _stat.S_ISREG(st.st_mode):
        return disabled(f"token file is not a regular file: {path}")
    if st.st_uid != geteuid():
        return disabled(f"token file owner mismatch (not the running user): {path}")
    if (st.st_mode & 0o777) not in (0o400, 0o600):
        return disabled(f"token file mode {oct(st.st_mode & 0o777)} not 400/600: {path}")
    try:
        raw = Path(path).read_text(encoding="utf-8")
    except OSError:
        return disabled(f"token file not readable: {path}")
    token = (raw[:-1] if raw.endswith("\n") else raw).replace("\r", "")  # ae:3189-3190
    if not token:
        return disabled("token file is empty")
    return TelegramConfig(enabled=True, token=token, chat_id=chat_id,
                          allowed_user_ids=tg.get("allowed_user_ids", ""),  # ae:3196
                          include=tg.get("include", _TG_INCLUDE_DEFAULT), exclude=tg.get("exclude", ""))  # ae:3194-3195


class TelegramTransport(abc.ABC):
    """The one Telegram Bot API seam — FakeTelegramTransport (bridge tests) and the s9
    RealTelegramTransport (urllib) both implement it. Methods return the RAW parsed API
    response dict ({"ok": bool, ...}) so bridge slices can test ok=false / error_code /
    retry_after without a lossy typed wrapper (mirrors ae's jq-facing shape)."""

    @abc.abstractmethod
    def get_updates(self, offset: int, *, timeout: int = 0, limit: int = 10, allowed_updates=("message",)) -> dict:
        """getUpdates (ae:3745-3799): {"ok": true, "result": [update, ...]} for update_id
        at/above the acknowledged offset. The caller persists offset+1 BEFORE dispatch
        (ae:3368-3372) for at-most-once."""
        ...

    @abc.abstractmethod
    def send_message(self, chat_id, text) -> dict:
        """sendMessage (ae:3274-3304): {"ok": true, "result": {...}} or {"ok": false,
        "error_code": N, ..., "parameters": {"retry_after": N}} on 429."""
        ...

    @abc.abstractmethod
    def set_my_commands(self, commands) -> dict:
        """setMyCommands (ae:3310-3352): {"ok": true, "result": true}."""
        ...


def _json_object_or_none(raw):
    """Parse `raw` as a JSON OBJECT. A non-object (`[]`, `true`, a bare string) or a
    parse error -> None, so a malformed body never reaches bridge code that does .get."""
    try:
        parsed = json.loads(raw)
    except (ValueError, TypeError):
        return None
    return parsed if isinstance(parsed, dict) else None


class RealTelegramTransport(TelegramTransport):
    """The urllib impl of TelegramTransport (FakeTelegramTransport is the other). NEVER
    raises: any HTTP / transport / decode failure degrades to a synthetic {"ok": False}
    so the bridge loop decides retry/sleep instead of crashing. The URL embeds
    bot<token>, so every error is logged through `logger` (an AewatchLogger with
    secrets=[token]) — the redacted URL names the failing endpoint without leaking the
    secret. The ABC `timeout` is Telegram's long-poll parameter; the urllib SOCKET
    timeout is implementation policy that must OUTLAST it."""

    def __init__(self, token, *, urlopen=None, timeout=30, long_poll_margin=10, logger=None,
                 base_url="https://api.telegram.org"):
        import urllib.request

        self._token = token
        self._urlopen = urlopen or urllib.request.urlopen
        self._timeout = timeout
        self._long_poll_margin = long_poll_margin
        self._logger = logger
        self._base = base_url

    def _log(self, message):
        if self._logger is not None:
            self._logger.log("WARNING", message)  # AewatchLogger scrubs the token / URL

    def _call(self, method, params, *, socket_timeout):
        import socket
        import urllib.error
        import urllib.parse
        import urllib.request

        url = f"{self._base}/bot{self._token}/{method}"
        data = urllib.parse.urlencode(params).encode("utf-8")
        req = urllib.request.Request(url, data=data, method="POST")
        try:
            with self._urlopen(req, timeout=socket_timeout) as resp:
                body = resp.read().decode("utf-8")
        except urllib.error.HTTPError as exc:
            # Telegram returns a JSON body even on 4xx/5xx (ok=false + error_code +
            # parameters.retry_after) — return it so s13 can retry correctly.
            self._log(f"{url} HTTP {exc.code}")
            try:
                raw = exc.read().decode("utf-8")
            except (OSError, ValueError):
                raw = ""
            parsed = _json_object_or_none(raw)
            return parsed if parsed is not None else {"ok": False, "error_code": exc.code, "description": "http error"}
        except (urllib.error.URLError, socket.timeout, TimeoutError, OSError) as exc:
            self._log(f"{url} transport error: {exc}")
            return {"ok": False, "error_code": None, "description": "transport error"}
        parsed = _json_object_or_none(body)
        if parsed is None:
            self._log(f"{url} response was not a JSON object")
            return {"ok": False, "error_code": None, "description": "invalid JSON response"}
        return parsed

    def _socket_timeout(self, api_timeout):
        # The socket must outlast a long poll: Telegram holds the request up to
        # `api_timeout` s, so the deadline is at least api_timeout + margin, floored at
        # the quick-call request timeout.
        return max(self._timeout, api_timeout + self._long_poll_margin)

    def get_updates(self, offset, *, timeout=0, limit=10, allowed_updates=("message",)):
        params = {
            "offset": offset,  # thin passthrough — the bridge owns stored offset + 1
            "limit": limit,
            "timeout": timeout,
            "allowed_updates": json.dumps(list(allowed_updates), separators=(",", ":")),
        }
        return self._call("getUpdates", params, socket_timeout=self._socket_timeout(timeout))

    def send_message(self, chat_id, text):
        return self._call("sendMessage", {"chat_id": chat_id, "text": text}, socket_timeout=self._timeout)

    def set_my_commands(self, commands):
        return self._call("setMyCommands", {"commands": json.dumps(commands, separators=(",", ":"))},
                          socket_timeout=self._timeout)


class OffsetStore:
    """Durable getUpdates offset (ae:3356-3372). load() validates numeric-or-0; save() is
    atomic (tmp + rename) and returns False on failure so the caller can stop before
    dispatch — at-most-once depends on the offset being persisted first."""

    def __init__(self, path):
        self._path = Path(path)

    def load(self) -> int:
        try:
            raw = self._path.read_text(encoding="utf-8").strip()
        except OSError:
            return 0
        return int(raw) if raw.isdigit() else 0

    def save(self, value) -> bool:
        import os as _os

        tmp = Path(f"{self._path}.tmp.{_os.getpid()}")
        try:
            tmp.write_text(f"{int(value)}\n", encoding="utf-8")
            _os.replace(tmp, self._path)
            return True
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            return False


def inbound_enabled(config) -> bool:
    """Inbound commands are enabled only with at least one allow-listed id — otherwise the
    bridge stays outbound-only (ae:3203-3205)."""
    return bool(re.sub(r"[,\s]", "", config.allowed_user_ids or ""))


def _allowed_ids(config) -> set:
    return {t for t in re.split(r"[,\s]+", (config.allowed_user_ids or "").strip()) if t}


def update_authorized(from_id, chat_id, chat_type, config) -> bool:
    """Authorize an inbound update — ALL must hold (ae:3210-3230): numeric sender, PRIVATE
    chat, EXACT control chat_id, allow-listed sender. Confines command execution to the
    intended 1:1 channel; a group / accidental-add cannot drive ae."""
    from_id = str(from_id)
    if not from_id.isdigit():
        return False
    if chat_type != "private":
        return False
    if str(chat_id) != str(config.chat_id):
        return False
    return from_id in _allowed_ids(config)


def poll_inbound(transport, offset_store, config, *, dispatch, logger=None, timeout=0, limit=10):
    """One inbound getUpdates cycle (ae:3745-3799). Persists the offset BEFORE dispatch
    (at-most-once, ae:3770-3775), drops non-text + unauthorized updates, and hands
    authorized text to `dispatch`. A dispatch error is logged (redacted) and the batch
    CONTINUES — ae runs tg_handle_command best-effort, so one bad command must not drop
    the rest of the batch. offset-before-dispatch gives at-most-once regardless."""

    def _log(msg):
        if logger is not None:
            logger.log("WARNING", msg)

    if not inbound_enabled(config):  # ae:3746
        return
    offset = offset_store.load()
    resp = transport.get_updates(offset + 1, timeout=timeout, limit=limit)  # stored+1, ae:3748-3749
    if not resp.get("ok"):
        _log("getUpdates not ok")  # ae:3760-3761
        return
    result = resp.get("result")
    if not isinstance(result, list):  # a real transport returns a raw dict — never iterate a str/dict
        _log("getUpdates result missing or not a list")
        return
    for update in result:
        uid = update.get("update_id")
        if not isinstance(uid, int) or isinstance(uid, bool):  # ae:3769
            continue
        if not offset_store.save(uid):  # persist BEFORE dispatch (ae:3772-3775)
            _log("offset persist failed — skipping inbound dispatch until it recovers")
            return
        message = update.get("message") or {}
        from_id = str((message.get("from") or {}).get("id", ""))
        chat = message.get("chat") or {}
        chat_id = str(chat.get("id", ""))
        chat_type = chat.get("type", "")
        text = message.get("text", "")
        if not text:  # ae:3780
            continue
        if not update_authorized(from_id, chat_id, chat_type, config):  # ae:3781-3784 (no secret)
            _log(f"dropped unauthorized update (from={from_id} chat={chat_id} type={chat_type})")
            continue
        try:
            dispatch(from_id, text, update)
        except Exception as exc:  # best-effort per-command (ae): log + continue the batch
            # str(exc) may carry secret-bearing text; the logger redacts it.
            _log(f"inbound dispatch error: {type(exc).__name__}: {exc}")


@dataclasses.dataclass
class Resolution:
    """The outcome of resolving a chat session/agent ref (maps to ae's rc 0/1/2). `value`
    is the resolved DiscoveredSession or the canonical alias:name; s11b maps `status` to
    the user-facing chat message."""

    status: str            # "ok" | "none" | "ambiguous"
    value: object = None

    @property
    def ok(self) -> bool:
        return self.status == "ok"


def resolve_session_ref(sessions, ref) -> "Resolution":
    """Resolve a chat session ref against RUNNING sessions (ae:3387-3417). EXACT name wins;
    else a UNIQUE non-empty session_id PREFIX. An empty ref resolves to nothing."""
    ref = (ref or "").strip()
    if not ref:
        return Resolution("none")
    running = [s for s in sessions if s.running]
    for s in running:
        if s.name == ref:                       # exact name beats any prefix (ae:3397-3406)
            return Resolution("ok", s)
    prefix = [s for s in running if s.session_id and s.session_id.startswith(ref)]  # ae:3400
    if len(prefix) == 1:
        return Resolution("ok", prefix[0])
    return Resolution("ambiguous" if len(prefix) > 1 else "none")


def resolve_agent_in_session(agents, want) -> "Resolution":
    """Resolve a chat agent ref against a session's actual agents (ae:3428-3450). EXACT
    alias:name wins; else a UNIQUE bare name. Returns the CANONICAL alias:name. A %pane /
    @session:agent / telegram:<id> / foreign-prefix ref matches no real agent.* entry ->
    none (the confinement, codex BLOCKER in ae)."""
    want = (want or "").strip()
    if not want:
        return Resolution("none")
    # Explicit confinement guard (codex): a %pane-id, an @session ref, or a multi-colon
    # escape (e.g. codex:lead:extra) can never be a legitimate alias:name or bare name.
    # Reject up front so a future meta change can't let one slip through implicit
    # non-match. A legitimate want is a bare name (0 colons) or alias:name (1 colon).
    if "%" in want or "@" in want or want.count(":") > 1:
        return Resolution("none")
    exact = None
    bare = []
    for a in agents:
        ref = a.ref
        if ref.count(":") != 1:                 # a canonical agent ref is exactly alias:name
            continue
        alias, name = ref.split(":", 1)
        if not alias or not name:
            continue
        if want == ref:
            exact = ref
            break
        if want == name:
            bare.append(ref)
    if exact is not None:
        return Resolution("ok", exact)
    if len(bare) == 1:
        return Resolution("ok", bare[0])
    return Resolution("ambiguous" if len(bare) > 1 else "none")


_DISPATCH_VERBS = frozenset({"send", "ask"})  # a chat command may only send/ask (ae:3532-3535)


@dataclasses.dataclass
class DispatchResult:
    """Outcome of routing a chat command to a session agent. `status` maps to a s11c chat
    message; delivery carries the resolved session/agent/verb for that message."""

    status: str   # delivered|failed|no_session|ambiguous_session|no_agent|ambiguous_agent|no_helper|bad_verb
    session: str = ""
    agent: str = ""
    verb: str = ""


def deliver_to_agent(session, verb, agent_ref, msg, *, from_id, ae_home, timeout=10) -> "DispatchResult":
    """Execute a chat command by running the session's OWN <verb> helper under the
    external-actor identity (ae:3572-3583) — never raw tmux, so ask-tracking + event
    emission stay identical. DEFENSE-IN-DEPTH at the execution boundary: only send/ask are
    runnable (a chat command must never invoke state/retire/etc); only the CANONICAL
    alias:name reaches the helper; the message is a POSITIONAL arg (no eval / no shell)."""
    if verb not in _DISPATCH_VERBS:
        return DispatchResult("bad_verb", session=session.name, verb=verb)
    ar = resolve_agent_in_session(session.agents, agent_ref)
    if not ar.ok:
        return DispatchResult("ambiguous_agent" if ar.status == "ambiguous" else "no_agent",
                              session=session.name, verb=verb)
    canon = ar.value
    helper = Path(ae_home) / "sessions" / session.name / verb
    if not os.access(helper, os.X_OK):
        return DispatchResult("no_helper", session=session.name, agent=canon, verb=verb)
    import subprocess

    env = dict(os.environ, AE_SENDER_OVERRIDE=f"telegram:{from_id}")
    try:
        proc = subprocess.run([str(helper), canon, msg], env=env, capture_output=True, text=True, timeout=timeout)
        status = "delivered" if proc.returncode == 0 else "failed"
    except (OSError, subprocess.SubprocessError):
        status = "failed"
    return DispatchResult(status, session=session.name, agent=canon, verb=verb)


def tg_dispatch(sessions, session_ref, verb, agent_ref, msg, *, from_id, ae_home, timeout=10) -> "DispatchResult":
    """Resolve the session ref (s11a) then deliver (ae:3545-3558). Structured result only;
    s11c maps status -> the chat message."""
    sr = resolve_session_ref(sessions, session_ref)
    if not sr.ok:
        return DispatchResult("ambiguous_session" if sr.status == "ambiguous" else "no_session")
    return deliver_to_agent(sr.value, verb, agent_ref, msg, from_id=from_id, ae_home=ae_home, timeout=timeout)


class CurrentTarget:
    """The sticky /use target — a single machine-global "<session>\\t<agent>" for the one
    control chat (ae:3618), stored owner-only. Re-validated on every send, so a stopped
    session just errors rather than misrouting."""

    def __init__(self, path):
        self._path = Path(path)

    def load(self):
        try:
            raw = self._path.read_text(encoding="utf-8").strip()
        except OSError:
            return None
        if "\t" not in raw:
            return None
        session, agent = raw.split("\t", 1)
        return (session, agent) if session and agent else None

    def save(self, session, agent) -> bool:
        import os as _os

        tmp = Path(f"{self._path}.tmp.{_os.getpid()}")
        try:
            fd = _os.open(str(tmp), _os.O_WRONLY | _os.O_CREAT | _os.O_TRUNC, 0o600)  # umask-077 equiv
            with _os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write(f"{session}\t{agent}\n")
            _os.replace(tmp, self._path)
            return True
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            return False

    def clear(self):
        try:
            self._path.unlink()
        except OSError:
            pass


def _session_main_ref(session) -> str:
    for a in session.agents:
        if a.slot == "main":
            return a.ref
    return ""


def find_orchestrator(sessions, ae_home):
    """The running orchestrator (meta-agent) for auto-default routing (ae:3717-3746): a running
    session with meta_agent=true in its meta. Prefer canonical 'orchestrator', then legacy
    'hub', then any other running meta-agent. Returns (session_name, main_agent_ref) or None."""
    hub = other = None
    for s in sessions:
        if not s.running:
            continue
        if _meta_value(Path(ae_home) / "sessions" / s.name, "meta_agent") != "true":
            continue
        main = _session_main_ref(s)
        if not main:
            continue
        if s.name == "orchestrator":
            return (s.name, main)
        if s.name == "hub":
            if hub is None:
                hub = (s.name, main)
        elif other is None:
            other = (s.name, main)
    return hub or other


_HELP_TEXT = (
    "ae telegram:\n"
    "• Plain text → your orchestrator (auto-default; just talk to it).\n"
    "• Reply to any forwarded message → answers that agent (no command).\n"
    "• @session:agent <msg> → send to an agent directly.\n"
    "• /use <session> <agent> → redirect plain messages elsewhere; /use clear → back to the orchestrator.\n"
    "/list\n"
    "/session <name|id-prefix> send|ask <agent> <msg>"
)


def _list_sessions(sessions) -> str:
    running = [s for s in sessions if s.running]
    if not running:
        return "(no running sessions)"
    return "Running sessions:\n" + "\n".join(f"• {s.name}  [{s.session_id[:8]}]" for s in running)


def _parse_reply_target(rtext):
    """Parse a forwarded event's header line (ae:3591-3600): '[<session>] <action>  <actor>'
    -> (session, actor). A misparse returns None so the caller FAILS SAFE (guidance),
    never a blind dispatch."""
    first = rtext.split("\n", 1)[0]
    if not (first.startswith("[") and "] " in first):
        return None
    session = first[1:].split("]", 1)[0]
    rest = first.split("] ", 1)[1]
    tokens = rest.split()
    if len(tokens) < 2 or not session:
        return None
    return (session, tokens[1])


def _dispatch_message(result, session_ref, agent_ref) -> str:
    """Map a DispatchResult status to the user-facing chat line (ae:3553/3554/3567/3568/
    3574/3580/3582)."""
    s = result.status
    if s == "delivered":
        return f"→ {result.verb} delivered to {result.agent} in {result.session}"
    if s == "failed":
        return f"Failed to {result.verb} {result.agent} in {result.session}"
    if s == "no_session":
        return f"No running session matching '{session_ref}'"
    if s == "ambiguous_session":
        return f"Ambiguous session '{session_ref}' — be more specific"
    if s == "no_agent":
        return f"No agent '{agent_ref}' in session {result.session}"
    if s == "ambiguous_agent":
        return f"Ambiguous agent '{agent_ref}' in {result.session} — use alias:name"
    if s == "no_helper":
        return f"Session '{result.session}' has no '{result.verb}' helper"
    if s == "bad_verb":
        return f"Unknown verb '{result.verb}' (use send or ask)"
    return "Command failed"


def _deliver_and_report(from_id, session_ref, verb, agent_ref, msg, *, sessions, ae_home, reply, timeout):
    result = tg_dispatch(sessions, session_ref, verb, agent_ref, msg, from_id=from_id, ae_home=ae_home, timeout=timeout)
    reply(_dispatch_message(result, session_ref, agent_ref))


def _route_at(from_id, stripped, *, sessions, ae_home, reply, timeout):
    parts = stripped.split(None, 1)
    spec = parts[0][1:]  # drop the leading '@'
    msg = parts[1] if len(parts) > 1 else ""
    if ":" not in spec:
        reply("Usage: @session:agent <msg>  (e.g. @mdk:claude:lead do X)")
        return
    session, agent = spec.split(":", 1)  # session up to first ':', agent keeps its alias:name
    if not msg:
        reply("Nothing to send — @session:agent <msg>")
        return
    _deliver_and_report(from_id, session, "send", agent, msg, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)


def _route_session(from_id, rest, *, sessions, ae_home, reply, timeout):
    tokens = rest.split(None, 3)
    if len(tokens) < 4:
        reply("Usage: /session <name|id-prefix> <send|ask> <agent> <msg>")
        return
    ref, verb, agent, msg = tokens
    if verb not in _DISPATCH_VERBS:  # caller-side verb validation (complements s11b's boundary)
        reply(f"Unknown verb '{verb}' (use send or ask)")
        return
    _deliver_and_report(from_id, ref, verb, agent, msg, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)


def _route_use(from_id, args, *, sessions, ae_home, current_target, reply):
    args = args.strip()
    if not args:
        cur = current_target.load()
        if cur:
            reply(f"Current target: {cur[0]} → {cur[1]}  (plain messages go here; /use clear to fall back to the orchestrator)")
            return
        st = find_orchestrator(sessions, ae_home)
        if st:
            reply(f"No override set — plain messages go to the orchestrator ({st[0]} → {st[1]}). /use <session> <agent> to redirect.")
        else:
            reply("No override set and no orchestrator running. Start one with 'ae orchestrator', or /use <session> <agent>.")
        return
    parts = args.split()
    ref = parts[0]
    if ref in ("clear", "off", "none"):
        current_target.clear()
        reply("Override cleared — plain messages go to the orchestrator again.")
        return
    if len(parts) < 2:
        reply("Usage: /use <session> <agent>   (or /use clear)")
        return
    agent = parts[1]
    sr = resolve_session_ref(sessions, ref)
    if not sr.ok:
        reply(f"Ambiguous session '{ref}' — be more specific" if sr.status == "ambiguous"
              else f"No running session matching '{ref}'")
        return
    ar = resolve_agent_in_session(sr.value.agents, agent)
    if not ar.ok:
        reply(f"Ambiguous agent '{agent}' in {sr.value.name} — use alias:name" if ar.status == "ambiguous"
              else f"No agent '{agent}' in session {sr.value.name}")
        return
    if current_target.save(sr.value.name, ar.value):
        reply(f"Override set: {sr.value.name} → {ar.value}. Plain messages go here until /use clear (then back to the orchestrator).")
    else:
        reply("Failed to save current target")


def _route_command(from_id, stripped, *, sessions, ae_home, current_target, reply, timeout):
    parts = stripped.split(None, 1)
    cmd = parts[0].split("@", 1)[0]  # tolerate /cmd@botname
    rest = parts[1] if len(parts) > 1 else ""
    if cmd == "/help":
        reply(_HELP_TEXT)
    elif cmd == "/list":
        reply(_list_sessions(sessions))
    elif cmd == "/use":
        _route_use(from_id, rest, sessions=sessions, ae_home=ae_home, current_target=current_target, reply=reply)
    elif cmd == "/session":
        _route_session(from_id, rest, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)
    else:
        reply(f"Unknown command: {cmd} — try /help")


def route_message(from_id, text, update, *, sessions, ae_home, current_target, reply, timeout=10):
    """Route one authorized inbound message by PRECEDENCE (ae:3485-3517 + the poll-level
    reply decision ae:3792-3797): slash command > non-slash reply > @session:agent >
    /use sticky > orchestrator default > guidance. Delivers via tg_dispatch (s11b); every
    user-facing line goes through the injected `reply` seam (the s16 daemon wires it to
    the transport's send_message). poll_inbound's `dispatch` seam binds this."""
    stripped = text.strip()
    if stripped.startswith("/"):  # slash beats reply — a /cmd sent as a reply is a command
        _route_command(from_id, stripped, sessions=sessions, ae_home=ae_home,
                       current_target=current_target, reply=reply, timeout=timeout)
        return
    reply_to = ((update.get("message") or {}).get("reply_to_message") or {}).get("text")
    if reply_to:
        parsed = _parse_reply_target(reply_to)
        if parsed is None:  # fail safe — a forged/broken reply must NOT blind-dispatch
            reply("Couldn't tell which agent that was a reply to — use /session <name> send <agent> <msg>")
            return
        session, actor = parsed
        _deliver_and_report(from_id, session, "send", actor, text, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)
        return
    if not stripped:  # whitespace-only, non-reply -> help (ae /help|"")
        reply(_HELP_TEXT)
        return
    if stripped.startswith("@"):
        _route_at(from_id, stripped, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)
        return
    target = current_target.load()
    if target:
        _deliver_and_report(from_id, target[0], "send", target[1], text, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)
        return
    orchestrator = find_orchestrator(sessions, ae_home)
    if orchestrator:
        _deliver_and_report(from_id, orchestrator[0], "send", orchestrator[1], text, sessions=sessions, ae_home=ae_home, reply=reply, timeout=timeout)
        return
    reply("No orchestrator running and no /use target set. Start one with 'ae orchestrator' (then just talk "
          "to it), reply to a message, use @session:agent <msg>, or /use <session> <agent>. (/help)")


def truncate_text(text, limit) -> str:
    """UTF-8-safe truncation (ae:3250-3257): a CODEPOINT slice — never splits a multibyte
    char — with an '…(truncated)' marker when over the limit."""
    return text if len(text) <= limit else text[:limit] + "…(truncated)"


def _action_set(spec) -> set:
    return {t for t in re.split(r"[,\s]+", (spec or "").strip()) if t}


def event_action_allowed(action, include, exclude) -> bool:
    """Forward only actions in `include` and not in `exclude` (ae:3232-3247; comma/space
    lists)."""
    if action not in _action_set(include):
        return False
    return action not in _action_set(exclude)


def format_event(name, event, *, limit=3500) -> str:
    """The forwarded chat line (ae:3261-3275): '[<name>] <action>  <actor>[ → <target>]'
    then, if a summary, a newline + truncated summary. This header is EXACTLY what s11c's
    _parse_reply_target reads back, keeping the reply round-trip consistent."""
    action = event.get("action", "")
    actor = event.get("actor", "")
    target = event.get("target", "")
    summary = event.get("summary", "")
    hdr = f"[{name}] {action}  {actor}"
    if target:
        hdr += f" → {target}"
    if summary:
        return f"{hdr}\n{truncate_text(summary, limit)}"
    return hdr


def forward_event(name, event, config, *, send, recorder=None):
    """Forward one ae event to Telegram IF its action passes include/exclude: format it,
    send via the injected seam, and record a telegram.send effect. A filtered event does
    NOT send or record. Records the send ATTEMPT regardless of the send result (s13 adds
    at-least-once retry); returns the send result for the caller to inspect."""
    action = event.get("action", "")
    if not event_action_allowed(action, config.include, config.exclude):
        return None
    text = format_event(name, event)
    result = send(config.chat_id, text)
    if recorder is not None:
        recorder.record("telegram.send", session=name, action=action, text=text)
    return result


class OutboundState:
    """Per-session outbound tail state (session_id -> (inode, byte_offset)) persisted to
    state.tsv (ae:3826-3856). Atomic save; header / comment / malformed / non-numeric rows
    are skipped on load. The 4th column (last_ts) is kept for ae-format compatibility but
    aewatch does not use it."""

    def __init__(self, path):
        self._path = Path(path)

    def load(self) -> dict:
        out: dict = {}
        try:
            text = self._path.read_text(encoding="utf-8")
        except OSError:
            return out
        for line in text.splitlines():
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 3 or not parts[0]:
                continue
            inode, offset = parts[1], parts[2]
            if not inode.isdigit() or not offset.isdigit():
                continue
            out[parts[0]] = (int(inode), int(offset))
        return out

    def save(self, state) -> bool:
        import os as _os

        tmp = Path(f"{self._path}.tmp.{_os.getpid()}")
        try:
            lines = ["# session_id\tinode\tbyte_offset\tlast_ts"]
            for sid, (inode, offset) in sorted(state.items()):
                lines.append(f"{sid}\t{inode}\t{offset}\t")
            fd = _os.open(str(tmp), _os.O_WRONLY | _os.O_CREAT | _os.O_TRUNC, 0o600)
            with _os.fdopen(fd, "w", encoding="utf-8") as fh:
                fh.write("\n".join(lines) + "\n")
            _os.replace(tmp, self._path)
            return True
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            return False


def _send_ok(result) -> bool:
    return isinstance(result, dict) and bool(result.get("ok"))


def process_session_events(events_file, prev, name, config, *, send, recorder=None):
    """Byte-accurate, at-least-once tail of a session's events.jsonl (ae:3875-3934). An
    UNSEEN session or an INODE CHANGE jumps to EOF (never replay history; handle
    transfer/rotation); size<=offset is a no-op; else forward each COMPLETE event via
    forward_event and advance the offset by the raw line bytes. A send failure stops
    WITHOUT advancing past the failed line, so it + everything after retries next cycle;
    a partial trailing line is ignored. Returns the new (inode, offset)."""
    events_file = Path(events_file)
    try:
        st = events_file.stat()
    except OSError:
        return prev
    file_inode, file_size = st.st_ino, st.st_size
    if prev is None or prev[0] != file_inode:   # unseen OR inode change -> EOF
        return (file_inode, file_size)
    cur_offset = prev[1]
    if file_size < cur_offset:   # TRUNCATED in place (same inode) -> reset to the new EOF,
        return (file_inode, file_size)  # else the offset stalls beyond EOF forever (codex)
    if file_size == cur_offset:  # nothing new -> no-op
        return (file_inode, cur_offset)
    try:
        with events_file.open("rb") as fh:
            fh.seek(cur_offset)
            data = fh.read(file_size - cur_offset)  # bound to the stat'd size
    except OSError:
        return (file_inode, cur_offset)
    new_offset = cur_offset
    start = 0
    while True:
        nl = data.find(b"\n", start)
        if nl == -1:
            break  # partial trailing line -> ignore (retried when the newline arrives)
        line_bytes = data[start:nl + 1]
        line = line_bytes[:-1].decode("utf-8", errors="replace")
        if line.strip():
            try:
                event = json.loads(line)
            except (ValueError, TypeError):
                event = None
            if isinstance(event, dict):
                result = forward_event(name, event, config, send=send, recorder=recorder)
                if result is not None and not _send_ok(result):
                    break  # send failed -> do NOT advance; retry this line + everything after
        new_offset += len(line_bytes)
        start = nl + 1
    return (file_inode, new_offset)


_COMMAND_MENU = [  # ae:3313-3316
    {"command": "list", "description": "Running sessions (name, id, last activity)"},
    {"command": "use",
     "description": "Redirect plain messages to a session (default is the orchestrator): /use <session> <agent>"},
    {"command": "session", "description": "Message an agent: /session <name> send|ask <agent> <msg>"},
    {"command": "help", "description": "Show help"},
]


def register_commands(transport, config, *, logger=None) -> bool:
    """Register the bot slash-command menu (setMyCommands, ae:3306-3352) — best-effort and
    ONLY when inbound is enabled (no point advertising commands that would be rejected).
    A raising transport OR a non-ok result logs REDACTED and returns False; setMyCommands
    can NEVER fail the bridge tick (the plan's explicit non-fatal contract — unlike s12's
    delivery seam, which surfaces a broken transport). Returns True only on ok."""
    if not inbound_enabled(config):
        return False

    def _warn(message):
        if logger is not None:
            logger.log("WARNING", message)

    try:
        result = transport.set_my_commands(_COMMAND_MENU)
    except Exception as exc:
        _warn(f"setMyCommands error: {exc}")
        return False
    if not (isinstance(result, dict) and result.get("ok")):
        _warn("setMyCommands not ok")
        return False
    return True


class TelegramBridge:
    """One composed Telegram bridge tick (the s8-15 capstone): load [telegram] config ->
    (if enabled) register the command menu once -> poll + route inbound -> drain each
    running session's outbound events -> persist. Inbound (tg_offset) and outbound
    (state.tsv) offsets are SEPARATE stores, so one tick's inbound dispatch and outbound
    forward cannot corrupt each other. All seams are injected (tmux-decoupled: `discover`
    is () -> list[DiscoveredSession], wired to discover_sessions in the s16 daemon)."""

    def __init__(self, ae_home, *, transport_provider, discover, offset_store, outbound_state,
                 current_target, logger=None, recorder=None, poll_timeout=0, poll_limit=10):
        self._ae_home = Path(ae_home)
        self._transport_provider = transport_provider
        self._discover = discover
        self._offset_store = offset_store
        self._outbound_state = outbound_state
        self._current_target = current_target
        self._logger = logger
        self._recorder = recorder
        self._poll_timeout = poll_timeout
        self._poll_limit = poll_limit
        self._registered = False
        self._registered_token = None

    def _warn(self, message):
        if self._logger is not None:
            self._logger.log("WARNING", message)

    def tick(self, now=None):
        config = load_telegram_config(load_config(self._ae_home))  # reloaded each tick
        if not config.enabled:
            return
        # Resolve the transport from the CURRENT config EVERY tick (B2): a bridge that
        # started disabled/token-less must pick up a later enable, and a rotated token
        # must send on the new bot — never a transport frozen at daemon start.
        transport = self._transport_provider(config)
        if transport is None:
            return  # enabled but no usable transport yet (e.g. token unreadable) — clean no-op
        # setMyCommands is a per-BOT side channel: a token rotation is a new bot, so
        # re-register even though we "registered once" for the old token.
        if config.token != self._registered_token:
            self._registered = False
            self._registered_token = config.token
        if not self._registered:
            # Retry until the FIRST success — a long-lived tick can recover from a
            # transient setMyCommands failure (register_commands is False when inbound
            # is disabled OR on failure, so `_registered` means "registered once").
            self._registered = register_commands(transport, config, logger=self._logger)
        sessions = self._discover()
        # OUTBOUND before INBOUND (ae:3988-4000): outbound offsets are persisted before
        # inbound command handling can run arbitrary session-helper code.
        self._drain_outbound(config, sessions, transport)
        self._poll_inbound(config, sessions, transport)

    def _poll_inbound(self, config, sessions, transport):
        def reply(text):
            transport.send_message(config.chat_id, text)

        def dispatch(from_id, text, update):
            route_message(from_id, text, update, sessions=sessions, ae_home=self._ae_home,
                          current_target=self._current_target, reply=reply)

        poll_inbound(transport, self._offset_store, config, dispatch=dispatch,
                     logger=self._logger, timeout=self._poll_timeout, limit=self._poll_limit)

    def _drain_outbound(self, config, sessions, transport):
        state = self._outbound_state.load()
        for session in sessions:
            if not session.running or not session.session_id:
                continue
            events_file = self._ae_home / "sessions" / session.name / "events.jsonl"
            try:
                state[session.session_id] = process_session_events(
                    events_file, state.get(session.session_id), session.name, config,
                    send=transport.send_message, recorder=self._recorder)
            except Exception as exc:  # one bad session must not abort the whole tick
                self._warn(f"outbound drain error for {session.name}: {type(exc).__name__}")
        self._outbound_state.save(state)


_AEWATCH_SESSION = "ae-aewatch"


def _heartbeat_fresh(runtime, clock, max_age) -> bool:
    try:
        age = clock() - runtime.heartbeat_path.stat().st_mtime
    except OSError:
        return False  # no heartbeat file -> not fresh (wedged / never started)
    return 0 <= age <= max_age


def ensure_aewatch_session(runtime, *, argv, tmux_server="", cwd=None, env=None,
                           tmux_bin="tmux", clock, heartbeat_max_age=90, logger=None) -> str:
    """Ensure the dedicated ae-aewatch daemon session exists — PER-AE_HOME, on the root's
    OWN tmux server (the P1 s4 singleton scope; -L <server>), NOT a global session (port of
    ae:4067-4079). Returns 'running' (alive + FRESH heartbeat -> refuse a duplicate),
    'restarted' (existed but stale / no heartbeat = wedged -> kill + recreate), 'started', or
    'failed' (new-session did not succeed — best-effort must never return FALSE success). The
    daemon argv is shell-QUOTED and AE_HOME defaults to the runtime's root (caller env
    overlays it); the launcher is non-fatal (tmux failures captured, never raised — the s18
    autostart path must never break a session launch)."""
    import shlex
    import subprocess

    server_args = ["-L", tmux_server] if tmux_server else []

    def _tmux(*args) -> int:
        try:
            return subprocess.run([tmux_bin, *server_args, *args],
                                  capture_output=True, text=True, timeout=5).returncode
        except (OSError, subprocess.SubprocessError):
            return 1

    def _warn(message):
        if logger is not None:
            logger.log("WARNING", message)

    status = "started"
    if _tmux("has-session", "-t", _AEWATCH_SESSION) == 0:
        if _heartbeat_fresh(runtime, clock, heartbeat_max_age):
            return "running"
        _tmux("kill-session", "-t", _AEWATCH_SESSION)  # wedged daemon -> reap before recreate
        status = "restarted"
    # Per-AE_HOME scope: the spawned daemon must read the SAME root, so AE_HOME defaults to
    # the runtime's; a caller env value overlays it. `exec` replaces the shell so SIGTERM/
    # SIGHUP reach the daemon directly (s16 signals). argv + env are shell-quoted.
    full_env = {"AE_HOME": str(runtime.ae_home), **(env or {})}
    env_prefix = "".join(f"{k}={shlex.quote(str(v))} " for k, v in full_env.items())
    command = f"{env_prefix}exec {shlex.join(list(argv))}"
    if _tmux("new-session", "-d", "-s", _AEWATCH_SESSION, "-c", cwd or str(Path.home()), command) != 0:
        _warn(f"ae-aewatch session create failed (intended={status})")
        return "failed"  # non-fatal to the caller, but never a FALSE success
    _tmux("set-option", "-t", _AEWATCH_SESSION, "status", "off")  # cosmetic — failure ignored
    _tmux("rename-window", "-t", _AEWATCH_SESSION, _AEWATCH_SESSION)
    return status


def collect_inputs(ae_home: Path, tmux: TmuxClient, recorder: EffectRecorder) -> list[str]:
    """Phase-1 no-op input collector: READ-ONLY.

    Lists the session directories that carry a `meta` file under $AE_HOME/sessions
    and records a single log line. It performs NO mutations (no tmux writes, no
    event appends, no runtime-file or Telegram effects). `tmux` is accepted so the
    signature is stable for the discovery slice; the read below also proves reads
    never record an effect.
    """
    sessions_dir = Path(ae_home) / "sessions"
    names: list[str] = []
    if sessions_dir.is_dir():
        for child in sorted(sessions_dir.iterdir()):
            if (child / "meta").is_file():
                names.append(child.name)
    tmux.list_sessions(None)  # read-only probe; must not record an effect
    recorder.log("INFO", f"collect-inputs: {len(names)} session dir(s)")
    return names


# ── ae-compatible INI parser (parity port) ───────────────────────────────
# Mirrors ae's own parse_config regex semantics EXACTLY so aewatch reads the same
# config ae does — NOT a general TOML/YAML parser. Notably: only literal spaces
# (never tabs) around '='; quoted values kept verbatim (a '#' inside quotes is not
# a comment); unquoted values strip an inline '#...' then right-trim; last
# duplicate wins; section names are [a-zA-Z_-]+ (no digits); keys before any
# section land in the "" bucket; non-matching lines are ignored.
_INI_SECTION_RE = re.compile(r"\[([a-zA-Z_-]+)\]")
_INI_KV_QUOTED_RE = re.compile(r'([a-zA-Z_][a-zA-Z0-9_-]*) *= *"(.*)"')
_INI_KV_UNQUOTED_RE = re.compile(r"([a-zA-Z_][a-zA-Z0-9_-]*) *= *(.+)")


def parse_ae_ini(text: str) -> dict[str, dict[str, str]]:
    """Parse ae INI text into {section: {key: value}} (all values are strings)."""
    result: dict[str, dict[str, str]] = {}
    section = ""
    if not text:
        return result
    # ae reads with `while IFS= read -r line`: it splits ONLY on '\n' and DROPS a
    # final line lacking a trailing newline (read returns non-zero at EOF without
    # a delimiter). Mirror both so phase-2 diffing has no hidden exception — do
    # not use str.splitlines() (splits on more separators and keeps the last line).
    lines = text.split("\n")
    if not text.endswith("\n"):
        lines = lines[:-1]
    for raw_line in lines:
        line = raw_line.strip()
        if not line:
            continue
        m = _INI_SECTION_RE.fullmatch(line)
        if m:
            section = m.group(1)
            continue
        m = _INI_KV_QUOTED_RE.fullmatch(line)
        if m:
            # Quoted value: verbatim, no comment stripping.
            result.setdefault(section, {})[m.group(1)] = m.group(2)
            continue
        m = _INI_KV_UNQUOTED_RE.fullmatch(line)
        if m:
            # Unquoted value: strip an inline '#...' comment, then right-trim.
            value = m.group(2).split("#", 1)[0].rstrip()
            result.setdefault(section, {})[m.group(1)] = value
            continue
        # Anything else (incl. full-line '#' comments) is ignored.
    return result


def load_config(ae_home) -> dict[str, dict[str, str]]:
    """Load and parse $AE_HOME/config. Missing file -> empty dict.

    Phase 1 is single-file by design: a local .ae/config overlay is cwd/session
    dependent and belongs to a later explicit-path loader, not a singleton daemon.
    """
    config_path = Path(ae_home) / "config"
    if not config_path.is_file():
        return {}
    return parse_ae_ini(config_path.read_text(encoding="utf-8"))


# ── Session discovery (per-meta tmux_server) ─────────────────────────────
# Session `meta` is a FLAT key=value file (no sections/quotes/comments), and its
# agent.* keys contain '.', which the config key grammar rejects — so meta has
# its own parser, distinct from parse_ae_ini.


def _parse_session_meta(text: str) -> dict[str, str]:
    """Parse a flat ae session meta (key=value per line, split on the first '=')."""
    out: dict[str, str] = {}
    for line in text.split("\n"):
        if "=" in line:
            key, value = line.split("=", 1)
            out[key] = value
    return out


@dataclasses.dataclass
class DiscoveredAgent:
    slot: str        # the key after 'agent.' — e.g. main, worker.0, spawned.1
    ref: str         # 'alias:name'
    session_id: str  # the agent's own tool session id (may be empty)


@dataclasses.dataclass
class DiscoveredSession:
    name: str
    session_id: str
    work_dir: str
    tmux_server: str
    running: bool
    agents: list

    def to_dict(self) -> dict:
        return {
            "name": self.name,
            "session_id": self.session_id,
            "work_dir": self.work_dir,
            "tmux_server": self.tmux_server,
            "running": self.running,
            "agents": [
                {"slot": a.slot, "ref": a.ref, "session_id": a.session_id}
                for a in self.agents
            ],
        }


def discover_sessions(ae_home, tmux, recorder=None) -> list:
    """Discover sessions from $AE_HOME/sessions/*/meta.

    Liveness is read through EACH session's OWN tmux_server — never a global
    server. One bad meta cannot hide good sessions: a malformed dir is skipped
    with a recorded warning (not stderr). A directory without a meta file is not
    a session and is ignored silently. Returns DiscoveredSession sorted by name
    (stable for phase-2 oracle snapshots); each is JSON-serializable via to_dict().
    """
    sessions_dir = Path(ae_home) / "sessions"
    result: list = []
    if not sessions_dir.is_dir():
        return result
    for child in sorted(sessions_dir.iterdir()):
        meta_file = child / "meta"
        if not meta_file.is_file():
            continue  # not a session directory
        try:
            meta = _parse_session_meta(meta_file.read_text(encoding="utf-8"))
        except OSError as exc:
            if recorder is not None:
                recorder.log("WARNING", f"discovery: unreadable meta in {child.name}: {exc}")
            continue
        name = meta.get("session", "").strip()
        if not name:
            if recorder is not None:
                recorder.log("WARNING", f"discovery: meta missing 'session' in {child.name}, skipped")
            continue
        agents = []
        for key in sorted(meta):
            if key.startswith("agent."):
                parts = meta[key].split(":")
                ref = ":".join(parts[:2]) if len(parts) >= 2 else meta[key]
                agent_session_id = parts[2] if len(parts) >= 3 else ""
                agents.append(
                    DiscoveredAgent(slot=key[len("agent.") :], ref=ref, session_id=agent_session_id)
                )
        server = meta.get("tmux_server", "")
        running = name in tmux.list_sessions(server)
        result.append(
            DiscoveredSession(
                name=name,
                session_id=meta.get("session_id", ""),
                work_dir=meta.get("work_dir", ""),
                tmux_server=server,
                running=running,
                agents=agents,
            )
        )
    result.sort(key=lambda s: s.name)
    return result


# ── Watchdog cycle (phase-2 parity port of ae's `watchdog _run`) ─────────
# The Python side of the dual-run oracle. Each function mirrors a NAMED bash
# helper so the ordered effect stream is byte-identical to the generated
# watchdog. Slice 4 covers the status side channel (bootstrap + end-of-cycle
# @ae_watchdog_status / @ae_branch_status / @ae_branch_name); later slices fill
# activity, nudges, alerts, throttle, and sweep on the same WatchdogState.

# Panes that are never counted as agents (ae:7682-7684 case + the empty guard).
_SYSTEM_AGENTS = frozenset({"", "(null)", "_watchdog", "_shepherd", "_loop", "_events"})


def _env_int(env, *names, default: int) -> int:
    """First present AE_WATCHDOG_*/AE_LOOP_* name wins; an unset/empty name is skipped
    (not a fallback). Name precedence mirrors bash `${VAR:-${LEGACY:-N}}` (ae:7595-7607).
    Numeric handling does NOT fully mirror bash: bash guards ONLY SWEEP against a
    non-numeric value (ae:7608) and raw-propagates every OTHER bad string; aewatch
    instead normalizes ANY set-but-non-numeric value (per `isdigit()` — so negative /
    whitespaced / leading-`+` forms too) to `default` on every knob. That is a
    deliberate divergence, safer for a long-lived daemon than propagating a value that
    would crash the arithmetic downstream (test_24 pins it)."""
    for name in names:
        raw = env.get(name)
        if raw is None or raw == "":
            continue
        return int(raw) if raw.isdigit() else default
    return default


@dataclasses.dataclass
class WatchdogConfig:
    """Watchdog tunables (ae:7595-7608). Values do not affect the slice-4 status
    stream (they gate sleep/nudge/sweep, added later) but the seam is here now."""

    interval: int = 60
    stale_min: int = 15
    max_nudges: int = 2
    throttle_alert_cycles: int = 5
    tg_supervise_secs: int = 120
    sweep_secs: int = 300

    @property
    def stale_secs(self) -> int:
        return self.stale_min * 60

    @classmethod
    def from_env(cls, env=None) -> "WatchdogConfig":
        env = os.environ if env is None else env
        return cls(
            interval=_env_int(env, "AE_WATCHDOG_INTERVAL_SEC", "AE_LOOP_INTERVAL_SEC", default=60),
            stale_min=_env_int(env, "AE_WATCHDOG_STALE_MIN", "AE_LOOP_STALE_MIN", default=15),
            max_nudges=_env_int(env, "AE_WATCHDOG_MAX_NUDGES", "AE_LOOP_MAX_NUDGES", default=2),
            throttle_alert_cycles=_env_int(
                env, "AE_WATCHDOG_THROTTLE_ALERT_CYCLES", "AE_LOOP_THROTTLE_ALERT_CYCLES", default=5
            ),
            tg_supervise_secs=_env_int(env, "AE_WATCHDOG_TG_SUPERVISE_SEC", "AE_LOOP_TG_SUPERVISE_SEC", default=120),
            sweep_secs=_env_int(env, "AE_WATCHDOG_SWEEP_SEC", "AE_LOOP_SWEEP_SEC", default=300),
        )


