def _agent_alert_reason(session_dir, agent: str, session_name: str) -> str:
    """Newest decisive alert/recovery reason for `agent` from events.jsonl, or ''.
    Port of ae:1628. Newest-first: an `alert` maps by summary (not sweeping->stale,
    dead/dropped/missing->dead, throttl->throttled, else stale); `throttled`->
    throttled; a clear (throttle-cleared/alert-cleared) or the agent's OWN other
    event -> '' (recovered); a target-only event (nudge/inbound) keeps scanning."""
    if session_dir is None:
        return ""
    events_file = Path(session_dir) / "events.jsonl"
    if not events_file.is_file():
        return ""
    try:
        lines = events_file.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    at_ref = f"@{session_name}:{agent}"
    for line in reversed(lines):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        actor = ev.get("actor", "")
        target = ev.get("target", "")
        if not (actor == agent or target == agent or target == at_ref):
            continue
        action = ev.get("action", "")
        if action == "alert":
            summary = ev.get("summary", "")
            if "not sweeping" in summary:
                return "stale"
            if any(x in summary for x in ("dead", "dropped", "missing", "MISSING")):
                return "dead"
            if "throttl" in summary:
                return "throttled"
            return "stale"
        if action == "throttled":
            return "throttled"
        if action in ("throttle-cleared", "alert-cleared"):
            return ""
        if actor == agent:  # the agent's OWN activity -> recovered
            return ""
        # target-only event (a nudge / inbound send) is not recovery — keep scanning.
    return ""


def _meta_value(session_dir, key: str) -> str:
    """First `key=` value from session_dir/meta, '' when absent. Port of ae:7422
    _watchdog_meta_value (grep '^key=' | head -1 | cut -d= -f2-)."""
    if session_dir is None:
        return ""
    meta_file = Path(session_dir) / "meta"
    if not meta_file.is_file():
        return ""
    try:
        for line in meta_file.read_text(encoding="utf-8").splitlines():
            if line.startswith(key + "="):
                return line[len(key) + 1:]
    except OSError:
        return ""
    return ""


def _now_iso(epoch) -> str:
    """UTC epoch -> ae's `date -u +%FT%TZ` string (2026-07-05T07:00:00Z)."""
    return datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _nudge_text(session_dir, goal: str) -> str:
    """The exact user-visible nudge message (ae:7933-7939). The Session-goal prefix
    is present only when a goal is set; ${META_DIR} is the session dir (session_dir),
    matching bash — the parity harness normalizes that runtime path."""
    goal_line = f"Session goal: {goal}. " if goal else ""
    return (
        f"{goal_line}Status check: if you have more work, continue. Otherwise declare "
        f'your state so I stop nudging: {session_dir}/state <waiting-user|blocked|done> "<reason>"'
    )


# ── Real ae/event boundaries (the live daemon's emit_event + recover_pending) ──
# Phase 2 injected these from fixtures; the daemon binds these real ones (slice 16).

_RECOVER_FIELDS = ("kind", "slot", "agent", "tool", "captured")
_RECOVER_KINDS = frozenset({"ok", "already", "miss", "skip"})  # ae:2692-2695


def _locked_append(path, line, *, timeout=5) -> bool:
    """Append `line` + newline to `path` under the SAME flock protocol as ae's
    ae_log_append (ae:6192-6198): LOCK_EX on `<path>.lock`, bounded ~`timeout`s to
    emulate `flock -w`. The daemon shares events.jsonl with live ae processes, so it
    must take the same lock. Returns True if appended, False on lock timeout (the
    caller warns + drops the event, matching ae's `flock -w 5 || exit 1`)."""
    import fcntl
    import time

    path = Path(path)
    lock_path = str(path) + ".lock"
    with open(lock_path, "a") as lockf:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(lockf.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    return False
                time.sleep(0.02)
        try:
            with open(path, "a", encoding="utf-8") as fh:
                fh.write(line + "\n")
        finally:
            fcntl.flock(lockf.fileno(), fcntl.LOCK_UN)
    return True


def make_emit_event(sessions_dir, recorder=None, *, timeout=5):
    """Production emit_event boundary: compact append (one JSON object per line —
    matches ae_emit_event) to `<sessions_dir>/<session>/events.jsonl`, flock-serialized
    like ae. Records an event.append effect ONLY after the line is actually appended;
    a lock timeout warns (redacted) + DROPS the event (ae's drop-and-continue), records
    no effect, and returns None."""
    sessions_dir = Path(sessions_dir)

    def emit(session, event):
        appended = _locked_append(
            sessions_dir / session / "events.jsonl", json.dumps(event, separators=(",", ":")), timeout=timeout
        )
        if not appended:
            if recorder is not None:
                recorder.log("WARNING", f"emit_event: lock timeout, dropped {event.get('action', '')} for {session}")
            return None
        if recorder is not None:
            recorder.record("event.append", session=session, event=event)
        return event

    return emit


def make_recover_pending(sessions_dir, recorder=None, *, timeout=5):
    """Production recover_pending boundary: resolve ae_path from the session meta
    (per-call — one daemon serves many sessions), then shell `<ae_path> _recover-pending
    <session>` and parse the TSV rows (ae:2683-2695). No-op ([]) when ae_path is
    absent/non-executable or the shell fails (nonzero/timeout/OSError — a read boundary
    degrades). A malformed (non-5-field) row OR an unknown `kind` (ae contract drift)
    warns through a REDACTED log.write and is skipped."""
    sessions_dir = Path(sessions_dir)

    def recover(session):
        ae_path = _meta_value(sessions_dir / session, "ae_path")
        if not ae_path or not os.access(ae_path, os.X_OK):
            return []
        import subprocess

        try:
            proc = subprocess.run(
                [ae_path, "_recover-pending", session], capture_output=True, text=True, timeout=timeout
            )
            if proc.returncode != 0:
                return []
            out = proc.stdout
        except (OSError, subprocess.SubprocessError):
            return []
        rows = []
        for line in out.split("\n"):
            if not line.strip():
                continue
            fields = line.split("\t")
            if len(fields) != 5:
                if recorder is not None:
                    recorder.log("WARNING", f"recover: malformed row (expected 5 fields): {line}")
                continue
            row = dict(zip(_RECOVER_FIELDS, fields))
            if row["kind"] not in _RECOVER_KINDS:
                if recorder is not None:
                    recorder.log("WARNING", f"recover: unknown kind {row['kind']!r} (ae contract drift): {line}")
                continue
            rows.append(row)
        return rows

    return recover


class BridgeSupervisor:
    """Real supervise_bridge boundary for the live daemon (slice 16). Best-effort revive
    of the machine-global Telegram bridge: records a telegram.supervise ATTEMPT (the same
    observation phase-2's fixture lambda recorded when due), then shells the legacy
    `ae telegram _supervise` propagating the session's tmux server (ae:7982-7995) so the
    bridge is checked on the SAME server the session uses.

    A no-op (no record, no shell) when disabled or when there is no executable ae to
    revive it. NEVER raises — the revive is a throttled scheduler, silent + non-fatal
    (ae:7992-7994 `>/dev/null 2>&1 || true`), deliberately unlike the s4 write path which
    fails loud. The daemon owns [telegram] enabled and passes it as `enabled`."""

    def __init__(self, recorder, *, ae_path=None, enabled=True, timeout=5):
        self._rec = recorder
        self._ae_path = ae_path
        self._enabled = enabled
        self._timeout = timeout

    def ensure_started(self, tmux_server):
        """The supervise_bridge seam: the cycle calls this with the session's tmux
        server when the supervise cadence fires."""
        if not self._enabled or not self._ae_path or not os.access(self._ae_path, os.X_OK):
            return
        # Record the ATTEMPT first (not success) — a failed shell still leaves the
        # attempt in the stream plus a warning.
        self._rec.record("telegram.supervise", tmux_server=tmux_server)
        import subprocess

        env = dict(os.environ)
        if tmux_server:
            env["AE_TMUX_SERVER"] = tmux_server
        else:
            # Explicit pop: an inherited parent AE_TMUX_SERVER must NOT leak into a
            # default-server revive (the daemon is a singleton over many servers).
            env.pop("AE_TMUX_SERVER", None)
        try:
            proc = subprocess.run(
                [self._ae_path, "telegram", "_supervise"],
                capture_output=True, text=True, timeout=self._timeout, env=env,
            )
            if proc.returncode != 0:
                self._rec.log("WARNING", f"bridge supervise: ae telegram _supervise exited {proc.returncode}")
        except (OSError, subprocess.SubprocessError) as exc:
            self._rec.log("WARNING", f"bridge supervise: {type(exc).__name__} shelling ae telegram _supervise")


def run_watchdog_cycle(
    config, state, tmux, session, *, work_dir, session_dir=None, tmux_server="",
    now=None, git=default_git_runner, emit_event=None, has_descendant=default_has_descendant,
    recover_pending=None, supervise_bridge=None,
) -> None:
    """One watchdog cycle for `session`. Counts live @ae_agent panes, classifies
    each (dead / throttled / quiet / active / recent / stale) and acts on them,
    then checks for missing panes, and finally pushes the end-of-cycle status +
    branch.

    Per-agent order mirrors ae:7679-7952. IMPLEMENTED: dead check (shell foreground
    + no descendant -> alert, latched via dead_agents); throttle detect + clear
    (before quiet) and react (after quiet, before active) — pause nudges, `throttled`
    once, `alert` at THROTTLE_ALERT_CYCLES, `throttle-cleared` on recovery; quiet
    states (done event-only / waiting-user / blocked arm-hold-yield); active/recent
    (pure cycle_active bumps); stale -> nudge under MAX_NUDGES (tmux.paste +
    event.append(nudge) via emit_event, actor 'watchdog') then a single max-nudge
    ALERT at count==MAX_NUDGES. After the loop, registered agents with no pane raise
    a missing alert (latched via alerted_missing), then pending session-ids are
    recovered via the injected recover_pending boundary (recover events) — both run
    BEFORE the status push. Meta-agent sweep + wedge (slice 10) run in branch 1b.
    Alerts / throttle / recover events are DIRECT emits (actor 'human') + a
    tmux.display_message where applicable. Finally, the telegram bridge supervise
    scheduler (branch 10, throttled to TG_SUPERVISE_SECS) fires the injected
    supervise_bridge boundary when due -> a telegram.supervise effect. All watchdog
    branches are now ported; phase 3 owns the real tmux/bridge clients."""
    state.cycle += 1
    goal = _meta_value(session_dir, "goal")
    agent_bins = _load_agent_bins(session_dir)
    meta_agent = _meta_value(session_dir, "meta_agent")
    meta_main_agent = _meta_main_agent(session_dir)
    live_agents: dict = {}
    total = active = stale = dead = 0
    for pane in tmux.list_panes(session, tmux_server):
        agent = (pane.agent or "").strip()
        if agent in _SYSTEM_AGENTS:
            continue
        total += 1
        pane_id = pane.pane_id
        live_agents[agent] = pane_id
        # Skip already-dead agents — no further checks (ae:7688-7693).
        if pane_id in state.dead_agents:
            dead += 1
            continue
        # 1. Dead check (ae:7703-7717) — foreground is a shell and the agent is not
        #    a live descendant -> dead alert (once), then latched via dead_agents.
        agent_bin = agent_bins.get(agent, agent.split(":")[0])
        if pane.current_command in _SHELL_COMMANDS and not has_descendant(pane.pane_pid, agent_bin):
            state.dead_agents[pane_id] = True
            dead += 1
            if emit_event is not None:
                emit_event(session, _alert_event(now, agent, "agent process dead — dropped to shell"))
            tmux.display_message(
                f"[ae watchdog] {agent} is DEAD — process dropped to shell", duration_ms=_ALERT_DURATION_MS, server=tmux_server
            )
            continue
        # 1b. Meta-agent (orchestrator) sweep cadence + wedge (ae:7719-7798) — ONLY the
        #     meta session's main agent. Idle between sweeps is NORMAL, not stale:
        #     prompt a sweep every SWEEP_SECS, and guard liveness via the orchestrator's
        #     heartbeat file (wedge alert if it stops advancing, cleared on recovery).
        if meta_agent == "true" and agent == meta_main_agent and config.sweep_secs > 0:
            hb = _heartbeat_mtime(session_dir)
            wedge_secs = config.sweep_secs * 2 + 60
            first_nudge = state.first_sweep_nudge.get(pane_id, 0)
            if hb > 0 and now - hb <= wedge_secs:
                # Fresh heartbeat -> recovery. Clear via the in-memory latch, OR once
                # per lifetime reconcile the durable event log (a restart that lost
                # the latch after alerting still emits a clear).
                if pane_id in state.meta_wedge_alerted:
                    del state.meta_wedge_alerted[pane_id]
                    state.meta_reconciled[pane_id] = True
                    if emit_event is not None:
                        emit_event(session, _watchdog_event(
                            now, "alert-cleared", agent, "meta-agent sweeping again (heartbeat resumed)"))
                elif pane_id not in state.meta_reconciled:
                    # Once per watchdog lifetime, reconcile the DURABLE event log: a
                    # restart that lost the in-memory latch after alerting still emits
                    # a clear if the log shows an active alert (ae:7757-7762). ae now
                    # emits _agent_alert_reason into _lib (slice 10b), so this fires.
                    state.meta_reconciled[pane_id] = True
                    if _agent_alert_reason(session_dir, agent, session) and emit_event is not None:
                        emit_event(session, _watchdog_event(
                            now, "alert-cleared", agent, "meta-agent sweeping again (heartbeat resumed)"))
            elif first_nudge > 0 and now - first_nudge > wedge_secs:
                # Prompted long enough but the heartbeat is stale/absent -> wedge.
                if pane_id not in state.meta_wedge_alerted:
                    state.meta_wedge_alerted[pane_id] = True
                    if hb > 0:
                        wedge_detail = f"no heartbeat for {(now - hb) // 60}m"
                    else:
                        wedge_detail = f"never wrote a heartbeat in {(now - first_nudge) // 60}m of sweep prompts"
                    if emit_event is not None:
                        emit_event(session, _alert_event(
                            now, agent, f"meta-agent not sweeping — {wedge_detail} (may be stuck)"))
                    tmux.display_message(
                        f"[ae watchdog] {agent} (meta-agent) not sweeping — may be stuck",
                        duration_ms=_ALERT_DURATION_MS, server=tmux_server)
            # Sweep cadence. Record the first nudge time so the wedge guard has a
            # reference point even before any heartbeat file exists.
            if now - state.last_sweep_nudge.get(pane_id, 0) >= config.sweep_secs:
                if state.first_sweep_nudge.get(pane_id, 0) == 0:
                    state.first_sweep_nudge[pane_id] = now
                tmux.paste(pane_id, _SWEEP_TEXT, submit=True, server=tmux_server)
                if emit_event is not None:
                    emit_event(session, {
                        "ts": _now_iso(now), "actor": "watchdog", "action": "nudge",
                        "target": agent, "summary": "sweep cadence",
                    })
                state.last_sweep_nudge[pane_id] = now
            active += 1
            continue
        buf = tmux.capture_pane(pane_id, server=tmux_server)
        h = _pane_hash(buf)
        # Throttle detect + clear (ae:7808-7819) — BEFORE quiet, every cycle: a
        # recovered pane with a live streak emits throttle-cleared no matter which
        # branch the agent later exits on. The REACT is after quiet (below).
        is_throttled = _buf_shows_throttle(buf, agent_bin)
        if not is_throttled and pane_id in state.throttle_streak:
            if emit_event is not None:
                emit_event(session, _watchdog_event(
                    now, "throttle-cleared", agent,
                    f"throttling cleared after {state.throttle_streak[pane_id]} cycles",
                ))
            del state.throttle_streak[pane_id]
        # Quiet state (ae:7821-7864) — evaluated BEFORE active so a declared agent
        # is not nudged. done is event-only (pane churn never invalidates it);
        # waiting-user/blocked arm a per-declaration pane baseline, hold while the
        # pane is untouched, and yield (fall through) once it changes.
        quiet = _agent_quiet_reason(session_dir, agent, session)
        if quiet is not None:
            reason, decl_key = quiet
            if reason == "done":
                state.nudge_count[pane_id] = 0
                active += 1
                continue
            decision = _quiet_pane_decision(
                h, state.quiet_base_key.get(pane_id), state.quiet_base_hash.get(pane_id), decl_key
            )
            if decision == "arm":
                state.quiet_base_key[pane_id] = decl_key
                state.quiet_base_hash[pane_id] = h
            if decision in ("arm", "hold"):
                state.nudge_count[pane_id] = 0
                active += 1
                continue
            # yield -> fall through to active/recent/stale (post-reply hang caught).
        # Throttled react (ae:7867-7892) — AFTER quiet, BEFORE active. React first
        # so the alert cadence starts immediately (before pane-hash early-continues
        # mask it). Updating prev_hash/last_hash_change here means a later recovery
        # is seen as ACTIVITY, not a stale first-time hash diff.
        if is_throttled:
            prev_streak = state.throttle_streak.get(pane_id, 0)
            if prev_streak == 0 and emit_event is not None:
                emit_event(session, _watchdog_event(
                    now, "throttled", agent, "upstream throttling detected — pausing nudges"))
            state.throttle_streak[pane_id] = prev_streak + 1
            if state.throttle_streak[pane_id] == config.throttle_alert_cycles:
                if emit_event is not None:
                    emit_event(session, _alert_event(
                        now, agent,
                        f"throttled for {config.throttle_alert_cycles * config.interval}s — may need attention"))
                tmux.display_message(
                    f"[ae watchdog] {agent} throttled persistently", duration_ms=_ALERT_DURATION_MS, server=tmux_server)
            state.prev_hash[pane_id] = h
            state.last_hash_change[pane_id] = now
            state.nudge_count[pane_id] = 0
            active += 1
            continue
        # 5. Active — pane content hash changed since last cycle (ae:7894).
        if h != state.prev_hash.get(pane_id):
            state.prev_hash[pane_id] = h
            state.last_hash_change[pane_id] = now
            state.nudge_count[pane_id] = 0
            active += 1
            continue
        # 6. Recently visible — changed within the stale window (ae:7906).
        last_change = state.last_hash_change.get(pane_id, 0)
        if last_change and now - last_change < config.stale_secs:
            active += 1
            continue
        # 7. Recently alive — recent ae event from this actor (ae:7913).
        event_age = _last_event_age(session_dir, agent, now)
        if event_age < config.stale_secs:
            active += 1
            continue
        # 8. Stale — nudge under MAX_NUDGES (ae:7921-7941).
        stale += 1
        count = state.nudge_count.get(pane_id, 0)
        stale_min = event_age // 60
        stale_display = "no recent events" if stale_min > 9999 else f"idle {stale_min}m"
        if count < config.max_nudges:
            # Paste THEN event, matching the send helper's order (ae:6468/6473).
            tmux.paste(pane_id, _nudge_text(session_dir, goal), submit=True, server=tmux_server)
            if emit_event is not None:
                emit_event(session, {
                    "ts": _now_iso(now),
                    "actor": "watchdog",
                    "action": "nudge",
                    "target": agent,
                    "summary": f"{stale_display}, no recent ae activity",
                })
            state.nudge_count[pane_id] = count + 1
        elif count == config.max_nudges:
            # Max-nudge alert (ae:7942-7947) — once; count > MAX_NUDGES is silent.
            if emit_event is not None:
                emit_event(session, _alert_event(now, agent, f"max nudges reached ({stale_display}), needs attention"))
            tmux.display_message(
                f"[ae watchdog] {agent} may need attention — stale after {config.max_nudges} nudges",
                duration_ms=_ALERT_DURATION_MS,
                server=tmux_server,
            )
            state.nudge_count[pane_id] = count + 1

    # 8. Missing pane check (ae:7954-7963) — registered agents whose panes are gone.
    for agent_ref in _meta_agent_refs(session_dir):
        if agent_ref not in live_agents and agent_ref not in state.alerted_missing:
            state.alerted_missing[agent_ref] = True
            if emit_event is not None:
                emit_event(session, _alert_event(now, agent_ref, "pane missing — agent no longer visible in session"))
            tmux.display_message(f"[ae watchdog] {agent_ref} pane is MISSING", duration_ms=_ALERT_DURATION_MS, server=tmux_server)

    # 9. Recover pending session IDs (ae:7966-7975) — retry the post-launch capture
    #    for codex/gemini/opencode. NO-OP when ae_path is absent or non-executable.
    #    recover_pending(session) is the injected boundary: the oracle returns the
    #    fixture rows; production shells `ae _recover-pending` and parses the TSV.
    ae_path = _meta_value(session_dir, "ae_path")
    if ae_path and os.access(ae_path, os.X_OK) and recover_pending is not None:
        for row in recover_pending(session):
            if row.get("kind") == "ok" and row.get("captured"):
                captured = row["captured"]
                if emit_event is not None:
                    emit_event(session, {
                        "ts": _now_iso(now), "actor": "human", "action": "recover",
                        "target": row.get("agent", ""), "ref": captured,
                        "summary": f"captured {row.get('tool', '')} session id ({captured[:8]})",
                    })

    # 10. Telegram bridge supervise (ae:7977-7997) — scheduler only, throttled to
    #     TG_SUPERVISE_SECS. Best-effort revive of the machine-global bridge; NO-OP
    #     when ae_path is absent/non-executable. supervise_bridge(tmux_server) is the
    #     injected boundary (oracle records telegram.supervise; production reboots the
    #     bridge with AE_TMUX_SERVER=<server>). No network / offset / send here.
    if (
        config.tg_supervise_secs > 0
        and ae_path and os.access(ae_path, os.X_OK)
        and supervise_bridge is not None
        and now - state.last_tg_supervise >= config.tg_supervise_secs
    ):
        state.last_tg_supervise = now
        supervise_bridge(_meta_value(session_dir, "tmux_server"))

    glyph = "✖" if dead else ("⚠" if stale else "●")
    _push_status(tmux, session, f"[watch {glyph} {active}/{total}]", work_dir, git=git, server=tmux_server)


class WatchdogRunner:
    """Runs one watchdog cycle per session for the daemon tick, owning the long-lived
    per-session WatchdogState + bootstrap-once — exactly ae's `_run` shape (bootstrap
    before the loop, then a cycle each pass), but for MANY sessions in one process.

    Injected into run_daemon_tick. `sessions_dir` is $AE_HOME/sessions (each session's
    meta/events live under <sessions_dir>/<name>). The boundaries are the same seams
    run_watchdog_cycle takes; the oracle binds fixture-backed ones, a later phase binds
    real tmux/ae clients."""

    def __init__(self, config, tmux, *, sessions_dir, git=default_git_runner, emit_event=None,
                 has_descendant=default_has_descendant, recover_pending=None, supervise_bridge=None):
        self.config = config
        self.tmux = tmux
        self._sessions_dir = Path(sessions_dir)
        self._git = git
        self._emit_event = emit_event
        self._has_descendant = has_descendant
        self._recover_pending = recover_pending
        self._supervise_bridge = supervise_bridge
        self._states: dict = {}
        self._bootstrapped: set = set()

    def run_cycle(self, session, now) -> None:
        name = session.name
        session_dir = self._sessions_dir / name
        if name not in self._bootstrapped:
            watchdog_bootstrap(self.tmux, name, work_dir=session.work_dir, git=self._git, server=session.tmux_server)
            self._bootstrapped.add(name)
        state = self._states.setdefault(name, WatchdogState())
        run_watchdog_cycle(
            self.config, state, self.tmux, name,
            work_dir=session.work_dir, session_dir=session_dir, tmux_server=session.tmux_server,
            now=now, git=self._git, emit_event=self._emit_event, has_descendant=self._has_descendant,
            recover_pending=self._recover_pending, supervise_bridge=self._supervise_bridge,
        )


# ── Runtime: per-AE_HOME singleton + heartbeat ───────────────────────────
# One supervisor per ae state root (NOT per machine): every runtime artifact
# lives under $AE_HOME/aewatch/, so isolated roots (tests, e2e) can never collide
# with a live one. Stale-lock handling belongs to the supervisor and is deferred.


class SingletonLock:
    """Non-blocking singleton via fcntl.flock on a lock file.

    acquire() returns True if this instance took the lock, False if another
    holder already has it — contention is an expected state, not an exception.
    The lock is held for the lifetime of the open fd and released on release().
    """

    def __init__(self, path: Path) -> None:
        self.path = Path(path)
        self._fd: int | None = None

    def acquire(self) -> bool:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            os.close(fd)
            # Only genuine contention means "already running". Any other flock
            # failure (e.g. ENOLCK / no-locks-available) must propagate, not
            # masquerade as a held lock and silently suppress work.
            if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK, errno.EACCES):
                return False
            raise
        self._fd = fd
        return True

    def release(self) -> None:
        if self._fd is not None:
            try:
                fcntl.flock(self._fd, fcntl.LOCK_UN)
            finally:
                os.close(self._fd)
                self._fd = None


class AewatchRuntime:
    """Resolves and owns the per-AE_HOME runtime paths under $AE_HOME/aewatch/.

    Creates a missing directory with private (0700) permissions. All aewatch
    state — lock, heartbeat, daemon log, backoff — lives here and nowhere else.
    """

    def __init__(self, ae_home) -> None:
        self.ae_home = Path(ae_home)
        self.dir = self.ae_home / "aewatch"
        self.lock_path = self.dir / "aewatch.lock"
        self.heartbeat_path = self.dir / "heartbeat"
        self.daemon_log_path = self.dir / "daemon.log"
        self.backoff_path = self.dir / "backoff.json"
        self.bridge_owner_path = self.dir / "bridge-owner"
        self.dir.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(self.dir, 0o700)
        except OSError:
            pass

    def singleton(self) -> SingletonLock:
        return SingletonLock(self.lock_path)

    def write_bridge_owner(self) -> bool:
        """Claim Telegram-bridge ownership (atomic tmp+replace; content = OUR pid + ns stamp).
        Returns True only on a DURABLE claim — the handoff is fail-CLOSED: if this returns
        False (permissions/disk/replace failure) the daemon must NOT stop bash or send, since
        bash revive paths would see no owner. The bash guard stands down while the marker
        exists AND the heartbeat is fresh; a stale heartbeat or missing marker lets bash revive."""
        self.dir.mkdir(parents=True, exist_ok=True)
        tmp = self.dir / f".bridge-owner.{os.getpid()}.tmp"
        try:
            tmp.write_text(f"{os.getpid()} {time.time_ns()}\n", encoding="utf-8")
            os.replace(tmp, self.bridge_owner_path)
            return True
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            return False

    def clear_bridge_owner(self) -> None:
        """Remove the marker ONLY if THIS process wrote it (pid match), so a second daemon
        invocation that lost the singleton race never clears the REAL owner's live marker
        (which would let bash double-send). Clean owner stop -> instant bash resume; a crash
        leaves the marker but the heartbeat stales -> bash revives (the free fallback)."""
        try:
            first = self.bridge_owner_path.read_text(encoding="utf-8").split(" ", 1)[0]
        except OSError:
            return
        if first == str(os.getpid()):
            try:
                self.bridge_owner_path.unlink()
            except OSError:
                pass

    def write_heartbeat(self) -> Path:
        """Atomically refresh the heartbeat (same-dir temp + os.replace).

        Readers never see partial content, and mtime/inode move cleanly each tick
        — the mtime IS the supervisor's freshness signal. The payload is a
        wall-clock nanosecond stamp (advisory; may not be monotonic).
        """
        self.dir.mkdir(parents=True, exist_ok=True)
        tmp = self.dir / f".heartbeat.{os.getpid()}.tmp"
        try:
            tmp.write_text(f"{time.time_ns()}\n", encoding="utf-8")
            os.replace(tmp, self.heartbeat_path)
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            raise
        return self.heartbeat_path


# ── daemon.log: size-capped rotation + secret redaction ──────────────────
# Security-critical: the daemon log must NEVER contain a raw Telegram bot token,
# a bot<TOKEN> API URL, or configured token-file contents — in the live file OR
# any rotated backup. Redaction runs on EVERY line BEFORE the byte-size / write
# decision, so a secret can never be split across a rotation boundary. Rotation
# params are constants with a per-instance test override, not config keys.
_LOG_MAX_BYTES = 1_000_000
_LOG_BACKUPS = 3


class AewatchLogger:
    """Append lines to $AE_HOME/aewatch/daemon.log with redaction + rotation."""

    def __init__(
        self,
        path,
        *,
        max_bytes: int = _LOG_MAX_BYTES,
        backups: int = _LOG_BACKUPS,
        secrets=None,
        stderr_on_error: bool = False,
        recorder=None,
    ) -> None:
        self.path = Path(path)
        self.max_bytes = max_bytes
        self.backups = backups
        self._stderr_on_error = stderr_on_error
        self._recorder = recorder
        # Redaction literals: each configured secret AND its CR/LF-stripped form,
        # empties dropped (str.replace("") would corrupt every line), longest first
        # so a longer secret wins over any of its substrings.
        literals: set[str] = set()
        for secret in secrets or []:
            for variant in (secret, secret.strip()):
                if variant:
                    literals.add(variant)
        self._literals = sorted(literals, key=len, reverse=True)

    def _redact(self, text: str) -> str:
        # Configured literal secrets first (the strong guarantee), then the shared
        # generic token redaction + fail-closed drop used by every log.write effect.
        for literal in self._literals:
            text = text.replace(literal, "<REDACTED>")
        return redact_generic(text)

    def _rotate(self) -> None:
        oldest = Path(f"{self.path}.{self.backups}")
        if oldest.exists():
            oldest.unlink()
        for i in range(self.backups - 1, 0, -1):
            src = Path(f"{self.path}.{i}")
            if src.exists():
                src.replace(Path(f"{self.path}.{i + 1}"))
        if self.path.exists():
            self.path.replace(Path(f"{self.path}.1"))

    def log(self, level: str, message: str) -> None:
        # Redact the MESSAGE (the level is a safe constant). The SAME redacted text
        # is recorded as the log.write effect payload AND written to daemon.log, so
        # no secret can reach either channel (watch item: effect payloads redacted).
        redacted = self._redact(message)
        if self._recorder is not None:
            self._recorder.record("log.write", level=level, message=redacted)
        data = f"{level} {redacted}\n".encode("utf-8")
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            if self.path.exists() and self.path.stat().st_size + len(data) > self.max_bytes:
                self._rotate()
            with self.path.open("ab") as handle:
                handle.write(data)
        except OSError as exc:
            # Best-effort: never crash the caller. In CLI mode warn with the path +
            # error ONLY — never echo the (possibly secret-bearing) log line.
            if self._stderr_on_error:
                print(f"aewatch: daemon.log write failed ({self.path}): {exc}", file=sys.stderr)


# ── Crash-loop backoff state ─────────────────────────────────────────────
# The supervisor (a later slice) restarts a dead daemon but must give up after
# too many crashes within a rolling window rather than hot-loop forever. This
# owns only the STATE; the supervisor loop and crash recording come later. Epochs
# are injected/persisted wall-clock (a monotonic clock would not survive restart).
_BACKOFF_WINDOW_SECS = 3600
_BACKOFF_BUDGET = 5


class BackoffState:
    """Rolling-window crash counter persisted to $AE_HOME/aewatch/backoff.json."""

    def __init__(self, path, *, window_secs=_BACKOFF_WINDOW_SECS, budget=_BACKOFF_BUDGET, recorder=None):
        self.path = Path(path)
        self.window_secs = window_secs
        self.budget = budget
        self._recorder = recorder

    def _warn_corrupt(self) -> None:
        if self._recorder is not None:
            self._recorder.log("WARNING", f"backoff: corrupt state at {self.path}, resetting to fresh")

    def _load(self) -> list:
        try:
            raw = self.path.read_text(encoding="utf-8")
        except FileNotFoundError:
            return []
        except OSError:
            self._warn_corrupt()
            return []
        try:
            crashes = json.loads(raw)["crashes"]
            # Valid JSON but wrong shape must degrade to fresh, not poison the count.
            if not isinstance(crashes, list) or not all(
                isinstance(c, (int, float)) and not isinstance(c, bool) for c in crashes
            ):
                raise ValueError("bad crashes schema")
        except (json.JSONDecodeError, KeyError, TypeError, ValueError):
            self._warn_corrupt()
            return []
        return [float(c) for c in crashes]

    def _prune(self, crashes: list, now) -> list:
        # A crash exactly window_secs old is still IN-window (inclusive boundary).
        return [c for c in crashes if now - c <= self.window_secs]

    def _save(self, crashes: list) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.parent / f".backoff.{os.getpid()}.tmp"
        try:
            tmp.write_text(json.dumps({"crashes": crashes}), encoding="utf-8")
            os.replace(tmp, self.path)
        except OSError:
            try:
                tmp.unlink()
            except OSError:
                pass
            raise

    def count(self, now) -> int:
        return len(self._prune(self._load(), now))

    def record_crash(self, now) -> bool:
        """Record a crash; return True if over budget within the window ('should stop')."""
        crashes = self._prune(self._load(), now)
        crashes.append(now)
        self._save(crashes)
        over = len(crashes) > self.budget
        if over and self._recorder is not None:
            self._recorder.log(
                "ERROR",
                f"backoff: {len(crashes)} crashes within {self.window_secs}s — over budget "
                f"({self.budget}), should stop",
            )
        return over

    def record_success(self, now) -> None:
        """A healthy tick clears the crash counter."""
        self._save([])


def _run_daemon_tick_body(runtime, tmux, recorder, *, now, config, watchdog_runner, logger) -> list:
    """The singleton-FREE watchdog tick body — the CALLER owns any needed lock (avoids a
    hold_lock footgun on the public run_daemon_tick). Discovers sessions and, if a
    watchdog_runner is provided, runs one cycle per LIVE session (name-sorted)."""
    sessions = discover_sessions(runtime.ae_home, tmux, recorder)
    logger.log("INFO", f"tick: {len(config)} config section(s), discovered {len(sessions)} session(s)")
    if watchdog_runner is not None:
        for session in sessions:
            if session.running:
                watchdog_runner.run_cycle(session, now)
    return sessions


def run_daemon_tick(runtime: "AewatchRuntime", tmux, recorder, *, now, watchdog_runner=None) -> dict:
    """Compose one daemon tick (the CLI/smoke single-tick wrapper): acquire the singleton
    -> discover -> [watchdog cycle per live session] -> heartbeat -> reset backoff ->
    release. Delegates the watchdog work to _run_daemon_tick_body (shared with the long
    loop). If the singleton is already held, does NOTHING and returns acquired=False.
    """
    lock = runtime.singleton()
    if not lock.acquire():
        return {"acquired": False, "sessions": [], "config": {}}
    try:
        config = load_config(runtime.ae_home)
        secrets = [config.get("telegram", {}).get("token", "")]
        logger = AewatchLogger(
            runtime.daemon_log_path, secrets=secrets, recorder=recorder, stderr_on_error=True
        )
        sessions = _run_daemon_tick_body(
            runtime, tmux, recorder, now=now, config=config, watchdog_runner=watchdog_runner, logger=logger
        )
        try:
            runtime.write_heartbeat()
            recorder.record("file.write", path=str(runtime.heartbeat_path), redacted=False)
        except OSError:
            logger.log("WARNING", "heartbeat write failed")
        try:
            BackoffState(runtime.backoff_path).record_success(now)
            recorder.record("file.write", path=str(runtime.backoff_path), redacted=False)
        except OSError:
            logger.log("WARNING", "backoff reset failed")
        return {"acquired": True, "sessions": sessions, "config": config}
    finally:
        lock.release()


_HEARTBEAT_DECAY_STOP_SECS = 60  # < the 90s ownership-decay budget: stop before the fact rots
_HEARTBEAT_REFRESH_MAX_SECS = 60  # cap the loop wait so the heartbeat can't decay between refreshes


def run_daemon_loop(runtime, components, *, clock, interval, sleep=None, recorder=None,
                    secrets_provider=None, install_signals=True) -> dict:
    """The long-running daemon supervisor. `components` is [(name, tick(now)), ...] — the
    s18 CLI wires ('watchdog', _run_daemon_tick_body-closure) ONLY; s19 adds
    ('bridge', TelegramBridge.tick). Holds the singleton for its whole lifetime.

    Each iteration ticks EVERY component in its own try/except (containment — one crash
    can't skip the others), records a REDACTED traceback + a PER-COMPONENT crash on
    failure (over its budget -> alert + stop the whole daemon), heartbeats regardless,
    and resets a component's streak only after ITS clean tick (so one component's health
    can't mask another's crash cadence). Injectable clock()/sleep(interval)->bool (True
    stops) mean no real time in tests. SIGTERM/SIGHUP/SIGINT set a shutdown flag ONLY
    (no work in-handler) -> a CLEAN shutdown (never counted as a crash; SIGHUP from a
    tmux pane teardown must not crash-loop). Redaction secrets are re-read EACH iteration
    so a rotated token still can't reach a crash traceback."""
    import signal as _signal
    import threading
    import traceback as _traceback

    secrets_provider = secrets_provider or (
        lambda: load_telegram_config(load_config(runtime.ae_home)).secrets
    )
    names = [name for name, _ in components]
    if len(names) != len(set(names)):
        raise ValueError(f"duplicate component names would share one backoff file: {names}")
    shutdown = threading.Event()
    signal_name = [None]

    lock = runtime.singleton()
    if not lock.acquire():
        return {"started": False, "reason": "already running"}

    def _logger():
        return AewatchLogger(runtime.daemon_log_path, secrets=secrets_provider(),
                             recorder=recorder, stderr_on_error=True)

    prev_handlers = {}
    if install_signals:
        def _on_signal(signum, frame):  # ONLY set the flag + record the name — no unsafe work
            signal_name[0] = _signal.Signals(signum).name
            shutdown.set()

        for sig in (_signal.SIGTERM, _signal.SIGHUP, _signal.SIGINT):
            try:
                prev_handlers[sig] = _signal.signal(sig, _on_signal)
            except (ValueError, OSError):
                pass  # not the main thread / unsupported platform

    wait = sleep or shutdown.wait  # production: interruptible wait, returns True on shutdown
    backoffs = {name: BackoffState(runtime.dir / f"backoff-{name}.json", recorder=recorder)
                for name, _ in components}
    stop_reason = None
    last_hb_ok_at = clock()
    try:
        while not shutdown.is_set():
            now = clock()
            logger = _logger()
            # B5/B6: maintain the ownership fact (marker + FRESH heartbeat) BEFORE any component
            # ticks this iteration, so the bridge never SENDS with a stale fact. If the heartbeat
            # cannot be kept fresh within the decay-stop budget (disk-full / perms / ro-remount,
            # or a long interval / scheduler stall), STOP before ticking -> the CLI finally clears
            # the marker (unlink needs no free bytes) -> bash revives -> single sender. A single
            # transient blip with a still-fresh heartbeat stays WARN. The wait is capped so the
            # heartbeat is refreshed well under the 90s decay regardless of the configured interval.
            try:
                runtime.write_heartbeat()
                last_hb_ok_at = now
            except OSError:
                logger.log("WARNING", "heartbeat write failed")
                if now - last_hb_ok_at >= _HEARTBEAT_DECAY_STOP_SECS:
                    logger.log("ERROR", "heartbeat unmaintainable — stopping daemon before ownership decays")
                    stop_reason = "heartbeat-write-failed"
                    shutdown.set()
                    break
            for name, tick in components:
                if shutdown.is_set():
                    break
                try:
                    tick_result = tick(now)
                except Exception:
                    logger.log("ERROR", f"{name} tick crashed:\n{_traceback.format_exc()}")
                    try:
                        over_budget = backoffs[name].record_crash(now)
                    except OSError:
                        # a broken backoff file must NOT turn a contained crash into a
                        # daemon crash — log + continue without budgeting this event.
                        logger.log("WARNING", f"{name} backoff persist failed — crash not budgeted")
                        over_budget = False
                    if over_budget:
                        logger.log("ERROR", f"{name} over crash budget — stopping daemon")
                        stop_reason = f"{name}-over-budget"
                        shutdown.set()
                        break
                else:
                    if tick_result is _TICK_SKIPPED:
                        continue  # a not-due gated wake did no work -> don't reset the crash streak (B9)
                    try:
                        backoffs[name].record_success(now)  # only THIS clean component resets
                    except OSError:
                        logger.log("WARNING", f"{name} backoff reset failed")
            if shutdown.is_set() or wait(min(interval, _HEARTBEAT_REFRESH_MAX_SECS)):
                break
        _logger().log("INFO", f"daemon shutting down (signal={signal_name[0]}, reason={stop_reason})")
    finally:
        for sig, handler in prev_handlers.items():
            try:
                _signal.signal(sig, handler)
            except (ValueError, OSError):
                pass
        lock.release()
    return {"started": True, "reason": stop_reason or signal_name[0] or "shutdown"}


def cmd_up(args: argparse.Namespace) -> int:
    """Ensure the ae-aewatch daemon session (s17, idempotent + heartbeat-aware), preserving
    the chosen runner into the spawned loop argv so the uv-run / python3 execution contract
    survives (no bare sys.executable PEP723 footgun)."""
    runtime = AewatchRuntime(args.ae_home)
    script = os.path.abspath(__file__)
    if args.runner == "uv":
        loop_argv = ["uv", "run", script, "daemon", "--loop", "--ae-home", args.ae_home]
    else:
        loop_argv = [sys.executable, script, "daemon", "--loop", "--ae-home", args.ae_home]
    server = args.tmux_server or os.environ.get("AE_TMUX_SERVER", "")
    logger = AewatchLogger(
        runtime.daemon_log_path,
        secrets=load_telegram_config(load_config(runtime.ae_home)).secrets,
        stderr_on_error=True,
    )
    status = ensure_aewatch_session(runtime, argv=loop_argv, tmux_server=server,
                                    clock=time.time, logger=logger)
    print(status)
    return 1 if status == "failed" else 0


_TELEGRAM_BASH_SESSION = "ae-telegram"


_BRIDGE_HEARTBEAT_MAX_AGE = 90  # seconds; the same freshness rule the bash guard uses


def _bridge_ownership_fresh(runtime, *, now=None, max_age=_BRIDGE_HEARTBEAT_MAX_AGE) -> bool:
    """The FULL ownership fact a bash reviver checks: the bridge-owner marker exists AND the
    heartbeat is fresh (age <= max_age). The handoff must make this TRUE before it kills/sends,
    else a concurrent _supervise sees marker-but-no-fresh-heartbeat and revives bash."""
    if not runtime.bridge_owner_path.exists():
        return False
    try:
        age = (time.time() if now is None else now) - runtime.heartbeat_path.stat().st_mtime
    except OSError:
        return False
    return 0 <= age <= max_age


def _stop_bash_bridge_all_servers(tmux, discover) -> None:
    """Kill the bash ae-telegram bridge on EVERY server it could be on — the ambient/default
    server AND every unique tmux_server across discovered sessions. A watchdog _supervise
    running inside a named (-L) server pane revives ae-telegram on THAT server (inherited via
    $TMUX), so an ambient-only kill would leave a second bridge sending."""
    servers = {""}  # "" / None == the ambient default server
    try:
        for sess in discover():
            servers.add(getattr(sess, "tmux_server", "") or "")
    except Exception:  # noqa: BLE001 — discovery failure must not abort the handoff
        pass
    for srv in servers:
        tmux.kill_session(_TELEGRAM_BASH_SESSION, server=(srv or None))


# Sentinel a component tick returns when it did NO work this wake (a not-due _due_gated tick), so
# run_daemon_loop does NOT count it as a clean tick — otherwise a skipped wake would reset the
# component's crash-backoff streak (the "reset only after ITS clean tick" containment contract, B9).
_TICK_SKIPPED = object()


def _due_gated(inner, interval):
    """Wrap a component tick so it runs only when its CONFIGURED cadence is due (now >= next_due),
    even though the daemon loop wakes more often (B6 caps the wait at <=60s for heartbeat
    maintenance). The first tick always runs; then next_due = now + interval. Keeps the watchdog
    on AE_WATCHDOG_INTERVAL_SEC (default 180) so cycle-counted logic (throttle/nudge/alert-text)
    doesn't skew, while the bridge component ticks every wake for command-routing responsiveness.
    A not-due wake returns _TICK_SKIPPED so the loop won't record it as a clean (streak-resetting)
    tick."""
    due = {"at": None}

    def tick(now):
        if due["at"] is not None and now < due["at"]:
            return _TICK_SKIPPED
        due["at"] = now + interval
        return inner(now)

    return tick


def _make_bridge_component(bridge, runtime, tmux, discover):
    """Wrap the bridge tick with the s19 handoff — order marker -> stop-bash -> first send,
    never a double-send window. On the FIRST tick where [telegram] is enabled: (a) DURABLY
    claim the bridge-owner marker (fail-CLOSED — if the claim fails, do NOT stop bash and do
    NOT send; retry next tick), (b) stop the live bash bridge on every server, THEN (c) tick.
    Idempotent (handoff once). Exposes .bridge for wiring tests."""
    state = {"handed_off": False}

    def tick(now):
        cfg = load_telegram_config(load_config(runtime.ae_home))
        if cfg.enabled and not state["handed_off"]:
            if not runtime.write_bridge_owner():          # a) claim the marker (fail-closed)
                return
            # a2) complete the OWNERSHIP FACT before the first kill/send: establish a fresh
            # heartbeat so a bash reviver sees marker + FRESH heartbeat (belt-and-braces with the
            # loop-top heartbeat). If it can't be made fresh, back out (clear marker, no kill/send).
            runtime.write_heartbeat()
            if not _bridge_ownership_fresh(runtime):
                runtime.clear_bridge_owner()
                return
            _stop_bash_bridge_all_servers(tmux, discover)  # b) stop bash on EVERY server
            state["handed_off"] = True
        elif cfg.enabled and not _bridge_ownership_fresh(runtime):
            # PER-SEND guard (B7/B8): time can pass INSIDE one iteration (a slow watchdog component
            # / a stall) between the loop-top heartbeat and this send. If the fact decayed, bash may
            # have revived, so the bridge must NOT send. AND we INVALIDATE the handoff (reset + clear
            # our marker): re-freshening ownership on the next wake is NOT enough — a revived bash
            # must be re-killed first, so the next enabled tick re-runs the FULL handoff (marker ->
            # fresh heartbeat -> kill EVERY bash bridge -> send).
            state["handed_off"] = False
            runtime.clear_bridge_owner()
            return
        bridge.tick(now)                                  # c) send (or idle internally if disabled)

    tick.bridge = bridge
    return tick


def _run_daemon_loop_cli(runtime: "AewatchRuntime", *, install_signals: bool = True) -> int:
    """Wire the PRODUCTION supervisor loop (s16): a watchdog component (RealTmuxClient +
    WatchdogRunner over the real ae/event boundaries) AND (s19) the co-located Telegram
    bridge. The bridge stores point at the SHARED bash telegram dir ($AE_HOME/telegram) so
    the aewatch bridge RESUMES from the bash bridge's last durable offset across the =uv
    handoff (durable-offset continuity). ae stands down the bash bridge (only ONE sends);
    the tick idles on [telegram] enabled. supervise_bridge stays a no-op (bridge co-located)."""
    recorder = EffectRecorder()
    logger = AewatchLogger(
        runtime.daemon_log_path,
        secrets=load_telegram_config(load_config(runtime.ae_home)).secrets,
        recorder=recorder, stderr_on_error=True,
    )
    tmux = RealTmuxClient(recorder)
    sessions_dir = runtime.ae_home / "sessions"
    wd_config = WatchdogConfig.from_env()
    watchdog_runner = WatchdogRunner(
        wd_config, tmux, sessions_dir=sessions_dir,
        emit_event=make_emit_event(sessions_dir, recorder),
        recover_pending=make_recover_pending(sessions_dir, recorder),
        supervise_bridge=None,  # the bridge runs IN this daemon — nothing external to revive
    )

    # B7 (cadence decouple): the loop wakes every min(interval, 60)s (B6 heartbeat maintenance +
    # bridge polling), but the WATCHDOG must keep its CONFIGURED cadence (AE_WATCHDOG_INTERVAL_SEC,
    # default 180) — cycle-counted logic (throttle/nudge budgets, the alert-text "~15min" figure)
    # skews if it sweeps 3x. Self-gate the watchdog on a due-time (below); the bridge ticks every
    # wake DELIBERATELY (<=60s command-routing responsiveness).
    def _watchdog_body(now):
        _run_daemon_tick_body(runtime, tmux, recorder, now=now,
                              config=load_config(runtime.ae_home),
                              watchdog_runner=watchdog_runner, logger=logger)

    watchdog_tick = _due_gated(_watchdog_body, wd_config.interval)

    # s19: wire the co-located Telegram bridge. Stores point at the SHARED bash telegram
    # dir ($AE_HOME/telegram) — byte-compatible formats — so the aewatch bridge resumes from
    # the bash bridge's last DURABLE offset across the =uv handoff (no loss, no replay of
    # durably-past; kill-mid-send stays at-least-once). ae stands down the bash bridge so
    # only ONE bridge sends. The tick idles on [telegram] enabled (config-live, B2).
    telegram_dir = runtime.ae_home / "telegram"
    telegram_dir.mkdir(parents=True, exist_ok=True)  # the stores do not create parents

    def _transport_provider(cfg):
        return RealTelegramTransport(cfg.token, logger=logger) if cfg.token else None

    def bridge_discover():
        return discover_sessions(runtime.ae_home, tmux, recorder)

    bridge = TelegramBridge(
        runtime.ae_home, transport_provider=_transport_provider,
        discover=bridge_discover,
        offset_store=OffsetStore(telegram_dir / "tg_offset"),
        outbound_state=OutboundState(telegram_dir / "state.tsv"),
        current_target=CurrentTarget(telegram_dir / "current_target"),
        logger=logger, recorder=recorder,
    )
    bridge_component = _make_bridge_component(bridge, runtime, tmux, bridge_discover)
    try:
        run_daemon_loop(
            runtime, [("watchdog", watchdog_tick), ("bridge", bridge_component)],
            clock=time.time, interval=wd_config.interval, recorder=recorder,
            install_signals=install_signals,
        )
    finally:
        runtime.clear_bridge_owner()  # clean shutdown -> bash resumes instantly (not after decay)
    return 0


def cmd_daemon(args: argparse.Namespace) -> int:
    runtime = AewatchRuntime(args.ae_home)
    if getattr(args, "loop", False):
        return _run_daemon_loop_cli(runtime)
    if not args.once:
        print("aewatch: daemon requires --once or --loop", file=sys.stderr)
        return 2
    # --once is a SMOKE single tick (NullTmuxClient — no live tmux, no mutations).
    result = run_daemon_tick(runtime, NullTmuxClient(), EffectRecorder(), now=time.time())
    if not result["acquired"]:
        print(f"aewatch: already running (lock held): {runtime.lock_path}", file=sys.stderr)
        return 3
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aewatch",
        description="Optional sidecar for ae's watchdog + telegram bridge (phase 1).",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"aewatch {__version__}",
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")

    contracts = sub.add_parser("contracts", help="contract fixture-matrix operations")
    contracts_sub = contracts.add_subparsers(
        dest="contracts_command", metavar="<subcommand>", required=True
    )
    validate = contracts_sub.add_parser("validate", help="validate CONTRACTS.md")
    validate.add_argument(
        "--contracts",
        default=None,
        help="path to CONTRACTS.md (default: alongside this script)",
    )

    up = sub.add_parser("up", help="ensure the ae-aewatch daemon session is running")
    up.add_argument("--ae-home", dest="ae_home", required=True, help="ae state root ($AE_HOME)")
    up.add_argument("--runner", choices=("uv", "python3"), default="python3",
                    help="how to re-invoke the sidecar for the loop (uv run / python3)")
    up.add_argument("--tmux-server", dest="tmux_server", default="",
                    help="tmux server for the session (default: $AE_TMUX_SERVER)")

    daemon = sub.add_parser("daemon", help="run the watchdog supervisor (--once smoke / --loop; bridge in s19)")
    daemon.add_argument("--ae-home", dest="ae_home", required=True, help="ae state root ($AE_HOME)")
    daemon.add_argument("--once", action="store_true", help="run a single tick and exit (smoke)")
    daemon.add_argument("--loop", action="store_true", help="run the long supervisor loop")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        # No behavior wired without a subcommand; print usage and exit non-zero.
        parser.print_help(sys.stderr)
        return 2
    if args.command == "contracts":
        # contracts_command is required=True, so argparse guarantees it is set.
        if args.contracts_command == "validate":
            return cmd_contracts_validate(args)
    if args.command == "up":
        return cmd_up(args)
    if args.command == "daemon":
        return cmd_daemon(args)
    parser.error(f"unknown command: {args.command}")
    return 2  # unreachable (parser.error exits), kept for type-clarity.


if __name__ == "__main__":
    raise SystemExit(main())
