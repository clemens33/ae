#!/usr/bin/env bash
# ae-next installer — the pre-P5 coexistence command, beside `ae`, never over it.
#
# WHAT THIS DOES AND WHAT IT REFUSES TO TOUCH.
# It installs an IMMUTABLE copy of the Rust core under $AE_HOME/core/<version>/,
# publishes that path as $AE_HOME/core/current, seeds $AE_HOME/config with every
# Telegram credential stripped, and symlinks ~/.local/bin/ae-next at the tracked
# wrapper. AE_HOME here is ~/.ae-next by default; AE_NEXT_HOME is an advanced
# coexistence runtime override, never ~/.ae. This surface is separate from
# install-remote's fixed publication paths.
#
# It never writes ~/.ae, never writes ~/.local/bin/ae, and never edits the repo's
# `install` script. That is the whole point of the slice: the installed ae keeps
# working exactly as it did while the rewrite is dogfooded next to it.
#
# See docs/migration/coexistence.md — that document is the spec, this script is
# its implementation, and where they disagree the document wins.
set -euo pipefail

# macOS ships bash 3.2 and this script is deliberately written for it: no
# associative arrays, no ${var^^}, no readarray. `ae` itself still requires
# bash >= 4, which is its business and not this installer's.

die() {
    echo "ae-next install: $*" >&2
    exit 1
}

note() { echo "ae-next install: $*"; }

# ── SHARED INPUT RULES — byte-identical in ae-next and its installer ─────────
# WHY THE SAME TEXT TWICE. An install that SUCCEEDS and a wrapper that then
# REFUSES is the worst of the three outcomes: state on disk and no command to
# reach it with. There is no shared library for contrib scripts, so the two
# copies are kept byte-identical and any drift shows up in one diff.
#
# Each function PRINTS the reason it refuses and returns 0 either way — the empty
# string is "no objection". Callers turn that into their own exit shape.
#
# THE HOME RULES, and what each one is for:
#   absolute        a relative home resolves against whatever directory the
#                   caller happened to be in, so one command installs to two
#                   places on two runs;
#   no literal ~    nothing here expands a tilde (the shell already did, or the
#                   value came from a file), so `~/x` would create a directory
#                   whose NAME starts with a tilde;
#   not the legacy  the whole point of the slice is that ~/.ae is untouched. The
#     home          comparison is RESOLVED, because `…/.ae-next/../.ae` and a
#                   symlinked root pointing at ~/.ae both spell it without
#                   looking like it;
#   root not a      the final component is ours to create and own. A symlinked
#     symlink       ANCESTOR is fine and normal (macOS /var -> /private/var); a
#                   symlinked ROOT means everything below lands somewhere never
#                   checked.
_ae_next_home_reason() {
    local home="$1" base parent rparent resolved legacy_parent legacy
    # The tilde is DELIBERATELY a literal here: this is the rule that REFUSES an
    # unexpanded one, so expanding it would delete the check.
    # shellcheck disable=SC2088
    case "$home" in
        '~' | '~/'*)
            echo "AE_NEXT_HOME must be an absolute path, and a literal '~' is never expanded here: $home"
            return 0
            ;;
        /*) ;;
        *)
            echo "AE_NEXT_HOME must be an absolute path: $home"
            return 0
            ;;
    esac
    # NO '.' OR '..' COMPONENTS, checked on the RAW value before anything is
    # resolved, created or compared. This is not tidiness. `cd -P` can only
    # resolve a parent that EXISTS, so `$HOME/missing/../.ae` survives
    # resolution as its own literal string, compares unequal to the legacy home,
    # and is then MATERIALISED by `mkdir -p` — which creates the missing
    # component and lands the install in ~/.ae after all. Rejecting the
    # components removes the whole family; the resolved comparison below stays
    # as the second line of defence for the paths that do exist.
    case "/$home/" in
        */../* | */./*)
            echo "AE_NEXT_HOME must not contain '.' or '..' path components: $home"
            return 0
            ;;
    esac
    if [ -L "$home" ]; then
        echo "AE_NEXT_HOME must not itself be a symlink (an ancestor may be): $home"
        return 0
    fi
    # Resolve the PARENT and re-append the name, so a home that does not exist
    # yet is still comparable. `cd -P` is the portable resolver — `readlink -f`
    # is GNU-only (AGENTS.md, GNU vs BSD userland).
    base="$(basename "$home")"
    parent="$(dirname "$home")"
    rparent="$parent"
    if [ -d "$parent" ]; then rparent="$(cd -P "$parent" && pwd)"; fi
    resolved="$rparent/$base"
    legacy_parent="$(dirname "$HOME/.ae")"
    if [ -d "$legacy_parent" ]; then legacy_parent="$(cd -P "$legacy_parent" && pwd)"; fi
    legacy="$legacy_parent/.ae"
    if [ "$resolved" = "$legacy" ]; then
        echo "AE_NEXT_HOME resolves to the legacy ae home ($legacy), the one tree this slice must never touch: $home"
        return 0
    fi
    # The string comparison cannot see filesystem aliases such as a
    # case-insensitive spelling. When both homes exist, device+inode identity
    # is authoritative: AE_NEXT_HOME must not resolve to the legacy ae home.
    if [ -d "$home" ] && [ -d "$HOME/.ae" ] && [ "$home" -ef "$HOME/.ae" ]; then
        echo "AE_NEXT_HOME resolves to the legacy ae home under a different spelling: $home"
        return 0
    fi
    return 0
}

# THE SERVER RULE. `default` is the tmux server the installed ae uses, so an
# ae-next pointed at it is not a second instance at all — it is the first one
# wearing a second name, sharing sessions with the ae you are trying not to
# disturb. Refused rather than silently renamed: an operator who typed it meant
# something, and it was not this.
_ae_next_server_reason() {
    local server="$1"
    if [ "$server" = "default" ]; then
        echo "AE_NEXT_TMUX_SERVER must not be 'default' — that is the installed ae's own tmux server, and pointing ae-next at it would share sessions with the instance this command exists to leave alone"
        return 0
    fi
    # THE SESSION-NAME GRAMMAR, for the same reason `ae` allowlists it there:
    # this value becomes a tmux socket NAME. `./default` and `../default` name
    # the very socket the rule above refuses, a slash makes it a path, and a
    # leading dot hides it. One class, no exceptions to reason about.
    #
    # Matched with `[[ =~ ]]` and a variable, never `printf | grep -q`: under
    # `set -o pipefail` a matching `grep -q` exits first, SIGPIPEs the producer,
    # and the PIPELINE reports failure — so the valid names would be the ones
    # refused.
    local grammar='^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$'
    if ! [[ "$server" =~ $grammar ]]; then
        echo "AE_NEXT_TMUX_SERVER must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}\$ — the session-name grammar, with no slash and no dot components: $server"
        return 0
    fi
    return 0
}

# ── OWNED-NODE CLASSIFICATION ───────────────────────────────────────────────
# EVERY node this script creates or writes is classified ONCE, by name, before it
# is used — and lstat-first, so a symlink is SEEN as a symlink instead of being
# followed to whatever it points at. `-e` follows links and answers false for a
# dangling one, which is why every check asks `-L` first.
#
# WHAT THIS IS NOT: a hostile-filesystem framework. Nothing is re-checked after
# use, and a same-UID substitution between the check and the write is not closed
# — a process running as this user may rewrite these paths whenever it likes, and
# that is an accepted non-security boundary rather than a hole left open by
# oversight. What it does close is the ordinary accident: a stale symlink, a
# directory where a file belongs, a `current` planted to point elsewhere. States
# an installer should refuse rather than write through.
_require_real_dir() {
    if [ -L "$1" ]; then die "$2 is a symlink, not a directory: $1"; fi
    if [ -e "$1" ] && [ ! -d "$1" ]; then die "$2 is not a directory: $1"; fi
}
_require_regular_or_absent() {
    if [ -L "$1" ]; then die "$2 is a symlink; this installer writes only regular files: $1"; fi
    if [ -e "$1" ] && [ ! -f "$1" ]; then die "$2 is not a regular file: $1"; fi
}

_ae_next_home_prepare() {
    local home="$1" existed=0 reason
    if [ -e "$home" ] || [ -L "$home" ]; then existed=1; fi
    if [ "$existed" -eq 0 ] && ! mkdir -p "$home"; then
        echo "could not create AE_NEXT_HOME root: $home"
        return 1
    fi
    # Re-run the complete home validator after creating only the root. This is
    # the first point where a fresh case-variant can be classified by -ef.
    reason="$(_ae_next_home_reason "$home")"
    if [ -n "$reason" ]; then
        if [ "$existed" -eq 0 ] && ! rmdir "$home"; then
            echo "AE_NEXT_HOME resolves to the legacy ae home under another spelling, and the newly-created root could not be removed: $home"
            return 1
        fi
        echo "$reason"
        return 1
    fi
    return 0
}

# ── Where things are ─────────────────────────────────────────────────────────

# The repo, resolved from this script's REAL location. Symlink-safe without
# `readlink -f`, which is GNU-only (AGENTS.md, GNU vs BSD userland): follow the
# chain by hand, one link at a time.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"
    _src="$(readlink "$_src")"
    case "$_src" in
        /*) ;;
        *) _src="$_dir/$_src" ;;
    esac
done
HERE="$(cd -P "$(dirname "$_src")" && pwd)"
REPO="$(cd -P "$HERE/../.." && pwd)"
WRAPPER="$HERE/ae-next"
[ -f "$REPO/ae" ] || die "no ae script at $REPO/ae — is this a checkout?"
[ -f "$WRAPPER" ] || die "no wrapper at $WRAPPER"

# The ae-next state home. A SECOND instance is a second install under another
# home (AE_NEXT_HOME=~/.ae-next2), which is why every path below derives from
# this one variable and nothing hardcodes ~/.ae-next twice.
AE_NEXT_HOME="${AE_NEXT_HOME:-$HOME/.ae-next}"
_reason="$(_ae_next_home_reason "$AE_NEXT_HOME")"
[ -z "$_reason" ] || die "$_reason"
# Validated HERE as well as in the wrapper, although this script never starts a
# tmux server: refusing at install time is the difference between one clear error
# and a working install whose command refuses on every launch.
_reason="$(_ae_next_server_reason "${AE_NEXT_TMUX_SERVER:-ae-next}")"
[ -z "$_reason" ] || die "$_reason"

# Classify the candidate root before any child (core, pointer, config, or
# version) can be created. A fresh alias is ours to remove; a pre-existing one
# is never removed by this installer.
_reason="$(_ae_next_home_prepare "$AE_NEXT_HOME")" || die "$_reason"

CORE_ROOT="$AE_NEXT_HOME/core"
CURRENT="$CORE_ROOT/current"
NEXT_CONFIG="$AE_NEXT_HOME/config"
OLD_CONFIG="$HOME/.ae/config"
LINK="$HOME/.local/bin/ae-next"

# ── The core binary ──────────────────────────────────────────────────────────

# AE_NEXT_CORE_BIN skips the build. It exists for the test suite and for CI,
# which already have a binary and must not spend three minutes rebuilding it —
# and for an operator installing a downloaded release artifact. It is an INPUT
# PATH only: whatever it names still has to pass the version check below.
if [ -n "${AE_NEXT_CORE_BIN:-}" ]; then
    BUILT="$AE_NEXT_CORE_BIN"
    [ -f "$BUILT" ] || die "AE_NEXT_CORE_BIN does not name a file: $BUILT"
    note "using the prebuilt core $BUILT"
else
    note "building the core (cargo build --release --locked)"
    (cd "$REPO" && cargo build --release --locked) || die "cargo build failed"
    BUILT="$REPO/target/release/ae"
fi
[ -x "$BUILT" ] || die "the core is not executable: $BUILT"

# THE TWO VERSIONS MOVE TOGETHER, and this is where that is enforced rather than
# hoped for. The bash glue and the core are one product: a glue that pins a core
# of another version is the exact drift the immutable path exists to prevent, and
# it shows up later as a session degrading to bash bodies for no visible reason.
CORE_VERSION="$("$BUILT" --version 2>/dev/null | head -1 | awk '{print $NF}')"
[ -n "$CORE_VERSION" ] || die "the core reported no version: $BUILT"
AE_VERSION="$(grep -m1 '^AE_VERSION=' "$REPO/ae" | cut -d'"' -f2)"
[ -n "$AE_VERSION" ] || die "could not read AE_VERSION from $REPO/ae"
if [ "$CORE_VERSION" != "$AE_VERSION" ]; then
    die "version mismatch: the core reports $CORE_VERSION, ae is $AE_VERSION.
    They move together. Rebuild the core, or bump AE_VERSION, Cargo.toml and
    Cargo.lock in one commit."
fi

# ── Install it, immutably ────────────────────────────────────────────────────
#
# 0555 ON THE VERSION DIRECTORY AND THE BINARY, and 0755 on core/ itself so the
# NEXT version can still be added beside this one. The mode is a guard against
# accident, not a security boundary: the owner of a file can always chmod it
# back. What it buys is that `cargo build` cannot land new bytes under a path a
# running session has pinned — the exhibit that motivated this whole shape was
# target/release/ae reporting 0.2.18 while the tree said 0.2.20, and the
# integration suite failing `compact` during someone else's rebuild.

VERSION_DIR="$CORE_ROOT/$CORE_VERSION"
INSTALLED="$VERSION_DIR/ae"
_require_real_dir "$AE_NEXT_HOME" "the ae-next home"
_require_real_dir "$CORE_ROOT" "the core directory"
_require_real_dir "$VERSION_DIR" "the core version directory"
_require_regular_or_absent "$INSTALLED" "the installed core"
_require_regular_or_absent "$CURRENT" "the core pointer (core/current)"
_require_regular_or_absent "$NEXT_CONFIG" "the ae-next config"
mkdir -p "$CORE_ROOT"
chmod 0755 "$CORE_ROOT"

if [ -e "$INSTALLED" ]; then
    if cmp -s "$BUILT" "$INSTALLED"; then
        # ENFORCED, not assumed. An identical core that is somehow writable is
        # hardened rather than refused: the bytes are right, only the mode drifted
        # (an older install, a hand edit, a restore from a backup that lost modes).
        chmod 0555 "$INSTALLED"
        note "core $CORE_VERSION already installed (identical bytes) — no-op, mode enforced 0555"
    else
        # THE REFUSAL. A version that is already installed is a version some
        # session may have pinned; replacing its bytes in place is exactly the
        # mutation this layout exists to prevent. There is no --force: the fix
        # is a version number, not a flag.
        die "core $CORE_VERSION is already installed at $INSTALLED with DIFFERENT bytes.
    An installed version is immutable — a running session may have pinned it.
    Bump the version (AE_VERSION, Cargo.toml, Cargo.lock) and install that."
    fi
else
    # A version directory left behind by an interrupted run is 0555 and cannot be
    # written into; make it writable for the copy rather than failing forever on
    # a half-finished install.
    if [ -d "$VERSION_DIR" ]; then chmod 0755 "$VERSION_DIR"; fi
    mkdir -p "$VERSION_DIR"
    # PUBLISHED BY RENAME, never written in place. A copy interrupted half way
    # leaves a partial file, and a partial file at THIS path is an executable
    # some session will pin and run. The temp lives in the same directory so the
    # rename is atomic, carries its final mode BEFORE it is named, and a leftover
    # temp from a killed run is inert — it is not on any path anyone reads.
    _tmp="$(mktemp "$VERSION_DIR/.ae.XXXXXX")"
    cp "$BUILT" "$_tmp"
    chmod 0555 "$_tmp"
    mv "$_tmp" "$INSTALLED"
    note "installed core $CORE_VERSION at $INSTALLED (0555)"
fi
chmod 0555 "$VERSION_DIR"

# ── Publish it: core/current is the ONE source of the core path ──────────────
#
# NEXT-OWNED AUTHORITY. `ae` reads this file itself (`_ae_core_bin_input`:
# AE_CORE_BIN, then <AE_HOME>/core/current, then the config), and the wrapper
# deliberately UNSETS AE_CORE_BIN rather than exporting one — so every RE-ENTRY
# (a generated helper, the watchdog's `telegram _supervise`, compact's child)
# reads the pointer fresh instead of inheriting a copy that goes stale at the
# first upgrade. No `workspace.core` is written anywhere, by anyone.
#
# Temp + rename, because a reader — the wrapper, on every single invocation —
# must never catch this file half-written: rename(2) is atomic, a truncating
# write is not. The value is the EXPANDED ABSOLUTE path, never a `~` token,
# which `_ae_core_bin_input` does not expand and which would pin a core that
# cannot be executed.
_tmp="$(mktemp "$CORE_ROOT/.current.XXXXXX")"
printf '%s\n' "$INSTALLED" >"$_tmp"
mv "$_tmp" "$CURRENT"
note "core/current -> $INSTALLED"

# ── Seed the config, with no credentials in it ───────────────────────────────
#
# ONLY WHEN ABSENT. A re-run never touches an existing config: the operator's
# ae-next config is theirs, including a deliberate `enabled = true` with their own
# test bot's credentials, and an installer that reset that on every upgrade would
# be an installer nobody runs twice.
#
# THE WHOLE [telegram] SECTION IS REPLACED, not just `enabled`. Copying
# token_file / chat_id / allowed_user_ids into a second instance is how one bot
# token ends up polled by two bridges — the failure this slice was written to
# make impossible. Stripping `enabled` alone would leave the credentials sitting
# there for one edit to activate.
if [ -e "$NEXT_CONFIG" ]; then
    note "config exists — left exactly as it is ($NEXT_CONFIG)"
elif [ -f "$OLD_CONFIG" ]; then
    _tmp="$(mktemp "$AE_NEXT_HOME/.config.XXXXXX")"
    if grep -qE '^[[:space:]]*\[telegram\][[:space:]]*$' "$OLD_CONFIG"; then
        awk '
            /^[[:space:]]*\[telegram\][[:space:]]*$/ {
                skipping = 1
                print "[telegram]"
                print "enabled = false"
                next
            }
            /^[[:space:]]*\[/ { skipping = 0 }
            skipping != 1 { print }
        ' "$OLD_CONFIG" >"$_tmp"
    else
        cat "$OLD_CONFIG" >"$_tmp"
        printf '\n[telegram]\nenabled = false\n' >>"$_tmp"
    fi
    mv "$_tmp" "$NEXT_CONFIG"
    note "seeded $NEXT_CONFIG from $OLD_CONFIG — [telegram] carries no credentials"
else
    printf '[telegram]\nenabled = false\n' >"$NEXT_CONFIG"
    note "no $OLD_CONFIG to seed from — wrote a minimal $NEXT_CONFIG"
    note "add [agents] and [workspace] to it before launching a session"
fi

# ── The command ──────────────────────────────────────────────────────────────
#
# ~/.local/bin/ae-next, and nothing else in that directory. ~/.local/bin/ae is
# the installed ae and is never read, written or inspected here.
#
# A DIRECTORY AT THE DESTINATION IS REFUSED, not worked around: `ln -sf` given a
# directory creates the link INSIDE it (`.../ae-next/ae-next`) and reports
# success, so the operator would be told the command was linked while nothing at
# the path they were told about exists. `-d` follows symlinks, so this covers a
# symlink to a directory too.
mkdir -p "$(dirname "$LINK")"
if [ -d "$LINK" ]; then
    die "$LINK is a directory (or a symlink to one); refusing to link inside it. Remove it and re-run."
fi
# Published by rename like everything else: `ln -sf` unlinks and re-creates, so
# a concurrent reader can see the path missing. A rename never shows a gap.
_tmplink="$(dirname "$LINK")/.ae-next.link.$$"
rm -f "$_tmplink"
ln -s "$WRAPPER" "$_tmplink"
mv "$_tmplink" "$LINK"
note "linked $LINK -> $WRAPPER"

note "done. Try: ae-next doctor"
