#!/usr/bin/env bash
# ae-next — run the rust-rewrite hybrid (bash glue + Rust core) beside the
# installed `ae`, sharing nothing with it.
#
# THE WHOLE JOB IS ISOLATION. Four exported variables and one refusal:
#   AE_HOME             ~/.ae-next          (AE_NEXT_HOME is an advanced coexistence runtime override)
#   CONFIG_FILE         $AE_HOME/config     so an inherited CONFIG_FILE cannot redirect it
#   AE_TMUX_SERVER      ae-next             (AE_NEXT_TMUX_SERVER overrides)
#   AE_TMUX_SERVER_KIND name
# Sessions, archive, worktrees, locks, the Telegram offset and the tmux server
# all follow those, so an ae-next session and an ae session cannot see each
# other's state — the ownership rule is structural rather than a convention.
#
# WHAT THIS DELIBERATELY DOES NOT DO: it does not export AE_CORE_BIN. The core is
# resolved by `ae` itself from $AE_HOME/core/current on EVERY entry, including
# the re-entries this wrapper is not part of — a generated helper exec'ing its
# recorded ae path, the watchdog re-invoking `telegram _supervise`, compact
# launching its child. An exported path would be a copy of that pointer, frozen
# into a tmux server's environment at launch and stale from the first upgrade;
# reading the file each time is what makes an install visible everywhere at once.
# The check below is a PRE-CHECK for a clear early error, not the resolution.
#
# See docs/migration/coexistence.md. Not P5: nothing here touches ~/.local/bin/ae
# or ~/.ae.
# AE_NEXT_HOME ships as an advanced coexistence runtime override. It is separate
# from install-remote's fixed publication paths and is a P5 retirement item.
set -euo pipefail

_refuse() {
    echo "ae-next: $1" >&2
    exit 2
}

# ── SHARED INPUT RULES — byte-identical in ae-next and its installer ─────────
# WHY THE SAME TEXT TWICE. An install that SUCCEEDS and a wrapper that then
# REFUSES is the worst of the three outcomes: state on disk and no command to
# reach it with. There is no shared library for contrib scripts, so the two
# copies are kept byte-identical and any drift shows up in one diff.
#
# Each function PRINTS the reason it refuses and returns 0 either way — the empty
# string is "no objection". Callers turn that into their own exit shape.
#
# THE HOME RULES, and what each one is for:
#   absolute        a relative home resolves against whatever directory the
#                   caller happened to be in, so one command installs to two
#                   places on two runs;
#   no literal ~    nothing here expands a tilde (the shell already did, or the
#                   value came from a file), so `~/x` would create a directory
#                   whose NAME starts with a tilde;
#   not the legacy  the whole point of the slice is that ~/.ae is untouched. The
#     home          comparison is RESOLVED, because `…/.ae-next/../.ae` and a
#                   symlinked root pointing at ~/.ae both spell it without
#                   looking like it;
#   root not a      the final component is ours to create and own. A symlinked
#     symlink       ANCESTOR is fine and normal (macOS /var -> /private/var); a
#                   symlinked ROOT means everything below lands somewhere never
#                   checked.
_ae_next_home_reason() {
    local home="$1" cursor tail component rprefix resolved legacy_parent legacy probe next
    # The tilde is DELIBERATELY a literal here: this is the rule that REFUSES an
    # unexpanded one, so expanding it would delete the check.
    # shellcheck disable=SC2088
    case "$home" in
        '~' | '~/'*)
            echo "AE_NEXT_HOME must be an absolute path, and a literal '~' is never expanded here: $home"
            return 0
            ;;
        /*) ;;
        *)
            echo "AE_NEXT_HOME must be an absolute path: $home"
            return 0
            ;;
    esac
    # NO '.' OR '..' COMPONENTS, checked on the RAW value before anything is
    # resolved, created or compared. This is not tidiness. `cd -P` can only
    # resolve a parent that EXISTS, so `$HOME/missing/../.ae` survives
    # resolution as its own literal string, compares unequal to the legacy home,
    # and is then MATERIALISED by `mkdir -p` — which creates the missing
    # component and lands the install in ~/.ae after all. Rejecting the
    # components removes the whole family; the resolved comparison below stays
    # as the second line of defence for the paths that do exist.
    case "/$home/" in
        */../* | */./*)
            echo "AE_NEXT_HOME must not contain '.' or '..' path components: $home"
            return 0
            ;;
    esac
    # Trailing slashes make `link/` resolve through the symlink, so `-L` answers
    # false. Strip them (keep a bare `/`) before the symlink test; do not refuse
    # the slash itself — it is ordinary shell-completion.
    if [ "$home" != "/" ]; then
        while [ "$home" != "${home%/}" ]; do
            home="${home%/}"
        done
        [ -n "$home" ] || home="/"
    fi
    if [ -L "$home" ]; then
        echo "AE_NEXT_HOME must not itself be a symlink (an ancestor may be): $home"
        return 0
    fi
    # Resolve from the nearest EXISTING ancestor and re-append the unresolved
    # tail. Resolving only the immediate parent misses `$HOME/.AE/a/b` when `a`
    # does not exist yet: `cd -P` cannot canonicalise a missing parent, so the
    # case-alias `.AE` never becomes `.ae` and `mkdir -p` then materialises
    # inside the legacy tree. `cd -P` is the portable resolver — `readlink -f`
    # is GNU-only (AGENTS.md, GNU vs BSD userland).
    cursor="$home"
    tail=""
    while [ ! -d "$cursor" ] && [ "$cursor" != "/" ]; do
        component="$(basename "$cursor")"
        if [ -n "$tail" ]; then
            tail="$component/$tail"
        else
            tail="$component"
        fi
        cursor="$(dirname "$cursor")"
    done
    if [ -d "$cursor" ]; then
        rprefix="$(cd -P "$cursor" && pwd)"
    else
        rprefix="$cursor"
    fi
    if [ -n "$tail" ]; then
        if [ "$rprefix" = "/" ]; then
            resolved="/$tail"
        else
            resolved="$rprefix/$tail"
        fi
    else
        resolved="$rprefix"
    fi
    legacy_parent="$(dirname "$HOME/.ae")"
    if [ -d "$legacy_parent" ]; then legacy_parent="$(cd -P "$legacy_parent" && pwd)"; fi
    legacy="$legacy_parent/.ae"
    case "$resolved" in
        "$legacy" | "$legacy"/*)
            echo "AE_NEXT_HOME resolves to the legacy ae home ($legacy), the one tree this slice must never touch: $home"
            return 0
            ;;
    esac
    # `cd -P` preserves the typed case on APFS (measured: `.AE` stays `.AE`
    # in pwd), so the string compare cannot see a case-alias ancestor.
    # Walk existing ancestors with `-ef` against the legacy home — that is
    # what catches `.AE/a/b` when `a` does not exist yet.
    if [ -d "$legacy" ]; then
        probe="$cursor"
        while [ -n "$probe" ] && [ "$probe" != "/" ]; do
            if [ -d "$probe" ] && [ "$probe" -ef "$legacy" ]; then
                echo "AE_NEXT_HOME resolves to the legacy ae home ($legacy), the one tree this slice must never touch: $home"
                return 0
            fi
            next="$(dirname "$probe")"
            [ "$next" = "$probe" ] && break
            probe="$next"
        done
    fi
    # The string comparison cannot see filesystem aliases such as a
    # case-insensitive spelling. When both homes exist, device+inode identity
    # is authoritative: AE_NEXT_HOME must not resolve to the legacy ae home.
    if [ -d "$home" ] && [ -d "$HOME/.ae" ] && [ "$home" -ef "$HOME/.ae" ]; then
        echo "AE_NEXT_HOME resolves to the legacy ae home under a different spelling: $home"
        return 0
    fi
    return 0
}

# THE SERVER RULE. `default` is the tmux server the installed ae uses, so an
# ae-next pointed at it is not a second instance at all — it is the first one
# wearing a second name, sharing sessions with the ae you are trying not to
# disturb. Refused rather than silently renamed: an operator who typed it meant
# something, and it was not this.
_ae_next_server_reason() {
    local server="$1"
    if [ "$server" = "default" ]; then
        echo "AE_NEXT_TMUX_SERVER must not be 'default' — that is the installed ae's own tmux server, and pointing ae-next at it would share sessions with the instance this command exists to leave alone"
        return 0
    fi
    # THE SESSION-NAME GRAMMAR, for the same reason `ae` allowlists it there:
    # this value becomes a tmux socket NAME. `./default` and `../default` name
    # the very socket the rule above refuses, a slash makes it a path, and a
    # leading dot hides it. One class, no exceptions to reason about.
    #
    # Matched with `[[ =~ ]]` and a variable, never `printf | grep -q`: under
    # `set -o pipefail` a matching `grep -q` exits first, SIGPIPEs the producer,
    # and the PIPELINE reports failure — so the valid names would be the ones
    # refused.
    local grammar='^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$'
    if ! [[ "$server" =~ $grammar ]]; then
        echo "AE_NEXT_TMUX_SERVER must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}\$ — the session-name grammar, with no slash and no dot components: $server"
        return 0
    fi
    return 0
}

# ── The repo this wrapper belongs to ─────────────────────────────────────────
# Resolved from the wrapper's REAL location, so the symlink at
# ~/.local/bin/ae-next runs the checkout it was linked from. Symlink-safe without
# `readlink -f`, which is GNU-only (AGENTS.md, GNU vs BSD userland).
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"
    _src="$(readlink "$_src")"
    case "$_src" in
        /*) ;;
        *) _src="$_dir/$_src" ;;
    esac
done
_here="$(cd -P "$(dirname "$_src")" && pwd)"
# A release bundle carries the glue beside this wrapper. Prefer that sibling so
# the installed command is self-contained: deleting or editing the checkout
# that produced the bundle cannot change a running or new session. The
# checkout-relative fallback is retained solely for `just next-install` during
# pre-P5 development, where this tracked wrapper is symlinked from the repo.
if [ -f "$_here/ae" ]; then
    _ae="$_here/ae"
    _ae_next_repair="run $_here/install-remote"
else
    _ae="$(cd -P "$_here/../.." && pwd)/ae"
    _ae_next_repair="run 'just next-install' in $(dirname "$_ae")"
fi
[ -x "$_ae" ] || _refuse "no executable ae at $_ae — is this a checkout?"

# ── The isolated instance ────────────────────────────────────────────────────
# UNCONDITIONAL overrides, including of values inherited from an outer ae
# session: running ae-next from inside an ae pane is the normal case during the
# canary, and inheriting that pane's AE_HOME would put ae-next's state in the old
# tree. AE_NEXT_HOME / AE_NEXT_TMUX_SERVER are the sanctioned overrides, and a
# second instance is a second install under its own home.
#
# THE SAME RULES THE INSTALLER APPLIED, applied again here rather than trusted:
# the two run at different times, the environment between them is whatever the
# operator's shell holds, and an install that succeeded is no evidence about the
# variables set for THIS invocation.
AE_HOME="${AE_NEXT_HOME:-$HOME/.ae-next}"
_reason="$(_ae_next_home_reason "$AE_HOME")"
[ -z "$_reason" ] || _refuse "$_reason"
export AE_HOME
CONFIG_FILE="$AE_HOME/config"
export CONFIG_FILE
AE_TMUX_SERVER="${AE_NEXT_TMUX_SERVER:-ae-next}"
_reason="$(_ae_next_server_reason "$AE_TMUX_SERVER")"
[ -z "$_reason" ] || _refuse "$_reason"
export AE_TMUX_SERVER
AE_TMUX_SERVER_KIND="name"
export AE_TMUX_SERVER_KIND

# The core is NEXT-OWNED and file-borne. An inherited AE_CORE_BIN is the one
# input that could quietly repoint it, so it is removed rather than overridden —
# there is no value this wrapper wants in it.
if [ -n "${AE_CORE_BIN:-}" ]; then
    echo "ae-next: ignoring inherited AE_CORE_BIN=$AE_CORE_BIN (the core comes from $AE_HOME/core/current)" >&2
fi
unset AE_CORE_BIN

# ── Pre-check: is there an installed core to resolve? ────────────────────────
# `ae` degrades to its bash bodies when no core is bound, visibly but quietly,
# and `compact` hard-requires one. For ae-next that degradation only ever means
# the install did not happen, so it is reported once, here, with the command that
# fixes it, instead of letting every later invocation explain a symptom.
_current="$AE_HOME/core/current"
_missing() {
    echo "ae-next: $1" >&2
    echo "ae-next: $_ae_next_repair" >&2
    exit 2
}
# lstat FIRST, and never follow: core/current is a regular pointer file this
# instance's installer wrote. A symlink there is not a pointer we published, and
# reading through it would resolve a core from a path nobody validated.
if [ -L "$_current" ]; then
    _missing "the core pointer $_current is a symlink; it must be the regular file the installer writes"
fi
[ -f "$_current" ] || _missing "no installed core: $_current is missing"
_core="$(head -1 "$_current" 2>/dev/null || true)"
_core="$(printf '%s' "$_core" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
[ -n "$_core" ] || _missing "no installed core: $_current is empty"
case "$_core" in
    /*) ;;
    *) _missing "the core path in $_current is not absolute: $_core" ;;
esac
[ -x "$_core" ] || _missing "the core in $_current is not executable: $_core"

# THE TWO VERSIONS MOVE TOGETHER. Install already enforces this; a checkout
# glue can still drift under a pinned core after `git pull`. Recheck
# unconditionally — one grep plus one --version against the core we are about
# to exec.
_glue_version="$(grep -m1 '^AE_VERSION=' "$_ae" | cut -d'"' -f2)"
[ -n "$_glue_version" ] || _refuse "could not read AE_VERSION from $_ae"
_core_version="$("$_core" --version 2>/dev/null | head -1 | awk '{print $NF}')"
[ -n "$_core_version" ] || _refuse "the core reported no version: $_core"
if [ "$_core_version" != "$_glue_version" ]; then
    echo "ae-next: version mismatch: the core reports $_core_version, ae is $_glue_version." >&2
    echo "ae-next: They move together. $_ae_next_repair, or bump AE_VERSION, Cargo.toml and Cargo.lock in one commit." >&2
    exit 2
fi

exec "$_ae" "$@"
