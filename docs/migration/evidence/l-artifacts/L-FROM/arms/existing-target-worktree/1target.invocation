cwd: /tmp/aelx/L-FROM/existing-target-worktree/w
argv:
  /tmp/aelx/L-FROM/existing-target-worktree/b/ae
  --worktree
  tgt
env:
  HOME=/tmp/aelx/L-FROM/existing-target-worktree/h
  AE_HOME=/tmp/aelx/L-FROM/existing-target-worktree/h/.ae
  TMPDIR=/tmp/aelx/L-FROM/existing-target-worktree/tp
  TMUX_TMPDIR=/tmp/aelx/L-FROM/existing-target-worktree/t
  PATH=/tmp/aelx/L-FROM/existing-target-worktree/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
