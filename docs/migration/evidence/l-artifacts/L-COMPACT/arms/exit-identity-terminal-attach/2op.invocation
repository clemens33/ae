pty: tmux pane on a dedicated control server
cwd: /tmp/aelx/L-COMPACT/exit-identity-terminal-attach/w
argv:
  /tmp/aelx/L-COMPACT/exit-identity-terminal-attach/b/ae
  compact
  -f
  --digest-only
  cp1
env:
  HOME=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/h
  AE_HOME=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/h/.ae
  TMPDIR=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/tp
  TMUX_TMPDIR=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/t
  PATH=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-COMPACT/exit-identity-terminal-attach/cap/tmux-argv.log
