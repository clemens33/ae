cwd: /tmp/aelx/L-COMPACT/revalidation-after-answer/w
argv (bg):
  /tmp/aelx/L-COMPACT/revalidation-after-answer/b/ae
  compact
  -f
  --digest-only
  cp1
env:
  HOME=/tmp/aelx/L-COMPACT/revalidation-after-answer/h
  AE_HOME=/tmp/aelx/L-COMPACT/revalidation-after-answer/h/.ae
  TMPDIR=/tmp/aelx/L-COMPACT/revalidation-after-answer/tp
  TMUX_TMPDIR=/tmp/aelx/L-COMPACT/revalidation-after-answer/t
  PATH=/tmp/aelx/L-COMPACT/revalidation-after-answer/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-COMPACT/revalidation-after-answer/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-COMPACT/revalidation-after-answer/cap/tmux-argv.log
  AE_L_HOOKS=b_cp_resolver_entry:b_cp_reval_after_confirmation:b_cp_reval_after_wait:b_cp_after_answer:b_cp_after_handover:b_cp_pre_relaunch
  AE_L_TRACE=/tmp/aelx/L-COMPACT/revalidation-after-answer/cap/hook-trace.tsv
  AE_L_BLOCK=/tmp/aelx/L-COMPACT/revalidation-after-answer/ctl
  AE_L_BLOCK_MAX=1800
