pty: tmux pane on a dedicated control server
cwd: /tmp/aelx/L-COMPACT/interactive-typed-n/w
argv:
  /tmp/aelx/L-COMPACT/interactive-typed-n/b/ae
  compact
  --digest-only
  cp1
env:
  HOME=/tmp/aelx/L-COMPACT/interactive-typed-n/h
  AE_HOME=/tmp/aelx/L-COMPACT/interactive-typed-n/h/.ae
  TMPDIR=/tmp/aelx/L-COMPACT/interactive-typed-n/tp
  TMUX_TMPDIR=/tmp/aelx/L-COMPACT/interactive-typed-n/t
  PATH=/tmp/aelx/L-COMPACT/interactive-typed-n/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-COMPACT/interactive-typed-n/cap/fake
  AE_COMPACT_HANDOVER_SECS=5
  AE_L_TMUX_LOG=/tmp/aelx/L-COMPACT/interactive-typed-n/cap/tmux-argv.log
