cwd: /tmp/aelx/L-STOP/fleet-concurrent-ops/w
argv (bg):
  /tmp/aelx/L-STOP/fleet-concurrent-ops/b/ae
  stop
  all
  -y
env:
  HOME=/tmp/aelx/L-STOP/fleet-concurrent-ops/h
  AE_HOME=/tmp/aelx/L-STOP/fleet-concurrent-ops/h/.ae
  TMPDIR=/tmp/aelx/L-STOP/fleet-concurrent-ops/tp
  TMUX_TMPDIR=/tmp/aelx/L-STOP/fleet-concurrent-ops/t
  PATH=/tmp/aelx/L-STOP/fleet-concurrent-ops/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-STOP/fleet-concurrent-ops/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-STOP/fleet-concurrent-ops/cap/tmux-argv.log
  AE_L_HOOKS=b_stop_supervisor_entry
  AE_L_TRACE=/tmp/aelx/L-STOP/fleet-concurrent-ops/cap/hook-trace.tsv
  AE_L_BLOCK=/tmp/aelx/L-STOP/fleet-concurrent-ops/ctl
  AE_L_BLOCK_MAX=1800
