cwd: /tmp/aelx/L-RENTRANS/_preflight/w
argv:
  /tmp/aelx/L-RENTRANS/_preflight/b/ae
  transfer
  xfer
  aepeer
  -y
env:
  HOME=/tmp/aelx/L-RENTRANS/_preflight/h
  AE_HOME=/tmp/aelx/L-RENTRANS/_preflight/h/.ae
  TMPDIR=/tmp/aelx/L-RENTRANS/_preflight/tp
  TMUX_TMPDIR=/tmp/aelx/L-RENTRANS/_preflight/t
  PATH=/tmp/aelx/L-RENTRANS/_preflight/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-RENTRANS/_preflight/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-RENTRANS/_preflight/cap/tmux-argv.log
