pty: tmux pane on a dedicated control server
cwd: /tmp/aelx/L-END/endall-rename-between-confirm-and-lock/w
argv:
  /tmp/aelx/L-END/endall-rename-between-confirm-and-lock/b/ae
  end
  all
env:
  HOME=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/h
  AE_HOME=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/h/.ae
  TMPDIR=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/tp
  TMUX_TMPDIR=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/t
  PATH=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/cap/tmux-argv.log
  AE_L_HOOKS=b_confirm_answered
  AE_L_TRACE=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/cap/hook-trace.tsv
  AE_L_BLOCK=/tmp/aelx/L-END/endall-rename-between-confirm-and-lock/ctl
  AE_L_BLOCK_MAX=1800
