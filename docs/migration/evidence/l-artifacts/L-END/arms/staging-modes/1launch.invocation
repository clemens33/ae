cwd: /tmp/aelx/L-END/staging-modes/w
argv:
  /tmp/aelx/L-END/staging-modes/b/ae
  --worktree
  smpl
env:
  HOME=/tmp/aelx/L-END/staging-modes/h
  AE_HOME=/tmp/aelx/L-END/staging-modes/h/.ae
  TMPDIR=/tmp/aelx/L-END/staging-modes/tp
  TMUX_TMPDIR=/tmp/aelx/L-END/staging-modes/t
  PATH=/tmp/aelx/L-END/staging-modes/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-END/staging-modes/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-END/staging-modes/cap/tmux-argv.log
