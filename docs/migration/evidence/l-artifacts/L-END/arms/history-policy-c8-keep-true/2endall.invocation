pty: tmux pane on a dedicated control server
cwd: /tmp/aelx/L-END/history-policy-c8-keep-true/w
argv:
  /tmp/aelx/L-END/history-policy-c8-keep-true/b/ae
  end
  --keep-history
  all
env:
  HOME=/tmp/aelx/L-END/history-policy-c8-keep-true/h
  AE_HOME=/tmp/aelx/L-END/history-policy-c8-keep-true/h/.ae
  TMPDIR=/tmp/aelx/L-END/history-policy-c8-keep-true/tp
  TMUX_TMPDIR=/tmp/aelx/L-END/history-policy-c8-keep-true/t
  PATH=/tmp/aelx/L-END/history-policy-c8-keep-true/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-END/history-policy-c8-keep-true/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-END/history-policy-c8-keep-true/cap/tmux-argv.log
