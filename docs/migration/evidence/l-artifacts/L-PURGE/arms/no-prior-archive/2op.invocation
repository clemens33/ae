cwd: /tmp/aelx/L-PURGE/no-prior-archive/w
argv:
  /tmp/aelx/L-PURGE/no-prior-archive/b/ae
  end
  -f
  --purge-history
  np
env:
  HOME=/tmp/aelx/L-PURGE/no-prior-archive/h
  AE_HOME=/tmp/aelx/L-PURGE/no-prior-archive/h/.ae
  TMPDIR=/tmp/aelx/L-PURGE/no-prior-archive/tp
  TMUX_TMPDIR=/tmp/aelx/L-PURGE/no-prior-archive/t
  PATH=/tmp/aelx/L-PURGE/no-prior-archive/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-PURGE/no-prior-archive/cap/fake
