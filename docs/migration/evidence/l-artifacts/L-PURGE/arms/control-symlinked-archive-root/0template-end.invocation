cwd: /tmp/aelx/L-PURGE/control-symlinked-archive-root/w
argv (bg):
  /tmp/aelx/L-PURGE/control-symlinked-archive-root/b/ae
  end
  -f
  pg
env:
  HOME=/tmp/aelx/L-PURGE/control-symlinked-archive-root/h
  AE_HOME=/tmp/aelx/L-PURGE/control-symlinked-archive-root/h/.ae
  TMPDIR=/tmp/aelx/L-PURGE/control-symlinked-archive-root/tp
  TMUX_TMPDIR=/tmp/aelx/L-PURGE/control-symlinked-archive-root/t
  PATH=/tmp/aelx/L-PURGE/control-symlinked-archive-root/b:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
  TERM=xterm-256color
  LANG=en_US.UTF-8
  LC_ALL=en_US.UTF-8
  TZ=UTC
  SHELL=/opt/homebrew/bin/bash
  AE_FAKE_TOOL=fake
  AE_FAKE_LOG_DIR=/tmp/aelx/L-PURGE/control-symlinked-archive-root/cap/fake
  AE_L_TMUX_LOG=/tmp/aelx/L-PURGE/control-symlinked-archive-root/cap/tmux-argv.log
  AE_L_HOOKS=b_stop_local:b_stop_git:b_git_fixed:b_stage_mid:b_pre_rename:b_post_rename:b_pre_cleanup
  AE_L_TRACE=/tmp/aelx/L-PURGE/control-symlinked-archive-root/cap/hook-trace.tsv
  AE_L_BLOCK=/tmp/aelx/L-PURGE/control-symlinked-archive-root/ctl
  AE_L_BLOCK_MAX=1800
