 # timing facts are arguments, never rediscovered here, so preview (pending /
 # preview-not-run) and publication (a real timestamp / a real push outcome) differ in
 # exactly those inputs and in nothing else.
+# >>> H507 EVIDENCE HOOKS (SC-507b probe patch; INERT unless AE_H507_DIR is set)
+# Barrier-only and ordinal-only by construction: these functions never read,
+# hash, or compute over any product state. The controller performs mutations.
+_h507_now() { printf '%s|%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${EPOCHREALTIME:-na}"; }
+_h507_barrier() { # H507_AFTER_FACTS: emit arrival ordinal, block until released
+    [[ -n "${AE_H507_DIR:-}" ]] || return 0
+    local n w=0
+    n="$(cat "${AE_H507_DIR}/facts.seq" 2>/dev/null || echo 0)"
+    n=$((n + 1))
+    printf '%s\n' "$n" >"${AE_H507_DIR}/facts.seq"
+    printf 'arrive\tafter_facts\t%s\t%s\n' "$n" "$(_h507_now)" >>"${AE_H507_DIR}/barrier.log"
+    : >"${AE_H507_DIR}/arrived.${n}"
+    while [[ ! -e "${AE_H507_DIR}/release.${n}" ]]; do
+        w=$((w + 1))
+        if [[ "$w" -gt "${AE_H507_MAXPOLL:-600}" ]]; then
+            printf 'timeout\tafter_facts\t%s\t%s\n' "$n" "$(_h507_now)" >>"${AE_H507_DIR}/barrier.log"
+            return 0
+        fi
+        sleep 0.1
+    done
+    printf 'release\tafter_facts\t%s\t%s\n' "$n" "$(_h507_now)" >>"${AE_H507_DIR}/barrier.log"
+    return 0
+}
+_h507_pass() { # H507_PASS: emit ONLY a pass ordinal to the evidence file
+    [[ -n "${AE_H507_DIR:-}" ]] || return 0
+    local n
+    n="$(cat "${AE_H507_DIR}/pass.seq" 2>/dev/null || echo 0)"
+    n=$((n + 1))
+    printf '%s\n' "$n" >"${AE_H507_DIR}/pass.seq"
+    printf '%s\t%s\n' "$n" "$(_h507_now)" >>"${AE_H507_DIR}/pass.log"
+    return 0
+}
