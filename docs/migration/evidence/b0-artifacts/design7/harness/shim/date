#!/opt/homebrew/bin/bash
# PATH-first `date` shim (batch-c-design.md date-shim contract).
# DELEGATES EVERY invocation to the real binary EXCEPT the exact frozen now-forms
# it substitutes; those four forms are the only ones ae uses to ask "what time is
# it now" at 72c7293: `date +%s`, `date -u +%FT%TZ`, `date -u +%Y/%m/%d`,
# `date -u +%Y%m%dT%H%M%SZ`. Substitution is itself delegated (`real date -u -r
# <pinned>`), so the shim never becomes the formatting behaviour under test.
# Every invocation is logged with its argv and disposition.
# AE_DATE_SHIM_SUBSTITUTE=0 makes it a pure delegate (its inactive form).
REAL_DATE="${AE_DATE_REAL:-/bin/date}"
LOG="${AE_DATE_SHIM_LOG:-}"
STATE="${AE_DATE_SHIM_STATE:-}"
SUB="${AE_DATE_SHIM_SUBSTITUTE:-1}"

ARGV_STR="$(printf '%q ' "$@")"
_note() { [[ -n "$LOG" ]] && printf '%s\t%s\targv=%s\n' "$1" "$2" "$ARGV_STR" >> "$LOG"; return 0; }

now=""
[[ -n "$STATE" && -r "$STATE" ]] && now="$(cat "$STATE")"

if [[ "$SUB" == "1" && -n "$now" ]]; then
    if [[ $# -eq 1 && "$1" == "+%s" ]]; then
        printf '%s\n' "$now"; _note SUBSTITUTED '+%s'; exit 0
    fi
    if [[ $# -eq 2 && "$1" == "-u" ]]; then
        case "$2" in
            "+%FT%TZ" | "+%Y/%m/%d" | "+%Y%m%dT%H%M%SZ")
                "$REAL_DATE" -u -r "$now" "$2"; rc=$?
                _note SUBSTITUTED "$2"; exit $rc ;;
        esac
    fi
fi
_note DELEGATED -
exec "$REAL_DATE" "$@"
