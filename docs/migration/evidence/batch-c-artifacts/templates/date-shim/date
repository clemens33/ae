#!/opt/homebrew/bin/bash
# PATH-first `date` shim (batch-c date-shim contract).
#
# DELEGATES EVERY invocation to the real binary EXCEPT the exact frozen now-forms
# listed below, which it substitutes from AE_FAKE_NOW (epoch seconds). The
# substituted values are themselves produced BY THE REAL BINARY from that epoch
# (`-r <epoch>`), so no formatting or parsing behaviour is ever supplied by the
# shim. With AE_FAKE_NOW unset the shim is pure delegation.
#
# Every invocation is logged to AE_DATE_SHIM_LOG when set (harness artifact,
# segregated from product state).
REAL="${AE_REAL_DATE:-/bin/date}"
if [[ -n "${AE_DATE_SHIM_LOG:-}" ]]; then
    printf '%s\t%s\n' "$$" "$(printf '%q ' "$@")" >>"$AE_DATE_SHIM_LOG" 2>/dev/null || true
fi
if [[ -z "${AE_FAKE_NOW:-}" ]]; then
    exec "$REAL" "$@"
fi
_all="$(printf '%s\x1f' "$@")"
case "$_all" in
    $'-u\x1f+%FT%TZ\x1f')                    exec "$REAL" -u -r "$AE_FAKE_NOW" '+%FT%TZ' ;;
    $'-u\x1f+%Y-%m-%dT%H:%M:%SZ\x1f')        exec "$REAL" -u -r "$AE_FAKE_NOW" '+%Y-%m-%dT%H:%M:%SZ' ;;
    $'-u\x1f+%Y%m%dT%H%M%SZ\x1f')            exec "$REAL" -u -r "$AE_FAKE_NOW" '+%Y%m%dT%H%M%SZ' ;;
    $'+%s\x1f')                              printf '%s\n' "$AE_FAKE_NOW"; exit 0 ;;
esac
exec "$REAL" "$@"
