#!/opt/homebrew/bin/bash
source "$(cd "$(dirname "$0")" && pwd)/_lib"
_ar_request_states () 
{ 
    local file="$1" line ref action;
    [[ -f "$file" ]] || return 0;
    declare -A req_kind req_sender req_target req_summary req_ts req_body;
    declare -A req_actor_slot req_target_slot req_actor_session req_target_session;
    declare -A cand_reply cand_cancel;
    local -a order=();
    local scan=0;
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue;
        scan=$((scan + 1));
        _event_json_str "$line" ref;
        ref="$_EV";
        [[ -n "$ref" ]] || continue;
        _event_json_str "$line" action;
        action="$_EV";
        case "$action" in 
            ask | review)
                [[ -n "${req_kind[$ref]:-}" ]] && continue;
                req_kind["$ref"]="$action";
                _event_json_str "$line" actor;
                req_sender["$ref"]="$_EV";
                _event_json_str "$line" target;
                req_target["$ref"]="$_EV";
                _event_json_str "$line" actor_slot;
                req_actor_slot["$ref"]="$_EV";
                _event_json_str "$line" target_slot;
                req_target_slot["$ref"]="$_EV";
                _event_json_str "$line" actor_session;
                req_actor_session["$ref"]="$_EV";
                _event_json_str "$line" target_session;
                req_target_session["$ref"]="$_EV";
                _event_json_str "$line" summary;
                req_summary["$ref"]="${_EV//'
'/ }";
                _event_json_str "$line" ts;
                req_ts["$ref"]="$_EV";
                _event_json_str "$line" body_file;
                req_body["$ref"]="$_EV";
                order+=("$ref")
            ;;
            cancel)
                _event_json_str "$line" summary;
                _c_sum="${_EV//'
'/ }";
                _event_json_str "$line" actor;
                _c_actor="$_EV";
                _event_json_str "$line" actor_slot;
                _c_aslot="$_EV";
                _event_json_str "$line" actor_session;
                _c_asess="$_EV";
                cand_cancel["$ref"]="${cand_cancel[$ref]:-}${scan}"''"${_c_actor}"''"${_c_aslot}"''"${_c_asess}"''"${_c_sum}"''
            ;;
            reply)
                _event_json_str "$line" summary;
                _r_sum="${_EV//'
'/ }";
                _event_json_str "$line" actor;
                _r_actor="$_EV";
                _event_json_str "$line" target;
                _r_target="$_EV";
                _event_json_str "$line" actor_slot;
                _r_aslot="$_EV";
                _event_json_str "$line" target_slot;
                _r_tslot="$_EV";
                _event_json_str "$line" actor_session;
                _r_asess="$_EV";
                _event_json_str "$line" target_session;
                _r_tsess="$_EV";
                cand_reply["$ref"]="${cand_reply[$ref]:-}${scan}"''"${_r_actor}"''"${_r_target}"''"${_r_aslot}"''"${_r_tslot}"''"${_r_asess}"''"${_r_tsess}"''"${_r_sum}"''
            ;;
        esac;
    done < <(_ae_tac "$file" 2> /dev/null || true);
    local i status summary;
    local -a cands=();
    local cand c_actor c_target c_aslot c_tslot c_asess c_tsess c_sum;
    local rep_ok rep_text can_ok can_text;
    for ((i = ${#order[@]} - 1; i >= 0; i--))
    do
        ref="${order[$i]}";
        status="pending";
        summary="${req_summary[$ref]}";
        rep_ok=false;
        rep_text="";
        if [[ -n "${cand_reply[$ref]:-}" ]]; then
            IFS='' read -ra cands <<< "${cand_reply[$ref]}";
            for cand in "${cands[@]}";
            do
                [[ -n "$cand" ]] || continue;
                IFS='' read -r _ c_actor c_target c_aslot c_tslot c_asess c_tsess c_sum <<< "$cand";
                if [[ -n "${req_target_slot[$ref]:-}" && -n "$c_aslot" ]]; then
                    if [[ "$c_aslot" == "${req_target_slot[$ref]}" && "$c_asess" == "${req_target_session[$ref]:-}" && "$c_tslot" == "${req_actor_slot[$ref]:-}" && "$c_tsess" == "${req_actor_session[$ref]:-}" ]]; then
                        rep_ok=true;
                        rep_text="$c_sum";
                        break;
                    fi;
                else
                    if [[ "$c_actor" == "${req_target[$ref]}" && "$c_target" == "${req_sender[$ref]}" ]]; then
                        rep_ok=true;
                        rep_text="$c_sum";
                        break;
                    fi;
                fi;
            done;
        fi;
        can_ok=false;
        can_text="";
        if [[ -n "${cand_cancel[$ref]:-}" ]]; then
            IFS='' read -ra cands <<< "${cand_cancel[$ref]}";
            for cand in "${cands[@]}";
            do
                [[ -n "$cand" ]] || continue;
                IFS='' read -r _ c_actor c_aslot c_asess c_sum <<< "$cand";
                if [[ -n "${req_actor_slot[$ref]:-}" && -n "$c_aslot" ]]; then
                    if [[ "$c_aslot" == "${req_actor_slot[$ref]}" && "$c_asess" == "${req_actor_session[$ref]:-}" ]]; then
                        can_ok=true;
                        can_text="$c_sum";
                        break;
                    fi;
                else
                    if [[ -n "$c_actor" && "$c_actor" == "${req_sender[$ref]}" ]]; then
                        can_ok=true;
                        can_text="$c_sum";
                        break;
                    fi;
                fi;
            done;
        fi;
        if [[ "$can_ok" == true ]]; then
            status="cancelled";
            summary="$can_text";
        else
            if [[ "$rep_ok" == true ]]; then
                status="replied";
                summary="$rep_text";
            fi;
        fi;
        printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$status" "${req_kind[$ref]}" "$ref" "${req_sender[$ref]}" "${req_target[$ref]}" "${req_ts[$ref]}" "${req_body[$ref]:-}" "${req_actor_slot[$ref]:-}" "${req_target_slot[$ref]:-}" "${req_actor_session[$ref]:-}" "${req_target_session[$ref]:-}" "$summary";
    done;
    return 0
}
helper_requests_main () 
{ 
    META_DIR="$(cd "$(dirname "$0")" && pwd)";
    mode="${1:-mine}";
    self="$(ae_current_agent_ref)";
    if [[ "$mode" != "mine" && "$mode" != "inbox" && "$mode" != "all" ]]; then
        echo "Usage: requests [mine|inbox|all]" 1>&2;
        exit 1;
    fi;
    if [[ "$mode" != "all" && -z "$self" ]]; then
        echo "Error: could not detect current agent identity; use 'requests all' outside an ae pane" 1>&2;
        exit 1;
    fi;
    local self_slot self_session;
    self_slot="$(ae_current_slot)";
    self_session="$(tmux display-message -p -t "$(ae_current_pane)" '#S' 2> /dev/null || true)";
    printf "%-8s %-8s %-28s %-20s %-20s %s\n" "STATUS" "TYPE" "ID" "FROM" "TO" "SUMMARY";
    local status kind ref sender target actor_slot target_slot actor_session target_session summary;
    while IFS='' read -r status kind ref sender target _ _ actor_slot target_slot actor_session target_session summary; do
        case "$mode" in 
            mine)
                if [[ -n "$actor_slot" && -n "$self_slot" ]]; then
                    { 
                        [[ "$actor_slot" == "$self_slot" ]] && [[ "$actor_session" == "$self_session" ]]
                    } || continue;
                else
                    [[ "$sender" == "$self" ]] || continue;
                fi
            ;;
            inbox)
                if [[ -n "$target_slot" && -n "$self_slot" ]]; then
                    { 
                        [[ "$target_slot" == "$self_slot" ]] && [[ "$target_session" == "$self_session" ]]
                    } || continue;
                else
                    [[ "$target" == "$self" ]] || continue;
                fi
            ;;
            all)

            ;;
        esac;
        printf "%-8s %-8s %-28s %-20s %-20s %s\n" "$status" "$kind" "$ref" "$sender" "$target" "$summary";
    done < <(_ar_request_states "${META_DIR}/events.jsonl")
}
helper_requests_main "$@"
