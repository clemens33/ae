#!/opt/homebrew/bin/bash
# PATH-first `tmux` shim.
#
# DEFAULT MODE: pure delegate-and-log. Records the argv, the caller pid and the effective
# AE_TMUX_SERVER/kind and locale, then execs the real binary unchanged. No active mode is
# possible unless AE_TMUX_BARRIER_DIR is set, so the inactive-equivalence proof taken with
# that variable unset covers every ordinary arm.
#
# ACTIVE BARRIER MODE (b0-design Design 5): with AE_TMUX_BARRIER_DIR set, the FIRST
# invocation whose subcommand equals AE_TMUX_BARRIER_CMD runs the REAL command, captures
# its stdout/stderr/rc, signals the barrier, BLOCKS, and then REPLAYS exactly those bytes
# and that exit status. The shim never performs the mutation — the controller does, while
# the shim is blocked — and every later invocation passes straight through.
REAL="${AE_REAL_TMUX:-/opt/homebrew/bin/tmux}"
if [[ -n "${AE_TMUX_SHIM_LOG:-}" ]]; then
    {
        printf 'pid=%s\tAE_TMUX_SERVER=%s\tAE_TMUX_SERVER_KIND=%s\tLC_ALL=%s\tLANG=%s\targv=' \
            "$$" "${AE_TMUX_SERVER-<unset>}" "${AE_TMUX_SERVER_KIND-<unset>}" \
            "${LC_ALL-<unset>}" "${LANG-<unset>}"
        printf '%q ' "$@"
        printf '\n'
    } >>"$AE_TMUX_SHIM_LOG" 2>/dev/null || true
fi
if [[ -n "${AE_TMUX_BARRIER_DIR:-}" && -n "${AE_TMUX_BARRIER_CMD:-}" && ! -e "${AE_TMUX_BARRIER_DIR}/fired" ]]; then
    # first non-option, non-option-argument word is the subcommand
    _sub=""; _skip=0
    for _a in "$@"; do
        if (( _skip )); then _skip=0; continue; fi
        case "$_a" in
            -S|-L|-f|-c) _skip=1 ;;
            -*) ;;
            *) _sub="$_a"; break ;;
        esac
    done
    if [[ "$_sub" == "${AE_TMUX_BARRIER_CMD}" ]]; then
        _d="$AE_TMUX_BARRIER_DIR"
        : >"$_d/fired"
        "$REAL" "$@" >"$_d/captured.stdout" 2>"$_d/captured.stderr"; _rc=$?
        printf '%s\n' "$_rc" >"$_d/captured.rc"
        { printf 'barrier_cmd=%s\tpid=%s\tutc=%s\targv=' "$_sub" "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          printf '%q ' "$@"; printf '\n'; } >>"$_d/barrier.log"
        : >"$_d/paneset.reached"
        while [[ ! -e "$_d/paneset.release" ]]; do sleep 0.05; done
        printf 'released\tutc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$_d/barrier.log"
        cat "$_d/captured.stdout"
        cat "$_d/captured.stderr" >&2
        exit "$_rc"
    fi
fi
exec "$REAL" "$@"
