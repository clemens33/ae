 # ae - agentic engineering: tmux-based multi-agent workspace
 set -euo pipefail
 AE_VERSION="0.2.1"
+_ae_hook() { # <point> — GUARD FIRST: with AE_HOOK unset this is a no-op and returns 0
    [[ -n "${AE_HOOK:-}" ]] || return 0
    [[ "${AE_HOOK}" == "$1" ]] || return 0
    printf '%s\t%s\n' "$1" "$(/bin/date -u +%s)" >>"${AE_HOOK_MARK:-/dev/null}"
    if [[ -n "${AE_HOOK_WAIT:-}" ]]; then
        local _n=0
        while [[ ! -e "${AE_HOOK_WAIT}" ]] && (( _n < 120 )); do sleep 0.5; _n=$((_n + 1)); done
    fi
    return 0
}

 
