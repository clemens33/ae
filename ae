# reply:
helper_reply_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    if [[ $# -lt 2 ]]; then
        echo "Usage: reply [--as <agent>] <request-id> <message>" >&2
        echo "  Reply to a logged ask/review request using its request id." >&2
        exit 1
    fi
    sender_override=""
    if [[ "${1:-}" == "--as" ]]; then
        [[ $# -ge 4 ]] || {
            echo "Usage: reply [--as <agent>] <request-id> <message>" >&2
            exit 1
        }
        sender_override="$2"
        shift 2
    fi
    req_id="$1"
    shift
    message="$*"
    self="$(ae_current_agent_ref)"
    self_slot="$(ae_current_slot)"
    self_session="$(tmux display-message -p -t "$(ae_current_pane)" '#S' 2>/dev/null || true)"

    row="$(ae_find_request "$req_id")" || {
        echo "Error: request id '${req_id}' not found in ${META_DIR}/events.jsonl" >&2
        exit 1
    }
    # tab-safe: OLD 3-column rows leave the slot fields empty (name-match fallback).
    IFS=$'\t' read -r _ sender target actor_slot actor_session target_slot target_session <<<"$row"

    reply_sender=""
    if [[ -n "$target_slot" ]]; then
        # Slot is the identity proof — ALWAYS verified for a slotted request; --as CANNOT
        # bypass it. (The ask/review footer always passes --as, so a bypass would let any
        # pane spoof a reply to the sender.) --as is advisory DISPLAY only, after the check.
        # R1 (lead gate): empty target_session must NOT fail-open — the request lives in THIS
        # session's events file, so default to $_AE_SESSION; a same-slot pane in another tmux
        # session is then rejected, not passed on slot alone.
        if [[ "$self_slot" != "$target_slot" ]] || [[ "$self_session" != "${target_session:-$_AE_SESSION}" ]]; then
            echo "Error: request '${req_id}' is assigned to slot '${target_slot}'@'${target_session:-$_AE_SESSION}', current pane is slot '${self_slot:-none}'@'${self_session}'" >&2
            exit 1
        fi
        if [[ -n "$sender_override" && "$sender_override" != "$target" ]]; then
            echo "Warning: --as '${sender_override}' != stored target name '${target}' (name is advisory; slot verified)" >&2
        fi
        reply_sender="${sender_override:-$self}"
    else
        # OLD event (pre-migration): name-match, as before.
        if [[ -n "$sender_override" && "$sender_override" != "$target" ]]; then
            echo "Error: override agent '${sender_override}' does not match assigned target '${target}'" >&2
            exit 1
        fi
        reply_sender="$sender_override"
        if [[ -z "$reply_sender" ]]; then
            if [[ -z "$self" ]]; then
                echo "Error: could not detect current agent identity; rerun with --as '${target}' from the assigned agent context" >&2
                exit 1
            fi
            if [[ "$self" != "$target" ]]; then
                echo "Error: request '${req_id}' is assigned to '${target}', current pane is '${self}'" >&2
                exit 1
            fi
            reply_sender="$self"
        fi
    fi

    # DELIVER by resolving the sender's SLOT -> current pane (routing key, not stale name).
    reply_target="$sender"
    if [[ -n "$actor_slot" ]]; then
        local _routed
        _routed="$(ae_slot_resolver "$actor_session" "$actor_slot")"
        if [[ -n "$_routed" ]]; then
            reply_target="$_routed"
        fi
    fi

    exec env AE_SENDER_OVERRIDE="$reply_sender" _AE_EVENT_ACTION="reply" _AE_EVENT_REF="$req_id" _AE_EVENT_SUMMARY="$message" \
        _AE_EVENT_ACTOR_SLOT="$self_slot" _AE_EVENT_ACTOR_SESSION="$self_session" \
        _AE_EVENT_TARGET_SLOT="$actor_slot" _AE_EVENT_TARGET_SESSION="$actor_session" \
        "${META_DIR}/send" "$reply_target" "[${req_id}] ${message}"
}

# requests:
helper_requests_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    mode="${1:-mine}"
    self="$(ae_current_agent_ref)"

    if [[ "$mode" != "mine" && "$mode" != "inbox" && "$mode" != "all" ]]; then
        echo "Usage: requests [mine|inbox|all]" >&2
        exit 1
    fi

    if [[ "$mode" != "all" && -z "$self" ]]; then
        echo "Error: could not detect current agent identity; use 'requests all' outside an ae pane" >&2
        exit 1
    fi

    # Scan events.jsonl: collect latest ask/review per ref and latest reply per ref.
    # A reply only counts as "replied" if the reply's actor matches the request's
    # target AND the reply's target matches the request's sender. This preserves
    # the old TSV invariant: stray reply events with a matching ref but wrong
    # actor/target leave the request pending.
    declare -A req_kind req_sender req_target req_summary req_ts req_actor_slot req_target_slot req_actor_session req_target_session
    declare -A reply_summary reply_actor reply_target reply_ts reply_actor_slot reply_target_slot reply_actor_session reply_target_session
    order=()
    events_file="${META_DIR}/events.jsonl"
    if [[ -f "$events_file" ]]; then
        while IFS= read -r line; do
            [[ "$line" == \{* ]] || continue
            ref="$(_event_json_str "$line" ref)"
            [[ -n "$ref" ]] || continue
            action="$(_event_json_str "$line" action)"
            case "$action" in
                ask | review)
                    [[ -n "${req_kind[$ref]:-}" ]] && continue
                    req_kind["$ref"]="$action"
                    req_sender["$ref"]="$(_event_json_str "$line" actor)"
                    req_target["$ref"]="$(_event_json_str "$line" target)"
                    req_actor_slot["$ref"]="$(_event_json_str "$line" actor_slot)"
                    req_target_slot["$ref"]="$(_event_json_str "$line" target_slot)"
                    req_actor_session["$ref"]="$(_event_json_str "$line" actor_session)"
                    req_target_session["$ref"]="$(_event_json_str "$line" target_session)"
                    req_summary["$ref"]="$(_event_json_str "$line" summary)"
                    # shellcheck disable=SC2034  # populated for symmetry; not read yet
                    req_ts["$ref"]="$(_event_json_str "$line" ts)"
                    order+=("$ref")
                    ;;
                reply)
                    [[ -n "${reply_summary[$ref]:-}" ]] && continue
                    reply_summary["$ref"]="$(_event_json_str "$line" summary)"
                    reply_actor["$ref"]="$(_event_json_str "$line" actor)"
                    reply_target["$ref"]="$(_event_json_str "$line" target)"
                    reply_actor_slot["$ref"]="$(_event_json_str "$line" actor_slot)"
                    reply_target_slot["$ref"]="$(_event_json_str "$line" target_slot)"
                    reply_actor_session["$ref"]="$(_event_json_str "$line" actor_session)"
                    reply_target_session["$ref"]="$(_event_json_str "$line" target_session)"
                    # shellcheck disable=SC2034  # populated for symmetry; not read yet
                    reply_ts["$ref"]="$(_event_json_str "$line" ts)"
                    ;;
            esac
        done < <(tac "$events_file" 2>/dev/null || true)
    fi

    printf "%-8s %-8s %-28s %-20s %-20s %s\n" "STATUS" "TYPE" "ID" "FROM" "TO" "SUMMARY"
    # 'order' is newest-first because we scanned backward; reverse for chronological output.
    local self_slot self_session
    self_slot="$(ae_current_slot)"
    self_session="$(tmux display-message -p -t "$(ae_current_pane)" '#S' 2>/dev/null || true)"
    for ((i = ${#order[@]} - 1; i >= 0; i--)); do
        ref="${order[$i]}"
        sender="${req_sender[$ref]}"
        target="${req_target[$ref]}"
        # Filter by SLOT when both the stored request slot AND this pane's slot exist
        # (survives a display-name churn); else fall back to name matching.
        case "$mode" in
            mine)
                if [[ -n "${req_actor_slot[$ref]:-}" && -n "$self_slot" ]]; then
                    { [[ "${req_actor_slot[$ref]}" == "$self_slot" ]] && [[ "${req_actor_session[$ref]:-}" == "$self_session" ]]; } || continue
                else
                    [[ "$sender" == "$self" ]] || continue
                fi
                ;;
            inbox)
                if [[ -n "${req_target_slot[$ref]:-}" && -n "$self_slot" ]]; then
                    { [[ "${req_target_slot[$ref]}" == "$self_slot" ]] && [[ "${req_target_session[$ref]:-}" == "$self_session" ]]; } || continue
                else
                    [[ "$target" == "$self" ]] || continue
                fi
                ;;
            all) ;;
        esac
        status="pending"
        summary="${req_summary[$ref]}"
        if [[ -n "${reply_summary[$ref]:-}" ]]; then
            # Replied when the reply's actor is the request's TARGET and its target is the
            # request's SENDER — matched by SLOT when available, else by name (churn-proof).
            if [[ -n "${req_target_slot[$ref]:-}" && -n "${reply_actor_slot[$ref]:-}" ]]; then
                if [[ "${reply_actor_slot[$ref]}" == "${req_target_slot[$ref]}" && "${reply_actor_session[$ref]:-}" == "${req_target_session[$ref]:-}" && "${reply_target_slot[$ref]:-}" == "${req_actor_slot[$ref]:-}" && "${reply_target_session[$ref]:-}" == "${req_actor_session[$ref]:-}" ]]; then
                    status="replied"
                    summary="${reply_summary[$ref]}"
                fi
            elif [[ "${reply_actor[$ref]:-}" == "$target" && "${reply_target[$ref]:-}" == "$sender" ]]; then
                status="replied"
                summary="${reply_summary[$ref]}"
            fi
        fi
        printf "%-8s %-8s %-28s %-20s %-20s %s\n" "$status" "${req_kind[$ref]}" "$ref" "$sender" "$target" "$summary"
    done
}

# say:
helper_say_usage() {
    cat >&2 <<'USAGE'
Usage: say <text>          # push a free-text line to the Telegram chat
       echo "text" | say   # multi-line / long replies via stdin

Emits a `chat` event the telegram bridge forwards. Requires the bridge running
with `chat` in its [telegram] include filter (see `ae telegram status`).
USAGE
    exit 2
}

helper_say_main() {
    if [[ $# -gt 0 ]]; then
        text="$*"
    elif [[ ! -t 0 ]]; then
        text="$(cat)"
    else
        helper_say_usage
    fi

    # Reject empty / whitespace-only payloads — nothing to forward.
    if [[ -z "${text//[$' \t\n\r']/}" ]]; then
        helper_say_usage
    fi

    ae_emit_event "chat" "" "" "$text"
    printf 'Sent to Telegram bridge (chat): %.60s%s\n' "$text" "$([[ ${#text} -gt 60 ]] && printf '…')"
}

# memo:
helper_memo_usage() {
    echo "Usage: memo add [--topic <topic>] <text> | memo read [--topic <topic>] | memo tail [n]" >&2
    exit 1
}

helper_memo_render() {
    awk -F '\t' -v topic_filter="${1:-}" 'NF >= 4 && (topic_filter == "" || $3 == topic_filter) { printf "%s — %s", $1, $2; if ($3 != "general") printf " [%s]", $3; printf "\n%s\n\n", $4 }' "${2:-$MEMO_FILE}"
}

helper_memo_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    MEMO_FILE="${META_DIR}/memo.tsv"
    cmd="${1:-read}"
    shift || true
    case "$cmd" in
        add)
            topic="general"
            if [[ "${1:-}" == "--topic" ]]; then
                [[ $# -ge 3 ]] || helper_memo_usage
                topic="$2"
                shift 2
            fi
            [[ $# -ge 1 ]] || helper_memo_usage
            text="$*"
            topic="${topic//$'\r'/}"
            topic="${topic//$'\t'/ }"
            topic="${topic//$'\n'/ }"
            text="${text//$'\r'/}"
            text="${text//$'\t'/ }"
            text="${text//$'\n'/ }"
            self="$(ae_current_agent_ref)"
            [[ -n "$self" ]] || self="human"
            [[ -n "$topic" ]] || topic="general"
            ae_log_append "$MEMO_FILE" "$(printf '%s\t%s\t%s\t%s' "$(ae_now_utc)" "$self" "$topic" "$text")"
            ae_emit_event "memo" "" "$topic" "$text"
            ;;
        read)
            topic=""
            if [[ "${1:-}" == "--topic" ]]; then
                [[ $# -eq 2 ]] || helper_memo_usage
                topic="$2"
            elif [[ $# -gt 0 ]]; then
                helper_memo_usage
            fi
            [[ -f "$MEMO_FILE" ]] || exit 0
            helper_memo_render "$topic"
            ;;
        tail)
            [[ $# -le 1 ]] || helper_memo_usage
            count="${1:-10}"
            [[ "$count" =~ ^[0-9]+$ ]] || helper_memo_usage
            [[ -f "$MEMO_FILE" ]] || exit 0
            tmp_file="$(mktemp)"
            tail -n "$count" "$MEMO_FILE" >"$tmp_file"
            helper_memo_render "" "$tmp_file"
            rm -f "$tmp_file"
            ;;
        *) helper_memo_usage ;;
    esac
}

# goal:
helper_goal_usage() {
    echo "Usage: goal            # show the session goal" >&2
    echo "       goal <text>     # set it (one line)" >&2
    echo "       goal --clear    # remove it" >&2
    exit 1
}

helper_goal_main() {
    case "${1:-}" in
        "")
            current="$(ae_meta_get goal)"
            if [[ -n "$current" ]]; then
                printf '%s\n' "$current"
            else
                echo "(no goal set)"
            fi
            ;;
        --clear)
            [[ $# -eq 1 ]] || helper_goal_usage
            ae_meta_unset goal
            ae_emit_event "goal" "" "" "goal cleared"
            echo "Goal cleared."
            ;;
        --help | -h)
            helper_goal_usage
            ;;
        *)
            text="$*"
            # One printable line only: newlines/tabs become spaces, every other control
            # byte (ESC, BEL, …) is dropped. The value fans out to meta (line-oriented),
            # events.jsonl + list --json (escapers don't cover C0 controls), the list
            # table, and the watchdog nudge — none of which may carry raw controls.
            text="$(printf '%s' "$text" | tr '\n\t' '  ' | tr -d '[:cntrl:]')"
            [[ -n "$text" ]] || helper_goal_usage
            ae_meta_set goal "$text" || {
                echo "Error: could not write session meta" >&2
                exit 1
            }
            ae_emit_event "goal" "" "" "$text"
            echo "Goal set: $text"
            ;;
    esac
}

# peek:
helper_peek_main() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: peek <agent-name|pane-id|@session:agent> [lines]" >&2
