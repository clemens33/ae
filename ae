# _register-sid:
helper_register_sid_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    SLOT="${1:-default}"
    TARGET_CWD="$(realpath "$PWD" 2>/dev/null || echo "$PWD")"
    ESCAPED_SLOT="${SLOT//./\\.}"
    # Read launch_time from meta to filter stale sessions (default 0 = accept all)
    LAUNCH_TIME="$(grep "^launch_time\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [ -z "$LAUNCH_TIME" ]; then
        LAUNCH_TIME="$(grep "^codex_launch_time\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || echo 0)"
    fi
    case "$LAUNCH_TIME" in
        '' | *[!0-9]*)
            LAUNCH_TIME=0
            ;;
    esac
    LAUNCH_ID="$(grep "^launch_id\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [ -z "$LAUNCH_ID" ]; then
        LAUNCH_ID="$(grep "^codex_launch_id\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    best_id="" best_mtime=0
    # Scan today and yesterday (handles UTC midnight rollover)
    for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do
        [ -z "$day" ] && continue
        dir="$HOME/.codex/sessions/${day}"
        [ -d "$dir" ] || continue
        for f in "$dir"/*.jsonl; do
            [ -f "$f" ] || continue
            mtime="$(_ae_stat mtime "$f" || echo 0)"
            [ "$mtime" -lt "$LAUNCH_TIME" ] && continue
            if [ -n "$LAUNCH_ID" ]; then
                grep -Fq "AE_CODEX_LAUNCH_ID=${LAUNCH_ID}" "$f" 2>/dev/null || continue
            fi
            first_line="$(head -1 "$f" 2>/dev/null || true)"
            [ -z "$first_line" ] && continue
            if [ "$mtime" -gt "$best_mtime" ]; then
                file_id="$(echo "$first_line" | _ae_json_first id '[0-9a-f-]' 2>/dev/null || true)"
                if [ -n "$file_id" ]; then
                    best_id="$file_id"
                    best_mtime="$mtime"
                fi
            fi
        done
    done
    if [ -z "$best_id" ]; then
        for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do
            [ -z "$day" ] && continue
            dir="$HOME/.codex/sessions/${day}"
            [ -d "$dir" ] || continue
            for f in "$dir"/*.jsonl; do
                [ -f "$f" ] || continue
                mtime="$(_ae_stat mtime "$f" || echo 0)"
                [ "$mtime" -lt "$LAUNCH_TIME" ] && continue
                first_line="$(head -1 "$f" 2>/dev/null || true)"
                [ -z "$first_line" ] && continue
                file_cwd="$(echo "$first_line" | _ae_json_first cwd 2>/dev/null || true)"
                [ -z "$file_cwd" ] && continue
                file_cwd="$(realpath "$file_cwd" 2>/dev/null || echo "$file_cwd")"
                [ "$file_cwd" != "$TARGET_CWD" ] && continue
                if [ "$mtime" -gt "$best_mtime" ]; then
                    file_id="$(echo "$first_line" | _ae_json_first id '[0-9a-f-]' 2>/dev/null || true)"
                    if [ -n "$file_id" ]; then
                        best_id="$file_id"
                        best_mtime="$mtime"
                    fi
                fi
            done
        done
    fi
    if [ -n "$best_id" ]; then
        echo "$best_id" >"$META_DIR/codex.${SLOT}.sid"
        echo "registered session $best_id for slot $SLOT"
    else
        echo "no codex session found matching cwd $TARGET_CWD" >&2
        exit 1
    fi
}

# events-tail:
# Extract a JSON string value for a flat key from one of our own events.jsonl
# lines. Walks character by character so escaped quotes (\") and backslashes
# (\\) inside the value don't terminate the parse early. Handles the same
# escape sequences ae_emit_event produces: \\, \", \n, \t, \r.
helper_events_tail_extract_json_str() {
    local line="$1" key="$2"
    local prefix="\"${key}\":\""
    local rest="${line#*"${prefix}"}"
    [[ "$rest" == "$line" ]] && return
    local result="" i=0 n=${#rest}
    local c next
    while ((i < n)); do
        c="${rest:$i:1}"
        if [[ "$c" == "\\" ]]; then
            next="${rest:$((i + 1)):1}"
            case "$next" in
                n) result+=" " ;;
                t) result+=" " ;;
                r) ;;
                '"') result+='"' ;;
                "\\") result+="\\" ;;
                *) result+="$c$next" ;;
            esac
            i=$((i + 2))
        elif [[ "$c" == '"' ]]; then
            break
        else
            result+="$c"
            i=$((i + 1))
        fi
    done
    printf '%s' "$result"
}

helper_events_tail_format_event() {
    local line="$1"
    [[ -n "$line" ]] || return
    [[ "$line" == \{* ]] || return
    local ts actor action target summary short_ts
    ts="$(helper_events_tail_extract_json_str "$line" ts)"
    actor="$(helper_events_tail_extract_json_str "$line" actor)"
    action="$(helper_events_tail_extract_json_str "$line" action)"
    target="$(helper_events_tail_extract_json_str "$line" target)"
    summary="$(helper_events_tail_extract_json_str "$line" summary)"
    # Display 'MM-DDTHH:MM:SS' (14 chars) so day rollovers are visible in the
    # monitor pane. Full ISO timestamp stays in events.jsonl for audit.
    short_ts="${ts:5:14}"
    if ((${#summary} > 60)); then
        summary="${summary:0:57}..."
    fi
    if [[ -n "$target" ]]; then
        printf '%s  %-8s %-22s → %-22s %s\n' "$short_ts" "$action" "$actor" "$target" "$summary"
    else
        printf '%s  %-8s %-22s   %-22s %s\n' "$short_ts" "$action" "$actor" "" "$summary"
    fi
}

helper_events_tail_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    # The Rust core serves this surface when the session pins one (P2.7, the
    # last helper of P2): `_events-tail <meta-dir>` — the shim hands the dir,
    # the helper takes no argument of its own. The shim EXECs the core, so
    # nothing below runs unless the core is unbound, unusable or refused with
    # AE_CORE= — then this body is the whole helper, as it always was.
    # --quiet: this pane's stderr is read by nobody, and the unusable-core
    # complaint is spent ONCE per session — spending it here would leave the
    # next helper the operator runs silent about a fault they must see.
    _ae_core_try --quiet _events-tail || true
    EVENTS_FILE="${META_DIR}/events.jsonl"

    # Banner printed once at the top of the pane's scrollback.
    printf '\033[1;36m'
    printf '╭─ ae events — session: %s ───────────────────────────────╮\n' "${META_DIR##*/}"
    printf '│ date+time (UTC)  action   actor                  → target                 summary\n'
    printf '╰──────────────────────────────────────────────────────────────────────────╯\n'
    printf '\033[0m\n'

    # Wait for events file (it is created lazily on first emit)
    while [[ ! -f "$EVENTS_FILE" ]]; do
        sleep 1
    done

    # Replay last 30 events, then follow new ones
    tail -n 30 -f "$EVENTS_FILE" 2>/dev/null | while IFS= read -r line; do
        helper_events_tail_format_event "$line"
    done
}

# — watchdog template functions (emitted into the watchdog helper; the
#   runtime flow lives in helper_watchdog_main, emitted last) —

_watchdog_is_running() {
    [[ -f "$PIDFILE" ]] || return 1
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    # Dead or empty pid → stale pidfile; clean it and report not running.
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PIDFILE" 2>/dev/null
        return 1
    fi
    # The pid is alive — but a stale pidfile can point at a RECYCLED, unrelated
    # process (kill -0 succeeds on it). Require our OWN watchdog pane
    # (@ae_agent=_watchdog) to be live in this session too — _monitor_find_pane is
    # list-panes -s on our own server. No pane → not really running: clean the
    # stale pidfile so 'status' can't lie, 'start' won't wrongly defer, and 'stop'
    # won't kill the innocent process. Safe against a starting watchdog:
    # _watchdog_start tags the pane before _run writes the pidfile, so whenever the
    # pidfile exists our pane exists too.
    if [[ -z "$(_monitor_find_pane _watchdog)" ]]; then
        rm -f "$PIDFILE" 2>/dev/null
        return 1
    fi
    return 0
}

_set_meta_kv() {
    local key="$1" value="$2"
    local meta_file="${META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 0
    {
        flock -w 5 200 || return 1
        local tmp="${META_DIR}/meta.tmp.$$"
        awk -F= -v k="$key" -v v="$value" '
            BEGIN { updated = 0 }
            $1 == k { print k "=" v; updated = 1; next }
            { print }
            END { if (!updated) print k "=" v }
        ' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${META_DIR}/meta.lock"
}

_unset_meta_kv() {
    local key="$1"
    local meta_file="${META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 0
    {
        flock -w 5 200 || return 1
        local tmp="${META_DIR}/meta.tmp.$$"
        awk -F= -v k="$key" '$1 != k { print }' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${META_DIR}/meta.lock"
}

_set_meta_watchdog() { _set_meta_kv "watchdog" "$1"; }

_monitor_find_pane() {
    # Stdout: pane_id of the pane in this session tagged with @ae_agent=$1, or empty.
    tmux list-panes -s -t "$_AE_SESSION" -F '#{pane_id} #{@ae_agent}' 2>/dev/null |
        awk -v want="$1" '$2 == want { print $1; exit }'
}

# Idempotent. Creates the hidden ae-monitor window with the _events pane if
# it doesn't already exist. Sets MONITOR_EVENTS_PANE to the pane id.
# Called by session launch and by _watchdog_start.
_monitor_ensure_events_pane() {
    MONITOR_EVENTS_PANE="$(_monitor_find_pane _events)"
    [[ -n "$MONITOR_EVENTS_PANE" ]] && return 0
    # Pin the monitor window at a high fixed index so it stays RIGHTMOST in
    # the tmux footer — spawned worker windows slot in between it and the main
    # window. Fallback: append-after-current if 99 is somehow taken.
    MONITOR_EVENTS_PANE="$(tmux new-window -d -t "${_AE_SESSION}:99" -n "ae-monitor" -P -F '#{pane_id}' \
        "${META_DIR}/events-tail" 2>/dev/null ||
        tmux new-window -da -t "$_AE_SESSION" -n "ae-monitor" -P -F '#{pane_id}' \
            "${META_DIR}/events-tail" 2>/dev/null)" || {
        echo "Error: could not create monitor window" >&2
        return 1
    }
    tmux set-option -p -t "$MONITOR_EVENTS_PANE" @ae_agent "_events" 2>/dev/null || true
    tmux select-pane -t "$MONITOR_EVENTS_PANE" -T "ae events" 2>/dev/null || true
    tmux set-window-option -t "${_AE_SESSION}:ae-monitor" pane-border-status top 2>/dev/null || true
    tmux select-pane -t "$MONITOR_EVENTS_PANE" -d 2>/dev/null || true
    return 0
}

_watchdog_ensure_monitor() {
    _monitor_ensure_events_pane || exit 1
    exit 0
}

# Transition shim (loop → watchdog rename). The short-lived local shepherd branch
# and released loop versions can leave OLD artifacts: .shepherd.pid / _shepherd /
# .shepherd.status or .loop.pid / _loop / .loop.status. A 'doctor --refresh'
# rewrites helpers but does NOT restart a running watchdog, so that legacy process
# can outlive the rename. Reap it before we start or stop, so we never run two
# watchdogs at once, never leave a stray legacy pane the new watchdog would
# mis-classify as an agent, and so deprecated commands actually stop a legacy one.
# Idempotent + silent. Keep the _shepherd reap only as a local transition aid; it
# is not a public compatibility surface.
_watchdog_reap_legacy_one() {
    local legacy_name="$1"
    local legacy_pid_file="${META_DIR}/.${legacy_name}.pid" legacy_status_file="${META_DIR}/.${legacy_name}.status"
    local legacy_pid legacy_pane
    legacy_pane="$(_monitor_find_pane "_${legacy_name}")"
    # A *live* legacy watchdog is pinned to its legacy monitor pane. Only when
    # that pane exists do we kill the recorded pid — otherwise the pid file is a
    # stale artifact from a crashed watchdog whose pid may have been reused by an
    # unrelated process, and killing it blindly would be wrong. With no pane, just
    # clean up.
    if [[ -n "$legacy_pane" ]]; then
        if [[ -f "$legacy_pid_file" ]]; then
            legacy_pid="$(cat "$legacy_pid_file" 2>/dev/null || true)"
            if [[ -n "$legacy_pid" ]]; then kill "$legacy_pid" 2>/dev/null || true; fi
        fi
        tmux kill-pane -t "$legacy_pane" 2>/dev/null || true
    fi
    rm -f "$legacy_pid_file" "$legacy_status_file"
}

_watchdog_reap_legacy() {
    _watchdog_reap_legacy_one "shepherd"
    _watchdog_reap_legacy_one "loop"
}

_watchdog_stop() {
    # Reap a pre-rename watchdog first (see _watchdog_reap_legacy). Note whether one
    # was present so we still report "stopped" even if no current watchdog ran.
    local had_legacy="no"
    if [[ -f "${META_DIR}/.shepherd.pid" || -n "$(_monitor_find_pane _shepherd)" || -f "${META_DIR}/.loop.pid" || -n "$(_monitor_find_pane _loop)" ]]; then
        had_legacy="yes"
    fi
    _watchdog_reap_legacy

    local stopped="no"
    if _watchdog_is_running; then
        local pid
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        # Clear the live status user options so the bars fall back (left → just path).
        _watchdog_clear_bar_options
        # Kill only the _watchdog pane; leave the _events pane and monitor window alive.
        local watchdog_pane
        watchdog_pane="$(_monitor_find_pane _watchdog)"
        if [[ -n "$watchdog_pane" ]]; then tmux kill-pane -t "$watchdog_pane" 2>/dev/null || true; fi
        stopped="yes"
    fi

    if [[ "$stopped" == "yes" || "$had_legacy" == "yes" ]]; then
        echo "Watchdog stopped."
    else
        echo "Watchdog is not running."
    fi
    _set_meta_watchdog "false"
    exit 0
}

_watchdog_status() {
    if _watchdog_is_running; then
        echo "Watchdog is running (pid $(cat "$PIDFILE"))."
    else
        echo "Watchdog is not running."
    fi
    exit 0
}

_watchdog_start() {
    # A pre-rename watchdog may still be running under legacy artifacts after an
    # upgrade + refresh (helpers are rewritten but the running watchdog is not
    # restarted). Reap it first so we never run two watchdogs side by side.
    _watchdog_reap_legacy
    # Idempotent: if a current watchdog is already running, just confirm the meta
    # flag and exit — do NOT touch status-right (its indicator must stay live).
    if _watchdog_is_running; then
        echo "Watchdog is already running (pid $(cat "$PIDFILE"))."
        _set_meta_watchdog "true"
        exit 0
    fi
    # Make sure the ae-monitor window with the _events pane exists; insert the
    # _watchdog pane above it so the visual order stays watchdog-on-top / events-below.
    _monitor_ensure_events_pane || exit 1
    local watchdog_pane
    watchdog_pane="$(tmux split-window -v -b -t "$MONITOR_EVENTS_PANE" -P -F '#{pane_id}' \
        "${META_DIR}/watchdog _run" 2>/dev/null)" || {
        echo "Error: could not create watchdog pane" >&2
        exit 1
    }
    tmux set-option -p -t "$watchdog_pane" @ae_agent "_watchdog" 2>/dev/null || true
    tmux select-pane -t "$watchdog_pane" -T "ae watchdog" 2>/dev/null || true
    # Read-only: disable input on the watchdog pane (events pane was already disabled).
    tmux select-pane -t "$watchdog_pane" -d 2>/dev/null || true
    # status-right is OWNED BY AE (_ae_apply_status_bar bakes '[path git] [watch …]' with
    # the #{@ae_watchdog_status} reference at the END). The watchdog never rewrites the
    # bar — it only feeds the user option each cycle — so there is nothing to capture,
    # save, prepend, restore, or dedup here, and start/stop are idempotent by shape.
    _set_meta_watchdog "true"
    echo "Watchdog started in hidden ae-monitor window. Use 'peek _watchdog' or 'peek _events' to inspect."
    exit 0
}

_last_event_age() {
    local actor="$1"
    local events_file="${META_DIR}/events.jsonl"
    [[ -f "$events_file" ]] || {
        echo 999999
        return
    }
    local last_ts
    last_ts="$(grep "\"actor\":\"${actor}\"" "$events_file" | tail -1 | sed -n 's/.*"ts":"\([^"]*\)".*/\1/p')"
    if [[ -z "$last_ts" ]]; then
        echo 999999
        return
    fi
    local last_epoch now_epoch
    last_epoch="$(_ae_epoch "$last_ts")"
    now_epoch="$(date +%s)"
    echo $((now_epoch - last_epoch))
}

# <agent> [skip_watchdog_nudges] — with the flag, ONE reverse pass consumes any
# consecutive watchdog nudges and returns the relevant event underneath them, setting
# _LRE_SKIPPED_NUDGE=1 when it did.
#
# BY POSITION, NEVER BY TIMESTAMP. The first version bounded the look-back with
# `ts < before_ts`, and events.jsonl timestamps are 1-second — so a declaration and
# the nudge that answered it, written in the same second, compared equal and the
# bound skipped the DECLARATION too. Append order is the truth here; the timestamp is
# its lossy rendering, and reasoning about order from a display form is the same
# family as reading state out of rendered text.
_latest_relevant_event() {
    local agent="$1" skip_nudges="${2:-}"
    _LRE_SKIPPED_NUDGE=0
    _LRE_ROW=""
    local events_file="${META_DIR}/events.jsonl"
    [[ -f "$events_file" ]] || return 0
    local line actor target action ts ref summary
    # Walk newest→oldest and stop at the first event mentioning the agent.
    # Unbounded by design: a quiet state must stay valid until a *newer* event
    # for this agent invalidates it, no matter how many unrelated events follow.
    # Emits 5 tab-separated fields: action, ts, ref, actor, summary (ref/summary
    # may be empty). actor lets callers distinguish the agent's OWN declaration
    # from an inbound event that merely targets it; summary lets them build a
    # declaration-identity key that survives second-resolution timestamps.
    # ae_emit_event strips tabs/newlines from summary, so it is safe last.
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        _event_json_str "$line" actor
        actor="$_EV"
        _event_json_str "$line" target
        target="$_EV"
        if [[ "$actor" == "$agent" || "$target" == "$agent" || "$target" == "@${_AE_SESSION}:${agent}" ]]; then
            _event_json_str "$line" action
            action="$_EV"
            _event_json_str "$line" ts
            ts="$_EV"
            # Walk PAST the watchdog's own nudges — however many are stacked up, and
            # whatever second they were written in.
            if [[ -n "$skip_nudges" && "$actor" == "watchdog" && "$action" == "nudge" ]]; then
                _LRE_SKIPPED_NUDGE=1
                continue
            fi
            _event_json_str "$line" ref
            ref="$_EV"
            _event_json_str "$line" summary
            summary="$_EV"
            _LRE_ROW="$(printf '%s\t%s\t%s\t%s\t%s' "$action" "$ts" "$ref" "$actor" "$summary")"
            printf '%s\n' "$_LRE_ROW"
            return 0
        fi
    done < <(_ae_tac "$events_file" 2>/dev/null || true)
}

# The agent's current self-declared quiet state, or empty. Quiet states tell the
# watchdog to stop nudging: done | waiting-user | blocked. Emits 'reason<TAB>key'
# where key is the full declaration tuple (action|ts|ref|actor|summary) — used by
# the pane-activity escape hatch to identify a declaration across cycles and
# re-arm on a genuinely new one. Empty when the newest relevant event is working,
# an inbound message (invalidates the prior quiet state), or anything else. Legacy
# action=done events (pre-state-helper, and the retained dual-emit) map to done.
_agent_quiet_reason() {
    local agent="$1"
    local row action ts ref actor summary rest
    # One pass that already looks past the watchdog's own nudges (by position).
    # CALLED BARE. The pass reports whether it skipped a nudge through a global, and a
    # $( ) capture is a subshell that swallows exactly that — the hazard the sweep
    # path already carries a note about. Read the row from the global too.
    _latest_relevant_event "$agent" skip >/dev/null
    row="${_LRE_ROW:-}"
    [[ -n "$row" ]] || return 0
    local _looked_past="${_LRE_SKIPPED_NUDGE:-0}"
    # Manual tab split — `IFS=$'\t' read` collapses the empty ref field (tab is
    # whitespace-IFS), which would shift fields left and corrupt actor.
    action="${row%%$'\t'*}"
    rest="${row#*$'\t'}"
    ts="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    ref="${rest%%$'\t'*}"
    rest="${rest#*$'\t'}"
    actor="${rest%%$'\t'*}"
    summary="${rest#*$'\t'}"
    # Only the agent's OWN declaration is a quiet state. If the newest relevant
    # event is inbound (actor != agent — a send/ask targeting it), the prior quiet
    # state is invalidated and the agent is no longer quiet.
    #
    # EXCEPT the watchdog's own nudge. Measured 2026-08-02 and reproduced by driving
    # these functions: the nudge is an inbound event, so it invalidated the very
    # state it was asking about — one nudge and the agent stopped being quiet no
    # matter what the pane said. The watchdog then nudged again, and again. A quiet
    # state must be broken by NEWS, and the watchdog asking "are you still waiting?"
    # is not news; a human or a peer writing to the agent is.
    # Inbound events other than our own nudges still invalidate: a human or a peer
    # writing to the agent is news, and news ends a quiet state.
    [[ "$actor" == "$agent" ]] || return 0
    local reason=""
    case "$action" in
        done) reason="done" ;;
        state)
            case "$ref" in
                done | waiting-user | blocked) reason="$ref" ;;
            esac
            ;;
    esac
    [[ -n "$reason" ]] || return 0
    # The look-past is scoped to the states #8 is about. done is EVENT-ONLY quiet and
    # its documented contract is "honoured until a newer MESSAGE arrives" — a nudge is
    # a message, and clearing done on one is deliberate, pinned behaviour. It is also
    # unreachable in practice (the watchdog skips done agents before it would nudge),
    # so widening the exception there would change a documented rule to fix nothing.
    if ((_looked_past == 1)) && [[ "$reason" == "done" ]]; then
        return 0
    fi
    # Emit 'reason<TAB>key'. The key is the full declaration tuple so the
    # watchdog's baseline re-arms on a genuinely new declaration even when two
    # land in the same (second-resolution) timestamp — as long as any field
    # (typically the summary/reason) differs. Byte-identical same-second
    # re-declares remain indistinguishable, which is acceptable.
    printf '%s\t%s' "$reason" "${action}|${ts}|${ref}|${actor}|${summary}"
}

# Escape hatch for waiting-user/blocked, using a per-pane baseline hash. The
# declaration's own echo (the `state` helper prints to the pane) means the
# global last_hash_change can't distinguish that echo from a later human reply.
# So we ARM a baseline with the pane hash the first time a declaration is seen
# (the echo is already part of it), then HOLD while the hash matches that
# baseline and YIELD once it changes (human reply / agent output). The
# declaration is identified by its full-tuple key (not just timestamp) so a
# fresh declaration re-arms even within the same second.
# Args: cur_hash armed_key armed_hash decl_key
# Prints: arm | hold | yield
# The pane view the quiet-state baseline is hashed from, with the watchdog's OWN
# footprints removed:
#   - its nudge, identified by the origin envelope the helper stamps on it (#39) and
#     by the nudge's own sentence, so a wrapped render still loses its first line
#   - the state helper's echo, which is what a bare re-declaration puts on screen
# Everything else — the human's reply, the agent's real output — stays in the hash.
_watchdog_quiet_hash() {
    local buf="$1"
    # THE SPECIMEN MUST COME FROM THE LAYER THE CODE READS. This hashes what the TUI
    # RENDERS, so the shapes below are captured renderings, not the delivered text —
    # an earlier version matched the bytes ae sends and filtered nothing at all,
    # because no modeled TUI shows a message the way it arrives.
    #
    # CAPTURED 2026-08-15 with the watchdog's own `capture-pane -p -J`, a real nudge
    # delivered through ae's paste primitive:
    #
    #   codex   › ⟦ae:msg from watchdog⟧
    #             Status check: if you have more work, continue. Otherwise declare …
    #             user|blocked|done> "<reason>"
    #   claude  ❯ ⟦ae:msg from watchdog⟧
    #             Status check: if you have more work, continue. Otherwise declare …
    #             <waiting-user|blocked|done> "<reason>"
    #
    # Same structure in both: a SUBMIT ORNAMENT plus the envelope alone on its line,
    # then two-space-indented continuations wrapped at whatever width the pane had.
    # The wrap point is not stable, so the body is consumed as a BLOCK rather than
    # matched — the header is the discriminator, and it is short enough never to wrap.
    #
    # That header is also what separates a watchdog nudge from an agent QUOTING one:
    # quoted text renders as ordinary prose with no submit ornament and no envelope
    # above it, so it survives into the hash and still wakes the watchdog.
    #
    # Echoes, likewise captured:
    #   codex     └ Marked gpt56sol:reviewer done: …
    #   claude  ⏺ [21:28] Done — output: Marked opus5:builder waiting-user: …
    #   raw     Marked opus5:builder waiting-user: …        (unmodeled pane, no TUI)
    printf '%s' "$buf" | awk '
        function submit_hdr(l) { return l ~ /^[[:space:]]*[›❯][[:space:]]+⟦ae:msg from watchdog⟧[[:space:]]*$/ }
        function indented(l)   { return l ~ /^[[:space:]][[:space:]]/ }
        function raw_nudge(l) {
            return l ~ /^(Session goal: .*\. )?Status check: if you have more work, continue\. Otherwise declare your state so I stop nudging: .*\/state <waiting-user\|blocked\|done> "<reason>"[[:space:]]*$/
        }
        function raw_env(l)  { return l ~ /^⟦ae:msg from watchdog⟧[[:space:]]*$/ }
        function is_echo(l) {
            if (l ~ /^[[:space:]]*└[[:space:]]+Marked [^ ]+ (working|waiting-user|blocked|done)([:.].*)?$/) return 1
            # The CAPTURED status grammar, not "anything mentioning output:". The loose
            # version swallowed ordinary assistant prose that happened to contain
            # "output: Marked …" — deaf in the yield direction, which is the failure
            # this filter must never introduce. Bytes from the capture:
            #   ⏺ SP [HH:MM] SP Done SP U+2014 SP output: SP Marked …
            if (l ~ /^⏺ \[[0-9][0-9]:[0-9][0-9]\] Done — output: Marked [^ ]+ (working|waiting-user|blocked|done)([:.].*)?$/) return 1
            if (l ~ /^Marked [^ ]+ (working|waiting-user|blocked|done)([:.].*)?$/) return 1
            return 0
        }
        {
            # Inside a rendered nudge block: swallow its indented body.
            if (in_block) { if (indented($0)) next; in_block = 0 }
            # A held raw envelope is only dropped when the raw nudge follows it.
            if (held != "") {
                if (raw_nudge($0)) { held = ""; next }
                print held; held = ""
            }
            if (submit_hdr($0)) { in_block = 1; next }   # rendered, both modeled TUIs
            if (raw_env($0))    { held = $0; next }      # unmodeled pane: pair form
            if (raw_nudge($0))  next                     # unmodeled / legacy watchdog
            if (is_echo($0))    next
            print
        }
        END { if (held != "") print held }
    ' | _ae_md5 | cut -d' ' -f1
    return 0
}

# <cur-hash> <armed-key> <armed-hash> <decl-key> [settles] [settle-max]
#
# ARM ON THE FIRST *STABLE* PANE. An agent declares its state with a TOOL CALL and
# emits its final message AFTER — every harness works that way, the final text is what
# ends the turn. So the pane is guaranteed to change once more right after the
# declaration, and baselining the first observed pane meant the agent broke its own
# hold: measured live, a waiting-user declaration at 09:05:55Z was nudged at 10:36:43Z
# through branch 5, which is reachable only after the quiet branch had YIELDED.
#
# The gap is the SECONDS between the tool call and the message; a 60s cycle is a
# terrible unit for measuring it. So the baseline is settled WITHIN the arming cycle
# (see _quiet_stabilize) and the verdict stays the crisp three it always was: a change
# in any LATER cycle is unambiguously not the declaration's own echo and yields, which
# is what keeps a human's in-pane reply — an event that exists nowhere else — audible.
#
# A cross-cycle "re-arm on change" was tried and rejected: it cannot tell the agent's
# echo from a human reply that lands in the same window, so a wedged agent owing the
# human an answer would have looked quiet forever. That is a worse failure than the bug
# it fixed, and the direction matters more than the count.
_quiet_pane_decision() {
    local cur="$1" armed_key="$2" armed_hash="$3" decl_key="$4"
    if [[ "$armed_key" != "$decl_key" ]]; then
        printf 'arm'
    elif [[ "$cur" == "$armed_hash" ]]; then
        printf 'hold'
    else
        printf 'yield'
    fi
    return 0
}

# ONE definition of how a pane is captured FOR HASHING. The stabilizer and the main
# loop must see identical bytes: two capture ranges over the same pane produce two
# different hashes, so a baseline taken by one can never equal a hash taken by the
# other. Measured on this session's own panes — `-p -J` against `-p -J -S -40 -E -`
# diverged on 8 of 12 live panes (%224: 35 lines vs 36, two different hashes), which
# meant a quiet state held for exactly its arming cycle and then yielded into the
# stale timer. Same class as the facts #30/#43 stopped re-deriving: two sites
# computing one thing, kept in step by hand.
#
# (_pane_shows_throttle captures its own -S -15 window deliberately: it greps a tail
# for error text and never feeds a hash, so it is not a second definition of this.)
# Status is PRESERVED: `|| true` here turned a failed capture into empty output, and
# two empty samples hash equal — so an unreadable or dying pane settled instantly and
# was classified QUIET. Callers that genuinely tolerate failure say so at their own
# call site; the stabilizer must not.
_watchdog_capture_pane() { # <pane>
    tmux capture-pane -p -J -S -40 -E - -t "$1" 2>/dev/null
}

# How many panes may pay the stabilization beat in a single cycle, AND WHICH ONES.
# The budget alone is bounded but not fair: list-panes is traversed in the same order
# every cycle and an unsettled attempt stores no baseline, so the first two permanently
# unsettled panes consumed both slots forever and panes 3+ were NEVER attempted — they
# aged out of their active/recent windows and got nudged while holding a perfectly good
# waiting-user declaration. That is the very bug this slice exists to fix, displaced
# onto later panes.
#
# So eligibility is budget AND position: a rotating cursor remembers where the cycle
# stopped and the next one resumes there. Less state than per-pane backoff, and it
# cannot itself starve — every pane is reached within one full rotation.
_quiet_stabilize_allowed() { # <spent-this-cycle> <per-cycle-max> [pane-index] [cursor]
    local spent="$1" max="$2" idx="${3:-0}" cursor="${4:-0}"
    ((spent < max)) || return 1
    ((idx >= cursor))
}

# Where the next cycle starts. Wrap when this cycle did not spend its budget (everyone
# reachable was offered a turn) or when the cursor has run past the last pane.
_quiet_cursor_advance() { # <cursor> <spent> <max> <panes-seen> -> next cursor
    local cursor="$1" spent="$2" max="$3" seen="$4"
    if ((spent < max)) || ((cursor > seen)); then
        printf '0'
    else
        printf '%s' "$cursor"
    fi
    return 0
}

# THE CYCLE STEP — the wiring between the budget predicate and the wrap rule, owned in
# ONE place and called by both the watchdog loop and its tests. Driving the two helpers
# separately is not the same as driving the machine: a test that advances its own cursor
# and calls the wrap itself passes even when the product does neither, which is exactly
# how the fairness fix ended up with no regression protection at all. Same medicine as
# the capture range — one definition, both callers — so divergence is impossible rather
# than merely detectable.
#
# State rides globals because bash returns one value and this step answers "may this
# pane stabilize?" while also advancing the cursor. (Precedent: _event_json_str returns
# through _EV for the same reason.)
_quiet_cycle_begin() { # start of a watchdog cycle
    _QS_SPENT=0
    return 0
}

_quiet_cycle_step() { # <pane-index> -> 0 if this pane may stabilize now
    local idx="$1"
    _quiet_stabilize_allowed "$_QS_SPENT" "$_QS_MAX" "$idx" "$_QS_CURSOR" || return 1
    _QS_SPENT=$((_QS_SPENT + 1))
    _QS_CURSOR=$((idx + 1)) # the next cycle resumes after this pane
    return 0
}

_quiet_cycle_end() { # <panes-seen> — rotate for the next cycle
    _QS_CURSOR="$(_quiet_cursor_advance "$_QS_CURSOR" "$_QS_SPENT" "$_QS_MAX" "$1")"
    return 0
}

# Settle the pane WITHIN the arming cycle: sample, wait a beat, sample again, until two
# consecutive samples match or the budget runs out. Returns the settled hash, or EMPTY
# if the pane never held still — which means the agent is still emitting, i.e. working
# rather than waiting, and the caller must fall through to the normal branches.
#
# It is tool-agnostic: no TUI modelling, so unmodeled tools get the same protection.
#
# COST IS BOUNDED PER CYCLE, not per declaration. An earlier comment here claimed this
# runs once per declaration — false for a pane that never settles, because no baseline
# is stored on failure, so it pays every beat again on every cycle. With 23 panes
# arming that is 23s; with 23 unsettled panes it is 92s on top of the unconditional
# 60s sleep, i.e. a ~152s cycle before any other work — the coupled-cadences failure.
# _quiet_stabilize_allowed caps how many panes may stabilize in one cycle; the rest
# simply are not quiet yet and get their turn next cycle.
_quiet_stabilize() { # <pane> <beat-secs> <tries> -> settled hash, or empty
    local pane="$1" beat="$2" tries="$3"
    local prev cur raw i
    # A capture that FAILS is not a still pane. Unreadable or dying panes used to
    # settle immediately here, because two failures both produced empty output and
    # hashed the same.
    raw="$(_watchdog_capture_pane "$pane")" || return 0
    prev="$(_watchdog_quiet_hash "$raw")"
    for ((i = 0; i < tries; i++)); do
        sleep "$beat"
        raw="$(_watchdog_capture_pane "$pane")" || return 0
        cur="$(_watchdog_quiet_hash "$raw")"
        if [[ "$cur" == "$prev" ]]; then
            printf '%s' "$cur"
            return 0
        fi
        prev="$cur"
    done
    return 0
}

# Nudge delivery accounting (#44). Two small answers, kept out of the loop so they can
# be driven directly: a counter that is wrong is invisible in a log nobody diffs.
#
# _nudge_should_attempt: an unreachable pane must stop costing cycles. Each send can
# hold the watchdog ~30s on a defer, so the streak bounds ATTEMPTS, not just alerts.
_nudge_should_attempt() { # <streak> <max>
    local streak="$1" max="$2"
    ((streak < max))
}

# _nudge_delivery_verdict: what an attempt's rc means for the books. rc 0 is the only
# thing that counts as a nudge; everything else is an undelivered attempt, and the one
# that reaches the bound raises the DISTINCT unreachable alert (not the max-nudges one,
# which means "delivered and ignored" — a different problem with a different fix).
_nudge_delivery_verdict() { # <send-rc> <streak> <max>
    local rc="$1" streak="$2" max="$3"
    if ((rc == 0)); then
        printf 'delivered'
    elif ((streak + 1 >= max)); then
        printf 'undelivered-alert'
    else
        printf 'undelivered'
    fi
    return 0
}

_watchdog_meta_value() {
    local key="$1"
    grep "^${key}=" "$META_DIR/meta" 2>/dev/null | head -1 | cut -d= -f2- || true
}

_watchdog_trim() {
    local text="$1" max="${2:-24}"
    text="${text//$'\n'/ }"
    text="${text//$'\r'/ }"
    if ((${#text} > max)); then
        printf '%s~' "${text:0:max-1}"
    else
        printf '%s' "$text"
    fi
}

_watchdog_git() {
    local work_dir="$1"
    shift
    if command -v timeout >/dev/null 2>&1; then
        timeout 2 git -C "$work_dir" "$@" 2>/dev/null
    else
        git -C "$work_dir" "$@" 2>/dev/null
    fi
}

# Live git branch segment, pushed each cycle into the @ae_branch_status tmux user
# option and rendered in status-LEFT after the (static) path — so repo context (path
# + branch) sits together on the left and watchdog health stands alone on the right.
# Emits ' <branch>*' (leading space, no brackets — it sits inside the [ae …] bracket)
# when work_dir is a git repo, else empty. Branch+dirty are the only session facts
# that change during a run, so they're the only thing recomputed per cycle.
_watchdog_branch_segment() {
    local work_dir branch full dirty="" _bs_sid
    work_dir="$(_watchdog_meta_value work_dir)"
    if [[ -z "$work_dir" ]] || ! _watchdog_git "$work_dir" rev-parse --is-inside-work-tree >/dev/null; then
        _bs_sid="$(_watchdog_session_id)"
        if [[ -n "$_bs_sid" ]]; then
            tmux set-option -t "$_bs_sid" -u @ae_branch_name 2>/dev/null || true
        fi
        return 0
    fi
    full="$(_watchdog_git "$work_dir" symbolic-ref --quiet --short HEAD || _watchdog_git "$work_dir" rev-parse --short HEAD || true)"
    branch="$(_watchdog_trim "$full" 24)"
    if [[ -z "$branch" ]]; then
        _bs_sid="$(_watchdog_session_id)"
        if [[ -n "$_bs_sid" ]]; then
            tmux set-option -t "$_bs_sid" -u @ae_branch_name 2>/dev/null || true
        fi
        return 0
    fi
    # Side channel for machine consumers: @ae_branch_name carries the FULL,
    # untrimmed branch (no dirty marker). @ae_branch_status stays display-only
    # (24-char trim + '*') — `ae list --json` must never echo a display trim
    # as the canonical branch.
    _watchdog_set_status @ae_branch_name "$full"
    if [[ -n "$(_watchdog_git "$work_dir" status --porcelain --untracked-files=no | head -1)" ]]; then
        dirty="*"
    fi
    printf ' %s%s' "$branch" "$dirty"
}

# Live status is pushed into tmux user options, read by the bars as
# #{@ae_branch_status} (status-RIGHT, after the static path) and #{@ae_watchdog_status}
# (status-RIGHT health). User-option values are interpolated literally — no shell, no
# #() parsing — so a branch/path with spaces, ), #, etc. is safe with no escaping.
# Cleared on exit so the bars fall back cleanly (left → just the path).
# EXACT session-id lookup. stdin: '<session_id> <session_name>' rows (a
# `list-sessions -F '#{session_id} #{session_name}'` dump); $1: the wanted NAME.
# Prints the matching session id ('$N'), or NOTHING when the session is gone.
#
# Why an id, and why matched here in bash rather than by a tmux target:
#   * tmux session targets PREFIX-MATCH. Reproduced: with 'foo' absent and 'foobar'
#     alive, `set-option -w -t 'foo:0' -u @probe` WIPED foobar's option — a dead
#     session's cleanup silently clobbering a live neighbour's bar.
#   * tmux's documented '=' exact-match prefix is NOT usable here: on tmux 3.4 it works
#     for `has-session` but FAILS for `show-options`/`set-option` ("no such session:
#     =name") and returns nothing from `display-message`. An earlier attempt to anchor
#     with '=' looked like it fixed the clobber only because EVERY write silently failed
#     — it broke the bar entirely and 14 integration tests caught it.
#   * `display-message -t foo '#{session_id}'` PREFIX-MATCHES too — it happily returns
#     foobar's id for a nonexistent 'foo' — so resolving through a tmux target would
#     reintroduce the bug at the lookup layer.
# Matching the name as an exact bash string over a list-sessions dump is the only step
# tmux cannot mis-resolve; the id it yields is unique and stable for the session's life,
# exactly like the '@N' window ids used for the window options.
# EMPTY OUT MEANS SKIP THE WRITE: callers must not fall back to a bare target — an empty
# '-t' would resolve to tmux's *current* session, i.e. someone else's bar.
_roster_session_id() {
    local want="$1" id name
    [[ -n "$want" ]] || return 0
    # Already an id — pass through.
    [[ "$want" == '$'* ]] && {
        printf '%s' "$want"
        return 0
    }
    # `|| [[ -n "$id" ]]`: a final row with no trailing newline makes `read` return
    # nonzero while still assigning — without this the LAST session in the dump is
    # silently invisible, which for a lookup means "gone" and skips its cleanup.
    while read -r id name || [[ -n "$id" ]]; do
        [[ "$name" == "$want" ]] || continue
        printf '%s' "$id"
        return 0
    done
    return 0
}

# Exact session id for an arbitrary NAME on the current tmux server ('' when no session
# of exactly that name is live). The ONE shared "name → exact id" resolver — tmux
# targets PREFIX-MATCH (`has-session -t proj` hits a live `project`), so any liveness or
# live-session operation must resolve here and then target by id, never by the raw name.
# (Third occurrence of the prefix-match class after display-message lookups and option
# writes; _roster_session_id is the shared string-matcher underneath.)
_ae_session_id() {
    tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id "$1"
    return 0
}

# The watchdog's own session id, resolved exactly — now a thin call to the shared
# resolver above (one resolver, not a sibling copy).
_watchdog_session_id() {
    _ae_session_id "$_AE_SESSION"
    return 0
}

_watchdog_set_status() {
    local _sid
    _sid="$(_watchdog_session_id)"
    # No id => the session is gone. Writing with an empty target would land on tmux's
    # CURRENT session — another user's bar. Do nothing instead.
    [[ -n "$_sid" ]] || return 0
    tmux set-option -t "$_sid" "$1" "$2" 2>/dev/null || true
    return 0
}

# Single owner of "put the bars back": called from BOTH the EXIT trap and `watchdog
# stop`, so the two paths cannot drift apart (they already listed the session options
# twice). Verified: bash DOES run an EXIT trap on SIGTERM, so this is the reliable path
# — `watchdog stop` kills the pid and the dying watchdog clears up after itself.
# EXIT cleanup, OWNERSHIP-CHECKED. A stop/start in quick succession can leave the OLD
# watchdog's EXIT trap running after the NEW one is already publishing: unconditional
# cleanup would then delete the new watchdog's pidfile and wipe its live publication —
# the dying process silently vandalising its replacement. Only clean up what is still
# ours. (Full stop/start serialization is a separate ticket; this is the cheap guard.)
_watchdog_exit_cleanup() {
    local _owner=""
    [[ -f "$PIDFILE" ]] && _owner="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "$_owner" && "$_owner" != "$$" ]]; then
        # A newer watchdog owns the pidfile — leave its file AND its bar alone.
        return 0
    fi
    rm -f "$PIDFILE"
    _watchdog_clear_bar_options
    return 0
}

_watchdog_clear_bar_options() {
    local _o _wi
    local _sid
    _sid="$(_watchdog_session_id)"
    [[ -n "$_sid" ]] || return 0
    for _o in @ae_branch_status @ae_branch_name @ae_watchdog_status @ae_agents_status; do
        tmux set-option -t "$_sid" -u "$_o" 2>/dev/null || true
    done
    # @ae_window_status is WINDOW-scoped: a session -u never touches it, so a stopped
    # watchdog would freeze glyphs in the window list forever. Clear each window.
    while read -r _wi; do
        [[ -n "$_wi" ]] || continue
        # By ID: an index can renumber between listing and clearing, which would skip a
        # window and leave its glyphs frozen — the precise failure this cleanup prevents.
        tmux set-option -w -t "$_wi" -u @ae_window_status 2>/dev/null || true
    done < <(tmux list-windows -t "$_sid" -F '#{window_id}' 2>/dev/null || true)
    return 0
}

# ── Agent roster (@ae_agents_status, status-format[1] right side) ────
# Agents live across MULTIPLE WINDOWS, but the status bar renders in every one — so a
# per-agent roster gives whole-org visibility from wherever you happen to be looking.
#
# DESIGN HONESTY (the builder-stall incident): this shows the watchdog's OWN VERDICT
# and nothing else. It must never claim an agent is "working" — pane activity is not
# work (a recap re-render is byte-identical to progress), and the watchdog cannot see
# intent. ● means "the watchdog saw this pane advance this cycle", nothing more. Every
# glyph maps 1:1 onto a branch the cycle ALREADY decides; the roster invents no state.
#
# FOLLOW-UP (post round-4): a ⏸ glyph for staged-but-unsubmitted input, once the
# input-region sensor (_capture_input_region) is consumed by the watchdog. Deliberately
# NOT in v1 — the sensor does not exist here yet, and a glyph we cannot source from a
# real verdict would be exactly the dishonesty this design forbids.
# SUBPROCESS ACTIVITY (⚙) IS DELIBERATELY ABSENT — see the roster memo. The mechanical
# "is a non-shell descendant alive?" sensor cannot carry the meaning it was meant to.
# Measured on a live claude pane: uv, npm, python, chrome-devtools, codebase-memory and
# two MainThread children had all been alive for 4h38m. Those are PERSISTENT MCP
# services, so the sensor answers "yes" permanently — an agent would render ⚙ forever
# and could NEVER show ◌, masking exactly the stuck agents this bar exists to surface.
# Existence of a child is not evidence of work. A real sensor must measure ACTIVITY
# (e.g. CPU-time delta for the subtree between cycles, which idle MCP servers do not
# accrue); that is its own slice, not a glyph bolted onto this one.
_roster_glyph() {
    local verdict="$1"
    case "$verdict" in
        dead) printf '✖' ;;
        # A REGISTERED agent with no live pane. Same ✖ class the watchdog's own
        # missing-pane alert uses (_agent_alert_reason ranks *missing* as dead): both
        # mean "this agent is not there", and the roster's job is to keep its slot
        # visible rather than let it vanish into a shorter line that reads as fine.
        missing) printf '✖' ;;
        # The steward is a SERVICE: idle between sweeps is normal, so the ordinary
        # active/stale reading would libel it. Its cadence branch already judges
        # heartbeat freshness (aemonitor rewrites meta-agent-state.json each real
        # sweep) — publish THAT, and nothing stronger.
        #   👁  swept within the wedge window — an honest read of the state file's
        #       mtime, not a claim that the steward is "working"
        #   ◌   past the grace window with no fresh heartbeat — the same condition the
        #       existing wedge alert already words as "not sweeping"
        #   ·   still inside the grace window, no heartbeat yet: undecided, and we say so
        meta-sweeping) printf '👁' ;;
        meta-wedged) printf '◌' ;;
        meta-starting) printf '·' ;;
        done) printf '✔' ;;
        waiting-user) printf '⏳' ;;
        blocked) printf '⛔' ;;
        throttled) printf '⚡' ;;
        stale) printf '◌' ;;
        active) printf '●' ;;
        # An unknown or unset verdict renders NEUTRAL. Borrowing ● for "we did not
        # decide" would manufacture a liveness claim out of a gap in our own logic.
        *) printf '·' ;;
    esac
    return 0
}

# 'opus5:builder' -> 'builder'. The roster is about WHO, not which model backs them
# (the alias is already visible in the pane border / @ae_agent line). Agent names
# cannot contain ':' (see AGENTS.md), so a suffix strip is unambiguous.
# The value lands in a tmux USER OPTION, which interpolates LITERALLY — no format
# parsing, no #() — so '#' and '%' need no escaping here (unlike status-left). Control
# bytes are still stripped: they would corrupt the bar's rendering, not just its text.
_roster_label() {
    local name="${1##*:}"
    printf '%s' "$name" | tr -d '\000-\037\177'
    return 0
}

# Registered agents from a session meta file as '<slot>\t<alias:name>' rows, in meta
# order (main, then workers, then spawned — the order ae itself writes).
#
# SLOT is the routing key, ref is only the label (design-patterns 9: route by key,
# display by address). Keying on the ref alone was wrong: `spawn` uniquifies only the
# numeric slot (`while grep -q '^agent.spawned.${next_idx}='`), never alias:name, so two
# registrations CAN share one display ref. With live panes also keyed by ref the last
# pane would win — both entries showing that pane's verdict, and killing one pane would
# NOT render its slot ✖, defeating the point of registered keying.
#
# The session id is dropped by FIELD (cut -d: -f1,2), not by suffix: '${v%:*}' on a
# sid-less 'alias:name' would silently yield just 'alias'. Agent names cannot contain ':'.
_roster_slot_refs() {
    local meta="$1" line slot val _slot_fd
    # '[[ -f ]]' is not enough: the file can exist and still fail to OPEN (permissions,
    # a /proc oddity), and under a BARE call with errexit that redirect aborts the
    # function before its `return 0`. Verified with /proc/1/mem. Open under a guard.
    exec {_slot_fd}<"$meta" 2>/dev/null || return 0
    while IFS= read -r line <&"$_slot_fd"; do
        case "$line" in
            agent.main=* | agent.worker.*=* | agent.spawned.*=*) ;;
            *) continue ;;
        esac
        slot="${line%%=*}"
        slot="${slot#agent.}"
        val="${line#*=}"
        [[ -n "$val" ]] || continue
        printf '%s\t%s\n' "$slot" "$(printf '%s' "$val" | cut -d: -f1,2)"
    done
    exec {_slot_fd}<&-
    return 0
}

# stdin: '<window_index>\t<glyph>' rows in PANE order -> one '<window_index>\t<glyphs>'
# row per window. Rows arrive grouped because `list-panes -s` walks window by window;
# glyph order inside a window therefore mirrors pane order and stays stable between
# cycles. A window with no agent panes emits an empty glyph run, so its option is
# published empty rather than left carrying a previous cycle's agents.
_roster_window_compose() {
    local cur_idx="" glyphs="" idx g
    while IFS=$'\t' read -r idx g; do
        [[ -n "$idx" ]] || continue
        if [[ "$idx" != "$cur_idx" ]]; then
            [[ -n "$cur_idx" ]] && printf '%s\t%s\n' "$cur_idx" "$glyphs"
            cur_idx="$idx"
            glyphs=""
        fi
        glyphs+="$g"
    done
    [[ -n "$cur_idx" ]] && printf '%s\t%s\n' "$cur_idx" "$glyphs"
    return 0
}

# stdin: '<agent>\t<verdict>' rows -> 'lead● colead✔ builder◌'. Input order is the
# render order, so the roster is stable cycle-to-cycle rather than reshuffling.
_roster_compose() {
    local out="" agent verdict
    while IFS=$'\t' read -r agent verdict; do
        [[ -n "$agent" ]] || continue
        out+="${out:+ }$(_roster_label "$agent")$(_roster_glyph "$verdict")"
    done
    printf '%s' "$out"
    return 0
}

_watchdog_log() {
    printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"
}

# Check if any process named $2 is a descendant of pane PID $1.
# Walks each candidate's ancestor chain via /proc/<pid>/stat.
# Used to avoid false-positive "dead" alerts when the pane's foreground is
# a shell wrapper (e.g. bash -lc) but the actual agent is running underneath.
_pane_has_descendant_named() {
    local pane_pid="$1" target="$2"
    [[ -n "$pane_pid" && -n "$target" ]] || return 1
    local pids
    pids="$(pgrep -x "$target" 2>/dev/null || true)"
    [[ -n "$pids" ]] || return 1
    local pid cur
    for pid in $pids; do
        cur="$pid"
        while [[ -n "$cur" && "$cur" != "1" && "$cur" != "0" ]]; do
            if [[ "$cur" == "$pane_pid" ]]; then
                return 0
            fi
            # ps, not /proc: /proc is Linux-only (on macOS the walk stopped at
            # the first hop and EVERY live agent read as dead), and field 4 of
            # /proc/<pid>/stat shifts whenever the comm contains a space.
            cur="$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d '[:space:]' || true)"
        done
    done
    return 1
}

# Known transient upstream throttle / overload patterns per agent binary.
# Pure function: takes a captured pane buffer + the agent binary name and
# returns 0 if any pattern matches. Patterns are deliberately narrow phrases
# unlikely to appear in normal agent prose, to keep false-positive rate low.
# When tools change their error wording, edit this function.
_buf_shows_throttle() {
    local buf="$1" agent_bin="$2"
    [[ -n "$buf" ]] || return 1
    # Per-tool catalogs. opencode is a TUI wrapper over configurable providers,
    # so it MUST be the full union — refactor here, never duplicate, to prevent
    # drift between branches.
    local claude_pats=(
        'Server is temporarily limiting requests'
        'API Error: Overloaded'
        'Anthropic API error'
    )
    local codex_pats=(
        'Rate limit exceeded'
        'RateLimitError'
        'ratelimit_exceeded'
    )
    local gemini_pats=(
        'RESOURCE_EXHAUSTED'
        'Quota exceeded'
    )
    local generic_pats=(
        '429 Too Many Requests'
        '503 Service Unavailable'
    )
    local -a active_pats
    case "$agent_bin" in
        claude) active_pats=("${claude_pats[@]}") ;;
        codex) active_pats=("${codex_pats[@]}") ;;
        gemini) active_pats=("${gemini_pats[@]}") ;;
        opencode) active_pats=("${claude_pats[@]}" "${codex_pats[@]}" "${gemini_pats[@]}") ;;
        *) active_pats=() ;;
    esac
    local pat
    for pat in "${active_pats[@]}" "${generic_pats[@]}"; do
        [[ "$buf" == *"$pat"* ]] && return 0
    done
    return 1
}

# tmux-capturing wrapper around _buf_shows_throttle. Looks at the last ~15
# lines (errors appear at tail of the buffer, not mid-conversation).
_pane_shows_throttle() {
    local pane="$1" agent_bin="$2"
    local buf
    buf="$(tmux capture-pane -p -J -S -15 -E - -t "$pane" 2>/dev/null || true)"
    _buf_shows_throttle "$buf" "$agent_bin"
}

# Build agent_label -> binary name map from meta. Used by the dead-check
# instead of trusting the alias label, which is arbitrary user-chosen text.
# Bash 4.0 compatible: agent_bins is declared at top level (no declare -g).
_load_agent_bins() {
    agent_bins=()
    [[ -f "$META_DIR/meta" ]] || return 0
    local key val slot bin label
    declare -A slot_to_bin=()
    while IFS='=' read -r key val; do
        case "$key" in
            agent_bin.*) slot_to_bin["${key#agent_bin.}"]="$val" ;;
        esac
    done <"$META_DIR/meta"
    while IFS='=' read -r key val; do
        case "$key" in
            agent.*)
                slot="${key#agent.}"
                label="${val%:*}" # alias:name
                bin="${slot_to_bin[$slot]:-${val%%:*}}"
                agent_bins["$label"]="$bin"
                ;;
        esac
    done <"$META_DIR/meta"
}

helper_watchdog_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"

    # Tunables. AE_WATCHDOG_* is canonical; legacy AE_LOOP_* names are still
    # honoured as fallbacks so existing shell rc / env exports keep working.
    INTERVAL="${AE_WATCHDOG_INTERVAL_SEC:-${AE_LOOP_INTERVAL_SEC:-60}}"
    STALE_MIN="${AE_WATCHDOG_STALE_MIN:-${AE_LOOP_STALE_MIN:-15}}"
    MAX_NUDGES="${AE_WATCHDOG_MAX_NUDGES:-${AE_LOOP_MAX_NUDGES:-2}}"
    # Same-cycle stabilization budget for a fresh quiet declaration (#47) and the
    # undelivered-nudge bound (#44). VALIDATED BEFORE ARITHMETIC, like SWEEP_RETRY_SECS
    # three functions up: under set -u an unset-but-referenced arithmetic operand is one
    # thing, but `((streak < abc))` with a non-numeric value TERMINATES the watchdog, and
    # a non-numeric settle budget silently empties the stabilizer's loop bound — quiet
    # holding would just stop working with nothing in the log. The pattern rejects
    # leading zeros deliberately: "08" is the documented octal trap.
    QUIET_SETTLE_BEAT="${AE_WATCHDOG_QUIET_SETTLE_BEAT:-1}"
    [[ "$QUIET_SETTLE_BEAT" =~ ^[1-9][0-9]*$ ]] || QUIET_SETTLE_BEAT=1
    QUIET_SETTLE_TRIES="${AE_WATCHDOG_QUIET_SETTLE:-4}"
    [[ "$QUIET_SETTLE_TRIES" =~ ^[1-9][0-9]*$ ]] || QUIET_SETTLE_TRIES=4
    QUIET_STABILIZE_PER_CYCLE="${AE_WATCHDOG_QUIET_STABILIZE_PER_CYCLE:-2}"
    [[ "$QUIET_STABILIZE_PER_CYCLE" =~ ^[1-9][0-9]*$ ]] || QUIET_STABILIZE_PER_CYCLE=2
    UNDELIVERED_MAX="${AE_WATCHDOG_UNDELIVERED_MAX:-3}"
    [[ "$UNDELIVERED_MAX" =~ ^[1-9][0-9]*$ ]] || UNDELIVERED_MAX=3
    STALE_SECS=$((STALE_MIN * 60))
    # Cycles of continuous throttle detection before escalating to alert (~5min default).
    THROTTLE_ALERT_CYCLES="${AE_WATCHDOG_THROTTLE_ALERT_CYCLES:-${AE_LOOP_THROTTLE_ALERT_CYCLES:-5}}"
    # How often (seconds) the watchdog best-effort revives the telegram bridge if it
    # died. 0 disables. Idempotent + respects [telegram] enabled — see step 10.
    TG_SUPERVISE_SECS="${AE_WATCHDOG_TG_SUPERVISE_SEC:-${AE_LOOP_TG_SUPERVISE_SEC:-120}}"
    # Meta-agent (steward) sweep cadence: if this session is the meta-agent
    # (meta_agent=true in meta), the watchdog prompts a sweep every SWEEP_SECS instead of
    # treating idle as stale. 0 falls back to normal watchdog behaviour.
    SWEEP_SECS="${AE_WATCHDOG_SWEEP_SEC:-${AE_LOOP_SWEEP_SEC:-300}}"
    [[ "$SWEEP_SECS" =~ ^[0-9]+$ ]] || SWEEP_SECS=300 # guard non-numeric overrides
    # A sweep nudge that FAILED to deliver retries after this instead of burning a
    # full SWEEP_SECS window (see the delivery check in the cadence branch). Allows
    # up to SWEEP_RETRY_MAX FAST retries; the next failure after that escalates once
    # and falls back to plain cadence. Retry timing is floor-only — the watchdog
    # polls on its own interval, so the retry lands on the first poll at or after
    # SWEEP_RETRY_SECS, never sooner.
    # Both regexes reject leading zeros: "08" is valid to ^[0-9]+$ but bash
    # arithmetic reads it as OCTAL and errors out ("value too great for base").
    SWEEP_RETRY_SECS="${AE_WATCHDOG_SWEEP_RETRY_SEC:-30}"
    [[ "$SWEEP_RETRY_SECS" =~ ^[1-9][0-9]*$ ]] || SWEEP_RETRY_SECS=30
    SWEEP_RETRY_MAX="${AE_WATCHDOG_SWEEP_RETRY_MAX:-6}"
    [[ "$SWEEP_RETRY_MAX" =~ ^(0|[1-9][0-9]*)$ ]] || SWEEP_RETRY_MAX=6
    META_AGENT="$(grep '^meta_agent=' "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    # Only the MAIN meta-agent runs the sweep cadence; any workers/spawned agents in a
    # meta session keep the normal watchdog. (alias:name, dropping the session-id.)
    META_MAIN_AGENT="$(grep '^agent.main=' "$META_DIR/meta" 2>/dev/null | cut -d= -f2- | cut -d: -f1,2 || true)"

    PIDFILE="${META_DIR}/.watchdog.pid"

    cmd="${1:-start}"
    case "$cmd" in
        stop) _watchdog_stop ;;
        status) _watchdog_status ;;
        start) _watchdog_start ;;
        _ensure-monitor) _watchdog_ensure_monitor ;; # internal: spawn _events pane only
        _run) ;;                                     # internal: actual watchdog execution
        *)
            echo "Usage: watchdog [start|stop|status]" >&2
            exit 1
            ;;
    esac

    # --- _run: the actual watchdog (runs inside hidden tmux window) ---

    echo "$$" >"$PIDFILE"
    trap '_watchdog_exit_cleanup' EXIT
    _watchdog_set_status @ae_watchdog_status "[watch ◌ starting]"
    _watchdog_set_status @ae_branch_status "$(_watchdog_branch_segment)"

    # Pretty banner so the pane is informative when viewed
    printf '\033[1;36m'
    printf '╭─ ae watchdog — session: %s ─────────────────────────╮\n' "$_AE_SESSION"
    printf '│ interval: %ss   stale: %sm   max nudges: %s\n' "$INTERVAL" "$STALE_MIN" "$MAX_NUDGES"
    # shellcheck disable=SC2016  # literal backticks in the banner text
    printf '│ read-only pane (input disabled). use peek _watchdog or stop with `watchdog stop`.\n'
    printf '╰────────────────────────────────────────────────────────╯\n'
    printf '\033[0m\n'

    declare -A prev_hash last_hash_change nudge_count dead_agents alerted_missing throttle_streak
    # Per-pane undelivered-nudge streak (#44) — see step 7. (The quiet baseline needs
    # no per-cycle state: it settles inside the arming cycle.)
    declare -A undelivered_streak
    # Fairness state for the stabilization rotation (#47), owned by the cycle step.
    _QS_CURSOR=0
    _QS_SPENT=0
    _QS_MAX="$QUIET_STABILIZE_PER_CYCLE"
    # Per-pane last sweep-nudge time, for meta-agent (steward) sweep cadence.
    declare -A last_sweep_nudge first_sweep_nudge meta_wedge_alerted meta_reconciled
    declare -A sweep_nudge_fails sweep_unreachable_alerted
    # Cross-cycle: consecutive cycles a registered slot has had no live pane (D4).
    declare -A missing_streak
    # Per-pane quiet baseline for waiting-user/blocked: the pane hash captured when a
    # declaration is first observed (already includes the declaration's own echo), so
    # only a *later* pane change (human reply / agent output) yields the quiet state.
    # Keyed by the declaration's full-tuple identity so a fresh declaration re-arms.
    declare -A quiet_base_key quiet_base_hash
    declare -A agent_bins
    cycle=0

    last_tg_supervise=0
    while true; do
        # Self-terminate if session or meta is gone
        if ! tmux has-session -t "$_AE_SESSION" 2>/dev/null; then
            _watchdog_log "session gone — exiting"
            break
        fi
        [[ -f "$META_DIR/meta" ]] || {
            _watchdog_log "meta gone — exiting"
            break
        }

        cycle=$((cycle + 1))
        _watchdog_log "── cycle ${cycle} ──"
        cycle_total=0
        cycle_active=0
        cycle_stale=0
        cycle_dead=0
        cycle_alerts=0
        # Per-cycle stabilization budget (#47). The CURSOR is deliberately NOT reset —
        # it is what carries "whose turn is next" across cycles, and the cycle step
        # wraps it after the sweep.
        _quiet_cycle_begin
        pane_idx=0
        _load_agent_bins

        # Collect live panes into an associative array for missing-pane detection
        declare -A live_agents=()
        # Roster accumulator (see _roster_compose): ordered rows + this cycle's verdict
        # per pane. Reset every cycle — a verdict is only ever THIS cycle's decision,
        # never a leftover from the previous one.
        declare -A roster_verdict=()
        # Live panes keyed by SLOT (@ae_slot), the churn-proof key — a display ref can be
        # duplicated by `spawn`, a slot cannot.
        declare -A live_slots=()
        # D4 debounce: `spawn` writes meta BEFORE stamping the pane, so a NORMAL spawn is
        # briefly registered-but-unstamped. The cycle-start snapshot narrows that window
        # but cannot close it (the stamp may land mid-cycle). A slot must therefore be
        # seen missing on TWO consecutive cycles before it renders ✖. A <=1-cycle late ✖
        # is honest-ish; a durable false alert is the real harm, and this kills it.
        # I2: snapshot the registered slots ONCE, here, and feed BOTH consumers (roster
        # composition AND missing-pane detection) from this same snapshot. `spawn` writes
        # meta BEFORE it stamps @ae_agent/@ae_slot on the pane, so a pane snapshot taken
        # early plus a meta read taken late makes a NORMAL spawn look registered-but-gone
        # for up to a full interval — a false ✖ on the bar and, worse, a durable false
        # missing-alert. One read, one truth, no window between them.
        roster_slots_snapshot="$(_roster_slot_refs "$META_DIR/meta")"
        while IFS='|' read -r pane agent proc pane_pid_val; do
            [[ -n "$agent" ]] || continue
            # Skip non-agent panes (no @ae_agent), the watchdog (and legacy monitor panes), and the events pane
            case "$agent" in
                "" | "(null)" | _watchdog | _shepherd | _loop | _events) continue ;; # legacy pre-rename watchdog panes (transition)
            esac
            pane_idx=$((pane_idx + 1)) # position in this cycle's traversal, for the cursor
            live_agents["$agent"]="$pane"
            pane_slot="$(tmux display-message -p -t "$pane" '#{@ae_slot}' 2>/dev/null || true)"
            [[ -n "$pane_slot" ]] && live_slots["$pane_slot"]="$pane"
            cycle_total=$((cycle_total + 1))

            # Skip already-dead agents
            if [[ -n "${dead_agents[$pane]:-}" ]]; then
                cycle_dead=$((cycle_dead + 1))
                roster_verdict["$pane"]="dead"
                _watchdog_log "  ${agent}  dead (no further checks)"
                continue
            fi

            # Resolve the actual binary name from agent_bin.<slot> in meta (not the
            # alias label, which is arbitrary user text). Needed by both dead check
            # and throttle pattern catalog.
            agent_bin="${agent_bins[$agent]:-${agent%%:*}}"

            # 1. Dead check — pane's foreground command is a shell.
            # But the agent might still be running as a descendant (e.g. when launched
            # via bash -lc wrapper). Walk the process tree before declaring death.
            case "$proc" in
                bash | zsh | fish | sh | dash | "")
                    if _pane_has_descendant_named "$pane_pid_val" "$agent_bin"; then
                        : # alive — fall through to active check
                    else
                        dead_agents["$pane"]=1
                        cycle_dead=$((cycle_dead + 1))
                        roster_verdict["$pane"]="dead"
                        cycle_alerts=$((cycle_alerts + 1))
                        ae_emit_event "alert" "$agent" "" "agent process dead — dropped to shell"
                        tmux display-message -d 10000 "[ae watchdog] $agent is DEAD — process dropped to shell" 2>/dev/null || true
                        _watchdog_log "  ${agent}  DEAD — process dropped to shell (alerted)"
                        continue
                    fi
                    ;;
            esac

            # 1b. Meta-agent (steward) sweep cadence — applies ONLY to the main agent
            #     (workers/spawned agents in a meta session keep the normal watchdog).
            #     The steward is a long-running SERVICE, so "idle between sweeps" is NORMAL,
            #     not stale — don't nudge it to declare a quiet state or escalate it to a
            #     stale alert. Instead: (a) prompt a sweep every SWEEP_SECS, and (b) guard
            #     liveness via the steward's OWN heartbeat — it rewrites its state file on
            #     each real sweep, so if that stops advancing while we keep nudging (model
            #     stall / API throttle / wedged), raise ONE alert (cleared on recovery).
            #     The dead-check above + missing-pane check (step 8) still catch a
            #     dead/vanished steward. This is the explicit cadence, not the stale-watchdog.
            if [[ "$META_AGENT" == "true" && "$agent" == "$META_MAIN_AGENT" ]] && ((SWEEP_SECS > 0)); then
                now_epoch="$(date +%s)"
                # Heartbeat liveness (live-but-not-sweeping detection). The steward rewrites
                # its state file on each real sweep; we judge it only AFTER we've prompted
                # at least one sweep and given it a grace window — so an ABSENT file
                # (never wrote a heartbeat) is caught too, not just a stale one.
                # This is the file the contrib aemonitor helper writes atomically each
                # sweep (~/.ae/sessions/<meta-agent>/meta-agent-state.json); they MUST match or
                # the wedge check watches a file nobody writes and false-alarms.
                hb_file="${META_DIR}/meta-agent-state.json"
                hb=0
                [[ -f "$hb_file" ]] && hb="$(_ae_stat mtime "$hb_file" || echo 0)"
                wedge_secs=$((SWEEP_SECS * 2 + 60))
                first_nudge="${first_sweep_nudge[$pane]:-0}"
                # Roster verdict for the steward, read off the SAME two conditions this
                # branch already judges below (fresh heartbeat / past-grace wedge) — the
                # expressions are deliberately identical so the glyph can never disagree
                # with the alert. It used to `continue` without assigning a verdict at
                # all, so the steward permanently rendered '·'.
                if ((hb > 0 && now_epoch - hb <= wedge_secs)); then
                    roster_verdict["$pane"]="meta-sweeping"
                elif ((first_nudge > 0 && now_epoch - first_nudge > wedge_secs)); then
                    roster_verdict["$pane"]="meta-wedged"
                else
                    # Inside the grace window with no heartbeat yet — genuinely undecided,
                    # and '·' says exactly that rather than inventing a liveness claim.
                    roster_verdict["$pane"]="meta-starting"
                fi
                if ((hb > 0 && now_epoch - hb <= wedge_secs)); then
                    # Fresh heartbeat → recovery. The WATCHDOG raised the alert, so the watchdog
                    # clears it (emit alert-cleared so _agent_alert_reason / ae list stops
                    # showing it even on a silent sweep). Clear via the in-memory latch
                    # (fast path) OR, once per watchdog lifetime, reconcile the DURABLE event
                    # log — so a watchdog restart that lost the latch after alerting still
                    # emits a clear. Idempotent: once cleared it's the newest event, so a
                    # re-scan finds no active alert.
                    if [[ -n "${meta_wedge_alerted[$pane]:-}" ]]; then
                        unset 'meta_wedge_alerted[$pane]'
                        meta_reconciled["$pane"]=1
                        ae_emit_event "alert-cleared" "$agent" "" "meta-agent sweeping again (heartbeat resumed)"
                        _watchdog_log "  ${agent}  meta-agent — wedge cleared (heartbeat fresh)"
                    elif [[ -z "${meta_reconciled[$pane]:-}" ]]; then
                        meta_reconciled["$pane"]=1
                        if [[ -n "$(_agent_alert_reason "$META_DIR/events.jsonl" "$agent" "$_AE_SESSION")" ]]; then
                            ae_emit_event "alert-cleared" "$agent" "" "meta-agent sweeping again (heartbeat resumed)"
                            _watchdog_log "  ${agent}  meta-agent — stale wedge alert reconciled + cleared (post-restart)"
                        fi
                    fi
                elif ((first_nudge > 0 && now_epoch - first_nudge > wedge_secs)); then
                    # We've prompted long enough to expect a heartbeat, but it is stale
                    # OR absent → live-but-not-sweeping. (Summary deliberately avoids the
                    # 'throttl'/'dead'/'missing' substrings so _agent_alert_reason ranks
                    # it high — it also has an explicit 'not sweeping' case.)
                    if [[ -z "${meta_wedge_alerted[$pane]:-}" ]]; then
                        meta_wedge_alerted["$pane"]=1
                        cycle_alerts=$((cycle_alerts + 1))
                        if ((hb > 0)); then
                            wedge_detail="no heartbeat for $(((now_epoch - hb) / 60))m"
                        else
                            wedge_detail="never wrote a heartbeat in $(((now_epoch - first_nudge) / 60))m of sweep prompts"
                        fi
                        ae_emit_event "alert" "$agent" "" "meta-agent not sweeping — ${wedge_detail} (may be stuck)"
                        tmux display-message -d 10000 "[ae watchdog] $agent (meta-agent) not sweeping — may be stuck" 2>/dev/null || true
                        _watchdog_log "  ${agent}  meta-agent — WEDGE alert (${wedge_detail})"
                    fi
                fi
                # Sweep cadence. Record the first DELIVERED nudge time so the heartbeat
                # guard above has a reference point even before any state file exists.
                last_sweep="${last_sweep_nudge[$pane]:-0}"
                if ((now_epoch - last_sweep >= SWEEP_SECS)); then
                    # Delivery is CHECKED, never fire-and-forget. `send` exits 1 when it
                    # REFUSES (dead shell) or ABANDONS (target busy / human at the pane
                    # past AE_SEND_DEFER_SEC). The old `2>/dev/null || true` swallowed
                    # that, advanced the cadence, and logged "sent" regardless — so a
                    # failed nudge was invisible and the steward waited another full
                    # SWEEP_SECS. Shipped exhibit (steward events.jsonl 2026-07-15):
                    # every nudge 05:00:24Z→06:55:00Z was eaten — 94 minutes, zero nudge
                    # events, steward never prompted; the 05:20:59Z wedge alert was the
                    # only signal and was a TRUE positive.
                    # Keep send's stderr: it names the ACTUAL failure ("REFUSED … has
                    # DIED" vs "ABANDONED — target stayed busy / human input"), which is
                    # the one fact a human debugging a missed sweep needs. Flattened to a
                    # single capped line so the log stays greppable.
                    # SEMANTIC (deliberate): send's rc is "delivered AND logged", not
                    # "delivered" — ae_emit_event is its last command, so an event-log
                    # failure after a successful paste reports nonzero and we retry a
                    # nudge the steward already got. That is AT-LEAST-ONCE, chosen over
                    # at-most-once: a duplicate sweep prompt costs one redundant sweep,
                    # a dropped one costs a 94-minute blind spot. Don't "fix" this by
                    # trusting a nonzero rc as delivered.
                    sweep_rc=0
                    sweep_err="$(env AE_SENDER_OVERRIDE=watchdog \
                        _AE_EVENT_ACTION=nudge \
                        _AE_EVENT_SUMMARY="sweep cadence" \
                        "${META_DIR}/send" "$agent" \
                        "Run your sweep now: ae list --json, diff your state file, and report ONLY new/changed attention to Clemens via say (stay silent if nothing changed). Stay in 'working'." 2>&1 >/dev/null)" || sweep_rc=$?
                    if ((sweep_rc == 0)); then
                        # The wedge grace window ticks from the first DELIVERED prompt:
                        # starting it on an undelivered attempt would alert "not sweeping"
                        # against a steward we never actually reached.
                        [[ "${first_sweep_nudge[$pane]:-0}" -eq 0 ]] && first_sweep_nudge["$pane"]="$now_epoch"
                        unset 'sweep_nudge_fails[$pane]'
                        last_sweep_nudge["$pane"]="$now_epoch"
                        _watchdog_log "  ${agent}  meta-agent — sweep nudge sent (every ${SWEEP_SECS}s)"
                        if [[ -n "${sweep_unreachable_alerted[$pane]:-}" ]]; then
                            unset 'sweep_unreachable_alerted[$pane]'
                            # alert-cleared is UNTYPED — _agent_alert_reason treats ANY
                            # clear as clearing THE alert. Emitting one here while the
                            # wedge alert is still latched would erase a live "not
                            # sweeping" from `ae list` while meta_wedge_alerted stays set,
                            # so it could never re-fire: a wedged steward would go
                            # invisible. Only clear when no wedge alert is outstanding;
                            # the wedge owns its own clear (heartbeat-recovery branch
                            # above, which already ran this cycle).
                            if [[ -z "${meta_wedge_alerted[$pane]:-}" ]]; then
                                ae_emit_event "alert-cleared" "$agent" "" "meta-agent reachable again (sweep nudge delivered)"
                                _watchdog_log "  ${agent}  meta-agent — unreachable cleared (nudge delivered)"
                            else
                                _watchdog_log "  ${agent}  meta-agent — reachable again, but wedge alert still active (not clearing)"
                            fi
                        fi
                    else
                        # Flatten to ONE capped line: newlines/tabs → spaces, then drop the
                        # remaining control bytes (an ESC sequence must not reach a log a
                        # human cats). Byte range keeps UTF-8 intact — send's own text has
                        # em-dashes. _watchdog_log passes this as a printf ARG, not a format.
                        sweep_err="$(printf '%s' "$sweep_err" | tr '\n\r\t' '   ' | tr -d '\000-\037\177' | cut -c1-140)"
                        # Re-read the clock: the send above BLOCKS while it defers a busy
                        # target (AE_SEND_DEFER_SEC, 30s), so now_epoch is stale by exactly
                        # the interval we are scheduling against — off it, the retry would
                        # be due the moment send returned.
                        sweep_now="$(date +%s)"
                        sweep_fails=$((${sweep_nudge_fails[$pane]:-0} + 1))
                        sweep_nudge_fails["$pane"]="$sweep_fails"
                        if ((sweep_fails <= SWEEP_RETRY_MAX)); then
                            # Don't consume the cadence slot — make the retry due
                            # SWEEP_RETRY_SECS after THIS failure. Clamped: a retry longer
                            # than SWEEP_SECS would push last_sweep into the FUTURE and
                            # delay the next nudge instead of hastening it. Floor, not a
                            # deadline: it lands on the first watchdog poll at/after that.
                            sweep_retry="$SWEEP_RETRY_SECS"
                            ((sweep_retry > SWEEP_SECS)) && sweep_retry="$SWEEP_SECS"
                            last_sweep_nudge["$pane"]=$((sweep_now - SWEEP_SECS + sweep_retry))
                            _watchdog_log "  ${agent}  meta-agent — sweep nudge FAILED (rc=${sweep_rc}, retry ${sweep_fails}/${SWEEP_RETRY_MAX}) — due in ~${sweep_retry}s, lands on the next poll${sweep_err:+ — ${sweep_err}}"
                        else
                            # Bounded: a persistently unreachable steward degrades to the
                            # normal cadence and escalates ONCE, rather than retry-spamming.
                            last_sweep_nudge["$pane"]="$sweep_now"
                            _watchdog_log "  ${agent}  meta-agent — sweep nudge FAILED (rc=${sweep_rc}) — ${sweep_fails} consecutive, back to ${SWEEP_SECS}s cadence${sweep_err:+ — ${sweep_err}}"
                            if [[ -z "${sweep_unreachable_alerted[$pane]:-}" ]]; then
                                sweep_unreachable_alerted["$pane"]=1
                                cycle_alerts=$((cycle_alerts + 1))
                                ae_emit_event "alert" "$agent" "" "meta-agent unreachable — ${sweep_fails} sweep nudges undelivered (not sweeping)"
                                tmux display-message -d 10000 "[ae watchdog] $agent (meta-agent) unreachable — sweep nudges undelivered" 2>/dev/null || true
                            fi
                        fi
                    fi
                else
                    _watchdog_log "  ${agent}  meta-agent — next sweep in $((SWEEP_SECS - (now_epoch - last_sweep)))s"
                fi
                cycle_active=$((cycle_active + 1))
                continue
            fi

            # Pre-check: one pane buffer capture per cycle, drives both hash check
            # (step 4) and throttle detection (step 3). Compute done epoch + throttle
            # state up front so the priority branches (done, throttled) can react
            # before the pane-hash early-continues mask them visually.
            now_epoch="$(date +%s)"
            pane_buf="$(_watchdog_capture_pane "$pane" || true)"
            # The quiet-state baseline hashes a FILTERED view: the watchdog must not
            # count its own footprints as human activity. Its nudge lands in the pane,
            # and the agent's answer to it is usually a bare state re-declaration whose
            # echo lands too — so a waiting-user hold was broken by the very exchange
            # it provoked, every cycle, on any agent responsive enough to reply.
            # Anything the human or the agent actually writes is still in the hash, so
            # a real reply still resumes nudging.
            hash="$(_watchdog_quiet_hash "$pane_buf")"
            quiet_row="$(_agent_quiet_reason "$agent")"
            # Throttle detection AND streak clear up front: streak resets on every
            # non-throttled cycle regardless of which branch the agent exits on.
            if _buf_shows_throttle "$pane_buf" "$agent_bin"; then
                is_throttled=1
            else
                is_throttled=0
                if [[ -n "${throttle_streak[$pane]:-}" ]]; then
                    ae_emit_event "throttle-cleared" "$agent" "" "throttling cleared after ${throttle_streak[$pane]} cycles"
                    _watchdog_log "  ${agent}  throttle cleared after ${throttle_streak[$pane]} cycles"
                    unset 'throttle_streak[$pane]'
                fi
            fi

            # 2. Declared quiet state — "leave me alone" signal from the agent.
            #    Quiet states: done, waiting-user, blocked. A quiet state is
            #    invalidated by a newer ae event mentioning the agent (enforced by
            #    _agent_quiet_reason returning empty in that case).
            #
            #    done is EVENT-ONLY quiet: pane churn (scrollback, resize, redraws,
            #    escape sequences) never invalidates it. Silent work after done is
            #    the agent's discipline problem; if they resume they should emit an
            #    ae event.
            #
            #    waiting-user / blocked yield to pane activity, because the human
            #    usually replies directly in the pane (no events.jsonl entry — only
            #    a pane-hash change). Honour the quiet state only while the pane is
            #    untouched since the declaration; once it changes, fall through to
            #    the normal active/recent/stale branches so a post-reply hang is
            #    still caught.
            if [[ -n "$quiet_row" ]]; then
                IFS=$'\t' read -r quiet_reason quiet_key <<<"$quiet_row"
                if [[ "$quiet_reason" == "done" ]]; then
                    cycle_active=$((cycle_active + 1))
                    nudge_count["$pane"]=0
                    roster_verdict["$pane"]="$quiet_reason"
                    _watchdog_log "  ${agent}  done (reported complete) — skip"
                    continue
                fi
                quiet_decision="$(_quiet_pane_decision "$hash" "${quiet_base_key[$pane]:-}" "${quiet_base_hash[$pane]:-}" "$quiet_key")"
                case "$quiet_decision" in
                    arm)
                        # First cycle observing this declaration. The agent's final
                        # message has NOT necessarily landed — it is emitted after the
                        # state tool call — so settle the pane here, in seconds, rather
                        # than baselining whatever happens to be on screen right now.
                        if _quiet_cycle_step "$pane_idx"; then
                            settled_hash="$(_quiet_stabilize "$pane" "$QUIET_SETTLE_BEAT" "$QUIET_SETTLE_TRIES")"
                        else
                            settled_hash="" # budget spent this cycle — try again next one
                        fi
                        if [[ -n "$settled_hash" ]]; then
                            quiet_base_key["$pane"]="$quiet_key"
                            quiet_base_hash["$pane"]="$settled_hash"
                            # Downstream bookkeeping (prev_hash / last_hash_change) must
                            # record what we BASELINED, not the pre-settle sample — and
                            # since both captures now come from _watchdog_capture_pane,
                            # this value is directly comparable to the next cycle's.
                            hash="$settled_hash"
                            cycle_active=$((cycle_active + 1))
                            nudge_count["$pane"]=0
                            roster_verdict["$pane"]="$quiet_reason"
                            _watchdog_log "  ${agent}  ${quiet_reason} (declared) — skip"
                            continue
                        fi
                        # Never held still inside the budget: someone is typing or the
                        # agent is still emitting. Either way this is not a quiet pane —
                        # fall through to the normal branches this cycle and try again
                        # on the next one.
                        _watchdog_log "  ${agent}  ${quiet_reason} (declared) — pane still moving, not quiet yet"
                        ;;
                    hold)
                        cycle_active=$((cycle_active + 1))
                        nudge_count["$pane"]=0
                        roster_verdict["$pane"]="$quiet_reason"
                        _watchdog_log "  ${agent}  ${quiet_reason} (declared) — skip"
                        continue
                        ;;
                    yield) : ;; # pane changed since baseline → no longer quiet, fall through
                esac
            fi

            # 3. Throttled — upstream rate limit / overload visible in pane. React
            #    BEFORE active/recent so the alert cadence (THROTTLE_ALERT_CYCLES *
            #    INTERVAL) starts immediately. If we waited until after active/recent,
            #    the alert would fire only after the full stale window expired —
            #    breaking the documented threshold.
            if ((is_throttled)); then
                prev_streak="${throttle_streak[$pane]:-0}"
                if ((prev_streak == 0)); then
                    ae_emit_event "throttled" "$agent" "" "upstream throttling detected — pausing nudges"
                    _watchdog_log "  ${agent}  THROTTLED — pausing nudges"
                fi
                throttle_streak["$pane"]=$((prev_streak + 1))
                if ((throttle_streak[$pane] == THROTTLE_ALERT_CYCLES)); then
                    ae_emit_event "alert" "$agent" "" "throttled for $((THROTTLE_ALERT_CYCLES * INTERVAL))s — may need attention"
                    tmux display-message -d 10000 "[ae watchdog] $agent throttled persistently" 2>/dev/null || true
                    cycle_alerts=$((cycle_alerts + 1))
                    _watchdog_log "  ${agent}  THROTTLED — persistent (${THROTTLE_ALERT_CYCLES} cycles), alert raised"
                fi
                # Update hash even when throttled so a later pane change (recovery)
                # is detected as activity rather than a stale "first time" hash diff.
                prev_hash["$pane"]="$hash"
                last_hash_change["$pane"]="$now_epoch"
                cycle_active=$((cycle_active + 1))
                nudge_count["$pane"]=0
                roster_verdict["$pane"]="throttled"
                continue
            fi

            # 4. Active — pane content hash changed since last cycle
            if [[ "$hash" != "${prev_hash[$pane]:-}" ]]; then
                prev_hash["$pane"]="$hash"
                last_hash_change["$pane"]="$now_epoch"
                nudge_count["$pane"]=0
                # The undelivered bound stops attempts to an UNCHANGED unreachable pane;
                # it must not outlive the condition. Only a delivery used to clear it,
                # so three transient busy/refused sends disabled nudging for that pane
                # permanently — while nudge_count reset on this very line, making the
                # pane look freshly attended. A moving pane is positive evidence that
                # whatever blocked delivery is gone, so the attempts re-arm here.
                undelivered_streak["$pane"]=0
                cycle_active=$((cycle_active + 1))
                roster_verdict["$pane"]="active"
                _watchdog_log "  ${agent}  active (pane hash changed)"
                continue
            fi

            # 5. Recently visible — pane changed within stale window (covers human
            #    interaction with quiet/static responses they are still reading)
            last_change="${last_hash_change[$pane]:-0}"
            if ((last_change > 0 && now_epoch - last_change < STALE_SECS)); then
                cycle_active=$((cycle_active + 1))
                roster_verdict["$pane"]="active"
                _watchdog_log "  ${agent}  recently visible ($((now_epoch - last_change))s ago) — skip"
                continue
            fi

            # 6. Recently alive — recent event from this actor
            event_age="$(_last_event_age "$agent")"
            if ((event_age < STALE_SECS)); then
                cycle_active=$((cycle_active + 1))
                roster_verdict["$pane"]="active"
                _watchdog_log "  ${agent}  recent ae activity (${event_age}s) — skip"
                continue
            fi

            # 7. Stale — nudge or escalate
            cycle_stale=$((cycle_stale + 1))
            roster_verdict["$pane"]="stale"
            count="${nudge_count[$pane]:-0}"
            stale_min_num=$((event_age / 60))
            if ((stale_min_num > 9999)); then
                stale_display="no recent events"
            else
                stale_display="idle ${stale_min_num}m"
            fi
            # THE COUNTER COUNTS DELIVERIES, NOT ATTEMPTS. send's rc was discarded
            # here, so a nudge that was refused (dead pane) or abandoned (busy, or the
            # human mid-type) still bumped nudge_count, printed "nudged (n/2)" and fed
            # the max-nudges alert — the watchdog reporting asks that never landed.
            # The event log was already honest: helper_send_body exits BEFORE
            # ae_emit_event on those paths, so no nudge event is written. Only the
            # counter, the log line and the alert reason lied.
            #
            # An undelivered attempt gets its OWN bounded streak and its own alert,
            # because "unreachable/occupied" is a different problem from "ignoring me",
            # and it is bounded rather than retried forever: each send can hold this
            # loop ~30s on a defer, so an unreachable pane must stop costing cycles.
            undelivered="${undelivered_streak[$pane]:-0}"
            if ! _nudge_should_attempt "$undelivered" "$UNDELIVERED_MAX"; then
                _watchdog_log "  ${agent}  STALE — nudge undeliverable (${undelivered} attempts, alerted) — not retrying"
            elif ((count < MAX_NUDGES)); then
                # Quote the session goal (if set) so an idle agent is reminded what
                # the session is FOR, not just that it went quiet.
                goal_line="$(_watchdog_meta_value goal)"
                [[ -n "$goal_line" ]] && goal_line="Session goal: ${goal_line}. "
                nudge_rc=0
                env AE_SENDER_OVERRIDE=watchdog \
                    _AE_EVENT_ACTION=nudge \
                    _AE_EVENT_SUMMARY="${stale_display}, no recent ae activity" \
                    "${META_DIR}/send" "$agent" \
                    "${goal_line}Status check: if you have more work, continue. Otherwise declare your state so I stop nudging: ${META_DIR}/state <waiting-user|blocked|done> \"<reason>\"" 2>/dev/null || nudge_rc=$?
                case "$(_nudge_delivery_verdict "$nudge_rc" "$undelivered" "$UNDELIVERED_MAX")" in
                    delivered)
                        undelivered_streak["$pane"]=0
                        nudge_count["$pane"]=$((count + 1))
                        _watchdog_log "  ${agent}  STALE (${stale_display}) — nudged ($((count + 1))/${MAX_NUDGES})"
                        ;;
                    undelivered)
                        undelivered=$((undelivered + 1))
                        undelivered_streak["$pane"]="$undelivered"
                        _watchdog_log "  ${agent}  STALE (${stale_display}) — nudge NOT delivered (rc=${nudge_rc}, ${undelivered}/${UNDELIVERED_MAX})"
                        ;;
                    undelivered-alert)
                        undelivered=$((undelivered + 1))
                        undelivered_streak["$pane"]="$undelivered"
                        ae_emit_event "alert" "$agent" "" "nudge unreachable/occupied — ${undelivered} undelivered attempts (${stale_display})"
                        tmux display-message -d 10000 "[ae watchdog] $agent unreachable — ${undelivered} nudges could not be delivered" 2>/dev/null || true
                        cycle_alerts=$((cycle_alerts + 1))
                        _watchdog_log "  ${agent}  STALE (${stale_display}) — nudge NOT delivered (rc=${nudge_rc}, ${undelivered}/${UNDELIVERED_MAX}) — alert raised"
                        ;;
                esac
            elif ((count == MAX_NUDGES)); then
                ae_emit_event "alert" "$agent" "" "max nudges reached (${stale_display}), needs attention"
                tmux display-message -d 10000 "[ae watchdog] $agent may need attention — stale after ${MAX_NUDGES} nudges" 2>/dev/null || true
                nudge_count["$pane"]=$((count + 1))
                cycle_alerts=$((cycle_alerts + 1))
                _watchdog_log "  ${agent}  STALE — max nudges reached, alert raised"
            else
                _watchdog_log "  ${agent}  STALE — already alerted, waiting for activity"
            fi

        done < <(tmux list-panes -s -t "$_AE_SESSION" -F '#{pane_id}|#{@ae_agent}|#{pane_current_command}|#{pane_pid}' 2>/dev/null)
        # Rotate: next cycle starts where this one stopped, so a pane that never settles
        # cannot hold the budget against every pane behind it.
        _quiet_cycle_end "$pane_idx"

        # 8. Missing pane check — registered agents whose panes no longer exist
        while IFS='=' read -r key val; do
            [[ "$key" == agent.* ]] || continue
            agent_ref="${val%%:*}:$(echo "${val#*:}" | cut -d: -f1)"
            if [[ -z "${live_agents[$agent_ref]:-}" && -z "${alerted_missing[$agent_ref]:-}" ]]; then
                alerted_missing["$agent_ref"]=1
                ae_emit_event "alert" "$agent_ref" "" "pane missing — agent no longer visible in session"
                tmux display-message -d 10000 "[ae watchdog] $agent_ref pane is MISSING" 2>/dev/null || true
                _watchdog_log "  ${agent_ref}  MISSING — pane no longer in session"
            fi
        done <"$META_DIR/meta"

        # 9. Recover pending session IDs (codex/gemini/opencode post-launch capture retry)
        AE_PATH_BIN="$(grep '^ae_path=' "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
        if [[ -n "$AE_PATH_BIN" && -x "$AE_PATH_BIN" ]]; then
            # shellcheck disable=SC2034  # r_slot consumed positionally, unused
            while IFS=$'\t' read -r r_kind r_slot r_agent r_tool r_captured; do
                [[ "$r_kind" == "ok" && -n "$r_captured" ]] || continue
                ae_emit_event "recover" "$r_agent" "$r_captured" "captured ${r_tool} session id (${r_captured:0:8})"
                _watchdog_log "  ${r_agent}  RECOVERED ${r_tool} session id ${r_captured:0:8}"
            done < <("$AE_PATH_BIN" _recover-pending "$_AE_SESSION" 2>/dev/null || true)
        fi

        # 10. Telegram bridge supervision — best-effort revive of the machine-global
        #     daemon if it died while this session's watchdog is alive. Throttled to
        #     TG_SUPERVISE_SECS. The revive runs the autostart path (respects
        #     [telegram] enabled, never flips it) and is idempotent/flock-guarded, so
        #     concurrent watchdogs across sessions are safe. Fully silent + non-fatal.
        if ((TG_SUPERVISE_SECS > 0)) && [[ -n "${AE_PATH_BIN:-}" && -x "${AE_PATH_BIN:-}" ]]; then
            now_epoch="$(date +%s)"
            if ((now_epoch - last_tg_supervise >= TG_SUPERVISE_SECS)); then
                last_tg_supervise=$now_epoch
                # Propagate this session's tmux server (mirrors spawn/retire) so the
                # bridge is checked/spawned on the SAME server the session uses —
                # otherwise it'd hit the default server and `ae telegram stop` under
                # the intended server would miss it.
                tg_srv="$(grep '^tmux_server=' "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
                if [[ -n "$tg_srv" ]]; then
                    AE_TMUX_SERVER="$tg_srv" "$AE_PATH_BIN" telegram _supervise >/dev/null 2>&1 || true
                else
                    "$AE_PATH_BIN" telegram _supervise >/dev/null 2>&1 || true
                fi
            fi
        fi

        # Push live status into the tmux user options: health → status-right,
        # branch+dirty → status-left (after the static path).
        if ((cycle_dead > 0)); then
            glyph="✖"
        elif ((cycle_stale > 0)); then
            glyph="⚠"
        else
            glyph="●"
        fi
        _watchdog_set_status @ae_watchdog_status "[watch ${glyph} ${cycle_active}/${cycle_total}]"
        _watchdog_set_status @ae_branch_status "$(_watchdog_branch_segment)"
        # Per-agent roster → status-format[1] right side. Keyed by the agents meta
        # REGISTERS, not by the panes that happen to be alive: an agent whose pane is
        # gone keeps its slot and renders ✖ instead of vanishing into a shorter line
        # that reads as a healthy org. Verdicts are only ever the ones the branches
        # above already reached this cycle; anything unjudged stays neutral rather than
        # borrowing a liveness claim.
        roster="$(
            while IFS=$'\t' read -r roster_slot roster_ref; do
                [[ -n "$roster_slot" ]] || continue
                # Route by SLOT, label by ref: two slots may legitimately share a display
                # ref (spawn never uniquifies the name), and they must resolve to their
                # OWN panes — otherwise one live pane would speak for both and a dead
                # one would never show ✖.
                roster_p="${live_slots[$roster_slot]:-}"
                if [[ -z "$roster_p" ]]; then
                    # Debounced: only a slot missing for TWO consecutive cycles is ✖.
                    # A first sighting is '·' (undecided) — a spawn mid-stamp is not a
                    # failure, and saying so would be the same manufactured claim the
                    # roster exists to avoid.
                    if [[ -n "${missing_streak[$roster_slot]:-}" ]]; then
                        printf '%s\t%s\n' "$roster_ref" "missing"
                    else
                        printf '%s\t%s\n' "$roster_ref" ""
                    fi
                else
                    printf '%s\t%s\n' "$roster_ref" "${roster_verdict[$roster_p]:-}"
                fi
            done <<<"$roster_slots_snapshot" | _roster_compose
        )"
        # Advance/reset the debounce from the SAME snapshot the roster was composed from.
        while IFS=$'\t' read -r _ms_slot _ms_ref; do
            [[ -n "$_ms_slot" ]] || continue
            if [[ -n "${live_slots[$_ms_slot]:-}" ]]; then
                unset 'missing_streak[$_ms_slot]'
            else
                missing_streak["$_ms_slot"]=1
            fi
        done <<<"$roster_slots_snapshot"
        if [[ -n "$roster" ]]; then
            _watchdog_set_status @ae_agents_status "$roster"
        else
            # UNSET, never publish "" — a roster outliving its agents would keep
            # asserting a fleet that no longer exists.
            _roster_sid="$(_watchdog_session_id)"
            if [[ -n "$_roster_sid" ]]; then
                tmux set-option -t "$_roster_sid" -u @ae_agents_status 2>/dev/null || true
            fi
        fi
        # Per-WINDOW glyphs → the window list. Grouped from the SAME per-pane verdicts,
        # in pane order. Window index comes from its own cheap list-panes call rather
        # than being added to the main loop's format string — that format is a pinned
        # parity contract with the aewatch sidecar (tests/aewatch_tests/test_25).
        while IFS=$'\t' read -r _w_id _w_glyphs; do
            [[ -n "$_w_id" ]] || continue
            # Target by WINDOW ID (@N), never by index. An index is a POSITION: closing a
            # window can renumber the ones after it (tmux's renumber-windows), so glyphs
            # published against an index can land on the wrong window, and — worse — stop
            # cleanup can MISS a renumbered window and leave exactly the frozen glyphs the
            # cleanup exists to prevent. @N is server-global unique and stable for the
            # window's life, which also means the target carries no session name at all
            # and so sidesteps the prefix-match hazard entirely.
            tmux set-option -w -t "$_w_id" @ae_window_status "$_w_glyphs" 2>/dev/null || true
        done < <(
            {
                while IFS='|' read -r _p _w_id_p _pa; do
                    [[ -n "$_p" ]] || continue
                    # Non-agent panes (the watchdog/events panes, or anything unstamped)
                    # register their WINDOW but contribute NO glyph — the monitor window
                    # must read '99:ae-monitor', not '99:ae-monitor··'. Emitting the row
                    # anyway is what lets a window that no longer holds agents be
                    # published EMPTY instead of keeping last cycle's glyphs. Skip list
                    # mirrors the cycle's own (see the pane loop).
                    case "$_pa" in
                        "" | "(null)" | _watchdog | _shepherd | _loop | _events)
                            printf '%s\t\n' "$_w_id_p"
                            continue
                            ;;
                    esac
                    printf '%s\t%s\n' "$_w_id_p" "$(_roster_glyph "${roster_verdict[$_p]:-__none__}")"
                done < <(tmux list-panes -s -t "$_AE_SESSION" -F '#{pane_id}|#{window_id}|#{@ae_agent}' 2>/dev/null || true)
            } | _roster_window_compose
        )

        sleep "$INTERVAL"
    done

    rm -f "$PIDFILE"
}

ATTACH_ON_READY=true
case "${1:-}" in
    list | ls)
        cmd_list "${@:2}"
        exit $?
        ;;
    status)
        cmd_status "${2:-}"
        exit $?
        ;;
    compact)
        cmd_compact "${@:2}"
        exit $?
        ;;
    archive)
        case "${2:-}" in
            preview)
                cmd_archive_preview "${3:-}"
                exit $?
                ;;
            *)
                echo "Usage: ae archive preview [session-name]" >&2
                exit 1
                ;;
        esac
        ;;
    next | jump)
        cmd_next "${@:2}"
        exit $?
        ;;
    doctor)
        cmd_doctor "${@:2}"
        exit $?
        ;;
    stop)
        cmd_stop "${@:2}"
        exit $?
        ;;
    # Internal: the detached self-stop worker (spawned by _stop_self_supervised via
    # nohup). Not part of the user surface — like _spawn / _retire / _register-sid.
    _stop-supervisor)
        _cmd_stop_supervisor "${2:-}"
        exit $?
        ;;
    _stop-fleet-supervisor)
        # <opid> <name>... — the fleet is argv, frozen at confirmation (F9).
        _cmd_stop_fleet_supervisor "${@:2}"
        exit $?
        ;;
    rename)
        cmd_rename "${2:-}" "${3:-}"
        exit $?
        ;;
    watchdog | loop) # 'loop' kept as the deprecated alias for the renamed feature
        cmd_watchdog "${2:-}" "${3:-}"
        exit $?
        ;;
    telegram)
        cmd_telegram "${@:2}"
        exit $?
        ;;
    steward | hub) # 'hub' kept as the deprecated alias for the renamed meta-agent
        # Steward (meta-agent) launcher. Trampoline: handle --init/help (exit),
        # else set up FULL config isolation (the start-steward wrapper's job) and
        # FALL THROUGH to the generic start/resume path below. We must NOT
        # re-dispatch the subcommand here (that would re-enter this branch and
        # recurse) — falling through reuses the generic parser instead.
        shift
        _steward_attach=false
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --init)
                    if [[ $# -gt 1 ]]; then
                        echo "Error: 'ae steward --init' takes no further arguments (got: ${*:2})" >&2
                        exit 1
                    fi
                    cmd_steward_init
                    exit $?
                    ;;
                -h | --help | help)
                    cmd_steward_help
                    exit 0
                    ;;
                --attach | --switch)
                    _steward_attach=true
                    shift
                    ;;
                --detach | --no-attach)
                    _steward_attach=false
                    shift
                    ;;
                *)
                    # The steward session is ALWAYS named `steward` (legacy scaffold:
                    # `hub`) with the standalone config; accepting extra args would
                    # let `ae steward foo` become session `foo` via the generic
                    # parser (last positional wins), leaking the reserved name +
                    # steward config onto another session. Reject them.
                    echo "Error: 'ae steward' takes no positional arguments (flags: --init / --help / --attach / --detach). Got: $*" >&2
                    echo "The steward session is always named 'steward' (config: \${AE_STEWARD_DIR:-~/.ae/steward}/steward.config)." >&2
                    echo "To run a normal session literally named 'steward', use: ae --local steward" >&2
                    exit 1
                    ;;
            esac
        done
        if $_steward_attach; then
            ATTACH_ON_READY=true
        else
            ATTACH_ON_READY=false
        fi
        # Resolve the scaffold: canonical steward layout first, then the legacy
        # hub layout (from 'ae hub --init' before the rename). The config file
        # found decides the SESSION NAME too — a legacy hub.config keeps running
        # as session `hub` so its baked charter paths (~/.ae/sessions/hub) and
        # resume state stay consistent; a steward.config runs as `steward`.
        _steward_session=steward
        if [[ -n "${AE_STEWARD_DIR:-}" ]]; then
            _steward_dir="$AE_STEWARD_DIR"
            _steward_config="$_steward_dir/steward.config"
        elif [[ -f "$CONFIG_DIR/steward/steward.config" ]]; then
            _steward_dir="$CONFIG_DIR/steward"
            _steward_config="$_steward_dir/steward.config"
        elif [[ -n "${AE_HUB_DIR:-}" ]]; then
            _steward_dir="$AE_HUB_DIR"
            _steward_config="$_steward_dir/hub.config"
            _steward_session=hub
        elif [[ -f "$CONFIG_DIR/meta-hub/hub.config" ]]; then
            _steward_dir="$CONFIG_DIR/meta-hub"
            _steward_config="$_steward_dir/hub.config"
            _steward_session=hub
        else
            _steward_dir="$CONFIG_DIR/steward"
            _steward_config="$_steward_dir/steward.config"
        fi
        if [[ ! -f "$_steward_config" ]]; then
            echo "Error: no steward config at $_steward_config." >&2
            echo "Run 'ae steward --init' to scaffold the steward config + charter." >&2
            exit 1
        fi
        if [[ "$_steward_session" == "hub" ]]; then
            echo "note: using legacy hub scaffold ($_steward_config) — session stays 'hub'."
            echo "      To migrate: ae end hub && ae steward --init && ae steward"
        fi
        # BLOCKER fix (codex): CONFIG_FILE alone does NOT isolate. AE_LOCAL_CONFIG
        # was captured from the CALLER's PWD near script top (before any cd), so a
        # project-local ./.ae/config could still override workspace.*/prompt.* and
        # reintroduce the worker-leak. Replicate the wrapper's full isolation:
        AE_LOCAL_CONFIG="" # drop the caller-PWD local config
        cd "$_steward_dir" || {
            echo "Error: cannot cd to $_steward_dir" >&2
            exit 1
        }
        # Set CONFIG_FILE from $PWD *after* cd so it's absolute even when the dir
        # override is relative (a relative path stored in meta would break resume).
        CONFIG_FILE="$PWD/$(basename "$_steward_config")" # standalone config wins (absolute, isolated)
        # copy=local ⇒ work_dir/origin become $_steward_dir; on resume the restore
        # path below rebuilds AE_LOCAL_CONFIG from stored_origin (no .ae/config
        # there), so the isolation persists across resume too.
        set -- "$_steward_session" # session name (extra args already rejected above)
        # fall through (NO exit) to flag-parse + generic start/resume
        ;;
    transfer)
        cmd_transfer "${@:2}"
        exit $?
        ;;
    end | rm)
        cmd_end "${@:2}"
        exit $?
        ;;
    _spawn)
        _cmd_spawn "${@:2}"
        exit $?
        ;;
    _retire)
        _cmd_retire "${@:2}"
        exit $?
        ;;
    _recover-pending)
        cmd_recover_pending "${@:2}"
        exit $?
        ;;
    help | -h | --help)
        cmd_help
        exit 0
        ;;
    version | --version | -V)
        echo "ae ${AE_VERSION}"
        exit 0
        ;;
esac

# --- Parse flags ---
# A FUNCTION, not an inline while-loop: the grammar has real rules now — `--from` takes
# exactly one value, may appear once, and is order-free like the mode flags — and a
# top-level loop can only be exercised by launching a real session. It returns rather
# than exits so a probe can call it; the caller below turns a refusal into exit 1.
# DEFINED BEFORE ANY LAUNCH BODY THAT CALLS IT. The --from reproof calls this from
# SCRIPT BODY, which bash executes top-to-bottom — with the definition further down
# the file it was a missing command (rc 127) and the rollback never ran: the failure
# was correctly DETECTED and the cleanup silently did not happen, leaving a half-built
# same-name session squatting the name the recovery command needs.
_launch_rollback() {
    local _rc="${1:-1}"
    echo "ae: launch failed — rolling back '${SESSION}'." >&2
    tmux kill-session -t "$SESSION" 2>/dev/null || true
    if ((${_AE_SESSION_DIR_CREATED:-0} != 1)); then
        echo "ae: session state KEPT — it predates this attempt; retry with 'ae ${SESSION}'." >&2
    elif ! _path_is_direct_child "$SESSIONS_DIR" "${AE_META:-}"; then
        # Unreachable after entry validation; kept because the alternative to an
        # unreachable branch here is an unbounded rm -rf.
        echo "ae: session state KEPT — '${AE_META:-}' is not a direct child of ${SESSIONS_DIR}; refusing to delete." >&2
    else
        rm -rf "$AE_META" 2>/dev/null || true
        echo "ae: session state removed — this launch created it; nothing left to reattach to." >&2
    fi
    exit "$_rc"
}

_launch_parse_flags() { # <args...> -> _LP_MODE _LP_NAME _LP_MAIN _LP_FROM
    _LP_MODE=""
    _LP_NAME=""
    _LP_MAIN=""
    _LP_FROM=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --worktree)
                _LP_MODE="git"
                shift
                ;;
            --copy)
                _LP_MODE="full"
                shift
                ;;
            --local)
                _LP_MODE="local"
                shift
                ;;
            --from | --from=*)
                if [[ -n "$_LP_FROM" ]]; then
                    echo "Error: --from may be given only once — a session inherits from exactly one archive." >&2
                    return 1
                fi
                if [[ "$1" == --from=* ]]; then
                    _LP_FROM="${1#--from=}"
                    shift
                else
                    shift
                    if [[ $# -eq 0 ]]; then
                        _LP_FROM=""
                    else
                        _LP_FROM="$1"
                        shift
                    fi
                fi
                if [[ -z "$_LP_FROM" ]]; then
                    echo "Error: --from requires an archive UUID (list them: ls ~/.ae/archive)." >&2
                    return 1
                fi
                ;;
            use)
                shift
                if [[ $# -eq 0 ]]; then
                    echo "Error: 'use' requires an agent alias (e.g. ae myproject use codex)" >&2
                    return 1
                fi
                _LP_MAIN="$1"
                shift
                ;;
            --*)
                echo "Error: unknown flag '$1'. Use --worktree, --copy, --local, or --from <archive-uuid>." >&2
                return 1
                ;;
            *)
                _LP_NAME="$1"
                shift
                ;;
        esac
    done
    return 0
}

_launch_parse_flags "$@" || exit 1
COPY_MODE_OVERRIDE="$_LP_MODE"
SESSION="$_LP_NAME"
MAIN_OVERRIDE="$_LP_MAIN"
FROM_ARCHIVE="$_LP_FROM"

check_deps || exit 1

# Session name: use argument if given, otherwise derive from PWD
SESSION_DERIVED=false
if [[ -z "$SESSION" ]]; then
    SESSION="$(default_session_name)"
    SESSION_DERIVED=true
fi

# The single validation chokepoint, placed BEFORE the first tmux call and before
# any path is built from the name — nothing below may assume it was checked
# somewhere else, and nothing above has touched the disk yet.
_validate_session_name "$SESSION" || exit 1

# DERIVED-NAME OWNERSHIP. A name the user TYPED means "that session, wherever I
# am" — attaching from elsewhere is the whole point. A name ae DERIVED means
# "the session for this directory", and reusing it is only correct if the
# existing session actually belongs here. The body of a derived name is lossy
# ('A ~"B' and 'A#==B' both reduce to 'A-B'), and six hex characters is 24 bits,
# so a name match is evidence, not proof. Without this check, a no-name launch
# in the wrong directory silently ATTACHES to another project's session and its
# conversation — a confidentiality failure that looks like success.
#
# Checked here, once, ahead of BOTH reuse paths (the running-session fast path
# below and the on-disk resume after it).
_require_session_path_safe "$SESSION" || exit 1

# --- Explicit lineage preflight (--from) ---
# Runs BEFORE the first tmux call, the first mkdir and any config mutation, so an
# invalid parent leaves ZERO side effects rather than a half-built session pointing at
# an archive that is not there. Order inside is deliberate: the archive is proved first
# (pure filesystem, no tmux at all), then the freshness rule.
#
# Lineage is EXPLICIT or absent. `--from` is only valid for a session that does not yet
# exist in any form — refusing rather than attaching, because "resume this session AND
# inherit that archive" is a request with two different meanings and no safe default.
PARENT_ARCHIVE_ID=""
PARENT_ARCHIVE_HANDOVER=""
PARENT_ARCHIVE_PENDING=""
if [[ -n "$FROM_ARCHIVE" ]]; then
    _from_proof="$(_ar_from_preflight "$FROM_ARCHIVE")" || exit 1
    IFS=$'\t' read -r PARENT_ARCHIVE_ID PARENT_ARCHIVE_HANDOVER PARENT_ARCHIVE_PENDING <<<"$_from_proof"
    if tmux has-session -t "$SESSION" 2>/dev/null ||
        [[ -d "${SESSIONS_DIR}/${SESSION}" || -d "${WORKTREES_DIR}/${SESSION}" ]]; then
        echo "Error: --from is only valid for a NEW session, and '${SESSION}' already exists." >&2
        echo "       Inheriting an archive into a running or resumable session would mean two" >&2
        echo "       different things (replace its history? merge it?) with no safe default." >&2
        echo "       Start the continuation under its own name:" >&2
        echo "           ae <new-name> --from ${PARENT_ARCHIVE_ID}" >&2
        exit 1
    fi
fi

if [[ "$SESSION_DERIVED" == true && -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
    _derived_owner="$(read_session_meta "$SESSION" origin)"
    # Compare CANONICAL paths, not raw strings. Two spellings of one directory —
    # a symlinked alias, a trailing slash — are the same place, and a raw
    # comparison refused the rightful owner and pointed it at a duplicate.
    # An origin that is RECORDED but cannot be resolved FAILS CLOSED. "A
    # collision needs two live directories" is only true at CREATION: the owner's
    # directory can be deleted later while its session state and conversation
    # history persist, so a moved project and a collision with a deleted one are
    # indistinguishable from here — and guessing "moved" resumes a foreign
    # conversation. Refusing strands nothing, because `ae <exact-name>` typed
    # bypasses this check by design; the error names that route explicitly.
    # Only an ABSENT origin proceeds with a note: a pre-tracking session never
    # recorded a claim there is anything to violate.
    _here_canon="$(_canonical_dir "$PWD" || true)"
    [[ -n "$_here_canon" ]] || _here_canon="$PWD"
    _owner_canon=""
    [[ -n "$_derived_owner" ]] && _owner_canon="$(_canonical_dir "$_derived_owner" || true)"
    if [[ -z "$_derived_owner" ]]; then
        # Pre-dates origin tracking. Refusing would strand old sessions with no
        # way back in; proceeding silently is what this guard exists to stop. So:
        # proceed, and say exactly what was assumed.
        echo "note: '${SESSION}' records no origin (pre-dates ownership tracking) — assuming it belongs to ${_here_canon}." >&2
    elif [[ -z "$_owner_canon" ]]; then
        # FAIL CLOSED. My earlier "a collision needs two LIVE directories"
        # argument holds only AT CREATION: the owner's directory can be deleted
        # or moved AFTERWARDS while its session state and agent conversation
        # history persist. A colliding live directory then lands exactly here,
        # and "assume it moved" resumes a FOREIGN conversation. Refusing strands
        # nothing, because `ae <exact-name>` typed is already the deliberate
        # ownership bypass — that escape hatch exists by design, and the message
        # names it rather than leaving the user to find it.
        echo "Error: '${SESSION}' records origin ${_derived_owner}, which no longer exists." >&2
        echo "       A MOVED project and a name COLLISION with a DELETED one look identical" >&2
        echo "       from here, and guessing wrong resumes someone else's conversation." >&2
        echo "       If that session is this project's, claim it by name:" >&2
        echo "           ae ${SESSION}" >&2
        echo "       If it is not, start this one under a distinguished name:" >&2
        echo "           ae $(default_session_name 12)" >&2
        exit 1
    elif [[ "$_owner_canon" != "$_here_canon" ]]; then
        echo "Error: '${SESSION}' is the derived name of a DIFFERENT directory." >&2
        echo "       it belongs to:  ${_owner_canon}" >&2
        echo "       you are in:     ${_here_canon}" >&2
        echo "       Two directories can reduce to the same derived name; attaching would join" >&2
        echo "       that project's session and its conversation. Launch this one under a name" >&2
        echo "       carrying more of the path hash:" >&2
        echo "           ae $(default_session_name 12)" >&2
        exit 1
    fi
fi

# Existing session? Just reattach (but only if it's an ae session).
if tmux has-session -t "$SESSION" 2>/dev/null; then
    if tmux show-environment -t "$SESSION" AE_SESSION 2>/dev/null | grep -q '^AE_SESSION='; then
        _telegram_autostart_if_enabled 2>/dev/null || true
        _steward_autostart_if_scaffolded 2>/dev/null || true
        # NOTE: aewatch autostart is deliberately NOT wired on reattach. Watchdog
        # ownership is decided once at launch (_start_session_watchdog); reviving or
        # migrating a running session's watchdog under AE_WATCHDOG_IMPL=uv (a bash-owned
        # session reattached with uv) would double-run — that mode-switch is its own slice.
        if [[ "$ATTACH_ON_READY" != "true" ]]; then
            echo "Session '$SESSION' is running. Use 'ae steward --attach' to view."
            exit 0
        fi
        tmux_attach "$SESSION"
    else
        echo "Error: tmux session '$SESSION' exists but is not an ae session." >&2
        exit 1
    fi
fi

# On resume: restore config paths from meta (ensures agent aliases resolve from original config)
if [[ -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
    _stored_config="$(read_session_meta "$SESSION" config)"
    if [[ -n "$_stored_config" && -f "$_stored_config" ]]; then
        CONFIG_FILE="$_stored_config"
    fi
    _stored_origin="$(read_session_meta "$SESSION" origin)"
    if [[ -n "$_stored_origin" && -f "${_stored_origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${_stored_origin}/.ae/config"
    else
        AE_LOCAL_CONFIG=""
    fi
fi

# --- Validate config before creating anything ---
# Parse alias[:name] — e.g. "claude:lead" → alias=claude, name=lead
# If no name given, name defaults to the alias itself
# On resume: recover agent from session meta (preserves 'use' override)
# PROVENANCE, because the same variable is validated differently depending on where its
# value came from. A name arriving FRESH from config or the CLI is something the human can
# still fix, so a violation is fatal and says so. A name RESTORED from a session's own meta
# is a fact about a session that already exists — it may predate the grammar entirely — and
# refusing it would mean a legacy session could never be resumed again. Restored values are
# therefore left to the interpolation-site guard, which drops the identity line quietly and
# lets the agent launch. Same rule as `_session_name_usable`: strict where a name is
# CREATED, forgiving where one is CONSUMED.
_MAIN_NAME_RESTORED=false
_ROSTER_NAMES_RESTORED=false
if [[ -z "$MAIN_OVERRIDE" ]]; then
    _saved_main="$(read_session_meta "$SESSION" agent.main)"
    if [[ -n "$_saved_main" ]]; then
        # agent.main format is alias:name:session_id — extract alias:name
        _saved_alias="${_saved_main%%:*}"
        _saved_rest="${_saved_main#*:}"
        _saved_name="${_saved_rest%%:*}"
        MAIN_RAW="${_saved_alias}:${_saved_name}"
        _MAIN_NAME_RESTORED=true
    else
        MAIN_RAW="$(get_config workspace.main)"
    fi
else
    MAIN_RAW="$MAIN_OVERRIDE"
fi
# THE ROSTER THE HUMAN AUTHORIZED, not the one the config files hold now. compact resolves
# main+workers at the moment it prints them at the prompt and freezes THAT ANSWER; the
# files it resolved them from stay live and can be edited during the end — a window in
# which the source session is already archived and gone, so a child starting the wrong
# roster cannot be undone. Freezing the resolved VALUE is what makes the child start what
# was agreed. Freezing the config PATH would only have frozen a pointer to something still
# mutable, and the origin's own .ae/config is layered at every ae startup regardless of
# CONFIG_FILE, so a snapshot of the recorded config would not have closed this at all.
# ONLY THIS LAUNCH: a later resume is a NEW decision by the human against whatever config
# exists then. compact promises continuity of the session it archived, not permanent
# immunity from config edits — do not "fix" that.
_AE_FROZEN_WORKERS_SET=false
_AE_FROZEN_WORKERS=""
# THE LIMIT OF THIS GATE, NAMED RATHER THAN IMPLIED: it fires when _AE_FROM_ROSTER is set
# AND this is a --from launch AND no explicit `use <alias>` override was given. The only
# path known to set _AE_FROM_ROSTER is compact's exec into this launch; NO ENUMERATION of
# other possible setters has been done. If you reach here with PARENT_ARCHIVE_ID from some
# other route, this gate has not been proven for your path — read it as scoped to compact,
# not as a general guarantee.
if [[ -n "${_AE_FROM_ROSTER:-}" && -n "$PARENT_ARCHIVE_ID" && -z "$MAIN_OVERRIDE" ]]; then
    _fr_main="${_AE_FROM_ROSTER#main=}"
    _fr_main="${_fr_main%% workers=*}"
    _fr_workers="${_AE_FROM_ROSTER##*workers=}"
    [[ "$_fr_workers" == "-" ]] && _fr_workers=""
    if [[ -n "$_fr_main" ]]; then
        MAIN_RAW="$_fr_main"
        # Restored, not fresh: this roster is the PARENT session's resolved meta. A fatal
        # here would kill a compact child AFTER the source is archived and gone — the one
        # failure with nothing left to fall back to.
        _MAIN_NAME_RESTORED=true
        _ROSTER_NAMES_RESTORED=true
        _AE_FROZEN_WORKERS_SET=true
        _AE_FROZEN_WORKERS="$_fr_workers"
    fi
fi
if [[ "$MAIN_RAW" == *:* ]]; then
    MAIN_ALIAS="${MAIN_RAW%%:*}"
    MAIN_NAME="${MAIN_RAW#*:}"
else
    MAIN_ALIAS="$MAIN_RAW"
    MAIN_NAME="$MAIN_RAW" # default name = alias
fi
if [[ "$MAIN_NAME" == *:* ]]; then
    echo "Error: agent name '${MAIN_NAME}' cannot contain ':' — use alias:name format (one colon)" >&2
    exit 1
fi
# Operator boundary (see _validate_agent_name). Same point in the launch as the ':' check
# above: roster parsing, before the first side effect — but ONLY for a value the human just
# supplied. A restored one is fail-quiet by design (see the provenance note above): a
# non-conforming legacy `agent.main` costs that agent its identity line, never its resume.
if [[ "$_MAIN_NAME_RESTORED" != true ]]; then
    _validate_agent_name "$MAIN_NAME" || exit 1
fi
LAYOUT="$(get_config workspace.layout)"
if [[ "$_AE_FROZEN_WORKERS_SET" == true ]]; then
    WORKERS_RAW="$_AE_FROZEN_WORKERS"
else
    WORKERS_RAW="$(get_config workspace.workers)"
fi
# meta-agent (steward) mode: [workspace] steward = true (canonical) — or its
# legacy aliases hub = true / meta = true — marks this session as the fleet
# steward. The watchdog then runs a sweep-cadence (periodic "run your sweep now")
# instead of the stale-nudge watchdog. Persisted to meta as meta_agent (internal
# name unchanged).
META_AGENT_CFG="$(get_config workspace.steward)"
[[ -z "$META_AGENT_CFG" ]] && META_AGENT_CFG="$(get_config workspace.hub)"
[[ -z "$META_AGENT_CFG" ]] && META_AGENT_CFG="$(get_config workspace.meta)"

# Determine copy mode: CLI flag > config > default (local)
if [[ -n "$COPY_MODE_OVERRIDE" ]]; then
    COPY_MODE="$COPY_MODE_OVERRIDE"
else
    COPY_MODE="$(get_config workspace.copy)"
    COPY_MODE="${COPY_MODE:-local}"
fi

# On resume: force mode from stored meta to prevent drift (CLI flag still overrides)
if [[ -z "$COPY_MODE_OVERRIDE" ]] && [[ -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
    _stored_mode="$(read_session_meta "$SESSION" mode)"
    [[ -n "$_stored_mode" ]] && COPY_MODE="$_stored_mode"
fi

if [[ "$COPY_MODE" != "git" ]] && [[ "$COPY_MODE" != "full" ]] && [[ "$COPY_MODE" != "local" ]]; then
    echo "Error: invalid copy mode '${COPY_MODE}'. Use 'git', 'full', or 'local'." >&2
    exit 1
fi

if [[ -z "$MAIN_ALIAS" ]]; then
    echo "Error: workspace.main not set in $CONFIG_FILE" >&2
    exit 1
fi

MAIN_CMD="$(get_config "agents.${MAIN_ALIAS}")"
if [[ -z "$MAIN_CMD" ]]; then
    echo "Error: agent '${MAIN_ALIAS}' not defined in $CONFIG_FILE" >&2
    exit 1
fi

_resolve_workers

# --- Working directory: local, resume existing, or create new ---
ORIGIN_DIR="$PWD"
WORK_DIR="${WORKTREES_DIR}/${SESSION}"
RESUMING=false

if [[ "$COPY_MODE" == "local" ]]; then
    # Local mode: work directly in current directory, no copy
    # Mode collision: error if a stopped worktree/copy session exists with the same name
    if [[ -d "${WORKTREES_DIR}/${SESSION}" ]]; then
        echo "Error: stopped session '${SESSION}' exists as worktree/copy. End it first (ae end ${SESSION}), or use a different name." >&2
        exit 1
    fi
    WORK_DIR="$PWD"
    # Resume if session meta exists from a previous run (e.g. after reboot)
    if [[ -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
        RESUMING=true
        # Restore original work_dir so agents resume in the correct CWD
        # (Claude Code's --resume is scoped to ~/.claude/projects/<encoded-CWD>/)
        _stored_wd="$(read_session_meta "$SESSION" work_dir)"
        if [[ -n "$_stored_wd" && -d "$_stored_wd" ]]; then
            WORK_DIR="$_stored_wd"
        fi
        _stored_origin="$(read_session_meta "$SESSION" origin)"
        [[ -n "$_stored_origin" ]] && ORIGIN_DIR="$_stored_origin"
        echo "Resuming session ${SESSION} (dir: ${WORK_DIR})..."
    fi
elif [[ -d "$WORK_DIR" ]]; then
    # Existing worktree — resume it (e.g. after reboot)
    RESUMING=true
    # Restore ORIGIN_DIR from meta (used by cleanup and env vars)
    _stored_origin="$(read_session_meta "$SESSION" origin)"
    [[ -n "$_stored_origin" ]] && ORIGIN_DIR="$_stored_origin"
    echo "Resuming session ${SESSION}..."
else
    mkdir -p "$WORK_DIR"
    if [[ "$COPY_MODE" == "git" ]]; then
        # Git worktree: fast, shares .git, true isolation
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            echo "Creating git worktree..."
            git worktree add --detach "$WORK_DIR" HEAD 2>/dev/null || {
                # Stale registration — prune and retry
                git worktree prune 2>/dev/null || true
                git worktree add --detach "$WORK_DIR" HEAD
            }
        else
            echo "Warning: not a git repo, falling back to full copy." >&2
            COPY_MODE="full"
            echo "Creating full copy..."
            cp -a "$PWD/." "$WORK_DIR"
        fi
    else
        # Full copy: includes untracked files (node_modules, .venv, etc.)
        echo "Creating full copy..."
        cp -a "$PWD/." "$WORK_DIR"
    fi
    echo "Working copy ready."
fi

# Resume: layout is META-WINS — pinned at launch, preserved on resume (a config `layout` flip
# applies to NEW sessions only, mirroring agent.* identity). Explicit if (set -e safe).
if [[ "$RESUMING" == true ]]; then
    _saved_layout="$(read_session_meta "$SESSION" layout)"
    if [[ -n "$_saved_layout" ]]; then
        LAYOUT="$_saved_layout"
    fi
fi

# --- Create tmux session in the worktree ---
PANE_IDS=()
# LIFECYCLE LOCK (11th review B2): mutual exclusion with `ae end` — creation/resume
# must not interleave with an end's proof-through-cleanup window. Held on fd 9 through
# meta finalization and released explicitly before attach (an exec'd attach would
# otherwise hold it for the whole interactive session).
mkdir -p "$SESSIONS_DIR"
# fd 8 (fd 9 belongs to the helper library's target lock). flock is util-linux, not
# part of ae's bash+tmux+git hard-dependency contract (12th review I2) — when absent,
# degrade to unlocked with a one-line note instead of breaking core commands.
exec 8>"${SESSIONS_DIR}/.lifecycle.${SESSION}.lock"
if command -v flock >/dev/null 2>&1; then
    if ! flock -w 15 8; then
        echo "Error: another lifecycle operation (end) is in progress for '$SESSION' — retry shortly." >&2
        exit 1
    fi
else
    echo "note: flock not found — lifecycle locking degraded (start/end races unguarded)" >&2
fi
# 9>&- : the FIRST client call auto-starts the tmux SERVER, a daemon that would
# inherit fd 9 — and flock lives on the open file DESCRIPTION, so the server would
# hold this session's lifecycle lock for its whole life (every later `ae end`
# refused; found by the suite, reproduced in a rig). Close the fd for this child.
tmux new-session -d -s "$SESSION" -c "$WORK_DIR" 8>&-
# Unset env vars that prevent Claude Code from starting inside tmux
tmux set-environment -t "$SESSION" -u CLAUDECODE
tmux set-environment -t "$SESSION" -u CLAUDE_CODE_SESSION

# Tag as ae session and store directories/mode
tmux set-environment -t "$SESSION" AE_SESSION 1
tmux set-environment -t "$SESSION" AE_ORIGIN "$ORIGIN_DIR"
tmux set-environment -t "$SESSION" AE_DIR "$WORK_DIR"
tmux set-environment -t "$SESSION" AE_MODE "$COPY_MODE"
# Pin AE_HOME into the session so hidden helpers run from the pane (spawn/retire →
# `ae _spawn`/`_retire`) resolve the SAME ae state, not the real ~/.ae — without
# relying on tmux-server env inheritance. Only meaningful when AE_HOME is overridden.
tmux set-environment -t "$SESSION" AE_HOME "$CONFIG_DIR"

# ae-specific tmux options (session-scoped, doesn't affect other tmux usage)
tmux set-option -t "$SESSION" mouse on
tmux set-option -t "$SESSION" focus-events on 2>/dev/null || true
tmux set-option -t "$SESSION" history-limit 50000
tmux set-option -t "$SESSION" pane-border-status top
tmux set-option -t "$SESSION" pane-border-format " #{@ae_agent} "
_ae_apply_status_bar "$SESSION" "$COPY_MODE" "$ORIGIN_DIR" "$WORK_DIR"
tmux set-option -t "$SESSION" automatic-rename off
tmux rename-window -t "$SESSION" "$(_ae_tmux_format_literal "$SESSION")"

PANE_IDS+=("$(tmux display-message -t "$SESSION" -p '#{pane_id}')")

for i in "${!WORKER_CMDS[@]}"; do
    local_id=""
    if [[ "$LAYOUT" == "lead-pair" ]]; then
        # worker.0 = the COLEAD SEAT: shares window 0 with the lead, side by side.
        # Workers 1+ live in window 1, split among themselves.
        if ((i == 0)); then
            local_id="$(tmux split-window -h -t "${PANE_IDS[0]}" -c "$WORK_DIR" -P -F '#{pane_id}')"
        elif ((i == 1)); then
            local_id="$(tmux new-window -d -t "${SESSION}:" -c "$WORK_DIR" -P -F '#{pane_id}')"
        else
            _prev=$((${#PANE_IDS[@]} - 1)) # split the previous worker pane (4.0-safe index)
            local_id="$(tmux split-window -v -t "${PANE_IDS[$_prev]}" -c "$WORK_DIR" -P -F '#{pane_id}')"
        fi
    elif [[ "$LAYOUT" == "lead-solo" ]]; then
        # Workers live in window 1, split among THEMSELVES; window 0 stays lead-only.
        if ((i == 0)); then
            local_id="$(tmux new-window -d -t "${SESSION}:" -c "$WORK_DIR" -P -F '#{pane_id}')"
        else
            _prev=$((${#PANE_IDS[@]} - 1)) # split the previous worker pane (4.0-safe index)
            local_id="$(tmux split-window -v -t "${PANE_IDS[$_prev]}" -c "$WORK_DIR" -P -F '#{pane_id}')"
        fi
    elif [[ "$LAYOUT" == "vertical" ]]; then
        local_id="$(tmux split-window -h -t "$SESSION" -c "$WORK_DIR" -P -F '#{pane_id}')"
    else
        local_id="$(tmux split-window -v -t "$SESSION" -c "$WORK_DIR" -P -F '#{pane_id}')"
    fi
    PANE_IDS+=("$local_id")
done

# Distribute panes evenly
if ((${#PANE_IDS[@]} > 1)); then
    if [[ "$LAYOUT" == "lead-pair" ]]; then
        # Window 0: lead + colead side by side. Window 1: workers 1+ (even only when 2+).
        tmux select-layout -t "${PANE_IDS[0]}" even-horizontal
        if ((${#WORKER_CMDS[@]} > 2)); then
            tmux select-layout -t "${PANE_IDS[2]}" even-vertical
        fi
    elif [[ "$LAYOUT" == "lead-solo" ]]; then
        # Distribute the workers WITHIN window 1 (only when 2+ workers).
        if ((${#WORKER_CMDS[@]} > 1)); then
            tmux select-layout -t "${PANE_IDS[1]}" even-vertical
        fi
    elif [[ "$LAYOUT" == "vertical" ]]; then
        tmux select-layout -t "$SESSION" even-horizontal
    else
        tmux select-layout -t "$SESSION" even-vertical
    fi
fi
# Role-based window names use FIXED literals — NEVER an agent name. Agent identity
# lives on @ae_agent; a name-derived window name would feed the tmux rename-window/format
# interpreted-sink (# introduces formats). Zero workers -> no window 1 (valid no-op).
if [[ "$LAYOUT" == "lead-solo" ]] && ((${#WORKER_CMDS[@]} > 0)); then
    tmux rename-window -t "${PANE_IDS[1]}" "workers" 2>/dev/null || true
fi
# lead-pair: window 0 carries the ROLE name (the session name lives in status-left now);
# window 1 exists only with 2+ workers. cmd_rename preserves a role-named window 0.
if [[ "$LAYOUT" == "lead-pair" ]]; then
    tmux rename-window -t "${PANE_IDS[0]}" "leads" 2>/dev/null || true
    if ((${#WORKER_CMDS[@]} > 1)); then
        tmux rename-window -t "${PANE_IDS[2]}" "workers" 2>/dev/null || true
    fi
fi

# Label panes: title for border display, @ae_agent option for reliable identity
tmux select-pane -t "${PANE_IDS[0]}" -T "ae:${MAIN_ALIAS}:${MAIN_NAME}"
tmux set-option -p -t "${PANE_IDS[0]}" @ae_agent "${MAIN_ALIAS}:${MAIN_NAME}"
tmux set-option -p -t "${PANE_IDS[0]}" @ae_slot "main"
for i in "${!WORKER_ALIASES[@]}"; do
    idx=$((i + 1))
    tmux select-pane -t "${PANE_IDS[$idx]}" -T "ae:${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]}"
    tmux set-option -p -t "${PANE_IDS[$idx]}" @ae_agent "${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]}"
    tmux set-option -p -t "${PANE_IDS[$idx]}" @ae_slot "worker.${i}"
done

# --- Generate helper scripts and workspace manifest ---
AE_META="${SESSIONS_DIR}/${SESSION}"
# Ownership as an explicit FACT recorded at the mkdir, never inferred. RESUMING
# was a proxy and a wrong one: a pre-existing half-written directory (an earlier
# attempt that died before writing meta) reads as "fresh", and the rollback would
# then delete a directory this attempt never created.
_AE_SESSION_DIR_CREATED=0
[[ -d "$AE_META" ]] || _AE_SESSION_DIR_CREATED=1
mkdir -p "$AE_META" && chmod 0700 "$AE_META"

# Session metadata (used by ae list/end for stopped sessions, and by spawn helper)
# Always write full meta: on resume, preserve original mode/origin from existing file
META_MODE="$COPY_MODE"
META_ORIGIN="$ORIGIN_DIR"
if [[ "$RESUMING" == true ]]; then
    # read_session_meta checks new path then falls back to legacy path
    META_MODE="$(read_session_meta "$SESSION" mode)"
    META_ORIGIN="$(read_session_meta "$SESSION" origin)"
    META_MODE="${META_MODE:-$COPY_MODE}"
    META_ORIGIN="${META_ORIGIN:-$ORIGIN_DIR}"
fi

MAIN_SESSION_ID="$(resolve_agent_session_id "$MAIN_CMD" "main")"
MAIN_LAUNCH_ID=""
if [[ "$RESUMING" != true ]]; then
    MAIN_TOOL_KIND="$(tool_kind_from_cmd "$MAIN_CMD")"
    if tool_kind_supports_launch_id "$MAIN_TOOL_KIND"; then
        MAIN_LAUNCH_ID="$(gen_uuid)"
    fi
fi

declare -a WORKER_SESSION_IDS=()
declare -a WORKER_LAUNCH_IDS=()
for i in "${!WORKER_CMDS[@]}"; do
    WORKER_SESSION_IDS+=("$(resolve_agent_session_id "${WORKER_CMDS[$i]}" "worker.${i}")")
    WORKER_TOOL_KIND="$(tool_kind_from_cmd "${WORKER_CMDS[$i]}")"
    if [[ "$RESUMING" != true ]] && tool_kind_supports_launch_id "$WORKER_TOOL_KIND"; then
        WORKER_LAUNCH_IDS+=("$(gen_uuid)")
    else
        WORKER_LAUNCH_IDS+=("")
    fi
done

# Load spawned agents from previous session (resume only). SPAWNED_IDX carries
# each entry's ORIGINAL spawned.N index (preserved across gaps — see R2).
declare -a SPAWNED_ALIASES=() SPAWNED_NAMES=() SPAWNED_CMDS=() SPAWNED_SESSION_IDS=() SPAWNED_IDX=() UNRESOLVED_SPAWNED=() UNRESOLVED_IDX=()
if [[ "$RESUMING" == true ]]; then
    # Recover spawned agents from meta, preserving each survivor's original
    # index (a retire leaves a hole; renumbering would break the slot key and
    # orphan any in-flight slotted request addressed to it).
    _resolve_spawned

    # Create panes for spawned agents
    for i in "${!SPAWNED_ALIASES[@]}"; do
        # Spawned agents live in their own windows (matches _cmd_spawn — the
        # main window keeps the lead/worker layout).
        local_id="$(tmux new-window -d -t "${SESSION}:" -c "$WORK_DIR" -P -F '#{pane_id}')"
        tmux rename-window -t "$local_id" "$(_ae_tmux_format_literal "${SPAWNED_NAMES[$i]}")" 2>/dev/null || true
        PANE_IDS+=("$local_id")
        tmux select-pane -t "$local_id" -T "ae:${SPAWNED_ALIASES[$i]}:${SPAWNED_NAMES[$i]}"
        tmux set-option -p -t "$local_id" @ae_agent "${SPAWNED_ALIASES[$i]}:${SPAWNED_NAMES[$i]}"
        tmux set-option -p -t "$local_id" @ae_slot "spawned.${SPAWNED_IDX[$i]}"
    done
    # Rebalance if spawned agents were added — SPLIT layouts only. Spawned agents get
    # their own windows, so window 0 gains no panes; under lead-solo (1 pane, no-op)
    # and lead-pair (lead+colead split -h, which even-vertical would STACK) touching
    # window 0 is wrong. Skip both.
    if ((${#SPAWNED_ALIASES[@]} > 0)) && [[ "$LAYOUT" != "lead-solo" && "$LAYOUT" != "lead-pair" ]]; then
        if [[ "$LAYOUT" == "vertical" ]]; then
            tmux select-layout -t "$SESSION" even-horizontal
        else
            tmux select-layout -t "$SESSION" even-vertical
        fi
    fi
fi

AE_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Preserve per-session watchdog override across rewrite (if any). Reads the
# canonical 'watchdog=' key, falling back to the legacy 'loop=' key so a session
# created before the rename keeps its on/off setting across resume.
PRESERVED_WATCHDOG=""
PRESERVED_SESSION_ID=""
PRESERVED_GOAL=""
PRESERVED_GIT_BASE=""
PRESERVED_ID_ORIGIN=""
PRESERVED_PARENT_ID=""
PRESERVED_PARENT_HANDOVER=""
PRESERVED_PARENT_PENDING=""
if [[ -f "${AE_META}/meta" ]]; then
    PRESERVED_WATCHDOG="$(grep '^watchdog=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    # Canonical-wins: only fall back to the legacy 'loop=' key when 'watchdog=' is
    # absent (matches the runtime read order). A first-line-wins grep would let a
    # 'loop=' that happens to sit above 'watchdog=' override the canonical value.
    [[ -n "$PRESERVED_WATCHDOG" ]] || PRESERVED_WATCHDOG="$(grep '^loop=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_SESSION_ID="$(grep '^session_id=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_GOAL="$(grep '^goal=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    # Launch facts that must survive every meta rewrite. git_base_commit is recorded
    # ONCE, at the fresh launch that created the working tree; a resume that
    # re-derived it would silently re-base the session's commit range on today's HEAD
    # and make the archive's range a lie. The parent-archive triple is the same:
    # lineage is decided once, at birth.
    PRESERVED_GIT_BASE="$(grep '^git_base_commit=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_ID_ORIGIN="$(grep '^session_id_origin=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_PARENT_ID="$(grep '^parent_archive_id=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_PARENT_HANDOVER="$(grep '^parent_archive_handover_count=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_PARENT_PENDING="$(grep '^parent_archive_pending_count=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
fi
# The base commit of a fresh non-local session: the HEAD its working tree was created
# at. Local mode records none — ae manages no branch there, and the human's own HEAD is
# not a session fact. There is no merge-base fallback for legacy sessions: they render
# '-', which is honest, where a guess would not be.
GIT_BASE_COMMIT="$PRESERVED_GIT_BASE"
if [[ -z "$GIT_BASE_COMMIT" && "$RESUMING" != true && "$COPY_MODE" != "local" ]]; then
    _gb_head="$(_ar_git_head "$WORK_DIR")"
    [[ "$_gb_head" == "-" ]] || GIT_BASE_COMMIT="$_gb_head"
fi
# Lineage: taken from --from on a fresh launch, preserved verbatim afterwards.
[[ -n "$PARENT_ARCHIVE_ID" ]] || PARENT_ARCHIVE_ID="$PRESERVED_PARENT_ID"
[[ -n "$PARENT_ARCHIVE_HANDOVER" ]] || PARENT_ARCHIVE_HANDOVER="$PRESERVED_PARENT_HANDOVER"
[[ -n "$PARENT_ARCHIVE_PENDING" ]] || PARENT_ARCHIVE_PENDING="$PRESERVED_PARENT_PENDING"
# A parent that disappeared AFTER this session was born is a warning, never a refusal:
# the lineage fact is still true and the session is still this session. Only a FRESH
# --from demands the archive be there, and its preflight has already proved that.
if [[ -n "$PARENT_ARCHIVE_ID" && ! -f "$(_ar_root)/${PARENT_ARCHIVE_ID}/digest.md" ]]; then
    echo "note: parent archive ${PARENT_ARCHIVE_ID} is no longer on this machine — the lineage is recorded, but its digest cannot be read." >&2
fi
# session_id is a stable UUID for the ae session, separate from the
# human-readable name. Persists across rename + transfer. Used by external
# bridges (chat, webhooks) to bind to a specific session unambiguously
# regardless of name collisions across machines.
SESSION_ID="${PRESERVED_SESSION_ID:-$(gen_uuid)}"

resolve_launch_tmux_server
# Atomic: build the ENTIRE initial meta — identities, roster, launch IDs — in a temp
# file, then ONE mv. A direct `cat > meta` left the file visible EMPTY between open()
# and the write, and post-mv appends left the roster observable half-built; either way
# meta existence was not a readiness fact. rename(2) makes the first observable
# canonical meta the complete one. Stale temp from a crashed launch is cleared first —
# safe, launches serialize on the lifecycle lock.
rm -f "${AE_META}/meta.tmp."*
cat >"${AE_META}/meta.tmp.$$" <<EOF
mode=${META_MODE}
origin=${META_ORIGIN}
session=${SESSION}
session_id=${SESSION_ID}
work_dir=${WORK_DIR}
layout=${LAYOUT:-vertical}
config=${CONFIG_FILE}
main_pane=${PANE_IDS[0]}
ae_path=${AE_PATH}
ae_version=${AE_VERSION}
tmux_server=${_LAUNCH_SRV_VALUE}
tmux_server_kind=${_LAUNCH_SRV_KIND}
agent.main=${MAIN_ALIAS}:${MAIN_NAME}:${MAIN_SESSION_ID}
agent_bin.main=$(extract_binary_from_cmd "$MAIN_CMD")
EOF
# Converge on the canonical 'watchdog' key (value preserved from 'watchdog=' or
# legacy 'loop=' key — see PRESERVED_WATCHDOG above).
[[ -n "$PRESERVED_WATCHDOG" ]] && echo "watchdog=${PRESERVED_WATCHDOG}" >>"${AE_META}/meta.tmp.$$"
# Preserve the session goal (set via the 'goal' helper) across resume.
[[ -n "$PRESERVED_GOAL" ]] && echo "goal=${PRESERVED_GOAL}" >>"${AE_META}/meta.tmp.$$"
# Launch facts for the archive: the base commit this tree started from, and the
# explicit lineage (never inferred from a name — only ever from --from).
[[ -n "$GIT_BASE_COMMIT" ]] && echo "git_base_commit=${GIT_BASE_COMMIT}" >>"${AE_META}/meta.tmp.$$"
# An id ae minted at a previous end attempt stays labelled as minted: a resume rewrites
# the whole meta, and losing this here would let the next end publish an archive claiming
# the session ran under an id it never had.
[[ -n "$PRESERVED_ID_ORIGIN" ]] && echo "session_id_origin=${PRESERVED_ID_ORIGIN}" >>"${AE_META}/meta.tmp.$$"
if [[ -n "$PARENT_ARCHIVE_ID" ]]; then
    {
        echo "parent_archive_id=${PARENT_ARCHIVE_ID}"
        echo "parent_archive_handover_count=${PARENT_ARCHIVE_HANDOVER:-0}"
        echo "parent_archive_pending_count=${PARENT_ARCHIVE_PENDING:-0}"
    } >>"${AE_META}/meta.tmp.$$"
fi
# Config-driven (re-read every start/resume): mark the meta-agent (steward) so its watchdog
# runs the sweep-cadence instead of the stale-nudge watchdog.
case "$META_AGENT_CFG" in
    true | 1 | yes | on) echo "meta_agent=true" >>"${AE_META}/meta.tmp.$$" ;;
esac
for i in "${!WORKER_CMDS[@]}"; do
    echo "agent.worker.${i}=${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]}:${WORKER_SESSION_IDS[$i]}" >>"${AE_META}/meta.tmp.$$"
    echo "agent_bin.worker.${i}=$(extract_binary_from_cmd "${WORKER_CMDS[$i]}")" >>"${AE_META}/meta.tmp.$$"
done
for i in "${!SPAWNED_ALIASES[@]}"; do
    echo "agent.spawned.${SPAWNED_IDX[$i]}=${SPAWNED_ALIASES[$i]}:${SPAWNED_NAMES[$i]}:${SPAWNED_SESSION_IDS[$i]}" >>"${AE_META}/meta.tmp.$$"
    echo "agent_bin.spawned.${SPAWNED_IDX[$i]}=$(extract_binary_from_cmd "${SPAWNED_CMDS[$i]}")" >>"${AE_META}/meta.tmp.$$"
done
# Unresolved spawned entries (alias missing on this machine) survive the
# rewrite verbatim AT THEIR ORIGINAL INDEX — a later resume with the alias
# configured restores the worker (review BLOCKER: they were being warned about
# and then silently deleted right here). Preserving the original index keeps the
# slot key stable and can't collide with a resolved entry (distinct meta keys).
for i in "${!UNRESOLVED_SPAWNED[@]}"; do
    echo "agent.spawned.${UNRESOLVED_IDX[$i]}=${UNRESOLVED_SPAWNED[$i]}" >>"${AE_META}/meta.tmp.$$"
done
[[ -n "$MAIN_LAUNCH_ID" ]] && echo "launch_id.main=${MAIN_LAUNCH_ID}" >>"${AE_META}/meta.tmp.$$"
for i in "${!WORKER_LAUNCH_IDS[@]}"; do
    [[ -n "${WORKER_LAUNCH_IDS[$i]}" ]] && echo "launch_id.worker.${i}=${WORKER_LAUNCH_IDS[$i]}" >>"${AE_META}/meta.tmp.$$"
done
# THE SECOND PARENT PROOF. The first ran before anything was created; this one runs in
# the last moment before the child's meta becomes canonical, because between them the
# archive could have been purged, claimed or corrupted — and a child published with a
# lineage pointer to something that is no longer there is exactly the "fresh --from never
# degrades" case. An expectation carried in by `ae compact` is compared byte-for-byte;
# an ordinary --from launch re-proves the archive without one.
if [[ -n "$PARENT_ARCHIVE_ID" && "$RESUMING" != true ]]; then
    _from_proof_now="$(_ar_from_preflight "$PARENT_ARCHIVE_ID" 2>/dev/null || true)"
    if [[ -z "$_from_proof_now" ]]; then
        rm -f "${AE_META}/meta.tmp.$$"
        echo "Error: parent archive ${PARENT_ARCHIVE_ID} stopped validating while this session was being created." >&2
        _launch_rollback 1
    fi
    if [[ -n "${_AE_FROM_EXPECTED:-}" && "$_from_proof_now" != "${_AE_FROM_EXPECTED}" ]]; then
        rm -f "${AE_META}/meta.tmp.$$"
        echo "Error: parent archive ${PARENT_ARCHIVE_ID} changed while this session was being created." >&2
        echo "  Expected: ${_AE_FROM_EXPECTED//$'\t'/ | }" >&2
        echo "  Now:      ${_from_proof_now//$'\t'/ | }" >&2
        _launch_rollback 1
    fi
fi
mv "${AE_META}/meta.tmp.$$" "${AE_META}/meta"
# The lifecycle lock is NOT released here. The complete initial meta is final at
# this point, but the SESSION is not: sync_session_assets still has ~20 helpers,
# the loop shim and workspace.md to write, and send_agent_cmd writes
# launch.<slot>.sh after that. Releasing here let a concurrent `ae end` rm -rf the
# session directory mid-generation — and because every helper lands via an atomic
# temp+mv, the very next write RECREATED the directory, so `end` returned 0 having
# left a partial session behind (issue #4). Proven by ordering, not inferred: on a
# loaded box end-rm-begin landed 1.7s before the last asset write, and the
# directory came back carrying 22 artifacts. The release now happens once the
# session is fully built; see the note at that site for why it cannot move later.

sync_session_assets() {
    local session_name="$1" meta_dir="$2" work_dir="$3" origin="$4" mode="$5" main_pane="$6" config_file="${7:-$CONFIG_FILE}"
    local previous_config="$CONFIG_FILE" previous_local_config="${AE_LOCAL_CONFIG:-}"
    local ae_path
    ae_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

    if [[ -n "$config_file" ]]; then
        CONFIG_FILE="$config_file"
    fi
    AE_LOCAL_CONFIG=""

    if [[ -f "${meta_dir}/meta" ]]; then
        set_session_meta_value "${meta_dir}/meta" "ae_path" "$ae_path"
        set_session_meta_value "${meta_dir}/meta" "ae_version" "$AE_VERSION"
        # The Rust core binding, pinned per session as a PAIR (path + the
        # version it reported): a helper that finds a binary whose version is
        # not the pinned one refuses it. One rule set for launch and refresh —
        # see _ae_core_bind.
        _ae_core_bind "$meta_dir"
        if [[ -n "$config_file" ]]; then
            set_session_meta_value "${meta_dir}/meta" "config" "$config_file"
        fi
    fi

    local AE_META="$meta_dir"
    local SESSION="$session_name"
    local WORK_DIR="$work_dir"
    local ORIGIN_DIR="$origin"
    local COPY_MODE="$mode"
    local MAIN_PANE="$main_pane"

    # SYNC_SESSION_ASSETS_BODY_START
    # Shebang for every generated helper. NOT `#!/usr/bin/env bash`: that
    # resolves through PATH, and under a macOS LOGIN shell path_helper puts /bin
    # first — /bin/bash is 3.2 and cannot even PARSE the bash-4 bodies
    # `declare -f` emits, so the helper dies with a bare
    # "syntax error near unexpected token `;;'". ae itself is guaranteed >= 4 by
    # the guard at the top of this file, so name that interpreter. Regenerated
    # every launch/refresh, so an upgraded or moved bash self-heals.
    local _ae_sb="#!${BASH:-/usr/bin/env bash}"
    # Remove orphan files from previous ae versions before regenerating helpers.
    # Helpers are unconditionally rewritten below; this list is only for things
    # whose *name* has been removed (renamed/deleted) so their old artifact
    # would otherwise sit forever in $AE_META alongside the new ones.
    # When you rename or drop a helper, add the old name here.
    for _ae_orphan in "done" register-sid shepherd messages.tsv messages.tsv.lock requests.tsv requests.tsv.lock; do
        rm -f "${AE_META:?}/${_ae_orphan}"
    done
    unset _ae_orphan

    # _lib — the shared library sourced by all helpers. Runtime prologue (meta
    # dir, tmux-server shim, session identity) emitted verbatim; the function
    # set emitted from the top-level template library via declare -f — single
    # source, no drifting copies. Atomic: temp + chmod + mv (a mid-write abort
    # must never truncate a live _lib).
    {
        cat <<'LIBPROLOGUE'
# tmux server shim
_AE_META_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_ts="$(grep '^tmux_server=' "$_AE_META_DIR/meta" | cut -d= -f2-)"
_tk="$(grep '^tmux_server_kind=' "$_AE_META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
if [[ "$_tk" == "ambiguous" ]]; then
    tmux() {
        echo "ae: refusing tmux operation — this session's server record is ambiguous; run 'ae doctor --refresh' first." >&2
        return 1
    }
elif [[ "$_tk" == "socket" ]]; then
    tmux() { command tmux -S "$_ts" "$@"; }
elif [[ "$_tk" == "name" ]]; then
    tmux() { command tmux -L "$_ts" "$@"; }
elif [[ "$_ts" == /* ]]; then
    tmux() { command tmux -S "$_ts" "$@"; }
elif [[ -n "$_ts" ]]; then
    tmux() { command tmux -L "$_ts" "$@"; }
fi
_AE_SESSION="$(grep '^session=' "$_AE_META_DIR/meta" | cut -d= -f2-)"
_AE_SESSIONS_DIR="$(dirname "$_AE_META_DIR")"
LIBPROLOGUE
        declare -f ae_resolve ae_lock_target ae_unlock_target ae_now_utc \
            ae_current_pane ae_current_agent ae_current_agent_ref ae_current_slot _valid_slot ae_slot_resolver \
            ae_preview_text ae_extract_req_id ae_log_append ae_log_read \
            ae_target_tool ae_json_escape ae_sanitize_utf8 ae_cap_summary ae_emit_event ae_latest_state_for \
            _event_json_str _agents_alert_reasons _agent_alert_reason ae_make_req_id ae_tracked_send ae_find_request \
            ae_require_body ae_store_message_body ae_provenance_sender \
            ae_submit_pasted_message _capture_input_region _sgr_parse _input_region_prompt_seg _input_region_is_border _input_region_content_end _input_region_occupied _paste_still_staged _paste_input_busy _pane_recently_viewed \
            command_is_shell _agent_bin_for_pane _pane_agent_is_dead _pane_has_descendant_named \
            ae_meta_get ae_meta_set ae_meta_unset \
            _ae_tac _ae_stat _ae_epoch _ae_json_first _ae_md5
    } >"${AE_META}/_lib.tmp.$$"
    chmod 0700 "${AE_META}/_lib.tmp.$$"
    mv "${AE_META}/_lib.tmp.$$" "${AE_META}/_lib"

    # Helper: send <target> <message> — focuses pane, pastes text, submits
    {
        printf '%s\n' "$_ae_sb"
        cat <<'SENDPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
SENDPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_send_body helper_send_finish_event helper_send_main
        printf 'helper_send_main "$@"\n'
    } >"${AE_META}/send.tmp.$$"
    chmod 0700 "${AE_META}/send.tmp.$$"
    mv "${AE_META}/send.tmp.$$" "${AE_META}/send"

    # Helper: _send-deliver <target> <message> — INTERNAL (P2.5a): the send body
    # behind its delivery-only entry, for the Rust core's tracked requests. Same
    # paste, same body store; the recovery file's path on stdout and NO event —
    # the core records the ask/review event itself. Not for agents or humans.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'SENDDELIVERPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
SENDDELIVERPROLOGUE
        declare -f helper_send_body helper_send_deliver_finish helper_send_deliver_main
        printf 'helper_send_deliver_main "$@"\n'
    } >"${AE_META}/_send-deliver.tmp.$$"
    chmod 0700 "${AE_META}/_send-deliver.tmp.$$"
    mv "${AE_META}/_send-deliver.tmp.$$" "${AE_META}/_send-deliver"

    # Helper: ask <target> <question> — structured send with reply-to metadata
    {
        printf '%s\n' "$_ae_sb"
        cat <<'ASKPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
ASKPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_ask_main
        printf 'helper_ask_main "$@"\n'
    } >"${AE_META}/ask.tmp.$$"
    chmod 0700 "${AE_META}/ask.tmp.$$"
    mv "${AE_META}/ask.tmp.$$" "${AE_META}/ask"

    # Helper: review <target> <request> — ask for a critical review with structured findings
    {
        printf '%s\n' "$_ae_sb"
        cat <<'REVIEWPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
REVIEWPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_review_main
        printf 'helper_review_main "$@"\n'
    } >"${AE_META}/review.tmp.$$"
    chmod 0700 "${AE_META}/review.tmp.$$"
    mv "${AE_META}/review.tmp.$$" "${AE_META}/review"

    # Helper: reply <request-id> <message> — reply to a logged request by id
    {
        printf '%s\n' "$_ae_sb"
        cat <<'REPLYPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
REPLYPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_reply_main
        printf 'helper_reply_main "$@"\n'
    } >"${AE_META}/reply.tmp.$$"
    chmod 0700 "${AE_META}/reply.tmp.$$"
    mv "${AE_META}/reply.tmp.$$" "${AE_META}/reply"

    # Helper: requests [mine|inbox|all] — inspect request state from session logs
    {
        printf '%s\n' "$_ae_sb"
        cat <<'REQUESTSPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
REQUESTSPROLOGUE
        declare -f _ae_core_complain _ae_core_try _ar_request_states helper_requests_main
        printf 'helper_requests_main "$@"\n'
    } >"${AE_META}/requests.tmp.$$"
    chmod 0700 "${AE_META}/requests.tmp.$$"
    mv "${AE_META}/requests.tmp.$$" "${AE_META}/requests"

    # Helper: state <working|waiting-user|blocked|done> [reason] — declare current work state.
    # mark-done is a shim that calls 'state done' so older docs/agents keep working.
    # The 'done' branch dual-emits a legacy 'done' event so that a watchdog
    # process started before the state helper existed (and only understands
    # action=done) keeps recognising completions after helpers are refreshed.
    # The current watchdog reads 'state done' directly; the dual-emit is retained
    # until 'ae doctor --refresh' can restart a running watchdog, then it can go.
    #
    # Template functions live in the top-level template library (defined
    # before the dispatcher); this site only emits them via `declare -f`.

    # Atomic emission: write to a temp file and mv into place only after every
    # printf/declare -f succeeded. doctor --refresh maintains LIVE sessions — a
    # generator bug (missing/renamed template fn) aborting mid-write under
    # set -e must never leave a truncated helper behind.
    {
        printf '%s\n' "$_ae_sb"
        # shellcheck disable=SC2016  # literal $(...) belongs to the generated file
        printf 'source "$(cd "$(dirname "$0")" && pwd)/_lib"\n'
        declare -f _ae_core_complain _ae_core_try helper_state_usage helper_state_main
        printf 'helper_state_main "$@"\n'
    } >"${AE_META}/state.tmp.$$"
    chmod 0700 "${AE_META}/state.tmp.$$"
    mv "${AE_META}/state.tmp.$$" "${AE_META}/state"

    # Helper: mark-done [message] — shim over `state done`. Preserved so existing
    # agent muscle memory and workspace.md guidance keep working unchanged.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'DONEEOF'
# Preserve the pre-state-helper default: `mark-done` with no args writes an
# event whose summary is the literal string "done".
exec "$(dirname "$0")/state" done "${@:-done}"
DONEEOF
    } >"${AE_META}/mark-done.tmp.$$"
    chmod 0700 "${AE_META}/mark-done.tmp.$$"
    mv "${AE_META}/mark-done.tmp.$$" "${AE_META}/mark-done"

    # Helper: say <text> — push a free-text line to the Telegram bridge (if the
    # machine-global daemon is running and its include filter contains `chat`).
    # Emits a `chat` event; the daemon forwards it with the standard
    # "[session] chat  actor" header, so a phone reply routes straight back to
    # this agent. Text comes from args or piped stdin (for multi-line / long
    # replies). This is the agent's deliberate way to answer the human on
    # Telegram — there is no automatic forwarding of pane output.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'SAYPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"

SAYPROLOGUE
        declare -f helper_say_usage helper_say_main
        printf 'helper_say_main "$@"\n'
    } >"${AE_META}/say.tmp.$$"
    chmod 0700 "${AE_META}/say.tmp.$$"
    mv "${AE_META}/say.tmp.$$" "${AE_META}/say"

    # Helper: memo add/read/tail — shared append-only session memory
    {
        printf '%s\n' "$_ae_sb"
        cat <<'MEMOPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
MEMOPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_memo_usage helper_memo_render helper_memo_main
        printf 'helper_memo_main "$@"\n'
    } >"${AE_META}/memo.tmp.$$"
    chmod 0700 "${AE_META}/memo.tmp.$$"
    mv "${AE_META}/memo.tmp.$$" "${AE_META}/memo"

    # Helper: goal [text|--clear] — the session's one-line objective. Stored as
    # 'goal=' in session meta (locked write, survives resume via the preserve
    # block), shown in 'ae list' (table sub-line + JSON), and quoted by the
    # watchdog's stale nudge so idle agents are reminded what the session is FOR.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'GOALPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"

GOALPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_goal_usage helper_goal_main
        printf 'helper_goal_main "$@"\n'
    } >"${AE_META}/goal.tmp.$$"
    chmod 0700 "${AE_META}/goal.tmp.$$"
    mv "${AE_META}/goal.tmp.$$" "${AE_META}/goal"

    # Helper: peek <target> [lines] — capture recent output from another agent's pane
    {
        printf '%s\n' "$_ae_sb"
        cat <<'PEEKPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
PEEKPROLOGUE
        declare -f helper_peek_main
        printf 'helper_peek_main "$@"\n'
    } >"${AE_META}/peek.tmp.$$"
    chmod 0700 "${AE_META}/peek.tmp.$$"
    mv "${AE_META}/peek.tmp.$$" "${AE_META}/peek"

    # Common typo alias: peak -> peek
    {
        printf '%s\n' "$_ae_sb"
        cat <<'PEAKOF'
exec "$(cd "$(dirname "$0")" && pwd)/peek" "$@"
PEAKOF
    } >"${AE_META}/peak.tmp.$$"
    chmod 0700 "${AE_META}/peak.tmp.$$"
    mv "${AE_META}/peak.tmp.$$" "${AE_META}/peak"

    # Helper: agents — list all agents in the session
    {
        printf '%s\n' "$_ae_sb"
        cat <<'AGENTSPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"

AGENTSPROLOGUE
        declare -f helper_agents_main
        printf 'helper_agents_main "$@"\n'
    } >"${AE_META}/agents.tmp.$$"
    chmod 0700 "${AE_META}/agents.tmp.$$"
    mv "${AE_META}/agents.tmp.$$" "${AE_META}/agents"

    # Helper: focus <target> — switch to another agent's pane by name
    {
        printf '%s\n' "$_ae_sb"
        cat <<'FOCUSPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
FOCUSPROLOGUE
        declare -f helper_focus_main
        printf 'helper_focus_main "$@"\n'
    } >"${AE_META}/focus.tmp.$$"
    chmod 0700 "${AE_META}/focus.tmp.$$"
    mv "${AE_META}/focus.tmp.$$" "${AE_META}/focus"

    # Helper: interrupt <target> [message] — cancel current generation, optionally redirect
    {
        printf '%s\n' "$_ae_sb"
        cat <<'INTERRUPTPROLOGUE'
source "$(cd "$(dirname "$0")" && pwd)/_lib"
INTERRUPTPROLOGUE
        declare -f helper_interrupt_main
        printf 'helper_interrupt_main "$@"\n'
    } >"${AE_META}/interrupt.tmp.$$"
    chmod 0700 "${AE_META}/interrupt.tmp.$$"
    mv "${AE_META}/interrupt.tmp.$$" "${AE_META}/interrupt"

    # Helper: spawn <alias> [prompt] — thin wrapper that calls ae _spawn
    {
        printf '%s\n' "$_ae_sb"
        cat <<'SPAWNPROLOGUE'
set -euo pipefail
SPAWNPROLOGUE
        declare -f helper_spawn_main
        printf 'helper_spawn_main "$@"\n'
    } >"${AE_META}/spawn.tmp.$$"
    chmod 0700 "${AE_META}/spawn.tmp.$$"
    mv "${AE_META}/spawn.tmp.$$" "${AE_META}/spawn"

    # Helper: retire <agent> — remove a spawned agent from the session
    {
        printf '%s\n' "$_ae_sb"
        cat <<'RETIREPROLOGUE'
set -euo pipefail
RETIREPROLOGUE
        declare -f helper_retire_main
        printf 'helper_retire_main "$@"\n'
    } >"${AE_META}/retire.tmp.$$"
    chmod 0700 "${AE_META}/retire.tmp.$$"
    mv "${AE_META}/retire.tmp.$$" "${AE_META}/retire"

    # Helper: _register-sid — internal; codex agents run this once on launch to
    # self-register their session ID so ae can resume the exact conversation later.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'REGISTER_SIDPROLOGUE'
# Find codex session matching current launch marker or CWD and write its UUID to codex.<slot>.sid
REGISTER_SIDPROLOGUE
        # _register-sid does NOT source _lib (it runs before the session is
        # fully wired), so the shims it calls must be emitted alongside it:
        # _ae_stat and _ae_json_first for the scan, _ae_yesterday for the
        # pre-midnight partition.
        declare -f _ae_stat _ae_json_first _ae_yesterday helper_register_sid_main
        printf 'helper_register_sid_main "$@"\n'
    } >"${AE_META}/_register-sid.tmp.$$"
    chmod 0700 "${AE_META}/_register-sid.tmp.$$"
    mv "${AE_META}/_register-sid.tmp.$$" "${AE_META}/_register-sid"

    # Helper: events-tail — read-only formatted tail of events.jsonl for the monitor pane
    {
        printf '%s\n' "$_ae_sb"
        cat <<'EVENTS_TAILPROLOGUE'
set -uo pipefail
EVENTS_TAILPROLOGUE
        declare -f _ae_core_complain _ae_core_try helper_events_tail_extract_json_str helper_events_tail_format_event helper_events_tail_main
        printf 'helper_events_tail_main "$@"\n'
    } >"${AE_META}/events-tail.tmp.$$"
    chmod 0700 "${AE_META}/events-tail.tmp.$$"
    mv "${AE_META}/events-tail.tmp.$$" "${AE_META}/events-tail"

    # Helper: watchdog [start|stop|status] — watchdog that nudges stale agents
    # watchdog — emitted from the template library (fns + the whole runtime
    # flow wrapped as helper_watchdog_main). Atomic: temp + chmod + mv. NOTE:
    # a RUNNING watchdog keeps its loaded body until stop/start — refresh
    # only replaces the on-disk script.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'WDPROLOGUE'
set -uo pipefail
source "$(cd "$(dirname "$0")" && pwd)/_lib"
WDPROLOGUE
        declare -f _watchdog_is_running _set_meta_kv _unset_meta_kv _set_meta_watchdog \
            _monitor_find_pane _monitor_ensure_events_pane _watchdog_ensure_monitor _watchdog_reap_legacy_one \
            _watchdog_reap_legacy _watchdog_stop _watchdog_status \
            _watchdog_start _last_event_age _latest_relevant_event _agent_quiet_reason \
            _quiet_pane_decision _watchdog_capture_pane _quiet_stabilize _quiet_stabilize_allowed _quiet_cursor_advance \
            _quiet_cycle_begin _quiet_cycle_step _quiet_cycle_end \
            _nudge_should_attempt _nudge_delivery_verdict \
            _watchdog_quiet_hash _watchdog_meta_value _watchdog_trim _watchdog_git \
            _watchdog_branch_segment _watchdog_set_status _watchdog_clear_bar_options _watchdog_log _pane_has_descendant_named \
            _watchdog_exit_cleanup _roster_session_id _ae_session_id _watchdog_session_id _roster_glyph _roster_label _roster_compose _roster_slot_refs _roster_window_compose \
            _buf_shows_throttle _pane_shows_throttle _load_agent_bins helper_watchdog_main
        printf 'helper_watchdog_main "$@"\n'
    } >"${AE_META}/watchdog.tmp.$$"
    chmod 0700 "${AE_META}/watchdog.tmp.$$"
    mv "${AE_META}/watchdog.tmp.$$" "${AE_META}/watchdog"

    # Deprecated 'loop' helper: thin wrapper that forwards to 'watchdog'. Keeps the
    # old direct path (~/.ae/sessions/<name>/loop start|stop|status) working for
    # muscle memory, old docs, and shell history. Regenerated every sync, so it is
    # not an orphan. Remove once the legacy name is fully retired.
    {
        printf '%s\n' "$_ae_sb"
        cat <<'LOOPSHIMEOF'
# Deprecated alias for the 'watchdog' helper (feature renamed loop -> watchdog).
exec "$(cd "$(dirname "$0")" && pwd)/watchdog" "$@"
LOOPSHIMEOF
    } >"${AE_META}/loop.tmp.$$"
    chmod 0700 "${AE_META}/loop.tmp.$$"
    mv "${AE_META}/loop.tmp.$$" "${AE_META}/loop"

    # Generate initial workspace.md from live pane state
    regenerate_manifest "$SESSION" "$WORK_DIR" "$ORIGIN_DIR" "$COPY_MODE" "$MAIN_PANE" "$AE_META"

    # I1: stamp @ae_slot onto any running pane still missing it (sessions from
    # before slot-keyed identity landed). Runs at launch (no-op, panes already
    # stamped) AND at doctor --refresh (the live transition). Inside the marker
    # region so the refresh awk-source runs it; _stamp_live_slots is column-0.
    _stamp_live_slots "$SESSION" "${AE_META}/meta"
    # SYNC_SESSION_ASSETS_BODY_END

    CONFIG_FILE="$previous_config"
    AE_LOCAL_CONFIG="$previous_local_config"
}

sync_session_assets "$SESSION" "$AE_META" "$WORK_DIR" "$META_ORIGIN" "$META_MODE" "${PANE_IDS[0]}" "$CONFIG_FILE"

# --- Launch agents ---
# Freshly created panes can still be inside shell init when tmux returns.
# Give them the same settle time as spawn before injecting launch commands.
sleep 0.3

# Resume-only events.jsonl retention: the event log is append-only, so a
# long-lived session accumulates history across every resume. Cap it to the
# newest AE_EVENTS_KEEP lines (default 1000; numeric-guarded like _request_secs).
# Trim atomically (tail -n N > tmp && mv) and strictly non-fatally — a failed
# trim must never break a resume. Runs BEFORE the resume commands are sent
# (agents aren't running yet) and under events.jsonl.lock — the same lock every
# event writer holds — so a concurrent append (telegram/human/helper) can never
# land between the tail read and the mv and be lost (review finding). Also
# precedes the _events pane start (inode swap beats tail -f).
if [[ "$RESUMING" == true ]]; then
    _events_keep="${AE_EVENTS_KEEP:-1000}"
    [[ "$_events_keep" =~ ^[0-9]+$ && "$_events_keep" -gt 0 ]] || _events_keep=1000
    _events_file="${AE_META}/events.jsonl"
    if [[ -f "$_events_file" ]]; then
        (
            flock -w 5 9 || exit 0
            # BSD wc pads with leading spaces; strip so the numeric guard below
            # accepts it (otherwise the count reads as junk and the trim is skipped).
            _events_lines="$(wc -l <"$_events_file" 2>/dev/null || echo 0)"
            _events_lines="${_events_lines//[^0-9]/}"
            [[ "$_events_lines" =~ ^[0-9]+$ ]] || _events_lines=0
            if ((_events_lines > _events_keep)); then
                _events_tmp="${AE_META}/events.jsonl.trim.$$"
                if tail -n "$_events_keep" "$_events_file" >"$_events_tmp" 2>/dev/null && mv "$_events_tmp" "$_events_file" 2>/dev/null; then
                    echo "Trimmed events.jsonl to newest ${_events_keep} lines (was ${_events_lines})."
                else
                    rm -f "$_events_tmp" 2>/dev/null || true
                fi
            fi
        ) 9>>"${_events_file}.lock" 2>/dev/null || true
    fi
fi

# Roll back a launch whose agent could not be started. By this point the tmux
# session, its panes, the meta file and every helper already exist — exiting
# without teardown leaves debris that the NEXT `ae <name>` reads as a healthy
# session: the existing-session fast path attaches to it, and nothing ever
# regenerates the launch script that failed to write.
#
# Runs with the LIFECYCLE LOCK STILL HELD — fd 8 is closed further down, so a
# concurrent `ae end` cannot interleave with this teardown (c1fd622's rule; the
# lock is released by process exit at the end of this function).
#
# POLICY, keyed on OWNERSHIP — did THIS attempt create the directory:
#   CREATED HERE — kill the tmux session AND delete it. It holds nothing worth
#            keeping, and leaving it behind reclassifies the next attempt as a
#            resume of debris.
#   PRE-EXISTING — kill the tmux session, KEEP the directory. It is either a
#            resume (that conversation history is the user's) or the remains of
#            an earlier attempt; either way this attempt did not make it and does
#            not get to destroy it.
# _AE_SESSION_DIR_CREATED is set at the mkdir, not derived from $RESUMING: a
# half-written directory with no meta reads as a fresh launch, and the old proxy
# would have deleted it.
#
# THREE INDEPENDENT GUARDS stand between a publication failure and an rm -rf,
# because the consequence of getting this wrong is unbounded: the name was
# validated at launch entry (no '/', no '..'), the path must still test as a
# direct child of the sessions root here, and the ownership flag must say this
# attempt created it. Any one of them failing means nothing is deleted.
#
# Working directories (worktree/copy) are deliberately untouched: tearing one
# down is `ae end`'s job, which commits and pushes first, and under --local the
# work dir is the user's own checkout.
#
# Never masks the original status — every step tolerates failure, and the exit
# code is the one that came in.

# Every launch-path send goes through here: a bare `send_agent_cmd` would exit
# on failure with the session half-built (the loud abort the previous round
# introduced is only correct if it takes its debris with it).
_send_or_rollback() {
    local _rc=0
    send_agent_cmd "$@" || _rc=$?
    if ((_rc != 0)); then
        _launch_rollback "$_rc"
    fi
    return 0
}

if [[ "$RESUMING" == true ]]; then
    # Resume: use session-scoped resume commands (exact conversation, not CWD heuristic)
    MAIN_RESUME="$(resume_cmd_from_cmd "$MAIN_CMD" "$MAIN_SESSION_ID")"
    # The injection boundary, captured where it is KNOWN rather than searched for later.
    MAIN_RESUME_PRE="$MAIN_RESUME"
    MAIN_RESUME="$(inject_ae_context "$MAIN_RESUME" "$AE_META" "$SESSION" "$WORK_DIR" "main")"
    _send_or_rollback "${PANE_IDS[0]}" "$MAIN_RESUME" "$(initial_prompt_for_cmd "$MAIN_CMD" "$AE_META" "$SESSION" "$WORK_DIR" "main")" "$AE_META" "main" "$MAIN_SESSION_ID" "$MAIN_RESUME_PRE"
    for i in "${!WORKER_CMDS[@]}"; do
        idx=$((i + 1))
        WORKER_RESUME="$(resume_cmd_from_cmd "${WORKER_CMDS[$i]}" "${WORKER_SESSION_IDS[$i]:-}")"
        WORKER_RESUME_PRE="$WORKER_RESUME"
        WORKER_RESUME="$(inject_ae_context "$WORKER_RESUME" "$AE_META" "$SESSION" "$WORK_DIR" "worker.${i}")"
        _send_or_rollback "${PANE_IDS[$idx]}" "$WORKER_RESUME" "$(initial_prompt_for_cmd "${WORKER_CMDS[$i]}" "$AE_META" "$SESSION" "$WORK_DIR" "worker.${i}")" "$AE_META" "worker.${i}" "${WORKER_SESSION_IDS[$i]:-}" "$WORKER_RESUME_PRE"
    done
    # Resume spawned agents. The PANE_IDS position is array-order (sidx); the
    # slot string carries the PRESERVED original index (SPAWNED_IDX) so context
    # injection + sid registration key on the stable slot (R2).
    for i in "${!SPAWNED_CMDS[@]}"; do
        sidx=$((${#WORKER_CMDS[@]} + i + 1))
        _sp_slot="spawned.${SPAWNED_IDX[$i]}"
        SPAWNED_RESUME="$(resume_cmd_from_cmd "${SPAWNED_CMDS[$i]}" "${SPAWNED_SESSION_IDS[$i]:-}")"
        SPAWNED_RESUME_PRE="$SPAWNED_RESUME"
        SPAWNED_RESUME="$(inject_ae_context "$SPAWNED_RESUME" "$AE_META" "$SESSION" "$WORK_DIR" "$_sp_slot")"
        _send_or_rollback "${PANE_IDS[$sidx]}" "$SPAWNED_RESUME" "$(initial_prompt_for_cmd "${SPAWNED_CMDS[$i]}" "$AE_META" "$SESSION" "$WORK_DIR" "$_sp_slot")" "$AE_META" "$_sp_slot" "${SPAWNED_SESSION_IDS[$i]:-}" "$SPAWNED_RESUME_PRE"
    done
else
    # Fresh start with session-scoped IDs (enables targeted resume later)
    SCOPED_MAIN="$(inject_session_id "$MAIN_CMD" "$MAIN_SESSION_ID")"
    # The injection boundary, captured where it is known. A FRESH launch needs it as
    # much as a resume does: launch.<slot>.sh's re-run form is built from it.
    SCOPED_MAIN_PRE="$SCOPED_MAIN"
    SCOPED_MAIN="$(inject_ae_context "$SCOPED_MAIN" "$AE_META" "$SESSION" "$WORK_DIR" "main")"
    _send_or_rollback "${PANE_IDS[0]}" "$SCOPED_MAIN" "$(initial_prompt_for_cmd "$MAIN_CMD" "$AE_META" "$SESSION" "$WORK_DIR" "main")" "$AE_META" "main" "$MAIN_SESSION_ID" "$SCOPED_MAIN_PRE"
    for i in "${!WORKER_CMDS[@]}"; do
        idx=$((i + 1))
        SCOPED_WORKER="$(inject_session_id "${WORKER_CMDS[$i]}" "${WORKER_SESSION_IDS[$i]:-}")"
        SCOPED_WORKER_PRE="$SCOPED_WORKER"
        SCOPED_WORKER="$(inject_ae_context "$SCOPED_WORKER" "$AE_META" "$SESSION" "$WORK_DIR" "worker.${i}")"
        _send_or_rollback "${PANE_IDS[$idx]}" "$SCOPED_WORKER" "$(initial_prompt_for_cmd "${WORKER_CMDS[$i]}" "$AE_META" "$SESSION" "$WORK_DIR" "worker.${i}")" "$AE_META" "worker.${i}" "${WORKER_SESSION_IDS[$i]:-}" "$SCOPED_WORKER_PRE"
    done
fi

# Release the lifecycle lock — the session is now fully on disk (meta, helpers,
# workspace.md, launch scripts) and `ae end` may safely delete it.
#
# This point is bounded on BOTH sides and cannot move:
#   - not EARLIER, or `end` deletes the directory while generation is still
#     writing into it and the next atomic mv recreates it (issue #4);
#   - not LATER, because the SID-capture children below are spawned with `&` and
#     would INHERIT this fd, holding the lock until capture finished — which made
#     an immediate `ae end` falsely time out (12th review I1).
# `end` waits up to 15s for this lock; a full launch is well inside that.
exec 8>&-

# Capture agent session IDs in background (runs after launch, doesn't delay attach).
# On fresh start: always capture. On resume: re-capture only for slots whose session ID
# is still "pending" (codex/gemini/opencode capture is post-launch and may have failed
# the previous attempt — without re-capture they would stay pending forever).
if [[ "$RESUMING" != true ]]; then
    MAIN_TOOL="$(tool_kind_from_cmd "$MAIN_CMD")"
    start_capture_session_id "$MAIN_TOOL" "${PANE_IDS[0]}" "main" "$AE_META"
    for i in "${!WORKER_CMDS[@]}"; do
        WORKER_TOOL="$(tool_kind_from_cmd "${WORKER_CMDS[$i]}")"
        start_capture_session_id "$WORKER_TOOL" "${PANE_IDS[$((i + 1))]}" "worker.${i}" "$AE_META"
    done
else
    if [[ "$MAIN_SESSION_ID" == "pending" ]]; then
        MAIN_TOOL="$(tool_kind_from_cmd "$MAIN_CMD")"
        start_capture_session_id "$MAIN_TOOL" "${PANE_IDS[0]}" "main" "$AE_META"
    fi
    for i in "${!WORKER_CMDS[@]}"; do
        if [[ "${WORKER_SESSION_IDS[$i]:-}" == "pending" ]]; then
            WORKER_TOOL="$(tool_kind_from_cmd "${WORKER_CMDS[$i]}")"
            start_capture_session_id "$WORKER_TOOL" "${PANE_IDS[$((i + 1))]}" "worker.${i}" "$AE_META"
        fi
    done
fi

# Ensure the ae-monitor window with the _events pane exists on every start
# and resume — the event stream is always available via peek _events even
# when the watchdog is off.
"${AE_META}/watchdog" _ensure-monitor 2>/dev/null || true

# Start the watchdog unless explicitly disabled. Precedence: per-session meta
# override > workspace.watchdog config > default (on). Only explicit false/no/off/0
# keeps the watchdog off — unset/empty means default-on. The canonical meta key is
# 'watchdog' (falling back to legacy 'loop'); same for the config key.
WATCHDOG_META="$(read_session_meta "$SESSION" watchdog)"
[[ -n "$WATCHDOG_META" ]] || WATCHDOG_META="$(read_session_meta "$SESSION" loop)"
if [[ -n "$WATCHDOG_META" ]]; then
    WATCHDOG_ENABLED="$WATCHDOG_META"
else
    WATCHDOG_ENABLED="$(get_config workspace.watchdog)"
    [[ -n "$WATCHDOG_ENABLED" ]] || WATCHDOG_ENABLED="$(get_config workspace.loop)"
fi
# Exactly one watchdog per session (plan p3: no double-run): AE_WATCHDOG_IMPL=uv
# picks the aewatch daemon (bash stands down), else the bash per-session watchdog;
# disabled starts neither.
_start_session_watchdog "$WATCHDOG_ENABLED"

# Optional: auto-start the Telegram bridge if [telegram] enabled = true.
# Strictly non-fatal: any error here must not affect session attach.
_telegram_autostart_if_enabled 2>/dev/null || true

# Companion: the steward rides along with any fleet launch (opt-in by an
# existing scaffold — see _steward_autostart_if_scaffolded). Same non-fatal
# contract as the bridge above.
_steward_autostart_if_scaffolded 2>/dev/null || true

# Focus main pane and attach
tmux select-pane -t "${PANE_IDS[0]}"
if [[ "$ATTACH_ON_READY" != "true" ]]; then
    echo "Session '$SESSION' started. Use 'ae steward --attach' to view."
    exit 0
fi
tmux_attach "$SESSION"
