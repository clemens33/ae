# Find an opencode session ID by matching directory in `opencode session list --format json`.
# Only considers sessions updated after $launch_time (epoch seconds).
# Returns the session ID of the newest matching session, or empty string.
find_opencode_session_by_cwd() {
    local target_cwd="$1" launch_time="${2:-0}"
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    if ! command -v opencode &>/dev/null; then
        return
    fi
    local json
    json="$(opencode session list --format json -n 20 2>/dev/null || true)"
    [[ -z "$json" ]] && return
    # opencode timestamps are in milliseconds
    local launch_time_ms=$((launch_time * 1000))
    local best_id="" best_updated=0
    # Compact JSON to single-line-per-object, then parse with grep
    local compact
    compact="$(echo "$json" | tr -d '\n' | sed 's/}\s*,\s*{/}\n{/g')"
    local sid dir updated
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        sid="$(echo "$entry" | grep -oP '"id"\s*:\s*"\K[^"]+' 2>/dev/null || true)"
        [[ -z "$sid" ]] && continue
        dir="$(echo "$entry" | grep -oP '"directory"\s*:\s*"\K[^"]+' 2>/dev/null || true)"
        [[ -z "$dir" ]] && continue
        updated="$(echo "$entry" | grep -oP '"updated"\s*:\s*\K[0-9]+' 2>/dev/null || true)"
        [[ -z "$updated" ]] && continue
        ((updated < launch_time_ms)) && continue
        dir="$(realpath "$dir" 2>/dev/null || echo "$dir")"
        [[ "$dir" != "$target_cwd" ]] && continue
        if ((updated > best_updated)); then
            best_id="$sid"
            best_updated="$updated"
        fi
    done <<<"$compact"
    echo "$best_id"
}

# Best-effort: capture OpenCode session ID post-launch.
# Fallback chain: A) launch-token DB scan, B) CWD-based session list scan.
capture_opencode_session_id() {
    local pane="$1" slot="$2" meta_dir="$3"
    local captured=""
    local work_dir launch_time launch_id
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    # Poll: opencode needs time to create the session
    local _attempt
    for _attempt in 1 2 3 4 5 6; do
        sleep 5
        if [[ -n "$launch_id" ]]; then
            captured="$(find_opencode_session_by_launch_id "$launch_id" "$launch_time")"
        fi
        if [[ -z "$captured" && -n "$work_dir" ]]; then
            captured="$(find_opencode_session_by_cwd "$work_dir" "$launch_time")"
        fi
        [[ -n "$captured" ]] && break
    done
    if [[ -n "$captured" ]]; then
        (
            flock -w 5 200 || exit 1
            local escaped_slot="${slot//./\\.}"
            sed -i "s/^agent\.${escaped_slot}=\([^:]*:[^:]*:\).*/agent.${slot}=\1${captured}/" "$meta_dir/meta"
        ) 200>"$meta_dir/meta.lock"
    fi
}

# Best-effort: capture Gemini session ID post-launch.
# Fallback chain: A) launch-token local chat scan, B) CWD-based local chat scan.
capture_gemini_session_id() {
    local pane="$1" slot="$2" meta_dir="$3"
    local captured=""
    local work_dir launch_time launch_id
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    local _attempt
    for _attempt in 1 2 3 4 5 6; do
        sleep 5
        if [[ -n "$work_dir" && -n "$launch_id" ]]; then
            captured="$(find_gemini_session_by_launch_id "$work_dir" "$launch_id" "$launch_time")"
        fi
        if [[ -z "$captured" && -n "$work_dir" ]]; then
            captured="$(find_gemini_session_by_cwd "$work_dir" "$launch_time")"
        fi
        [[ -n "$captured" ]] && break
    done
    if [[ -n "$captured" ]]; then
        (
            flock -w 5 200 || exit 1
            local escaped_slot="${slot//./\\.}"
            sed -i "s/^agent\.${escaped_slot}=\([^:]*:[^:]*:\).*/agent.${slot}=\1${captured}/" "$meta_dir/meta"
        ) 200>"$meta_dir/meta.lock"
    fi
}

capture_session_id() {
    local tool_kind="$1" pane="$2" slot="$3" meta_dir="$4"
    case "$tool_kind" in
        codex) capture_codex_session_id "$pane" "$slot" "$meta_dir" ;;
        opencode) capture_opencode_session_id "$pane" "$slot" "$meta_dir" ;;
        gemini) capture_gemini_session_id "$pane" "$slot" "$meta_dir" ;;
        *) return 0 ;;
    esac
}

start_capture_session_id() {
    local tool_kind="$1" pane="$2" slot="$3" meta_dir="$4"
    tool_kind_supports_launch_id "$tool_kind" || return 0
    (
        flock -w 5 200 || exit 1
        echo "launch_time.${slot}=$(date +%s)" >>"$meta_dir/meta"
    ) 200>"$meta_dir/meta.lock"
    capture_session_id "$tool_kind" "$pane" "$slot" "$meta_dir" &
}

# Generate or restore a session-scoped agent ID
# Uses globals $RESUMING and $SESSION when available (main launch path)
# For _cmd_spawn: RESUMING is unset → always generates new IDs
resolve_agent_session_id() {
    local cmd="$1" slot="$2"
    local session_id=""
    if [[ "${RESUMING:-}" == true ]] && [[ -n "${SESSION:-}" ]]; then
        local stored
        stored="$(read_session_meta "$SESSION" "agent.${slot}")"
        if [[ -n "$stored" ]]; then
            # Format: alias:name:session_id
            local stored_id="${stored##*:}"
            if [[ "$stored_id" != "pending" && -n "$stored_id" ]]; then
                session_id="$stored_id"
            fi
        fi
    fi
    if [[ -z "$session_id" ]]; then
        case "$cmd" in
            # claude and grok both accept an ae-generated --session-id at launch, so their
            # UUID is known upfront — resume is exact from the first cycle with no
            # post-launch capture (neither appears in tool_kind_supports_launch_id).
            claude* | grok*) session_id="$(gen_uuid)" ;;
            *) session_id="pending" ;;
        esac
    fi
    echo "$session_id"
}

# Derive default session name from PWD
default_session_name() {
    local dir="${PWD/#$HOME\//}"
    local hash
    hash="$(printf '%s' "$PWD" | md5sum | cut -c1-6)"
    dir="${dir//\//-}"
    dir="${dir//./_}"
    echo "ae-${dir}-${hash}"
}

# Attach or switch to a tmux session (handles being inside tmux already)
tmux_attach() {
    local target="$1"
    if [[ -n "${TMUX:-}" ]]; then
        exec tmux switch-client -t "$target"
    else
        exec tmux attach-session -t "$target"
    fi
}

# Read a session's metadata file (mode, origin)
read_session_meta() {
    local session_name="$1" key="$2"
    local meta="${SESSIONS_DIR}/${session_name}/meta"
    # Backward compat: try old worktree-nested path
    if [[ ! -f "$meta" ]]; then
        meta="${WORKTREES_DIR}/${session_name}/.ae/${session_name}/meta"
    fi
    if [[ -f "$meta" ]]; then
        while IFS='=' read -r k v; do
            if [[ "$k" == "$key" ]]; then
                printf '%s' "$v"
                return
            fi
        done <"$meta"
    fi
}

# Locked single-key meta write. Serializes on the same ${meta_file}.lock that the
# generated helpers' ae_meta_set and the watchdog's meta writer use — without it, a
# refresh could read old meta and mv it back OVER a concurrent helper write (e.g. an
# agent setting the session goal mid-refresh), silently dropping that update. The
# temp lives next to the meta file (same filesystem → atomic mv) and the read-modify-
# write happens entirely inside the lock.
set_session_meta_value() {
    local meta_file="$1" key="$2" value="$3"
    {
        flock -w 5 200 || return 1
        local tmp="${meta_file}.tmp.$$"
        awk -F= -v key="$key" -v value="$value" '
            BEGIN { updated = 0 }
            $1 == key { print key "=" value; updated = 1; next }
            { print }
            END {
                if (!updated) {
                    print key "=" value
                }
            }
        ' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${meta_file}.lock"
}

# Resolve the session's workers into WORKER_ALIASES/WORKER_NAMES/WORKER_CMDS. On RESUME
# (agent.worker.0 present in meta) recover them from meta — names PRESERVED; config
# workspace.workers deltas apply to NEW sessions ONLY (symmetric with the main-agent
# meta-preservation at the launch flow — a config worker rename must NOT re-identify a
# running worker, the doctor-refresh churn leg). On a FRESH launch, parse config workers=
# and dedup colliding names.
_resolve_workers() {
    WORKER_CMDS=()
    WORKER_ALIASES=()
    WORKER_NAMES=()
    # Resume: the session META EXISTS -> meta is authoritative INCLUDING EMPTINESS.
    # Keying on agent.worker.0 alone let a ZERO-worker session fall through to the
    # config path on resume — silently gaining workers the human never launched
    # (codex session-shape finding; bites whenever config workers= grows, e.g. the
    # lead-pair default). A fresh launch has no meta file yet, so file-existence is
    # the resume fact.
    local _rw_meta="${SESSIONS_DIR}/${SESSION}/meta"
    [[ -f "$_rw_meta" ]] || _rw_meta="${WORKTREES_DIR}/${SESSION}/.ae/${SESSION}/meta"
    if [[ -f "$_rw_meta" ]]; then
        local _wi=0 _saved _walias _wrest _wname _wcmd
        while :; do
            _saved="$(read_session_meta "$SESSION" "agent.worker.${_wi}")"
            [[ -n "$_saved" ]] || break
            _walias="${_saved%%:*}"
            _wrest="${_saved#*:}"
            _wname="${_wrest%%:*}"
            _wcmd="$(get_config "agents.${_walias}")"
            if [[ -z "$_wcmd" ]]; then
                echo "Error: resumed worker '${_wname}' uses alias '${_walias}', no longer defined in $CONFIG_FILE — restore the [agents] entry, or 'ae end' the session" >&2
                exit 1
            fi
            WORKER_ALIASES+=("$_walias")
            WORKER_NAMES+=("$_wname")
            WORKER_CMDS+=("$_wcmd")
            _wi=$((_wi + 1))
        done
        return 0
    fi
    # Fresh: parse config workspace.workers + dedup.
    [[ -n "$WORKERS_RAW" ]] || return 0
    local -a _entries
    local entry walias wname cmd
    IFS=',' read -ra _entries <<<"$WORKERS_RAW"
    for entry in "${_entries[@]}"; do
        entry="$(echo "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        if [[ "$entry" == *:* ]]; then
            walias="${entry%%:*}"
            wname="${entry#*:}"
            if [[ "$wname" == *:* ]]; then
                echo "Error: worker name '${wname}' cannot contain ':' — use alias:name format (one colon)" >&2
                exit 1
            fi
        else
            walias="$entry"
            wname="$entry" # default name = alias
        fi
        cmd="$(get_config "agents.${walias}")"
        if [[ -z "$cmd" ]]; then
            echo "Error: agent '${walias}' not defined in $CONFIG_FILE" >&2
            exit 1
        fi
        WORKER_ALIASES+=("$walias")
        WORKER_NAMES+=("$wname")
        WORKER_CMDS+=("$cmd")
    done
    # Deduplicate names: append index if a name collides with main or another worker.
    local -A _name_seen=()
    _name_seen["$MAIN_NAME"]=1
    local i wn
    for i in "${!WORKER_NAMES[@]}"; do
        wn="${WORKER_NAMES[$i]}"
        if [[ -n "${_name_seen[$wn]:-}" ]]; then
            WORKER_NAMES[i]="${wn}-${i}"
        fi
        _name_seen["${WORKER_NAMES[$i]}"]=1
    done
    return 0
}

# Present spawned indices from a session's meta, in numeric order, WITHOUT
# renumbering. A retire removes exactly one agent.spawned.<n> line, leaving a
# gap; this returns the survivors' ORIGINAL indices so resume can preserve them
# (R2 — a renumber would break the slot key and orphan in-flight slotted
# requests). Query helper: result is stdout, exit status incidental (set -e).
_spawned_meta_indices() {
    local session_name="$1" meta
    meta="${SESSIONS_DIR}/${session_name}/meta"
    [[ -f "$meta" ]] || meta="${WORKTREES_DIR}/${session_name}/.ae/${session_name}/meta"
    [[ -f "$meta" ]] || return 0
    grep -oE '^agent\.spawned\.[0-9]+' "$meta" 2>/dev/null | sed -E 's/.*\.//' | sort -n -u || true
    return 0
}

# Recover spawned agents from meta on resume, PRESERVING each survivor's
# original spawned.N index across gaps. Populates the SPAWNED_* globals
# (parallel arrays; SPAWNED_IDX carries the original index alongside each
# entry) plus UNRESOLVED_SPAWNED/UNRESOLVED_IDX for entries whose alias is no
# longer configured on this machine. Symmetric with _resolve_workers: meta wins
# on resume, cmd comes from config by alias. No tmux — pure, unit-testable.
_resolve_spawned() {
    SPAWNED_ALIASES=()
    SPAWNED_NAMES=()
    SPAWNED_CMDS=()
    SPAWNED_SESSION_IDS=()
    SPAWNED_IDX=()
    UNRESOLVED_SPAWNED=()
    UNRESOLVED_IDX=()
    local _idxs
    _idxs="$(_spawned_meta_indices "$SESSION")"
    [[ -n "$_idxs" ]] || return 0
    local _si _saved _salias _srest _sname _scmd
    for _si in $_idxs; do
        _saved="$(read_session_meta "$SESSION" "agent.spawned.${_si}")"
        [[ -n "$_saved" ]] || continue
        # Format: alias:name:session_id
        _salias="${_saved%%:*}"
        _srest="${_saved#*:}"
        _sname="${_srest%%:*}"
        _scmd="$(get_config "agents.${_salias}")"
        if [[ -n "$_scmd" ]]; then
            SPAWNED_ALIASES+=("$_salias")
            SPAWNED_NAMES+=("$_sname")
            SPAWNED_CMDS+=("$_scmd")
            SPAWNED_SESSION_IDS+=("$(resolve_agent_session_id "$_scmd" "spawned.${_si}")")
            SPAWNED_IDX+=("$_si")
        else
            # Loud, not silent (audit finding): after a transfer the destination
            # config may lack the alias — dropping the worker quietly loses the
            # operator's intent. Preserve the raw entry AND its original index so
            # the meta rewrite re-emits it in place and a later resume (with the
            # alias added) can still restore the worker.
            UNRESOLVED_SPAWNED+=("$_saved")
            UNRESOLVED_IDX+=("$_si")
            echo "Warning: spawned agent '${_salias}:${_sname}' NOT restored — alias '${_salias}' missing from this machine's ae config. Entry preserved; add the alias and resume again." >&2
        fi
    done
    return 0
}

sync_session_assets() {
    local session_name="$1" meta_dir="$2" work_dir="$3" origin="$4" mode="$5" main_pane="$6" config_file="${7:-$CONFIG_FILE}"
    local previous_config="$CONFIG_FILE" previous_local_config="${AE_LOCAL_CONFIG:-}"
    local ae_path script_path
    ae_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    script_path="$ae_path"

    if [[ -n "$config_file" ]]; then
        CONFIG_FILE="$config_file"
    fi
    AE_LOCAL_CONFIG=""

    if [[ -f "${meta_dir}/meta" ]]; then
        set_session_meta_value "${meta_dir}/meta" "ae_path" "$ae_path"
        set_session_meta_value "${meta_dir}/meta" "ae_version" "$AE_VERSION"
        if [[ -n "$config_file" ]]; then
            set_session_meta_value "${meta_dir}/meta" "config" "$config_file"
        fi
    fi

    local AE_META="$meta_dir"
    local SESSION="$session_name"
    local WORK_DIR="$work_dir"
    local ORIGIN_DIR="$origin"
    local COPY_MODE="$mode"
    local MAIN_PANE="$main_pane"

    # Reuse the canonical helper-render body later in this file so doctor and session
    # creation always generate the same helper scripts.
    # shellcheck disable=SC1091  # dynamic source of our own marker region — unfollowable
    source /dev/stdin <<<"$(awk '
        /^[[:space:]]*# SYNC_SESSION_ASSETS_BODY_START$/ { printing = 1; next }
        /^[[:space:]]*# SYNC_SESSION_ASSETS_BODY_END$/ { printing = 0 }
        printing { print }
    ' "$script_path")"

    CONFIG_FILE="$previous_config"
    AE_LOCAL_CONFIG="$previous_local_config"
}

# List all ae sessions (tagged with AE_SESSION env var)
list_ae_sessions() {
    local sessions=""
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        if tmux show-environment -t "$name" AE_SESSION 2>/dev/null | grep -q '^AE_SESSION='; then
            sessions="${sessions}${name}\n"
        fi
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
    printf '%b' "$sessions"
}

# Iterate stopped sessions (on disk but not running), de-duplicated across SESSIONS_DIR and WORKTREES_DIR
iter_stopped_sessions() {
    declare -A _seen=()
    for dir in "$SESSIONS_DIR" "$WORKTREES_DIR"; do
        [[ -d "$dir" ]] || continue
        for entry in "$dir"/*/; do
            [[ -d "$entry" ]] || continue
            local name
            name="$(basename "$entry")"
            [[ -n "${_seen[$name]:-}" ]] && continue
            tmux has-session -t "$name" 2>/dev/null && continue
            _seen[$name]=1
            echo "$name"
        done
    done
}

# Clean up session resources (mode-aware)
# Remove the underlying agent CLI conversation files for the named session.
# Best-effort: missing files print no error (already gone is success).
# Reuses _transfer_find_<tool>_session_file helpers for UUID-based lookup —
# they're general-purpose despite the "transfer" prefix. Gemini and OpenCode
# have no lookup helper yet, so those agents are skipped with a warning
# (their files leak; same gap as ae transfer's MVP).
#
# Tool detection: read agent_bin.<slot> from meta (canonical, written by ae
# at session creation via extract_binary_from_cmd). The agent.<slot> alias
# field is arbitrary user config and unreliable for tool dispatch — e.g.
# config `lead = "claude ..."` would write agent.main=lead:architect:<uuid>,
# and treating "lead" as the tool kind silently leaks the Claude jsonl.
# Fall back to the alias only when agent_bin.<slot> is missing (legacy meta).
_cleanup_agent_session_files() {
    local session_name="$1"
    local meta="${SESSIONS_DIR}/${session_name}/meta"
    [[ -f "$meta" ]] || return 0
    # Pass 1: collect agent_bin.<slot> entries into a lookup map.
    declare -A agent_bins=()
    local k v slot
    while IFS='=' read -r k v; do
        case "$k" in
            agent_bin.*) agent_bins["${k#agent_bin.}"]="$v" ;;
        esac
    done <"$meta"
    # Pass 2: iterate agents, dispatch on agent_bin (fallback to alias).
    local tool uuid file
    while IFS='=' read -r k v; do
        [[ "$k" =~ ^agent\. ]] || continue
        slot="${k#agent.}"
        tool="${agent_bins[$slot]:-${v%%:*}}"
        uuid="${v##*:}"
        [[ "$uuid" == "pending" ]] && continue
        case "$tool" in
            claude)
                if file="$(_transfer_find_claude_session_file "$uuid" 2>/dev/null)"; then
                    rm -f "$file" 2>/dev/null && echo "  removed claude conversation: $file"
                fi
                ;;
            codex)
                if file="$(_transfer_find_codex_session_file "$uuid" 2>/dev/null)"; then
                    rm -f "$file" 2>/dev/null && echo "  removed codex rollout: $file"
                fi
                ;;
            gemini | opencode)
                echo "  note: $tool conversation file for slot $slot left in place (lookup not yet implemented)" >&2
                ;;
        esac
    done <"$meta"
}

cleanup_session() {
    local session_name="$1" mode="${2:-}" origin="${3:-}"
    local wt="${WORKTREES_DIR}/${session_name}"

    # mode/origin are passed by end_session, captured EXACTLY (by session id on the
    # target's own server) BEFORE the kill. NEVER re-read live tmux by raw name here:
    # this runs AFTER the kill, so `-t <name>` prefix-matches a live NEIGHBOR whose mode
    # bleeds in — a git target then reads a local neighbor's mode and its worktree LEAKS
    # (B2). Fall back to the target's on-disk meta only.
    [[ -z "$mode" ]] && mode="$(read_session_meta "$session_name" mode)"
    [[ -z "$origin" ]] && origin="$(read_session_meta "$session_name" origin)"

    # The underlying agent CLI conversation files (claude/codex jsonl) are KEPT by
    # default — they're the only local per-session record of token usage, retained
    # for later usage/cost reporting. Purge only when asked. Decision: a CLI flag
    # (_AE_PURGE_HISTORY_CLI from cmd_end) overrides; otherwise the default comes
    # from THIS session's OWN config — hydrated from its meta `config` + origin (the
    # resume pattern) — so a cross-repo end or `ae end all` honors each session's
    # policy, not the caller's cwd. (Claude self-sweeps via cleanupPeriodDays;
    # Codex/OpenCode don't, so this is the only prune hook — hence opt-in.) Read
    # meta BEFORE we rm -rf the dir below.
    local _purge="${_AE_PURGE_HISTORY_CLI:-}"
    if [[ -z "$_purge" ]]; then
        local _scfg _prev_cfg="$CONFIG_FILE" _prev_local="${AE_LOCAL_CONFIG:-}"
        _scfg="$(read_session_meta "$session_name" config)"
        if [[ -n "$_scfg" && -f "$_scfg" ]]; then
            CONFIG_FILE="$_scfg"
        else
            # No usable stored config (old/transferred/broken session): do NOT fall
            # back to the caller's cwd/global (that would let an unrelated purge=true
            # bleed in). /dev/null is an empty source parse_config skips, so only the
            # session's OWN origin local config (layered below) can opt into purge.
            CONFIG_FILE=/dev/null
        fi
        if [[ -n "$origin" && -f "${origin}/.ae/config" ]]; then
            AE_LOCAL_CONFIG="${origin}/.ae/config"
        else
            AE_LOCAL_CONFIG=""
        fi
        case "$(get_config workspace.purge_agent_history)" in
            true | 1 | yes | on) _purge=true ;;
            *) _purge=false ;;
        esac
        CONFIG_FILE="$_prev_cfg"
        AE_LOCAL_CONFIG="$_prev_local"
    fi
    if [[ "$_purge" == "true" ]]; then
        _cleanup_agent_session_files "$session_name"
    else
        echo "  kept agent conversation files (claude/codex token history; purge: ae end --purge-history)"
    fi

    # Kill any legacy heartbeat before removing meta.
    kill_heartbeat "$session_name"

    # Always clean session state from SESSIONS_DIR
    rm -rf "${SESSIONS_DIR:?}/${session_name:?}"
    # Legacy cleanup: old worktree-nested and local-mode paths
    rm -rf "${WORKTREES_DIR}/${session_name}/.ae/${session_name}" 2>/dev/null || true
    if [[ -n "$origin" ]] && [[ -d "${origin}/.ae/${session_name}" ]]; then
        rm -rf "${origin}/.ae/${session_name}"
    fi

    if [[ "$mode" == "local" ]]; then
        echo "Cleaned up local session $session_name"
        return 0
    fi

    [[ -d "$wt" ]] || return 0

    if [[ "$mode" == "git" ]] && [[ -n "$origin" ]]; then
        git -C "$origin" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
        git -C "$origin" worktree prune 2>/dev/null || true
    else
        rm -rf "$wt"
    fi
    echo "Removed worktree for $session_name"
}

# Sanitize session name to valid git branch name
sanitize_branch_name() {
    local name="$1"
    # Strip ae- prefix for cleaner branch names
    name="${name#ae-}"
    # Replace invalid chars with -, collapse repeats, trim edges
    name="$(echo "$name" | sed 's/[^a-zA-Z0-9._-]/-/g; s/--*/-/g; s/^-//; s/-$//')"
    echo "ae/${name}"
}

# Resolve work directory for a session (running or stopped)
resolve_session_workdir() {
    local session_name="$1"
    local wdir="" _sid
    # Try tmux env first (running session) — by EXACT id, never the raw name: a
    # `-t project` read would prefix-match a live `project2` and hand back the wrong
    # workdir. Empty id → not live → fall through to on-disk meta.
    _sid="$(_ae_session_id "$session_name")"
    if [[ -n "$_sid" ]]; then
        wdir="$(tmux show-environment -t "$_sid" AE_DIR 2>/dev/null | sed 's/^AE_DIR=//' || true)"
    fi
    if [[ -z "$wdir" ]] || [[ ! -d "$wdir" ]]; then
        # Try on-disk meta (stopped session)
        wdir="$(read_session_meta "$session_name" work_dir)"
    fi
    if [[ -z "$wdir" ]] || [[ ! -d "$wdir" ]]; then
        # Fallback: standard worktree path
        wdir="${WORKTREES_DIR}/${session_name}"
    fi
    echo "$wdir"
}

# End a session: commit dirty state, push to ae/<branch>, then clean up
# Returns non-zero on failure (session is preserved on failure)
end_session() {
    local session_name="$1"

    # Resolve the target on ITS OWN tmux server (from meta), by EXACT id — never by the
    # raw name (prefix-matches: killing `project` while ending `proj`), and never on just
    # the ambient server (a plain-shell end of a NAMED-server session would miss it,
    # delete state, and orphan it alive). Empty id = not live there, so the live-tmux ops
    # are skipped and the on-disk meta paths take over.
    local _es_srv _es_sid
    _es_srv="$(_end_target_server "$session_name")"
    local -a _es_t=(tmux)
    [[ -n "$_es_srv" ]] && _es_t=(command tmux -L "$_es_srv")
    _es_sid="$("${_es_t[@]}" list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id "$session_name")"

    # Resolve mode and origin. Initialize to "" — under set -u a stopped session leaves
    # _es_sid empty, so the tmux reads below are skipped and `[[ -z "$mode" ]]` would
    # otherwise abort on an unset var. These are captured EXACTLY here and passed into
    # cleanup_session so it never rediscovers live data by raw name after the kill.
    local mode="" origin="" wdir=""
    if [[ -n "$_es_sid" ]]; then
        mode="$("${_es_t[@]}" show-environment -t "$_es_sid" AE_MODE 2>/dev/null | sed 's/^AE_MODE=//' || true)"
        origin="$("${_es_t[@]}" show-environment -t "$_es_sid" AE_ORIGIN 2>/dev/null | sed 's/^AE_ORIGIN=//' || true)"
    fi
    if [[ -z "$mode" ]]; then
        mode="$(read_session_meta "$session_name" mode)"
    fi
    if [[ -z "$origin" ]]; then
        origin="$(read_session_meta "$session_name" origin)"
    fi
    wdir="$(resolve_session_workdir "$session_name")"

    # Local mode: just clean up (no work to preserve — files are in original dir)
    if [[ "$mode" == "local" ]]; then
        if [[ -n "$_es_sid" ]]; then
            "${_es_t[@]}" kill-session -t "$_es_sid" 2>/dev/null || true
        fi
        cleanup_session "$session_name" "$mode" "$origin"
        echo "Ended local session $session_name"
        return 0
    fi

    # git/full mode: commit + push if in a git repo
    if [[ -d "$wdir" ]] && git -C "$wdir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        # Check for uncommitted changes
        if ! git -C "$wdir" diff --quiet 2>/dev/null || ! git -C "$wdir" diff --cached --quiet 2>/dev/null ||
            [[ -n "$(git -C "$wdir" ls-files --others --exclude-standard 2>/dev/null)" ]]; then
            echo "Committing changes in $session_name..."
            git -C "$wdir" add -A
            local ts
            ts="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
            if ! git -C "$wdir" commit -m "ae: end session ${session_name}" -m "Ended: ${ts}"; then
                echo "Error: commit failed. Session preserved — fix manually and retry." >&2
                echo "  Working directory: $wdir" >&2
                return 1
            fi
        fi

        # Check if there's anything to push (HEAD not already on a remote branch)
        local needs_push=false
        if git -C "$wdir" remote get-url origin >/dev/null 2>&1; then
            # Fetch silently to check against remote state
            git -C "$wdir" fetch origin --quiet 2>/dev/null || true
            if ! git -C "$wdir" branch -r --contains HEAD 2>/dev/null | grep -q .; then
                needs_push=true
            fi
        fi

        if [[ "$needs_push" == true ]]; then
            local branch
            branch="$(sanitize_branch_name "$session_name")"
            echo "Pushing to origin/${branch}..."

            # Show what we're pushing (count files changed across all unpushed commits)
            local file_count
            file_count="$(git -C "$wdir" diff --name-only "$(git -C "$wdir" merge-base HEAD origin/HEAD 2>/dev/null || echo HEAD~1)" HEAD 2>/dev/null | wc -l || echo "?")"
            echo "  ${file_count} file(s) changed"

            if ! git -C "$wdir" push -u origin "HEAD:refs/heads/${branch}"; then
                echo "Error: push failed. Session preserved — fix manually and retry." >&2
                echo "  Working directory: $wdir" >&2
                echo "  To retry: cd $wdir && git push -u origin HEAD:refs/heads/${branch}" >&2
                return 1
            fi
            echo "Pushed to origin/${branch}"
        else
            if ! git -C "$wdir" remote get-url origin >/dev/null 2>&1; then
                echo "No remote 'origin' — skipping push."
            else
                echo "No new commits to push."
            fi
        fi
    else
        echo "Error: working directory is not a git repo — cannot preserve work." >&2
        echo "  Use 'ae end $session_name' to end the session." >&2
        return 1
    fi

    # All good — clean up (kill by exact id; empty means it was not live)
    if [[ -n "$_es_sid" ]]; then
        "${_es_t[@]}" kill-session -t "$_es_sid" 2>/dev/null || true
    fi
    cleanup_session "$session_name" "$mode" "$origin"
    echo "Ended $session_name"
    return 0
}

# --- Subcommands ---

# Parse agent entry (alias:name:session_id) and print "alias:name short_sid"
_parse_agent_entry() {
    local val="$1"
    # Format: alias:name:session_id
    local alias="${val%%:*}"
    local rest="${val#*:}"
    local name="${rest%%:*}"
    local sid="${rest#*:}"
    local short="-"
    [[ -n "$sid" && "$sid" != "pending" ]] && short="${sid:0:8}"
    printf '%s:%s\t%s\n' "$alias" "$name" "$short"
}

# Resolve the session's actual meta directory, checking the new path first and
# falling back to the legacy worktree-nested path that read_session_meta() also
# honors. Prints the resolved directory, or empty if none found.
_resolve_session_dir() {
    local name="$1"
    local primary="${SESSIONS_DIR}/${name}"
    if [[ -f "${primary}/meta" ]]; then
        printf '%s' "$primary"
        return
    fi
    local legacy="${WORKTREES_DIR}/${name}/.ae/${name}"
    if [[ -f "${legacy}/meta" ]]; then
        printf '%s' "$legacy"
        return
    fi
}

# Print the sub-line after a session row showing goal + current ae version +
# last active. $1 = meta_blob (full meta file contents), $2 = session directory,
# $3 = optional attention suffix (e.g. a declared state like "waiting-user").
# Session git branch for the list context. Running sessions: read the live
# @ae_branch_name tmux user option (watchdog-pushed each cycle — zero git
# calls; full name, no display trim). Fallback (option empty, watchdog off,
# or stopped session): one git call against the work_dir.
_session_branch() {
    local name="$1" workdir="$2" running="${3:-}" b=""
    if [[ "$running" == "running" ]]; then
        # @ae_branch_name is the watchdog's machine-value side channel: the
        # FULL branch, untrimmed, no dirty marker (@ae_branch_status is the
        # display segment — 24-char trim — and must never be echoed as data).
        b="$(tmux show-options -t "$name" -qv @ae_branch_name 2>/dev/null || true)"
    fi
    if [[ -z "$b" && -n "$workdir" && -d "$workdir" ]]; then
        b="$(git -C "$workdir" symbolic-ref --quiet --short HEAD 2>/dev/null ||
            git -C "$workdir" rev-parse --short HEAD 2>/dev/null || true)"
    fi
    printf '%s' "$b"
    return 0
}

# Epoch when the session's goal was last set — the newest action=goal event in
# the session's events.jsonl. Prints 0 when unknown (no events file, no goal
# event, or unparseable timestamp). Result via stdout; exit status incidental.
_goal_set_epoch() {
    local sess_dir="$1" line ts=""
    local events="${sess_dir}/events.jsonl"
    [[ -f "$events" ]] || {
        printf '0'
        return 0
    }
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        [[ "$(_event_json_str "$line" action)" == "goal" ]] || continue
        ts="$(_event_json_str "$line" ts)"
        break
    done < <(tac "$events" 2>/dev/null || true)
    [[ -n "$ts" ]] || {
        printf '0'
        return 0
    }
    date -d "$ts" +%s 2>/dev/null || printf '0'
    return 0
}

_print_session_meta_line() {
    local blob="$1" sess_dir="$2" attn="${3:-}" branch="${4:-}"
    local ae_ver active_ts active_str goal goal_prefix="" branch_seg=""
    ae_ver="$(echo "$blob" | sed -n 's/^ae_version=//p')"
    ae_ver="${ae_ver:-?}"
    goal="$(echo "$blob" | sed -n 's/^goal=//p' | head -1)"
    if [[ -n "$goal" ]]; then
        ((${#goal} > 60)) && goal="${goal:0:59}…"
        # Age makes a stale goal visibly stale instead of silently lying.
        local goal_epoch goal_age=""
        goal_epoch="$(_goal_set_epoch "$sess_dir")"
        if [[ "$goal_epoch" =~ ^[0-9]+$ ]] && ((goal_epoch > 0)); then
            goal_age=" ($(format_relative_time "$goal_epoch"))"
        fi
        goal_prefix="goal${goal_age}: ${goal} · "
    fi
    [[ -n "$branch" ]] && branch_seg="git:${branch} · "
    active_ts="$(_session_active_epoch "$sess_dir")"
    active_str="$(format_relative_time "$active_ts")"
    if [[ -n "$attn" ]]; then
        printf "  %s%sae %s · active %s · attn:%s\n" "$goal_prefix" "$branch_seg" "$ae_ver" "$active_str" "$attn"
    else
        printf "  %s%sae %s · active %s\n" "$goal_prefix" "$branch_seg" "$ae_ver" "$active_str"
    fi
}

# Extract a flat-JSON string value. Single source: used directly by ae's own
# code (cmd_list/_session_states) AND emitted by name into every generated
# _lib via declare -f. The old byte-identical _lib mirror is gone; the unit
# suite asserts exactly one copy exists.
_event_json_str() {
    local line="$1" key="$2"
    local prefix="\"${key}\":\""
    local rest="${line#*"${prefix}"}"
    [[ "$rest" == "$line" ]] && return
    local result="" i=0 n=${#rest}
    local c next
    while ((i < n)); do
        c="${rest:$i:1}"
        if [[ "$c" == "\\" ]]; then
            next="${rest:$((i + 1)):1}"
            case "$next" in
                n) result+=" " ;;
                t) result+=" " ;;
                r) ;;
                '"') result+='"' ;;
                "\\") result+="\\" ;;
                *) result+="$c$next" ;;
            esac
            i=$((i + 2))
        elif [[ "$c" == '"' ]]; then
            break
        else
            result+="$c"
            i=$((i + 1))
        fi
    done
    printf '%s' "$result"
}

# Print 'agent<TAB>state' for every actor that has declared a work state in this
# session's events.jsonl. Single backward pass; the first (newest) state per
# actor wins. Legacy action=done events report as state=done for back-compat.
# Scope: state/done events only — this is NOT a full attention signal (pending
# asks, dead agents, alerts are deliberately out of scope here; that belongs in
# a future `ae watch`). Callers must treat the result as state display only.
_session_states() {
    local sess_dir="$1"
    [[ -n "$sess_dir" ]] || return 0
    local events="${sess_dir}/events.jsonl"
    [[ -f "$events" ]] || return 0
    declare -A _seen=()
    local line actor action st
    # grep-prefilter to relevant events before the per-char parser runs.
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        action="$(_event_json_str "$line" action)"
        case "$action" in
            state | done) ;;
            *) continue ;;
        esac
        actor="$(_event_json_str "$line" actor)"
        [[ -n "$actor" ]] || continue
        [[ -n "${_seen[$actor]:-}" ]] && continue
        if [[ "$action" == "done" ]]; then
            st="done"
        else
            st="$(_event_json_str "$line" ref)"
        fi
        [[ -n "$st" ]] || continue
        _seen["$actor"]="$st"
        printf '%s\t%s\n' "$actor" "$st"
    done < <(grep -aE '"action":"(state|done)"' "$events" 2>/dev/null | tac || true)
}

# Active alert/throttle reason for an agent, or empty. Reuses the watchdog
# watchdog's own alert/throttled events as the attention signal (max-nudges,
# missing pane, persistent throttle) instead of re-deriving them. An alert is
# "active" only while it is the newest event mentioning the agent — any newer
# activity (state/send/nudge) or an explicit clear (throttle-cleared /
# alert-cleared) supersedes it. Returns a short reason: dead | stale | throttled | "".
_agent_alert_reason() {
    local events="$1" agent="$2" session="$3"
    [[ -f "$events" ]] || return 0
    local line actor target action summary
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        actor="$(_event_json_str "$line" actor)"
        target="$(_event_json_str "$line" target)"
        [[ "$actor" == "$agent" || "$target" == "$agent" || "$target" == "@${session}:${agent}" ]] || continue
        action="$(_event_json_str "$line" action)"
        case "$action" in
            alert)
                summary="$(_event_json_str "$line" summary)"
                # Summaries come from the watchdog (see ae_emit_event
                # "alert" sites): "agent process dead — dropped to shell",
                # "pane missing …", "max nudges reached …", "throttled for …",
                # "meta-agent not sweeping …". The meta-agent wedge alert is
                # matched FIRST and mapped to high-severity stale — its summary text
                # must not be downgraded to throttled by a stray substring match.
                case "$summary" in
                    *"not sweeping"*) printf 'stale' ;;
                    *dead* | *dropped* | *missing* | *MISSING*) printf 'dead' ;;
                    *throttl*) printf 'throttled' ;;
                    *) printf 'stale' ;; # max-nudges and any other alert
                esac
                return 0
                ;;
            throttled)
                printf 'throttled'
                return 0
                ;;
            throttle-cleared | alert-cleared) return 0 ;; # explicit watchdog-owned clears
            *)
                # The agent's OWN activity (state/send/reply/…) means it
                # recovered → clears any alert. A target-only event (a watchdog
                # nudge or an inbound send/ask addressed TO the agent) is NOT
                # recovery — skip it and keep scanning back for a live alert.
                [[ "$actor" == "$agent" ]] && return 0
                ;;
        esac
    done < <(tac "$events" 2>/dev/null || true)
    # No decisive alert/recovery found → no active alert. Return success
    # explicitly: the result is the emitted string, not the exit status. Without
    # this the function inherits the loop's status (non-zero when the last
    # scanned line hit the target-only `*)` path), and a caller doing
    # `r="$(_agent_alert_reason …)"` under `set -e` would abort mid-command.
    return 0
}

# Severity rank for an attention reason (higher = more urgent). Used to pick the
# single most-actionable reason across a session's agents.
_attn_rank() {
    case "$1" in
        dead) printf '6' ;;
        stale) printf '5' ;;
        waiting-user) printf '4' ;;
        blocked) printf '3' ;;
        throttled) printf '2' ;;
        unanswered) printf '1' ;;
        *) printf '0' ;;
    esac
}

# Session needs_attention rollup — the SINGLE source of attention semantics,
# shared by cmd_list and cmd_next so they can never diverge. Computes the single
# most-actionable reason across the session's CURRENT agents (severity via
# _attn_rank: dead > stale > waiting-user > blocked > throttled > unanswered), and the agent
# that raised it. 'dead' = a registered agent whose pane vanished; stale/throttled
# come from the watchdog's alert events; waiting-user/blocked are self-declared.
# Only agents present in meta may raise attention (a stray/retired actor must not).
#
# Outputs via globals (NOT stdout) so the call runs in the caller's shell — that
# lets it populate the caller's _areason map (per-agent reason, for --json) via
# dynamic scope; a process-substitution subshell would silently drop those writes.
#   sets: _AE_ATTN_REASON (reason or empty), _AE_ATTN_AGENT (contributing agent)
#   fills: _areason["<agent>"]=<reason>  — only if the caller has _areason in scope
# shellcheck disable=SC2154 # _areason is an optional caller-scope map (dynamic scope)
_session_attn_rollup() {
    local name="$1" sess_dir="$2" meta_blob="$3"
    local events="${sess_dir}/events.jsonl"
    _AE_ATTN_REASON=""
    _AE_ATTN_AGENT=""
    declare -A _s=() _c=() _al=()
    local sa sv mk mv _an _as ag pc
    while IFS=$'\t' read -r sa sv; do
        [[ -n "$sa" ]] && _s["$sa"]="$sv"
    done < <(_session_states "$sess_dir")
    while IFS='=' read -r mk mv; do
        [[ "$mk" == agent.* ]] || continue
        IFS=$'\t' read -r _an _as < <(_parse_agent_entry "$mv")
        [[ -n "$_an" ]] && _c["$_an"]=1
    done <<<"$meta_blob"
    while IFS=$'\t' read -r ag pc; do
        [[ -n "$ag" ]] || continue
        case "$pc" in
            bash | fish | zsh | sh | dash) _al["$ag"]="!" ;;
            *) _al["$ag"]="" ;;
        esac
    done < <(tmux list-panes -s -t "$name" -F '#{@ae_agent}	#{pane_current_command}' 2>/dev/null)
    # Stale-request pass: an ask/review whose ref never got a reply and is
    # older than AE_ATTN_REQUEST_SECS (default 30min) marks its TARGET agent
    # 'unanswered' — the lowest-rank attention reason. Requests between the
    # session's agents were previously invisible unless someone ran
    # \`requests\`; agents silently waiting on each other is a coordination
    # blind spot (list/next/steward all read this rollup).
    declare -A _preq=() _unans=()
    if [[ -f "$events" ]]; then
        local _pl _pact _pref _ptgt _pts _pnow _page _request_secs
        # Numeric-guard the threshold BEFORE arithmetic (review finding: a
        # malformed env value aborts (( )) under nounset instead of degrading).
        _request_secs="${AE_ATTN_REQUEST_SECS:-1800}"
        [[ "$_request_secs" =~ ^[0-9]+$ ]] || _request_secs=1800
        _pnow="$(date +%s 2>/dev/null || echo 0)"
        while IFS= read -r _pl; do
            [[ "$_pl" == \{* ]] || continue
            _pact="$(_event_json_str "$_pl" action)"
            case "$_pact" in
                ask | review)
                    _pref="$(_event_json_str "$_pl" ref)"
                    [[ -n "$_pref" && -z "${_preq[$_pref]+x}" ]] || continue
                    _ptgt="$(_event_json_str "$_pl" target)"
                    _pts="$(_event_json_str "$_pl" ts)"
                    _page=0
                    [[ -n "$_pts" ]] && _page="$(date -d "$_pts" +%s 2>/dev/null || echo 0)"
                    if ((_pnow > 0 && _page > 0 && _pnow - _page >= _request_secs)); then
                        _preq[$_pref]="$_ptgt"
                    else
                        _preq[$_pref]=""
                    fi
                    ;;
                reply)
                    _pref="$(_event_json_str "$_pl" ref)"
                    [[ -n "$_pref" ]] && _preq[$_pref]=""
                    ;;
            esac
        done < <(tac "$events" 2>/dev/null || true)
        local _pt
        for _pref in "${!_preq[@]}"; do
            _pt="${_preq[$_pref]}"
            [[ -n "$_pt" && -n "${_c[$_pt]+x}" ]] || continue
            _unans[$_pt]=1
        done
    fi
    local a r
    for a in "${!_c[@]}"; do
        if [[ -z "${_al[$a]+x}" ]]; then
            r="dead"
        else
            r="$(_agent_alert_reason "$events" "$a" "$name")"
            [[ -n "$r" ]] || r="${_s[$a]:-}"
        fi
        case "$r" in waiting-user | blocked | dead | stale | throttled | unanswered) ;; *) r="" ;; esac
        # Lowest-rank fallback: no other reason, but the agent owes a reply
        # (covers a worker that declared done while a request sits unanswered).
        [[ -z "$r" && -n "${_unans[$a]+x}" ]] && r="unanswered"
        [[ -n "${_areason+x}" ]] && _areason["$a"]="$r"
        [[ -n "$r" ]] || continue
        if (($(_attn_rank "$r") > $(_attn_rank "$_AE_ATTN_REASON"))); then
            _AE_ATTN_REASON="$r"
            _AE_ATTN_AGENT="$a"
        fi
    done
}

# Ranking comparison for `ae next`: should the candidate (rank,epoch,name) replace
# the current best? Deterministic order: higher severity rank, then more-recent
# activity, then name ascending — so equal-rank/equal-mtime ties are stable and
# scriptable, not tmux-list order. Pure → unit-tested directly.
_next_better() {
    local rank="$1" epoch="$2" name="$3" brank="$4" bepoch="$5" bname="$6"
    ((rank > brank)) && return 0
    ((rank < brank)) && return 1
    ((epoch > bepoch)) && return 0
    ((epoch < bepoch)) && return 1
    [[ -z "$bname" || "$name" < "$bname" ]] && return 0
    return 1
}

# Which tmux verb focuses a session, by whether we're already inside tmux:
# switch-client (inside — attach-session errors with "sessions should be nested
# with care") vs attach-session (outside). Returns ONLY the verb so the caller
# passes the target as a separate quoted argv element — a session name with
# spaces must not be word-split. Pure → unit-tested.
_next_focus_verb() {
    if [[ -n "${TMUX:-}" ]]; then
        printf 'switch-client'
    else
        printf 'attach-session'
    fi
}

# `ae next` — attention navigator (Layer 2). Names the top-ranked RUNNING session
# needing attention, reusing _session_attn_rollup (the same semantics as
# `ae list`). Read-only by default (prints); `--attach` jumps to it (switch-client
# inside tmux / attach-session outside). Exits non-zero when nothing needs
# attention so it composes in scripts and Layer 3.
# Tie-break across equally-severe sessions: most-recent activity, then name asc.
cmd_next() {
    local do_attach=false arg
    for arg in "$@"; do
        case "$arg" in
            -h | --help)
                cat >&2 <<'USAGE'
Usage: ae next [--attach]   Name the top running session needing attention.
       ae jump [--attach]   Alias for ae next.

Read-only by default: prints "<session>  attn:<reason>  rank:<n>  <agent>" and
exits 0, or a message on stderr and non-zero when nothing needs attention.
--attach (alias --switch) jumps to that session: switch-client inside tmux,
attach-session outside.
USAGE
                return 0
                ;;
            --attach | --switch)
                do_attach=true
                ;;
            *)
                echo "ae next: unknown argument '$arg' (see: ae next --help)" >&2
                return 2
                ;;
        esac
    done

    local sessions name
    sessions="$(list_ae_sessions)"
    local best_name="" best_reason="" best_agent="" best_rank=0 best_epoch=0
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        local sess_dir
        sess_dir="$(_resolve_session_dir "$name")"
        [[ -n "$sess_dir" ]] || continue
        local meta_blob=""
        [[ -f "${sess_dir}/meta" ]] && meta_blob="$(<"${sess_dir}/meta")"
        _session_attn_rollup "$name" "$sess_dir" "$meta_blob"
        [[ -n "$_AE_ATTN_REASON" ]] || continue
        local rank epoch
        rank="$(_attn_rank "$_AE_ATTN_REASON")"
        epoch="$(_session_active_epoch "$sess_dir")"
        if _next_better "$rank" "$epoch" "$name" "$best_rank" "$best_epoch" "$best_name"; then
            best_name="$name"
            best_reason="$_AE_ATTN_REASON"
            best_agent="$_AE_ATTN_AGENT"
            best_rank="$rank"
            best_epoch="$epoch"
        fi
    done <<<"$sessions"

    if [[ -z "$best_name" ]]; then
        echo "ae next: no running session needs attention." >&2
        return 1
    fi

    if ! $do_attach; then
        printf '%s  attn:%s  rank:%s  %s\n' "$best_name" "$best_reason" "$best_rank" "$best_agent"
        return 0
    fi

    # --attach: jump to the chosen session. Re-validate it still EXACTLY exists
    # (it may have ended between the scan and the jump). Use an exact
    # list-sessions match, NOT `has-session -t` — that prefix-matches, so a
    # vanished session with a surviving prefix-sibling would false-positive and
    # land the focus on the wrong session. Cannot make the final switch atomic,
    # but this removes the known false-positive.
    if ! tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- "$best_name"; then
        echo "ae next: '$best_name' disappeared before attach." >&2
        return 1
    fi
    if [[ -n "${TMUX:-}" ]]; then
        local cur
        cur="$(tmux display-message -p '#S' 2>/dev/null || true)"
        if [[ "$cur" == "$best_name" ]]; then
            echo "ae next: already in '$best_name' (attn:$best_reason)."
            return 0
        fi
    fi
    # Target passed as its own quoted argv element — never word-split (a session
    # name may contain spaces); the verb is a single fixed word.
    tmux "$(_next_focus_verb)" -t "$best_name"
}

# Escape a string for embedding in JSON. Single source: this body is emitted
# into every generated _lib via declare -f AND used directly by ae's own code
# (`ae list --json` needs no jq). The old byte-identical _lib mirror is gone —
# _json_escape below is a thin alias for ae's historical internal call sites.
ae_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/\\r}"
    printf '%s' "$s"
}
_json_escape() { ae_json_escape "$@"; }

# Last-active epoch for a session: mtime of the first existing of events.jsonl,
# then workspace.md, then meta (events.jsonl is the activity log, so in practice
# it is the most recently touched), or 0. NOT a max() across the three — this
# preserves the long-standing list meta-line behaviour, now shared with --json.
_session_active_epoch() {
    local sess_dir="$1" f ts=0
    [[ -n "$sess_dir" ]] || {
        printf '0'
        return
    }
    for f in "${sess_dir}/events.jsonl" "${sess_dir}/workspace.md" "${sess_dir}/meta"; do
        if [[ -f "$f" ]]; then
            ts="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
            [[ "$ts" != "0" ]] && break
        fi
    done
    printf '%s' "$ts"
}

# Emit one session as a JSON object for `ae list --json`. A cmd_list helper:
# it reads the per-iteration maps (_state/_alive/_areason) and the comma tracker
# (json_first) from cmd_list's scope via bash dynamic scoping. For stopped
# sessions those maps are unset, so agents render alive=false / state=null /
# reason=null. Args: status name mode origin workdir sess_dir attn meta_blob.
# shellcheck disable=SC2154 # _alive/_state/_areason/json_first come from cmd_list scope
_list_session_json() {
    local status="$1" name="$2" mode="$3" origin="$4" workdir="$5" sess_dir="$6" attn="$7" blob="$8" branch="${9:-}"
    $json_first || printf ','
    json_first=false
    local na="false" at="null"
    if [[ -n "$attn" ]]; then
        na="true"
        at="\"$(_json_escape "$attn")\""
    fi
    # Session goal (set via the 'goal' helper) — additive field; null when unset.
    local goal gj="null"
    goal="$(echo "$blob" | sed -n 's/^goal=//p' | head -1)"
    [[ -n "$goal" ]] && gj="\"$(_json_escape "$goal")\""
    # Context fields: when the goal was set (age for staleness) + git branch.
    local gse="null"
    if [[ "$gj" != "null" ]]; then
        local _ge
        _ge="$(_goal_set_epoch "$sess_dir")"
        if [[ "$_ge" =~ ^[0-9]+$ ]] && ((_ge > 0)); then gse="$_ge"; fi
    fi
    local bj="null"
    [[ -n "$branch" ]] && bj="\"$(_json_escape "$branch")\""
    printf '{"name":"%s","status":"%s","mode":"%s","origin":"%s","work_dir":"%s","goal":%s,"goal_set_epoch":%s,"branch":%s,"last_active_epoch":%s,"needs_attention":%s,"attention":%s,"attention_rank":%s,"agents":[' \
        "$(_json_escape "$name")" "$status" "$(_json_escape "$mode")" "$(_json_escape "$origin")" \
        "$(_json_escape "$workdir")" "$gj" "$gse" "$bj" "$(_session_active_epoch "$sess_dir")" "$na" "$at" "$(_attn_rank "$attn")"
    local _afirst=true mk mv ref sid alive st rs
    while IFS='=' read -r mk mv; do
        [[ "$mk" == agent.* ]] || continue
        IFS=$'\t' read -r ref sid < <(_parse_agent_entry "$mv")
        [[ -n "$ref" ]] || continue
        $_afirst || printf ','
        _afirst=false
        # alive = the agent process is actually running. A pane that dropped to
        # a bare shell (marker '!') is present but the agent is dead, so it is
        # NOT alive; a missing pane (unset) is not alive either. Only a pane
        # running a non-shell foreground command (empty marker) counts.
        alive="false"
        [[ -n "${_alive[$ref]+x}" && -z "${_alive[$ref]}" ]] && alive="true"
        st="null"
        [[ -n "${_state[$ref]:-}" ]] && st="\"$(_json_escape "${_state[$ref]}")\""
        rs="null"
        [[ -n "${_areason[$ref]:-}" ]] && rs="\"$(_json_escape "${_areason[$ref]}")\""
        printf '{"ref":"%s","alias":"%s","name":"%s","session_id":"%s","alive":%s,"state":%s,"reason":%s}' \
            "$(_json_escape "$ref")" "$(_json_escape "${ref%%:*}")" "$(_json_escape "${ref#*:}")" \
            "$(_json_escape "$sid")" "$alive" "$st" "$rs"
    done <<<"$blob"
    printf ']}'
}

# shellcheck disable=SC2059 # format strings stored in variables intentionally
cmd_list() {
    # Default view = running only. Stopped sessions (often the bulk of the list)
    # are noise for day-to-day monitoring; gate them behind --all/--stopped.
    local show_running=true show_stopped=false only_needs_me=false only_active=false as_json=false
    # "Recently active" window for --active (seconds). Override with the env var.
    local active_window="${AE_LIST_ACTIVE_SECS:-300}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)
                show_running=true
                show_stopped=true
                ;;
            --stopped)
                show_running=false
                show_stopped=true
                ;;
            --running)
                show_running=true
                show_stopped=false
                ;;
            --needs-attn | --needs-me | --needs | --attn) only_needs_me=true ;;
            --active | --busy) only_active=true ;;
            --json) as_json=true ;;
            -h | --help)
                cat >&2 <<'LISTHELP'
Usage: ae list [--running | --all | --stopped | --needs-attn | --active] [--json]
  (default)    running sessions only
  --running    running sessions only (explicit)
  --all        running sessions, then stopped ones
  --stopped    stopped sessions only
  --needs-attn only running sessions with an attn reason — declared
               waiting-user/blocked, watchdog-derived dead/stale/throttled, or an
               unanswered inter-agent ask/review (older than AE_ATTN_REQUEST_SECS,
               default 30m); implies running-only
               (aliases: --needs-me, --needs, --attn)
  --active     only running sessions with recent activity (an ae event in the
               last 5 min; set AE_LIST_ACTIVE_SECS to change). Implies
               running-only (alias: --busy)
  --json       machine-readable digest (schema_version, per-session
               needs_attention + attention reason, per-agent state); honours
               the filters above. Pure bash output — no jq required.
LISTHELP
                return 0
                ;;
            *)
                echo "Error: unknown flag '$1' (see: ae list --help)" >&2
                return 1
                ;;
        esac
        shift
    done
    # --needs-me / --active are about live sessions; a stopped session can't
    # need attention or be active. Force running-only so combining them with
    # --all / --stopped doesn't leak unfiltered stopped rows.
    if $only_needs_me || $only_active; then
        show_running=true
        show_stopped=false
    fi
    local _now
    _now="$(date +%s 2>/dev/null || echo 0)"

    # Column widths: SESSION(24) STATUS(8) MODE(10) ORIGIN(rest)
    local hdr='%-24s  %-8s  %-10s  %s\n'
    local indent='%-24s  %-8s  %-10s  %s\n' # same widths for target indent
    local header_printed=false

    # --json: a single digest object. schema_version lets consumers (a future
    # monitoring agent) gate on shape; generated_at stamps the snapshot.
    local json_first=true
    if $as_json; then
        printf '{"schema_version":1,"generated_at":"%s","sessions":[' "$(date -u +%FT%TZ)"
    fi

    # A listing must never abort mid-output. Per-session helpers below can
    # return non-zero on a session's transient state (e.g. `_agent_alert_reason`
    # when the newest scanned event only targets the agent) — and under `set -e`
    # a bare call or a `x="$(helper)"` assignment then kills the WHOLE command.
    # For `--json` that emits INVALID JSON (no closing `]}`, exit 1) and breaks
    # consumers (aemonitor); for the human table it silently drops rows. Degrade
    # a single session's fields instead. Restored before the JSON close below.
    set +e

    if $show_running; then
        local sessions
        sessions="$(list_ae_sessions)"
        while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            local sess_dir
            sess_dir="$(_resolve_session_dir "$name")"
            local meta_blob=""
            [[ -n "$sess_dir" && -f "${sess_dir}/meta" ]] && meta_blob="$(<"${sess_dir}/meta")"
            local origin mode workdir
            origin="$(tmux show-environment -t "$name" AE_ORIGIN 2>/dev/null | sed 's/^AE_ORIGIN=//' || true)"
            [[ -z "$origin" ]] && origin="$(echo "$meta_blob" | sed -n 's/^origin=//p')"
            origin="${origin:-?}"
            mode="$(tmux show-environment -t "$name" AE_MODE 2>/dev/null | sed 's/^AE_MODE=//' || true)"
            [[ -z "$mode" ]] && mode="$(echo "$meta_blob" | sed -n 's/^mode=//p')"
            mode="${mode:-?}"
            workdir="$(tmux show-environment -t "$name" AE_DIR 2>/dev/null | sed 's/^AE_DIR=//' || true)"
            [[ -z "$workdir" ]] && workdir="$(echo "$meta_blob" | sed -n 's/^work_dir=//p')"
            # Per-agent declared states (single events.jsonl scan).
            declare -A _state=()
            while IFS=$'\t' read -r sa sv; do
                [[ -n "$sa" ]] || continue
                _state["$sa"]="$sv"
            done < <(_session_states "$sess_dir")
            # Build alive map from tmux panes (one tmux call) for the agent-row
            # display markers below. (The attention rollup builds its own maps.)
            declare -A _alive=()
            while IFS=$'\t' read -r ae_agent pane_cmd; do
                [[ -n "$ae_agent" ]] || continue
                case "$pane_cmd" in
                    bash | fish | zsh | sh | dash) _alive["$ae_agent"]="!" ;;
                    *) _alive["$ae_agent"]="" ;;
                esac
            done < <(tmux list-panes -s -t "$name" -F '#{@ae_agent}	#{pane_current_command}' 2>/dev/null)
            # Derived needs_attention rollup via the shared single-source
            # _session_attn_rollup (also used by `ae next` — same semantics, no
            # divergence). Called in THIS shell (not a subshell) so it fills the
            # _areason map --json reads from this scope via dynamic scope.
            declare -A _areason=()
            _session_attn_rollup "$name" "$sess_dir" "$meta_blob"
            local attn="$_AE_ATTN_REASON"
            # --needs-me: skip sessions with no attention signal.
            if $only_needs_me && [[ -z "$attn" ]]; then
                unset _state _alive _areason
                continue
            fi
            # --active: skip sessions with no recent activity. "Recent" = an ae
            # event (message/state/nudge/spawn/…) within active_window. Note this
            # tracks ae-event recency, not raw pane churn — a silently-working
            # agent that emits no events won't count until it uses a helper.
            if $only_active; then
                local _sae
                _sae="$(_session_active_epoch "$sess_dir")"
                if ((_now <= 0 || _sae <= 0 || _now - _sae >= active_window)); then
                    unset _state _alive _areason
                    continue
                fi
            fi
            local sess_branch
            sess_branch="$(_session_branch "$name" "$workdir" running)"
            if $as_json; then
                _list_session_json "running" "$name" "$mode" "$origin" "$workdir" \
                    "$sess_dir" "$attn" "$meta_blob" "$sess_branch"
                unset _alive _state _areason
                continue
            fi
            if ! $header_printed; then
                printf "$hdr" "SESSION" "STATUS" "MODE" "ORIGIN"
                header_printed=true
            fi
            printf "$hdr" "$name" "running" "$mode" "$origin"
            [[ "$mode" != "local" && -n "$workdir" ]] && printf "$indent" "" "" "" "  -> $workdir"
            _print_session_meta_line "$meta_blob" "$sess_dir" "$attn" "$sess_branch"
            while IFS='=' read -r mk mv; do
                [[ "$mk" == agent.* ]] || continue
                local aname asid
                IFS=$'\t' read -r aname asid < <(_parse_agent_entry "$mv")
                local marker="${_alive[$aname]:-}"
                printf "  %-22s  %-8s  %-12s  %s\n" "$aname" "$asid" "${_state[$aname]:--}" "$marker"
            done <<<"$meta_blob"
            unset _alive _state _areason
        done <<<"$sessions"
    fi

    if $show_stopped; then
        while IFS= read -r name; do
            local sess_dir
            sess_dir="$(_resolve_session_dir "$name")"
            local meta_blob=""
            [[ -n "$sess_dir" && -f "${sess_dir}/meta" ]] && meta_blob="$(<"${sess_dir}/meta")"
            local mode origin workdir
            mode="$(echo "$meta_blob" | sed -n 's/^mode=//p')"
            mode="${mode:-?}"
            origin="$(echo "$meta_blob" | sed -n 's/^origin=//p')"
            origin="${origin:--}"
            workdir="$(echo "$meta_blob" | sed -n 's/^work_dir=//p')"
            if $as_json; then
                # Stopped: no live state/attn. Declare EMPTY maps so the agent
                # lookups in _list_session_json resolve associatively — under
                # `set -u` a subscript on an UNDECLARED array is treated as an
                # arithmetic index and aborts on a non-numeric agent ref.
                declare -A _alive=() _state=() _areason=()
                _list_session_json "stopped" "$name" "$mode" "$origin" "$workdir" \
                    "$sess_dir" "" "$meta_blob" "$(_session_branch "$name" "$workdir" stopped)"
                unset _alive _state _areason
                continue
            fi
            if ! $header_printed; then
                printf "$hdr" "SESSION" "STATUS" "MODE" "ORIGIN"
                header_printed=true
            fi
            printf "$hdr" "$name" "stopped" "$mode" "$origin"
            [[ "$mode" != "local" && -n "$workdir" ]] && printf "$indent" "" "" "" "  -> $workdir"
            _print_session_meta_line "$meta_blob" "$sess_dir" "" "$(_session_branch "$name" "$workdir" stopped)"
            while IFS='=' read -r mk mv; do
                [[ "$mk" == agent.* ]] || continue
                local aname asid
                IFS=$'\t' read -r aname asid < <(_parse_agent_entry "$mv")
                printf "  %-22s  %s\n" "$aname" "$asid"
            done <<<"$meta_blob"
        done < <(iter_stopped_sessions)
    fi

    set -e # restore errexit for the JSON close / human fallback below

    if $as_json; then
        printf ']}\n'
        return 0
    fi

    if ! $header_printed; then
        if $only_needs_me; then
            echo "No running sessions need your attention."
        elif $only_active; then
            echo "No recently active sessions."
        elif $show_running && $show_stopped; then
            echo "No ae sessions."
        elif $show_running; then
            echo "No running ae sessions. (try: ae list --all)"
        else
            echo "No stopped ae sessions."
        fi
    fi
}

cmd_status() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae status [session-name]" >&2
            echo "(Run inside an ae tmux session to check status without specifying the name.)" >&2
            return 1
        }
    fi
    if ! tmux has-session -t "$target" 2>/dev/null; then
        if [[ -d "${SESSIONS_DIR}/${target}" ]]; then
            echo "Session '$target' is stopped."
            return 0
        fi
        echo "Session '$target' not found." >&2
        return 1
    fi
    local found=false
    while IFS=$'\t' read -r pane_id ae_agent; do
        [[ -n "$ae_agent" ]] || continue
        found=true
        echo "── ${ae_agent} (${pane_id}) ──"
        tmux capture-pane -t "$pane_id" -p 2>/dev/null | grep -v '^$' | tail -15
        echo ""
    done < <(tmux list-panes -s -t "$target" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)
    if [[ "$found" == false ]]; then
        echo "No agent panes in session '$target'."
    fi
}

# Kill a legacy heartbeat process for a session (best-effort, never fails).
kill_heartbeat() {
    local session_name="$1"
    local meta="${SESSIONS_DIR}/${session_name}/meta"
    [[ -f "$meta" ]] || return 0
    local hb_pid
    hb_pid="$(grep '^heartbeat_pid=' "$meta" | cut -d= -f2- || true)"
    [[ -n "$hb_pid" ]] || return 0
    # Validate PID still belongs to our heartbeat before killing
    if kill -0 "$hb_pid" 2>/dev/null; then
        local cmdline
        cmdline="$(tr '\0' ' ' </proc/"$hb_pid"/cmdline 2>/dev/null || true)"
        if [[ "$cmdline" == *heartbeat* ]]; then
            kill "$hb_pid" 2>/dev/null || true
        fi
    fi
}

cmd_stop() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae stop [session-name]" >&2
            echo "       ae stop all" >&2
            echo "(Run inside an ae tmux session to stop it without specifying the name.)" >&2
            return 1
        }
    fi
    if [[ "$target" == "all" ]]; then
        local found=false
        local sessions
        sessions="$(list_ae_sessions)"
        if [[ -n "$sessions" ]]; then
            while IFS= read -r s; do
                [[ -z "$s" ]] && continue
                found=true
                kill_heartbeat "$s"
                tmux kill-session -t "$s" 2>/dev/null || true
                echo "Stopped $s"
            done <<<"$sessions"
        fi
        if [[ "$found" == false ]]; then
            echo "No running ae sessions."
        fi
    else
        if tmux has-session -t "$target" 2>/dev/null; then
            kill_heartbeat "$target"
            tmux kill-session -t "$target"
            echo "Stopped $target"
        else
            echo "Session '$target' is not running." >&2
            return 1
        fi
    fi
}

# Classify an `ae end` target BEFORE any destructive prompt. Echoes:
#   live      — a running tmux session
#   stopped   — no tmux session, but a session dir exists (SESSIONS_DIR/<name>)
#   worktree  — no tmux session, no session dir, but a worktree dir exists
#   (empty)   — not found: the caller MUST error out without prompting
# 'all' is handled by the caller and never passed here. A name containing '/' can
# never be a valid session/worktree basename (path-traversal guard, preserved from the
# original elif conditions), so it classifies as not-found.
# The tmux server a target session lives on (its own meta `tmux_server`), or empty for
# the ambient/default server. The `ae end` path must target the session's OWN server:
# `_ae_session_id` lists the AMBIENT server, so a plain-shell `ae end X` for an X live on
# a NAMED server misses it, misclassifies X as stopped, deletes its state, and leaves X
# running (orphaned). The doctor orphan check already reads per-session tmux_server; the
# end path must too. (The prefix-match class's other axis: wrong SERVER, not just a name
# prefix — sweep every consumer of the target name on the end path.)
_end_target_server() {
    read_session_meta "$1" tmux_server 2>/dev/null
    return 0
}

# Exact live-session id for a target on ITS OWN server. Server-correct variant of
# _ae_session_id for the end path; empty when the target is not live there.
_end_live_id() {
    local target="$1" srv
    srv="$(_end_target_server "$target")"
    if [[ -n "$srv" ]]; then
        command tmux -L "$srv" list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id "$target"
    else
        _ae_session_id "$target"
    fi
    return 0
}

_end_target_class() {
    local target="$1"
    # Reject empty and path components BEFORE any filesystem or tmux lookup. Empty would
    # match `${SESSIONS_DIR}/` (a real dir); '.' and '..' resolve to SESSIONS_DIR itself
    # and its parent (`ae end ..` prompted on `sessions/../`); any '/' is traversal.
    # None can be a valid session basename. (B2)
    case "$target" in
        "" | . | .. | */*) return 0 ;;
    esac
    # Exact live match (B1): `tmux has-session -t proj` PREFIX-MATCHES a live `project`,
    # so `ae end proj` would classify as live and downstream could kill `project`.
    # Resolve the EXACT session id instead — a mere prefix of a live session does not
    # resolve, so it correctly falls through to the on-disk checks (or not-found).
    if [[ -n "$(_end_live_id "$target")" ]]; then
        printf 'live'
        return 0
    fi
    if [[ -d "${SESSIONS_DIR}/${target}" ]]; then
        printf 'stopped'
        return 0
    fi
    if [[ -d "${WORKTREES_DIR}/${target}" ]]; then
        printf 'worktree'
        return 0
    fi
    return 0
}

# Will `ae end <target>` actually commit + push? Mirrors end_session's decision so the
# prompt cannot over-promise: local mode never pushes; git/full pushes only when a real
# git worktree is present. Echoes 'yes' or nothing.
_end_will_push() {
    local target="$1" mode="" wdir _sid _srv
    _srv="$(_end_target_server "$target")"
    _sid="$(_end_live_id "$target")"
    if [[ -n "$_sid" ]]; then
        local -a _wp_t=(tmux)
        [[ -n "$_srv" ]] && _wp_t=(command tmux -L "$_srv")
        mode="$("${_wp_t[@]}" show-environment -t "$_sid" AE_MODE 2>/dev/null | sed 's/^AE_MODE=//' || true)"
    fi
    [[ -z "$mode" ]] && mode="$(read_session_meta "$target" mode 2>/dev/null)"
    [[ "$mode" == "local" ]] && return 0
    wdir="$(resolve_session_workdir "$target")"
    if [[ -d "$wdir" ]] && git -C "$wdir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'yes'
    fi
    return 0
}

# Truthful confirm body for `ae end` — pure (no read, no side effects), so it is
# unit-tested directly. Prints only what the end will actually DO for this target
# class. The old prompt claimed "Commits + pushes to ae/<name> branch" for every
# target, which is false for a local session (the default) and for a stopped/orphan
# with nothing to push.
#   $1 target  $2 class(live|stopped|worktree|all)  $3 will_push(yes|"")  $4 purge(true|false|"")
_end_confirm_body() {
    local target="$1" class="$2" will_push="$3" purge="$4"
    case "$class" in
        all)
            printf "End ALL ae sessions?\n"
            printf "  - Ends every running and stopped session (git/full ones commit any work, then push any unpushed commits).\n"
            ;;
        stopped) printf "End stopped session '%s'?\n" "$target" ;;
        worktree) printf "Remove leftover worktree '%s'?\n" "$target" ;;
        *) printf "End session '%s'?\n" "$target" ;;
    esac
    if [[ "$class" != all ]]; then
        # Only claim a push when one will happen, and name the SANITIZED branch (the raw
        # target is not always a valid branch ref). end_session commits any uncommitted
        # work first, then pushes if there are unpushed commits.
        if [[ "$will_push" == "yes" ]]; then
            # sanitize_branch_name already returns 'ae/<name>' — do NOT re-prefix 'ae/'
            # (that printed 'ae/ae/<name>').
            printf "  - Commits any uncommitted work, then pushes any unpushed commits to the %s branch.\n" "$(sanitize_branch_name "$target")"
        fi
        printf "  - Removes ae state at ~/.ae/sessions/%s/.\n" "$target"
    fi
    # Purge disclosure applies to EVERY class, `all` included: `ae end --purge-history all`
    # must say it deletes conversation files — the old `all` early-return hid this (B3).
    if [[ "$purge" == true ]]; then
        printf "  - DELETES claude/codex conversation files (--purge-history).\n"
    elif [[ "$purge" == false ]]; then
        printf "  - KEEPS claude/codex conversation files (--keep-history).\n"
    else
        printf "  - KEEPS conversation files unless a session's own [workspace]\n"
        printf "    purge_agent_history is set (kept = token/usage history).\n"
    fi
    printf "  (Use 'ae stop' to resume later; it also preserves history.)\n"
    return 0
}

cmd_end() {
    local target="" force=false purge_cli="" a
    for a in "$@"; do
        case "$a" in
            -f | --force) force=true ;;
            --purge-history) purge_cli=true ;;
            --keep-history) purge_cli=false ;;
            --*)
                echo "Error: unknown flag '$a'. Use -f, --purge-history, --keep-history." >&2
                return 1
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$a"
                else
                    # Destructive command — never silently drop a stray arg.
                    echo "Error: unexpected extra argument '$a' — ae end takes one session name (or 'all')." >&2
                    return 1
                fi
                ;;
        esac
    done
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae end [-f] [--purge-history|--keep-history] [session-name|all]" >&2
            echo "(Run inside an ae tmux session to end it without specifying the name.)" >&2
            return 1
        }
    fi
    # A CLI flag overrides globally; otherwise the purge default is resolved
    # PER-SESSION (from each session's OWN config) in cleanup_session — so ending a
    # session from an unrelated cwd, or `ae end all`, honors each session's policy,
    # not the caller's. Empty = no CLI override.
    _AE_PURGE_HISTORY_CLI="$purge_cli"

    # RESOLVE BEFORE PROMPTING. A destructive confirm must never fire on an unresolved
    # target: `ae end <bogus>` used to prompt, read 'y', THEN error "not found". Classify
    # the target up front; a not-found single target errors here, before any prompt.
    local _class=""
    if [[ "$target" != "all" ]]; then
        _class="$(_end_target_class "$target")"
        if [[ -z "$_class" ]]; then
            echo "Session '$target' not found." >&2
            return 1
        fi
    fi

    if [[ "$force" != true ]]; then
        local _will_push=""
        [[ "$target" != "all" ]] && _will_push="$(_end_will_push "$target")"
        _end_confirm_body "$target" "${_class:-all}" "$_will_push" "$purge_cli"
        printf "Continue? [y/N] "
        read -r -n 1 reply
        echo
        if [[ ! "$reply" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            return 0
        fi
    fi
    if [[ "$target" == "all" ]]; then
        local found=false failures=0
        local sessions
        sessions="$(list_ae_sessions)"
        if [[ -n "$sessions" ]]; then
            while IFS= read -r s; do
                [[ -z "$s" ]] && continue
                found=true
                end_session "$s" || failures=$((failures + 1))
            done <<<"$sessions"
        fi
        while IFS= read -r name; do
            found=true
            end_session "$name" || failures=$((failures + 1))
        done < <(iter_stopped_sessions)
        if [[ "$found" == false ]]; then
            echo "No ae sessions."
        elif ((failures > 0)); then
            echo "${failures} session(s) failed to end. See errors above." >&2
            return 1
        fi
    else
        # Target already classified (live|stopped|worktree) — all three end the same way.
        end_session "$target" || return 1
    fi
}

doctor_extract_exec() {
    local raw="$1"
    local -a parts=()
    read -r -a parts <<<"$raw"
    local part
    for part in "${parts[@]}"; do
        case "$part" in
            env) continue ;;
            *=*) continue ;;
            *)
                printf '%s' "$part"
                return 0
                ;;
        esac
    done
    return 1
}

doctor_report() {
    local level="$1" label="$2" detail="$3"
    printf "%-5s %-14s %s\n" "$level" "$label" "$detail"
    case "$level" in
        FAIL) DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)) ;;
        WARN) DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
    esac
}

check_deps() {
    if [[ -z "${BASH_VERSINFO[0]:-}" ]] || ((BASH_VERSINFO[0] < 4)); then
        echo "Error: ae requires bash >= 4.0 (found ${BASH_VERSION:-unknown})." >&2
        echo "macOS: brew install bash" >&2
        return 1
    fi
    if ! command -v tmux >/dev/null 2>&1; then
        echo "Error: tmux not found in PATH. Install tmux or run 'ae doctor' for details." >&2
        return 1
    fi
}

sync_existing_session_assets() {
    local session_name="$1"
    local meta="${SESSIONS_DIR}/${session_name}/meta"
    if [[ ! -f "$meta" ]]; then
        meta="${WORKTREES_DIR}/${session_name}/.ae/${session_name}/meta"
    fi
    if [[ ! -f "$meta" ]]; then
        echo "session '${session_name}' not found" >&2
        return 1
    fi

    local meta_dir work_dir origin mode main_pane config_file
    meta_dir="$(dirname "$meta")"
    work_dir="$(read_session_meta "$session_name" work_dir)"
    origin="$(read_session_meta "$session_name" origin)"
    mode="$(read_session_meta "$session_name" mode)"
    main_pane="$(read_session_meta "$session_name" main_pane)"
    config_file="$(read_session_meta "$session_name" config)"

    [[ -n "$work_dir" ]] || work_dir="$origin"
    [[ -n "$origin" ]] || origin="$work_dir"
    [[ -n "$mode" ]] || mode="local"

    sync_session_assets "$session_name" "$meta_dir" "$work_dir" "$origin" "$mode" "$main_pane" "$config_file"

    # Keep the status-left location in sync for an already-running session — refresh
    # only regenerates on-disk assets, but a watchdog restart drops session/mode/
    # location from status-right, so the left half must carry it. No-op if the
    # session isn't running. Targets the session's own tmux server (from meta).
    local server
    server="$(read_session_meta "$session_name" tmux_server)"
    _ae_apply_status_bar "$session_name" "$mode" "$origin" "$work_dir" "$server"

    # Cycle a RUNNING watchdog so refreshed helper code actually goes live. The
    # running watchdog keeps its already-loaded body until restarted (refresh only
    # rewrites the on-disk script), so a stop→start makes it re-source the fresh
    # helper. Invoke the SESSION's own generated helper by path. Non-fatal: a failed
    # restart must not fail the refresh, and every probe is guarded (set -e).
    #
    # Liveness gate (BLOCKER): 'watchdog status' trusts .watchdog.pid + kill -0,
    # which a STOPPED session's stale pidfile satisfies if that PID was recycled by
    # an unrelated live process — a stop would then kill that innocent process. So
    # require genuine liveness FIRST: the tmux session exists on its own server
    # (exact match via list-sessions|grep -Fxq, not has-session which prefix-matches)
    # AND a pane still carries @ae_agent=_watchdog. Only then trust the status text.
    local wd_helper="${meta_dir}/watchdog"
    local _wt=(tmux)
    [[ -n "$server" ]] && _wt=(command tmux -L "$server")
    local sess_live="" wd_pane_live=""
    if "${_wt[@]}" list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- "$session_name"; then
        sess_live="yes"
    fi
    if [[ "$sess_live" == "yes" ]] &&
        "${_wt[@]}" list-panes -s -t "$session_name" -F '#{@ae_agent}' 2>/dev/null | grep -Fxq -- "_watchdog"; then
        wd_pane_live="yes"
    fi
    if [[ -x "$wd_helper" && "$wd_pane_live" == "yes" ]]; then
        local wd_status
        wd_status="$("$wd_helper" status 2>/dev/null || true)"
        if [[ "$wd_status" == *"is running"* ]]; then
            "$wd_helper" stop >/dev/null 2>&1 || true
            sleep 0.3 # brief settle so the pane is gone before the fresh start
            "$wd_helper" start >/dev/null 2>&1 || true
            # Verify it actually came back up before claiming success (IMPORTANT):
            # 'stop' flips meta watchdog=false, so a failed 'start' would leave the
            # watchdog persistently disabled. Poll, then either announce success or
            # re-record watchdog=true so the next resume revives it — never echo
            # success unconditionally.
            local wd_up="" _i=0
            while ((_i < 5)); do
                if [[ "$("$wd_helper" status 2>/dev/null || true)" == *"is running"* ]]; then
                    wd_up="yes"
                    break
                fi
                sleep 0.5
                _i=$((_i + 1))
            done
            if [[ "$wd_up" == "yes" ]]; then
                echo "restarted watchdog for ${session_name}"
            else
                set_session_meta_value "${meta_dir}/meta" "watchdog" "true" || true
                echo "Warning: watchdog restart failed for ${session_name} — re-enable recorded; it will start on next resume"
            fi
        fi
    fi
}

# Try to capture a pending session ID from on-disk agent session files (no live pane needed).
# Uses the same find_*_session_by_* helpers as start_capture_session_id, but skips the
# pane-polling and TUI-scrape methods so it can run from doctor without an attached agent.
# Exit codes:
#   0 = won the race; captured ID printed to stdout
#   2 = found a session file but lost the race to another recoverer
#   1 = no matching session file found (real miss) or other error
doctor_try_capture_session_id() {
    local tool_kind="$1" slot="$2" meta_dir="$3"
    local captured="" launch_time launch_id work_dir
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    case "$tool_kind" in
        codex)
            if [[ -n "$launch_id" ]]; then
                captured="$(find_codex_session_by_launch_id "$launch_id" "$launch_time" 2>/dev/null || true)"
            fi
            if [[ -z "$captured" && -n "$work_dir" ]]; then
                captured="$(find_codex_session_by_cwd "$work_dir" "$launch_time" 2>/dev/null || true)"
            fi
            ;;
        gemini)
            if [[ -n "$work_dir" && -n "$launch_id" ]]; then
                captured="$(find_gemini_session_by_launch_id "$work_dir" "$launch_id" "$launch_time" 2>/dev/null || true)"
            fi
            ;;
        opencode)
            if [[ -n "$launch_id" ]]; then
                captured="$(find_opencode_session_by_launch_id "$launch_id" "$launch_time" 2>/dev/null || true)"
            fi
            ;;
    esac
    [[ -n "$captured" ]] || return 1
    # Check-then-set under flock: only update + report success if the slot is
    # still pending. Prevents duplicate "ok" reports if two recoverers race.
    local rc
    set +e
    (
        flock -w 5 200 || exit 1
        local escaped_slot="${slot//./\\.}"
        local current_line current_id
        current_line="$(grep "^agent\.${escaped_slot}=" "$meta_dir/meta" 2>/dev/null || true)"
        current_id="${current_line##*:}"
        if [[ "$current_id" != "pending" ]]; then
            exit 2
        fi
        sed -i "s/^agent\.${escaped_slot}=\([^:]*:[^:]*:\).*/agent.${slot}=\1${captured}/" "$meta_dir/meta"
        exit 0
    ) 200>"$meta_dir/meta.lock"
    rc=$?
    set -e
    case "$rc" in
        0)
            printf '%s' "$captured"
            return 0
            ;;
        2) return 2 ;;
        *) return 1 ;;
    esac
}

# Walk a session's meta and try to recover any pending agent session IDs.
# Iterate a session's meta and try to recover pending session IDs.
# Calls report_fn for each entry: report_fn <kind> <slot> <agent_label> <tool_kind> <captured_or_empty>
# kind is one of: ok | already | miss | skip
# Used by both doctor (with reporting) and the watchdog (with quiet/event-based output).
walk_pending_session_ids() {
    local session_name="$1" report_fn="$2"
    local meta_dir="${SESSIONS_DIR}/${session_name}"
    [[ -f "${meta_dir}/meta" ]] || return 0

    local key val slot stored_alias rest stored_id agent_label cmd tool_kind captured rc
    while IFS='=' read -r key val; do
        [[ "$key" == agent.* ]] || continue
        slot="${key#agent.}"
        # Format: alias:name:session_id (or alias:name for very old sessions)
        stored_alias="${val%%:*}"
        rest="${val#*:}"
        stored_id=""
        if [[ "$rest" == *:* ]]; then
            stored_id="${rest##*:}"
        fi
        [[ "$stored_id" == "pending" ]] || continue
        agent_label="${val%:*}"
        cmd="$(get_config "agents.${stored_alias}")"
        if [[ -z "$cmd" ]]; then
            "$report_fn" "skip" "$slot" "$agent_label" "" ""
            continue
        fi
        tool_kind="$(tool_kind_from_cmd "$cmd")"
        case "$tool_kind" in
            codex | gemini | opencode) ;;
            *)
                # claude shouldn't be pending; nothing else to recover
                continue
                ;;
        esac
        rc=0
        captured="$(doctor_try_capture_session_id "$tool_kind" "$slot" "$meta_dir")" || rc=$?
        case "$rc" in
            0)
                if [[ -n "$captured" ]]; then
                    "$report_fn" "ok" "$slot" "$agent_label" "$tool_kind" "$captured"
                else
                    "$report_fn" "miss" "$slot" "$agent_label" "$tool_kind" ""
                fi
                ;;
            2)
                "$report_fn" "already" "$slot" "$agent_label" "$tool_kind" ""
                ;;
            *)
                "$report_fn" "miss" "$slot" "$agent_label" "$tool_kind" ""
                ;;
        esac
    done <"${meta_dir}/meta"
}

# doctor reporter — emits doctor_report lines for each entry
_doctor_recover_report() {
    local kind="$1" slot="$2" agent_label="$3" tool_kind="$4" captured="$5"
    case "$kind" in
        ok)
            doctor_report "OK" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "captured ${tool_kind} session id ${captured:0:8}"
            ;;
        already)
            doctor_report "OK" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "already captured by another recoverer"
            ;;
        miss)
            doctor_report "WARN" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "no matching ${tool_kind} session file found (will retry on next launch)"
            ;;
        skip)
            doctor_report "WARN" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "no command configured for this agent alias"
            ;;
    esac
}

doctor_recover_pending_sessions() {
    RECOVER_SESSION_NAME="$1"
    # Hydrate config + origin from session meta (same reason as cmd_recover_pending)
    local stored_config stored_origin
    stored_config="$(read_session_meta "$1" config)"
    stored_origin="$(read_session_meta "$1" origin)"
    local prev_config="$CONFIG_FILE" prev_local="${AE_LOCAL_CONFIG:-}"
    if [[ -n "$stored_config" && -f "$stored_config" ]]; then
        CONFIG_FILE="$stored_config"
    fi
    AE_LOCAL_CONFIG=""
    if [[ -n "$stored_origin" && -f "${stored_origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${stored_origin}/.ae/config"
    fi
    walk_pending_session_ids "$1" _doctor_recover_report
    CONFIG_FILE="$prev_config"
    AE_LOCAL_CONFIG="$prev_local"
}

# watchdog reporter — TSV output: <kind>\t<slot>\t<agent_label>\t<tool_kind>\t<captured>
# Called by the watchdog helper via 'ae _recover-pending <session>'.
_watchdog_recover_report() {
    local kind="$1" slot="$2" agent_label="$3" tool_kind="$4" captured="$5"
    printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$slot" "$agent_label" "$tool_kind" "$captured"
}

# Internal: recover pending session IDs for a session and emit TSV results.
# Used by the watchdog to keep meta up to date over time. Output format:
#   ok\t<slot>\t<agent_label>\t<tool_kind>\t<captured_id>     # we won the race
#   already\t<slot>\t<agent_label>\t<tool_kind>\t             # another recoverer claimed it
#   miss\t<slot>\t<agent_label>\t<tool_kind>\t                # no matching session file found
#   skip\t<slot>\t<agent_label>\t\t                            # alias not configured
# The watchdog ignores non-ok rows; doctor reports each kind distinctly.
cmd_recover_pending() {
    local session_name="${1:-}"
    if [[ -z "$session_name" ]]; then
        echo "Usage: ae _recover-pending <session-name>" >&2
        return 1
    fi
    # Hydrate config + origin from session meta so get_config resolves the
    # same agent aliases that created the session, regardless of caller CWD.
    local stored_config stored_origin
    stored_config="$(read_session_meta "$session_name" config)"
    stored_origin="$(read_session_meta "$session_name" origin)"
    if [[ -n "$stored_config" && -f "$stored_config" ]]; then
        CONFIG_FILE="$stored_config"
    fi
    AE_LOCAL_CONFIG=""
    if [[ -n "$stored_origin" && -f "${stored_origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${stored_origin}/.ae/config"
    fi
    walk_pending_session_ids "$session_name" _watchdog_recover_report
}

doctor_refresh_sessions() {
    local target="${1:-all}"
    local refreshed=0

    if [[ "$target" == "all" ]]; then
        local meta session_name
        declare -A seen_sessions=()
        for meta in "${SESSIONS_DIR}"/*/meta; do
            [[ -f "$meta" ]] || continue
            session_name="$(basename "$(dirname "$meta")")"
            seen_sessions["$session_name"]=1
            if sync_existing_session_assets "$session_name"; then
                doctor_report "OK" "refresh:${session_name}" "refreshed session helpers and workspace"
                doctor_recover_pending_sessions "$session_name"
            else
                doctor_report "FAIL" "refresh:${session_name}" "failed to refresh session assets"
            fi
            refreshed=1
        done
        for meta in "${WORKTREES_DIR}"/*/.ae/*/meta; do
            [[ -f "$meta" ]] || continue
            session_name="$(basename "$(dirname "$meta")")"
            [[ -n "${seen_sessions[$session_name]:-}" ]] && continue
            if sync_existing_session_assets "$session_name"; then
                doctor_report "OK" "refresh:${session_name}" "refreshed session helpers and workspace"
                doctor_recover_pending_sessions "$session_name"
            else
                doctor_report "FAIL" "refresh:${session_name}" "failed to refresh session assets"
            fi
            refreshed=1
        done
        if ((refreshed == 0)); then
            doctor_report "WARN" "refresh" "no existing sessions found in ${SESSIONS_DIR}"
        fi
        return 0
    fi

    if sync_existing_session_assets "$target"; then
        doctor_report "OK" "refresh:${target}" "refreshed session helpers and workspace"
        doctor_recover_pending_sessions "$target"
    else
        doctor_report "FAIL" "refresh:${target}" "failed to refresh session assets"
    fi
}

cmd_doctor() {
    local refresh_target=""
    case "${1:-}" in
        "") ;;
        --refresh)
            refresh_target="${2:-all}"
            if [[ $# -gt 2 ]]; then
                echo "Usage: ae doctor [--refresh [all|<session>]]" >&2
                return 1
            fi
            ;;
        *)
            echo "Usage: ae doctor [--refresh [all|<session>]]" >&2
            return 1
            ;;
    esac

    DOCTOR_FAILURES=0
    DOCTOR_WARNINGS=0

    echo "ae doctor"
    echo ""
    doctor_report "OK" "ae" "version ${AE_VERSION}"

    if [[ -n "${BASH_VERSINFO[0]:-}" ]] && ((BASH_VERSINFO[0] >= 4)); then
        doctor_report "OK" "bash" "version ${BASH_VERSION}"
    else
        doctor_report "FAIL" "bash" "bash >= 4.0 required"
    fi

    if command -v tmux >/dev/null 2>&1; then
        doctor_report "OK" "tmux" "$(tmux -V 2>/dev/null || command -v tmux)"
    else
        doctor_report "FAIL" "tmux" "tmux not found in PATH"
    fi

    if command -v git >/dev/null 2>&1; then
        doctor_report "OK" "git" "$(git --version 2>/dev/null || command -v git)"
    else
        doctor_report "FAIL" "git" "git not found in PATH"
    fi

    if [[ -f "$CONFIG_FILE" ]]; then
        doctor_report "OK" "config" "$CONFIG_FILE"
    else
        doctor_report "FAIL" "config" "missing ${CONFIG_FILE}"
    fi

    case ":$PATH:" in
        *":${HOME}/.local/bin:"*) doctor_report "OK" "PATH" "${HOME}/.local/bin" ;;
        *) doctor_report "WARN" "PATH" "${HOME}/.local/bin not found on PATH" ;;
    esac

    if [[ -n "${AE_LOCAL_CONFIG:-}" ]]; then
        doctor_report "OK" "local-config" "$AE_LOCAL_CONFIG"
    else
        doctor_report "WARN" "local-config" "no project override (.ae/config) in $(pwd)"
    fi

    mkdir -p "$SESSIONS_DIR" "$WORKTREES_DIR"
    doctor_report "OK" "sessions" "$SESSIONS_DIR"
    doctor_report "OK" "worktrees" "$WORKTREES_DIR"

    # Orphan check: session dirs / worktrees with no matching RUNNING session. These
    # accumulate when a wind-down DECLARES done but never runs `ae end` — the dir +
    # worktree are left behind, and every --running-scoped sensor (ae list default, the
    # steward's charter) is structurally blind to them (the AIASSIST-115 class:
    # half-dead for days, 17 worktrees vs 6 running). doctor is the one lane that reads
    # on-disk state, so it surfaces the count + names and the human resumes (`ae <name>`)
    # or finishes the teardown (`ae end <name>`). WARN, not FAIL: a deliberately stopped
    # session is legitimately here too, and doctor cannot read intent.
    local _orphan_n=0 _orphan_list="" _oname _osrv
    while IFS= read -r _oname; do
        [[ -z "$_oname" ]] && continue
        # iter_stopped_sessions checks the AMBIENT tmux server. A session created on a
        # NAMED server (tmux_server in its meta) is live but invisible there, so it would
        # be a false orphan. Re-check the candidate against its OWN server (exact match)
        # before counting it. (I1)
        _osrv="$(read_session_meta "$_oname" tmux_server)"
        if [[ -n "$_osrv" ]] && command tmux -L "$_osrv" has-session -t "=${_oname}" 2>/dev/null; then
            continue
        fi
        _orphan_n=$((_orphan_n + 1))
        _orphan_list="${_orphan_list}${_orphan_list:+, }${_oname}"
    done < <(iter_stopped_sessions)
    if ((_orphan_n == 0)); then
        doctor_report "OK" "orphans" "no stopped or orphaned session dirs"
    else
        doctor_report "WARN" "orphans" "${_orphan_n} session dir(s)/worktree(s) with no running session: ${_orphan_list}"
        doctor_report "WARN" "orphans-hint" "resume with 'ae <name>' or finish teardown with 'ae end <name>'"
    fi

    local workspace_main
    workspace_main="$(get_config workspace.main)"
    if [[ -n "$workspace_main" ]]; then
        doctor_report "OK" "workspace.main" "$workspace_main"
    else
        doctor_report "FAIL" "workspace.main" "not set in config"
    fi

    local workers
    workers="$(get_config workspace.workers)"
    if [[ -n "$workers" ]]; then
        doctor_report "OK" "workspace.workers" "$workers"
    else
        doctor_report "WARN" "workspace.workers" "no startup workers configured"
    fi

    declare -A doctor_agents=()
    local entry key value
    while IFS= read -r entry; do
        [[ "$entry" == agents.*=* ]] || continue
        key="${entry#agents.}"
        key="${key%%=*}"
        value="${entry#*=}"
        doctor_agents["$key"]="$value"
    done < <(parse_config)

    if [[ ${#doctor_agents[@]} -eq 0 ]]; then
        doctor_report "FAIL" "agents" "no [agents] entries found"
    else
        local alias
        while IFS= read -r alias; do
            value="${doctor_agents[$alias]}"
            local exec_name
            exec_name="$(doctor_extract_exec "$value" || true)"
            if [[ -z "$exec_name" ]]; then
                doctor_report "FAIL" "agent:${alias}" "could not determine executable from '${value}'"
                continue
            fi
            if command -v "$exec_name" >/dev/null 2>&1; then
                doctor_report "OK" "agent:${alias}" "$exec_name"
            else
                doctor_report "FAIL" "agent:${alias}" "command '${exec_name}' not found"
            fi
        done < <(printf '%s\n' "${!doctor_agents[@]}" | sort)
    fi

    # Telegram bridge — feature-aware. Reports OK/WARN only; FAILs are
    # surfaced when the user actually runs `ae telegram start`. If the user
    # never configured the feature, we skip silently.
    local _tg_enabled _tg_token _tg_chat _tg_present
    _tg_enabled="$(get_config telegram.enabled 2>/dev/null || true)"
    _tg_token="$(get_config telegram.token_file 2>/dev/null || true)"
    _tg_chat="$(get_config telegram.chat_id 2>/dev/null || true)"
    _tg_present="false"
    if [[ -n "$_tg_enabled$_tg_token$_tg_chat" ]]; then
        _tg_present="true"
    fi
    if [[ "$_tg_present" == "true" ]]; then
        local _tg_missing
        _tg_missing="$(_telegram_missing_deps)"
        if [[ -n "$_tg_missing" ]]; then
            doctor_report "WARN" "telegram.deps" "missing:$_tg_missing (needed for ae telegram)"
        else
            doctor_report "OK" "telegram.deps" "jq + curl present"
        fi
        if [[ -n "$_tg_token" ]]; then
            local _tg_err
            if _tg_err="$(_telegram_validate_token_file "$_tg_token" 2>&1)"; then
                doctor_report "OK" "telegram.token" "$(_telegram_expand_path "$_tg_token")"
            else
                doctor_report "WARN" "telegram.token" "$_tg_err"
            fi
        else
            doctor_report "WARN" "telegram.token" "telegram.token_file not set"
        fi
        if [[ -n "$_tg_chat" ]]; then
            doctor_report "OK" "telegram.chat_id" "$_tg_chat"
        else
            doctor_report "WARN" "telegram.chat_id" "telegram.chat_id not set"
        fi
        if [[ "$(_telegram_intent_enabled)" == "true" ]]; then
            if _aewatch_owns_bridge; then
                doctor_report "OK" "telegram.daemon" "enabled; aewatch daemon owns the bridge"
            elif _telegram_daemon_running; then
                doctor_report "OK" "telegram.daemon" "running"
            else
                doctor_report "WARN" "telegram.daemon" "enabled but not running (will autostart on 'ae <name>')"
            fi
        else
            doctor_report "OK" "telegram.intent" "enabled=false (feature off)"
        fi
    fi

    if [[ -n "$refresh_target" ]]; then
        echo ""
        doctor_refresh_sessions "$refresh_target"
    fi

    echo ""
    printf "Summary: %d failure(s), %d warning(s)\n" "$DOCTOR_FAILURES" "$DOCTOR_WARNINGS"
    ((DOCTOR_FAILURES == 0))
}

cmd_watchdog() {
    local subcmd="${1:-}"
    local target="${2:-}"
    if [[ -z "$subcmd" ]]; then
        echo "Usage: ae watchdog <start|stop|status> [session-name]" >&2
        echo "  (If run inside an ae session, session-name is optional.)" >&2
        return 1
    fi
    case "$subcmd" in
        start | stop | status) ;;
        *)
            echo "Usage: ae watchdog <start|stop|status> [session-name]" >&2
            return 1
            ;;
    esac
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Error: no session name given and not inside an ae tmux session" >&2
            return 1
        }
    fi
    local meta_dir="${SESSIONS_DIR}/${target}"
    if [[ ! -d "$meta_dir" ]]; then
        echo "Error: session '${target}' not found" >&2
        return 1
    fi
    # Prefer the canonical 'watchdog' helper; fall back to the legacy 'loop'
    # helper so renamed commands still work on sessions created before the
    # current helpers are refreshed.
    local helper="${meta_dir}/watchdog"
    [[ -x "$helper" ]] || helper="${meta_dir}/loop"
    if [[ ! -x "$helper" ]]; then
        echo "Error: watchdog helper not found in session '${target}'" >&2
        echo "       Run 'ae doctor --refresh ${target}' to regenerate helpers." >&2
        return 1
    fi
    "$helper" "$subcmd"
}

# ── Telegram bridge (machine-global chat daemon) ─────────────────────
#
# Forwards filtered events from every ae session on this machine to a
# Telegram chat, via a single bash daemon running in a background tmux
# session named `ae-telegram`. Hard deps (jq, curl) are required ONLY
# when this feature is in use; core ae commands work without them.
#
# Per-session offset state lives at ~/.ae/telegram/state.tsv with
# (session_id, inode, byte_offset) so restarts don't replay events.
# Token never appears in argv — curl reads its config from stdin.

_TELEGRAM_TMUX_SESSION="ae-telegram"
# Serializes start / stop / autostart(supervise) so an "is it enabled + running?"
# check and the spawn/kill that follows are one atomic critical section. Without
# it, a watchdog supervise tick can re-spawn a daemon the user just `stop`ped.
_TELEGRAM_CONTROL_LOCK="${CONFIG_DIR}/telegram/control.lock"
_telegram_control_lock_file() {
    mkdir -p "${CONFIG_DIR}/telegram" 2>/dev/null || true
    printf '%s' "$_TELEGRAM_CONTROL_LOCK"
}

# Resolve a possibly-tilde-prefixed path against $HOME. Patterns are
# literal-tilde matches, not shell tilde-expansion (which would happen
# at quote-time and miss config-file values like "~/.config/...").
# shellcheck disable=SC2088
_telegram_expand_path() {
    local p="$1"
    case "$p" in
        '~') printf '%s' "$HOME" ;;
        '~/'*) printf '%s/%s' "$HOME" "${p#"~/"}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# True if a value looks like a config-affirmative.
_telegram_truthy() {
    case "${1,,}" in
        1 | true | yes | on) return 0 ;;
        *) return 1 ;;
    esac
}

# Print the configured intent: "true" if [telegram] enabled is truthy.
_telegram_intent_enabled() {
    local v
    v="$(get_config telegram.enabled 2>/dev/null || true)"
    if _telegram_truthy "$v"; then echo "true"; else echo "false"; fi
}

# Same as above but bypasses the get_config CACHE: get_config caches per
# XDG_RUNTIME_DIR, so a watchdog process with a different runtime dir could hold a
# stale enabled=true even after `stop` wrote false. Reuses parse_config so the
# value semantics (inline-comment stripping, quotes, local-override last-wins)
# match get_config exactly — just without the cache. Authoritative for the
# under-lock re-check.
_telegram_intent_enabled_uncached() {
    local entry result=""
    while IFS= read -r entry; do
        [[ "$entry" == "telegram.enabled="* ]] && result="${entry#*=}"
    done < <(parse_config)
    if _telegram_truthy "$result"; then echo "true"; else echo "false"; fi
}

# Idempotent check for daemon presence — uses exact tmux session match
# (list-sessions + grep -Fxq), not has-session which prefix-matches.
_telegram_daemon_running() {
    tmux list-sessions -F '#{session_name}' 2>/dev/null |
        grep -Fxq -- "$_TELEGRAM_TMUX_SESSION"
}

# Check feature deps. Echoes missing names space-separated. Empty == OK.
_telegram_missing_deps() {
    local missing=""
    command -v jq >/dev/null 2>&1 || missing+=" jq"
    command -v curl >/dev/null 2>&1 || missing+=" curl"
    printf '%s' "${missing# }"
}

# Validate token file (path, exists, readable, mode 600, owned by user).
# Echoes error message on failure, returns non-zero. Echoes nothing on success.
_telegram_validate_token_file() {
    local path="$1"
    [[ -n "$path" ]] || {
        echo "no telegram.token_file in config"
        return 1
    }
    local resolved
    resolved="$(_telegram_expand_path "$path")"
    [[ -f "$resolved" ]] || {
        echo "token file not found: $resolved"
        return 1
    }
    [[ -r "$resolved" ]] || {
        echo "token file not readable: $resolved"
        return 1
    }
    local owner mode
    owner="$(stat -c %u "$resolved" 2>/dev/null || echo -1)"
    [[ "$owner" == "${UID:-$(id -u)}" ]] || {
        echo "token file not owned by you: $resolved"
        return 1
    }
    mode="$(stat -c %a "$resolved" 2>/dev/null || echo 000)"
    case "$mode" in
        400 | 600) ;;
        *)
            echo "token file must be chmod 600 (currently $mode): $resolved"
            return 1
            ;;
    esac
    return 0
}

# Write the daemon helper to ~/.ae/telegram-daemon, idempotent.
# Called by cmd_telegram_start and ae doctor --refresh.
_telegram_write_daemon() {
    local dest="$CONFIG_DIR/telegram-daemon"
    mkdir -p "$CONFIG_DIR/telegram"
    cat >"$dest" <<'TELEGRAM_DAEMON_EOF'
#!/usr/bin/env bash
# ae-telegram daemon — auto-generated by `ae telegram start`.
# Tails events.jsonl across every ae session on this machine and
# forwards filtered events to one Telegram chat. Single instance per
# host (lock-guarded). Token is read from a file and passed to curl
# via stdin config so it never appears in process argv.

set -uo pipefail

AE_HOME="${AE_HOME:-$HOME/.ae}"
SESSIONS_DIR="$AE_HOME/sessions"
STATE_DIR="$AE_HOME/telegram"
STATE_FILE="$STATE_DIR/state.tsv"
LOCK_FILE="$STATE_DIR/daemon.lock"
LOG_FILE="$STATE_DIR/daemon.log"
LOG_MAX_BYTES="${AE_TELEGRAM_LOG_MAX_BYTES:-1048576}" # rotate at ~1 MiB
CONFIG_FILE="${CONFIG_FILE:-$AE_HOME/config}"

DISCOVERY_INTERVAL="${AE_TELEGRAM_DISCOVERY_INTERVAL:-2}"
POLL_INTERVAL="${AE_TELEGRAM_POLL_INTERVAL:-1}"

mkdir -p "$STATE_DIR"

# Persist ALL daemon output to a log file. This is stderr+stdout, not just the
# _log lines, so an uncaught crash (e.g. the bash "unbound variable" message
# under set -u that closes the tmux session) lands in the log and the death is
# diagnosable after the session is gone — the pane-only output we had before
# vanished with the session. Rotate once at startup if the log grew large.
if [[ -f "$LOG_FILE" ]] && (($(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0) > LOG_MAX_BYTES)); then
    mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null && chmod 600 "$LOG_FILE.1" 2>/dev/null || true
fi
# Owner-only: the log captures chat ids, session names, sender ids and raw
# operational detail. Create it 600 BEFORE redirecting (shell redirection would
# otherwise honour the ambient umask, typically 0644).
: >>"$LOG_FILE" && chmod 600 "$LOG_FILE" 2>/dev/null || true
exec >>"$LOG_FILE" 2>&1

declare -A TG_CFG=()
declare -A STATE_INODE=()
declare -A STATE_OFFSET=()
declare -A SESSION_NAME=()
declare -A SESSION_PATH=()
TG_TOKEN=""
TG_CHAT_ID=""
TG_INCLUDE_DEFAULT="send,ask,review,reply,done,alert,throttled,chat"
TG_INCLUDE=""
TG_EXCLUDE=""
TG_ALLOWED_IDS=""          # comma/space list; non-empty enables inbound commands
TG_OFFSET_FILE="$STATE_DIR/tg_offset"
TG_UPDATES_LIMIT=10        # bounded updates per cycle so a backlog can't
                          # starve the outbound event-tail pass

_log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }

_redact() { sed -E 's|bot[0-9]+:[A-Za-z0-9_-]+|bot<redacted>|g'; }

# Literal tilde-prefix expansion; case patterns are literal '~' matches,
# not shell tilde-expansion (silenced for shellcheck — same suppression
# as the corresponding helper in ae itself).
# shellcheck disable=SC2088
_expand_path() {
    local p="$1"
    case "$p" in
        '~') printf '%s' "$HOME" ;;
        '~/'*) printf '%s/%s' "$HOME" "${p#"~/"}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# Parse [telegram] block from CONFIG_FILE. Same shape as ae's parse_config
# but scoped to one section to keep this daemon dependency-free of ae.
read_config() {
    TG_CFG=()
    [[ -f "$CONFIG_FILE" ]] || return 0
    local section="" line val
    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue
        if [[ "$line" =~ ^\[([a-zA-Z_-]+)\]$ ]]; then
            section="${BASH_REMATCH[1]}"
            continue
        fi
        [[ "$section" == "telegram" ]] || continue
        if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*)[[:space:]]*=[[:space:]]*\"(.*)\"$ ]]; then
            TG_CFG["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
        elif [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            val="${BASH_REMATCH[2]}"
            val="${val%%#*}"
            val="${val%"${val##*[![:space:]]}"}"
            TG_CFG["${BASH_REMATCH[1]}"]="$val"
        fi
    done <"$CONFIG_FILE"
}

# Load token + chat + filter set. Exits non-zero on missing required config.
load_runtime_config() {
    local token_file
    token_file="${TG_CFG[token_file]:-}"
    [[ -n "$token_file" ]] || { _log "missing telegram.token_file"; return 1; }
    token_file="$(_expand_path "$token_file")"
    [[ -r "$token_file" ]] || { _log "token file not readable: $token_file"; return 1; }
    TG_TOKEN="$(< "$token_file")"
    TG_TOKEN="${TG_TOKEN%$'\n'}"
    TG_TOKEN="${TG_TOKEN//$'\r'/}"
    [[ -n "$TG_TOKEN" ]] || { _log "token file is empty"; return 1; }
    TG_CHAT_ID="${TG_CFG[chat_id]:-}"
    [[ -n "$TG_CHAT_ID" ]] || { _log "missing telegram.chat_id"; return 1; }
    TG_INCLUDE="${TG_CFG[include]:-$TG_INCLUDE_DEFAULT}"
    TG_EXCLUDE="${TG_CFG[exclude]:-}"
    TG_ALLOWED_IDS="${TG_CFG[allowed_user_ids]:-}"
    return 0
}

# Inbound (chat -> ae) is enabled ONLY when at least one user id is
# allow-listed. With no allow-list there is no authorized sender, so the
# daemon stays outbound-only (Stage 2 behavior preserved verbatim).
inbound_enabled() {
    [[ -n "${TG_ALLOWED_IDS//[, ]/}" ]]
}

# Authorize an incoming update. ALL must hold (codex BLOCKER): the sender id
# is numeric and allow-listed, the chat is exactly the configured control
# channel, and it's a private chat. This confines command execution to the
# intended 1:1 channel — a group/accidental-add cannot drive ae.
update_authorized() {
    local from_id="$1" chat_id="$2" chat_type="$3" item
    [[ "$from_id" =~ ^[0-9]+$ ]] || return 1
    [[ "$chat_type" == "private" ]] || return 1
    [[ "$chat_id" == "$TG_CHAT_ID" ]] || return 1
    local -a ids
    IFS=', ' read -ra ids <<<"$TG_ALLOWED_IDS"
    for item in "${ids[@]}"; do
        [[ "$item" == "$from_id" ]] && return 0
    done
    return 1
}

# True if action is in TG_INCLUDE and not in TG_EXCLUDE. Both are
# comma-separated; whitespace tolerated.
event_action_allowed() {
    local action="$1" item
    local -a items
    IFS=', ' read -ra items <<<"$TG_INCLUDE"
    local found=0
    for item in "${items[@]}"; do
        [[ "$item" == "$action" ]] && { found=1; break; }
    done
    (( found )) || return 1
    [[ -n "$TG_EXCLUDE" ]] || return 0
    IFS=', ' read -ra items <<<"$TG_EXCLUDE"
    for item in "${items[@]}"; do
        [[ "$item" == "$action" ]] && return 1
    done
    return 0
}

# Truncate text to N chars, preserving full UTF-8 best-effort.
truncate_text() {
    local text="$1" limit="$2"
    if (( ${#text} > limit )); then
        printf '%s…(truncated)' "${text:0:limit}"
    else
        printf '%s' "$text"
    fi
}

# Format one event into a Telegram-bound message body.
# Input: session_name, JSON event line.
format_event() {
    local name="$1" line="$2"
    local action actor target summary
    action=$(jq -r '.action // ""' <<<"$line" 2>/dev/null) || return 1
    actor=$(jq -r '.actor // ""' <<<"$line" 2>/dev/null) || return 1
    target=$(jq -r '.target // ""' <<<"$line" 2>/dev/null) || return 1
    summary=$(jq -r '.summary // ""' <<<"$line" 2>/dev/null) || return 1
    local hdr="[$name] $action  $actor"
    [[ -n "$target" ]] && hdr+=" → $target"
    if [[ -n "$summary" ]]; then
        printf '%s\n%s' "$hdr" "$(truncate_text "$summary" 3500)"
    else
        printf '%s' "$hdr"
    fi
}

# Send a Telegram sendMessage. URL + token are interpolated into a
# heredoc piped to curl's -K config-on-stdin, so neither token nor
# message body appear in argv.
send_message() {
    local text="$1" resp rc tmp_text
    # curl's -K config is line-oriented. An inline `data-urlencode = text=...`
    # with embedded newlines splits into multiple directives (the second line
    # becomes "world" → curl warning "unknown option"). Pass the payload via
    # data-urlencode's @file form so multi-line text is data, not config.
    tmp_text=$(mktemp "${TMPDIR:-/tmp}/ae-telegram-msg.XXXXXX") || {
        _log "send_message: mktemp failed"
        return 1
    }
    (umask 077; printf '%s' "$text" >"$tmp_text") || {
        rm -f "$tmp_text"
        _log "send_message: writing payload temp failed"
        return 1
    }
    resp=$(curl -sS -K - 2>&1 <<EOF
silent
fail-with-body
url = https://api.telegram.org/bot${TG_TOKEN}/sendMessage
data-urlencode = chat_id=${TG_CHAT_ID}
data-urlencode = text@${tmp_text}
EOF
)
    rc=$?
    rm -f "$tmp_text"
    if (( rc != 0 )); then
        _log "send_message failed (rc=$rc): $(printf '%s' "$resp" | _redact | head -c 400)"
        return 1
    fi
    return 0
}

# Register the bot's slash-command menu with Telegram (setMyCommands) so the
# inbound commands surface in the "/" UI. Best-effort + non-fatal; called once
# at startup only when inbound is enabled (no point advertising commands that
# would be rejected). Token via -K stdin, never argv (same as send_message).
tg_set_commands() {
    local cmds_json resp ok tmp_cmds
    cmds_json=$(jq -cn '[
        {command:"list",    description:"Running sessions (name, id, last activity)"},
        {command:"use",     description:"Redirect plain messages to a session (default is the steward): /use <session> <agent>"},
        {command:"session", description:"Message an agent: /session <name> send|ask <agent> <msg>"},
        {command:"help",    description:"Show help"}
    ]' 2>/dev/null) || return 0
    # Pass the JSON via data-urlencode's @file form, not inline. curl's -K config
    # parser truncates an unquoted value at the first space, and the descriptions
    # contain spaces — an inline `commands=${cmds_json}` ships chopped JSON and
    # Telegram rejects it with 400 "can't parse commands JSON object". @file keeps
    # the payload out of the config grammar (same fix as send_message).
    tmp_cmds=$(mktemp "${TMPDIR:-/tmp}/ae-telegram-cmds.XXXXXX") || {
        _log "setMyCommands: mktemp failed"
        return 0
    }
    (umask 077; printf '%s' "$cmds_json" >"$tmp_cmds") || {
        rm -f "$tmp_cmds"
        _log "setMyCommands: writing payload temp failed"
        return 0
    }
    resp=$(curl -sS -K - 2>&1 <<EOF
silent
fail-with-body
url = https://api.telegram.org/bot${TG_TOKEN}/setMyCommands
data-urlencode = commands@${tmp_cmds}
EOF
)
    if (( $? != 0 )); then
        rm -f "$tmp_cmds"
        _log "setMyCommands failed: $(printf '%s' "$resp" | _redact | head -c 200)"
        return 0
    fi
    rm -f "$tmp_cmds"
    ok=$(printf '%s' "$resp" | jq -r '.ok // false' 2>/dev/null)
    if [[ "$ok" == "true" ]]; then
        _log "registered bot command menu (setMyCommands)"
    else
        _log "setMyCommands not ok: $(printf '%s' "$resp" | _redact | head -c 200)"
    fi
    return 0
}

# ── Inbound (chat -> ae) ─────────────────────────────────────────────

# Read the persisted getUpdates offset (last acked update_id). Empty => 0.
tg_load_offset() {
    local v=""
    [[ -f "$TG_OFFSET_FILE" ]] && v="$(< "$TG_OFFSET_FILE")"
    [[ "$v" =~ ^[0-9]+$ ]] || v=0
    printf '%s' "$v"
}

# Persist the offset atomically (tmp+rename). Returns non-zero on failure;
# the caller MUST NOT dispatch the command if this fails, else a disk error
# after fetch-but-before-persist would replay a side-effecting command on the
# next daemon start (codex IMPORTANT — at-most-once depends on this write).
tg_save_offset() {
    local val="$1" tmp="$TG_OFFSET_FILE.tmp.$$"
    printf '%s\n' "$val" >"$tmp" 2>/dev/null || return 1
    mv "$tmp" "$TG_OFFSET_FILE" 2>/dev/null || { rm -f "$tmp"; return 1; }
    return 0
}

# Exact-match check for a RUNNING tmux session (not prefix — same guard as
# the main script). The daemon shares the tmux server, so it can query it.
daemon_session_running() {
    tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- "$1"
}

# Resolve a chat-supplied session reference to a real session dir WITHOUT
# ever building a path from the input (codex — path-traversal guard). Only
# RUNNING sessions are considered (codex — don't offer/dispatch into stopped
# sessions, which would fail later with a misleading error). Matches exact
# session name, else a unique session_id prefix. Echoes "name<TAB>dir" on a
# unique match; returns 1 (none) or 2 (ambiguous).
resolve_session_ref() {
    local ref="$1" meta dir name sid
    local exact_dir="" exact_name=""
    local -a pre_dirs=() pre_names=()
    for meta in "$SESSIONS_DIR"/*/meta; do
        [[ -f "$meta" ]] || continue
        dir="${meta%/meta}"
        name="${dir##*/}"
        daemon_session_running "$name" || continue
        sid="$(grep '^session_id=' "$meta" 2>/dev/null | head -1 | cut -d= -f2-)"
        if [[ "$name" == "$ref" ]]; then
            exact_dir="$dir"; exact_name="$name"
        fi
        if [[ -n "$sid" && "$sid" == "$ref"* ]]; then
            pre_dirs+=("$dir"); pre_names+=("$name")
        fi
    done
    if [[ -n "$exact_dir" ]]; then
        printf '%s\t%s\n' "$exact_name" "$exact_dir"; return 0
    fi
    case "${#pre_dirs[@]}" in
        1) printf '%s\t%s\n' "${pre_names[0]}" "${pre_dirs[0]}"; return 0 ;;
        0) return 1 ;;
        *) return 2 ;;
    esac
}

# Validate a chat-supplied agent ref against the RESOLVED session's actual
# agents and return the canonical "alias:name" (codex BLOCKER). The session
# helpers' grammar is broader than ours — it also accepts %pane-id,
# @session:agent, and external prefixes — which would let a command escape
# the resolved session into an arbitrary pane/session. We never pass the raw
# input to the helper: we match it (exact alias:name OR unique bare name)
# against meta's agent.* entries and pass only the canonical ref. Anything
# with %, @, or a foreign prefix simply won't match.
resolve_agent_in_session() {
    local dir="$1" want="$2" line ref alias name
    local match="" bare_hits=0 bare_match=""
    while IFS= read -r line; do
        ref="${line#*=}"            # alias:name:uuid
        alias="${ref%%:*}"
        name="${ref#*:}"; name="${name%%:*}"
        [[ -n "$alias" && -n "$name" ]] || continue
        if [[ "$want" == "${alias}:${name}" ]]; then
            match="${alias}:${name}"; break
        fi
        if [[ "$want" == "$name" ]]; then
            bare_hits=$((bare_hits + 1)); bare_match="${alias}:${name}"
        fi
    done < <(grep -E '^agent\.[a-z0-9.]+=' "$dir/meta" 2>/dev/null)
    if [[ -n "$match" ]]; then printf '%s' "$match"; return 0; fi
    if (( bare_hits == 1 )); then printf '%s' "$bare_match"; return 0; fi
    (( bare_hits > 1 )) && return 2   # ambiguous bare name
    return 1                          # no such agent in this session
}

# /list reply body: RUNNING ae sessions with their short session_id + age.
tg_cmd_list() {
    local meta dir name sid ev age out=""
    local now; now=$(date +%s)
    for meta in "$SESSIONS_DIR"/*/meta; do
        [[ -f "$meta" ]] || continue
        dir="${meta%/meta}"; name="${dir##*/}"
        daemon_session_running "$name" || continue
        sid="$(grep '^session_id=' "$meta" 2>/dev/null | head -1 | cut -d= -f2-)"
        ev="$dir/events.jsonl"
        if [[ -f "$ev" ]]; then
            local mt; mt=$(stat -c %Y "$ev" 2>/dev/null || echo 0)
            local d=$((now - mt))
            if (( d < 90 )); then age="just now"
            elif (( d < 3600 )); then age="$((d/60))m ago"
            elif (( d < 86400 )); then age="$((d/3600))h ago"
            else age="$((d/86400))d ago"; fi
        else
            age="-"
        fi
        out+="• ${name}  [${sid:0:8}]  ${age}"$'\n'
    done
    [[ -n "$out" ]] || out="(no running sessions)"
    printf 'Running sessions:\n%s' "$out"
}

# Dispatch one authorized command. from_id is pre-validated numeric.
tg_handle_command() {
    local from_id="$1" text="$2"
    # Strip leading/trailing whitespace.
    text="${text#"${text%%[![:space:]]*}"}"
    text="${text%"${text##*[![:space:]]}"}"

    # Compact prefix: "@session:agent msg" sends straight to that agent (mirrors
    # ae's @session:agent addressing). Handled BEFORE command parsing because the
    # /cmd@botname stripping below would otherwise eat a leading @.
    if [[ "$text" == @* ]]; then
        tg_cmd_at "$from_id" "$text"
        return
    fi

    local cmd rest
    cmd="${text%%[[:space:]]*}"
    rest="${text#"$cmd"}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
    # Tolerate /cmd@botname in case pinning is ever loosened.
    cmd="${cmd%@*}"

    case "$cmd" in
        /help|"")
            send_message "$(printf 'ae telegram:\n• Plain text → your steward (auto-default; just talk to it).\n• Reply to any forwarded message → answers that agent (no command).\n• @session:agent <msg> → send to an agent directly.\n• /use <session> <agent> → redirect plain messages elsewhere; /use clear → back to the steward.\n/list\n/session <name|id-prefix> send|ask <agent> <msg>')"
            ;;
        /list)
            send_message "$(tg_cmd_list)"
            ;;
        /use)
            tg_cmd_use "$from_id" "$rest"
            ;;
        /session)
            tg_cmd_session "$from_id" "$rest"
            ;;
        /*)
            send_message "Unknown command: $cmd — try /help"
            ;;
        *)
            # Bare text (no slash, no @): route to the sticky /use target if set.
            tg_route_sticky "$from_id" "$text"
            ;;
    esac
}

# /session <ref> <send|ask> <agent> <msg...>
tg_cmd_session() {
    local from_id="$1" args="$2"
    local ref verb agent msg
    ref="${args%%[[:space:]]*}"; args="${args#"$ref"}"; args="${args#"${args%%[![:space:]]*}"}"
    verb="${args%%[[:space:]]*}"; args="${args#"$verb"}"; args="${args#"${args%%[![:space:]]*}"}"
    agent="${args%%[[:space:]]*}"; args="${args#"$agent"}"; args="${args#"${args%%[![:space:]]*}"}"
    msg="$args"
    if [[ -z "$ref" || -z "$verb" || -z "$agent" || -z "$msg" ]]; then
        send_message "Usage: /session <name|id-prefix> <send|ask> <agent> <msg>"
        return
    fi
    case "$verb" in
        send|ask) ;;
        *) send_message "Unknown verb '$verb' (use send or ask)"; return ;;
    esac
    tg_dispatch "$from_id" "$ref" "$verb" "$agent" "$msg"
}

# Resolve <ref>+<agent> against RUNNING sessions and deliver <msg> via the
# session's send/ask helper under the external-actor identity. Shared by the
# explicit /session command and by reply-routing — all the security lives here:
# resolve_session_ref (running-only) + resolve_agent_in_session (canonicalize +
# reject %pane / @session / telegram: targets, so a chat command can't escape
# the named session). Reports each failure back to chat; returns nonzero on any.
tg_dispatch() {
    local from_id="$1" ref="$2" verb="$3" agent="$4" msg="$5"
    # Capture rc explicitly — `if ! cmd` would make $? the status of `!` (0),
    # so the ambiguous (2) branch would be unreachable (codex NIT).
    local resolved rc name dir
    resolved="$(resolve_session_ref "$ref")"; rc=$?
    if (( rc != 0 )); then
        case $rc in
            2) send_message "Ambiguous session '$ref' — be more specific" ;;
            *) send_message "No running session matching '$ref'" ;;
        esac
        return 1
    fi
    name="${resolved%%$'\t'*}"; dir="${resolved#*$'\t'}"
    # Constrain the target to an agent that actually lives in THIS session,
    # and canonicalize it (codex BLOCKER). This blocks %pane-id, @session:agent,
    # and telegram:/discord: targets — they cannot match a real agent ref, so
    # a Telegram command can never escape the resolved session.
    local canon arc
    canon="$(resolve_agent_in_session "$dir" "$agent")"; arc=$?
    if (( arc != 0 )); then
        case $arc in
            2) send_message "Ambiguous agent '$agent' in ${name} — use alias:name" ;;
            *) send_message "No agent '$agent' in session ${name}" ;;
        esac
        return 1
    fi
    local helper="$dir/$verb"
    if [[ ! -x "$helper" ]]; then
        send_message "Session '$name' has no '$verb' helper"
        return 1
    fi
    # Dispatch with the external-actor identity. No eval; positional args;
    # the agent is the canonical alias:name we validated above.
    if AE_SENDER_OVERRIDE="telegram:$from_id" "$helper" "$canon" "$msg" >/dev/null 2>&1; then
        send_message "→ ${verb} delivered to ${canon} in ${name}"
    else
        send_message "Failed to ${verb} ${canon} in ${name}"
    fi
}

# Parse the header line of a message THIS bridge forwarded — format_event emits
# "[<session>] <action>  <actor> [→ <target>]" as line 1. Echoes
# "<session>\t<actor>" or returns nonzero if it doesn't look like ours. Values
# are validated downstream (resolve_session_ref / resolve_agent_in_session), so
# a misparse fails safe rather than dispatching somewhere unexpected.
tg_parse_reply_target() {
    local rtext="$1" first sess rest action actor
    first="${rtext%%$'\n'*}"
    [[ "$first" == "["*"] "* ]] || return 1
    sess="${first#\[}"; sess="${sess%%]*}"
    rest="${first#*] }"
    read -r action actor _ <<<"$rest"
    [[ -n "$sess" && -n "$actor" ]] || return 1
    printf '%s\t%s' "$sess" "$actor"
}

# A plain (non-command) message sent as a Telegram REPLY to a forwarded event:
# route it to that event's agent — no `/session …` typing. reply = send (deliver
# the answer straight into the agent's pane).
tg_handle_reply() {
    local from_id="$1" rtext="$2" msg="$3" tgt sess actor
    if ! tgt="$(tg_parse_reply_target "$rtext")"; then
        send_message "Couldn't tell which agent that was a reply to — use /session <name> send <agent> <msg>"
        return
    fi
    sess="${tgt%%$'\t'*}"; actor="${tgt#*$'\t'}"
    tg_dispatch "$from_id" "$sess" "send" "$actor" "$msg"
}

# Sticky default target ("/use") — a single machine-global current target for the
# one control chat, stored as "<session>\t<agent>". Re-validated on every send,
# so a stopped session just reports an error rather than misrouting.
TG_TARGET_FILE="$STATE_DIR/current_target"

# Compact prefix: "@session:agent <msg>" → send <msg> to that agent. agent keeps
# its alias:name colon (session is up to the FIRST colon, agent is the rest of
# the token). Reuses tg_dispatch, so the same session/agent revalidation applies.
tg_cmd_at() {
    local from_id="$1" text="$2" token spec sess agent msg
    token="${text%%[[:space:]]*}"
    msg="${text#"$token"}"; msg="${msg#"${msg%%[![:space:]]*}"}"
    spec="${token#@}"
    if [[ "$spec" != *:* ]]; then
        send_message "Usage: @session:agent <msg>  (e.g. @mdk:claude:lead do X)"
        return
    fi
    sess="${spec%%:*}"; agent="${spec#*:}"
    if [[ -z "$msg" ]]; then
        send_message "Nothing to send — @session:agent <msg>"
        return
    fi
    tg_dispatch "$from_id" "$sess" "send" "$agent" "$msg"
}

# /use            → show the current sticky target
# /use clear|off  → clear it
# /use <ref> <agent> → set it (validated against running sessions, canonicalized)
tg_cmd_use() {
    local from_id="$1" args="$2" ref agent resolved rc name dir canon arc
    if [[ -z "$args" ]]; then
        if [[ -f "$TG_TARGET_FILE" ]]; then
            local cur; cur="$(cat "$TG_TARGET_FILE" 2>/dev/null)"
            send_message "Current target: ${cur%%$'\t'*} → ${cur#*$'\t'}  (plain messages go here; /use clear to fall back to the steward)"
        else
            local st; st="$(tg_find_steward)"
            if [[ -n "$st" ]]; then
                send_message "No override set — plain messages go to the steward (${st%%$'\t'*} → ${st#*$'\t'}). /use <session> <agent> to redirect."
            else
                send_message "No override set and no steward running. Start one with 'ae steward', or /use <session> <agent>."
            fi
        fi
        return
    fi
    ref="${args%%[[:space:]]*}"
    case "$ref" in
        clear|off|none)
            rm -f "$TG_TARGET_FILE" 2>/dev/null || true
            send_message "Override cleared — plain messages go to the steward again."
            return
            ;;
    esac
    agent="${args#"$ref"}"; agent="${agent#"${agent%%[![:space:]]*}"}"
    agent="${agent%%[[:space:]]*}"
    if [[ -z "$ref" || -z "$agent" ]]; then
        send_message "Usage: /use <session> <agent>   (or /use clear)"
        return
    fi
    resolved="$(resolve_session_ref "$ref")"; rc=$?
    if (( rc != 0 )); then
        case $rc in
            2) send_message "Ambiguous session '$ref' — be more specific" ;;
            *) send_message "No running session matching '$ref'" ;;
        esac
        return
    fi
    name="${resolved%%$'\t'*}"; dir="${resolved#*$'\t'}"
    canon="$(resolve_agent_in_session "$dir" "$agent")"; arc=$?
    if (( arc != 0 )); then
        case $arc in
            2) send_message "Ambiguous agent '$agent' in ${name} — use alias:name" ;;
            *) send_message "No agent '$agent' in session ${name}" ;;
        esac
        return
    fi
    (umask 077; printf '%s\t%s\n' "$name" "$canon" >"$TG_TARGET_FILE") || {
        send_message "Failed to save current target"
        return
    }
    send_message "Override set: ${name} → ${canon}. Plain messages go here until /use clear (then back to the steward)."
}

# Find the running steward (meta-agent) for auto-default routing: a running
# session with meta_agent=true in its meta. Prefer the canonical `steward` name,
# then legacy `hub`, then any other running meta-agent. Echoes
# "<session>\t<alias:name>" (its main agent) or nothing.
tg_find_steward() {
    local meta dir name main
    local hub_name="" hub_main="" any_name="" any_main=""
    for meta in "$SESSIONS_DIR"/*/meta; do
        [[ -f "$meta" ]] || continue
        grep -q '^meta_agent=true$' "$meta" 2>/dev/null || continue
        dir="${meta%/meta}"; name="${dir##*/}"
        daemon_session_running "$name" || continue
        main="$(grep '^agent.main=' "$meta" 2>/dev/null | head -1 | cut -d= -f2- | cut -d: -f1,2)"
        [[ -n "$main" ]] || continue
        case "$name" in
            steward) printf '%s\t%s\n' "$name" "$main"; return 0 ;; # canonical wins
            hub) hub_name="$name"; hub_main="$main" ;;
            *) [[ -z "$any_name" ]] && { any_name="$name"; any_main="$main"; } ;;
        esac
    done
    if [[ -n "$hub_name" ]]; then
        printf '%s\t%s\n' "$hub_name" "$hub_main"
    elif [[ -n "$any_name" ]]; then
        printf '%s\t%s\n' "$any_name" "$any_main"
    fi
}

# Bare (non-slash, non-@, non-reply) message → an explicit `/use` sticky target if
# set, else auto-default to the running steward (so you just talk to it — no
# `/use` needed), else guide the user.
tg_route_sticky() {
    local from_id="$1" msg="$2" cur sess agent steward
    if [[ -f "$TG_TARGET_FILE" ]]; then
        cur="$(cat "$TG_TARGET_FILE" 2>/dev/null)"
        sess="${cur%%$'\t'*}"; agent="${cur#*$'\t'}"
        if [[ -z "$sess" || -z "$agent" ]]; then
            send_message "Current target is unset/corrupt — /use <session> <agent>"
            return
        fi
        tg_dispatch "$from_id" "$sess" "send" "$agent" "$msg"
        return
    fi
    # No explicit /use override → default to the steward.
    steward="$(tg_find_steward)"
    if [[ -n "$steward" ]]; then
        sess="${steward%%$'\t'*}"; agent="${steward#*$'\t'}"
        tg_dispatch "$from_id" "$sess" "send" "$agent" "$msg"
        return
    fi
    send_message "No steward running and no /use target set. Start one with 'ae steward' (then just talk to it), reply to a message, use @session:agent <msg>, or /use <session> <agent>. (/help)"
}

# Poll getUpdates once (short-poll, bounded). For each update: persist the
# offset FIRST (at-most-once), then auth-check, then dispatch.
poll_updates() {
    inbound_enabled || return 0
    local offset next resp ok
    offset="$(tg_load_offset)"
    next=$((offset + 1))
    resp=$(curl -sS -K - 2>&1 <<EOF
silent
url = https://api.telegram.org/bot${TG_TOKEN}/getUpdates
data = offset=${next}
data = limit=${TG_UPDATES_LIMIT}
data = timeout=0
data-urlencode = allowed_updates=["message"]
EOF
)
    [[ $? -eq 0 ]] || { _log "getUpdates failed: $(printf '%s' "$resp" | _redact | head -c 200)"; return 0; }
    ok=$(printf '%s' "$resp" | jq -r '.ok // false' 2>/dev/null) || return 0
    [[ "$ok" == "true" ]] || { _log "getUpdates not ok: $(printf '%s' "$resp" | _redact | head -c 200)"; return 0; }

    local n; n=$(printf '%s' "$resp" | jq '.result | length' 2>/dev/null) || return 0
    [[ "$n" =~ ^[0-9]+$ ]] || return 0
    local i upd uid fid cid ctype mtext
    for (( i=0; i<n; i++ )); do
        upd=$(printf '%s' "$resp" | jq -c ".result[$i]" 2>/dev/null) || continue
        uid=$(printf '%s' "$upd" | jq -r '.update_id // empty' 2>/dev/null)
        [[ "$uid" =~ ^[0-9]+$ ]] || continue
        # Persist offset BEFORE dispatch. If it fails, stop processing this
        # cycle entirely so nothing executes that could later replay.
        if ! tg_save_offset "$uid"; then
            _log "offset persist failed — skipping inbound dispatch until it recovers"
            return 0
        fi
        fid=$(printf '%s' "$upd" | jq -r '.message.from.id // empty' 2>/dev/null)
        cid=$(printf '%s' "$upd" | jq -r '.message.chat.id // empty' 2>/dev/null)
        ctype=$(printf '%s' "$upd" | jq -r '.message.chat.type // empty' 2>/dev/null)
        mtext=$(printf '%s' "$upd" | jq -r '.message.text // empty' 2>/dev/null)
        [[ -n "$mtext" ]] || continue
        if ! update_authorized "$fid" "$cid" "$ctype"; then
            _log "dropped unauthorized update (from=$fid chat=$cid type=$ctype)"
            continue
        fi
        # Reply-to-routing: a plain (non-slash) message sent as a reply to a
        # forwarded event routes straight to that event's agent. Slash commands
        # are always handled as commands, even when sent as a reply. Trim leading
        # whitespace before the slash check so " /list" / a leading-newline are
        # still recognised as commands (matches tg_handle_command's own trim).
        local rtext mt_lead
        rtext=$(printf '%s' "$upd" | jq -r '.message.reply_to_message.text // empty' 2>/dev/null)
        mt_lead="${mtext#"${mtext%%[![:space:]]*}"}"
        if [[ "$mt_lead" != /* && -n "$rtext" ]]; then
            tg_handle_reply "$fid" "$rtext" "$mtext"
        else
            tg_handle_command "$fid" "$mtext"
        fi
    done
}

# Discover ae sessions: scan SESSIONS_DIR/*/meta. Populates
# SESSION_NAME and SESSION_PATH keyed by session_id.
discover_sessions() {
    local meta dir session_id name
    declare -A seen=()
    for meta in "$SESSIONS_DIR"/*/meta; do
        [[ -f "$meta" ]] || continue
        dir="${meta%/meta}"
        name="${dir##*/}"
        session_id=$(grep '^session_id=' "$meta" 2>/dev/null | head -1 | cut -d= -f2-)
        [[ -n "$session_id" ]] || continue
        SESSION_NAME[$session_id]="$name"
        SESSION_PATH[$session_id]="$dir"
        seen[$session_id]=1
    done
    # Drop missing sessions from state
    local sid
    for sid in "${!SESSION_NAME[@]}"; do
        if [[ -z "${seen[$sid]:-}" ]]; then
            unset 'SESSION_NAME[$sid]' 'SESSION_PATH[$sid]'
            unset 'STATE_INODE[$sid]' 'STATE_OFFSET[$sid]'
        fi
    done
}

# Read offset state from disk into STATE_*.
load_state() {
    STATE_INODE=()
    STATE_OFFSET=()
    [[ -f "$STATE_FILE" ]] || return 0
    local sid inode offset _rest
    while IFS=$'\t' read -r sid inode offset _rest; do
        [[ -z "$sid" || "$sid" == \#* ]] && continue
        STATE_INODE[$sid]="$inode"
        STATE_OFFSET[$sid]="$offset"
    done <"$STATE_FILE"
}

# Persist offset state atomically (tmp + rename, flock-guarded).
save_state() {
    local tmp="$STATE_FILE.tmp.$$"
    {
        printf '# session_id\tinode\tbyte_offset\tlast_ts\n'
        local sid
        for sid in "${!STATE_OFFSET[@]}"; do
            printf '%s\t%s\t%s\t%s\n' \
                "$sid" "${STATE_INODE[$sid]:-0}" "${STATE_OFFSET[$sid]:-0}" \
                "$(date -u +%FT%TZ)"
        done
    } >"$tmp"
    mv "$tmp" "$STATE_FILE"
}

# Stream new newline-terminated records from a session's events.jsonl,
# starting from the saved byte offset, and forward each accepted event
# to Telegram.
#
# Subtle correctness invariants codex flagged in review:
# (1) Use process substitution, NOT command substitution. `chunk=$(tail ...)`
#     strips trailing newlines — a single complete record `{...}\n` then looks
#     like a partial line and never advances the offset.
# (2) Advance the byte offset by the actual byte count of each consumed line
#     (line + '\n'), NOT by ${#var} which counts characters and drifts on UTF-8.
# (3) For an unseen session_id OR an inode change (transfer / recreate),
#     initialize at EOF instead of byte 0. Otherwise enabling the bridge
#     replays every historical event in every session.
# (4) Plain `while IFS= read -r line` naturally drops an unterminated trailing
#     partial line — `read` returns non-zero AND leaves no body for the loop.
process_session() {
    local sid="$1"
    local name="${SESSION_NAME[$sid]}"
    local path="${SESSION_PATH[$sid]}"
    local events_file="$path/events.jsonl"
    [[ -f "$events_file" ]] || return 0

    local cur_inode="${STATE_INODE[$sid]:-}"
    local cur_offset="${STATE_OFFSET[$sid]:-0}"
    local file_inode file_size
    file_inode=$(stat -c %i "$events_file" 2>/dev/null) || return 0
    file_size=$(stat -c %s "$events_file" 2>/dev/null) || return 0

    # Unknown session_id OR inode change: jump to EOF, persist, and skip
    # this iteration. This is the codex-flagged "don't replay history"
    # invariant — without it, every existing session's full event log
    # would flood the chat the first time the daemon comes up.
    if [[ -z "$cur_inode" || "$file_inode" != "$cur_inode" ]]; then
        STATE_INODE[$sid]="$file_inode"
        STATE_OFFSET[$sid]="$file_size"
        return 0
    fi

    if (( file_size <= cur_offset )); then
        STATE_INODE[$sid]="$file_inode"
        STATE_OFFSET[$sid]="$cur_offset"
        return 0
    fi

    # At-least-once delivery. The offset is only advanced PAST a deliverable
    # event after send_message succeeds; on send failure we break without
    # committing, so the same event (and everything after it) is retried on
    # the next poll instead of being silently dropped on a transient 429/5xx
    # or network blip. Filtered / empty / unparseable records carry no
    # delivery obligation and advance the offset freely.
    local line action body line_bytes
    local new_offset="$cur_offset"
    while IFS= read -r line; do
        # Byte-accurate width: wc -c counts the trailing '\n' that we'd
        # otherwise lose to printf, so the file position stays in sync even
        # when summaries contain multi-byte UTF-8 codepoints.
        line_bytes=$(printf '%s\n' "$line" | wc -c)
        if [[ -n "$line" ]]; then
            action=$(jq -r '.action // ""' <<<"$line" 2>/dev/null) || action=""
            if [[ -n "$action" ]] && event_action_allowed "$action"; then
                body=$(format_event "$name" "$line") || body=""
                if [[ -n "$body" ]]; then
                    if ! send_message "$body"; then
                        _log "send failed for $sid — will retry from offset $new_offset"
                        break
                    fi
                fi
            fi
        fi
        new_offset=$((new_offset + line_bytes))
    done < <(tail -c "+$((cur_offset + 1))" "$events_file" 2>/dev/null)

    STATE_INODE[$sid]="$file_inode"
    STATE_OFFSET[$sid]="$new_offset"
}

# Acquire exclusive daemon lock — refuses to run if another daemon
# holds the lock (would otherwise create duplicate Telegram messages).
acquire_lock() {
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        _log "another ae telegram daemon is already running (lock: $LOCK_FILE)"
        return 1
    fi
    return 0
}

# The EXIT trap must only persist state when THIS process owns the lock AND
# has loaded existing state — otherwise a daemon that lost the flock race, or
# bailed during config validation, would rewrite state.tsv down to just the
# header and wipe a healthy daemon's offsets.
LOCK_HELD=0
STATE_LOADED=0
# main() is an infinite loop with no internal exit path, so the daemon only ever
# stops because something OUTSIDE it intervenes. "exiting (rc=0)" alone hides
# whether that was SIGTERM (`ae telegram stop` / a stray `tmux kill-session`),
# SIGHUP (the tmux session or server torn down — e.g. a client/terminal closing),
# SIGINT, or a genuinely internal exit (which would mean a code path we don't know
# about). Record the terminating signal so the next death is diagnosable. Each
# handler re-exits with 128+signum, so death behaviour is unchanged — only the log
# gains the cause.
_DAEMON_EXIT_SIGNAL=""
_daemon_on_signal() {
    _DAEMON_EXIT_SIGNAL="$1"
    exit "$2"
}
trap '_daemon_on_signal SIGHUP 129' HUP
trap '_daemon_on_signal SIGINT 130' INT
trap '_daemon_on_signal SIGTERM 143' TERM
# Single EXIT handler (bash keeps only one): capture the exit status FIRST, then
# persist offsets if we held the lock, then record WHY the daemon stopped — the
# rc plus the signal makes a crash (e.g. set -u abort), an external kill, and a
# clean stop distinguishable in the log file.
daemon_on_exit() {
    local rc=$?
    [[ "$LOCK_HELD" == 1 && "$STATE_LOADED" == 1 ]] && { save_state 2>/dev/null || true; }
    if [[ -n "$_DAEMON_EXIT_SIGNAL" ]]; then
        _log "daemon exiting (rc=$rc, signal=$_DAEMON_EXIT_SIGNAL)"
    else
        _log "daemon exiting (rc=$rc, no signal — internal/clean exit)"
    fi
}
trap daemon_on_exit EXIT

main() {
    mkdir -p "$STATE_DIR"
    acquire_lock || exit 1
    LOCK_HELD=1
    read_config
    load_runtime_config || exit 1
    load_state
    STATE_LOADED=1
    if inbound_enabled; then
        _log "daemon started — include=$TG_INCLUDE exclude=${TG_EXCLUDE:-<none>} inbound=on (allow-listed users)"
        # Advertise the inbound commands in Telegram's "/" menu (best-effort).
        tg_set_commands
    else
        _log "daemon started — include=$TG_INCLUDE exclude=${TG_EXCLUDE:-<none>} inbound=off (no allowed_user_ids)"
    fi

    local last_discovery=0
    local now sid
    while :; do
        now=$(date +%s)
        if (( now - last_discovery >= DISCOVERY_INTERVAL )); then
            discover_sessions
            last_discovery=$now
        fi
        for sid in "${!SESSION_NAME[@]}"; do
            process_session "$sid"
        done
        save_state
        # Inbound (chat -> ae): short-poll once per cycle, bounded.
        poll_updates
        sleep "$POLL_INTERVAL"
    done
}

main "$@"
TELEGRAM_DAEMON_EOF
    chmod +x "$dest"
}

# Persist the enabled flag in ~/.ae/config without disturbing other content.
# Adds the [telegram] section if it doesn't yet exist.
#
# A single section-scoped awk pass handles every case: replace `enabled`
# INSIDE [telegram], or insert it just before the next section / at EOF if
# the section exists without it. We must NOT decide replace-vs-insert from a
# global `grep enabled` — another section's `enabled =` would mislead that
# check and leave [telegram] untouched (codex-flagged).
_telegram_persist_intent() {
    local value="$1"
    local cfg="$CONFIG_FILE"
    local tmp="$cfg.tmp.$$"
    if [[ ! -f "$cfg" ]]; then
        printf '[telegram]\nenabled = %s\n' "$value" >"$cfg"
    elif ! grep -q '^\[telegram\]' "$cfg"; then
        printf '\n[telegram]\nenabled = %s\n' "$value" >>"$cfg"
    else
        awk -v val="$value" '
            BEGIN { in_tg = 0; done = 0 }
            /^\[telegram\][[:space:]]*$/ { in_tg = 1; print; next }
            /^\[/ {
                if (in_tg && !done) { print "enabled = " val; done = 1 }
                in_tg = 0; print; next
            }
            in_tg && !done && /^[[:space:]]*enabled[[:space:]]*=/ {
                print "enabled = " val; done = 1; next
            }
            { print }
            END { if (in_tg && !done) print "enabled = " val }
        ' "$cfg" >"$tmp" && mv "$tmp" "$cfg"
    fi
    # (No cache to bust: get_config parses fresh on every call — the disk cache was
    # removed after proving both stale-mtime and cross-process wrong-owner races.)
}

# Spawn the daemon in its dedicated tmux session. Caller must have
# checked deps and validated config — this just orchestrates tmux.
# The daemon inherits the EXACT config file ae validated (CONFIG_FILE),
# not its own $HOME/.ae/config default — otherwise a CONFIG_FILE override
# (tests, or a non-default config) would validate one file and the daemon
# would read another. Both the env value and the script path are %q-quoted.
_telegram_spawn_daemon() {
    _telegram_write_daemon
    local q_cfg q_daemon q_aehome
    q_cfg="$(printf '%q' "$CONFIG_FILE")"
    q_daemon="$(printf '%q' "$CONFIG_DIR/telegram-daemon")"
    # Pass AE_HOME too: the daemon defaults AE_HOME to $HOME/.ae, so without this
    # an isolated (AE_HOME=...) run would spawn a daemon tailing the LIVE ~/.ae.
    q_aehome="$(printf '%q' "$CONFIG_DIR")"
    tmux new-session -d -s "$_TELEGRAM_TMUX_SESSION" -c "$HOME" \
        "AE_HOME=${q_aehome} CONFIG_FILE=${q_cfg} exec bash ${q_daemon}" 2>/dev/null
    tmux set-option -t "$_TELEGRAM_TMUX_SESSION" status off 2>/dev/null || true
    tmux rename-window -t "$_TELEGRAM_TMUX_SESSION" "ae-telegram" 2>/dev/null || true
}

# Best-effort idempotent autostart — called from the `ae <name>` start path.
# Strictly non-fatal: any error path is a one-line stderr warn, returns 0.
# Caller's session start path MUST NOT be affected by anything here.
# Companion: ensure the steward comes up with the fleet. Opt-in purely by
# existing state — a scaffold from 'ae steward --init' (canonical or legacy
# hub layout); no new config keys. Skips when already running, when launching
# the steward itself, or under AE_NO_AUTOSTART=1 (also the recursion guard for
# the fire-and-forget self-invocation below). Never blocks or fails a launch.
_steward_autostart_if_scaffolded() {
    [[ "${AE_NO_AUTOSTART:-}" == "1" ]] && return 0
    case "${SESSION:-}" in steward | hub) return 0 ;; esac
    # Scaffold probe mirrors the steward trampoline's era-detection EXACTLY
    # (review finding): a set AE_STEWARD_DIR is authoritative (set-but-missing
    # means 'ae steward' would error — don't fire a child that dies silently),
    # then canonical, then AE_HUB_DIR (authoritative likewise), then legacy.
    local _sconf=""
    if [[ -n "${AE_STEWARD_DIR:-}" ]]; then
        _sconf="${AE_STEWARD_DIR}/steward.config"
    elif [[ -f "$CONFIG_DIR/steward/steward.config" ]]; then
        _sconf="$CONFIG_DIR/steward/steward.config"
    elif [[ -n "${AE_HUB_DIR:-}" ]]; then
        _sconf="${AE_HUB_DIR}/hub.config"
    elif [[ -f "$CONFIG_DIR/meta-hub/hub.config" ]]; then
        _sconf="$CONFIG_DIR/meta-hub/hub.config"
    fi
    [[ -n "$_sconf" && -f "$_sconf" ]] || return 0
    if daemon_session_running steward || daemon_session_running hub; then
        return 0
    fi
    echo "Starting steward companion session in the background (AE_NO_AUTOSTART=1 skips)."
    (AE_NO_AUTOSTART=1 "$0" steward >/dev/null 2>&1 &)
    return 0
}

# Companion: bring up the aewatch sidecar daemon (WATCHDOG only for now; the bridge is
# wired in s19) in its own per-AE_HOME tmux session. OPT-IN via AE_WATCHDOG_IMPL=uv ONLY
# — never by mere availability; the plain default keeps the bash per-session watchdog, so
# there is no live double-run (plan p3). Then additionally availability-gated (the
# contrib/aewatch script + a uv/python3 runtime); anything missing is a SILENT no-op.
# Guarded by AE_NO_AUTOSTART; strictly non-fatal — never blocks or fails a launch. The
# existing-session fast path is HEARTBEAT-FRESH-aware — a stale/wedged ae-aewatch session
# must still fall through to `up`, which kills + recreates it (never name-only suppress).
# Invoked exclusively from _start_session_watchdog (below), which owns the bash-standdown.
_aewatch_autostart_if_available() {
    [[ "${AE_NO_AUTOSTART:-}" == "1" ]] && return 0
    # OPT-IN ONLY (plan p3: no live watchdog double-run by default). The aewatch daemon
    # watchdog runs solely under the explicit AE_WATCHDOG_IMPL=uv switch; unset/bash/any
    # other value keeps the bash per-session watchdog and starts NO aewatch daemon.
    [[ "${AE_WATCHDOG_IMPL:-}" == "uv" ]] || return 0
    local _aw
    _aw="$(cd "$(dirname "$0")" && pwd)/contrib/aewatch/aewatch"
    [[ -f "$_aw" ]] || return 0
    local -a _run
    local _runner=""
    if command -v uv >/dev/null 2>&1; then
        _run=(uv run "$_aw")
        _runner=uv
    elif command -v python3 >/dev/null 2>&1; then
        _run=(python3 "$_aw")
        _runner=python3
    else
        return 0
    fi
    # Fast path ONLY when the heartbeat is fresh (age <= 90s, matching aewatch's
    # heartbeat_max_age); a stale/absent heartbeat falls through to `up` for a restart.
    local _hb="$CONFIG_DIR/aewatch/heartbeat"
    if daemon_session_running ae-aewatch && [[ -f "$_hb" ]]; then
        local _age=$(($(date +%s) - $(stat -c %Y "$_hb" 2>/dev/null || echo 0)))
        ((_age >= 0 && _age <= 90)) && return 0
    fi
    echo "Starting aewatch companion daemon in the background (AE_NO_AUTOSTART=1 skips)."
    (AE_NO_AUTOSTART=1 "${_run[@]}" up --ae-home "$CONFIG_DIR" --runner "$_runner" >/dev/null 2>&1 &)
    return 0
}

# The single watchdog-ownership decision for a launching session (plan p3: exactly
# one watchdog per session, no double-run). Arg is the effective watchdog-enabled
# value (meta > config). Disabled -> NEITHER. AE_WATCHDOG_IMPL=uv -> the aewatch
# daemon watches (bash stands down); anything else -> the bash per-session watchdog.
# The aewatch hook itself is availability/heartbeat-gated and non-fatal.
_start_session_watchdog() {
    local _enabled="$1"
    case "${_enabled,,}" in
        false | no | off | 0) return 0 ;;
    esac
    if [[ "${AE_WATCHDOG_IMPL:-}" == "uv" ]]; then
        _aewatch_autostart_if_available 2>/dev/null || true
    else
        "${AE_META}/watchdog" start
    fi
}

# s19: does a live aewatch daemon OWN the Telegram bridge? True when the durable bridge-owner
# marker exists AND the ae-aewatch heartbeat is fresh (age <= 90s, the s18-hook rule).
# Ownership is a machine-readable FACT, NOT env: a concurrent bash reviver (another session's
# `telegram _supervise`) never shares the uv-launcher's env, so the marker (written by the
# aewatch daemon's handoff) is what suppresses every revive path — only ONE bridge ever sends.
_aewatch_owns_bridge() {
    # Ownership is a DURABLE MARKER + fresh heartbeat, NOT env: a concurrent bash reviver
    # (another session's `telegram _supervise`) never shares the uv-launcher's env. The
    # aewatch daemon writes bridge-owner while its bridge is active; a STALE heartbeat means
    # aewatch is dead, so bash revives (the free fallback).
    [[ -f "$CONFIG_DIR/aewatch/bridge-owner" ]] || return 1
    local _hb="$CONFIG_DIR/aewatch/heartbeat"
    [[ -f "$_hb" ]] || return 1
    local _age=$(($(date +%s) - $(stat -c %Y "$_hb" 2>/dev/null || echo 0)))
    ((_age >= 0 && _age <= 90))
}

_telegram_autostart_if_enabled() {
    # s19: a live aewatch daemon owning the bridge (bridge-owner marker + fresh heartbeat)
    # stands bash down — return 0, do NOT start. This ONE guard covers every revive path
    # (launch, reattach, watchdog _supervise) that funnels here. A STALE heartbeat (aewatch
    # dead) falls through and bash revives — the free fallback.
    _aewatch_owns_bridge && return 0
    [[ "$(_telegram_intent_enabled)" == "true" ]] || return 0
    _telegram_daemon_running && return 0
    local missing
    missing="$(_telegram_missing_deps)"
    if [[ -n "$missing" ]]; then
        echo "ae telegram: skipped autostart — missing deps:$missing" >&2
        return 0
    fi
    local token_file err lock
    token_file="$(get_config telegram.token_file 2>/dev/null || true)"
    if err="$(_telegram_validate_token_file "$token_file" 2>&1)"; then
        : # ok
    else
        echo "ae telegram: skipped autostart — $err" >&2
        return 0
    fi
    lock="$(_telegram_control_lock_file)"
    {
        # Non-blocking: if a start/stop/supervise is mid-flight, skip this tick —
        # autostart must never delay session launch. Re-check intent + running
        # UNDER the lock so a concurrent `ae telegram stop` can't be undone (the
        # stop-vs-supervise TOCTOU race).
        flock -n 9 || return 0
        # Authoritative (uncached) re-check: a same-second `stop` must win even
        # if this process's get_config cache (possibly a different
        # XDG_RUNTIME_DIR) still has enabled=true.
        [[ "$(_telegram_intent_enabled_uncached)" == "true" ]] || return 0
        _telegram_daemon_running && return 0
        if ! _telegram_spawn_daemon 2>/dev/null; then
            echo "ae telegram: autostart failed (continuing without bridge)" >&2
        fi
    } 9>"$lock"
    return 0
}

cmd_telegram_help() {
    cat <<'EOF'
Usage:
  ae telegram setup      Interactive: writes [telegram] config + token file
  ae telegram start      Persist enabled=true and start the daemon now
  ae telegram stop       Persist enabled=false and stop the daemon now
  ae telegram status     Report runtime + intent state

Config block in ~/.ae/config:
  [telegram]
  enabled = true
  token_file = "~/.config/ae/telegram-bot.token"
  chat_id = 123456789
  allowed_user_ids = "123456789"
  include = "send,ask,review,reply,done,alert,throttled,chat"   # default
  exclude = "memo"                                             # default empty

Requires: jq, curl. The bridge runs in tmux session `ae-telegram` and
forwards filtered events from every ae session on this machine.
See docs/internals/bridge-protocol.md for the underlying contract.
EOF
}

cmd_telegram_setup() {
    local token_path_default="$HOME/.config/ae/telegram-bot.token"
    mkdir -p "$(dirname "$token_path_default")"
    echo "ae telegram setup — interactive."
    echo
    local token chat_id
    # -s keeps the token off the screen/scrollback. It is not a shell-history
    # risk here (read runs inside the script, not the user's interactive shell),
    # but visible-on-screen is its own leak vector (over-the-shoulder, recording).
    read -r -s -p "Bot token (from @BotFather): " token
    echo
    [[ -n "$token" ]] || {
        echo "Error: token required" >&2
        return 1
    }
    read -r -p "Chat ID (your Telegram numeric id): " chat_id
    [[ -n "$chat_id" ]] || {
        echo "Error: chat_id required" >&2
        return 1
    }
    if ! [[ "$chat_id" =~ ^-?[0-9]+$ ]]; then
        echo "Error: chat_id must be numeric" >&2
        return 1
    fi

    local tok_target="$token_path_default"
    read -r -p "Token file path [$tok_target]: " _tok_input
    [[ -n "$_tok_input" ]] && tok_target="$(_telegram_expand_path "$_tok_input")"
    mkdir -p "$(dirname "$tok_target")"
    (
        umask 077
        printf '%s\n' "$token" >"$tok_target"
    )
    chmod 600 "$tok_target"

    # Write config block (preserve user's existing content).
    if [[ ! -f "$CONFIG_FILE" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        : >"$CONFIG_FILE"
    fi
    if grep -q '^\[telegram\]' "$CONFIG_FILE"; then
        echo "Warning: [telegram] section already exists in $CONFIG_FILE — leaving as-is."
        echo "Edit it manually if values changed."
    else
        cat >>"$CONFIG_FILE" <<EOF

[telegram]
enabled = true
token_file = "${tok_target/#$HOME/~}"
chat_id = $chat_id
allowed_user_ids = "$chat_id"
EOF
    fi
    echo
    echo "Saved token to $tok_target (chmod 600)."
    echo "Wrote [telegram] block to $CONFIG_FILE."
    echo "Run 'ae telegram start' to spawn the daemon."
}

cmd_telegram_start() {
    local missing err
    missing="$(_telegram_missing_deps)"
    if [[ -n "$missing" ]]; then
        echo "Error: ae telegram needs:$missing" >&2
        return 1
    fi
    local token_file
    token_file="$(get_config telegram.token_file 2>/dev/null || true)"
    if ! err="$(_telegram_validate_token_file "$token_file" 2>&1)"; then
        echo "Error: $err" >&2
        return 1
    fi
    local chat_id lock
    chat_id="$(get_config telegram.chat_id 2>/dev/null || true)"
    [[ -n "$chat_id" ]] || {
        echo "Error: telegram.chat_id missing in config" >&2
        return 1
    }
    lock="$(_telegram_control_lock_file)"
    # Under the control lock so start serializes with stop/supervise (the whole
    # start/stop/supervise trio shares it): enable + spawn happen atomically.
    {
        # Must hold the lock (serializes with stop/supervise). Busy → report,
        # don't run the critical section unlocked.
        flock -w 5 9 || {
            echo "ae telegram: busy (start/stop/supervise in progress) — try again" >&2
            return 1
        }
        _telegram_persist_intent "true"
        # s19: if the aewatch daemon owns the bridge, WARN but honor the explicit human
        # request (`ae telegram start`) — human intent wins; we just say so, then spawn.
        if _aewatch_owns_bridge; then
            echo "ae telegram: WARNING — aewatch owns the bridge (bridge-owner + fresh heartbeat); starting the bash bridge too may double-send. Proceeding on your explicit request." >&2
        fi
        if _telegram_daemon_running; then
            echo "ae telegram: already running (tmux session $_TELEGRAM_TMUX_SESSION)"
            return 0
        fi
        _telegram_spawn_daemon
        if _telegram_daemon_running; then
            echo "ae telegram: started (tmux session $_TELEGRAM_TMUX_SESSION)"
            return 0
        fi
        echo "Error: failed to spawn daemon" >&2
        return 1
    } 9>"$lock"
}

cmd_telegram_stop() {
    local lock
    lock="$(_telegram_control_lock_file)"
    # Hold the control lock across disable + kill so an in-flight autostart/
    # supervise tick can't re-spawn after we've disabled (it re-checks intent
    # under the same lock). Wait briefly, but proceed best-effort if contended.
    {
        # Must hold the lock to be correct — proceeding unlocked would re-open
        # the stop-vs-supervise race. If we can't get it in 5s, report busy.
        flock -w 5 9 || {
            echo "ae telegram: busy (start/stop/supervise in progress) — try again" >&2
            return 1
        }
        _telegram_persist_intent "false"
        if _telegram_daemon_running; then
            tmux kill-session -t "$_TELEGRAM_TMUX_SESSION" 2>/dev/null
            echo "ae telegram: stopped"
        else
            echo "ae telegram: was not running"
        fi
    } 9>"$lock"
}

cmd_telegram_status() {
    local intent runtime
    intent="$(_telegram_intent_enabled)"
    if _telegram_daemon_running; then runtime="running"; else runtime="stopped"; fi
    echo "ae telegram:"
    echo "  intent:  enabled=$intent (in $CONFIG_FILE)"
    if _aewatch_owns_bridge; then
        echo "  backend: aewatch (bridge-owner marker + fresh heartbeat; shared state in $CONFIG_DIR/telegram)"
    else
        echo "  backend: bash"
    fi
    echo "  runtime: bash daemon $runtime (tmux session $_TELEGRAM_TMUX_SESSION)"
    local missing
    missing="$(_telegram_missing_deps)"
    if [[ -n "$missing" ]]; then
        echo "  deps:    MISSING:$missing"
    else
        echo "  deps:    jq=$(command -v jq) curl=$(command -v curl)"
    fi
    local token_file err
    token_file="$(get_config telegram.token_file 2>/dev/null || true)"
    if [[ -n "$token_file" ]]; then
        if err="$(_telegram_validate_token_file "$token_file" 2>&1)"; then
            echo "  token:   OK ($(_telegram_expand_path "$token_file"))"
        else
            echo "  token:   ERROR — $err"
        fi
    else
        echo "  token:   not configured"
    fi
    local state_file="$CONFIG_DIR/telegram/state.tsv"
    if [[ -f "$state_file" ]]; then
        local tracked
        # awk avoids `grep -c`'s "0 + exit 1" footgun (which `|| echo 0`
        # turned into a two-line "0\n0" count).
        tracked=$(awk '!/^#/ && NF {n++} END {print n + 0}' "$state_file")
        echo "  state:   $tracked sessions tracked ($state_file)"
    fi
    # An explicit include= that omits `chat` silently drops agents' `say`
    # replies (outbound chat). When include is unset the default carries `chat`,
    # so only warn when the user pinned an include without it.
    local include_cfg
    include_cfg="$(get_config telegram.include 2>/dev/null || true)"
    if [[ -n "$include_cfg" ]]; then
        local inc_words=" ${include_cfg//,/ } "
        if [[ "$inc_words" == *" chat "* ]]; then
            echo "  include: $include_cfg"
        else
            echo "  include: $include_cfg"
            echo "           WARN: 'chat' not in include — agent 'say' replies will NOT forward to Telegram. Add 'chat' to [telegram] include."
        fi
    fi
}

cmd_telegram() {
    local sub="${1:-status}"
    shift 2>/dev/null || true
    case "$sub" in
        setup) cmd_telegram_setup "$@" ;;
        start) cmd_telegram_start "$@" ;;
        stop) cmd_telegram_stop "$@" ;;
        status) cmd_telegram_status "$@" ;;
        # Internal: best-effort revive used by the watchdog (step 10). Runs
        # the same autostart path as `ae <name>` — respects [telegram] enabled,
        # never flips the persisted flag, idempotent. Not for direct use.
        _supervise) _telegram_autostart_if_enabled 2>/dev/null || true ;;
        help | -h | --help) cmd_telegram_help ;;
        *)
            echo "Error: unknown subcommand 'telegram $sub'" >&2
            cmd_telegram_help >&2
            return 2
            ;;
    esac
}

# ── Transfer helpers (cross-machine session sync) ────────────────────

# Validate a UUID has the expected v4-ish shape. Used as a first gate before
# any disk globbing so malformed inputs fail with an actionable error rather
# than producing nondeterministic glob matches.
_transfer_validate_uuid() {
    local uuid="${1:-}"
    [[ "$uuid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
}

# Find the Claude Code conversation file for a given UUID. Globs under
# ~/.claude/projects/*/<uuid>.jsonl; requires exactly one match anchored
# inside the projects tree. Echoes the absolute path on success.
_transfer_find_claude_session_file() {
    local uuid="$1"
    _transfer_validate_uuid "$uuid" || {
        echo "Error: invalid UUID format: $uuid" >&2
        return 1
    }
    local matches=() f
    for f in "$HOME"/.claude/projects/*/"${uuid}".jsonl; do
        [[ -f "$f" ]] && matches+=("$f")
    done
    case "${#matches[@]}" in
        0)
            echo "Error: no Claude Code session file found for UUID $uuid under ~/.claude/projects/" >&2
            return 1
            ;;
        1) printf '%s\n' "${matches[0]}" ;;
        *)
            echo "Error: multiple Claude Code session files match UUID $uuid:" >&2
            printf '  %s\n' "${matches[@]}" >&2
            return 1
            ;;
    esac
}

# Find the Codex conversation file for a given UUID. Globs only *.jsonl
# (no .jsonl.zst compressed variants in MVP) and validates session_meta.payload.id
# from the first JSONL line. Requires exactly one match after validation.
_transfer_find_codex_session_file() {
    local uuid="$1"
    _transfer_validate_uuid "$uuid" || {
        echo "Error: invalid UUID format: $uuid" >&2
        return 1
    }
    local candidates=() f first_line file_id
    for f in "$HOME"/.codex/sessions/*/*/*/*"${uuid}"*.jsonl; do
        [[ -f "$f" ]] || continue
        first_line="$(head -1 "$f" 2>/dev/null || true)"
        [[ -z "$first_line" ]] && continue
        file_id="$(echo "$first_line" | grep -oP '"id"\s*:\s*"\K[0-9a-f-]+' 2>/dev/null || true)"
        [[ "$file_id" == "$uuid" ]] && candidates+=("$f")
    done
    case "${#candidates[@]}" in
        0)
            echo "Error: no Codex session file found for UUID $uuid (no match passing session_meta.payload.id check)" >&2
            return 1
            ;;
        1) printf '%s\n' "${candidates[0]}" ;;
        *)
            echo "Error: multiple Codex session files match UUID $uuid:" >&2
            printf '  %s\n' "${candidates[@]}" >&2
            return 1
            ;;
    esac
}

# Exact-match session-running check. Uses grep -Fxq on list-sessions output
# rather than `tmux has-session -t "$name"` which prefix-matches (so 'mdk'
# would match 'mdk-app'). Returns 0 if exactly the named session is running.
_transfer_session_running() {
    local name="$1"
    tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- "$name"
}

# Idempotent local stop. Already-stopped is success; missing meta is an error.
_transfer_ensure_stopped() {
    local name="$1"
    [[ -d "${SESSIONS_DIR}/${name}" ]] || {
        echo "Error: no session '$name' on this machine" >&2
        return 1
    }
    if _transfer_session_running "$name"; then
        cmd_stop "$name" >/dev/null 2>&1 || {
            echo "Error: failed to stop local session '$name'" >&2
            return 1
        }
    fi
    return 0
}

# Idempotent remote stop. Values interpolated via %q into an unquoted heredoc
# (see _transfer_bash_quote — SSH argv is not preserved across the wire).
_transfer_ensure_stopped_remote() {
    local target="$1" name="$2"
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
set -uo pipefail
name=$(_transfer_bash_quote "$name")
[[ -d "\$HOME/.ae/sessions/\$name" ]] || exit 0
if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- "\$name"; then
    ae stop "\$name" >/dev/null 2>&1 || exit 1
fi
exit 0
REMOTE
}

# Shell-quote a value for safe interpolation into a remote bash heredoc.
# SSH treats argv as a single re-parsed string (it does NOT preserve quoting
# boundaries), so we never use `ssh "$t" bash -s -- "$arg1" "$arg2"`. Instead
# we interpolate %q-quoted values into an unquoted heredoc and stream the
# script to the remote bash via stdin. The remote shell parses the assignment
# once, recovering the original value. Required for any arg that may contain
# spaces, quotes, braces, or other shell-special chars (work_dirs, JSON, etc.).
_transfer_bash_quote() {
    printf '%q' "$1"
}

# JSON-escape mirroring ae_json_escape's rules. Used to safely embed
# variables into the destination event-emit snippet.
_transfer_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/\\r}"
    printf '%s' "$s"
}

# Quick SSH connectivity probe with batch mode + short timeout.
_transfer_ssh_probe() {
    local target="$1"
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" true
}

# Check whether local rsync supports --protect-args. Probes the option
# directly rather than grepping --version text (modern rsync 3.2+ labels
# it 'secluded-args' in help but accepts --protect-args as an alias).
_transfer_local_rsync_supports_protect_args() {
    rsync --protect-args --version >/dev/null 2>&1
}

# Remote preflight: required commands fatal, optional commands warn-only,
# protect-args probed directly, ae version compared for drift warning.
_transfer_remote_preflight() {
    local target="$1"
    local probe
    probe="$(
        ssh "$target" bash -s <<'REMOTE' 2>/dev/null || true
fatal=""
command -v ae >/dev/null 2>&1 || fatal="${fatal} ae"
command -v rsync >/dev/null 2>&1 || fatal="${fatal} rsync"
printf 'fatal:%s\n' "${fatal# }"
command -v claude >/dev/null 2>&1 || printf 'warn:%s\n' claude
command -v codex >/dev/null 2>&1 || printf 'warn:%s\n' codex
printf 'ae_version:%s\n' "$(ae version 2>/dev/null || echo unknown)"
if rsync --protect-args --version >/dev/null 2>&1; then
    printf 'protect_args:ok\n'
else
    printf 'protect_args:fail\n'
fi
REMOTE
    )"
    local fatal="" ae_remote="" protect_remote="" line
    while IFS= read -r line; do
        case "$line" in
            fatal:*) fatal="${line#fatal:}" ;;
            warn:*) echo "Warning: remote missing optional tool '${line#warn:}'" >&2 ;;
            ae_version:*) ae_remote="${line#ae_version:}" ;;
            protect_args:*) protect_remote="${line#protect_args:}" ;;
        esac
    done <<<"$probe"
    if [[ -n "$fatal" ]]; then
        echo "Error: remote missing required tools:$fatal (install on $target before retrying)" >&2
        return 1
    fi
    if [[ "$protect_remote" != "ok" ]]; then
        echo "Error: remote rsync lacks --protect-args support (upgrade to rsync 3.0+)" >&2
        return 1
    fi
    if [[ "$ae_remote" != "ae $AE_VERSION" && "$ae_remote" != "unknown" ]]; then
        echo "Warning: ae version differs: local=ae $AE_VERSION remote=$ae_remote" >&2
    fi
    return 0
}

# Path-equality precheck via SSH. work_dir may contain spaces, so the value
# is %q-quoted into an unquoted heredoc (SSH argv is not preserved verbatim).
_transfer_check_remote_path() {
    local target="$1" work_dir="$2"
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
work_dir=$(_transfer_bash_quote "$work_dir")
[[ -d "\$work_dir" ]]
REMOTE
}

# Check whether the remote already has a session of the given name.
_transfer_remote_session_exists() {
    local target="$1" name="$2"
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
name=$(_transfer_bash_quote "$name")
[[ -f "\$HOME/.ae/sessions/\$name/meta" ]]
REMOTE
}

# Brief local-side session summary used in the collision prompt.
_transfer_session_summary() {
    local meta="$1"
    [[ -f "$meta" ]] || {
        echo "(no meta)"
        return
    }
    local session_name last_active agents=()
    session_name="$(grep '^session=' "$meta" | cut -d= -f2-)"
    last_active="$(stat -c %y "$meta" 2>/dev/null | cut -d. -f1)"
    local k v
    while IFS='=' read -r k v; do
        [[ "$k" =~ ^agent\. ]] && agents+=("${v%:*}")
    done <"$meta"
    printf 'session=%s last=%s agents=[%s]\n' "$session_name" "$last_active" "${agents[*]:-(none)}"
}

# Emit a transfer event on the destination via SSH+flock+JSON-append.
# Variables are JSON-escaped locally, then the resulting JSON string is
# %q-quoted as a single bash word into an unquoted heredoc. SSH argv would
# mangle the braces and spaces; stdin-streamed heredoc + %q round-trips
# cleanly through one bash reparse.
_transfer_emit_destination_event() {
    local target="$1" session="$2" summary="$3"
    local ts actor esc_ts esc_actor esc_summary json
    ts="$(date -u +%FT%TZ)"
    actor="${USER:-human}"
    esc_ts="$(_transfer_json_escape "$ts")"
    esc_actor="$(_transfer_json_escape "$actor")"
    esc_summary="$(_transfer_json_escape "$summary")"
    json="$(printf '{"ts":"%s","actor":"%s","action":"transfer","summary":"%s"}' "$esc_ts" "$esc_actor" "$esc_summary")"
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
session=$(_transfer_bash_quote "$session")
json=$(_transfer_bash_quote "$json")
events_file="\$HOME/.ae/sessions/\$session/events.jsonl"
lock_file="\${events_file}.lock"
mkdir -p "\$(dirname "\$events_file")"
{
    flock -w 5 9 || exit 1
    printf '%s\n' "\$json" >>"\$events_file"
} 9>>"\$lock_file"
REMOTE
}

# Read a single key from the remote session's meta file.
_transfer_read_remote_meta_value() {
    local target="$1" session="$2" key="$3"
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
session=$(_transfer_bash_quote "$session")
key=$(_transfer_bash_quote "$key")
meta="\$HOME/.ae/sessions/\$session/meta"
[[ -f "\$meta" ]] || exit 1
grep "^\${key}=" "\$meta" 2>/dev/null | cut -d= -f2- | head -1
REMOTE
}

# Find the Claude conversation file on the remote for a given UUID. Same
# semantics as _transfer_find_claude_session_file but executed on the remote.
_transfer_find_remote_claude_session_file() {
    local target="$1" uuid="$2"
    _transfer_validate_uuid "$uuid" || {
        echo "Error: invalid UUID format: $uuid" >&2
        return 1
    }
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
uuid=$(_transfer_bash_quote "$uuid")
matches=()
for f in "\$HOME"/.claude/projects/*/"\${uuid}".jsonl; do
    [[ -f "\$f" ]] && matches+=("\$f")
done
case "\${#matches[@]}" in
    0) exit 1 ;;
    1) printf '%s\n' "\${matches[0]}" ;;
    *) exit 2 ;;
esac
REMOTE
}

# Find the Codex conversation file on the remote for a given UUID. Validates
# session_meta.payload.id from the first JSONL line (same as the local version).
_transfer_find_remote_codex_session_file() {
    local target="$1" uuid="$2"
    _transfer_validate_uuid "$uuid" || {
        echo "Error: invalid UUID format: $uuid" >&2
        return 1
    }
    # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
    ssh "$target" bash -s <<REMOTE
uuid=$(_transfer_bash_quote "$uuid")
candidates=()
for f in "\$HOME"/.codex/sessions/*/*/*/*"\${uuid}"*.jsonl; do
    [[ -f "\$f" ]] || continue
    first_line="\$(head -1 "\$f" 2>/dev/null || true)"
    [[ -z "\$first_line" ]] && continue
    file_id="\$(echo "\$first_line" | grep -oP '"id"\\s*:\\s*"\\K[0-9a-f-]+' 2>/dev/null || true)"
    [[ "\$file_id" == "\$uuid" ]] && candidates+=("\$f")
done
case "\${#candidates[@]}" in
    0) exit 1 ;;
    1) printf '%s\n' "\${candidates[0]}" ;;
    *) exit 2 ;;
esac
REMOTE
}

# Does the local machine already have this session?
_transfer_local_session_exists() {
    local name="$1"
    [[ -f "${SESSIONS_DIR}/${name}/meta" ]]
}

# Local-side event emit (used by --pull direction where destination is local).
_transfer_emit_local_event() {
    local session="$1" summary="$2"
    local ts actor esc_ts esc_actor esc_summary json
    ts="$(date -u +%FT%TZ)"
    actor="${USER:-human}"
    esc_ts="$(_transfer_json_escape "$ts")"
    esc_actor="$(_transfer_json_escape "$actor")"
    esc_summary="$(_transfer_json_escape "$summary")"
    json="$(printf '{"ts":"%s","actor":"%s","action":"transfer","summary":"%s"}' "$esc_ts" "$esc_actor" "$esc_summary")"
    local events_file="${SESSIONS_DIR}/${session}/events.jsonl"
    local lock_file="${events_file}.lock"
    mkdir -p "$(dirname "$events_file")"
    {
        flock -w 5 9 || return 1
        printf '%s\n' "$json" >>"$events_file"
    } 9>>"$lock_file"
}

cmd_transfer() {
    # Parse positional args + flags.
    local session="" target=""
    local pull=false with_workdir=false dry_run=false yes=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pull) pull=true ;;
            --with-workdir) with_workdir=true ;;
            --dry-run) dry_run=true ;;
            --yes | -y) yes=true ;;
            --help | -h)
                cat <<'HELP'
Usage: ae transfer <session> <ssh-target> [flags]

Push a stopped ae session (with Claude Code + Codex conversation history)
to a peer machine, or pull it back with --pull.

Flags:
  --pull           Reverse direction (pull from remote to local).
  --with-workdir   Also rsync the project working tree.
  --dry-run        Show what would happen; make no changes on either side.
  --yes, -y        Skip the interactive collision prompt.

Preconditions:
  * Same absolute project path on both machines.
  * Each machine has its own agent CLI auth pre-provisioned.
  * Source session is stopped (the command stops it automatically).
HELP
                return 0
                ;;
            --*)
                echo "Error: unknown flag: $1" >&2
                return 1
                ;;
            *)
                if [[ -z "$session" ]]; then
                    session="$1"
                elif [[ -z "$target" ]]; then
                    target="$1"
                else
                    echo "Error: too many positional args (got '$1' after session=$session target=$target)" >&2
                    return 1
                fi
                ;;
        esac
        shift
    done
    # 1. Arg validation (codex NIT — required args before deferred-flag rejection
    # so 'ae transfer --pull' reports the missing positional, not a future-phase
    # message that hides the real problem).
    if [[ -z "$session" || -z "$target" ]]; then
        echo "Usage: ae transfer <session> <ssh-target> [--pull] [--with-workdir] [--dry-run] [--yes]" >&2
        return 1
    fi
    # 1b. Phase-deferred flags. --with-workdir and --dry-run land in phase 3.
    if $with_workdir; then
        echo "Error: --with-workdir is not yet implemented (planned for phase 3)" >&2
        return 1
    fi
    if $dry_run; then
        echo "Error: --dry-run is not yet implemented (planned for phase 3)" >&2
        return 1
    fi
    # 2. Source session exists. Source is local for push, remote for pull.
    local local_session_dir="${SESSIONS_DIR}/${session}"
    if $pull; then
        # For pull, the source meta lives on the remote; we'll discover its
        # content after SSH probe + preflight pass.
        :
    else
        if [[ ! -f "${local_session_dir}/meta" ]]; then
            echo "Error: no session '$session' on this machine (looked for ${local_session_dir}/meta)" >&2
            return 1
        fi
    fi
    # Steward guard (audit finding): a meta-agent session is machine-local by
    # nature — transferring it silently breaks the source's Telegram routing
    # (tg_find_steward) and spawns a rogue steward watching the WRONG fleet on
    # the destination. Refuse in both directions; re-init on the target
    # machine instead (ae steward --init && ae steward).
    if grep -q '^meta_agent=true$' "${local_session_dir}/meta" 2>/dev/null; then
        echo "Error: '$session' is a steward/meta-agent session — transfer is refused." >&2
        echo "Stewards are machine-local (fleet routing + monitoring state). Run" >&2
        echo "'ae steward --init && ae steward' on the target machine instead." >&2
        return 1
    fi
    # 3. Self-stop guard — applies in both directions. Pulling onto the local
    # machine while the user is inside the local same-name session would also
    # kill the running pane (the local session is the destination on pull, and
    # gets stopped before rsync overwrite).
    local current_session
    current_session="$(detect_current_session 2>/dev/null || true)"
    if [[ "$current_session" == "$session" ]]; then
        echo "Error: cannot transfer the session you're inside; detach (Ctrl-b d) and retry" >&2
        return 2
    fi
    # 4. SSH connectivity probe (needed regardless of direction)
    echo "Probing SSH connectivity to $target..."
    if ! _transfer_ssh_probe "$target"; then
        echo "Error: SSH probe to '$target' failed (check ssh config, keys, network)" >&2
        return 1
    fi
    # 5. Local + remote preflight
    if ! _transfer_local_rsync_supports_protect_args; then
        echo "Error: local rsync lacks --protect-args support (upgrade to rsync 3.0+)" >&2
        return 1
    fi
    echo "Running remote preflight on $target..."
    _transfer_remote_preflight "$target" || return 1
    # Pull: now that SSH+preflight passed, confirm the source session exists on remote.
    if $pull; then
        if ! _transfer_remote_session_exists "$target" "$session"; then
            echo "Error: no session '$session' on $target (looked for ~/.ae/sessions/$session/meta)" >&2
            return 1
        fi
        # Steward guard, pull side (review BLOCKER-adjacent): the source meta is
        # REMOTE here — the local grep above cannot see it. Same refusal, same
        # reason: pulling a steward creates a rogue local one and breaks the
        # remote machine's fleet routing.
        if [[ "$(_transfer_read_remote_meta_value "$target" "$session" meta_agent)" == "true" ]]; then
            echo "Error: '$session' on $target is a steward/meta-agent session — transfer is refused." >&2
            echo "Stewards are machine-local. Run 'ae steward --init && ae steward' locally instead." >&2
            return 1
        fi
    fi
    # 6. Path-equality. The work_dir is read from the SOURCE meta; the
    # destination machine must have it. Push: local meta → remote check.
    # Pull: remote meta → local check.
    local work_dir
    if $pull; then
        work_dir="$(_transfer_read_remote_meta_value "$target" "$session" work_dir)"
        [[ -n "$work_dir" ]] || {
            echo "Error: remote meta for session '$session' has no work_dir" >&2
            return 1
        }
        echo "Verifying local path '$work_dir' exists..."
        if [[ ! -d "$work_dir" ]]; then
            echo "Error: local path '$work_dir' does not exist." >&2
            echo "       Same project path is required on both machines. Create the directory" >&2
            echo "       locally (e.g. git clone the same repo at the same path) and retry." >&2
            return 1
        fi
    else
        work_dir="$(read_session_meta "$session" work_dir)"
        [[ -n "$work_dir" ]] || {
            echo "Error: meta for session '$session' has no work_dir" >&2
            return 1
        }
        echo "Verifying remote path '$work_dir' exists..."
        if ! _transfer_check_remote_path "$target" "$work_dir"; then
            echo "Error: remote path '$work_dir' does not exist on $target." >&2
            echo "       Same project path is required on both machines. Create the directory" >&2
            echo "       on $target (or transfer your project tree first) and retry." >&2
            return 1
        fi
    fi
    # 7. Collision check (BEFORE any stop). Push: does remote have the session?
    # Pull: does LOCAL have the session?
    local collision=false
    if $pull; then
        _transfer_local_session_exists "$session" && collision=true
    else
        _transfer_remote_session_exists "$target" "$session" && collision=true
    fi
    if $collision; then
        # Side header — push: remote has it; pull: local has it.
        if $pull; then
            echo "Local already has a session named '$session':"
        else
            echo "Remote already has a session named '$session':"
        fi
        # Local summary (read from local meta if it exists).
        if [[ -f "${local_session_dir}/meta" ]]; then
            echo "  Local:  $(_transfer_session_summary "${local_session_dir}/meta")"
        else
            echo "  Local:  (no local session)"
        fi
        # Remote summary (read from remote meta if it exists).
        local remote_summary
        # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
        remote_summary="$(
            ssh "$target" bash -s <<REMOTE
session=$(_transfer_bash_quote "$session")
meta="\$HOME/.ae/sessions/\$session/meta"
[[ -f "\$meta" ]] || { echo "(no meta)"; exit 0; }
session_name="\$(grep '^session=' "\$meta" | cut -d= -f2-)"
last_active="\$(stat -c %y "\$meta" 2>/dev/null | cut -d. -f1)"
agents=()
while IFS='=' read -r k v; do
    [[ "\$k" =~ ^agent\\. ]] && agents+=("\${v%:*}")
done <"\$meta"
printf 'session=%s last=%s agents=[%s]\n' "\$session_name" "\$last_active" "\${agents[*]:-(none)}"
REMOTE
        )"
        echo "  Remote: $remote_summary"
        # Shared prompt logic — direction-aware messages.
        local prompt_msg overwrite_target
        if $pull; then
            prompt_msg="Overwrite local state? [y/N] "
            overwrite_target="local"
        else
            prompt_msg="Overwrite remote state? [y/N] "
            overwrite_target="remote"
        fi
        if ! $yes; then
            if [[ -t 0 ]]; then
                local answer
                read -r -p "$prompt_msg" answer
                case "$answer" in
                    y | Y | yes | YES) ;;
                    *)
                        echo "Aborted by user. No changes made."
                        return 0
                        ;;
                esac
            else
                echo "Error: $overwrite_target already has session '$session' and no TTY for confirmation." >&2
                echo "       Re-run with --yes to confirm overwrite." >&2
                return 3
            fi
        fi
    fi
    # 8. UUID discovery (read-only, no side effects). Read meta from the
    # source side: push → local meta, pull → remote meta (via SSH+cat).
    echo "Discovering per-agent conversation files..."
    declare -A agent_files=() agent_tools=()
    local agent_summary_parts=()
    local k v slot tool uuid src meta_content
    if $pull; then
        # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
        meta_content="$(
            ssh "$target" bash -s <<REMOTE
session=$(_transfer_bash_quote "$session")
cat "\$HOME/.ae/sessions/\$session/meta" 2>/dev/null
REMOTE
        )" || {
            echo "Error: failed to read remote meta for session '$session'" >&2
            return 1
        }
    else
        meta_content="$(cat "${local_session_dir}/meta")" || {
            echo "Error: failed to read local meta for session '$session'" >&2
            return 1
        }
    fi
    while IFS='=' read -r k v; do
        [[ "$k" =~ ^agent\. ]] || continue
        slot="${k#agent.}"
        # v format: alias:name:uuid
        tool="${v%%:*}"
        uuid="${v##*:}"
        # 'pending' uuids cannot be transferred
        if [[ "$uuid" == "pending" ]]; then
            echo "Warning: slot $slot ($tool) has uuid=pending; skipping conversation file transfer" >&2
            continue
        fi
        case "$tool" in
            claude)
                if $pull; then
                    src="$(_transfer_find_remote_claude_session_file "$target" "$uuid")" || {
                        echo "Error: no remote Claude session file for slot $slot (uuid $uuid) on $target" >&2
                        return 1
                    }
                else
                    src="$(_transfer_find_claude_session_file "$uuid")" || return 1
                fi
                agent_files["$slot"]="$src"
                agent_tools["$slot"]="$tool"
                agent_summary_parts+=("$slot:$tool")
                ;;
            codex)
                if $pull; then
                    src="$(_transfer_find_remote_codex_session_file "$target" "$uuid")" || {
                        echo "Error: no remote Codex session file for slot $slot (uuid $uuid) on $target" >&2
                        return 1
                    }
                else
                    src="$(_transfer_find_codex_session_file "$uuid")" || return 1
                fi
                agent_files["$slot"]="$src"
                agent_tools["$slot"]="$tool"
                agent_summary_parts+=("$slot:$tool")
                ;;
            *)
                echo "Warning: transfer not yet supported for tool '$tool' (slot $slot); agent will start fresh on destination" >&2
                ;;
        esac
    done <<<"$meta_content"
    # 9. Stop helpers — both sides, idempotent. Order doesn't matter for
    # correctness because the stops are independent and idempotent.
    echo "Stopping local session if running..."
    if [[ -d "${local_session_dir}" ]]; then
        _transfer_ensure_stopped "$session" || return 1
    fi
    echo "Stopping remote session if running..."
    _transfer_ensure_stopped_remote "$target" "$session" || {
        echo "Error: failed to stop remote session" >&2
        return 1
    }
    # 10. rsync ae state. rsync does not create missing intermediate
    # directories — pre-create the destination parent (push: remote; pull: local)
    # so a fresh destination doesn't fail mid-pipeline.
    if $pull; then
        mkdir -p "${local_session_dir}" || {
            echo "Error: failed to create local ${local_session_dir}" >&2
            return 1
        }
        echo "Transferring ae session state..."
        rsync -aHA --protect-args --delete \
            --exclude='*.lock' --exclude='*.pid' --exclude='.watchdog.status' --exclude='.shepherd.status' --exclude='.loop.status' \
            "${target}:.ae/sessions/${session}/" "${local_session_dir}/" || {
            echo "Error: rsync of ae state failed" >&2
            return 1
        }
    else
        # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
        ssh "$target" bash -s <<REMOTE || {
session=$(_transfer_bash_quote "$session")
mkdir -p "\$HOME/.ae/sessions/\$session"
REMOTE
            echo "Error: failed to create remote ~/.ae/sessions/$session" >&2
            return 1
        }
        echo "Transferring ae session state..."
        rsync -aHA --protect-args --delete \
            --exclude='*.lock' --exclude='*.pid' --exclude='.watchdog.status' --exclude='.shepherd.status' --exclude='.loop.status' \
            "${local_session_dir}/" "${target}:.ae/sessions/${session}/" || {
            echo "Error: rsync of ae state failed" >&2
            return 1
        }
    fi
    # 11. rsync per-agent conversation files. Direction-aware:
    # push: local src_file → remote (preserving ~/.claude/projects/ or ~/.codex/sessions/ subtree).
    # pull: remote src_file → local (same path on local side).
    local rel_path src_file
    for slot in "${!agent_files[@]}"; do
        src_file="${agent_files[$slot]}"
        tool="${agent_tools[$slot]}"
        if $pull; then
            # src_file is a remote absolute path under /home/<user>/. Compute
            # the relative path under HOME and mirror on local.
            case "$tool" in
                claude) rel_path=".claude/${src_file#*/.claude/}" ;;
                codex) rel_path=".codex/${src_file#*/.codex/}" ;;
            esac
            local local_dest="$HOME/$rel_path"
            mkdir -p "$(dirname "$local_dest")" || {
                echo "Error: failed to create local $(dirname "$local_dest")" >&2
                return 1
            }
            rsync -aHA --protect-args "${target}:${src_file}" "$local_dest" || {
                echo "Error: rsync of $tool session file (slot $slot) failed" >&2
                return 1
            }
        else
            case "$tool" in
                claude) rel_path=".claude/${src_file#"$HOME"/.claude/}" ;;
                codex) rel_path=".codex/${src_file#"$HOME"/.codex/}" ;;
            esac
            # Ensure remote parent dir (per-agent rel_path may contain spaces if
            # Claude's encoded-cwd does — %q-quoted heredoc handles it safely).
            # shellcheck disable=SC2087  # unquoted heredoc is intentional — see _transfer_bash_quote
            ssh "$target" bash -s <<REMOTE
rel_path=$(_transfer_bash_quote "$rel_path")
mkdir -p "\$HOME/\$(dirname "\$rel_path")"
REMOTE
            rsync -aHA --protect-args "$src_file" "${target}:${rel_path}" || {
                echo "Error: rsync of $tool session file (slot $slot) failed" >&2
                return 1
            }
        fi
    done
    # 12. Emit transfer event on the destination side. The `from=` field
    # records the source — local hostname for push (where data originated),
    # the SSH target for pull (the remote we pulled from).
    local summary source_label
    if $pull; then
        source_label="$target"
    else
        source_label="$(hostname)"
    fi
    summary="from=$source_label agents=$(
        IFS=,
        echo "${agent_summary_parts[*]:-none}"
    )"
    if $pull; then
        _transfer_emit_local_event "$session" "$summary" || {
            echo "Warning: failed to emit transfer event locally (transfer itself succeeded)" >&2
        }
    else
        _transfer_emit_destination_event "$target" "$session" "$summary" || {
            echo "Warning: failed to emit transfer event on destination (transfer itself succeeded)" >&2
        }
    fi
    # 13. Success output. Resume hint points at the destination side.
    if $pull; then
        echo "Done. Run 'ae $session' on this machine to resume."
    else
        echo "Done. Run 'ae $session' on $target to resume."
    fi
    return 0
}

cmd_rename() {
    local old_name="" new_name=""
    if [[ $# -ge 2 ]]; then
        old_name="$1"
        new_name="$2"
    elif [[ $# -eq 1 ]]; then
        old_name="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae rename [old-name] <new-name>" >&2
            echo "(Run inside an ae tmux session to rename it without specifying the old name.)" >&2
            return 1
        }
        new_name="$1"
    else
        echo "Usage: ae rename [old-name] <new-name>" >&2
        return 1
    fi
    # Validate new name (no slashes, no colons, tmux-safe)
    if [[ "$new_name" == */* || "$new_name" == *:* || "$new_name" == *.* ]]; then
        echo "Error: session name cannot contain '/', ':', or '.'" >&2
        return 1
    fi
    # Check old session exists
    if ! tmux has-session -t "$old_name" 2>/dev/null; then
        echo "Error: session '${old_name}' is not running." >&2
        return 1
    fi
    # Check new name is not already taken
    if tmux has-session -t "$new_name" 2>/dev/null; then
        echo "Error: session '${new_name}' already exists." >&2
        return 1
    fi
    if [[ -d "${SESSIONS_DIR}/${new_name}" ]]; then
        echo "Error: session directory '${SESSIONS_DIR}/${new_name}' already exists." >&2
        return 1
    fi

    local old_meta="${SESSIONS_DIR}/${old_name}"
    local new_meta="${SESSIONS_DIR}/${new_name}"

    # 1. Rename tmux session
    tmux rename-session -t "$old_name" "$new_name"

    # 1b. Rename the main window to match — but NOT under lead-pair, where window 0
    # carries the ROLE name 'leads' (the session name lives in status-left) and must
    # survive a rename. Decide by the LAYOUT FACT from meta, never by comparing the
    # window name to the session name — a session literally named 'lead' would fool
    # a name check (codex session-shape finding). Meta hasn't moved yet at this step.
    local _ren_layout
    _ren_layout="$(grep '^layout=' "${old_meta}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    if [[ "$_ren_layout" != "lead-pair" ]]; then
        tmux rename-window -t "${new_name}:0" "$(_ae_tmux_format_literal "$new_name")" 2>/dev/null || true
    fi

    # 2. Move session directory
    if [[ -d "$old_meta" ]]; then
        mv "$old_meta" "$new_meta"
    fi

    # 3. Update session= in meta file
    if [[ -f "${new_meta}/meta" ]]; then
        sed -i "s/^session=.*/session=${new_name}/" "${new_meta}/meta"
    fi

    # 4. Regenerate workspace.md (contains session name)
    if [[ -f "${new_meta}/meta" ]]; then
        local work_dir origin mode main_pane
        work_dir="$(grep '^work_dir=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        origin="$(grep '^origin=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        mode="$(grep '^mode=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        main_pane="$(grep '^main_pane=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        regenerate_manifest "$new_name" "${work_dir:-.}" "${origin:-.}" "${mode:-local}" "${main_pane:-%0}" "$new_meta"
        # 4b. Refresh status-left — it carries the SESSION NAME now, which just changed.
        _ae_apply_status_bar "$new_name" "${mode:-local}" "${origin:-.}" "${work_dir:-.}"
    fi

    echo "Renamed '${old_name}' → '${new_name}'"
}

