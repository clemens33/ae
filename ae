# Internal: spawn a new agent pane (called via spawn helper → ae _spawn)
# Is a freshly-launched pane's TUI ready to RECEIVE its brief? Ready means the input is
# CONFIRMED IDLE — not "the process is up", and not "some marker is somewhere on screen".
#
# The marker grep this replaces ('❯|bypass permissions|for shortcuts') answered a
# different question than the caller was asking. claude's trust dialog renders
# '❯ 1. Yes, I trust this folder' — and that BARE ORNAMENT alone was the whole match: the
# real captured dialog contains neither 'bypass permissions' nor 'for shortcuts' (they
# belong to the composed TUI's footer, which is not drawn yet). So a modal read READY and
# the brief was pasted into it, where Enter answers the dialog rather than submitting
# (colead ROUND5 BLOCKER 2). One incidental glyph was enough — which is the argument for
# a predicate over a marker, not for a longer marker list.
#
# For modeled tools this is the SAME structural predicate the send path uses, so spawn
# can no longer disagree with it: a booting TUI has no live prompt (indeterminate ->
# unsafe -> not ready), and a modal is occupied (-> not ready). Unmodeled TUIs have no
# predicate — _paste_input_busy reports them safe unconditionally, which would mean
# "ready" the instant the pane exists, i.e. the boot-gap paste this poll exists to
# prevent. They keep the marker, which is weaker but is what they had before.
_spawn_input_ready() { # <pane> <tool_kind>
    local pane="$1" tool_kind="$2"
    case "$tool_kind" in
        claude | codex)
            if _paste_input_busy "$pane" "$tool_kind"; then
                return 1 # busy / modal / unreadable -> NOT ready
            fi
            return 0
            ;;
        *)
            tmux capture-pane -p -t "$pane" 2>/dev/null |
                grep -qE '❯|bypass permissions|for shortcuts' || return 1
            return 0
            ;;
    esac
}

_cmd_spawn() {
    local meta_dir="$1"
    shift
    local alias_arg="$1"
    shift
    local alias_name="${alias_arg%%:*}"
    local spawn_name=""
    [[ "$alias_arg" == *:* ]] && spawn_name="${alias_arg#*:}"
    # Name must not contain ':' (used as delimiter in meta format)
    if [[ "$spawn_name" == *:* ]]; then
        echo "Error: agent name cannot contain ':' — use alias:name format" >&2
        return 1
    fi
    local user_prompt="${*:-}"

    # Resolve caller's agent identity (the pane that ran spawn)
    local caller_pane caller_agent
    caller_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
    caller_agent=""
    if [[ -n "$caller_pane" ]]; then
        caller_agent="$(tmux display-message -t "$caller_pane" -p '#{@ae_agent}' 2>/dev/null || true)"
    fi

    # Build spawn prompt with reply-back instruction
    local prompt
    if [[ -n "$user_prompt" ]]; then
        if [[ -n "$caller_agent" ]]; then
            prompt="${user_prompt} — When done, reply back via: ${meta_dir}/send \"${caller_agent}\" \"<your reply>\""
        else
            prompt="$user_prompt"
        fi
    else
        prompt="You were spawned into an ae workspace. Read ${meta_dir}/workspace.md for details."
    fi

    # Read meta
    declare -A meta=()
    while IFS='=' read -r k v; do
        case "$k" in
            mode | origin | session | work_dir | layout | config | main_pane) meta["$k"]="$v" ;;
        esac
    done <"$meta_dir/meta"

    local session="${meta[session]:-}" work_dir="${meta[work_dir]:-}" layout="${meta[layout]:-vertical}"
    local config_file="${meta[config]:-}" main_pane="${meta[main_pane]:-}"
    local origin="${meta[origin]:-}" mode="${meta[mode]:-}"

    if [[ -z "$session" ]]; then
        echo "Error: session not found in metadata" >&2
        return 1
    fi
    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Error: session '$session' not running" >&2
        return 1
    fi

    CONFIG_FILE="$config_file"
    # Wire up per-project config from session's origin directory
    AE_LOCAL_CONFIG=""
    if [[ -n "$origin" ]] && [[ -f "${origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${origin}/.ae/config"
    fi
    local cmd
    cmd="$(get_config "agents.${alias_name}")"
    if [[ -z "$cmd" ]]; then
        echo "Error: agent '${alias_name}' not defined in $config_file" >&2
        return 1
    fi

    # New window per worker: spawned agents get their own tmux window so the
    # main window keeps the lead layout untouched and N parallel workers stay
    # usable. -d: don't steal the caller's focus. (The window is renamed to
    # the worker's role name after the meta flock resolves it.)
    local pane_id
    pane_id="$(tmux new-window -d -t "${session}:" -c "$work_dir" -P -F '#{pane_id}')"

    # Register spawned agent in meta (flock-protected to prevent races)
    local session_id tool_kind next_idx slot launch_id
    session_id="$(resolve_agent_session_id "$cmd" "spawned.0")"
    tool_kind="$(tool_kind_from_cmd "$cmd")"
    {
        flock -w 5 200 || {
            echo "Error: could not lock meta" >&2
            return 1
        }
        next_idx=0
        while grep -q "^agent\\.spawned\\.${next_idx}=" "$meta_dir/meta" 2>/dev/null; do
            next_idx=$((next_idx + 1))
        done
        slot="spawned.${next_idx}"
        [[ -z "$spawn_name" ]] && spawn_name="helper-${next_idx}"
        session_id="$(resolve_agent_session_id "$cmd" "$slot")"
        echo "agent.${slot}=${alias_name}:${spawn_name}:${session_id}" >>"$meta_dir/meta"
        echo "agent_bin.${slot}=$(extract_binary_from_cmd "$cmd")" >>"$meta_dir/meta"
        if tool_kind_supports_launch_id "$tool_kind"; then
            launch_id="$(gen_uuid)"
            echo "launch_id.${slot}=${launch_id}" >>"$meta_dir/meta"
        fi
    } 200>"$meta_dir/meta.lock"

    # Label pane + name the worker's window (after flock so spawn_name is
    # resolved; explicit rename-window also disables tmux automatic-rename).
    tmux select-pane -t "$pane_id" -T "ae:${alias_name}:${spawn_name}"
    tmux set-option -p -t "$pane_id" @ae_agent "${alias_name}:${spawn_name}"
    tmux set-option -p -t "$pane_id" @ae_slot "${slot}"
    tmux rename-window -t "$pane_id" "$(_ae_tmux_format_literal "$spawn_name")" 2>/dev/null || true

    # Regenerate workspace.md from live panes
    regenerate_manifest "$session" "$work_dir" "$origin" "$mode" "$main_pane" "$meta_dir"

    # Wait for new pane's shell to initialize before sending commands
    sleep 0.3

    # Launch agent with session-scoped ID and ae workspace context
    local scoped_cmd initial_msg
    scoped_cmd="$(inject_session_id "$cmd" "$session_id")"
    scoped_cmd="$(inject_ae_context "$scoped_cmd" "$meta_dir" "$session" "$work_dir" "$slot")"
    # For agents without system prompt injection, combine workspace context + spawn prompt
    initial_msg="$(initial_prompt_for_cmd "$cmd" "$meta_dir" "$session" "$work_dir" "$slot")"
    if [[ -n "$initial_msg" ]]; then
        initial_msg="${initial_msg} --- ${prompt}"
    fi
    send_agent_cmd "$pane_id" "$scoped_cmd" "$initial_msg" "$meta_dir" "$slot"

    # Post-launch: capture agent session ID if needed
    start_capture_session_id "$tool_kind" "$pane_id" "$slot" "$meta_dir"

    # Brief-delivered truth, tracked separately from pane-created truth (see the outer
    # contract below). Tools WITHOUT system-prompt injection carry the brief in
    # initial_msg, which send_agent_cmd already delivered as the first message — for those
    # there is no separate paste to fail, so delivery is settled here.
    local _delivered=1 _fail_reason=""

    # For agents with system prompt injection, send spawn prompt separately
    if [[ -z "$initial_msg" ]]; then
        # Wait for the TUI to actually ACCEPT input before pasting.
        # wait_for_agent_start only proves the process is running — pasting in the boot
        # gap is swallowed wholesale, with nothing staged for the lingering-nudge below
        # to detect (live-dogfood finding: workers booted brief-less twice).
        local _ready_i=0 _ready=0
        while ((_ready_i < 30)); do
            if _spawn_input_ready "$pane_id" "$tool_kind"; then
                _ready=1
                break
            fi
            sleep 0.5
            _ready_i=$((_ready_i + 1))
        done
        if ((_ready == 0)); then
            # DO NOT paste into a state we could not confirm idle. The old code polled
            # for any of '❯|bypass permissions|for shortcuts' and pasted on timeout
            # regardless — so claude's trust dialog ('❯ 1. Yes, I trust this folder')
            # read READY and the brief went INTO THE MODAL, where Enter answers the
            # dialog instead (colead ROUND5 BLOCKER 2). Leave the pane untouched — the
            # brief is re-sendable, a clobbered modal is not — and record NOT-DELIVERED
            # so the caller sees it (colead ROUND6: stderr alone let the positive path
            # run on and claim success).
            _delivered=0
            _fail_reason="input never reached a confirmed-idle state (busy, modal, or unreadable)"
        else
            tmux select-pane -t "$pane_id"
            # Launch paste is best-effort for DELIVERY, but never silent: a slow TUI
            # whose paste stays staged past the bounded verify-retries returns non-zero
            # and this runs under set -e, so the status is captured rather than dropped.
            # The old bare `|| true` discarded exactly the signal that says "your worker
            # never got its brief".
            local _paste_rc=0
            tmux_paste_submit "$pane_id" "$prompt" || _paste_rc=$?
            if ((_paste_rc != 0)); then
                # Staged past the bounded verify-retries: the text may be sitting unsent
                # in the box. UNCONFIRMED is not delivered, and must not read as success.
                _delivered=0
                _fail_reason="brief submit UNCONFIRMED (tmux_paste_submit rc=$_paste_rc) — it may be staged unsent"
            fi
        fi
        if ((_ready == 1)); then
            # A booting TUI can swallow the quick post-paste Enter, leaving the prompt
            # staged in the input box (live-dogfood find). Verify the text actually left
            # the input; nudge Enter once more if it lingers. Only when we actually
            # pasted — never blind-Enter a pane we deliberately did not touch.
            sleep 1.5
            if tmux capture-pane -p -t "$pane_id" 2>/dev/null | tail -n 6 |
                grep -qF "${prompt:0:40}"; then
                tmux send-keys -t "$pane_id" Enter
            fi
        fi
    fi

    # PANE-CREATED and BRIEF-DELIVERED are different truths, and only the second one
    # means the worker was assigned its task. Conflating them is how a delivery failure
    # became a success at the caller: both failure branches printed to stderr and then
    # control ran on to the positive line, a task-bearing action=spawn event, and rc=0 —
    # so supervision saw an assigned worker whose brief was absent, and automation could
    # not tell (colead ROUND6 BLOCKER, caller-probed). stderr is for humans; rc and the
    # event log are the machine-visible contract, and they must agree with reality.
    if ((_delivered == 0)); then
        # The pane EXISTS and is in meta — say so, so nobody respawns a duplicate — but
        # report failure and never claim the task was assigned. The brief is preserved on
        # disk rather than quoted into the message: it is arbitrary multi-line text, and a
        # '<the brief>' placeholder is not a resend path anyone can run (colead ROUND6).
        local _brief_file="${meta_dir}/undelivered.${alias_name}-${spawn_name}.txt"
        printf '%s' "$prompt" >"$_brief_file" 2>/dev/null || _brief_file=""
        [[ -n "$_brief_file" ]] && chmod 600 "$_brief_file" 2>/dev/null
        echo "ae: SPAWN INCOMPLETE — ${alias_name}:${spawn_name} exists in pane ${pane_id}, brief NOT delivered" >&2
        echo "ae: reason: ${_fail_reason}" >&2
        echo "ae: do NOT respawn (the pane is live) — send to the existing agent:" >&2
        if [[ -n "$_brief_file" ]]; then
            echo "ae:   ${meta_dir}/send ${alias_name}:${spawn_name} \"\$(cat ${_brief_file})\"" >&2
        else
            echo "ae:   ${meta_dir}/send ${alias_name}:${spawn_name} '<re-send your brief>'" >&2
        fi
        # An explicit delivery-failed FACT, not silence: supervision reads this log, and a
        # missing event is indistinguishable from a spawn that never happened. It carries
        # NO task summary — nothing here assigned that task.
        _spawn_emit_event "$meta_dir" "${caller_agent:-human}" "${alias_name}:${spawn_name}" \
            "spawn-failed" "brief not delivered: ${_fail_reason}"
        return 1
    fi

    echo "Spawned ${alias_name}:${spawn_name} in pane $pane_id"
    _spawn_emit_event "$meta_dir" "${caller_agent:-human}" "${alias_name}:${spawn_name}" \
        "spawn" "$(printf '%.200s' "${user_prompt:-}" | tr '\n\t' '  ')"
    return 0
}

# Append one event to the session log. Inline-equivalent of ae_emit_event — _cmd_spawn
# runs outside the _lib context — kept as its own function so the spawn path has exactly
# ONE event writer and the success/failure calls cannot drift apart.
_spawn_emit_event() { # <meta_dir> <actor> <target> <action> <summary>
    local meta_dir="$1" actor="$2" target="$3" action="$4" summary="$5"
    local _esc _actor _target _summary _ts _json
    _esc() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        s="${s//$'\r'/\\r}"
        printf '%s' "$s"
    }
    _actor="$(_esc "$actor")"
    _target="$(_esc "$target")"
    _summary="$(_esc "$summary")"
    _ts="$(date -u +%FT%TZ)"
    _json="$(printf '{"ts":"%s","actor":"%s","action":"%s","target":"%s"' "$_ts" "$_actor" "$action" "$_target")"
    [[ -n "$_summary" ]] && _json+="$(printf ',"summary":"%s"' "$_summary")"
    _json+="}"
    { flock -w 5 8 && printf '%s\n' "$_json" >>"$meta_dir/events.jsonl"; } 8>>"$meta_dir/events.jsonl.lock"
    return 0
}

# Internal: retire a spawned agent (called via retire helper → ae _retire)
_cmd_retire() {
    local meta_dir="$1"
    shift
    local target="$1"

    # Read meta
    declare -A meta=()
    while IFS='=' read -r k v; do
        case "$k" in
            mode | origin | session | work_dir | layout | config | main_pane) meta["$k"]="$v" ;;
        esac
    done <"$meta_dir/meta"

    local session="${meta[session]:-}" work_dir="${meta[work_dir]:-}"
    local main_pane="${meta[main_pane]:-}" origin="${meta[origin]:-}" mode="${meta[mode]:-}"

    if [[ -z "$session" ]]; then
        echo "Error: session not found in metadata" >&2
        return 1
    fi

    # Resolve agent name to pane ID
    local resolved="" pane_agent=""
    if [[ "$target" == %* ]]; then
        # Validate pane belongs to this session
        local pane_in_session=false
        while IFS=$'\t' read -r pid aagent; do
            if [[ "$pid" == "$target" ]]; then
                resolved="$target"
                pane_agent="$aagent"
                pane_in_session=true
                break
            fi
        done < <(tmux list-panes -s -t "$session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)
        if [[ "$pane_in_session" == false ]]; then
            echo "Error: pane '${target}' not found in session '${session}'" >&2
            return 1
        fi
    else
        local bare_match="" bare_count=0
        while IFS=$'\t' read -r pid aagent; do
            if [[ "$aagent" == "$target" ]]; then
                resolved="$pid"
                pane_agent="$aagent"
                break
            fi
            local aname="${aagent#*:}"
            if [[ "$aname" == "$target" ]]; then
                bare_match="$pid"
                pane_agent="$aagent"
                bare_count=$((bare_count + 1))
            fi
        done < <(tmux list-panes -s -t "$session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)
        if [[ -z "$resolved" && "$bare_count" -eq 1 ]]; then
            resolved="$bare_match"
        elif [[ -z "$resolved" ]]; then
            if [[ "$bare_count" -gt 1 ]]; then
                echo "Error: ambiguous name '${target}' — use alias:name format" >&2
            else
                echo "Error: agent '${target}' not found" >&2
            fi
            return 1
        fi
    fi

    # Prevent retiring the main agent
    if [[ "$resolved" == "$main_pane" ]]; then
        echo "Error: cannot retire the main agent — use 'ae end' instead" >&2
        return 1
    fi

    # Verify it's a spawned agent (exists in meta as agent.spawned.*)
    local spawned_key=""
    while IFS='=' read -r k v; do
        if [[ "$k" == agent.spawned.* ]]; then
            local entry_alias_name="${v%%:*}"
            local entry_rest="${v#*:}"
            local entry_name="${entry_rest%%:*}"
            if [[ "${entry_alias_name}:${entry_name}" == "$pane_agent" ]]; then
                spawned_key="$k"
                break
            fi
        fi
    done <"$meta_dir/meta"

    if [[ -z "$spawned_key" ]]; then
        # Also check worker agents
        if grep -q "^agent\\.worker\\..*=${pane_agent}:" "$meta_dir/meta" 2>/dev/null; then
            echo "Error: cannot retire a worker agent — use 'ae end' instead" >&2
        else
            echo "Error: agent '${target}' not found in spawned agents" >&2
        fi
        return 1
    fi

    # Kill the pane
    tmux kill-pane -t "$resolved" 2>/dev/null || true

    # Remove the meta entries (flock-protected)
    local spawned_slot="${spawned_key#agent.}"
    {
        flock -w 5 200 || {
            echo "Error: could not lock meta" >&2
            return 1
        }
        local tmpfile="${meta_dir}/meta.tmp.$$"
        grep -v -e "^${spawned_key}=" -e "^agent_bin\\.${spawned_slot}=" \
            -e "^launch_id\\.${spawned_slot}=" -e "^launch_time\\.${spawned_slot}=" \
            -e "^[a-z]*_launch_id\\.${spawned_slot}=" -e "^[a-z]*_launch_time\\.${spawned_slot}=" \
            "$meta_dir/meta" >"$tmpfile"
        mv "$tmpfile" "$meta_dir/meta"
    } 200>"$meta_dir/meta.lock"
    # The worker's launch script is dead weight once the pane is gone.
    rm -f "${meta_dir}/launch.${spawned_slot}.sh"
    # (No layout rebalance: the worker lived in its own window — killing the
    # pane closed that window; the main window's layout was never touched.)

    # Regenerate manifest
    CONFIG_FILE="${meta[config]:-}"
    AE_LOCAL_CONFIG=""
    if [[ -n "$origin" ]] && [[ -f "${origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${origin}/.ae/config"
    fi
    regenerate_manifest "$session" "$work_dir" "$origin" "$mode" "$main_pane" "$meta_dir"

    echo "Retired ${pane_agent} (pane ${resolved})"
    # Emit event (inline — _cmd_retire runs outside _lib context)
    local _esc _actor _target _ts _json
    _esc() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        s="${s//$'\r'/\\r}"
        printf '%s' "$s"
    }
    _actor="$(tmux display-message -p '#{@ae_agent}' 2>/dev/null || true)"
    [[ -n "$_actor" ]] || _actor="human"
    _actor="$(_esc "$_actor")"
    _target="$(_esc "$pane_agent")"
    _ts="$(date -u +%FT%TZ)"
    _json="$(printf '{"ts":"%s","actor":"%s","action":"retire","target":"%s"}' "$_ts" "$_actor" "$_target")"
    { flock -w 5 8 && printf '%s\n' "$_json" >>"$meta_dir/events.jsonl"; } 8>>"$meta_dir/events.jsonl.lock"
}

# Regenerate workspace.md from live tmux pane state
# Scans panes with ae: title prefix, builds agent table
regenerate_manifest() {
    local sess="$1" wdir="$2" origin="$3" mode="$4" main_pane="$5" sessions_dir="$6"
    local manifest="${sessions_dir}/workspace.md"

    # Describe copy mode
    local copy_desc
    case "$mode" in
        git) copy_desc="Isolated git worktree at a DETACHED HEAD from origin (not a named branch yet) — work boldly here. The origin checkout at ${origin} is OFF-LIMITS. Untracked files (deps, .env) do not exist here; install locally. 'ae end' commits + pushes to a new ae/${sess} branch." ;;
        full) copy_desc="Full copy of the project in a separate directory. The origin at ${origin} is off-limits. Changes reach the project only via 'ae end' (branch push)." ;;
        local) copy_desc="You are in the human's LIVE checkout (local mode) — their uncommitted work may be present. One writer per file; no destructive git operations; never assume the tree is yours alone." ;;
    esac

    # Build agent rows from live panes (using @ae_agent option, immune to title overrides)
    local agent_rows=""
    # local! — bash dynamic scoping: without it this read-loop CLOBBERS the
    # CALLER's pane_id (_cmd_spawn's freshly created worker pane went empty →
    # every later paste hit -t '' = the active pane; found via live dogfood).
    local pane_id ae_agent
    while IFS=$'\t' read -r pane_id ae_agent; do
        [[ -n "$ae_agent" ]] || continue
        local alias_name="${ae_agent%%:*}"
        local agent_name="${ae_agent#*:}"
        agent_name="${agent_name%%:*}" # guard against nested colons
        local role="agent"
        [[ "$pane_id" == "$main_pane" ]] && role="lead"
        local cmd tool_label
        cmd="$(get_config "agents.${alias_name}")"
        tool_label="$(tool_name_from_cmd "${cmd:-$alias_name}")"
        agent_rows="${agent_rows}| ${alias_name}:${agent_name} | ${tool_label} | ${role} | ${pane_id} |
"
    done < <(tmux list-panes -s -t "$sess" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)

    # Collect available aliases from config for spawn section
    local available_aliases=""
    while IFS= read -r entry; do
        if [[ "$entry" == agents.* ]]; then
            local aname="${entry%%=*}"
            aname="${aname#agents.}"
            if [[ -n "$available_aliases" ]]; then
                available_aliases="${available_aliases}, ${aname}"
            else
                available_aliases="$aname"
            fi
        fi
    done < <(parse_config)

    cat >"$manifest" <<EOF
# ae workspace

Session: ${sess}
Origin: ${origin}
Directory: ${wdir}
Mode: ${mode}

${copy_desc}

## Agents

| Agent | Tool | Role | Pane |
|-------|------|------|------|
${agent_rows}
## Communication

Send a message to another agent by name:
\`\`\`bash
${sessions_dir}/send "<agent_name>" "your message"
\`\`\`

Ask another agent a question and require a reply:
\`\`\`bash
${sessions_dir}/ask <agent_name> "your question"
\`\`\`

Request a critical review:
\`\`\`bash
${sessions_dir}/review <agent_name> "review request"
\`\`\`

Reply to a logged request by request id:
\`\`\`bash
${sessions_dir}/reply <request_id> "your reply"
\`\`\`

Inspect request state without peeking panes:
\`\`\`bash
${sessions_dir}/requests
${sessions_dir}/requests inbox
\`\`\`

Declare your current work state. It shows in \`ae list\` (per agent). Your \`waiting-user\`/\`blocked\` contribute to the session \`attn:\` marker; \`ae list\` may also show watchdog-derived reasons (\`dead\`/\`stale\`/\`throttled\`). The watchdog stops nudging on any quiet state: \`done\` until a newer message arrives; \`waiting-user\`/\`blocked\` until the pane changes (e.g. the human replies), then nudging resumes:
\`\`\`bash
${sessions_dir}/state working "starting on X"
${sessions_dir}/state waiting-user "need clarification on Y"
${sessions_dir}/state blocked "waiting for codex review on req-Z"   # reason required
${sessions_dir}/state done "shipped X"
${sessions_dir}/state                                                # print current state
\`\`\`

\`mark-done "<summary>"\` is preserved as shorthand for \`state done\`. Declare \`working\` on every new task, \`waiting-user\` only after asking the human, \`blocked\` only with a concrete external blocker.

Record durable findings, decisions, and handoffs in shared session memory:
\`\`\`bash
${sessions_dir}/memo add "important shared fact"
${sessions_dir}/memo add --topic arch "we chose SQLite over Postgres"
${sessions_dir}/memo read
${sessions_dir}/memo read --topic arch
${sessions_dir}/memo tail 5
\`\`\`

Memo entries are append-only and stored in \`${sessions_dir}/memo.tsv\`. Use memo for durable shared context, not full chat transcripts.

The session can carry a one-line goal — what this session is FOR. It shows in \`ae list\` and the watchdog quotes it when nudging idle agents:
\`\`\`bash
${sessions_dir}/goal                       # show the current session goal
${sessions_dir}/goal "ship the PR for X"   # set it
${sessions_dir}/goal --clear               # remove it
\`\`\`

When another agent sends you a question, task, or review request, reply via the exact \`reply\` or \`send\` command included in that message:
\`\`\`bash
${sessions_dir}/send "<their_agent_name>" "your reply"
\`\`\`

Do not infer the recipient. Do not reply only in your own pane output. Do not poll or capture panes to wait for replies — answers arrive as incoming messages.

## Talking to the human on Telegram

If the human messages you from Telegram, answer with \`say\` — your normal pane
output does NOT reach their phone:
\`\`\`bash
${sessions_dir}/say "done — the menu is live, tested end to end"
echo "a longer, multi-line reply" | ${sessions_dir}/say   # stdin for long text
\`\`\`
\`say\` emits a \`chat\` event the Telegram bridge forwards (when running with
\`chat\` in its include filter). The human can reply to your message on Telegram
and it routes straight back to you.

## Peek

View recent output from another agent's pane:
\`\`\`bash
${sessions_dir}/peek <agent_name> [lines]
\`\`\`
\`\`\`bash
${sessions_dir}/peak <agent_name> [lines]
\`\`\`

Default: 80 lines. Max: 2000. Use peek/peak for inspection only, not as a reply mechanism.

## Agents

List all agents in the session:
\`\`\`bash
${sessions_dir}/agents
\`\`\`

## Focus

Switch to another agent's pane:
\`\`\`bash
${sessions_dir}/focus <agent_name>
\`\`\`

## Interrupt

Stop an agent's current generation and optionally redirect:
\`\`\`bash
${sessions_dir}/interrupt <agent_name> [message]
\`\`\`

Without a message, just cancels current work. With a message, cancels then sends new instructions.

## Spawn

Add another agent to this workspace (it gets its own tmux window, named
after its role — the main window's layout is untouched):
\`\`\`bash
${sessions_dir}/spawn <alias>:<name> [prompt]
\`\`\`

Always give spawned agents a descriptive role name (e.g. \`codex:reviewer\`, \`claude:pair-programmer\`).

Available aliases: ${available_aliases} (from ~/.ae/config)

## Delegation

The lead stays on the strongest model; bounded subtasks go to spawned workers
on cheaper/faster tiers, then get retired. The win is CONTEXT HYGIENE first
(a worker burns its own context exploring and returns a distilled summary —
your strategic context stays clean), parallelism second, cost third.

**Spawn a worker when** the task specs in ~10 lines, has a clear stop
condition, and the result is verifiable (tests, grep, focused review):
test/CI runs, scoped mechanical edits, callers/usage scans, log triage,
doc syncs, independent review lanes. **Do it yourself when** the hard part
is judgment: architecture, ambiguous debugging, final integration, anything
needing your accumulated context. **Prefer ae \`spawn\` over your harness's own
subagents** (e.g. Claude Code's Task tool) for anything beyond a quick or
bursty read-only lookup/fan-out consumed immediately (a ten-window parallel
scan is noise — harness-native fan-out is right there): ae workers are
visible to the human (own window),
steward-monitored, messageable, and survive your context compaction —
internal subagents are invisible to everyone but you. Internal subagents
remain fine for fast same-harness reads whose result you consume
immediately.

Conventions:
- Alias = the model (\`opus48\`/\`fable5\`/\`sonnet5\`/\`gpt56sol\`/\`gpt56luna\`…
  — whatever ~/.ae/config defines); name = role. Good: \`sonnet5:tests\`,
  \`gpt56luna:callers\`, \`opus48:docs-sync\`. Bad: \`worker\`, \`helper-3\`.
- Brief contract: objective, allowed scope/files, verification command,
  expected reply shape, whether edits are allowed.
- Result contract (worker replies with): Outcome / Changed / Verified (command
  + result) / Risks / Need-from-lead. No raw logs unless asked.
- Lifecycle: worker declares \`state working\` on start, \`state done\` when
  finished, then WAITS. The lead reviews the output/diff, then
  \`retire <name>\` — workers never self-retire (the pane must survive until
  reviewed). Use \`memo\` only for durable findings that outlive the pane.
- One writer per file: in local mode the lead assigns scope; for parallel
  write-heavy work use separate worktrees or sessions.

## Retire

Remove a spawned agent from the workspace:
\`\`\`bash
${sessions_dir}/retire <agent_name|pane_id>
\`\`\`

Kills the pane, removes meta entry, and updates the manifest. Only works on spawned agents.

## Cross-session

All helpers support targeting agents in other ae sessions using \`@session:agent\` syntax:
\`\`\`bash
${sessions_dir}/peek @other-session:claude:lead 20
${sessions_dir}/send @other-session:codex:reviewer "check the API"
\`\`\`

List all agents across all running sessions:
\`\`\`bash
${sessions_dir}/agents --all
\`\`\`

## Rules

- Coordinate file edits -- don't modify the same file simultaneously
- The human can see all panes and may intervene at any time
- Always use the send helper above to communicate with other agents (never raw tmux send-keys)
EOF
}

# --- Agent launch helper (must be defined before dispatcher for _spawn) ---
send_agent_cmd() {
    local pane="$1" cmd="$2" prompt="$3" meta_dir="$4" slot="$5"
    local tool_kind launch_cmd launch_script launch_exec current

    tool_kind="$(tool_kind_from_cmd "$cmd")"
    launch_cmd="$(build_launch_command "$cmd" "$prompt")"
    launch_script="$(write_launch_script "$meta_dir" "$slot" "$launch_cmd")"
    launch_exec="$(shell_quote "$launch_script")"

    # || true: fire-and-forget launch paste (of the launch command into the
    # shell) must not abort the launch on an unconfirmed submit — see the 3
    # $prompt sites. Safe today (shell tool -> return 0), guarded defensively.
    tmux_paste_submit "$pane" "$launch_exec" || true
    # Brief wait to confirm launch started (don't block attach on slow agent init)
    wait_for_agent_start "$pane" "$tool_kind" 10 || true

    case "$cmd" in
        codex*resume*)
            # codex resume doesn't accept inline prompts — send it after the UI comes back.
            if [[ -n "$prompt" ]]; then
                (
                    sleep 3 &&
                        if [[ "$(pane_current_command "$pane")" == "codex" ]]; then
                            tmux select-pane -t "$pane"
                            tmux_paste_submit "$pane" "$prompt" || true # fire-and-forget launch paste
                        fi
                ) &
            fi
            ;;
        opencode*)
            # OpenCode has no system prompt flag — launch TUI, then paste context as first message.
            if [[ -n "$prompt" ]]; then
                (
                    sleep 3 &&
                        if [[ "$(pane_current_command "$pane")" == "opencode" ]]; then
                            tmux select-pane -t "$pane"
                            tmux_paste_submit "$pane" "$prompt" || true # fire-and-forget launch paste
                        fi
                ) &
            fi
            ;;
    esac
}

# --- ae steward: meta-agent launcher (deprecated alias: ae hub) ---
# Copy one template file to its destination, NO overwrite, substituting a single
# __PLACEHOLDER__ via bash param expansion (no sed → safe with '/' in the value).
# Reports created vs skipped per file so partial dirs are handled explicitly.
_steward_scaffold_file() {
    local src="$1" dst="$2" content
    shift 2 # remaining args are placeholder/value pairs
    if [[ -e "$dst" ]]; then
        echo "  skipped (exists): $dst"
        return 0
    fi
    content="$(cat "$src" 2>/dev/null)" || {
        echo "  ERROR reading template $src" >&2
        return 1
    }
    # Two-phase substitution so an inserted VALUE is never rescanned by a later
    # placeholder (codex: sequential ${//} reprocesses inserted text). Phase 1
    # maps every placeholder to a unique SOH-delimited sentinel (no values yet);
    # phase 2 maps sentinels to values. A real path value can't contain a \x01, so
    # phase-2 insertions can never collide — making it order-independent.
    local -a _ph _val
    local _n=0 soh=$'\x01'
    while (($# >= 2)); do
        _ph[_n]="$1"
        _val[_n]="$2"
        _n=$((_n + 1))
        shift 2
    done
    local _i
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${_ph[_i]}/${soh}${_i}${soh}}"
    done
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${soh}${_i}${soh}/${_val[_i]}}"
    done
    printf '%s\n' "$content" >"$dst" || {
        echo "  ERROR writing $dst" >&2
        return 1
    }
    echo "  created: $dst"
}

# Scaffold ~/.ae/steward/{steward.config,CHARTER.md} from contrib/aesteward
# templates. Always scaffolds the NEW steward layout; an existing legacy
# ~/.ae/meta-hub scaffold keeps working via the launch-time fallback below.
cmd_steward_init() {
    local steward_dir="${AE_STEWARD_DIR:-$CONFIG_DIR/steward}"
    # Reject a dir that would break the INI double-quoted instructions value.
    case "$steward_dir" in
        *'"'* | *$'\n'*)
            echo "Error: AE_STEWARD_DIR contains an unsupported character (quote/newline): $steward_dir" >&2
            return 1
            ;;
    esac
    # Resolve template dir relative to THIS script (symlink-aware) with a
    # realpath/echo fallback — never hard-depend on readlink being present.
    local self tdir aemon_path charter_path helpers_dir
    self="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        echo "${BASH_SOURCE[0]:-$0}")"
    tdir="$(dirname "$self")/contrib/aesteward"
    if [[ ! -d "$tdir" ]]; then
        echo "Error: steward templates not found at $tdir." >&2
        echo "(single-file install?) Create $steward_dir/steward.config + CHARTER.md by hand." >&2
        return 1
    fi
    mkdir -p "$steward_dir" || return 1
    # Canonicalize to an ABSOLUTE dir so a relative AE_STEWARD_DIR doesn't bake a
    # relative charter path into steward.config — `ae steward` later cd's into the
    # dir, so `rel/CHARTER.md` would wrongly resolve to `rel/rel/CHARTER.md`.
    steward_dir="$(cd "$steward_dir" && pwd -P)" || return 1
    charter_path="$steward_dir/CHARTER.md"
    aemon_path="$(dirname "$self")/contrib/aemonitor/aemonitor"
    # The steward session is always named `steward`; its helper scripts live here.
    # Baked into the charter so it's correct under any AE_HOME (default
    # ~/.ae/sessions/steward, isolated e2e runs $AE_HOME/sessions/steward) — never
    # the wrong (live) ~/.ae.
    helpers_dir="$CONFIG_DIR/sessions/steward"
    echo "Scaffolding steward into $steward_dir:"
    # CHARTER.md first (the config points at it).
    _steward_scaffold_file "$tdir/CHARTER.md" "$charter_path" \
        "__AEMONITOR_PATH__" "$aemon_path" "__HELPERS_DIR__" "$helpers_dir" || return 1
    _steward_scaffold_file "$tdir/steward.config" "$steward_dir/steward.config" "__CHARTER_PATH__" "$charter_path" || return 1
    echo
    echo "Done. Review/edit those files, then run: ae steward"
}

cmd_steward_help() {
    cat <<'EOF'
ae steward — launch the steward: your fleet's chief of staff. One ae session that
monitors all your other ae sessions, briefs you, relays your instructions to them,
and helps you hold an objective once you set one. `ae hub` is the deprecated alias.

  ae steward           ensure the session is running (detached, isolated config)
  ae steward --attach  switch/attach to it
  ae steward --init    scaffold ~/.ae/steward/{steward.config,CHARTER.md} (never overwrites)
  ae steward --help    this help

Config dir: ~/.ae/steward (or $AE_HOME/steward when AE_HOME is set; override with
AE_STEWARD_DIR). A legacy ~/.ae/meta-hub scaffold (from 'ae hub --init') is still
honoured at launch and keeps its `hub` session name. See contrib/aesteward/README.md.
EOF
}

# --- Dispatcher ---
# ── Session-helper template library ──────────────────────────────────
# Functions below are EMITTED into generated session helpers (_lib and
# the declare-f migrated helpers) via `declare -f` at the emission sites
# inside the SYNC_SESSION_ASSETS_BODY region. They are defined at top
# level BEFORE the dispatcher so every execution path — launch, and
# dispatcher subcommands like doctor --refresh (which awk-sources that
# region) — has them loaded prior to any emission. They execute inside a
# generated helper's runtime (after `source _lib`, which provides
# _AE_META_DIR/_AE_SESSION/_AE_SESSIONS_DIR): ae's own code paths must
# not call them. Shared bodies ae itself also uses (ae_json_escape,
# _event_json_str) live at their long-standing top-level sites instead.

helper_state_usage() {
    cat >&2 <<'USAGE'
Usage: state <working|waiting-user|blocked|done> [reason]
       state                              # print current state

  working       actively making progress
  waiting-user  needs human input
  blocked       stuck on external dep — REASON REQUIRED
  done          complete or paused
USAGE
    exit 2
}

helper_state_main() {
    local self
    self="$(ae_current_agent_ref)"
    [[ -n "$self" ]] || self="human"

    if [[ $# -eq 0 ]]; then
        local line st reason ts
        line="$(ae_latest_state_for "$self")"
        if [[ -z "$line" ]]; then
            printf '%s state: (none declared)\n' "$self"
        else
            IFS=$'\t' read -r st reason ts <<<"$line"
            printf '%s state: %s%s  (since %s)\n' "$self" "$st" "${reason:+ — $reason}" "$ts"
        fi
        exit 0
    fi

    local value="$1"
    shift
    local reason="${*:-}"

    case "$value" in
        working | waiting-user | done) ;;
        blocked)
            if [[ -z "$reason" ]]; then
                echo "Error: 'blocked' requires a reason" >&2
                helper_state_usage
            fi
            ;;
        *) helper_state_usage ;;
    esac

    printf 'Marked %s %s%s\n' "$self" "$value" "${reason:+: $reason}"
    ae_emit_event "state" "" "$value" "$reason"
    # Transitional dual-emit: a watchdog process started before the state
    # helper existed only understands action=done. Emit the legacy event too
    # so it keeps recognising completions after helpers are refreshed. The
    # current watchdog reads 'state done' directly; retained until
    # 'ae doctor --refresh' can restart a running watchdog.
    if [[ "$value" == "done" ]]; then
        ae_emit_event "done" "" "" "$reason"
    fi
}

# Resolve agent target to pane ID
# Supports: %pane-id, @session:agent-ref, alias:name, alias-only, bare-name
# Sets: AE_RESOLVED_PANE (pane ID), AE_RESOLVED_AGENT (canonical agent ref) or exits with error
ae_resolve() {
    local target="$1"
    AE_RESOLVED_PANE=""
    AE_RESOLVED_AGENT=""
    AE_RESOLVED_SLOT=""
    AE_RESOLVED_SESSION=""

    # 1. Raw pane ID — pass through
    if [[ "$target" == %* ]]; then
        AE_RESOLVED_PANE="$target"
        local pane_agent pane_session
        pane_agent="$(tmux display-message -p -t "$target" '#{@ae_agent}' 2>/dev/null || true)"
        pane_session="$(tmux display-message -p -t "$target" '#S' 2>/dev/null || true)"
        AE_RESOLVED_SLOT="$(tmux display-message -p -t "$target" '#{@ae_slot}' 2>/dev/null || true)"
        _valid_slot "$AE_RESOLVED_SLOT" || AE_RESOLVED_SLOT=""
        AE_RESOLVED_SESSION="$pane_session"
        if [[ -n "$pane_agent" ]]; then
            if [[ -n "$pane_session" && "$pane_session" != "$_AE_SESSION" ]]; then
                AE_RESOLVED_AGENT="@${pane_session}:${pane_agent}"
            else
                AE_RESOLVED_AGENT="$pane_agent"
            fi
        fi
        return 0
    fi

    # 2. Cross-session: @session:agent-ref
    local search_session="$_AE_SESSION"
    if [[ "$target" == @* ]]; then
        if [[ "$target" != @*:* ]]; then
            echo "Error: cross-session target must be @session:agent, got '${target}'" >&2
            return 1
        fi
        target="${target#@}"
        search_session="${target%%:*}"
        target="${target#*:}"
        if [[ -z "$search_session" || -z "$target" ]]; then
            echo "Error: cross-session target must be @session:agent" >&2
            return 1
        fi
        # Verify session exists in tmux
        if ! tmux has-session -t "$search_session" 2>/dev/null; then
            echo "Error: session '${search_session}' not found" >&2
            return 1
        fi
    fi

    # 3. Resolve within session
    local resolved="" resolved_agent=""
    local alias_match="" alias_match_agent="" alias_count=0
    local bare_match="" bare_match_agent="" bare_count=0
    while IFS=$'\t' read -r pid aagent; do
        # Exact match on alias:name
        if [[ "$aagent" == "${target}" ]]; then
            resolved="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                resolved_agent="@${search_session}:${aagent}"
            else
                resolved_agent="$aagent"
            fi
            break
        fi
        # Alias-only match (e.g. "codex" matches "codex:coworker")
        local aalias="${aagent%%:*}"
        if [[ "$aalias" == "${target}" ]]; then
            alias_match="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                alias_match_agent="@${search_session}:${aagent}"
            else
                alias_match_agent="$aagent"
            fi
            alias_count=$((alias_count + 1))
        fi
        # Bare name match (e.g. "lead" matches "claude:lead")
        local aname="${aagent#*:}"
        if [[ "$aname" == "${target}" ]]; then
            bare_match="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                bare_match_agent="@${search_session}:${aagent}"
            else
                bare_match_agent="$aagent"
            fi
            bare_count=$((bare_count + 1))
        fi
    done < <(tmux list-panes -s -t "$search_session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)

    if [[ -z "$resolved" && "$alias_count" -eq 1 ]]; then
        resolved="$alias_match"
        resolved_agent="$alias_match_agent"
    fi

    if [[ -z "$resolved" && "$bare_count" -eq 1 ]]; then
        resolved="$bare_match"
        resolved_agent="$bare_match_agent"
    fi

    if [[ -z "$resolved" ]]; then
        if [[ "$alias_count" -gt 1 || "$bare_count" -gt 1 ]]; then
            echo "Error: ambiguous name '${target}' in session '${search_session}' — use alias:name format" >&2
        else
            echo "Error: agent '${target}' not found in session '${search_session}'" >&2
        fi
        return 1
    fi

    # Output contract: consumers read these after calling ae_resolve.
    # shellcheck disable=SC2034
    AE_RESOLVED_PANE="$resolved"
    AE_RESOLVED_AGENT="$resolved_agent"
    AE_RESOLVED_SLOT="$(tmux display-message -p -t "$resolved" '#{@ae_slot}' 2>/dev/null || true)"
    _valid_slot "$AE_RESOLVED_SLOT" || AE_RESOLVED_SLOT=""
    AE_RESOLVED_SESSION="$(tmux display-message -p -t "$resolved" '#S' 2>/dev/null || true)"
    return 0
}

# Acquire per-target flock (shared between send and interrupt, globally across sessions)
ae_lock_target() {
    local pane="$1"
    local lockdir="${_AE_SESSIONS_DIR}/.locks"
    mkdir -p "$lockdir"
    local lockfile="${lockdir}/send-lock-${pane//[^a-zA-Z0-9]/_}"
    exec 9>"$lockfile"
    flock 9
}

ae_unlock_target() {
    exec 9>&-
}

ae_now_utc() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

ae_current_pane() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        printf '%s' "$TMUX_PANE"
    else
        tmux display-message -p '#{pane_id}' 2>/dev/null || true
    fi
}

ae_current_agent() {
    local pane
    pane="$(ae_current_pane)"
    [[ -n "$pane" ]] || return 0
    tmux display-message -p -t "$pane" '#{@ae_agent}' 2>/dev/null || true
}

# The invoking pane's STABLE slot (main | worker.N | spawned.N) — the request-store key
# that survives a display-name churn (unlike @ae_agent). Empty for an unstamped/external
# pane (the request store falls back to name matching for those).
ae_current_slot() {
    local pane slot
    pane="$(ae_current_pane)"
    [[ -n "$pane" ]] || return 0
    slot="$(tmux display-message -p -t "$pane" '#{@ae_slot}' 2>/dev/null || true)"
    _valid_slot "$slot" && printf '%s' "$slot"
    return 0
}

# Resolve a session-qualified slot -> the CURRENT agent ref for the pane carrying that slot
# (survives a display-name churn — the request-store routing key). Echoes the ref
# (@session:agent when cross-session, else agent), or nothing when no live pane has it.
ae_slot_resolver() {
    local want_session="$1" want_slot="$2" pid pslot pagent
    [[ -n "$want_slot" ]] || return 0
    local search="${want_session:-$_AE_SESSION}"
    # '|' delimiter, NOT tab: @ae_slot is the MIDDLE field and an UNSTAMPED pane
    # emits it empty — tab is IFS-whitespace, so `read` would collapse the empty
    # field and slide the AGENT value into pslot. Benign today (a misparsed agent
    # ref can't equal a valid want_slot, so unstamped panes are skipped by
    # accident), but it is the same class fixed in _stamp_live_slots and one
    # refactor from biting. '|' is non-whitespace, so empty fields survive.
    while IFS='|' read -r pid pslot pagent; do
        [[ "$pslot" == "$want_slot" ]] || continue
        [[ -n "$pagent" ]] || continue
        if [[ -n "$want_session" && "$want_session" != "$_AE_SESSION" ]]; then
            printf '@%s:%s' "$want_session" "$pagent"
        else
            printf '%s' "$pagent"
        fi
        return 0
    done < <(tmux list-panes -s -t "$search" -F '#{pane_id}|#{@ae_slot}|#{@ae_agent}' 2>/dev/null || true)
    return 0
}

# Whitelist a slot string before it is stored/compared (codex hazards: validate at the
# boundary). Accepts main, worker.<n>, spawned.<n>; anything else is treated as slotless.
_valid_slot() {
    # Anchored: exactly main / worker.<digits> / spawned.<digits> — a loose glob accepted
    # worker.0x, letting a malformed/tampered @ae_slot mint a bogus slotted event.
    [[ "$1" =~ ^(main|worker\.[0-9]+|spawned\.[0-9]+)$ ]]
}

# I1: stamp @ae_slot onto RUNNING panes that lack it, mapping each pane's
# @ae_agent (alias:name) to its meta slot. Idempotent — a pane with a valid
# @ae_slot is skipped — so it is safe to run at every launch (a no-op there, the
# panes are freshly stamped) AND at `doctor --refresh`, which is the point: a
# session started BEFORE slot-keyed identity landed carries no @ae_slot, so its
# new requests fall back to name matching until a full resume; this stamps live.
#
# Called from the SYNC_SESSION_ASSETS_BODY marker region so both launch (the
# real def) and refresh (the wrapper's awk-source of that region) run it. It is
# a column-0 fn — defined for BOTH the launch process and the doctor process —
# because the refresh path only awk-sources the marker BODY; a fn defined inside
# the launch block would be invisible there and break --refresh.
#
# tmux-server-aware WITHOUT AE_TMUX_SERVER: `doctor --refresh` runs from a plain
# shell where that env var is unset, so the server is read from the session's
# own meta (matches sync_existing_session_assets' watchdog-restart path).
_stamp_live_slots() {
    local sess="$1" meta_file="$2"
    [[ -n "$sess" ]] || return 0
    [[ -f "$meta_file" ]] || return 0
    local _srv
    _srv="$(grep '^tmux_server=' "$meta_file" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    local -a _st=(tmux)
    if [[ -n "$_srv" ]]; then
        _st=(command tmux -L "$_srv")
    fi
    # Reverse map: alias:name (display, :uuid stripped) -> slot, from meta.
    # F5 (transition-only, best-effort): keyed by DISPLAY name — the churn-prone
    # key slot-identity exists to replace. Two panes sharing a display name in
    # ONE session would collapse (last-wins) -> a mis-stamp; distinct names are
    # the norm and a mis-route self-heals at the next resume, so this is an
    # acceptable limit for the one-shot live-transition stamp.
    local -A _slot_by_agent=()
    local _k _v _an
    while IFS='=' read -r _k _v; do
        case "$_k" in
            agent.main | agent.worker.* | agent.spawned.*) ;;
            *) continue ;;
        esac
        _an="${_v%:*}" # strip trailing :uuid -> alias:name
        [[ -n "$_an" ]] || continue
        _slot_by_agent["$_an"]="${_k#agent.}"
    done <"$meta_file"
    # Stamp each unstamped pane whose @ae_agent maps to a known slot. Delimiter is
    # '|' (ae's convention for pane parsing — see the list-panes callers), NOT a
    # tab: an UNSTAMPED pane has an EMPTY @ae_slot field, and tab is IFS-
    # whitespace, so `read` would COLLAPSE the empty middle field and mis-parse
    # the row — exactly the panes I1 must detect. '|' is non-whitespace, so empty
    # fields survive. Agent names/slots/pane-ids never contain '|'.
    local _pid _pslot _pagent _want
    while IFS='|' read -r _pid _pslot _pagent; do
        [[ -n "$_pid" ]] || continue
        # Idempotent: leave already-stamped panes untouched.
        if _valid_slot "$_pslot"; then
            continue
        fi
        [[ -n "$_pagent" ]] || continue
        _want="${_slot_by_agent[$_pagent]:-}"
        [[ -n "$_want" ]] || continue
        # || true: a pane vanishing mid-refresh must not abort the sourced BODY
        # (this runs under set -e in both the launch and doctor processes).
        "${_st[@]}" set-option -p -t "$_pid" @ae_slot "$_want" 2>/dev/null || true
    done < <("${_st[@]}" list-panes -s -t "$sess" -F '#{pane_id}|#{@ae_slot}|#{@ae_agent}' 2>/dev/null || true)
    return 0
}

ae_current_agent_ref() {
    local agent session pane
    agent="$(ae_current_agent)"
    [[ -n "$agent" ]] || return 0
    pane="$(ae_current_pane)"
    session="$(tmux display-message -p -t "${pane:-$_AE_SESSION}" '#S' 2>/dev/null || true)"
    if [[ -n "$session" && "$session" != "$_AE_SESSION" ]]; then
        printf '@%s:%s' "$session" "$agent"
    else
        printf '%s' "$agent"
    fi
}

ae_preview_text() {
    local text="$*"
    text="${text//$'\r'/}"
    text="${text//$'\n'/\\n}"
    text="${text//$'\t'/ }"
    printf '%.200s' "$text"
}

ae_extract_req_id() {
    local text="$1"
    if [[ "$text" =~ \[((ae|review)-[A-Za-z0-9._:-]+)\] ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
}

ae_log_append() {
    local file="$1" line="$2"
    {
        flock -w 5 8 || exit 1
        printf '%s\n' "$line" >>"$file"
    } 8>>"${file}.lock"
}

ae_log_read() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    {
        flock -s 8 || exit 1
        cat "$file"
    } 8<>"${file}.lock"
}

# Determine target tool type from pane metadata/process name.
# Returns: codex | claude | other
ae_target_tool() {
    local pane="$1" row agent cmd alias
    row="$(tmux list-panes -a -F '#{pane_id}|#{@ae_agent}|#{pane_current_command}' 2>/dev/null | awk -F'|' -v p="$pane" '$1==p {print; exit}')"
    [[ -z "$row" ]] && {
        echo "other"
        return 0
    }
    IFS='|' read -r _ agent cmd <<<"$row"
    alias="${agent%%:*}"
    if [[ "$alias" == "codex" || "$cmd" == "codex" ]]; then
        echo "codex"
    elif [[ "$alias" == "claude" || "$cmd" == "claude" ]]; then
        echo "claude"
    else
        echo "other"
    fi
}

ae_emit_event() {
    local action="$1" target="${2:-}" ref="${3:-}" summary="${4:-}"
    local actor
    actor="${AE_SENDER_OVERRIDE:-$(ae_current_agent_ref)}"
    [[ -n "$actor" ]] || actor="human"
    local ts
    ts="$(date -u +%FT%TZ)"
    # Summary is capped and (for most events) flattened to one line. `chat`
    # events carry a human reply destined for Telegram, so they keep newlines
    # and get a larger cap (3500 — matches format_event's truncation, stays
    # under Telegram's 4096 limit). Either way ae_json_escape below turns any
    # newline into a literal \n, so events.jsonl stays one JSON object per line
    # — the invariant every line-oriented consumer (cmd_list, the watchdog
    # watchdog, the telegram tail) depends on.
    if [[ "$action" == "chat" ]]; then
        summary="$(printf '%s' "$summary" | head -c 3500)"
    else
        summary="$(printf '%s' "$summary" | head -c 200 | tr '\n\t' '  ')"
    fi
    local json
    json="$(printf '{"ts":"%s","actor":"%s","action":"%s"' \
        "$(ae_json_escape "$ts")" "$(ae_json_escape "$actor")" "$(ae_json_escape "$action")")"
    [[ -n "$target" ]] && json+="$(printf ',"target":"%s"' "$(ae_json_escape "$target")")"
    [[ -n "$ref" ]] && json+="$(printf ',"ref":"%s"' "$(ae_json_escape "$ref")")"
    # request-integrity: session-qualified SLOT identity (the churn-proof routing key).
    [[ -n "${_AE_EVENT_ACTOR_SLOT:-}" ]] && json+="$(printf ',"actor_slot":"%s"' "$(ae_json_escape "$_AE_EVENT_ACTOR_SLOT")")"
    [[ -n "${_AE_EVENT_ACTOR_SESSION:-}" ]] && json+="$(printf ',"actor_session":"%s"' "$(ae_json_escape "$_AE_EVENT_ACTOR_SESSION")")"
    [[ -n "${_AE_EVENT_TARGET_SLOT:-}" ]] && json+="$(printf ',"target_slot":"%s"' "$(ae_json_escape "$_AE_EVENT_TARGET_SLOT")")"
    [[ -n "${_AE_EVENT_TARGET_SESSION:-}" ]] && json+="$(printf ',"target_session":"%s"' "$(ae_json_escape "$_AE_EVENT_TARGET_SESSION")")"
    [[ -n "$summary" ]] && json+="$(printf ',"summary":"%s"' "$(ae_json_escape "$summary")")"
    json+="}"
    ae_log_append "${_AE_META_DIR}/events.jsonl" "$json"
}

# Latest state declaration for an agent. Output: state<TAB>reason<TAB>ts (or empty).
# Scans events.jsonl backwards for newest event matching actor=<agent>; treats
# action=state events as authoritative and legacy action=done events as state=done
# so sessions that pre-date the state helper still read back consistently.
ae_latest_state_for() {
    local agent="$1"
    local events="${_AE_META_DIR}/events.jsonl"
    [[ -f "$events" ]] || return 0
    local line actor action st reason ts
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        actor="$(_event_json_str "$line" actor)"
        [[ "$actor" == "$agent" ]] || continue
        action="$(_event_json_str "$line" action)"
        case "$action" in
            state)
                st="$(_event_json_str "$line" ref)"
                reason="$(_event_json_str "$line" summary)"
                ts="$(_event_json_str "$line" ts)"
                printf '%s\t%s\t%s\n' "$st" "$reason" "$ts"
                return 0
                ;;
            done)
                reason="$(_event_json_str "$line" summary)"
                ts="$(_event_json_str "$line" ts)"
                printf '%s\t%s\t%s\n' "done" "$reason" "$ts"
                return 0
                ;;
        esac
    done < <(tac "$events" 2>/dev/null || true)
}

# Generate a request id like "<prefix>-YYYYMMDDTHHMMSSZ-<rand>"
ae_make_req_id() {
    local prefix="${1:-ae}"
    local req_suffix
    req_suffix="$(cut -d- -f1 /proc/sys/kernel/random/uuid 2>/dev/null || true)"
    [[ -n "$req_suffix" ]] || req_suffix="$$-$RANDOM"
    printf '%s-%s-%s' "$prefix" "$(date -u +%Y%m%dT%H%M%SZ)" "$req_suffix"
}

# Shared body for ask/review. Resolves target, generates req_id, builds the
# message (with optional instructions block + uniform reply contract footer),
# and execs into send with the appropriate _AE_EVENT_* env vars set.
# Args: action req_prefix header instructions reply_label target body...
ae_tracked_send() {
    local action="$1" req_prefix="$2" header="$3" instructions="$4" reply_label="$5" target_name="$6"
    shift 6
    local body="$*"
    # External actors (chat bridges, webhooks) identify themselves via
    # AE_SENDER_OVERRIDE — they have no @ae_agent pane to detect. Respect
    # the override before falling back to pane-based detection.
    local self _tgt_slot="" _tgt_session="" _actor_slot=""
    self="${AE_SENDER_OVERRIDE:-$(ae_current_agent_ref)}"
    if [[ -z "$self" ]]; then
        echo "Warning: could not detect caller identity (no @ae_agent on this pane). Using 'send' instead." >&2
        exec "${_AE_META_DIR}/send" "$target_name" "$body"
    fi
    # External-actor targets (telegram:*, discord:*) are event-only sinks
    # consumed by a bridge daemon; the send helper handles the no-pane case.
    # Skip ae_resolve so the literal target name is preserved end-to-end.
    if [[ "$target_name" != telegram:* && "$target_name" != discord:* ]]; then
        ae_resolve "$target_name" || exit 1
        target_name="${AE_RESOLVED_AGENT:-$target_name}"
        # request-integrity: the churn-proof session-qualified target slot (empty ->
        # slotless name-fallback for external/unstamped targets).
        _tgt_slot="$AE_RESOLVED_SLOT"
        _tgt_session="$AE_RESOLVED_SESSION"
    fi
    # Actor slot from THIS pane (external senders via AE_SENDER_OVERRIDE have none).
    if [[ -z "${AE_SENDER_OVERRIDE:-}" ]]; then
        _actor_slot="$(ae_current_slot)"
    fi

    local req_id
    req_id="$(ae_make_req_id "$req_prefix")"
    local reply_cmd="${_AE_META_DIR}/reply --as \"${target_name}\" \"${req_id}\" \"${reply_label}\""

    local msg="${header} ${req_id} from ${self}: ${body}"
    [[ -n "$instructions" ]] && msg+=$'\n\n'"${instructions}"
    msg+=$'\n\n'"REQUIRED: When you have finished, you MUST run this exact command to reply:
${reply_cmd}
Do not reply any other way. Do NOT use peek/peak as a reply mechanism."

    exec env _AE_EVENT_ACTION="$action" _AE_EVENT_REF="$req_id" _AE_EVENT_SUMMARY="$body" \
        _AE_EVENT_ACTOR_SLOT="$_actor_slot" _AE_EVENT_ACTOR_SESSION="${_AE_SESSION:-}" \
        _AE_EVENT_TARGET_SLOT="$_tgt_slot" _AE_EVENT_TARGET_SESSION="$_tgt_session" \
        "${_AE_META_DIR}/send" "$target_name" "$msg"
}

# Look up the original ask/review event for a given req_id. Scans events.jsonl
# newest-first; returns the first matching ask|review event.
# Output: TAB-separated "<kind>\t<sender>\t<target>". Return 1 if not found.
ae_find_request() {
    local req_id="$1"
    local events_file="${_AE_META_DIR}/events.jsonl"
    [[ -f "$events_file" ]] || return 1
    local line ref action actor target
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        ref="$(_event_json_str "$line" ref)"
        [[ "$ref" == "$req_id" ]] || continue
        action="$(_event_json_str "$line" action)"
        if [[ "$action" == "ask" || "$action" == "review" ]]; then
            actor="$(_event_json_str "$line" actor)"
            target="$(_event_json_str "$line" target)"
            local a_slot a_sess t_slot t_sess
            a_slot="$(_event_json_str "$line" actor_slot)"
            a_sess="$(_event_json_str "$line" actor_session)"
            t_slot="$(_event_json_str "$line" target_slot)"
            t_sess="$(_event_json_str "$line" target_session)"
            # Backward-compatible: emit the extended (slot) row ONLY when slots are present;
            # a pre-migration event keeps the original 3-column output. Consumers read
            # tab-safe (missing slot fields -> empty -> name-match fallback).
            if [[ -n "${a_slot}${a_sess}${t_slot}${t_sess}" ]]; then
                printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$action" "$actor" "$target" "$a_slot" "$a_sess" "$t_slot" "$t_sess"
            else
                printf '%s\t%s\t%s\n' "$action" "$actor" "$target"
            fi
            return 0
        fi
    done < <(tac "$events_file" 2>/dev/null || true)
    return 1
}

# Capture the pane's INPUT REGION with SGR escape sequences PRESERVED (capture-pane -e).
# tail -N was geometry-blind: a top-anchored TUI input box can sit far above the pane
# bottom, so a fixed bottom slice misses the live input and catches transcript echo
# instead (the F4 false-positive class). A fixed look-back (the old cy-8) was an INVENTED
# bound — the deepest real fixture was 4 rows, a sample not a limit — so a legal 10-row
# multiline input hid its prompt above the window, no prompt was found, and post-submit
# mapped that to "clear" = false success = silent loss (colead BLOCKER 2, reproduced).
# ONE sensor, TWO consumers (_paste_input_busy pre-paste, _paste_still_staged
# post-submit). UNREADABLE DIRECTIONS DIFFER, deliberately: unreadable -> empty output;
# _paste_input_busy treats empty as UNSAFE (fail-closed: defer, never clobber), while
# _paste_still_staged maps indeterminate to "clear" — the F4 compromise that trades a
# rare missed retry for never duplicating an already-sent message.
_capture_input_region() {
    # The WHOLE visible pane. Bounding the bottom at [0 .. cursor_y] was wrong in the
    # DANGEROUS direction: cursor_y is the EDIT position, not the end of the input. A
    # multiline draft keeps real unsent rows BELOW the cursor after cursor navigation or
    # a leading blank line; -E cursor_y dropped them, the sensor read IDLE, and the
    # pre-paste guard would CLOBBER a live draft (colead ROUND4 BLOCKER, reproduced on
    # real tmux: prompt row 0, unsent continuation row 1, cursor parked back on row 0 ->
    # region held only the ornament row -> IDLE). The region therefore no longer depends
    # on where the edit cursor happens to sit.
    # Rows ABOVE the input are transcript, and the structural anchor
    # (_input_region_prompt_seg) picks the live prompt out of them; rows BELOW it are the
    # box's chrome, which _input_region_content_end excludes. Extra context is inert — a
    # slightly bigger capture is the right trade against both a false success and a
    # clobber.
    local pane="$1"
    tmux capture-pane -e -p -t "$pane" -S 0 2>/dev/null || true
    return 0
}

# Parse a captured region into styled SEGMENTS: parallel arrays _SGR_BOLD/_SGR_DIM/
# _SGR_TEXT/_SGR_LINE, one entry per run of text sharing an SGR state. Parses SGR
# *state* — params, grouping and resets — never byte literals: tmux legally serializes
# the SAME visual state many ways ($'\e[1m›', $'\e[0;1m›', $'\e[2m…\e[1m›'), so an
# exact-byte anchor is unsound and mis-reads real panes (colead BLOCKER 1, reproduced in
# isolated tmux). Only intensity matters here: 1 = bold on, 2 = dim on, 0/22 = both off;
# an extended-colour introducer (38/48) has its arguments skipped so a nested '1'/'2'
# parameter is never mistaken for bold/dim.
# Segments NEVER span a newline: _SGR_LINE[i] is the segment's row in the region, which
# is what lets the prompt rule be STRUCTURAL (line-leading) and not a wildcard — see
# _input_region_prompt_seg (colead NEW BLOCKER 1).
_sgr_parse() {
    _SGR_BOLD=()
    _SGR_DIM=()
    _SGR_TEXT=()
    _SGR_LINE=()
    local rest="$1" bold=0 dim=0 line=0 body seq rem final params text chunk
    local -a ps
    local j v
    while [[ -n "$rest" ]]; do
        if [[ "$rest" == $'\e['* ]]; then
            body="${rest#$'\e['}"
            seq="${body%%[a-zA-Z]*}"
            rem="${body#"$seq"}"
            final="${rem:0:1}"
            rest="${rem:1}"
            [[ "$final" == "m" ]] || continue # non-SGR CSI: consumed, no state change
            params="${seq:-0}"
            IFS=';' read -ra ps <<<"$params"
            j=0
            while ((j < ${#ps[@]})); do
                v="${ps[j]:-0}"
                case "$v" in
                    "" | 0)
                        bold=0
                        dim=0
                        ;;
                    1) bold=1 ;;
                    2) dim=1 ;;
                    21 | 22)
                        bold=0
                        dim=0
                        ;;
                    38 | 48)
                        # 38;5;N (256) or 38;2;R;G;B (truecolour) — skip the arguments
                        if [[ "${ps[j + 1]:-}" == "5" ]]; then
                            ((j += 2))
                        elif [[ "${ps[j + 1]:-}" == "2" ]]; then
                            ((j += 4))
                        fi
                        ;;
                esac
                j=$((j + 1))
            done
            continue
        fi
        if [[ "$rest" == $'\e'* ]]; then
            # A non-CSI escape (charset designator $'\e(B', $'\e7'…). tmux -e emits SGR
            # only, so this is defensive — but it MUST consume bytes: the old loop took
            # this branch, matched an empty text run and spun FOREVER. Drop the whole
            # sequence (ESC + intermediates + one final byte) rather than just the ESC,
            # so a designator's final ('B' of $'\e(B') can't leak into a text run and
            # read as input content — a false OCCUPIED is the F4 duplication class.
            rest="${rest:1}"
            while [[ -n "$rest" ]]; do
                case "${rest:0:1}" in
                    ' ' | '!' | '"' | '#' | '$' | '%' | '&' | "'" | '(' | ')' | '*' | '+' | ',' | '-' | '.' | '/')
                        rest="${rest:1}" # intermediate byte, more to come
                        ;;
                    *)
                        rest="${rest:1}" # final byte: sequence complete
                        break
                        ;;
                esac
            done
            continue
        fi
        text="${rest%%$'\e'*}"
        rest="${rest#"$text"}"
        [[ -n "$text" ]] || continue
        # Split the run at newlines so every segment belongs to exactly ONE row.
        while [[ "$text" == *$'\n'* ]]; do
            chunk="${text%%$'\n'*}"
            text="${text#*$'\n'}"
            if [[ -n "$chunk" ]]; then
                _SGR_BOLD+=("$bold")
                _SGR_DIM+=("$dim")
                _SGR_TEXT+=("$chunk")
                _SGR_LINE+=("$line")
            fi
            line=$((line + 1))
        done
        if [[ -n "$text" ]]; then
            _SGR_BOLD+=("$bold")
            _SGR_DIM+=("$dim")
            _SGR_TEXT+=("$text")
            _SGR_LINE+=("$line")
        fi
    done
    return 0
}

# STRUCTURAL prompt selection over a parsed region: find the live input prompt by the
# only property that separates it from transcript — the ornament is the FIRST
# non-whitespace cell of its ROW, and the BOTTOM-MOST such row wins (the input box sits
# below the transcript; the capture stops at the cursor, which is inside the box).
# Sets _SGR_PROMPT_SEG (segment index), _SGR_PROMPT_TAIL (that segment's text from the
# ornament onward) and _SGR_PROMPT_ORN (which ornament matched, so a multi-ornament tool
# can strip exactly its own anchor). Returns 1 when no row qualifies -> indeterminate.
#
# Style alone was NOT enough (colead NEW BLOCKER 1): once the capture widened past a
# fixed look-back the whole transcript came into view, and a wildcard '*›*' over bold-and-
# not-dim segments matched bold assistant PROSE ($'\e[1mAnalysis › outcome') as a live
# prompt — a DELIVERED message then read as staged, the sender re-pressed Enter and the
# F4 duplication class reopened. Structure alone is not enough either: a submitted echo
# IS line-leading, and is excluded by style (bold AND dim). Both rules, together.
#
# live_only=1 requires bold && !dim (codex, whose echo is bold+dim). Ornaments are
# matched as literal PREFIXES, never a bracket class: '›'/'❯' are multibyte and a
# bracket expression matches per-byte under LC_ALL=C (the queued locale slice's bug).
_input_region_prompt_seg() { # <live_only:0|1> <ornament>... -> 0 + _SGR_PROMPT_SEG/_TAIL
    local live_only="$1"
    shift
    _SGR_PROMPT_SEG=-1
    _SGR_PROMPT_TAIL=""
    _SGR_PROMPT_ORN=""
    # Callers always _sgr_parse first, but this is emitted into _lib where a future one
    # might not: subscripting an UNDECLARED array under `set -u` aborts the whole helper
    # (the repo's documented hazard). No segments parsed == no prompt, which is exactly
    # what an unparsed region should report.
    [[ -n "${_SGR_TEXT+x}" ]] || return 1
    local n=${#_SGR_TEXT[@]}
    ((n > 0)) || return 1
    local maxline=${_SGR_LINE[n - 1]}
    local line i lead rest orn found
    for ((line = maxline; line >= 0; line--)); do
        found=-1
        for ((i = 0; i < n; i++)); do
            [[ "${_SGR_LINE[i]}" == "$line" ]] || continue
            # Leading whitespace is not content: tmux legally paints the cells before a
            # live ornament ($'\e[2m  \e[0;1m›' — colead's isolated-tmux serialization),
            # so the run holding them is skipped, not treated as text.
            [[ -z "${_SGR_TEXT[i]//[[:space:]]/}" ]] && continue
            found=$i
            break
        done
        ((found >= 0)) || continue
        lead="${_SGR_TEXT[found]}"
        rest="${lead#"${lead%%[![:space:]]*}"}" # from the row's first non-blank cell
        for orn in "$@"; do
            [[ "$rest" == "$orn"* ]] || continue
            if ((live_only == 1)); then
                [[ "${_SGR_BOLD[found]}" == 1 && "${_SGR_DIM[found]}" == 0 ]] || continue
            fi
            _SGR_PROMPT_SEG=$found
            _SGR_PROMPT_TAIL="$rest"
            _SGR_PROMPT_ORN="$orn"
            return 0
        done
    done
    return 1
}

# Where the input box ENDS: the first CHROME row below the prompt, exclusive. Sets
# _SGR_CONTENT_END (a line index; rows >= it are not input).
#
# This replaces cursor_y as the bottom bound. The cursor could not do this job — it marks
# the EDIT position, so a draft can extend below it (colead ROUND4 BLOCKER) — but
# something must, because the capture now runs to the pane bottom and every input box has
# chrome under it. Counting chrome as content is the OPPOSITE failure and it is worse
# than it looks: an idle pane would read OCCUPIED forever, every send would defer, and
# that is the ri-3 fleet-wide comms outage. So this bound is load-bearing in BOTH
# directions — too high clobbers a draft, too low blocks all delivery.
#
# Is this row the input box's structural BORDER, as opposed to draft content that merely
# begins with the same glyph? POSITIVE identification, on two properties measured from
# real v2.1.209 captures — a border row's printable content is ENTIRELY U+2500, AND it
# spans the full width of the region (the box is drawn edge to edge, so it is always the
# widest row; text rows are shorter because tmux strips their trailing blanks).
#
# A first-cell glyph test is NOT enough and shipped as a clobber (colead ROUND5 BLOCKER
# 1): a user pasting '─ user-pasted heading' into a draft truncated the region there, and
# the unsent body below it read IDLE -> pre-paste safe -> overwrite. On the real rig
# capture that row is 23 cells of mixed characters against the box's 167 of pure U+2500,
# so it fails BOTH properties. The welcome box's rows ('╭───', '│', '╰───') fail the
# morphology test too.
#
# Residual, in the SAFE direction: a draft row that is BOTH pure U+2500 AND exactly the
# full width is indistinguishable from a border — it is a border, morphologically. Also
# ${#s} counts characters under the fleet's C.UTF-8 but BYTES under LC_ALL=C, where a
# border (3 bytes/glyph) still measures longest, so the test holds; if it ever did not,
# no border is found, chrome counts as content, and the read is OCCUPIED -> defer (loud),
# never a clobber. The locale slice owns the general case.
_input_region_is_border() { # <row-printable-text> <region-max-width>
    local row="$1" maxw="$2"
    [[ -n "$row" ]] || return 1
    [[ -z "${row//─/}" ]] || return 1 # morphology: nothing but U+2500
    ((${#row} == maxw)) || return 1   # position: drawn edge to edge
    return 0
}

# The boundary is per-tool because the two real layouts differ (live captures,
# 2026-07-15) — each tool is given the row that actually closes ITS box:
#   claude ('border') — the box's BOTTOM BORDER sits directly under the input (a row
#           whose first non-blank cell is '─'), then the model/status rows and specimen
#           #5's 'paste again to expand' hint. Claude must NOT stop at a blank row: a
#           draft can contain one, and clipping there would drop the rows below it.
#   codex  ('blank')  — no bottom border at all: a BLANK row, then the model/path footer
#           ('  gpt-5.6-sol xhigh · ~/projects/clemens33/ae').
# Deliberately NOT "the pane's last non-blank row is the footer": that guesses chrome
# from position, and with no footer present it clips the draft's last row instead —
# the clobber direction, caught by the fixtures.
_input_region_content_end() { # <prompt_line> <stop_at: border|blank>
    local pl="$1" stop_at="$2" n=${#_SGR_TEXT[@]} i line
    local -a nonblank=() rowtext=()
    _SGR_CONTENT_END=$((${_SGR_LINE[n - 1]} + 1)) # default: everything below the prompt
    # Rebuild each row's printable text: a border must be judged on the WHOLE row, never
    # on its first cell (colead ROUND5 BLOCKER 1 — see _input_region_is_border).
    local maxw=0 w
    for ((i = 0; i < n; i++)); do
        line=${_SGR_LINE[i]}
        rowtext[line]="${rowtext[line]:-}${_SGR_TEXT[i]}"
    done
    for line in "${!rowtext[@]}"; do
        w=${#rowtext[line]}
        if ((w > maxw)); then maxw=$w; fi
    done
    for ((i = 0; i < n; i++)); do
        line=${_SGR_LINE[i]}
        ((line > pl)) || continue
        ((line < _SGR_CONTENT_END)) || continue
        [[ -z "${_SGR_TEXT[i]//[[:space:]]/}" ]] && continue
        nonblank[line]=1
        if [[ "$stop_at" == "border" ]] && _input_region_is_border "${rowtext[line]}" "$maxw"; then
            _SGR_CONTENT_END=$line
        fi
    done
    if [[ "$stop_at" == "blank" ]]; then
        # The LAST blank row below the prompt — codex's separator above the footer.
        # Deliberately not the FIRST: a draft carries its own blank rows (an empty first
        # line, a paragraph break), and stopping at one of those drops the real text
        # below it -> false IDLE -> clobber. That is the same class as the cursor bound
        # this replaced, so the bound has to be the LAST one to stay on the safe side.
        for ((line = _SGR_CONTENT_END - 1; line > pl; line--)); do
            if [[ -z "${nonblank[line]:-}" ]]; then
                _SGR_CONTENT_END=$line
                break
            fi
        done
    fi
    return 0
}

# Occupancy of the target's live input box (colead characterization, 2026-07-14/15).
# PER-TOOL — the "empty" tell differs. Returns:
#   0 = OCCUPIED       real typed/staged content sits in the input
#   1 = IDLE           bare ornament / a dim placeholder suggestion only
#   2 = INDETERMINATE  no live prompt in view / unreadable — callers fail-closed
#                      their OWN way (pre-paste busy => UNSAFE, post-submit staged
#                      => CLEAR/non-regressive).
_input_region_occupied() {
    local pane="$1" tool="$2" region
    region="$(_capture_input_region "$pane")"
    [[ -n "$region" ]] || return 2 # unreadable
    case "$tool" in
        codex)
            # Live input starts at the last BOLD-ONLY prompt $'\e[1m›'. A SUBMITTED
            # transcript echo is BOLD+DIM $'\e[1;2m›' — excluded, so cursor-region
            # isolation kills the F4 transcript-echo false-positive by style+geometry,
            # NOT a content grep (live repro 2026-07-14: '\e[1;2m› \e[0mMemo read …').
            # From the live prompt to the cursor: drop the DIM (SGR 2) placeholder-
            # suggestion span, strip remaining SGR + ornament + whitespace; ANY
            # printable remainder — INCLUDING the unstyled '[Pasted Content N chars]'
            # staging token — is OCCUPIED. (Re-enables codex staged detection safely;
            # supersedes the ri-2 DO-NOT-RE-ADD note, whose transcript-echo objection
            # stays correct and is what cursor-region isolation now resolves. Live
            # repro: staged '[Pasted Content 1469 chars]' — the old detector returned
            # clear and would have logged a false success = silent loss.)
            local i live s
            _sgr_parse "$region"
            # The LIVE prompt is the bottom-most ROW whose first non-blank cell is the
            # ornament in BOLD-and-NOT-DIM state; a submitted transcript echo is the
            # same ornament BOLD-AND-DIM, and bold prose carrying a '›' mid-row is
            # transcript regardless of style. State, not bytes: $'\e[2m…\e[1m›' leaves
            # DIM active (an echo) while $'\e[2m…\e[0;1m›' resets first (live) —
            # visually identical prefixes, opposite meanings.
            _input_region_prompt_seg 1 '›' || return 2 # no live prompt (mid-gen/abnormal)
            live=$_SGR_PROMPT_SEG
            _input_region_content_end "${_SGR_LINE[live]}" blank
            # Content = everything after the ANCHOR ornament only. Removing every '›'
            # in the region (the old tr -d) made a user-typed ornament vanish, reading
            # real input as idle and permitting a clobber — violating the very class
            # rule this sensor enforces (colead BLOCKER 3). Strip the anchor, keep all
            # printable content that follows it, including further ornaments.
            s="${_SGR_PROMPT_TAIL#*›}"
            for ((i = live + 1; i < ${#_SGR_TEXT[@]}; i++)); do
                # Below the box (blank row + model/path footer) is chrome, not input.
                ((_SGR_LINE[i] < _SGR_CONTENT_END)) || break
                # DIM-state text is the placeholder suggestion — not user content.
                [[ "${_SGR_DIM[i]}" == 1 ]] && continue
                s+="${_SGR_TEXT[i]}"
            done
            s="${s//$'\xc2\xa0'/ }"
            s="$(tr -d '\n\t ' <<<"$s")"
            # ANY unstyled printable remainder is OCCUPIED — including the unstyled
            # '[Pasted Content N chars]' staging token(s), chunked multi-token rows and
            # a leaked plaintext tail (occurrence #3). The token text is documentation,
            # never the predicate: the CLASS (unstyled printable) is the rule.
            [[ -n "$s" ]] && return 0 || return 1
            ;;
        claude)
            # STRUCTURE + CONTENT (colead's REAL v2.1.209 fixtures, 2026-07-15).
            # STRUCTURE, because styling cannot identify claude's live prompt: the
            # submitted echo is fg239-on-bg237, the live prompt is default when idle and
            # fg246 mid-generation, and NONE of them is SGR-dim — so unlike codex there
            # is no live_only style test to apply (hence live_only=0). Geometry is the
            # robust fact: the live prompt is the BOTTOM-MOST row whose FIRST non-blank
            # cell is the ornament. The old any-line grep for [>❯▌] instead took the last
            # row containing one ANYWHERE, so a transcript row could be read as the live
            # input -> staged -> extra Enters -> F4 duplication (colead NEW BLOCKER 2).
            # Claude DOES draw the live empty prompt WHILE GENERATING (fixture 2), so
            # bottom-most-wins holds mid-generation rather than degrading.
            # No border cell ever precedes ❯ — borders are their own rows — so the old
            # sed's speculative '│?' is dropped: no specimen supports it.
            # '▌' stays in the set only BECAUSE selection is structural: the splash logo
            # contains a '▌', but never as a row's first cell (the logo rows open '▐').
            #
            # CONTENT, because suggestions are disabled at launch
            # (CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=0): idle == a bare ornament, so ANY
            # content after it = OCCUPIED. If that flag ever fails and a ghost returns,
            # the ghost reads as content -> OCCUPIED -> fail CLOSED (defer/abandon),
            # never a silent clobber. This CLASS rule is also why the two staging shapes
            # need no text matching: claude's '[Pasted text #N +M lines]' token and raw
            # unstyled text (the steward's variant-3 loss) are both just content.
            # It is also why specimen #5's 'paste again to expand' hint is irrelevant: it
            # renders below the box's bottom border, so _input_region_content_end drops it
            # with the rest of the chrome, while the staged token stays on the prompt row
            # where the class rule sees it. (The hint IS captured now — the capture is the
            # whole pane; it is the border bound, not capture geometry, that excludes it.)
            local i s
            _sgr_parse "$region"
            _input_region_prompt_seg 0 '❯' '>' '▌' || return 2 # no live prompt in view
            _input_region_content_end "${_SGR_LINE[$_SGR_PROMPT_SEG]}" border
            s="${_SGR_PROMPT_TAIL#"$_SGR_PROMPT_ORN"}"
            # Continuation rows of a multiline draft sit BELOW the prompt row — including
            # below the edit cursor — and are real unsent input; the box's bottom border
            # (then the status/hint rows) is where they stop being input.
            for ((i = _SGR_PROMPT_SEG + 1; i < ${#_SGR_TEXT[@]}; i++)); do
                ((_SGR_LINE[i] < _SGR_CONTENT_END)) || break
                s+="${_SGR_TEXT[i]}"
            done
            s="${s//$'\xc2\xa0'/ }" # NBSP (U+00A0) follows ❯ on a real idle row
            s="$(tr -d '\n\t ' <<<"$s")"
            [[ -n "$s" ]] && return 0 || return 1
            ;;
        *) return 1 ;; # unmodeled tool -> treat as idle (don't block delivery)
    esac
}

# Is our pasted message STILL STAGED (unsent) in the target's input box? Return
# 0 (staged) ONLY on a positive OCCUPIED read of the cursor-region — an idle or
# indeterminate read degrades to "submitted" (non-regressive: never a false loud
# alarm that would make the sender DUPLICATE an already-sent message, the F4 class).
_paste_still_staged() {
    local pane="$1" tool="$2" msg="$3" rc # msg kept for caller symmetry
    case "$tool" in
        claude | codex)
            _input_region_occupied "$pane" "$tool"
            rc=$?
            ((rc == 0)) && return 0 || return 1 # OCCUPIED=staged; idle/indeterminate=clear
            ;;
        *) return 1 ;; # unmodeled -> clear (non-regressive)
    esac
}

# Is it UNSAFE to paste into this pane right now? Return 0 (unsafe) when the
# input holds unsent/human-typed content OR the target is mid-generation OR the
# state can't be read — fail-CLOSED, NEVER paste into uncertainty (delivery-bug
# exhibit #3: a helper paste clipped the human's half-typed question). Return 1
# (safe) ONLY on a confident idle+empty read. Robust for claude (the exhibit
# tool); best-effort for codex (its dim empty-placeholder is indistinguishable
# from typed text in a color-stripped capture — NOTE for the codex reviewer).
# Is an attached client LOOKING AT this pane with recent input activity? Supplemental
# human-presence signal for the send defer (codex send-focus review): typing into an
# IDLE codex is undetectable in a color-stripped capture, but a human plausibly AT the
# pane right now is cheap to see. list-clients' #{pane_id} is the client's own active
# pane — stronger than #{pane_active}, which only means active-in-window, not viewed.
# #{client_activity} is the epoch of the client's last INPUT; navigation/mouse count
# too, so false positives are safe deferrals. This cannot prove the input box is empty
# (the busy predicate stays primary) and cannot close the check-to-paste race — it
# narrows the codex idle-typing gap, nothing more. Grace ~4s of quiet.
_pane_recently_viewed() {
    local pane="$1" grace="${2:-4}" now cpane cact
    now="$(date +%s)"
    while IFS='|' read -r cpane cact; do
        [[ "$cpane" == "$pane" ]] || continue
        [[ "$cact" =~ ^[0-9]+$ ]] || continue
        if ((now - cact < grace)); then
            return 0 # human plausibly typing HERE right now -> defer
        fi
    done < <(tmux list-clients -F '#{pane_id}|#{client_activity}' 2>/dev/null || true)
    return 1
}

_paste_input_busy() {
    local pane="$1" tool="$2"
    # Only claude/codex are modeled for input protection. Other tools (gemini,
    # opencode, plain shells, test dummies) have NO reliable input predicate, so
    # fail-closed there would break every send to them — instead ALLOW (preserve
    # the pre-existing unconditional-paste behavior; the exhibits were claude +
    # codex). Fail-closed applies WITHIN a modeled tool, not to unknown ones.
    case "$tool" in
        claude | codex) ;;
        *) return 1 ;; # unmodeled -> safe (allow, don't regress)
    esac
    # UNSAFE unless the cursor-region reads confidently IDLE. OCCUPIED (typed/staged)
    # and INDETERMINATE (no live prompt = mid-generation / unreadable) both fail
    # CLOSED — never paste into uncertainty (delivery-bug exhibit #3: a helper paste
    # clipped a half-typed human question). Only a positive idle read is safe.
    local rc
    _input_region_occupied "$pane" "$tool"
    rc=$?
    ((rc == 1)) && return 1 || return 0 # IDLE=safe; OCCUPIED/INDETERMINATE=unsafe
}

# Resolve the agent BINARY expected in a pane from meta agent_bin.<slot>
# (authoritative — written at launch via extract_binary_from_cmd; the @ae_agent
# alias is arbitrary user text). Empty when the pane is unstamped or the meta
# can't be read. Cross-session aware (reads the pane's OWN session meta). Query
# helper: result is stdout, explicit return.
_agent_bin_for_pane() {
    local pane="$1" slot psess meta
    slot="$(tmux display-message -p -t "$pane" '#{@ae_slot}' 2>/dev/null || true)"
    _valid_slot "$slot" || {
        printf ''
        return 0
    }
    psess="$(tmux display-message -p -t "$pane" '#S' 2>/dev/null || true)"
    [[ -n "$psess" ]] || {
        printf ''
        return 0
    }
    meta="${_AE_SESSIONS_DIR}/${psess}/meta"
    [[ -f "$meta" ]] || {
        printf ''
        return 0
    }
    grep "^agent_bin.${slot}=" "$meta" 2>/dev/null | head -1 | cut -d= -f2- || true
    return 0
}

# Is this pane a DEAD-agent shell? A real agent that exits drops its pane back to
# a login shell; a subsequent paste + Enter would EXECUTE the message as a shell
# command — the AGENTS.md interpreted-sink class (message-as-code). Detect: the
# pane's foreground is a shell AND the agent EXPECTED there is NOT itself a shell.
# A shell-BASED agent (agent_bin is bash/etc — e.g. test dummies) and an
# undeterminable pane fail-OPEN (return 1, deliver) so this never breaks
# legitimate delivery. Live real agents run in the foreground under the
# `exec bash -lc` launcher, so their pane_current_command IS the agent binary
# (not a shell) — only a genuinely dead one shows a bare shell. Mirrors the
# watchdog dead-check heuristic (command_is_shell + expected binary).
_pane_agent_is_dead() {
    local pane="$1" proc abin pane_pid
    proc="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
    command_is_shell "$proc" || return 1 # a real process is in the foreground -> alive
    abin="$(_agent_bin_for_pane "$pane")"
    command_is_shell "$abin" && return 1 # shell-based agent or undeterminable -> deliver
    # Foreground is a shell AND a real agent is expected — but a LIVE agent running a
    # Bash tool (or launched under the `bash -lc` wrapper) shows a shell foreground
    # while its binary is alive as a DESCENDANT. Walk the process tree before declaring
    # death, exactly as the watchdog dead-check does (_pane_has_descendant_named). The
    # earlier version omitted this walk and false-refused sends to live-but-busy agents
    # (proven: a live claude under `bash` still got a REFUSED send).
    pane_pid="$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)"
    if [[ -n "$pane_pid" ]] && _pane_has_descendant_named "$pane_pid" "$abin"; then
        return 1 # agent binary alive in the pane's process tree -> deliver
    fi
    return 0 # real agent expected, only a shell in the tree -> genuinely DEAD
}

# Paste a message into a pane and CONFIRM it submitted. On a busy TUI a single
# Enter can be swallowed and the staged text later clears WITHOUT sending (the
# founding deadlock exhibit: a review paste that never reached a busy codex).
# After the initial Enter, verify the input cleared; retry Enter BOUNDED (2
# attempts, ~2s total); if never confirmed, fail LOUD (non-zero + a warning).
# NO durable outbox — ae is not a queue (doctrine); the LLM sender re-sends when
# it sees the failure. Unified: tmux_paste_submit (launch) delegates here so the
# two paste paths can't drift.
ae_submit_pasted_message() {
    local pane="$1" tool="$2" buf="$3" msg="$4"
    local _settle=0.1
    if [[ "$tool" == "codex" ]]; then
        # Codex expects bracketed-paste mode for injected input.
        tmux set-buffer -b "$buf" -- "$msg" \; \
            paste-buffer -d -p -b "$buf" -t "$pane"
    else
        tmux set-buffer -b "$buf" -- "$msg" \; \
            paste-buffer -d -b "$buf" -t "$pane"
        # Claude only: the steward's 24-sample sweep (2026-07-15) found sends to IDLE
        # claude panes losing the Enter — the text stayed staged raw — while sends to
        # BUSY panes queued and delivered. The lead's fresh-pane repro did NOT
        # reproduce, so this is version/client-state dependent and the root cause is
        # unproven; a longer settle is cheap insurance for the flow-control hypothesis.
        # It is NOT the guarantee — the verify-then-retry loop below is. Codex keeps
        # 0.1s: no evidence of the drop there, and every send would pay the latency.
        _settle=0.3
    fi
    sleep "$_settle"
    tmux send-keys -t "$pane" Enter

    local _attempt=0
    while ((_attempt < 2)); do
        sleep 0.3
        if ! _paste_still_staged "$pane" "$tool" "$msg"; then
            return 0
        fi
        tmux send-keys -t "$pane" Enter
        _attempt=$((_attempt + 1))
    done
    sleep 0.3
    if ! _paste_still_staged "$pane" "$tool" "$msg"; then
        return 0
    fi
    echo "ae: submit UNCONFIRMED to pane ${pane} (${tool}) — message may not have sent. Re-send." >&2
    return 1
}

# --- session meta key/value (locked) -------------------------------------
# Shared read/write for keys in this session's meta file. Writes serialize on
# meta.lock (same lock the watchdog's meta writer uses) so concurrent helpers
# can't clobber each other; last-write-wins per key. Values are single-line.

ae_meta_get() {
    grep "^${1}=" "${_AE_META_DIR}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true
}

ae_meta_set() {
    local key="$1" value="$2"
    local meta_file="${_AE_META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 1
    value="${value//$'\r'/}"
    value="${value//$'\n'/ }"
    {
        flock -w 5 200 || exit 1
        local tmp="${meta_file}.tmp.$$"
        awk -F= -v k="$key" -v v="$value" '
            BEGIN { updated = 0 }
            $1 == k { print k "=" v; updated = 1; next }
            { print }
            END { if (!updated) print k "=" v }
        ' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${meta_file}.lock"
}

ae_meta_unset() {
    local key="$1"
    local meta_file="${_AE_META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 0
    {
        flock -w 5 200 || exit 1
        local tmp="${meta_file}.tmp.$$"
        awk -F= -v k="$key" '$1 != k { print }' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${meta_file}.lock"
}

# — session-helper template functions (send/ask/review/reply/requests/say/
#   memo/goal/peek/agents/focus/interrupt/spawn/retire/_register-sid/
#   events-tail; each emitted into its generated helper, main fn last) —

# send:
helper_send_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    if [[ $# -lt 2 ]]; then
        echo "Usage: send <agent-name|pane-id|@session:agent> <message>" >&2
        echo "  Examples: send claude:lead \"hello\"" >&2
        echo "           send @my-feature:claude:lead \"hello\"" >&2
        exit 1
    fi
    target_ref="$1"
    shift
    msg="$*"
    sender="${AE_SENDER_OVERRIDE:-}"
    if [[ -z "$sender" ]]; then
        sender="$(ae_current_agent_ref)"
    fi
    [[ -n "$sender" ]] || sender="human"
    req_id="$(ae_extract_req_id "$msg")"

    # External actor targets (telegram:*, discord:*) are NOT panes — they're
    # event-only sinks consumed by an out-of-band bridge daemon tailing
    # events.jsonl. For these targets, emit the event and exit; skip the tmux
    # paste path. Any other unresolved name still fails loudly so typos surface.
    if [[ "$target_ref" == telegram:* || "$target_ref" == discord:* ]]; then
        ae_emit_event "${_AE_EVENT_ACTION:-send}" "$target_ref" "${_AE_EVENT_REF:-${req_id:-}}" "${_AE_EVENT_SUMMARY:-$msg}"
        exit 0
    fi

    ae_resolve "$target_ref" || exit 1
    target="$AE_RESOLVED_PANE"
    logged_target="${AE_RESOLVED_AGENT:-$target_ref}"
    buf="ae-send-$$"

    # Interpreted-sink guard: refuse to paste into a pane whose agent has DIED
    # and dropped to a shell — a stray Enter would EXECUTE the message as a shell
    # command (message-as-code). No retry/defer: a dead agent won't recover on
    # its own. Placed BEFORE the lock and the busy-defer loop so a dead target
    # fails fast, not after a 5x defer. (Launch legitimately pastes into a shell
    # via tmux_paste_submit, not this send path, so the guard lives here.)
    if _pane_agent_is_dead "$target"; then
        echo "ae: send to ${logged_target} REFUSED — target pane is a shell, not a running agent (the agent process is gone). Nothing pasted; a stray Enter would EXECUTE the message as a shell command. Re-launch the agent, then re-send." >&2
        exit 1
    fi

    ae_lock_target "$target"

    tool="$(ae_target_tool "$target")"

    # NO FOCUS CHANGE — ever. paste-buffer -t / send-keys -t write to the NAMED pane;
    # focus is not part of any TUI's submission contract (codex send-focus review).
    # select-pane here changed the window's active pane, routing the human's in-flight
    # keystrokes into the TARGET mid-send — acute under lead-pair, where lead and
    # colead share window 0. Only the explicit `focus` helper may select panes.
    #
    # Protect in-progress input and avoid a busy target (delivery-bug exhibits: a
    # helper paste CLIPPED the human's half-typed question; a review paste never
    # submitted to a busy codex). The cancel keystroke ITSELF would clobber staged or
    # human-typed text, so inspect the state BEFORE any cancel. Defer while unsafe:
    # busy/non-empty input (fail-closed for modeled TUIs) OR a human plausibly AT the
    # pane right now (attached client viewing it with recent input — supplemental,
    # tool-agnostic; codex idle typing is otherwise undetectable). Bounded in-process
    # wait (AE_SEND_DEFER_SEC, default 30s — a human mid-sentence outlasts 2s), then
    # LOUD failure. The target flock is HELD while waiting, so competing sends and
    # interrupts to this target queue behind us in order. No durable outbox.
    _defer_sec="${AE_SEND_DEFER_SEC:-30}"
    [[ "$_defer_sec" =~ ^[0-9]+$ ]] || _defer_sec=30
    _wait_start=$SECONDS
    while _paste_input_busy "$target" "$tool" || _pane_recently_viewed "$target"; do
        if ((SECONDS - _wait_start >= _defer_sec)); then
            ae_unlock_target
            echo "ae: send to ${logged_target} ABANDONED — target stayed busy / human input or attention (not clear within ${_defer_sec}s; AE_SEND_DEFER_SEC overrides). Re-send." >&2
            exit 1
        fi
        sleep 0.4
    done

    # Safe now: cancel (only AFTER the safety check), paste + verify — all by -t target.
    tmux send-keys -t "$target" -X cancel 2>/dev/null || true

    if ! ae_submit_pasted_message "$target" "$tool" "$buf" "$msg"; then
        ae_unlock_target
        echo "ae: send to ${logged_target} UNCONFIRMED — submit not verified. Re-send." >&2
        exit 1
    fi
    ae_unlock_target
    ae_emit_event "${_AE_EVENT_ACTION:-send}" "$logged_target" "${_AE_EVENT_REF:-${req_id:-}}" "${_AE_EVENT_SUMMARY:-$msg}"
}

