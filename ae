# interrupt:
helper_interrupt_main() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: interrupt <agent-name|pane-id|@session:agent> [message]" >&2
        echo "  Examples: interrupt codex:reviewer" >&2
        echo "           interrupt @my-feature:claude:lead \"Stop — try a different approach\"" >&2
        exit 1
    fi
    ae_resolve "$1" || exit 1
    shift
    target="$AE_RESOLVED_PANE"
    msg="${*:-}"

    # Interpreted-sink guard (same as send): if the agent is dead and its pane
    # dropped to a shell, a message paste + Enter would EXECUTE as a shell
    # command. Only refuse when there IS a message — a no-message interrupt is
    # just harmless cancel keystrokes into whatever is there.
    if [[ -n "$msg" ]] && _pane_agent_is_dead "$target"; then
        echo "ae: interrupt of ${AE_RESOLVED_AGENT:-$target} REFUSED — target pane is a shell, not a running agent; a stray Enter would EXECUTE the message as a shell command. Re-launch the agent, then re-send." >&2
        exit 1
    fi

    ae_lock_target "$target"

    # NO FOCUS CHANGE — send-keys -t (incl. -X cancel and Escape) targets the pane
    # without selecting it; see helper_send_body. Only `focus` selects panes.
    tmux send-keys -t "$target" -X cancel 2>/dev/null || true
    tmux send-keys -t "$target" Escape

    if [[ -n "$msg" ]]; then
        sleep 0.5
        buf="ae-interrupt-$$"
        tool="$(ae_target_tool "$target")"
        # Mirror send: a message interrupt must NOT log success on an unconfirmed
        # submit (codex code-round finding — the "false delivered" class the send
        # path already fixes). Unlock, fail LOUD, emit NO event.
        if ! ae_submit_pasted_message "$target" "$tool" "$buf" "$msg"; then
            ae_unlock_target
            echo "ae: interrupt message to ${AE_RESOLVED_AGENT:-$target} UNCONFIRMED — submit not verified. Re-send." >&2
            exit 1
        fi
    fi

    ae_emit_event "interrupt" "${AE_RESOLVED_AGENT:-$target}" "" "$msg"
    ae_unlock_target
}

