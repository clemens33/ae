# _register-sid:
helper_register_sid_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    SLOT="${1:-default}"
    TARGET_CWD="$(realpath "$PWD" 2>/dev/null || echo "$PWD")"
    ESCAPED_SLOT="${SLOT//./\\.}"
    # Read launch_time from meta to filter stale sessions (default 0 = accept all)
    LAUNCH_TIME="$(grep "^launch_time\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [ -z "$LAUNCH_TIME" ]; then
        LAUNCH_TIME="$(grep "^codex_launch_time\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || echo 0)"
    fi
    case "$LAUNCH_TIME" in
        '' | *[!0-9]*)
            LAUNCH_TIME=0
            ;;
    esac
    LAUNCH_ID="$(grep "^launch_id\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [ -z "$LAUNCH_ID" ]; then
        LAUNCH_ID="$(grep "^codex_launch_id\.${ESCAPED_SLOT}=" "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    best_id="" best_mtime=0
    # Scan today and yesterday (handles UTC midnight rollover)
    for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do
        [ -z "$day" ] && continue
        dir="$HOME/.codex/sessions/${day}"
        [ -d "$dir" ] || continue
        for f in "$dir"/*.jsonl; do
            [ -f "$f" ] || continue
            mtime="$(_ae_stat mtime "$f" || echo 0)"
            [ "$mtime" -lt "$LAUNCH_TIME" ] && continue
            if [ -n "$LAUNCH_ID" ]; then
                grep -Fq "AE_CODEX_LAUNCH_ID=${LAUNCH_ID}" "$f" 2>/dev/null || continue
            fi
            first_line="$(head -1 "$f" 2>/dev/null || true)"
            [ -z "$first_line" ] && continue
            if [ "$mtime" -gt "$best_mtime" ]; then
                file_id="$(echo "$first_line" | _ae_json_first id '[0-9a-f-]' 2>/dev/null || true)"
                if [ -n "$file_id" ]; then
                    best_id="$file_id"
                    best_mtime="$mtime"
                fi
            fi
        done
    done
    if [ -z "$best_id" ]; then
        for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do
            [ -z "$day" ] && continue
            dir="$HOME/.codex/sessions/${day}"
            [ -d "$dir" ] || continue
            for f in "$dir"/*.jsonl; do
                [ -f "$f" ] || continue
                mtime="$(_ae_stat mtime "$f" || echo 0)"
                [ "$mtime" -lt "$LAUNCH_TIME" ] && continue
                first_line="$(head -1 "$f" 2>/dev/null || true)"
                [ -z "$first_line" ] && continue
                file_cwd="$(echo "$first_line" | _ae_json_first cwd 2>/dev/null || true)"
                [ -z "$file_cwd" ] && continue
                file_cwd="$(realpath "$file_cwd" 2>/dev/null || echo "$file_cwd")"
                [ "$file_cwd" != "$TARGET_CWD" ] && continue
                if [ "$mtime" -gt "$best_mtime" ]; then
                    file_id="$(echo "$first_line" | _ae_json_first id '[0-9a-f-]' 2>/dev/null || true)"
                    if [ -n "$file_id" ]; then
                        best_id="$file_id"
                        best_mtime="$mtime"
                    fi
                fi
            done
        done
    fi
    if [ -n "$best_id" ]; then
        echo "$best_id" >"$META_DIR/codex.${SLOT}.sid"
        echo "registered session $best_id for slot $SLOT"
    else
        echo "no codex session found matching cwd $TARGET_CWD" >&2
        exit 1
    fi
}

