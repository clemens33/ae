#!/usr/bin/env bash
# ae - agentic engineering: tmux-based multi-agent workspace
set -euo pipefail
AE_VERSION="0.2.1"

# Fail fast with a clear message on bash < 4 (macOS ships 3.2 and defaults to
# zsh). This must sit BEFORE any bash-4-only syntax is parsed — bash parses
# function bodies at definition time, so a later guard never runs; 3.2 would
# die with a cryptic parse error instead.
if ((BASH_VERSINFO[0] < 4)); then
    echo "Error: ae requires bash >= 4.0 (found ${BASH_VERSION})." >&2
    echo "macOS: brew install bash, and make sure brew's bin dir precedes /bin on PATH (eval \"\$(brew shellenv)\")." >&2
    exit 1
fi

# AE_HOME relocates ALL ae state (config, sessions, worktrees) without swapping
# $HOME — so an isolated run (tests, e2e) can keep the real $HOME (and real
# agent-CLI auth under ~/.claude, ~/.codex) while writing ae state elsewhere.
# Unset → the normal ~/.ae. CONFIG_DIR derives from it; everything below derives
# from CONFIG_DIR, so this single knob is authoritative for the whole tool.
AE_HOME="${AE_HOME:-${HOME}/.ae}"
CONFIG_DIR="$AE_HOME"
# CONFIG_FILE honors a pre-set env var so tests + the generated daemon
# can point at a non-default config without rewriting the user's real one.
CONFIG_FILE="${CONFIG_FILE:-${CONFIG_DIR}/config}"
WORKTREES_DIR="${CONFIG_DIR}/worktrees"
SESSIONS_DIR="${CONFIG_DIR}/sessions"

# Per-project config override (optional)
AE_LOCAL_CONFIG=""
[[ -f ".ae/config" ]] && AE_LOCAL_CONFIG="$(pwd)/.ae/config"

# Optional: isolated tmux server (for testing or multi-instance use)
if [[ -n "${AE_TMUX_SERVER:-}" ]]; then
    tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }
fi

# --- Function index ---
#   Config:     parse_config, get_config
#   Helpers:    tool_name_from_cmd, tool_kind_from_cmd, default_session_name, tmux_attach, gen_uuid, detect_current_session
#   Resume:     strip_session_flags, resume_cmd_from_cmd, inject_session_id, inject_ae_context, resolve_agent_session_id
#   Session:    read_session_meta, list_ae_sessions, iter_stopped_sessions, kill_heartbeat, cleanup_session
#   End/branch: sanitize_branch_name, resolve_session_workdir, end_session
#   Commands:   cmd_list, cmd_status, cmd_stop, cmd_rename, cmd_end, cmd_doctor, cmd_transfer, cmd_help, _cmd_spawn
#   Manifest:   regenerate_manifest, sync_session_assets
#   Launch:     send_agent_cmd, capture_codex_session_id

DEFAULT_CONFIG='# ae config — auto-created on first run, yours to edit. Also mirrored in the repo as
# config.sample. INI-style: [section] headers, key = value, "#" starts a comment.
# New sessions read this whole file. Stopping + resuming an existing session (ae stop <name>;
# ae <name>) relaunches its preserved agents with their CURRENT command + [prompt] — but the
# roster (main/workers), layout, and watchdog stay pinned in session meta, so edits to those
# take effect for NEW sessions only. (ae doctor --refresh regenerates the on-disk session
# helpers + workspace.md after you upgrade ae; it changes neither running agents nor config.)

[agents]
# Register any CLI tool as an alias: alias = "the shell command that launches it".
# Model-named aliases: the prefix names the model + major, so the running model is legible at
# a glance. STRICT pins (never --model best) — a model-named alias must not silently run a
# different model; that would make the name lie and blind the model-drift alarm.
opus48 = "claude --permission-mode bypassPermissions --model opus --effort xhigh"
# fable5 = frontier lead tier (the default session lead; pair it with a cross-model colead).
fable5 = "claude --permission-mode bypassPermissions --model fable --effort xhigh"
sonnet5 = "claude --permission-mode bypassPermissions --model sonnet --effort low"
gpt56sol = "codex --yolo -m gpt-5.6-sol -c model_reasoning_effort=xhigh"
gpt56terra = "codex --yolo -m gpt-5.6-terra -c model_reasoning_effort=xhigh"
gpt56luna = "codex -m gpt-5.6-luna -c model_reasoning_effort=low -a never"
opencode = "opencode"

[workspace]
# main = the primary agent (alias:name). workers = comma-separated agents launched at start.
# layout = vertical | horizontal | lead-pair. watchdog = true nudges stale/idle agents.
# The lead delegates by rule (see docs/reference/delegation.md — spawn sonnet5:* / gpt56luna:*
# for chores). Distinct worker role names avoid the duplicate-name dedup churn. Worker ORDER
# matters under lead-pair: the FIRST worker (worker.0) is the COLEAD seat — a cross-model
# judgment partner sharing the leads window (0:leads); builders live in 1:workers. The
# dedicated reviewer seat (gpt56sol:reviewer, xhigh) keeps cross-model review always on
# hand — reviews go to a seat that is NOT the colead, so judgment and review stay separate.
main = fable5:lead
workers = gpt56sol:colead, opus48:builder, gpt56sol:reviewer
layout = lead-pair
watchdog = true

[prompt]
# ae already injects the full workspace protocol into every agent — the roster, the helper
# commands (send/ask/spawn/…), the delegation and comms rules — see the generated
# ~/.ae/sessions/<name>/workspace.md. Anything set here is APPENDED on top of that; per-project
# .ae/config overrides the global one. Uncomment to add your own house rules:
# instructions = "Always write tests. Prefer TypeScript."'

# Create default config if missing
if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$DEFAULT_CONFIG" >"$CONFIG_FILE"
    echo "Created default config at $CONFIG_FILE"
fi

# Simple INI parser — outputs section.key=value lines
# Reads global config, then per-project .ae/config (local values shadow global)
parse_config() {
    local section="" file line
    for file in "$CONFIG_FILE" "${AE_LOCAL_CONFIG:-}"; do
        # shellcheck disable=SC2015 # safe: if file is empty or missing, continue either way
        [[ -n "$file" ]] && [[ -f "$file" ]] || continue
        section=""
        while IFS= read -r line; do
            # Trim leading/trailing whitespace (pure bash, no sed fork)
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -z "$line" ]] && continue

            if [[ "$line" =~ ^\[([a-zA-Z_-]+)\]$ ]]; then
                section="${BASH_REMATCH[1]}"
                continue
            fi

            # Strip comments only outside quoted values
            if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*)\ *=\ *\"(.*)\"$ ]]; then
                printf '%s\n' "${section}.${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
            elif [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*)\ *=\ *(.+)$ ]]; then
                local val="${BASH_REMATCH[2]}"
                val="${val%%#*}"
                val="${val%"${val##*[![:space:]]}"}"
                printf '%s\n' "${section}.${BASH_REMATCH[1]}=${val}"
            else
                continue
            fi
        done <"$file"
    done
}

# Last match wins — local config overrides global
# Cached via deterministic temp file so subshells share the same parsed result.
get_config() {
    # NO disk cache — parse on every call. The old UID-global cache file raced:
    # (a) mtime keying (1-second resolution) served a same-second config REWRITE
    # stale, and (b) the check/write/read was not one transaction, so two concurrent
    # ae invocations with DIFFERENT configs could read each other's parse (codex
    # repro: 99/300 wrong-owner reads across 300 concurrent pairs; tmp.$$ names also
    # collide across subshells of one parent). The config is under a kilobyte and
    # parse_config is pure bash — direct parsing costs microseconds and cannot lie.
    local result="" entry
    while IFS= read -r entry; do
        if [[ "$entry" == "${1}="* ]]; then
            result="${entry#*=}"
        fi
    done < <(parse_config)
    printf '%s' "$result"
}

# Launch-time paste-and-submit. Delegates to ae_submit_pasted_message (the
# single unified paste+submit-verify impl) so the two paste paths can't drift —
# the tool-specific bracketed-paste + staged-recheck logic lives in ONE place.
# ae_submit_pasted_message is a column-0 fn, so it is available here at launch as
# well as in the generated helpers (via _lib). Usage: tmux_paste_submit <pane> <text>
tmux_paste_submit() {
    local pane="$1" text="$2"
    local buf="ae-ps-$$-${pane}"
    local tool
    tool="$(pane_current_command "$pane")"
    ae_submit_pasted_message "$pane" "$tool" "$buf" "$text"
}

shell_quote() {
    printf '%q' "$1"
}

pane_current_command() {
    tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null || true
}

command_is_shell() {
    case "$1" in
        bash | zsh | fish | sh | dash | "") return 0 ;;
        *) return 1 ;;
    esac
}

# Format an epoch timestamp as a relative time string (e.g. "2m ago", "3h ago").
# Empty/zero/missing input returns "-".
format_relative_time() {
    local ts="${1:-}"
    [[ -n "$ts" && "$ts" =~ ^[0-9]+$ && "$ts" -gt 0 ]] || {
        printf '%s' "-"
        return
    }
    local now delta
    now="$(date +%s 2>/dev/null || echo 0)"
    delta=$((now - ts))
    if ((delta < 0)); then
        printf 'just now'
    elif ((delta < 60)); then
        printf '%ss ago' "$delta"
    elif ((delta < 3600)); then
        printf '%sm ago' $((delta / 60))
    elif ((delta < 86400)); then
        printf '%sh ago' $((delta / 3600))
    elif ((delta < 604800)); then
        printf '%sd ago' $((delta / 86400))
    else
        printf '>7d'
    fi
}

build_launch_command() {
    local cmd="$1" prompt="$2"
    local launch_cmd="$cmd"

    case "$cmd" in
        codex*resume*)
            local codex_fallback
            # shellcheck disable=SC2001
            codex_fallback="$(echo "$cmd" | sed 's/ *resume [^ ]*//')"
            printf '%s || %s' "$cmd" "$codex_fallback"
            return 0
            ;;
        opencode*)
            printf '%s' "$cmd"
            return 0
            ;;
    esac

    # Ensure Claude Code doesn't detect nesting when ae is run from inside a Claude
    # session. Also disable the input-box ghost SUGGESTION: claude styling is not
    # focus-invariant, so the input-region sensor is content-based and needs "idle ==
    # bare ornament" to hold — a ghost placeholder would read as content and defer
    # first-contact sends. Off => a fresh pane shows only the ornament (input-region
    # slice, colead characterization). If the flag is ignored by a future claude, a
    # returned ghost simply reads as occupied => we fail closed, never clobber.
    if [[ "$cmd" == claude* ]]; then
        launch_cmd="env -u CLAUDECODE -u CLAUDE_CODE_SESSION CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=0 ${launch_cmd}"
    fi

    # Resilient resume: if claude --resume UUID fails, fall back to --continue.
    if [[ "$cmd" == claude*" --resume "* ]]; then
        local fallback_continue
        # shellcheck disable=SC2001
        fallback_continue="$(echo "$launch_cmd" | sed 's/--resume [^ ]*/--continue/')"
        launch_cmd="${launch_cmd} || ${fallback_continue}"
    fi

    if [[ -n "$prompt" ]]; then
        printf '%s %s' "$launch_cmd" "$(shell_quote "$prompt")"
    else
        printf '%s' "$launch_cmd"
    fi
}

# Extract the binary name from a command string, skipping leading env-var
# assignments (FOO=bar) and well-known launcher prefixes (env, sudo, nice, ...).
# Tracks per-launcher option-argument flags so e.g. "sudo -u alice codex"
# correctly skips "alice" as the option arg of "-u" rather than treating
# it as the binary. Used by the watchdog's dead-check so it can find the actual
# agent process even when the configured command is wrapped.
extract_binary_from_cmd() {
    local cmd="$1"
    local words=()
    local w
    for w in $cmd; do
        words+=("$w")
    done
    local n=${#words[@]} i=0
    local arg_flags="" skip_next=0
    while ((i < n)); do
        w="${words[$i]}"
        if ((skip_next)); then
            skip_next=0
            i=$((i + 1))
            continue
        fi
        case "$w" in
            *=*)
                # env-var assignment (FOO=bar)
                i=$((i + 1))
                continue
                ;;
            env)
                arg_flags=" -C -u --chdir --unset --block-signal --default-signal --ignore-signal "
                i=$((i + 1))
                continue
                ;;
            sudo)
                # Only flags that take an option argument; booleans like -E -i -s -n are NOT here.
                arg_flags=" -C -D -U -g -h -p -r -t -u --close-from --chroot --group --host --prompt --role --type --user --other-user "
                i=$((i + 1))
                continue
                ;;
            nice)
                arg_flags=" -n --adjustment "
                i=$((i + 1))
                continue
                ;;
            ionice)
                arg_flags=" -c -n -p -P -u --class --classdata --pid --pgid --uid "
                i=$((i + 1))
                continue
                ;;
            time)
                arg_flags=" -o -f --output --format --append "
                i=$((i + 1))
                continue
                ;;
            nohup | command | exec)
                arg_flags=""
                i=$((i + 1))
                continue
                ;;
            -*)
                # Launcher option flag — skip its arg if it's in the known arg-flags list
                if [[ -n "$arg_flags" && "$arg_flags" == *" $w "* ]]; then
                    skip_next=1
                fi
                i=$((i + 1))
                continue
                ;;
            *)
                # First non-flag, non-assignment, non-launcher word — that's the binary
                printf '%s' "${w##*/}"
                return 0
                ;;
        esac
    done
}

write_launch_script() {
    local meta_dir="$1" slot="$2" launch_cmd="$3"
    local safe_slot="${slot//[^A-Za-z0-9._-]/_}"
    local script="${meta_dir}/launch.${safe_slot}.sh"
    cat >"$script" <<EOF
#!/usr/bin/env bash
exec bash -lc $(shell_quote "$launch_cmd")
EOF
    chmod 0700 "$script"
    printf '%s' "$script"
}

wait_for_agent_start() {
    local pane="$1" tool_kind="$2"
    local tries="${3:-40}"
    local current=""

    case "$tool_kind" in
        claude | codex | opencode) ;;
        *)
            return 0
            ;;
    esac

    for ((i = 0; i < tries; i++)); do
        current="$(pane_current_command "$pane")"
        if [[ "$current" == "$tool_kind" ]]; then
            return 0
        fi
        if ! command_is_shell "$current"; then
            return 0
        fi
        sleep 0.1
    done

    return 1
}

reset_shell_launch_input() {
    local pane="$1"
    tmux send-keys -t "$pane" C-c 2>/dev/null || true
    sleep 0.1
    tmux send-keys -t "$pane" C-u 2>/dev/null || true
    sleep 0.1
}

# Map command prefix to human-readable tool name
tool_name_from_cmd() {
    case "$1" in
        claude*) echo "claude code" ;;
        codex*) echo "codex" ;;
        gemini*) echo "gemini cli" ;;
        grok*) echo "grok build" ;;
        opencode*) echo "opencode" ;;
        *) echo "$1" ;;
    esac
}

# Strip session/resume flags from a command (whole-token matching to avoid mangling e.g. --continue-on-error)
strip_session_flags() {
    echo "$1" | sed \
        -e 's/\(^\|  *\)--session-id[= ][^ ]*/\1/g' \
        -e 's/\(^\|  *\)--resume[= ][^ ]*/\1/g' \
        -e 's/\(^\|  *\)--continue\(  *\|$\)/\1\2/g' \
        -e 's/  */ /g; s/^ //; s/ $//'
}

# Strip opencode-specific session/resume flags (--session ID, -s ID, -c, --continue)
strip_opencode_session_flags() {
    echo "$1" | sed \
        -e 's/\(^\|  *\)--session[= ][^ ]*/\1/g' \
        -e 's/\(^\|  *\)-s[= ][^ ]*/\1/g' \
        -e 's/\(^\|  *\)--continue\(  *\|$\)/\1\2/g' \
        -e 's/\(^\|  *\)-c\(  *\|$\)/\1\2/g' \
        -e 's/  */ /g; s/^ //; s/ $//'
}

# Strip gemini prompt injection flags (-i '...' / --prompt-interactive '...')
# Only called for gemini commands. We control the format: always single-quoted via inject_ae_context.
strip_gemini_prompt_flags() {
    echo "$1" | sed \
        -e "s/ --prompt-interactive '[^']*'//g" \
        -e "s/ -i '[^']*'//g" \
        -e 's/  */ /g; s/^ //; s/ $//'
}

# Strip Grok session/resume flags for clean resume-command reconstruction.
# Grok (xAI CLI, verified live 0.2.x) session surface:
#   -s, --session-id <UUID>   VALUE REQUIRED — new-conversation launch id
#   -r, --resume [<UUID>]     VALUE OPTIONAL — resume by id, or latest if omitted
#   -c, --continue            no value
# The optional-value forms are the trap the generic strip_session_flags cannot handle:
# it misses the short forms entirely, and its greedy `--resume[= ][^ ]*` eats the token
# AFTER a bare `--resume` (e.g. the `--effort` in `--resume --effort high`), turning a
# real flag into a positional prompt. Tokenize instead: eat a value ONLY when it does
# not itself look like a flag, and pass every non-session token through verbatim in
# order (so --effort, -m MODEL, --always-approve all survive).
strip_grok_session_flags() {
    local cmd="$1"
    local -a toks=() kept=()
    read -ra toks <<<"$cmd" || true
    local n=${#toks[@]} i=0
    while ((i < n)); do
        case "${toks[i]}" in
            # attached value (equals form) — drop the single token
            --session-id=* | --resume=* | -s=* | -r=*) ;;
            # clap-style attached short value (-sUUID / -rUUID, no '='): Grok 0.2.106
            # accepts these. Without this branch, inject/resume append a second long
            # session flag and live Grok rejects rc=2 (option used multiple times).
            # Pattern is -s?* / -r?* so bare -s / -r fall through to the exact arms.
            -s?* | -r?*) ;;
            # value-required session flag — drop it AND its value token
            --session-id | -s)
                if ((i + 1 < n)); then i=$((i + 1)); fi
                ;;
            # optional-value resume — drop it; eat the next token only if it is a value,
            # never another flag (this is the bare-resume trap the generic strip fails)
            --resume | -r)
                if ((i + 1 < n)) && [[ "${toks[i + 1]}" != -* ]]; then i=$((i + 1)); fi
                ;;
            # bare continue — no value
            --continue | -c) ;;
            *) kept+=("${toks[i]}") ;;
        esac
        i=$((i + 1))
    done
    echo "${kept[*]}"
}

# Derive resume command with session-scoped ID (survives multiple concurrent sessions)
# Falls back to heuristic resume, then fresh start
resume_cmd_from_cmd() {
    local cmd="$1" session_id="${2:-}"
    # Treat "pending" (uncaptured) as no session ID — fall back to fresh start
    [[ "$session_id" == "pending" ]] && session_id=""
    local clean
    clean="$(strip_session_flags "$cmd")"
    case "$cmd" in
        claude*)
            if [[ -n "$session_id" ]]; then
                echo "${clean} --resume ${session_id}"
            else
                echo "${clean} --continue"
            fi
            ;;
        codex*)
            if [[ -n "$session_id" ]]; then
                # Preserve flags (e.g. --yolo) from original command for the resume subcommand
                local codex_flags="${clean#codex}"
                codex_flags="${codex_flags# }" # strip leading space
                if [[ -n "$codex_flags" ]]; then
                    echo "codex ${codex_flags} resume ${session_id}"
                else
                    echo "codex resume ${session_id}"
                fi
            else
                echo "$clean" # fresh start (--last is unreliable for concurrent sessions)
            fi
            ;;
        opencode*)
            clean="$(strip_opencode_session_flags "$clean")"
            if [[ -n "$session_id" ]]; then
                echo "${clean} --session ${session_id}"
            else
                echo "${clean} --continue"
            fi
            ;;
        gemini*)
            clean="$(strip_gemini_prompt_flags "$clean")"
            if [[ -n "$session_id" ]]; then
                echo "${clean} --resume ${session_id}"
            else
                echo "${clean} --resume latest"
            fi
            ;;
        grok*)
            # claude-shaped: exact UUID resume, CWD-heuristic --continue fallback.
            # Normalize from the ORIGINAL cmd, not $clean: the generic strip_session_flags
            # ran above misses grok's short forms (-s/-r/-c) and would already have eaten
            # the token after a bare --resume. strip_grok_session_flags is the complete
            # normalizer for grok's whole session surface.
            clean="$(strip_grok_session_flags "$cmd")"
            if [[ -n "$session_id" ]]; then
                echo "${clean} --resume ${session_id}"
            else
                echo "${clean} --continue"
            fi
            ;;
        *) echo "$clean" ;; # fresh start for unknown agents
    esac
}

# Inject agent-scoped session ID into start command (enables targeted resume later)
inject_session_id() {
    local cmd="$1" session_id="$2"
    [[ "$session_id" == "pending" ]] && session_id=""
    local clean
    clean="$(strip_session_flags "$cmd")"
    if [[ -n "$session_id" ]]; then
        case "$cmd" in
            # grok takes an ae-generated UUID at launch exactly like claude (verified
            # live): the id is known upfront, so resume is UUID-scoped from the first
            # cycle — no launch-token scan, no _register-sid handshake, no entry in
            # tool_kind_supports_launch_id. Re-normalize from $cmd with the grok-complete
            # stripper so a pre-existing -s/-r/-c or bare --resume in the config cannot
            # stack with — or swallow — the launch --session-id.
            grok*) echo "$(strip_grok_session_flags "$cmd") --session-id ${session_id}" ;;
            claude*) echo "${clean} --session-id ${session_id}" ;;
            *) echo "$clean" ;;
        esac
    else
        echo "$clean"
    fi
}

tool_kind_supports_launch_id() {
    case "$1" in
        codex | opencode | gemini) return 0 ;;
        *) return 1 ;;
    esac
}

read_launch_id_for_slot() {
    local meta_dir="$1" slot="$2"
    local escaped_slot="${slot//./\\.}"
    local launch_id=""
    launch_id="$(grep "^launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [[ -z "$launch_id" ]]; then
        # Backward compatibility for sessions created before generic launch_id keys.
        launch_id="$(grep "^codex_launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_id" ]]; then
        launch_id="$(grep "^opencode_launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_id" ]]; then
        launch_id="$(grep "^gemini_launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    printf '%s' "$launch_id"
}

read_launch_time_for_slot() {
    local meta_dir="$1" slot="$2"
    local escaped_slot="${slot//./\\.}"
    local launch_time=""
    launch_time="$(grep "^launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [[ -z "$launch_time" ]]; then
        # Backward compatibility for sessions created before generic launch_time keys.
        launch_time="$(grep "^codex_launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_time" ]]; then
        launch_time="$(grep "^opencode_launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_time" ]]; then
        launch_time="$(grep "^gemini_launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    case "$launch_time" in
        '' | *[!0-9]*)
            launch_time=0
            ;;
    esac
    printf '%s' "$launch_time"
}

# --- status-left location rendering (mode-aware session path) ---------
# Abbreviate $HOME -> ~ for compactness. The `~` here is a literal display glyph,
# not a path to expand — hence SC2088 is intentionally disabled.
# shellcheck disable=SC2088
_ae_abbrev_home() {
    local p="$1"
    if [[ "$p" == "$HOME" ]]; then
        printf '~'
    elif [[ "$p" == "$HOME/"* ]]; then
        printf '~/%s' "${p#"$HOME"/}"
    else
        printf '%s' "$p"
    fi
}

# Truncate from the LEFT (keep the meaningful tail), prefixing … when cut.
_ae_trunc_left() {
    local s="$1" max="${2:-40}"
    if ((${#s} > max)); then
        printf '…%s' "${s: -$((max - 1))}"
    else
        printf '%s' "$s"
    fi
}

# Build the status-left location string from mode/origin/work_dir:
#   local -> <work_dir>             (origin == work_dir; one path)
#   full  -> <origin> → <work_dir>  (copy: where it was opened → the copy)
#   git   -> <origin> ⌁ <work_dir>  (worktree: origin repo ⌁ the worktree)
_ae_status_left_paths() {
    local mode="$1" origin="$2" work_dir="$3"
    local o w
    o="$(_ae_trunc_left "$(_ae_abbrev_home "$origin")")"
    w="$(_ae_trunc_left "$(_ae_abbrev_home "$work_dir")")"
    case "$mode" in
        full) printf '%s → %s' "$o" "$w" ;;
        git) printf '%s ⌁ %s' "$o" "$w" ;;
        *) printf '%s' "$w" ;;
    esac
}

# Escape a string for literal use inside tmux status FORMAT TEXT (e.g. status-left).
# Two metacharacters expand there: `#` (format introducer — `#S`/`#(cmd)`/`#{…}`) and
# `%` (strftime — `%Y`/`%H`…). Both must be doubled (`##`, `%%`) or a path containing
# them silently renders wrong or runs a shell job on every status redraw. Applied to
# the static path text. (Live branch/health are tmux user-OPTION values, which are
# interpolated literally — neither `#` nor `%` expands there — so they need no escape.)
_ae_tmux_format_literal() {
    local s="${1//\#/##}"
    printf '%s' "${s//%/%%}"
}

# Render and apply the mode-aware session location to a session's status-left,
# escaped for tmux format context, with status-left-length raised so it isn't
# clipped (tmux default is 10). No-op if the target session isn't running. Shared
# by session creation and `ae doctor --refresh` so a refreshed live session keeps
# both halves of the bar in sync. server="" uses the ambient tmux (the wrapped
# server at launch); a non-empty server (refresh path, read from meta) targets it
# explicitly via -L.
# Apply ae's status BAR to a session — both halves, one owner (ae; the watchdog only
# feeds user options). Shape: [ae <session>]  0:leads 1:workers 99:ae-monitor  [<path> <git>] [watch …]
#   left   = [ae <session>]           (name only — the window list renders after it)
#   middle = tmux's native window list (role-named windows under lead-pair/lead-solo)
#   right  = [<path><git>] [watch …]  (path static; git + watch via user options)
_ae_apply_status_bar() {
    local session="$1" mode="$2" origin="$3" work_dir="$4" server="${5:-}"
    local _t=(tmux)
    [[ -n "$server" ]] && _t=(command tmux -L "$server")
    "${_t[@]}" has-session -t "$session" 2>/dev/null || return 0
    # Target by session ID, resolved by EXACT name match: tmux session targets
    # prefix-match, so theming 'foo' would silently rewrite live 'foobar' if foo
    # vanished mid-apply. Resolve through the same tmux command this function uses.
    local _st
    _st="$("${_t[@]}" list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id "$session")"
    [[ -n "$_st" ]] || return 0
    local paths sess_lit
    paths="$(_ae_tmux_format_literal "$(_ae_status_left_paths "$mode" "$origin" "$work_dir")")"
    # The SESSION NAME is user text entering a tmux FORMAT context — #-escape it like
    # the path (a name with '#' would otherwise open a format/#() directive). With the
    # name in status-left, window 0 is free to carry a role name under lead-pair.
    sess_lit="$(_ae_tmux_format_literal "$session")"
    "${_t[@]}" set-option -t "$_st" status-left "[ae ${sess_lit}] " 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" status-left-length 40 2>/dev/null || true
    # status-right is OWNED BY AE, baked once here — the watchdog never rewrites it
    # (it only sets/unsets the user options below, so there is nothing to save,
    # prepend, restore, or dedup). The path is static #-escaped text; the live parts
    # come via user options, which tmux interpolates LITERALLY — not re-expanded, not
    # parsed for directives — so branch names / status text with ), #, spaces, or
    # shell metacharacters are harmless (no #() command, no shell):
    #   @ae_branch_status   ' <branch><dirty>' — watchdog, each cycle (empty when off)
    #   @ae_watchdog_status '[watch <glyph> a/t]' — watchdog health (empty when off)
    "${_t[@]}" set-option -t "$_st" status-right "[${paths}#{@ae_branch_status}] #{@ae_watchdog_status}" 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" status-right-length 100 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" status-interval 5 2>/dev/null || true
    # SECOND status line: the focused pane's agent identity. tmux renders pane borders
    # (which carry #{@ae_agent}) only in windows with 2+ panes — a lone agent in its own
    # window (lead-solo's lead, a single worker, spawned agents) had NO visible identity.
    # Line 1 shows the active pane's @ae_agent (user option -> interpolated literally,
    # injection-safe) so 'who am I looking at' is always answered, any pane count.
    "${_t[@]}" set-option -t "$_st" status 2 2>/dev/null || true
    # tmux ARRAY options do NOT inherit per-index: setting session-scope
    # status-format[1] alone shadows the WHOLE global array, leaving index 0 (the
    # standard bar: status-left + window list + status-right) EMPTY at session scope
    # — the bar renders as a blank line (live exhibit: the first session-shape
    # launch). Copy the global [0] into the session alongside our [1].
    local _fmt0
    _fmt0="$("${_t[@]}" show-options -gv 'status-format[0]' 2>/dev/null || true)"
    if [[ -n "$_fmt0" ]]; then
        "${_t[@]}" set-option -t "$_st" 'status-format[0]' "$_fmt0" 2>/dev/null || true
    fi
    # Right side of line 1: the per-agent roster (@ae_agents_status, watchdog-published
    # each cycle, empty/unset when the watchdog is off). Agents live across multiple
    # windows and this bar renders in every one, so the whole org is visible from any
    # window. Right-aligned so it never collides with the left-aligned focused identity.
    "${_t[@]}" set-option -t "$_st" 'status-format[1]' '#[align=left] #{@ae_agent}#[align=right]#{@ae_agents_status} ' 2>/dev/null || true
    # WINDOW LIST: each window carries its own agents' verdict glyphs, so attention maps
    # SPATIALLY onto the windows you already scan ('0:leads●● 1:workers⚙◌'). The
    # right-side roster still answers WHO; this answers WHERE.
    # @ae_window_status is a WINDOW-scoped user option (watchdog-published each cycle,
    # empty/unset when it is off), interpolated literally like the others.
    # OWNERSHIP: window-status-format is user-THEMING territory. ae deliberately owns it
    # INSIDE its own sessions and writes it at SESSION scope only — a global write would
    # leak ae's glyphs into every other tmux session the user runs. #F is preserved: it
    # carries tmux's own zoom/activity/current markers, and dropping it would silently
    # eat them.
    "${_t[@]}" set-option -t "$_st" window-status-format '#I:#W#{@ae_window_status}#F' 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" window-status-current-format '#I:#W#{@ae_window_status}#F' 2>/dev/null || true
}

# Build ae workspace context string (shared by inject_ae_context and initial prompt fallback)
build_ae_context() {
    local meta_dir="$1" session="${2:-}" work_dir="${3:-}" slot="${4:-}"
    local ctx="You are in an ae multi-agent workspace. Session: ${session}. Directory: ${work_dir}."
    ctx+=" Helper scripts in ${meta_dir}/ — always invoke them by their full path (they are not on PATH). Read ${meta_dir}/workspace.md for the full helper catalog and current agent names."
    ctx+=" REQUIRED RULES:"
    ctx+=" (1) Communicate only through ae helpers — never raw tmux send-keys."
    ctx+=" (2) ${meta_dir}/ask <agent> <question> or ${meta_dir}/review <agent> <request> when you require a reply (returns a request id). ${meta_dir}/send <agent> <message> for one-way."
    ctx+=" (3) When another agent gives you an exact reply command, run it verbatim. Do not infer the recipient. Do not reply only in your own pane output."
    ctx+=" (4) Do not poll or capture panes waiting for replies — answers arrive as incoming messages. ${meta_dir}/peek <agent> [lines] (alias peak) is for inspection only, never as a reply mechanism."
    ctx+=" (5) Declare your state with ${meta_dir}/state <working|waiting-user|blocked|done> <reason> whenever it changes: working when taking new work or resuming, waiting-user only after asking the human, blocked only after a concrete external blocker (reason required), done at completion or pause. ${meta_dir}/mark-done \"<summary>\" still works as shorthand for state done. Your declared state shows in 'ae list' (per agent). Your waiting-user/blocked contribute to the session attn marker; ae list may also show watchdog-derived reasons (dead/stale/throttled). The watchdog stops nudging you on any quiet state: done is honoured until a newer message arrives; waiting-user/blocked are honoured until the pane changes (e.g. the human replies), then normal nudging resumes."
    ctx+=" (6) ${meta_dir}/memo add [--topic <topic>] <text> for durable shared findings, decisions, and handoffs that survive restarts. Do not dump chat transcripts into memo."
    ctx+=" (7) IMPORTANT — CONCURRENT COLLABORATION: Other agents may be editing files in this same workspace RIGHT NOW. Files you read may change. Coordinate on shared files; verify intent via ${meta_dir}/send before reverting or overwriting unexpected modifications."
    ctx+=" (8) ${meta_dir}/say <text> pushes a free-text line to the human's Telegram chat (if the bridge is running). Use it to answer the human when they message you from Telegram — your normal pane replies do NOT reach them. Replies to your message on Telegram route back to you."
    ctx+=" (9) DELEGATION: for bounded subtasks (spec fits ~10 lines, clear stop condition, result verifiable by tests/grep/review), spawn the cheapest capable alias with a role name instead of polluting your own context: ${meta_dir}/spawn <alias>:<name> [prompt] — pick an alias from workspace.md (e.g. a cheap-burst tier: spawn sonnet5:tests 'run just test-unit; report failures only'). PREFER ae spawn over your harness's internal subagents for anything beyond a quick or bursty read-only lookup/fan-out consumed immediately: ae workers are visible to the human (own window), steward-monitored, and messageable — internal subagents are invisible to everyone but you. Brief workers with objective, scope, verification command, and expected reply shape; expect a distilled summary (Outcome/Changed/Verified/Risks), never raw logs. One writer per file. YOU own review and ${meta_dir}/retire <name> — workers never self-retire; keep judgment-heavy work yourself. See workspace.md 'Delegation'."
    # Session facts from meta (mode, origin, layout) — read ONCE, up front: the role
    # block needs layout (the colead seat is structural: layout=lead-pair + worker.0)
    # and the working-tree block needs mode/origin. Callers stay unchanged; works at
    # launch and resume. Missing meta -> empty values -> the generic fallbacks below.
    local _mode="" _origin="" _layout=""
    if [[ -f "${meta_dir}/meta" ]]; then
        _mode="$(grep '^mode=' "${meta_dir}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
        _origin="$(grep '^origin=' "${meta_dir}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
        _layout="$(grep '^layout=' "${meta_dir}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    fi
    # Slot-aware ROLE block (hardcoded, like the rules above — NOT a config key). The lead gets
    # the delegation decision-rule; workers get the execution contract. Under layout=lead-pair
    # the FIRST worker (worker.0) is the COLEAD seat — a judgment partner, not a builder. Slot
    # is main/worker.N/spawned.N from meta and layout is an ae-validated keyword (never user
    # text), so both are safe in this branch.
    case "$slot" in
        main)
            ctx+=" LEAD ROLE: your tokens are for JUDGMENT — triage, rulings, gates, adjudication, and the human interface; never delegate those. DELEGATE the rest (implementation, tests, docs, chores, research, scoping): when a subtask has a spec that fits ~10 lines AND a verifiable stop condition, spawn a worker (rule 9) instead of spending your own context on it. You still own review and retirement of every worker, and you keep the judgment-heavy work yourself."
            ;;
        worker.* | spawned.*)
            if [[ "$slot" == "worker.0" && "$_layout" == "lead-pair" ]]; then
                ctx+=" COLEAD ROLE: you are the lead's JUDGMENT PARTNER, sharing its window — not a builder, and not the code reviewer (the reviewer reviews what was BUILT; you challenge what is being DECIDED). Stress-test rulings and briefs BEFORE they ship, run second gate reads on gated diffs, and hunt the blind spot in the lead's reasoning. Disagree once, concretely, with evidence — log dissent via memo so it survives — then THE LEAD RULES: one owner per decision, no stalemates, and you commit to the ruling. You own no files and build no slices; your output is judgment, findings-first."
            else
                ctx+=" WORKER ROLE: you execute the briefed subtask within its stated scope. Report a distilled summary — Outcome / Changed / Verified (command + result) / Risks / Need-from-lead — never raw logs. Stay in your assigned files (one writer per file); surface any decision that needs judgment to the lead rather than deciding it unilaterally. You do not self-retire — the lead retires you when the task is verified done."
            fi
            ;;
    esac
    # Mode-aware WORKING-TREE block (hardcoded like the slot role — code, not config).
    # Missing/unknown mode -> no block (fail-quiet, like a slotless pane). Rule 7's
    # concurrency caution is universal; the human-LIVE-tree caution lives ONLY here.
    case "$_mode" in
        local)
            ctx+=" WORKING TREE: you are in the human's LIVE checkout — their uncommitted work may be present. One writer per file; NO destructive git operations (no reset --hard, clean -fd, or checkout of files you did not change); never assume the tree is yours alone."
            ;;
        git)
            ctx+=" WORKING TREE: an isolated git worktree checked out at a DETACHED HEAD from origin (not a named branch yet) — work BOLDLY here. The origin checkout at ${_origin} is strictly OFF-LIMITS. Untracked files (dependencies, .env) from the origin do NOT exist here — install locally if you need them. 'ae end' commits your work and pushes it to a new ae/<session> branch."
            ;;
        full)
            ctx+=" WORKING TREE: a full copy of the project in a separate directory. The origin at ${_origin} is off-limits; your changes reach the project only via 'ae end' (its branch push)."
            ;;
    esac
    local user_instr
    user_instr="$(get_config prompt.instructions)"
    [[ -n "$user_instr" ]] && ctx="${ctx} --- Workspace instructions: ${user_instr}"
    printf '%s' "$ctx"
    return 0
}

# Inject ae workspace context into agent system prompt (survives context compaction)
# Claude Code: --append-system-prompt; Codex: -c developer_instructions; others: initial prompt
inject_ae_context() {
    local cmd="$1" meta_dir="$2" session="${3:-}" work_dir="${4:-}" slot="${5:-}"
    local ctx
    ctx="$(build_ae_context "$meta_dir" "$session" "$work_dir" "$slot")"
    case "$cmd" in
        claude*)
            local escaped="${ctx//\'/\'\\\'\'}"
            echo "${cmd} --append-system-prompt '${escaped}'"
            ;;
        codex*)
            # Tell codex to self-register its session ID by running the slot-scoped helper script
            local slot_arg=""
            local launch_marker=""
            [[ -n "$slot" ]] && slot_arg=" ${slot}"
            if [[ -n "$slot" && -f "${meta_dir}/meta" ]]; then
                local launch_id
                launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
                if [[ -n "$launch_id" ]]; then
                    # Meta keys are generic (launch_id.<slot>), but persisted markers stay tool-specific
                    # because the matching logic searches different external storage backends per tool.
                    launch_marker=$'\n'"AE_CODEX_LAUNCH_ID=${launch_id}"$'\n'"AE_CODEX_SLOT=${slot}"
                fi
            fi
            local full_ctx="${ctx} --- CRITICAL FIRST TASK: Enable session resume by running: ${meta_dir}/_register-sid${slot_arg} — do this NOW before anything else.${launch_marker}"
            local escaped="${full_ctx//\'/\'\\\'\'}"
            echo "${cmd} -c developer_instructions='${escaped}'"
            ;;
        gemini*)
            local launch_marker=""
            if [[ -n "$slot" && -f "${meta_dir}/meta" ]]; then
                local launch_id
                launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
                if [[ -n "$launch_id" ]]; then
                    # Meta keys are generic (launch_id.<slot>), but persisted markers stay tool-specific
                    # because the matching logic searches different external storage backends per tool.
                    launch_marker=$'\n'"AE_GEMINI_LAUNCH_ID=${launch_id}"$'\n'"AE_GEMINI_SLOT=${slot}"
                fi
            fi
            local full_ctx="${ctx}${launch_marker} --- IMPORTANT: This is context only. Do NOT act on it. Wait for the user to give you a task."
            local escaped="${full_ctx//\'/\'\\\'\'}"
            echo "${cmd} -i '${escaped}'"
            ;;
        grok*)
            # grok has NO append-style system-prompt flag: --system-prompt-override
            # REPLACES the agent's own prompt (its tooling depends on that prompt), so
            # ae must never use it. The context rides in as the POSITIONAL initial
            # prompt — grok's own argv contract ([PROMPT]) — same shape as gemini's -i,
            # with the same do-not-act suffix so the agent waits for a real task.
            local full_ctx="${ctx} --- IMPORTANT: This is context only. Do NOT act on it. Wait for the user to give you a task."
            local escaped="${full_ctx//\'/\'\\\'\'}"
            echo "${cmd} '${escaped}'"
            ;;
        *) echo "$cmd" ;;
    esac
}

# For agents without system prompt injection, return context as emphasized initial message
initial_prompt_for_cmd() {
    local cmd="$1" meta_dir="$2" session="${3:-}" work_dir="${4:-}" slot="${5:-}"
    case "$cmd" in
        claude* | gemini* | grok*) echo "" ;; # context injected via CLI flag/argv
        codex*) echo "Go" ;;                  # codex needs a user message to act on developer_instructions
        opencode*)
            local ctx
            local launch_marker=""
            ctx="$(build_ae_context "$meta_dir" "$session" "$work_dir" "$slot")"
            if [[ -n "$slot" && -f "${meta_dir}/meta" ]]; then
                local launch_id
                launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
                if [[ -n "$launch_id" ]]; then
                    # Meta keys are generic (launch_id.<slot>), but persisted markers stay tool-specific
                    # because the matching logic searches different external storage backends per tool.
                    launch_marker=$'\n'"AE_OPENCODE_LAUNCH_ID=${launch_id}"$'\n'"AE_OPENCODE_SLOT=${slot}"
                fi
            fi
            printf '%s' "IMPORTANT — read and internalize these workspace instructions before doing anything else. They apply for the ENTIRE session. ${ctx}${launch_marker} Confirm you understood by briefly listing the other agents and available helpers."
            ;;
        *) echo "" ;; # unknown agents: no injection (no reliable delivery method)
    esac
}

# Generate a UUID (for agent session scoping)
gen_uuid() {
    if [[ -f /proc/sys/kernel/random/uuid ]]; then
        cat /proc/sys/kernel/random/uuid
    elif command -v uuidgen >/dev/null 2>&1; then
        uuidgen
    else
        echo "ae: no UUID generator available (need /proc/sys/kernel/random/uuid or uuidgen)" >&2
        echo "ae: install util-linux or uuid-runtime, or ensure /proc is mounted" >&2
        return 1
    fi
}

# Detect current ae session when running inside tmux (for ae end/status without name)
detect_current_session() {
    if [[ -n "${TMUX:-}" ]]; then
        local session_name
        session_name="$(tmux display-message -p '#{session_name}' 2>/dev/null)" || return 1
        if [[ -d "${SESSIONS_DIR}/${session_name}" ]]; then
            echo "$session_name"
            return 0
        fi
    fi
    return 1
}

# Detect tool kind from command (for staleness checks on resume)
tool_kind_from_cmd() {
    case "$1" in
        claude*) echo "claude" ;;
        codex*) echo "codex" ;;
        gemini*) echo "gemini" ;;
        grok*) echo "grok" ;;
        opencode*) echo "opencode" ;;
        *) echo "unknown" ;;
    esac
}

# Find a codex session ID by matching an ae-injected launch marker in the session log.
# Scans recent session files (today + yesterday to handle UTC midnight rollover).
# Only considers files modified after $launch_time (epoch seconds) to avoid stale matches.
# Returns the UUID of the newest matching session, or empty string.
find_codex_session_by_launch_id() {
    local launch_id="$1" launch_time="${2:-0}"
    local best_id="" best_mtime=0
    local day
    for day in "$(date -u +%Y/%m/%d)" "$(date -u -d 'yesterday' +%Y/%m/%d 2>/dev/null || date -u -v-1d +%Y/%m/%d 2>/dev/null || true)"; do
        [[ -z "$day" ]] && continue
        local dir="$HOME/.codex/sessions/${day}"
        [[ -d "$dir" ]] || continue
        local f
        for f in "$dir"/*.jsonl; do
            [[ -f "$f" ]] || continue
            local mtime
            mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
            ((mtime < launch_time)) && continue
            grep -Fq "AE_CODEX_LAUNCH_ID=${launch_id}" "$f" 2>/dev/null || continue
            if ((mtime > best_mtime)); then
                local first_line file_id
                first_line="$(head -1 "$f" 2>/dev/null || true)"
                [[ -z "$first_line" ]] && continue
                file_id="$(echo "$first_line" | grep -oP '"id"\s*:\s*"\K[0-9a-f-]+' 2>/dev/null || true)"
                if [[ -n "$file_id" ]]; then
                    best_id="$file_id"
                    best_mtime="$mtime"
                fi
            fi
        done
    done
    echo "$best_id"
}

# Find a codex session ID by matching CWD in session_meta JSON.
# Scans recent session files (today + yesterday to handle UTC midnight rollover).
# Only considers files modified after $launch_time (epoch seconds) to avoid stale matches.
# Returns the UUID of the newest matching session, or empty string.
find_codex_session_by_cwd() {
    local target_cwd="$1" launch_time="${2:-0}"
    # Normalize target CWD (resolve symlinks/worktrees)
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    local best_id="" best_mtime=0
    # Scan today and yesterday (handles UTC midnight rollover)
    local day
    for day in "$(date -u +%Y/%m/%d)" "$(date -u -d 'yesterday' +%Y/%m/%d 2>/dev/null || date -u -v-1d +%Y/%m/%d 2>/dev/null || true)"; do
        [[ -z "$day" ]] && continue
        local dir="$HOME/.codex/sessions/${day}"
        [[ -d "$dir" ]] || continue
        local f
        for f in "$dir"/*.jsonl; do
            [[ -f "$f" ]] || continue
            # Skip files older than launch_time
            local mtime
            mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
            ((mtime < launch_time)) && continue
            # Parse first line: extract payload.cwd and payload.id
            local first_line file_cwd file_id
            first_line="$(head -1 "$f" 2>/dev/null || true)"
            [[ -z "$first_line" ]] && continue
            file_cwd="$(echo "$first_line" | grep -oP '"cwd"\s*:\s*"\K[^"]*' 2>/dev/null || true)"
            [[ -z "$file_cwd" ]] && continue
            # Normalize file CWD
            file_cwd="$(realpath "$file_cwd" 2>/dev/null || echo "$file_cwd")"
            [[ "$file_cwd" != "$target_cwd" ]] && continue
            # CWD matches — pick newest by mtime
            if ((mtime > best_mtime)); then
                file_id="$(echo "$first_line" | grep -oP '"id"\s*:\s*"\K[0-9a-f-]+' 2>/dev/null || true)"
                if [[ -n "$file_id" ]]; then
                    best_id="$file_id"
                    best_mtime="$mtime"
                fi
            fi
        done
    done
    echo "$best_id"
}

# Best-effort: capture Codex session ID post-launch.
# Fallback chain: A) sid-file from register-sid, B) launch-token scan, C) CWD scan, D) pane scrape.
capture_codex_session_id() {
    local pane="$1" slot="$2" meta_dir="$3"
    local sid_file="${meta_dir}/codex.${slot}.sid"
    local captured=""
    local work_dir launch_time launch_id
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    # A) Poll for self-registered session ID (codex writes codex.SLOT.sid via developer_instructions)
    local _attempt
    for _attempt in 1 2 3 4 5 6; do
        sleep 5
        if [[ -f "$sid_file" ]]; then
            captured="$(<"$sid_file")"
            captured="${captured//[$'\n\r ']/}" # strip whitespace
            rm -f "$sid_file"
            break
        fi
    done
    # B) Direct launch-token scan of codex session files
    if [[ -z "$captured" && -n "$launch_id" ]]; then
        captured="$(find_codex_session_by_launch_id "$launch_id" "$launch_time")"
    fi
    # C) Direct CWD-based scan of codex session files
    if [[ -z "$captured" && -n "$work_dir" ]]; then
        captured="$(find_codex_session_by_cwd "$work_dir" "$launch_time")"
    fi
    # D) Fallback: scrape TUI output (legacy, least reliable)
    if [[ -z "$captured" ]]; then
        captured="$(tmux capture-pane -t "$pane" -p 2>/dev/null | grep -oP 'session id: \K[0-9a-f-]+' | head -1 || true)"
    fi
    if [[ -n "$captured" ]]; then
        (
            flock -w 5 200 || exit 1
            local escaped_slot="${slot//./\\.}"
            sed -i "s/^agent\.${escaped_slot}=\([^:]*:[^:]*:\).*/agent.${slot}=\1${captured}/" "$meta_dir/meta"
        ) 200>"$meta_dir/meta.lock"
    fi
}

# Find an opencode session ID by matching directory in `opencode session list --format json`.
# Only considers sessions updated after $launch_time (epoch seconds).
# Returns the session ID of the newest matching session, or empty string.
find_opencode_session_by_launch_id() {
    local launch_id="$1" launch_time="${2:-0}"
    if ! command -v opencode &>/dev/null; then
        return
    fi
    [[ "$launch_id" =~ ^[0-9a-fA-F-]+$ ]] || return
    local launch_time_ms=$((launch_time * 1000))
    local query
    query="select s.id
from session s
join message m on m.session_id = s.id
join part p on p.message_id = m.id and p.session_id = s.id
where s.time_updated >= ${launch_time_ms}
  and p.data like '%AE_OPENCODE_LAUNCH_ID=${launch_id}%'
order by s.time_updated desc
limit 1;"
    opencode db "$query" --format tsv 2>/dev/null | awk 'NR > 1 && NF { print $1; exit }'
}

# Find a Gemini session ID by matching an ae-injected launch marker in local chat history.
# Limits search to project temp dirs whose .project_root matches $target_cwd.
find_gemini_session_by_launch_id() {
    local target_cwd="$1" launch_id="$2" launch_time="${3:-0}"
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    [[ -d "$HOME/.gemini/tmp" ]] || return
    local best_id="" best_mtime=0
    local proj_dir root_file root chats_dir f mtime session_id
    for proj_dir in "$HOME/.gemini/tmp"/*; do
        [[ -d "$proj_dir" ]] || continue
        root_file="${proj_dir}/.project_root"
        [[ -f "$root_file" ]] || continue
        root="$(cat "$root_file" 2>/dev/null || true)"
        root="$(realpath "$root" 2>/dev/null || echo "$root")"
        [[ "$root" == "$target_cwd" ]] || continue
        chats_dir="${proj_dir}/chats"
        [[ -d "$chats_dir" ]] || continue
        for f in "$chats_dir"/session-*.json; do
            [[ -f "$f" ]] || continue
            mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
            ((mtime < launch_time)) && continue
            grep -Fq "AE_GEMINI_LAUNCH_ID=${launch_id}" "$f" 2>/dev/null || continue
            session_id="$(grep -oP '"sessionId"\s*:\s*"\K[^"]+' "$f" 2>/dev/null | head -1 || true)"
            [[ -z "$session_id" ]] && continue
            if ((mtime > best_mtime)); then
                best_id="$session_id"
                best_mtime="$mtime"
            fi
        done
    done
    echo "$best_id"
}

