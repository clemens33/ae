cmd_rename() {
    local old_name="" new_name=""
    if [[ $# -ge 2 ]]; then
        old_name="$1"
        new_name="$2"
    elif [[ $# -eq 1 ]]; then
        old_name="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae rename [old-name] <new-name>" >&2
            echo "(Run inside an ae tmux session to rename it without specifying the old name.)" >&2
            return 1
        }
        new_name="$1"
    else
        echo "Usage: ae rename [old-name] <new-name>" >&2
        return 1
    fi
    # The rename TARGET is a creation boundary, so it takes the one grammar —
    # not the old slash/colon/dot blacklist, which accepted 'has space' and
    # persisted a session that launch and resume then refused, and which left the
    # tmux-target and sed-replacement classes open besides.
    _validate_session_name "$new_name" || return 1
    # The SOURCE may be a legacy name that predates the grammar: renaming is
    # exactly the migration path out of one, so it must not be blocked.
    _session_name_usable "$old_name" || return 1
    # Both PATH OBJECTS, independently of either name. A grammar-valid symlink
    # satisfies everything above; `mv` through one relocates whatever it points
    # at, and a dangling symlink at the target is invisible to the `-d` existence
    # check further down.
    _require_session_path_safe "$old_name" || return 1
    _require_session_path_safe "$new_name" || return 1
    # LIFECYCLE SERIALIZATION, BOTH NAMES. Rename has always run outside lifecycle
    # locking — a PRE-EXISTING gap against end and launch, not something #33
    # introduced — and #33 made its cost concrete: pause a freezer before it locks
    # `oldslot`, end oldslot, rename a live identity-less session INTO that name,
    # release, and the freezer mints into the REPLACEMENT, freezes that id, and the
    # supervisor kills it reporting "verified gone". Every check below reads state
    # the rename then mutates, so they belong inside the lock, not in front of it.
    #
    # TWO locks, taken in NAME-SORTED order — the standard deadlock avoidance: two
    # concurrent renames touching the same pair acquire them in the same sequence, so
    # one waits instead of both holding half. Consistent with the one global order
    # (lifecycle outside, meta.lock inside); nothing here takes meta.lock first.
    local _rn_first _rn_second
    if [[ "$old_name" < "$new_name" ]]; then
        _rn_first="$old_name"
        _rn_second="$new_name"
    else
        _rn_first="$new_name"
        _rn_second="$old_name"
    fi
    mkdir -p "$SESSIONS_DIR"
    {
        if command -v flock >/dev/null 2>&1; then
            if ! flock -w 15 9 || ! flock -w 15 10; then
                echo "Error: another lifecycle operation (start/resume/stop/end) is in progress for '${old_name}' or '${new_name}' — retry shortly. Nothing was renamed." >&2
                return 1
            fi
        else
            echo "note: flock not found — lifecycle locking degraded (start/stop races unguarded)" >&2
        fi
        _cmd_rename_locked "$old_name" "$new_name"
    } 9>"${SESSIONS_DIR}/.lifecycle.${_rn_first}.lock" 10>"${SESSIONS_DIR}/.lifecycle.${_rn_second}.lock"
}

# Everything that READS state the rename then mutates, plus the mutation itself.
# Split out so the locked region is a single call rather than a long braced block —
# the same shape _stop_one_session/_stop_session_locked use, and for the same reason.
_cmd_rename_locked() {
    local old_name="$1" new_name="$2"
    # Check old session exists
    if ! tmux has-session -t "$old_name" 2>/dev/null; then
        echo "Error: session '${old_name}' is not running." >&2
        return 1
    fi
    # Check new name is not already taken
    if tmux has-session -t "$new_name" 2>/dev/null; then
        echo "Error: session '${new_name}' already exists." >&2
        return 1
    fi
    if [[ -d "${SESSIONS_DIR}/${new_name}" ]]; then
        echo "Error: session directory '${SESSIONS_DIR}/${new_name}' already exists." >&2
        return 1
    fi

    local old_meta="${SESSIONS_DIR}/${old_name}"
    local new_meta="${SESSIONS_DIR}/${new_name}"

    # 1. Rename tmux session
    tmux rename-session -t "$old_name" "$new_name"

    # 1b. Rename the main window to match — but NOT under lead-pair, where window 0
    # carries the ROLE name 'leads' (the session name lives in status-left) and must
    # survive a rename. Decide by the LAYOUT FACT from meta, never by comparing the
    # window name to the session name — a session literally named 'lead' would fool
    # a name check (codex session-shape finding). Meta hasn't moved yet at this step.
    local _ren_layout
    _ren_layout="$(grep '^layout=' "${old_meta}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    if [[ "$_ren_layout" != "lead-pair" ]]; then
        tmux rename-window -t "${new_name}:0" "$(_ae_tmux_format_literal "$new_name")" 2>/dev/null || true
    fi

    # 2. Move session directory
    if [[ -d "$old_meta" ]]; then
        mv "$old_meta" "$new_meta"
    fi

    # 3. Update session= in meta file
    if [[ -f "${new_meta}/meta" ]]; then
        _ae_sed_inplace "s/^session=.*/session=${new_name}/" "${new_meta}/meta"
    fi

    # 4. Regenerate workspace.md (contains session name)
    if [[ -f "${new_meta}/meta" ]]; then
        local work_dir origin mode main_pane
        work_dir="$(grep '^work_dir=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        origin="$(grep '^origin=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        mode="$(grep '^mode=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        main_pane="$(grep '^main_pane=' "${new_meta}/meta" 2>/dev/null | cut -d= -f2- || true)"
        regenerate_manifest "$new_name" "${work_dir:-.}" "${origin:-.}" "${mode:-local}" "${main_pane:-%0}" "$new_meta"
        # 4b. Refresh status-left — it carries the SESSION NAME now, which just changed.
        _ae_apply_status_bar "$new_name" "${mode:-local}" "${origin:-.}" "${work_dir:-.}"
    fi

    echo "Renamed '${old_name}' → '${new_name}'"
}

