#!/usr/bin/env bash
# ae - agentic engineering: tmux-based multi-agent workspace
set -euo pipefail
AE_VERSION="2026.8.2"

# Fail fast with a clear message on bash < 4 (macOS ships 3.2 and defaults to
# zsh). This must sit BEFORE any bash-4-only syntax is parsed — bash parses
# function bodies at definition time, so a later guard never runs; 3.2 would
# die with a cryptic parse error instead.
if ((BASH_VERSINFO[0] < 4)); then
    # Re-exec under a modern bash before giving up. macOS ships 3.2 as /bin/bash,
    # and a LOGIN shell's path_helper rebuilds PATH with /bin ahead of Homebrew —
    # so `env bash` picks 3.2 even on a machine with 5.x installed. That is the
    # normal state inside a macOS tmux pane, where it made ae refuse to start.
    # Everything here must parse under 3.2: no bash-4 syntax above this point.
    # Loop safety is a bounded ATTEMPT COUNT, not a boolean. We only ever exec a
    # bash we have already PROVEN is >= 4, so the marker can only be set
    # legitimately on a >= 4 shell — its presence HERE, on a < 4 shell, is always
    # stale (inherited by a descendant that re-invoked ae through ae's own
    # PATH-resolved shebang). A boolean made that descendant refuse instead of
    # re-execing, and the orchestrator autostart child discards stderr, so it died in
    # silence. Counting recovers from a poisoned marker while still capping
    # recursion. Must parse under 3.2: no arithmetic-if, no [[ ]].
    _ae_tries="${AE_BASH_REEXEC:-0}"
    case "$_ae_tries" in '' | *[!0-9]*) _ae_tries=0 ;; esac
    if [ "$_ae_tries" -lt 2 ]; then
        for _ae_bash in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash; do
            # shellcheck disable=SC2016 # single quotes are the point: the
            # expression must be evaluated by the CANDIDATE bash, not this one.
            if [ -x "$_ae_bash" ] &&
                "$_ae_bash" -c 'exit $((BASH_VERSINFO[0] < 4))' 2>/dev/null; then
                AE_BASH_REEXEC=$((_ae_tries + 1)) exec "$_ae_bash" "$0" "$@"
            fi
        done
    fi
    echo "Error: ae requires bash >= 4.0 (found ${BASH_VERSION})." >&2
    echo "macOS: brew install bash, and make sure brew's bin dir precedes /bin on PATH (eval \"\$(brew shellenv)\")." >&2
    exit 1
fi
# The marker's job ended the moment we got here: this shell IS >= 4. Leaving it
# EXPORTED poisons every descendant that re-invokes ae through ae's own
# PATH-resolved shebang — on a hostile PATH the child lands on 3.2, sees the
# marker, skips the re-exec that would have saved it, and refuses. The orchestrator
# autostart child is spawned with stderr to /dev/null, so it died in SILENCE.
# Loop safety does not need the marker to persist: the candidate loop only execs
# a bash it has already proven is >= 4, so a re-exec can never recurse.
unset AE_BASH_REEXEC _ae_tries

# AE_HOME relocates ALL ae state (config, sessions, worktrees) without swapping
# $HOME — so an isolated run (tests, e2e) can keep the real $HOME (and real
# agent-CLI auth under ~/.claude, ~/.codex) while writing ae state elsewhere.
# Unset → the normal ~/.ae. CONFIG_DIR derives from it; everything below derives
# from CONFIG_DIR, so this single knob is authoritative for the whole tool.
AE_HOME="${AE_HOME:-${HOME}/.ae}"
CONFIG_DIR="$AE_HOME"
# CONFIG_FILE honors a pre-set env var so tests + the generated daemon
# can point at a non-default config without rewriting the user's real one.
CONFIG_FILE="${CONFIG_FILE:-${CONFIG_DIR}/config}"
# WORKTREES_DIR is gone with the last body that read it (glue cut, pass 4). The
# worktree root is <AE_HOME>/worktrees and it is the CORE's to derive — it does so
# from the --home it is handed (src/inventory.rs, Roots::worktrees). A second
# spelling here would be a second definition of the same path, and the glue has no
# caller for it: nothing in this file creates, lists or removes a worktree.
SESSIONS_DIR="${CONFIG_DIR}/sessions"

# Per-project config override (optional)
AE_LOCAL_CONFIG=""
[[ -f ".ae/config" ]] && AE_LOCAL_CONFIG="$(pwd)/.ae/config"

# Optional: isolated tmux server (for testing or multi-instance use)
# Install the ambient tmux() shim from AE_TMUX_SERVER(+_KIND). A FUNCTION so the
# selection is unit-testable behaviorally, and KIND-FIRST so an ambiguous record
# refuses even when the VALUE is blank — the old nesting under a non-empty value let
# blank+ambiguous skip the shim entirely and inherited $TMUX won (10th review B3:
# a retire killed a pane cross-server through exactly that gap).
_ae_install_tmux_shim() {
    if [[ "${AE_TMUX_SERVER_KIND:-}" == "ambiguous" ]]; then
        tmux() {
            echo "ae: refusing tmux operation — this session's server record is ambiguous; run 'ae doctor --refresh' first." >&2
            return 1
        }
        return 0
    fi
    [[ -n "${AE_TMUX_SERVER:-}" ]] || return 0
    if [[ "${AE_TMUX_SERVER_KIND:-}" == "socket" ]]; then
        tmux() { command tmux -S "$AE_TMUX_SERVER" "$@"; }
    elif [[ "${AE_TMUX_SERVER_KIND:-}" == "name" ]]; then
        tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }
    elif [[ "$AE_TMUX_SERVER" == /* ]]; then
        tmux() { command tmux -S "$AE_TMUX_SERVER" "$@"; }
    else
        tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }
    fi
    return 0
}
_ae_install_tmux_shim

# --- Portability shims (GNU coreutils vs BSD/macOS userland) -------------
# ae runs on Linux (GNU) and macOS (BSD). Four utilities differ, and each one
# fails SILENTLY through the `|| default` idiom the call sites use: a missing
# `tac` yields nothing (newest-first scans read empty), `stat -c` yields the
# fallback (every mtime reads 0), `date -d` yields 0, `sed -i EXPR FILE` eats
# EXPR as a backup suffix. All four shipped as macOS bugs. Never call the raw
# tool — route through these.
#
# Each shim tries the GNU form FIRST and falls back to BSD, so no platform
# detection is needed and a macOS box with brew coreutils on PATH keeps taking
# the GNU path. These are shared bodies: ae calls them directly AND they are
# emitted into the generated helpers via the _lib declare -f list.

# Are we ACTUALLY inside a tmux pane — not merely carrying $TMUX? (#29)
#
# $TMUX and $TMUX_PANE are ordinary environment variables. A GUI terminal
# launched from inside a pane inherits them and hands them to every tab shell it
# opens (observed live 2026-08-05: cmux launched from pane %44), so the bare
# `[[ -n "${TMUX:-}" ]]` test fires in shells no tmux client owns. ae then takes
# the inside-tmux branch: `ae <name>` runs switch-client, which moves the
# ORIGINAL pane's view somewhere else and never attaches the terminal the human
# is looking at, and `ae end` with no name resolves to the ORIGINAL pane's
# session. An everyday action turns into a silent dead end.
#
# TRUTH TEST: our controlling terminal must be the tty of a PANE on that server.
# Not `list-clients` — a client's tty is the terminal EMULATOR's (/dev/ttys002),
# never the pane pty a shell sits on (/dev/ttys055), so matching against it
# would call every genuine in-pane shell stale. Genuine nesting still passes:
# $TMUX names the INNER server, whose pane list contains our tty.
#
# POSITIVE EVIDENCE ONLY. When the question is unanswerable — no controlling tty
# (an agent's non-interactive children have none), tmux unreachable, an empty
# pane list — we answer TRUE and keep the historical behaviour. This guard is
# here to catch a PROVEN mismatch, not to re-litigate every ambiguous case.
#
# Asked through ae's tmux shim on purpose (never `command tmux -S ${TMUX%%,*}`):
# when AE_TMUX_SERVER pins a server, that is the server switch-client would
# target, so "are we a client of THAT one" is the question the callers actually
# need answered. A shell sitting in a pane of some other server is correctly
# told "not inside" — switch-client would have no client to switch there.
#
# Cached per process: the answer cannot change mid-run, and the warning must be
# said once, not once per branch that asks.
_ae_inside_tmux() {
    [[ -n "${TMUX:-}" ]] || return 1
    case "${_AE_INSIDE_TMUX:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    local _tty="" _panes="" _p
    _tty="$(ps -o tty= -p $$ 2>/dev/null | tr -d '[:space:]')" || _tty=""
    _panes="$(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null)" || _panes=""
    # No controlling tty ("?"/"??"/"-" depending on ps flavour) or no answer
    # from tmux: unanswerable, so trust $TMUX as ae always has.
    if [[ -z "$_tty" || "$_tty" == '?' || "$_tty" == '??' || "$_tty" == '-' || -z "$_panes" ]]; then
        _AE_INSIDE_TMUX=1
        return 0
    fi
    # /dev/ stripped from BOTH sides: procps prints "pts/3" and BSD ps "ttys039"
    # against tmux's "/dev/pts/3" / "/dev/ttys039", but a ps that spelled the
    # full path would otherwise make every genuine pane look stale.
    _tty="${_tty#/dev/}"
    while IFS= read -r _p; do
        if [[ "${_p#/dev/}" == "$_tty" ]]; then
            _AE_INSIDE_TMUX=1
            return 0
        fi
    done <<<"$_panes"
    _AE_INSIDE_TMUX=0
    echo "ae: stale \$TMUX inherited (this shell is not a tmux pane) — attaching normally." >&2
    return 1
}

# --- Function index --- (21 functions; every one has a live caller)
#   Portability:  _ae_inside_tmux, _ae_install_tmux_shim
#   Names/paths:  _validate_session_name, _session_name_usable, _path_is_direct_child,
#                 _session_path_is_safe, _require_session_path_safe
#   Session read: detect_current_session, _autostart_session_hint
#   Core binding: _ae_core_current_input, _ae_core_bin_input, _ae_core_bin_version,
#                 _ae_core_try (session-pinned), _ae_core_preflight_try (operator)
#   Commands:     cmd_list, cmd_next, cmd_archive_preview, cmd_help,
#                 _cmd_spawn, _cmd_retire
#   Launch glue:  resolve_launch_tmux_server (the typed server pair)
#
# NOT HERE, AND THAT IS THE POINT — the absences this file is now pinned on.
# Each was a real body that a later reader could plausibly reintroduce, so the
# suite asserts it is gone rather than trusting this comment:
#   * NO POST-SPAWN CAPTURE FORK. `_cmd_spawn` is a bare exec. The core's spawn
#     forks `_capture-sid` for the seat it just created, from the launch_id and
#     launch_time it wrote itself — a second reader here would re-derive the slot
#     and the pane out of meta and disagree the first time two spawns raced.
#     Gone with it: capture_session_id and the codex/opencode/gemini capture and
#     find_*_session_by_* bodies (the doctor recovery path keeps its own until
#     that command moves).
#   * NO SESSION-HELPER LOGIC. The core writes every shim; there is no
#     declare -f template library and no `_lib`.
#   * NO CORE RESOLUTION FROM CONFIG. Two sources only, AE_CORE_BIN then
#     core/current — see _ae_core_bin_input.
#   * NO SECOND READER OF SESSION STATE. `ae status` is gone (pass 3): it read
#     meta, tmux and the event log itself, beside the core's own readers, to print
#     what `ae list` already prints from one implementation. The word still has an
#     arm, and the arm REFUSES — deleting it outright would let the launch take
#     `status` as a session name.
#   * NO ORCHESTRATOR TRAMPOLINE. `ae orchestrator` scaffolded a config, rewrote
#     CONFIG_FILE / AE_LOCAL_CONFIG / $PWD and fell through to the launch (pass 3).
#     The core reads the config pair it is handed and starts the companions itself.
#     Gone with it: the whole legacy `hub` scaffold, and the two meta writers
#     (_set_meta_kv, _set_meta_watchdog) that had already lost their last caller.
#   * NO PENDING-SESSION-ID RECOVERY, and no per-tool history reader of any kind
#     (pass 4). The core recovers in-process on every watchdog cycle
#     (src/watchdog_glue.rs `recover`, driven from `tick_pane_duties`), so the
#     `_recover-pending` arm has no caller: the daemon used to shell back into
#     this script through meta's `ae_path` and parse a TSV. Gone with it: the four
#     find_*_session_by_* scanners, the launch-id/launch-time readers they keyed
#     on, doctor's capture retry, and the tool-command sensor
#     (tool_kind_from_cmd / _cmd_binary_kind / _cmd_split_binary) that classified
#     which scanner to run. `_recover-pending` needs no refusing arm of its own:
#     `_*)` already fails closed on any internal word nobody serves.
#   * NO INI PARSER. `parse_config` and `get_config` went with their last callers
#     in the same pass. The glue still WRITES a default config on first run — that
#     is a template, not a read — and hands the file path to the core as
#     `--global`; parsing it is the core's (src/config.rs). This is the line
#     AGENTS.md draws for the surviving glue: it resolves paths and facts the core
#     cannot see for itself, and reads none of ae's own state.
#   * NO PORTABILITY SHIMS. `_ae_stat`, `_ae_json_first` and `_ae_yesterday` are
#     gone — the GNU-vs-BSD divergences they covered (stat -c, grep -oP, date -d)
#     were reached only by the readers above. `_ae_inside_tmux` stays: it is a
#     tmux/ps question, not a userland one, and the launch still needs its answer.

DEFAULT_CONFIG='# ae config — auto-created on first run, yours to edit. Also mirrored in the repo as
# config.sample. INI-style: [section] headers, key = value, "#" starts a comment.
# New sessions read this whole file. Stopping + resuming an existing session (ae stop <name>;
# ae <name>) relaunches its preserved agents with their CURRENT command + [prompt] — but the
# roster (main/workers), layout, and watchdog stay pinned in session meta, so edits to those
# take effect for NEW sessions only. (ae doctor --refresh regenerates the on-disk session
# helpers + workspace.md after you upgrade ae; it changes neither running agents nor config.)

[profiles]
# Register any CLI tool as a PROFILE: profile = "the shell command that launches it". A
# profile is a reusable launch recipe, not an identity: an agent IS its NAME, bound to a
# profile in [roster] below. The command must be ONE simple command (env assignments plus
# one argv; no ; | & # redirections or $(…) outside quotes) — ae refuses anything else.
# Model-named aliases: the prefix names the model + major, so the running model is legible at
# a glance. STRICT pins (never --model best) — a model-named alias must not silently run a
# different model; that would make the name lie and blind the model-drift alarm. Exact IDs
# beat family aliases where they would drift: --model opus moved to Opus 5 the day it shipped.
# opus5 = everyday builder tier (xhigh is a deliberate opt-up; Opus 5 defaults to high).
opus5 = "claude --permission-mode bypassPermissions --model claude-opus-5 --effort xhigh"
# fable5 = frontier lead tier (default lead seat; pairs with a cross-model colead as its equal peer).
fable5 = "claude --permission-mode bypassPermissions --model fable --effort xhigh"
sonnet5 = "claude --permission-mode bypassPermissions --model sonnet --effort low"
gpt56sol = "codex --yolo -m gpt-5.6-sol -c model_reasoning_effort=xhigh"
gpt56terra = "codex --yolo -m gpt-5.6-terra -c model_reasoning_effort=xhigh"
gpt56luna = "codex -m gpt-5.6-luna -c model_reasoning_effort=low -a never"
opencode = "opencode"

[roster]
# The agents promised to launch: name = profile. The NAME is the identity of the agent — it is
# addressed as <name> in the session and <session>:<name> across sessions; the profile is
# metadata (`ae list` shows it). Every seat in main/workers below must be bound here — ae
# refuses the launch otherwise and lists every violation. A name bound here but not seated
# is legal: `ae <session> use <name>` starts it as main instead. Spawn on demand with:
# spawn <name> --using <profile> [prompt].
lead = fable5
colead = gpt56sol

[workspace]
# main = the standing main seat (a [roster] NAME) — under lead-pair a technical lifecycle
# anchor, not a rank. workers = comma-separated [roster] names launched at start.
# layout = vertical | horizontal | lead-pair. watchdog = true nudges stale/idle agents.
# The leads delegate by rule (see docs/reference/delegation.md — spawn workers on demand).
# Standing seats are the JUDGMENT PAIR only: under lead-pair the FIRST worker (worker.0)
# is the COLEAD seat — an EQUAL leadership peer of the lead (interchangeable, same level,
# sharing the leads window 0:leads); main stays the technical lifecycle anchor (compact
# handover), which is infrastructure, not seniority. Builders and reviewers are NOT
# standing seats: either peer spawns them per slice (spawn builder --using opus5 / spawn
# reviewer --using gpt56sol) and retires its own spawns when the work is verified — every spawn
# ends in a retire. This keeps idle panes at zero, makes the retire contract do real
# work, and still keeps judgment (the pair) separate from review (a spawned seat) on
# every slice.
main = lead
workers = colead
layout = lead-pair
watchdog = true

[prompt]
# ae already injects the full workspace protocol into every agent — the roster, the helper
# commands (send/ask/spawn/…), the delegation and comms rules — see the generated
# ~/.ae/sessions/<name>/workspace.md. Anything set here is APPENDED on top of that; per-project
# .ae/config overrides the global one. Uncomment to add your own house rules:
# instructions = "Always write tests. Prefer TypeScript."'

# Create default config if missing
if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$DEFAULT_CONFIG" >"$CONFIG_FILE"
    # STDERR: this runs before the dispatcher, on EVERY invocation, so on a config-less
    # home it would otherwise prepend a line to the stdout of commands whose stdout is a
    # contract — `ae archive preview` promises the digest bytes and nothing else.
    echo "Created default config at $CONFIG_FILE" >&2
fi

# ── The core's helper set, rewritten from bash ────────────────────────────
# The ONE asset `ae doctor --refresh` still needs that the core has no entry for.
#
# Since the B move a session helper carries NO LOGIC: it is `exec <core> <entry>
# "$META_DIR" "$@"`, and src/session_launch/assets.rs writes exactly these bytes
# at launch and resume. Refresh must produce the SAME bytes, so what follows is a
# deliberate second copy of a five-line contract — not a second implementation of
# a helper, and nothing like the 422-line generator and `_lib` library it
# replaces. The copy is not trusted to stay honest by reading: the integration
# suite refreshes a launched session and compares every helper BYTE FOR BYTE
# against what the core wrote. Delete all of this the day the core grows an entry
# that rewrites a session's assets.
#
# `<file>:<core entry>` — the same table as assets.rs PASSTHROUGH, plus the two
# monitor panes' processes (each is a pane's whole command, so it must be an
# executable file). `peak` and `loop` are aliases and are written below.
_AE_SHIM_PASSTHROUGH=(
    send:_send ask:_ask review:_review reply:_reply requests:_requests
    state:_state say:_say memo:_memo goal:_goal peek:_peek agents:_agents
    focus:_focus interrupt:_interrupt spawn:_spawn retire:_retire
    watchdog:_watchdog-run events-tail:_events-tail
)
# Detect current ae session when running inside tmux (for ae end/status without name)
# _ae_inside_tmux, not a bare $TMUX test (#29): from a GUI terminal that inherited
# $TMUX, display-message answers for the ORIGINAL pane — so `ae end` with no name
# would target someone else's session.
detect_current_session() {
    if _ae_inside_tmux; then
        local session_name
        session_name="$(tmux display-message -p '#{session_name}' 2>/dev/null)" || return 1
        if [[ -d "${SESSIONS_DIR}/${session_name}" ]]; then
            echo "$session_name"
            return 0
        fi
    fi
    return 1
}

# Is CANDIDATE a DIRECT CHILD of PARENT, by pure string structure? Used as the
# belt to entry validation's braces before anything is deleted. String-structural
# rather than realpath-based on purpose: `readlink -f` is GNU-only, and this test
# is strictly stronger for the job — it rejects `parent/a/b` as well as
# `parent/../x`, which a resolved-path prefix check would happily accept.
_path_is_direct_child() {
    local parent="$1" cand="$2"
    [[ -n "$parent" && -n "$cand" ]] || return 1
    [[ "$cand" == */* ]] || return 1
    [[ "${cand%/*}" == "$parent" ]] || return 1
    local base="${cand##*/}"
    [[ -n "$base" && "$base" != "." && "$base" != ".." ]] || return 1
    return 0
}

# ALLOWLIST, deliberately not a blacklist. A session name becomes ALL of: a tmux
# session name, a DIRECTORY under ${SESSIONS_DIR}, the middle of the lifecycle
# lock filename (.lifecycle.<name>.lock), a `#{@ae_*}` neighbour in tmux format
# strings, and — since the launch rollback landed — the target of an rm -rf. A
# blacklist has to anticipate every one of those consumers, and each review round
# found one it had missed: path traversal first, then '.dotproject' (tmux CREATES
# it, ae then cannot target it — an orphan session and a stranded lock file, with
# the failure landing before the rollback exists), then backslashes, leading
# sigils, a trailing ';', tmux-format-shaped names, ASCII controls, and
# '.lifecycle.foo.lock' aliasing ae's own lock namespace.
#
# THE GRAMMAR — stated once, here, and echoed verbatim in the error:
#
#     ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$
#
# Alphanumeric start; alphanumeric, underscore or dash body; 128 characters max.
# The consequences follow by construction instead of by enumeration: a leading
# '.' cannot occur, so both the lifecycle-lock namespace and tmux's untargetable
# dot-names are unreachable; no shell metacharacter, glob, tmux format, quote or
# control byte survives; spaces are simply out.
#
# The LENGTH is the one number measured rather than picked. Every session name on
# this machine passes (longest 25, including the numeric '38' and 'AIASSIST-133'
# shapes), and the longest name default_session_name produces across 177 real
# project directories is 62 — one character inside a 63 cap. 128 keeps real
# headroom for deeper trees and stays far under the 255-byte filesystem limit.
#
# Validated ONCE, at launch entry, BEFORE the first tmux or filesystem side
# effect, so every artifact later derived from the name is well-formed by
# construction. Same class as resolve_session_ref's guard for chat-supplied refs
# — this is the argv-supplied one, which had none at all.
_validate_session_name() {
    local name="$1"
    if [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]]; then
        return 0
    fi
    echo "Error: invalid session name '${name}'." >&2
    echo "       Names must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}\$ — start with a letter or digit," >&2
    echo "       then letters, digits, '_' or '-', up to 128 characters." >&2
    return 1
}

# The MIGRATION shape, for boundaries that consume an EXISTING session rather
# than create one (a transfer source, a rename source). Sessions created before
# the grammar existed must stay usable — being unable to rename or move a legacy
# session away is a worse outcome than the name itself. Accepts:
#   - anything the grammar accepts, or
#   - a legacy name that IS ALREADY a real direct-child session directory.
# Traversal is never accepted by either arm: the second arm requires the built
# path to be a true direct child AND to exist, so '../victim' and 'a/b' are out
# even if someone creates those directories. Creation boundaries (a new name, a
# rename TARGET) use the strict grammar — legacy names get a migration path, not
# a permanent home.
#
# The existence arm requires a PHYSICAL directory — `-d` alone accepts a
# direct-child SYMLINK, and a symlink is an escape wearing a compliant name:
# `rsync -a --delete src/ sessions/legacy.name/` follows it and deletes whatever
# it points at. `! -L` is the whole difference between a migration path and a
# traversal with extra steps.
#
# Used ONLY where an existing session is CONSUMED IN PLACE — today that is the
# rename SOURCE, and only that. Not transfer: transfer creates a directory of the
# same name on the DESTINATION (either side, depending on direction), so it is a
# creation boundary in both directions, and a same-name copy cannot migrate a
# name into compliance — it propagates it. Legacy sessions rename at the source
# first, then transfer.
_session_name_usable() {
    local name="$1"
    _validate_session_name "$name" 2>/dev/null && return 0
    if _path_is_direct_child "$SESSIONS_DIR" "${SESSIONS_DIR}/${name}" &&
        [[ -d "${SESSIONS_DIR}/${name}" && ! -L "${SESSIONS_DIR}/${name}" ]]; then
        return 0
    fi
    _validate_session_name "$name"
    return 1
}

# Is the ON-DISK OBJECT at ${SESSIONS_DIR}/<name> safe to treat as that session's
# directory? A PATH question, answered INDEPENDENTLY of the name grammar — and
# that independence is the entire point. Folding it into _session_name_usable did
# not work, because that function RETURNS on a grammar accept: every
# grammar-VALID symlink skipped the check completely, so a symlink named
# 'valid-name' passed every boundary and `rsync -a --delete` onto it followed the
# link out of the sessions root and deleted what it pointed at.
#   0 — safe: absent (nothing to escape through yet), or a real physical
#       directory that is a direct child of the sessions root
#   1 — unsafe: a symlink of ANY kind (including dangling, which `-e` misses), a
#       non-directory, or a path that is not a direct child
_session_path_is_safe() {
    # SEPARATE statements: `local name="$1" p="${SESSIONS_DIR}/${name}"` expands
    # every word before assigning any of them, so p would be built from the OLD
    # name — unset here, which under `set -u` aborts ae outright. Same shape as
    # the export HOME/AE_HOME footgun in AGENTS.md.
    local name="$1"
    local p="${SESSIONS_DIR}/${name}"
    _path_is_direct_child "$SESSIONS_DIR" "$p" || return 1
    # -L before -e: a DANGLING symlink is not -e, so an -e-first test would call
    # it ABSENT and wave it through. What a given rsync then does varies by
    # implementation (the openrsync shipped here returns rc 11 rather than
    # creating through the link) — which is precisely why the classification does
    # not rest on that behaviour. A symlink of any kind is unsafe regardless.
    [[ -L "$p" ]] && return 1
    [[ -e "$p" ]] || return 0
    [[ -d "$p" ]] || return 1
    return 0
}

# Same question, phrased for a caller that wants to say why.
_require_session_path_safe() {
    local name="$1"
    _session_path_is_safe "$name" && return 0
    echo "Error: ${SESSIONS_DIR}/${name} is not a plain directory (symlink, file, or outside the sessions root)." >&2
    echo "       Refusing to use it — a symlinked session directory is an escape wearing a valid name." >&2
    return 1
}

# Identity v2 (P34): the roster is the CORE's answer — the glue parses no identity.
# RESUME (the session meta exists — authoritative INCLUDING EMPTINESS, so a zero-worker
# session never regains config workers): a v1 meta is migrated in place first
# (`_roster migrate` refuses loudly when a legacy alias has no [profiles] entry, as the
# bash resume did), then `_roster list` yields every seat with its profile's CURRENT
# command. FRESH: `_launch-plan` validates [profiles]/[roster]/[workspace] both ways and
# yields the seats — every violation at once, before any tmux or filesystem side effect.
# Variables keep their frozen names: *_ALIASES now hold PROFILES.
_ROSTER_RECORDS=""
# Identity v2: ae derives no agent names. Duplicate seat names are REFUSED by the core
# (`_launch-plan` NameTwice) rather than renamed, and the grammar is enforced there
# for every FRESH name — the bash `_dedup_worker_names` went with the alias era.

# The core path an INSTALL publishes: <AE_HOME>/core/current, one line holding an
# absolute path. General, not tied to one installer — every install publishes
# through the same pointer — and deliberately a FILE rather than an exported
# variable.
#
# WHY A FILE. Every re-entry into ae resolves the core again: a generated helper
# execs its recorded ae path, the watchdog re-invokes `telegram _supervise`,
# compact launches its child, `doctor --refresh` regenerates. An exported
# AE_CORE_BIN is a COPY of the pointer, frozen into a tmux server's environment
# at launch and stale from the first upgrade onwards; a file is read fresh every
# time, so one install is visible to everything at once.
#
# PRECEDENCE: bundle sibling ae-core (basename of $0 is exactly ae-glue AND
# that sibling is executable) > env AE_CORE_BIN > core/current. Installed
# ae-glue is INTERNAL — generated helpers exec it
# directly with no B8 sanitization — so a pane-carried AE_CORE_BIN must not
# override the immutable sibling. Env is ignored silently when the sibling
# fires. Checkout `ae` and every non-bundle / missing-sibling invocation skip
# it and keep env > current > config.
#
# FAIL-QUIET, like an unusable config value: a missing file, an empty line, or a
# relative/`~` path prints nothing and lets the caller fall through to the config.
# A `~` value is refused rather than expanded because _ae_core_bin_input does not
# expand one either — pinning a path that cannot be executed is worse than
# pinning none.
_ae_core_current_input() {
    local file line
    [[ -n "${CONFIG_DIR:-}" ]] || return 0
    file="$CONFIG_DIR/core/current"
    # A SYMLINK IS NOT A POINTER WE PUBLISHED, and lstat says so before anything
    # reads through it. The wrapper refuses one too, but the wrapper is not on
    # this path: a generated helper exec'ing its recorded ae, the watchdog's
    # `telegram _supervise`, compact's child launch and a bare `ae` run with
    # AE_HOME set all reach THIS reader directly. Fail-quiet like every other
    # unusable value here — fall through to the config rather than resolve a core
    # from a path nobody published.
    if [[ -L "$file" ]]; then
        return 0
    fi
    [[ -f "$file" ]] || return 0
    line="$(head -1 "$file" 2>/dev/null || true)"
    # Trim, pure bash, same idiom as parse_config.
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ "$line" == /* ]] || return 0
    printf '%s\n' "$line"
    return 0
}

# Resolve the operator's Rust core binding, or nothing.
#
# OPERATOR-OWNED INPUTS ONLY, in precedence order: the bundle sibling ae-core
# (when $0's basename is exactly ae-glue AND that sibling is executable — env
# is then ignored, silently), then the AE_CORE_BIN environment variable, then
# <AE_HOME>/core/current (what an install published — see the reader above).
# Deliberately NOT the config, NOT the PATH and NOT a build-layout guess such as
# `target/release/ae`. The config key `workspace.core` was retired at the final
# cut: it was the only source that could not be read without an INI parser, and
# keeping 47 lines of parser in the glue to answer one key was the wrong trade. PATH is wrong because a helper
# runs in the AGENT's inherited environment rather than the operator's shell, so
# it can resolve differently, or to a different VERSION than the one that
# created the session; a build layout is wrong because it is a developer artifact
# that does not exist on a clean install. Resolved ONCE, at creation or refresh,
# and recorded — never re-resolved at helper-run time.
#
# An empty result means NO CORE: every core-owned command then refuses (the core
# is required), so an empty binding is a broken install, not a supported mode.
_ae_core_bin_input() {
    local candidate dir sibling
    if [[ "$(basename "$0")" == "ae-glue" ]]; then
        dir="$(cd -P "$(dirname "$0")" && pwd -P)" || dir=""
        sibling="${dir:+$dir/ae-core}"
        if [[ -n "$sibling" && -x "$sibling" ]]; then
            printf '%s\n' "$sibling"
            return 0
        fi
    fi
    candidate="${AE_CORE_BIN:-}"
    if [[ -z "$candidate" ]]; then
        candidate="$(_ae_core_current_input)"
    fi
    # `workspace.core` IS NO LONGER A RESOLUTION SOURCE (ruled at the final cut).
    # It cost the glue the whole INI parser to read ONE key, and it was the only
    # source that could not be answered without one. Two sources remain and
    # neither needs a parser: the operator's `AE_CORE_BIN` (which is how the
    # ae-dev namespace points at a checkout build) and the immutable
    # `<AE_HOME>/core/current` an install publishes. An operator who had the
    # config key set gets the same refusal as one who set nothing — named, exit
    # 2, before any side effect — rather than a silently different core.
    [[ -n "$candidate" ]] || return 1
    printf '%s\n' "$candidate"
    return 0
}

# The version a core binary reports, normalised to the bare version string.
# `ae --version` prints `ae <version>`, so the value is the last field.
_ae_core_bin_version() {
    local line
    line="$("$1" --version 2>/dev/null | head -1)" || return 1
    [[ -n "$line" ]] || return 1
    printf '%s\n' "${line##* }"
    return 0
}
# --- Subcommands ---
# `ae next` — attention navigator (Layer 2). Names the top-ranked RUNNING session
# needing attention, with the same semantics as `ae list`'s attn marker because
# since A.2c it is the same code: both are the core's. Read-only by default
# (prints); `--attach` jumps to it (switch-client inside tmux / attach-session
# outside). Exits non-zero when nothing needs attention so it composes in scripts
# and Layer 3. Tie-break across equally-severe sessions: activity, then name asc.
cmd_next() {
    # A.2c: `next`/`jump` is the CORE's, whole — the ranking, the read-only print,
    # the `--attach` jump and its own `--help` and usage error all live there, so
    # the glue keeps no second ranker to drift against `ae list`'s attention. A
    # thin exec with the argv verbatim, like `list`.
    #
    # `next` is the word the core is given for BOTH spellings: it treats `jump` as
    # the alias it always was, and every message it prints already says "ae next".
    # Nothing here parses the tail — an unknown argument is the core's usage error.
    _ae_core_preflight_try --exec next "$@"
}
# shellcheck disable=SC2059 # format strings stored in variables intentionally
cmd_list() {
    # A.2a: `list` is the CORE's, whole. It computes liveness, branch and the
    # attention rollup itself, so the glue keeps no second implementation to drift
    # against — this is a thin exec with the argv verbatim, which is exactly what
    # the public wrapper (`ae-entry`) does for the same word. Both entries then
    # answer identically; a divergence would otherwise depend on which `ae` the
    # caller happened to run.
    #
    # `-h`/`--help` is the ONE exception, and it is the wrapper's contract, not a
    # convenience: ae-entry scans the tail for exactly those two tokens and routes
    # them BACK here, because the core parses help only at top level and would
    # answer a list tail with UnknownFlag rc 2. The text below is the ratified one.
    # This block retires the day the core grows a ratified list-help.
    local _lh
    for _lh in "$@"; do
        case "$_lh" in
            -h | --help)
                cat >&2 <<'LISTHELP'
Usage: ae list [--running | --all | --stopped | --needs-attn | --active] [--json]
  (default)    running sessions only
  --running    running sessions only (explicit)
  --all        running sessions, then stopped ones
  --stopped    stopped sessions only
  --needs-attn only running sessions with an attn reason — declared
               waiting-user/blocked, watchdog-derived dead/stale/throttled, or an
               unanswered inter-agent ask/review (older than 30m); implies
               running-only
               (aliases: --needs-me, --needs, --attn)
  --active     only running sessions with recent activity (an ae event in the
               last 5 min). Implies running-only (alias: --busy)
  --json       machine-readable digest (schema_version, per-session
               needs_attention + attention reason, per-agent state); honours
               the filters above.
LISTHELP
                return 0
                ;;
        esac
    done
    # Every other tail — including an unknown flag, which the core reports as a
    # usage error with exit 2 — is the core's to parse.
    _ae_core_preflight_try --exec list "$@"
}

# ── #48 archive: pure facts ─────────────────────────────────────────────────────
# Everything here is a QUERY: stdout is the answer, status is a deliberate 0, and none
# of it touches live state. The archive writer and `archive preview` share these, so a
# preview cannot drift from what would actually be published.

cmd_archive_preview() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae archive preview [session-name]" >&2
            echo "(Run inside an ae tmux session to preview it without naming it.)" >&2
            return 1
        }
    fi
    _session_name_usable "$target" || {
        echo "ae: '${target}' is not a usable session name." >&2
        return 1
    }
    local dir="${SESSIONS_DIR}/${target}"
    if [[ ! -d "$dir" ]]; then
        echo "ae: no session state for '${target}'." >&2
        return 1
    fi
    _require_session_path_safe "$target" || return 1
    # P3.2: the Rust core IS the read-only preview tracer, for every mode. It
    # renders a local session's digest and a non-local one's real git facts (HEAD,
    # range, count) through its typed Git capability — it runs `git` through the
    # one process door with OS-native argv, no shell — so the mode gate that once
    # kept unproven shapes on a bash body is gone with the body.
    #
    # `dir` is resolved, existing and path-safe; the core is handed it and renders
    # the whole preview (digest to stdout, banner to stderr) writing nothing. The
    # shim EXECs the core and never returns; with no usable core it refuses (one
    # line, exit 2). META_DIR is a prefix assignment: visible to the shim, which
    # reads ${META_DIR}/meta and execs the core with it, and never mutating the
    # global.
    META_DIR="$dir" _ae_core_try _archive-preview
}

# ── compact phase (b): the semantic handover ────────────────────────────────────
# This is the first place compact TALKS to a live agent, so every failure here is a
# DELIVERY failure and is treated as one: a send that cannot be verified refuses
# immediately, a wait that expires refuses before anything is stopped, and the only
# degradation is the explicit --digest-only — which withdraws the request through the
# sensor rather than pretending it was answered. There is no headless fallback and no
# fabricated reply: the point of the handover is that the agent that did the work says
# what matters, and nothing else can stand in for that.

# Wait for BOTH facts, polling the LOG and the MEMO — never pane output, which is the one
# source this project has repeatedly proven cannot answer "did it land". A reply alone is
# an agent saying "done" with nothing written down; a memo alone is something written with
# nobody claiming the work stopped.
# Reports WHICH of the two facts arrived, REPLY-style in _AE_CP_SAW, because the caller's
# failure message is only honest if it can tell them apart: a reply that arrived CLOSED the
# request, so "re-run to keep waiting on it" — true when nothing arrived — is false here.
# The next run would send a NEW request with a NEW ref and wait on that instead.
_AE_CP_SAW=""
# ── compact phase (c): revalidate, then end under one lock ──────────────────────
# THE ABA GUARD. Everything below re-proves the frozen tuple against the world before
# acting on it, because a name is not an instance: the session that answers to this name
# now may not be the one the human authorized. This slice proved that gap is REACHABLE in
# `ae end` itself, so here it is checked twice — once after the confirmation so a
# replacement is never MESSAGED, and again after the bounded wait so a replacement is
# never STOPPED.

# THREE MORE ORPHANED BLOCKS RETIRED HERE: the `ae end` target classifier, the
# per-session server reader, and the `-S <path>` / `-L <name>` argv printer. All
# three bodies went to the core with `end`/`stop`, and their prose had no subject
# left in this file. The one rule worth keeping visible from here is the TYPED
# PAIR: a server's KIND is a stored key (`tmux_server_kind`), never inferred from
# the value's prefix, because a legacy `-L` server may literally be named "S:x".
# The resolver below is the glue's remaining half of it — it decides what to
# record; the core does the reading and the fail-closed refusals (src/meta.rs
# ServerSelector, src/inventory.rs ServerId).
# Where a launch ACTUALLY lands, as a TYPED PAIR in globals (kind|value).
#
# The core may not read the environment and does not ask tmux which server it is
# on: it RECORDS the pair the glue hands it. So an unresolved `AE_TMUX_SERVER`
# (or an inherited $TMUX, or nothing at all) would land in meta verbatim, and
# every exact-server consumer would read that as "the default server" while the
# session lived somewhere else — the lie the 4th review's B1 closed.
#
# Ask tmux ITSELF for #{socket_path}; a RELATIVE answer is proven by a PID
# round-trip (7th review B1: readlink in the caller's cwd found a same-named
# decoy) and is `ambiguous` when it cannot be proven, so the core fails closed
# rather than guessing.
resolve_launch_tmux_server() {
    _LAUNCH_SRV_KIND=""
    _LAUNCH_SRV_VALUE=""
    local _sp _pid _cand _cpid
    _sp="$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)"
    if [[ -n "$_sp" ]]; then
        if [[ "$_sp" == /* ]]; then
            _LAUNCH_SRV_KIND="socket"
            _LAUNCH_SRV_VALUE="$_sp"
            return 0
        fi
        _pid="$(tmux display-message -p '#{pid}' 2>/dev/null || true)"
        # realpath fallback: `readlink -f` is GNU (macOS only grew it in 12.3),
        # and without a canonical path a relative socket reads as ambiguous and
        # forces every lifecycle operation on that session to fail closed.
        _cand="$(readlink -f -- "$_sp" 2>/dev/null || realpath "$_sp" 2>/dev/null || true)"
        if [[ -n "$_pid" && -n "$_cand" && -S "$_cand" ]]; then
            _cpid="$(command tmux -S "$_cand" display-message -p '#{pid}' 2>/dev/null || true)"
            if [[ -n "$_cpid" && "$_cpid" == "$_pid" ]]; then
                _LAUNCH_SRV_KIND="socket"
                _LAUNCH_SRV_VALUE="$_cand"
                return 0
            fi
        fi
        _LAUNCH_SRV_KIND="ambiguous"
        _LAUNCH_SRV_VALUE="$_sp"
        return 0
    fi
    if [[ -n "${AE_TMUX_SERVER:-}" ]]; then
        # The re-export path carries the kind SEPARATELY (AE_TMUX_SERVER_KIND) — use it
        # when present; otherwise type by shape. Never strip prefixes from the value:
        # a legacy -L server may literally be named "S:evil" (8th review I2).
        if [[ "${AE_TMUX_SERVER_KIND:-}" == "socket" || "${AE_TMUX_SERVER_KIND:-}" == "name" ]]; then
            _LAUNCH_SRV_KIND="$AE_TMUX_SERVER_KIND"
        elif [[ "$AE_TMUX_SERVER" == /* ]]; then
            _LAUNCH_SRV_KIND="socket"
        else
            _LAUNCH_SRV_KIND="name"
        fi
        _LAUNCH_SRV_VALUE="$AE_TMUX_SERVER"
        return 0
    fi
    # DELIBERATELY a bare $TMUX test, unlike the four client-semantics branches
    # hardened for #29: this reads the SOCKET PATH, not our client status. A
    # $TMUX inherited by a GUI terminal still names the very server that spawned
    # it — the right server to talk to. _ae_inside_tmux here would discard a
    # correct answer for being second-hand.
    if [[ -n "${TMUX:-}" ]]; then
        _LAUNCH_SRV_KIND="socket"
        _LAUNCH_SRV_VALUE="${TMUX%%,*}"
    fi
    return 0
}
# WHAT THE HUMAN ACTUALLY CONFIRMED, frozen at the prompt and keyed by target. The plan
# is resolved from config, and config can change between the question and the answer: a
# reviewer flipped a session's purge_agent_history while the prompt was waiting and a
# confirmed KEEP carried out a PURGE — the same ABA shape the stop path already guards,
# reached through the confirmation gap. Populated only when a human was actually asked;
# `-f` freezes nothing, because nothing was promised.
declare -A _AE_END_FROZEN_PLAN=()
# WHOSE contract the payload is: `confirmed` (a human answered end's prompt) or `compact`
# (an ae compact operation authorized it). One mechanism, several callers — recording the
# authority costs nothing and makes a refusal legible about which agreement it is holding
# the operation to.
declare -A _AE_END_FROZEN_AUTHORITY=()
# The exact target list the human was shown. `ae end all` used to enumerate again at
# action time, so a session that appeared AFTER the prompt could be ended without ever
# having been named to anyone.
declare -a _AE_END_CONFIRMED_TARGETS=()
# WHETHER a prompt ran — a separate fact, never inferred from the list's LENGTH. An
# interactive `ae end all` with nothing to end legitimately confirms an EMPTY list, and a
# count cannot tell "confirmed nothing" from "never confirmed": reading zero as "no
# confirmation" sent execution back to a fresh enumeration and ended a session that
# appeared while the prompt waited. AN EMPTY CONFIRMED SET MUST EXECUTE NOTHING.
_AE_END_TARGETS_CONFIRMED=false
# The rendered confirmation line for the target just frozen. REPLY-style, like _EV: the
# freeze path may not fork, because a fork cannot carry the array write back.
_AE_END_PLAN_LINE=""
# ── Telegram bridge (machine-global chat daemon) ─────────────────────
#
# Forwards filtered events from every ae session on this machine to a
# Telegram chat, and routes replies back. The bridge itself is the RUST
# CORE (`ae _telegram-run`), run in a background tmux session named
# `ae-telegram`; what is left here is the start/stop/status glue and the
# config surface. The ONE dependency is a usable ae core. The retired bash
# bridge needed two optional CLIs and gated on them; the core needs none, so
# this feature ships no optional dependency and no dep gate — the core
# resolution in _telegram_spawn_daemon is the only thing that can refuse.
#
# The daemon owns its own state under ~/.ae/telegram/ (offset, sticky
# target) and reads its secrets from [telegram] in the config file ae
# hands it — never from argv, and never from the environment.

_TELEGRAM_TMUX_SESSION="ae-telegram"
# Serializes start / stop / autostart(supervise) so an "is it enabled + running?"
# check and the spawn/kill that follows are one atomic critical section. Without
# it, a watchdog supervise tick can re-spawn a daemon the user just `stop`ped.
# Spawn the Rust core's telegram bridge in its dedicated tmux session. Caller
# must have checked deps and validated config — this just orchestrates tmux.
# The daemon inherits the EXACT config file ae validated (CONFIG_FILE) via
# --config rather than its own <ae-home>/config default: a CONFIG_FILE override
# (tests, or a non-default config) would otherwise validate one file and leave
# the daemon reading another. Secrets never ride argv — the core reads
# token_file / chat_id / allowed_user_ids out of [telegram] in --config itself.
#
# The command is passed to tmux as DIRECT ARGV, not as one shell string. A
# single-string shell-command is run through /bin/sh (dash on Linux), so it
# needs quoting we cannot do portably: printf %q emits bash-only $'...' for a
# path containing a newline or a nonprintable, and dash would then hand the
# daemon different argv than ae resolved. The multi-argument form tmux execs
# directly — no shell, no quoting boundary — so a path with a space, a quote
# or a newline survives byte-for-byte. The core path is absolute (checked
# above), which also keeps it out of option-parsing ambiguity.
# ── COEXISTENCE (pre-P5): delete at the entry flip ───────────────────────────
# WHY THIS EXISTS. The bridge's "already running" check sees only its OWN tmux
# server, so a named-server instance (ae-next) and the default-server instance
# (the installed ae) are invisible to each other — and two bridges long-polling
# ONE bot token is the failure that costs updates, not just tidiness: Telegram
# hands an update to whichever getUpdates arrives first and the other never sees
# it. Structural isolation cannot solve this one, because the token is outside
# both state trees.
#
# THIS BLOCK GOES AWAY AT THE ENTRY FLIP, when there is one ae again. It is
# deliberately conservative: it never stops the default-server instance from
# starting (a plain `ae` has AE_TMUX_SERVER unset and is not gated at all), only
# a second, named-server one.
# Best-effort idempotent autostart — called from the `ae <name>` start path.
# Strictly non-fatal: any error path is a one-line stderr warn, returns 0.
# Caller's session start path MUST NOT be affected by anything here.
# Companion: ensure the orchestrator comes up with the fleet. Opt-in purely by
# existing state — a scaffold from 'ae orchestrator --init' (canonical or legacy
# hub layout); no new config keys. Skips when already running, when launching
# the orchestrator itself, or under AE_NO_AUTOSTART=1 (also the recursion guard for
# the fire-and-forget self-invocation below). Never blocks or fails a launch.
# The session name a launch argv NAMES — for the two autostart guards and
# nothing else: the orchestrator companion must not be started for the
# orchestrator session itself, and a telegram refusal record says which session
# it was refusing for. ADVISORY, and deliberately not a grammar: the core owns
# the launch grammar and every refusal it carries, so this scan accepts anything
# and answers with the last positional exactly as that grammar's `*)` arm does.
# `use` and `--from` consume the word after them (an agent name and an archive
# uuid — neither is a session name). No positional means the core will DERIVE the
# name, and a derived name always carries a path hash, so it can never be
# literally `orchestrator` or `hub`; empty is the right answer there.
_autostart_session_hint() {
    local word name=""
    while [[ $# -gt 0 ]]; do
        word="$1"
        shift
        case "$word" in
            use | --from)
                if (($# > 0)); then
                    shift
                fi
                ;;
            --*) ;;
            *) name="$word" ;;
        esac
    done
    printf '%s\n' "$name"
    return 0
}
