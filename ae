# Internal: spawn a new agent pane (called via spawn helper → ae _spawn)
_cmd_spawn() {
    local meta_dir="$1"
    shift
    local alias_arg="$1"
    shift
    local alias_name="${alias_arg%%:*}"
    local spawn_name=""
    [[ "$alias_arg" == *:* ]] && spawn_name="${alias_arg#*:}"
    # Name must not contain ':' (used as delimiter in meta format)
    if [[ "$spawn_name" == *:* ]]; then
        echo "Error: agent name cannot contain ':' — use alias:name format" >&2
        return 1
    fi
    local user_prompt="${*:-}"

    # Resolve caller's agent identity (the pane that ran spawn)
    local caller_pane caller_agent
    caller_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
    caller_agent=""
    if [[ -n "$caller_pane" ]]; then
        caller_agent="$(tmux display-message -t "$caller_pane" -p '#{@ae_agent}' 2>/dev/null || true)"
    fi

    # Build spawn prompt with reply-back instruction
    local prompt
    if [[ -n "$user_prompt" ]]; then
        if [[ -n "$caller_agent" ]]; then
            prompt="${user_prompt} — When done, reply back via: ${meta_dir}/send \"${caller_agent}\" \"<your reply>\""
        else
            prompt="$user_prompt"
        fi
    else
        prompt="You were spawned into an ae workspace. Read ${meta_dir}/workspace.md for details."
    fi

    # Read meta
    declare -A meta=()
    while IFS='=' read -r k v; do
        case "$k" in
            mode | origin | session | work_dir | layout | config | main_pane) meta["$k"]="$v" ;;
        esac
    done <"$meta_dir/meta"

    local session="${meta[session]:-}" work_dir="${meta[work_dir]:-}" layout="${meta[layout]:-vertical}"
    local config_file="${meta[config]:-}" main_pane="${meta[main_pane]:-}"
    local origin="${meta[origin]:-}" mode="${meta[mode]:-}"

    if [[ -z "$session" ]]; then
        echo "Error: session not found in metadata" >&2
        return 1
    fi
    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Error: session '$session' not running" >&2
        return 1
    fi

    CONFIG_FILE="$config_file"
    # Wire up per-project config from session's origin directory
    AE_LOCAL_CONFIG=""
    if [[ -n "$origin" ]] && [[ -f "${origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${origin}/.ae/config"
    fi
    local cmd
    cmd="$(get_config "agents.${alias_name}")"
    if [[ -z "$cmd" ]]; then
        echo "Error: agent '${alias_name}' not defined in $config_file" >&2
        return 1
    fi

    # Split pane
    local pane_id
    if [[ "$layout" == "vertical" ]]; then
        pane_id="$(tmux split-window -h -t "$session" -c "$work_dir" -P -F '#{pane_id}')"
    else
        pane_id="$(tmux split-window -v -t "$session" -c "$work_dir" -P -F '#{pane_id}')"
    fi

    # Rebalance layout
    if [[ "$layout" == "vertical" ]]; then
        tmux select-layout -t "$session" even-horizontal
    else
        tmux select-layout -t "$session" even-vertical
    fi

    # Register spawned agent in meta (flock-protected to prevent races)
    local session_id tool_kind next_idx slot launch_id
    session_id="$(resolve_agent_session_id "$cmd" "spawned.0")"
    tool_kind="$(tool_kind_from_cmd "$cmd")"
    {
        flock -w 5 200 || {
            echo "Error: could not lock meta" >&2
            return 1
        }
        next_idx=0
        while grep -q "^agent\\.spawned\\.${next_idx}=" "$meta_dir/meta" 2>/dev/null; do
            next_idx=$((next_idx + 1))
        done
        slot="spawned.${next_idx}"
        [[ -z "$spawn_name" ]] && spawn_name="helper-${next_idx}"
        session_id="$(resolve_agent_session_id "$cmd" "$slot")"
        echo "agent.${slot}=${alias_name}:${spawn_name}:${session_id}" >>"$meta_dir/meta"
        echo "agent_bin.${slot}=$(extract_binary_from_cmd "$cmd")" >>"$meta_dir/meta"
        if tool_kind_supports_launch_id "$tool_kind"; then
            launch_id="$(gen_uuid)"
            echo "launch_id.${slot}=${launch_id}" >>"$meta_dir/meta"
        fi
    } 200>"$meta_dir/meta.lock"

    # Label pane (after flock so spawn_name is resolved)
    tmux select-pane -t "$pane_id" -T "ae:${alias_name}:${spawn_name}"
    tmux set-option -p -t "$pane_id" @ae_agent "${alias_name}:${spawn_name}"

    # Regenerate workspace.md from live panes
    regenerate_manifest "$session" "$work_dir" "$origin" "$mode" "$main_pane" "$meta_dir"

    # Wait for new pane's shell to initialize before sending commands
    sleep 0.3

    # Launch agent with session-scoped ID and ae workspace context
    local scoped_cmd initial_msg
    scoped_cmd="$(inject_session_id "$cmd" "$session_id")"
    scoped_cmd="$(inject_ae_context "$scoped_cmd" "$meta_dir" "$session" "$work_dir" "$slot")"
    # For agents without system prompt injection, combine workspace context + spawn prompt
    initial_msg="$(initial_prompt_for_cmd "$cmd" "$meta_dir" "$session" "$work_dir" "$slot")"
    if [[ -n "$initial_msg" ]]; then
        initial_msg="${initial_msg} --- ${prompt}"
    fi
    send_agent_cmd "$pane_id" "$scoped_cmd" "$initial_msg" "$meta_dir" "$slot"

    # Post-launch: capture agent session ID if needed
    start_capture_session_id "$tool_kind" "$pane_id" "$slot" "$meta_dir"

    # For agents with system prompt injection, send spawn prompt separately
    if [[ -z "$initial_msg" ]]; then
        sleep 1
        tmux select-pane -t "$pane_id"
        tmux_paste_submit "$pane_id" "$prompt"
    fi

    echo "Spawned ${alias_name}:${spawn_name} in pane $pane_id"
    # Emit event (inline — _cmd_spawn runs outside _lib context)
    local _esc _actor _target _summary _ts _json
    _esc() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        s="${s//$'\r'/\\r}"
        printf '%s' "$s"
    }
    _actor="$(_esc "${caller_agent:-human}")"
    _target="$(_esc "${alias_name}:${spawn_name}")"
    _summary="$(_esc "$(printf '%.200s' "${user_prompt:-}" | tr '\n\t' '  ')")"
    _ts="$(date -u +%FT%TZ)"
    _json="$(printf '{"ts":"%s","actor":"%s","action":"spawn","target":"%s"' "$_ts" "$_actor" "$_target")"
    [[ -n "$_summary" ]] && _json+="$(printf ',"summary":"%s"' "$_summary")"
    _json+="}"
    { flock -w 5 8 && printf '%s\n' "$_json" >>"$meta_dir/events.jsonl"; } 8>>"$meta_dir/events.jsonl.lock"
}

# Internal: retire a spawned agent (called via retire helper → ae _retire)
_cmd_retire() {
    local meta_dir="$1"
    shift
    local target="$1"

    # Read meta
    declare -A meta=()
    while IFS='=' read -r k v; do
        case "$k" in
            mode | origin | session | work_dir | layout | config | main_pane) meta["$k"]="$v" ;;
        esac
    done <"$meta_dir/meta"

    local session="${meta[session]:-}" work_dir="${meta[work_dir]:-}"
    local main_pane="${meta[main_pane]:-}" origin="${meta[origin]:-}" mode="${meta[mode]:-}"

    if [[ -z "$session" ]]; then
        echo "Error: session not found in metadata" >&2
        return 1
    fi

    # Resolve agent name to pane ID
    local resolved="" pane_agent=""
    if [[ "$target" == %* ]]; then
        # Validate pane belongs to this session
        local pane_in_session=false
        while IFS=$'\t' read -r pid aagent; do
            if [[ "$pid" == "$target" ]]; then
                resolved="$target"
                pane_agent="$aagent"
                pane_in_session=true
                break
            fi
        done < <(tmux list-panes -t "$session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)
        if [[ "$pane_in_session" == false ]]; then
            echo "Error: pane '${target}' not found in session '${session}'" >&2
            return 1
        fi
    else
        local bare_match="" bare_count=0
        while IFS=$'\t' read -r pid aagent; do
            if [[ "$aagent" == "$target" ]]; then
                resolved="$pid"
                pane_agent="$aagent"
                break
            fi
            local aname="${aagent#*:}"
            if [[ "$aname" == "$target" ]]; then
                bare_match="$pid"
                pane_agent="$aagent"
                bare_count=$((bare_count + 1))
            fi
        done < <(tmux list-panes -t "$session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)
        if [[ -z "$resolved" && "$bare_count" -eq 1 ]]; then
            resolved="$bare_match"
        elif [[ -z "$resolved" ]]; then
            if [[ "$bare_count" -gt 1 ]]; then
                echo "Error: ambiguous name '${target}' — use alias:name format" >&2
            else
                echo "Error: agent '${target}' not found" >&2
            fi
            return 1
        fi
    fi

    # Prevent retiring the main agent
    if [[ "$resolved" == "$main_pane" ]]; then
        echo "Error: cannot retire the main agent — use 'ae end' instead" >&2
        return 1
    fi

    # Verify it's a spawned agent (exists in meta as agent.spawned.*)
    local spawned_key=""
    while IFS='=' read -r k v; do
        if [[ "$k" == agent.spawned.* ]]; then
            local entry_alias_name="${v%%:*}"
            local entry_rest="${v#*:}"
            local entry_name="${entry_rest%%:*}"
            if [[ "${entry_alias_name}:${entry_name}" == "$pane_agent" ]]; then
                spawned_key="$k"
                break
            fi
        fi
    done <"$meta_dir/meta"

    if [[ -z "$spawned_key" ]]; then
        # Also check worker agents
        if grep -q "^agent\\.worker\\..*=${pane_agent}:" "$meta_dir/meta" 2>/dev/null; then
            echo "Error: cannot retire a worker agent — use 'ae end' instead" >&2
        else
            echo "Error: agent '${target}' not found in spawned agents" >&2
        fi
        return 1
    fi

    # Kill the pane
    tmux kill-pane -t "$resolved" 2>/dev/null || true

    # Remove the meta entries (flock-protected)
    local spawned_slot="${spawned_key#agent.}"
    {
        flock -w 5 200 || {
            echo "Error: could not lock meta" >&2
            return 1
        }
        local tmpfile="${meta_dir}/meta.tmp.$$"
        grep -v -e "^${spawned_key}=" -e "^agent_bin\\.${spawned_slot}=" "$meta_dir/meta" >"$tmpfile"
        mv "$tmpfile" "$meta_dir/meta"
    } 200>"$meta_dir/meta.lock"

    # Rebalance layout
    local layout="${meta[layout]:-vertical}"
    if [[ "$layout" == "vertical" ]]; then
        tmux select-layout -t "$session" even-horizontal 2>/dev/null || true
    else
        tmux select-layout -t "$session" even-vertical 2>/dev/null || true
    fi

    # Regenerate manifest
    CONFIG_FILE="${meta[config]:-}"
    AE_LOCAL_CONFIG=""
    if [[ -n "$origin" ]] && [[ -f "${origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${origin}/.ae/config"
    fi
    regenerate_manifest "$session" "$work_dir" "$origin" "$mode" "$main_pane" "$meta_dir"

    echo "Retired ${pane_agent} (pane ${resolved})"
    # Emit event (inline — _cmd_retire runs outside _lib context)
    local _esc _actor _target _ts _json
    _esc() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        s="${s//$'\r'/\\r}"
        printf '%s' "$s"
    }
    _actor="$(tmux display-message -p '#{@ae_agent}' 2>/dev/null || true)"
    [[ -n "$_actor" ]] || _actor="human"
    _actor="$(_esc "$_actor")"
    _target="$(_esc "$pane_agent")"
    _ts="$(date -u +%FT%TZ)"
    _json="$(printf '{"ts":"%s","actor":"%s","action":"retire","target":"%s"}' "$_ts" "$_actor" "$_target")"
    { flock -w 5 8 && printf '%s\n' "$_json" >>"$meta_dir/events.jsonl"; } 8>>"$meta_dir/events.jsonl.lock"
}

# Regenerate workspace.md from live tmux pane state
# Scans panes with ae: title prefix, builds agent table
regenerate_manifest() {
    local sess="$1" wdir="$2" origin="$3" mode="$4" main_pane="$5" sessions_dir="$6"
    local manifest="${sessions_dir}/workspace.md"

    # Describe copy mode
    local copy_desc
    case "$mode" in
        git) copy_desc="You are working on a git worktree (detached HEAD from the origin). Push to remote and merge from there." ;;
        full) copy_desc="You are working on a full copy of the project. Push to remote and merge from there." ;;
        local) copy_desc="You are working directly in the project directory (local mode). Changes affect the original files immediately." ;;
    esac

    # Build agent rows from live panes (using @ae_agent option, immune to title overrides)
    local agent_rows=""
    while IFS=$'\t' read -r pane_id ae_agent; do
        [[ -n "$ae_agent" ]] || continue
        local alias_name="${ae_agent%%:*}"
        local agent_name="${ae_agent#*:}"
        agent_name="${agent_name%%:*}" # guard against nested colons
        local role="agent"
        [[ "$pane_id" == "$main_pane" ]] && role="lead"
        local cmd tool_label
        cmd="$(get_config "agents.${alias_name}")"
        tool_label="$(tool_name_from_cmd "${cmd:-$alias_name}")"
        agent_rows="${agent_rows}| ${alias_name}:${agent_name} | ${tool_label} | ${role} | ${pane_id} |
"
    done < <(tmux list-panes -t "$sess" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)

    # Collect available aliases from config for spawn section
    local available_aliases=""
    while IFS= read -r entry; do
        if [[ "$entry" == agents.* ]]; then
            local aname="${entry%%=*}"
            aname="${aname#agents.}"
            if [[ -n "$available_aliases" ]]; then
                available_aliases="${available_aliases}, ${aname}"
            else
                available_aliases="$aname"
            fi
        fi
    done < <(parse_config)

    cat >"$manifest" <<EOF
# ae workspace

Session: ${sess}
Origin: ${origin}
Directory: ${wdir}
Mode: ${mode}

${copy_desc}

## Agents

| Agent | Tool | Role | Pane |
|-------|------|------|------|
${agent_rows}
## Communication

Send a message to another agent by name:
\`\`\`bash
${sessions_dir}/send "<agent_name>" "your message"
\`\`\`

Ask another agent a question and require a reply:
\`\`\`bash
${sessions_dir}/ask <agent_name> "your question"
\`\`\`

Request a critical review:
\`\`\`bash
${sessions_dir}/review <agent_name> "review request"
\`\`\`

Reply to a logged request by request id:
\`\`\`bash
${sessions_dir}/reply <request_id> "your reply"
\`\`\`

Inspect request state without peeking panes:
\`\`\`bash
${sessions_dir}/requests
${sessions_dir}/requests inbox
\`\`\`

Declare your current work state. It shows in \`ae list\` (per agent). Your \`waiting-user\`/\`blocked\` contribute to the session \`attn:\` marker; \`ae list\` may also show watchdog-derived reasons (\`dead\`/\`stale\`/\`throttled\`). The watchdog stops nudging on any quiet state: \`done\` until a newer message arrives; \`waiting-user\`/\`blocked\` until the pane changes (e.g. the human replies), then nudging resumes:
\`\`\`bash
${sessions_dir}/state working "starting on X"
${sessions_dir}/state waiting-user "need clarification on Y"
${sessions_dir}/state blocked "waiting for codex review on req-Z"   # reason required
${sessions_dir}/state done "shipped X"
${sessions_dir}/state                                                # print current state
\`\`\`

\`mark-done "<summary>"\` is preserved as shorthand for \`state done\`. Declare \`working\` on every new task, \`waiting-user\` only after asking the human, \`blocked\` only with a concrete external blocker.

Record durable findings, decisions, and handoffs in shared session memory:
\`\`\`bash
${sessions_dir}/memo add "important shared fact"
${sessions_dir}/memo add --topic arch "we chose SQLite over Postgres"
${sessions_dir}/memo read
${sessions_dir}/memo read --topic arch
${sessions_dir}/memo tail 5
\`\`\`

Memo entries are append-only and stored in \`${sessions_dir}/memo.tsv\`. Use memo for durable shared context, not full chat transcripts.

When another agent sends you a question, task, or review request, reply via the exact \`reply\` or \`send\` command included in that message:
\`\`\`bash
${sessions_dir}/send "<their_agent_name>" "your reply"
\`\`\`

Do not infer the recipient. Do not reply only in your own pane output. Do not poll or capture panes to wait for replies — answers arrive as incoming messages.

## Talking to the human on Telegram

If the human messages you from Telegram, answer with \`say\` — your normal pane
output does NOT reach their phone:
\`\`\`bash
${sessions_dir}/say "done — the menu is live, tested end to end"
echo "a longer, multi-line reply" | ${sessions_dir}/say   # stdin for long text
\`\`\`
\`say\` emits a \`chat\` event the Telegram bridge forwards (when running with
\`chat\` in its include filter). The human can reply to your message on Telegram
and it routes straight back to you.

## Peek

View recent output from another agent's pane:
\`\`\`bash
${sessions_dir}/peek <agent_name> [lines]
\`\`\`
\`\`\`bash
${sessions_dir}/peak <agent_name> [lines]
\`\`\`

Default: 80 lines. Max: 2000. Use peek/peak for inspection only, not as a reply mechanism.

## Agents

List all agents in the session:
\`\`\`bash
${sessions_dir}/agents
\`\`\`

## Focus

Switch to another agent's pane:
\`\`\`bash
${sessions_dir}/focus <agent_name>
\`\`\`

## Interrupt

Stop an agent's current generation and optionally redirect:
\`\`\`bash
${sessions_dir}/interrupt <agent_name> [message]
\`\`\`

Without a message, just cancels current work. With a message, cancels then sends new instructions.

## Spawn

Add another agent to this workspace:
\`\`\`bash
${sessions_dir}/spawn <alias>:<name> [prompt]
\`\`\`

Always give spawned agents a descriptive role name (e.g. \`codex:reviewer\`, \`claude:pair-programmer\`).

Available aliases: ${available_aliases} (from ~/.ae/config)

## Retire

Remove a spawned agent from the workspace:
\`\`\`bash
${sessions_dir}/retire <agent_name|pane_id>
\`\`\`

Kills the pane, removes meta entry, and updates the manifest. Only works on spawned agents.

## Cross-session

All helpers support targeting agents in other ae sessions using \`@session:agent\` syntax:
\`\`\`bash
${sessions_dir}/peek @other-session:claude:lead 20
${sessions_dir}/send @other-session:codex:reviewer "check the API"
\`\`\`

List all agents across all running sessions:
\`\`\`bash
${sessions_dir}/agents --all
\`\`\`

## Rules

- Coordinate file edits -- don't modify the same file simultaneously
- The human can see all panes and may intervene at any time
- Always use the send helper above to communicate with other agents (never raw tmux send-keys)
EOF
}

# --- Agent launch helper (must be defined before dispatcher for _spawn) ---
send_agent_cmd() {
    local pane="$1" cmd="$2" prompt="$3" meta_dir="$4" slot="$5"
    local tool_kind launch_cmd launch_script launch_exec current

    tool_kind="$(tool_kind_from_cmd "$cmd")"
    launch_cmd="$(build_launch_command "$cmd" "$prompt")"
    launch_script="$(write_launch_script "$meta_dir" "$slot" "$launch_cmd")"
    launch_exec="$(shell_quote "$launch_script")"

    tmux_paste_submit "$pane" "$launch_exec"
    # Brief wait to confirm launch started (don't block attach on slow agent init)
    wait_for_agent_start "$pane" "$tool_kind" 10 || true

    case "$cmd" in
        codex*resume*)
            # codex resume doesn't accept inline prompts — send it after the UI comes back.
            if [[ -n "$prompt" ]]; then
                (
                    sleep 3 &&
                        if tmux list-panes -F '#{pane_id} #{pane_current_command}' | grep -q "^${pane} codex$"; then
                            tmux select-pane -t "$pane"
                            tmux_paste_submit "$pane" "$prompt"
                        fi
                ) &
            fi
            ;;
        opencode*)
            # OpenCode has no system prompt flag — launch TUI, then paste context as first message.
            if [[ -n "$prompt" ]]; then
                (
                    sleep 3 &&
                        if tmux list-panes -F '#{pane_id} #{pane_current_command}' | grep -q "^${pane} opencode$"; then
                            tmux select-pane -t "$pane"
                            tmux_paste_submit "$pane" "$prompt"
                        fi
                ) &
            fi
            ;;
    esac
}

# --- ae hub: meta-agent launcher ---
# Copy one template file to its destination, NO overwrite, substituting a single
# __PLACEHOLDER__ via bash param expansion (no sed → safe with '/' in the value).
# Reports created vs skipped per file so partial dirs are handled explicitly.
_hub_scaffold_file() {
    local src="$1" dst="$2" content
    shift 2 # remaining args are placeholder/value pairs
    if [[ -e "$dst" ]]; then
        echo "  skipped (exists): $dst"
        return 0
    fi
    content="$(cat "$src" 2>/dev/null)" || {
        echo "  ERROR reading template $src" >&2
        return 1
    }
    # Two-phase substitution so an inserted VALUE is never rescanned by a later
    # placeholder (codex: sequential ${//} reprocesses inserted text). Phase 1
    # maps every placeholder to a unique SOH-delimited sentinel (no values yet);
    # phase 2 maps sentinels to values. A real path value can't contain a \x01, so
    # phase-2 insertions can never collide — making it order-independent.
    local -a _ph _val
    local _n=0 soh=$'\x01'
    while (($# >= 2)); do
        _ph[_n]="$1"
        _val[_n]="$2"
        _n=$((_n + 1))
        shift 2
    done
    local _i
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${_ph[_i]}/${soh}${_i}${soh}}"
    done
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${soh}${_i}${soh}/${_val[_i]}}"
    done
    printf '%s\n' "$content" >"$dst" || {
        echo "  ERROR writing $dst" >&2
        return 1
    }
    echo "  created: $dst"
}

# Scaffold ~/.ae/meta-hub/{hub.config,CHARTER.md} from contrib/aehub templates.
cmd_hub_init() {
    local hub_dir="${AE_HUB_DIR:-$CONFIG_DIR/meta-hub}"
    # Reject a HUB_DIR that would break the INI double-quoted instructions value.
    case "$hub_dir" in
        *'"'* | *$'\n'*)
            echo "Error: AE_HUB_DIR contains an unsupported character (quote/newline): $hub_dir" >&2
            return 1
            ;;
    esac
    # Resolve template dir relative to THIS script (symlink-aware) with a
    # realpath/echo fallback — never hard-depend on readlink being present.
    local self tdir aemon_path charter_path helpers_dir
    self="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        echo "${BASH_SOURCE[0]:-$0}")"
    tdir="$(dirname "$self")/contrib/aehub"
    if [[ ! -d "$tdir" ]]; then
        echo "Error: hub templates not found at $tdir." >&2
        echo "(single-file install?) Create $hub_dir/hub.config + CHARTER.md by hand." >&2
        return 1
    fi
    mkdir -p "$hub_dir" || return 1
    # Canonicalize to an ABSOLUTE dir so a relative AE_HUB_DIR doesn't bake a
    # relative charter path into hub.config — `ae hub` later cd's into the dir, so
    # `rel/CHARTER.md` would wrongly resolve to `rel/rel/CHARTER.md`.
    hub_dir="$(cd "$hub_dir" && pwd -P)" || return 1
    charter_path="$hub_dir/CHARTER.md"
    aemon_path="$(dirname "$self")/contrib/aemonitor/aemonitor"
    # The hub session is always named `hub`; its helper scripts live here. Baked
    # into the charter so it's correct under any AE_HOME (default ~/.ae/sessions/hub,
    # isolated e2e runs $AE_HOME/sessions/hub) — never the wrong (live) ~/.ae.
    helpers_dir="$CONFIG_DIR/sessions/hub"
    echo "Scaffolding hub into $hub_dir:"
    # CHARTER.md first (the config points at it).
    _hub_scaffold_file "$tdir/CHARTER.md" "$charter_path" \
        "__AEMONITOR_PATH__" "$aemon_path" "__HELPERS_DIR__" "$helpers_dir" || return 1
    _hub_scaffold_file "$tdir/hub.config" "$hub_dir/hub.config" "__CHARTER_PATH__" "$charter_path" || return 1
    echo
    echo "Done. Review/edit those files, then run: ae hub"
}

cmd_hub_help() {
    cat <<'EOF'
ae hub — launch the meta-agent hub: one ae session that monitors all your other
ae sessions and is your single point of contact to them.

  ae hub           ensure the `hub` session is running (detached, isolated config)
  ae hub --attach  switch/attach to the `hub` session
  ae hub --init    scaffold ~/.ae/meta-hub/{hub.config,CHARTER.md} (never overwrites)
  ae hub --help    this help

Config dir: ~/.ae/meta-hub (or $AE_HOME/meta-hub when AE_HOME is set; override
with AE_HUB_DIR). See contrib/aehub/README.md for details.
EOF
}

# --- Dispatcher ---
ATTACH_ON_READY=true
case "${1:-}" in
    list | ls)
        cmd_list "${@:2}"
        exit $?
        ;;
    status)
        cmd_status "${2:-}"
        exit $?
        ;;
    next | jump)
        cmd_next "${@:2}"
        exit $?
        ;;
    doctor)
        cmd_doctor "${@:2}"
        exit $?
        ;;
    stop)
        cmd_stop "${2:-}"
        exit $?
        ;;
    rename)
        cmd_rename "${2:-}" "${3:-}"
        exit $?
        ;;
    watchdog | loop) # 'loop' kept as the deprecated alias for the renamed feature
        cmd_watchdog "${2:-}" "${3:-}"
        exit $?
        ;;
    telegram)
        cmd_telegram "${@:2}"
        exit $?
        ;;
    hub)
        # Meta-agent launcher. Trampoline: handle --init/help (exit), else set up
        # FULL config isolation (the start-hub wrapper's job) and FALL THROUGH to
        # the generic start/resume path below as if `ae hub` named the session.
        # We must NOT re-dispatch the subcommand here (that would re-enter this
        # branch and recurse) — falling through reuses the generic parser instead.
        shift
        _hub_attach=false
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --init)
                    if [[ $# -gt 1 ]]; then
                        echo "Error: 'ae hub --init' takes no further arguments (got: ${*:2})" >&2
                        exit 1
                    fi
                    cmd_hub_init
                    exit $?
                    ;;
                -h | --help | help)
                    cmd_hub_help
                    exit 0
                    ;;
                --attach | --switch)
                    _hub_attach=true
                    shift
                    ;;
                --detach | --no-attach)
                    _hub_attach=false
                    shift
                    ;;
                *)
                    # The hub session is ALWAYS named `hub` with the standalone config;
                    # accepting extra args would let `ae hub foo` become session `foo`
                    # via the generic parser (last positional wins), leaking the
                    # reserved name + hub config onto another session. Reject them.
                    echo "Error: 'ae hub' takes no positional arguments (flags: --init / --help / --attach / --detach). Got: $*" >&2
                    echo "The hub session is always named 'hub' (config: \${AE_HUB_DIR:-~/.ae/meta-hub}/hub.config)." >&2
                    echo "To run a normal session literally named 'hub', use: ae --local hub" >&2
                    exit 1
                    ;;
            esac
        done
        if $_hub_attach; then
            ATTACH_ON_READY=true
        else
            ATTACH_ON_READY=false
        fi
        _hub_dir="${AE_HUB_DIR:-$CONFIG_DIR/meta-hub}"
        _hub_config="$_hub_dir/hub.config"
        if [[ ! -f "$_hub_config" ]]; then
            echo "Error: no hub config at $_hub_config." >&2
            echo "Run 'ae hub --init' to scaffold the meta-agent config + charter." >&2
            exit 1
        fi
        # BLOCKER fix (codex): CONFIG_FILE alone does NOT isolate. AE_LOCAL_CONFIG
        # was captured from the CALLER's PWD near script top (before any cd), so a
        # project-local ./.ae/config could still override workspace.*/prompt.* and
        # reintroduce the worker-leak. Replicate the wrapper's full isolation:
        AE_LOCAL_CONFIG="" # drop the caller-PWD local config
        cd "$_hub_dir" || {
            echo "Error: cannot cd to $_hub_dir" >&2
            exit 1
        }
        # Set CONFIG_FILE from $PWD *after* cd so it's absolute even when AE_HUB_DIR
        # is relative (a relative path stored in meta would break resume elsewhere).
        CONFIG_FILE="$PWD/hub.config" # standalone hub config wins (absolute, isolated)
        # copy=local ⇒ work_dir/origin become $_hub_dir; on resume the restore path
        # below rebuilds AE_LOCAL_CONFIG from stored_origin=$_hub_dir (no .ae/config
        # there), so the isolation persists across resume too.
        set -- hub # session name = hub (extra args already rejected above)
        # fall through (NO exit) to flag-parse + generic start/resume
        ;;
    transfer)
        cmd_transfer "${@:2}"
        exit $?
        ;;
    end | rm)
        cmd_end "${@:2}"
        exit $?
        ;;
    _spawn)
        _cmd_spawn "${@:2}"
        exit $?
        ;;
    _retire)
        _cmd_retire "${@:2}"
        exit $?
        ;;
    _recover-pending)
        cmd_recover_pending "${@:2}"
        exit $?
        ;;
    help | -h | --help)
        cmd_help
        exit 0
        ;;
    version | --version | -V)
        echo "ae ${AE_VERSION}"
        exit 0
        ;;
esac

# --- Parse flags ---
COPY_MODE_OVERRIDE=""
SESSION=""
MAIN_OVERRIDE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --worktree)
            COPY_MODE_OVERRIDE="git"
            shift
            ;;
        --copy)
            COPY_MODE_OVERRIDE="full"
            shift
            ;;
        --local)
            COPY_MODE_OVERRIDE="local"
            shift
            ;;
        use)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: 'use' requires an agent alias (e.g. ae myproject use codex)" >&2
                exit 1
            fi
            MAIN_OVERRIDE="$1"
            shift
            ;;
        --*)
            echo "Error: unknown flag '$1'. Use --worktree, --copy, or --local." >&2
            exit 1
            ;;
        *)
            SESSION="$1"
            shift
            ;;
    esac
done

check_deps || exit 1

# Session name: use argument if given, otherwise derive from PWD
if [[ -z "$SESSION" ]]; then
    SESSION="$(default_session_name)"
fi

# Existing session? Just reattach (but only if it's an ae session).
if tmux has-session -t "$SESSION" 2>/dev/null; then
    if tmux show-environment -t "$SESSION" AE_SESSION 2>/dev/null | grep -q '^AE_SESSION='; then
        _telegram_autostart_if_enabled 2>/dev/null || true
        if [[ "$ATTACH_ON_READY" != "true" ]]; then
            echo "Session '$SESSION' is running. Use 'ae hub --attach' to view."
            exit 0
        fi
        tmux_attach "$SESSION"
    else
        echo "Error: tmux session '$SESSION' exists but is not an ae session." >&2
        exit 1
    fi
fi

# On resume: restore config paths from meta (ensures agent aliases resolve from original config)
if [[ -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
    _stored_config="$(read_session_meta "$SESSION" config)"
    if [[ -n "$_stored_config" && -f "$_stored_config" ]]; then
        CONFIG_FILE="$_stored_config"
    fi
    _stored_origin="$(read_session_meta "$SESSION" origin)"
    if [[ -n "$_stored_origin" && -f "${_stored_origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${_stored_origin}/.ae/config"
    else
        AE_LOCAL_CONFIG=""
    fi
fi

# --- Validate config before creating anything ---
# Parse alias[:name] — e.g. "claude:lead" → alias=claude, name=lead
# If no name given, name defaults to the alias itself
# On resume: recover agent from session meta (preserves 'use' override)
if [[ -z "$MAIN_OVERRIDE" ]]; then
    _saved_main="$(read_session_meta "$SESSION" agent.main)"
    if [[ -n "$_saved_main" ]]; then
        # agent.main format is alias:name:session_id — extract alias:name
        _saved_alias="${_saved_main%%:*}"
        _saved_rest="${_saved_main#*:}"
        _saved_name="${_saved_rest%%:*}"
        MAIN_RAW="${_saved_alias}:${_saved_name}"
    else
        MAIN_RAW="$(get_config workspace.main)"
    fi
else
    MAIN_RAW="$MAIN_OVERRIDE"
fi
if [[ "$MAIN_RAW" == *:* ]]; then
    MAIN_ALIAS="${MAIN_RAW%%:*}"
    MAIN_NAME="${MAIN_RAW#*:}"
else
    MAIN_ALIAS="$MAIN_RAW"
    MAIN_NAME="$MAIN_RAW" # default name = alias
fi
if [[ "$MAIN_NAME" == *:* ]]; then
    echo "Error: agent name '${MAIN_NAME}' cannot contain ':' — use alias:name format (one colon)" >&2
    exit 1
fi
LAYOUT="$(get_config workspace.layout)"
WORKERS_RAW="$(get_config workspace.workers)"
# meta-agent (hub) mode: [workspace] hub = true (preferred) — or its legacy alias
# meta = true — marks this session as the monitoring hub. The watchdog then runs a
# sweep-cadence (periodic "run your sweep now") instead of the stale-nudge
# watchdog. Persisted to meta as meta_agent (internal name unchanged).
META_AGENT_CFG="$(get_config workspace.hub)"
[[ -z "$META_AGENT_CFG" ]] && META_AGENT_CFG="$(get_config workspace.meta)"

# Determine copy mode: CLI flag > config > default (local)
if [[ -n "$COPY_MODE_OVERRIDE" ]]; then
    COPY_MODE="$COPY_MODE_OVERRIDE"
else
    COPY_MODE="$(get_config workspace.copy)"
    COPY_MODE="${COPY_MODE:-local}"
fi

# On resume: force mode from stored meta to prevent drift (CLI flag still overrides)
if [[ -z "$COPY_MODE_OVERRIDE" ]] && [[ -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
    _stored_mode="$(read_session_meta "$SESSION" mode)"
    [[ -n "$_stored_mode" ]] && COPY_MODE="$_stored_mode"
fi

if [[ "$COPY_MODE" != "git" ]] && [[ "$COPY_MODE" != "full" ]] && [[ "$COPY_MODE" != "local" ]]; then
    echo "Error: invalid copy mode '${COPY_MODE}'. Use 'git', 'full', or 'local'." >&2
    exit 1
fi

if [[ -z "$MAIN_ALIAS" ]]; then
    echo "Error: workspace.main not set in $CONFIG_FILE" >&2
    exit 1
fi

MAIN_CMD="$(get_config "agents.${MAIN_ALIAS}")"
if [[ -z "$MAIN_CMD" ]]; then
    echo "Error: agent '${MAIN_ALIAS}' not defined in $CONFIG_FILE" >&2
    exit 1
fi

WORKER_CMDS=()
WORKER_ALIASES=()
WORKER_NAMES=()
if [[ -n "$WORKERS_RAW" ]]; then
    IFS=',' read -ra _entries <<<"$WORKERS_RAW"
    for entry in "${_entries[@]}"; do
        entry="$(echo "$entry" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        if [[ "$entry" == *:* ]]; then
            walias="${entry%%:*}"
            wname="${entry#*:}"
            if [[ "$wname" == *:* ]]; then
                echo "Error: worker name '${wname}' cannot contain ':' — use alias:name format (one colon)" >&2
                exit 1
            fi
        else
            walias="$entry"
            wname="$entry" # default name = alias
        fi
        cmd="$(get_config "agents.${walias}")"
        if [[ -z "$cmd" ]]; then
            echo "Error: agent '${walias}' not defined in $CONFIG_FILE" >&2
            exit 1
        fi
        WORKER_ALIASES+=("$walias")
        WORKER_NAMES+=("$wname")
        WORKER_CMDS+=("$cmd")
    done
    # Deduplicate names: append index if a name collides with main or another worker
    declare -A _name_seen=()
    _name_seen["$MAIN_NAME"]=1
    for i in "${!WORKER_NAMES[@]}"; do
        wn="${WORKER_NAMES[$i]}"
        if [[ -n "${_name_seen[$wn]:-}" ]]; then
            WORKER_NAMES[i]="${wn}-${i}"
        fi
        _name_seen["${WORKER_NAMES[$i]}"]=1
    done
    unset _name_seen
fi

# --- Working directory: local, resume existing, or create new ---
ORIGIN_DIR="$PWD"
WORK_DIR="${WORKTREES_DIR}/${SESSION}"
RESUMING=false

if [[ "$COPY_MODE" == "local" ]]; then
    # Local mode: work directly in current directory, no copy
    # Mode collision: error if a stopped worktree/copy session exists with the same name
    if [[ -d "${WORKTREES_DIR}/${SESSION}" ]]; then
        echo "Error: stopped session '${SESSION}' exists as worktree/copy. End it first (ae end ${SESSION}), or use a different name." >&2
        exit 1
    fi
    WORK_DIR="$PWD"
    # Resume if session meta exists from a previous run (e.g. after reboot)
    if [[ -f "${SESSIONS_DIR}/${SESSION}/meta" ]]; then
        RESUMING=true
        # Restore original work_dir so agents resume in the correct CWD
        # (Claude Code's --resume is scoped to ~/.claude/projects/<encoded-CWD>/)
        _stored_wd="$(read_session_meta "$SESSION" work_dir)"
        if [[ -n "$_stored_wd" && -d "$_stored_wd" ]]; then
            WORK_DIR="$_stored_wd"
        fi
        _stored_origin="$(read_session_meta "$SESSION" origin)"
        [[ -n "$_stored_origin" ]] && ORIGIN_DIR="$_stored_origin"
        echo "Resuming session ${SESSION} (dir: ${WORK_DIR})..."
    fi
elif [[ -d "$WORK_DIR" ]]; then
    # Existing worktree — resume it (e.g. after reboot)
    RESUMING=true
    # Restore ORIGIN_DIR from meta (used by cleanup and env vars)
    _stored_origin="$(read_session_meta "$SESSION" origin)"
    [[ -n "$_stored_origin" ]] && ORIGIN_DIR="$_stored_origin"
    echo "Resuming session ${SESSION}..."
else
    mkdir -p "$WORK_DIR"
    if [[ "$COPY_MODE" == "git" ]]; then
        # Git worktree: fast, shares .git, true isolation
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            echo "Creating git worktree..."
            git worktree add --detach "$WORK_DIR" HEAD 2>/dev/null || {
                # Stale registration — prune and retry
                git worktree prune 2>/dev/null || true
                git worktree add --detach "$WORK_DIR" HEAD
            }
        else
            echo "Warning: not a git repo, falling back to full copy." >&2
            COPY_MODE="full"
            echo "Creating full copy..."
            cp -a "$PWD/." "$WORK_DIR"
        fi
    else
        # Full copy: includes untracked files (node_modules, .venv, etc.)
        echo "Creating full copy..."
        cp -a "$PWD/." "$WORK_DIR"
    fi
    echo "Working copy ready."
fi

# --- Create tmux session in the worktree ---
PANE_IDS=()
tmux new-session -d -s "$SESSION" -c "$WORK_DIR"
# Unset env vars that prevent Claude Code from starting inside tmux
tmux set-environment -t "$SESSION" -u CLAUDECODE
tmux set-environment -t "$SESSION" -u CLAUDE_CODE_SESSION

# Tag as ae session and store directories/mode
tmux set-environment -t "$SESSION" AE_SESSION 1
tmux set-environment -t "$SESSION" AE_ORIGIN "$ORIGIN_DIR"
tmux set-environment -t "$SESSION" AE_DIR "$WORK_DIR"
tmux set-environment -t "$SESSION" AE_MODE "$COPY_MODE"
# Pin AE_HOME into the session so hidden helpers run from the pane (spawn/retire →
# `ae _spawn`/`_retire`) resolve the SAME ae state, not the real ~/.ae — without
# relying on tmux-server env inheritance. Only meaningful when AE_HOME is overridden.
tmux set-environment -t "$SESSION" AE_HOME "$CONFIG_DIR"

# ae-specific tmux options (session-scoped, doesn't affect other tmux usage)
tmux set-option -t "$SESSION" mouse on
tmux set-option -t "$SESSION" focus-events on 2>/dev/null || true
tmux set-option -t "$SESSION" history-limit 50000
tmux set-option -t "$SESSION" pane-border-status top
tmux set-option -t "$SESSION" pane-border-format " #{@ae_agent} "
_ae_apply_status_left "$SESSION" "$COPY_MODE" "$ORIGIN_DIR" "$WORK_DIR"
tmux set-option -t "$SESSION" automatic-rename off
tmux rename-window -t "$SESSION" "$SESSION"

PANE_IDS+=("$(tmux display-message -t "$SESSION" -p '#{pane_id}')")

for i in "${!WORKER_CMDS[@]}"; do
    local_id=""
    if [[ "$LAYOUT" == "vertical" ]]; then
        local_id="$(tmux split-window -h -t "$SESSION" -c "$WORK_DIR" -P -F '#{pane_id}')"
    else
        local_id="$(tmux split-window -v -t "$SESSION" -c "$WORK_DIR" -P -F '#{pane_id}')"
    fi
    PANE_IDS+=("$local_id")
done

# Distribute panes evenly
if ((${#PANE_IDS[@]} > 1)); then
    if [[ "$LAYOUT" == "vertical" ]]; then
        tmux select-layout -t "$SESSION" even-horizontal
    else
        tmux select-layout -t "$SESSION" even-vertical
    fi
fi

# Label panes: title for border display, @ae_agent option for reliable identity
tmux select-pane -t "${PANE_IDS[0]}" -T "ae:${MAIN_ALIAS}:${MAIN_NAME}"
tmux set-option -p -t "${PANE_IDS[0]}" @ae_agent "${MAIN_ALIAS}:${MAIN_NAME}"
for i in "${!WORKER_ALIASES[@]}"; do
    idx=$((i + 1))
    tmux select-pane -t "${PANE_IDS[$idx]}" -T "ae:${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]}"
    tmux set-option -p -t "${PANE_IDS[$idx]}" @ae_agent "${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]}"
done

# --- Generate helper scripts and workspace manifest ---
AE_META="${SESSIONS_DIR}/${SESSION}"
mkdir -p "$AE_META" && chmod 0700 "$AE_META"

# Session metadata (used by ae list/end for stopped sessions, and by spawn helper)
# Always write full meta: on resume, preserve original mode/origin from existing file
META_MODE="$COPY_MODE"
META_ORIGIN="$ORIGIN_DIR"
if [[ "$RESUMING" == true ]]; then
    # read_session_meta checks new path then falls back to legacy path
    META_MODE="$(read_session_meta "$SESSION" mode)"
    META_ORIGIN="$(read_session_meta "$SESSION" origin)"
    META_MODE="${META_MODE:-$COPY_MODE}"
    META_ORIGIN="${META_ORIGIN:-$ORIGIN_DIR}"
fi

MAIN_SESSION_ID="$(resolve_agent_session_id "$MAIN_CMD" "main")"
MAIN_LAUNCH_ID=""
if [[ "$RESUMING" != true ]]; then
    MAIN_TOOL_KIND="$(tool_kind_from_cmd "$MAIN_CMD")"
    if tool_kind_supports_launch_id "$MAIN_TOOL_KIND"; then
        MAIN_LAUNCH_ID="$(gen_uuid)"
    fi
fi

declare -a WORKER_SESSION_IDS=()
declare -a WORKER_LAUNCH_IDS=()
for i in "${!WORKER_CMDS[@]}"; do
    WORKER_SESSION_IDS+=("$(resolve_agent_session_id "${WORKER_CMDS[$i]}" "worker.${i}")")
    WORKER_TOOL_KIND="$(tool_kind_from_cmd "${WORKER_CMDS[$i]}")"
    if [[ "$RESUMING" != true ]] && tool_kind_supports_launch_id "$WORKER_TOOL_KIND"; then
        WORKER_LAUNCH_IDS+=("$(gen_uuid)")
    else
        WORKER_LAUNCH_IDS+=("")
    fi
done

# Load spawned agents from previous session (resume only)
declare -a SPAWNED_ALIASES=() SPAWNED_NAMES=() SPAWNED_CMDS=() SPAWNED_SESSION_IDS=()
if [[ "$RESUMING" == true ]]; then
    sidx=0
    while true; do
        spawned_entry="$(read_session_meta "$SESSION" "agent.spawned.${sidx}")"
        [[ -z "$spawned_entry" ]] && break
        # Format: alias:name:session_id
        salias="${spawned_entry%%:*}"
        _rest="${spawned_entry#*:}"
        sname="${_rest%%:*}"
        scmd="$(get_config "agents.${salias}")"
        if [[ -n "$scmd" ]]; then
            SPAWNED_ALIASES+=("$salias")
            SPAWNED_NAMES+=("$sname")
            SPAWNED_CMDS+=("$scmd")
            SPAWNED_SESSION_IDS+=("$(resolve_agent_session_id "$scmd" "spawned.${sidx}")")
        fi
        sidx=$((sidx + 1))
    done

    # Create panes for spawned agents
    for i in "${!SPAWNED_ALIASES[@]}"; do
        local_id=""
        if [[ "$LAYOUT" == "vertical" ]]; then
            local_id="$(tmux split-window -h -t "$SESSION" -c "$WORK_DIR" -P -F '#{pane_id}')"
        else
            local_id="$(tmux split-window -v -t "$SESSION" -c "$WORK_DIR" -P -F '#{pane_id}')"
        fi
        PANE_IDS+=("$local_id")
        tmux select-pane -t "$local_id" -T "ae:${SPAWNED_ALIASES[$i]}:${SPAWNED_NAMES[$i]}"
        tmux set-option -p -t "$local_id" @ae_agent "${SPAWNED_ALIASES[$i]}:${SPAWNED_NAMES[$i]}"
    done
    # Rebalance if spawned agents were added
    if ((${#SPAWNED_ALIASES[@]} > 0)); then
        if [[ "$LAYOUT" == "vertical" ]]; then
            tmux select-layout -t "$SESSION" even-horizontal
        else
            tmux select-layout -t "$SESSION" even-vertical
        fi
    fi
fi

AE_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Preserve per-session watchdog override across rewrite (if any). Reads the
# canonical 'watchdog=' key, falling back to the legacy 'loop=' key so a session
# created before the rename keeps its on/off setting across resume.
PRESERVED_WATCHDOG=""
PRESERVED_STATUS_RIGHT_PREV=""
PRESERVED_STATUS_RIGHT_WAS_SESSION=""
PRESERVED_SESSION_ID=""
if [[ -f "${AE_META}/meta" ]]; then
    PRESERVED_WATCHDOG="$(grep '^watchdog=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    # Canonical-wins: only fall back to the legacy 'loop=' key when 'watchdog=' is
    # absent (matches the runtime read order). A first-line-wins grep would let a
    # 'loop=' that happens to sit above 'watchdog=' override the canonical value.
    [[ -n "$PRESERVED_WATCHDOG" ]] || PRESERVED_WATCHDOG="$(grep '^loop=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_STATUS_RIGHT_PREV="$(grep '^status_right_prev=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_STATUS_RIGHT_WAS_SESSION="$(grep '^status_right_was_session=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    PRESERVED_SESSION_ID="$(grep '^session_id=' "${AE_META}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
fi
# session_id is a stable UUID for the ae session, separate from the
# human-readable name. Persists across rename + transfer. Used by external
# bridges (chat, webhooks) to bind to a specific session unambiguously
# regardless of name collisions across machines.
SESSION_ID="${PRESERVED_SESSION_ID:-$(gen_uuid)}"

cat >"${AE_META}/meta" <<EOF
mode=${META_MODE}
origin=${META_ORIGIN}
session=${SESSION}
session_id=${SESSION_ID}
work_dir=${WORK_DIR}
layout=${LAYOUT:-vertical}
config=${CONFIG_FILE}
main_pane=${PANE_IDS[0]}
ae_path=${AE_PATH}
ae_version=${AE_VERSION}
tmux_server=${AE_TMUX_SERVER:-}
agent.main=${MAIN_ALIAS}:${MAIN_NAME}:${MAIN_SESSION_ID}
agent_bin.main=$(extract_binary_from_cmd "$MAIN_CMD")
EOF
# Converge on the canonical 'watchdog' key (value preserved from 'watchdog=' or
# legacy 'loop=' key — see PRESERVED_WATCHDOG above).
[[ -n "$PRESERVED_WATCHDOG" ]] && echo "watchdog=${PRESERVED_WATCHDOG}" >>"${AE_META}/meta"
# Config-driven (re-read every start/resume): mark the monitoring hub so its watchdog
# runs the sweep-cadence instead of the stale-nudge watchdog.
case "$META_AGENT_CFG" in
    true | 1 | yes | on) echo "meta_agent=true" >>"${AE_META}/meta" ;;
esac
[[ -n "$PRESERVED_STATUS_RIGHT_PREV" ]] && echo "status_right_prev=${PRESERVED_STATUS_RIGHT_PREV}" >>"${AE_META}/meta"
[[ -n "$PRESERVED_STATUS_RIGHT_WAS_SESSION" ]] && echo "status_right_was_session=${PRESERVED_STATUS_RIGHT_WAS_SESSION}" >>"${AE_META}/meta"
for i in "${!WORKER_CMDS[@]}"; do
    echo "agent.worker.${i}=${WORKER_ALIASES[$i]}:${WORKER_NAMES[$i]}:${WORKER_SESSION_IDS[$i]}" >>"${AE_META}/meta"
    echo "agent_bin.worker.${i}=$(extract_binary_from_cmd "${WORKER_CMDS[$i]}")" >>"${AE_META}/meta"
done
for i in "${!SPAWNED_ALIASES[@]}"; do
    echo "agent.spawned.${i}=${SPAWNED_ALIASES[$i]}:${SPAWNED_NAMES[$i]}:${SPAWNED_SESSION_IDS[$i]}" >>"${AE_META}/meta"
    echo "agent_bin.spawned.${i}=$(extract_binary_from_cmd "${SPAWNED_CMDS[$i]}")" >>"${AE_META}/meta"
done
[[ -n "$MAIN_LAUNCH_ID" ]] && echo "launch_id.main=${MAIN_LAUNCH_ID}" >>"${AE_META}/meta"
for i in "${!WORKER_LAUNCH_IDS[@]}"; do
    [[ -n "${WORKER_LAUNCH_IDS[$i]}" ]] && echo "launch_id.worker.${i}=${WORKER_LAUNCH_IDS[$i]}" >>"${AE_META}/meta"
done

sync_session_assets() {
    local session_name="$1" meta_dir="$2" work_dir="$3" origin="$4" mode="$5" main_pane="$6" config_file="${7:-$CONFIG_FILE}"
    local previous_config="$CONFIG_FILE" previous_local_config="${AE_LOCAL_CONFIG:-}"
    local ae_path
    ae_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

    if [[ -n "$config_file" ]]; then
        CONFIG_FILE="$config_file"
    fi
    AE_LOCAL_CONFIG=""

    if [[ -f "${meta_dir}/meta" ]]; then
        set_session_meta_value "${meta_dir}/meta" "ae_path" "$ae_path"
        set_session_meta_value "${meta_dir}/meta" "ae_version" "$AE_VERSION"
        if [[ -n "$config_file" ]]; then
            set_session_meta_value "${meta_dir}/meta" "config" "$config_file"
        fi
    fi

    local AE_META="$meta_dir"
    local SESSION="$session_name"
    local WORK_DIR="$work_dir"
    local ORIGIN_DIR="$origin"
    local COPY_MODE="$mode"
    local MAIN_PANE="$main_pane"

    # SYNC_SESSION_ASSETS_BODY_START
    # Remove orphan files from previous ae versions before regenerating helpers.
    # Helpers are unconditionally rewritten below; this list is only for things
    # whose *name* has been removed (renamed/deleted) so their old artifact
    # would otherwise sit forever in $AE_META alongside the new ones.
    # When you rename or drop a helper, add the old name here.
    for _ae_orphan in "done" register-sid shepherd messages.tsv messages.tsv.lock requests.tsv requests.tsv.lock; do
        rm -f "${AE_META:?}/${_ae_orphan}"
    done
    unset _ae_orphan

    # Shared library sourced by all helpers — tmux shim, name resolution, locking
    cat >"${AE_META}/_lib" <<'LIBEOF'
# tmux server shim
_AE_META_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_ts="$(grep '^tmux_server=' "$_AE_META_DIR/meta" | cut -d= -f2-)"
[[ -n "$_ts" ]] && tmux() { command tmux -L "$_ts" "$@"; }
_AE_SESSION="$(grep '^session=' "$_AE_META_DIR/meta" | cut -d= -f2-)"
_AE_SESSIONS_DIR="$(dirname "$_AE_META_DIR")"

# Resolve agent target to pane ID
# Supports: %pane-id, @session:agent-ref, alias:name, alias-only, bare-name
# Sets: AE_RESOLVED_PANE (pane ID), AE_RESOLVED_AGENT (canonical agent ref) or exits with error
ae_resolve() {
    local target="$1"
    AE_RESOLVED_PANE=""
    AE_RESOLVED_AGENT=""

    # 1. Raw pane ID — pass through
    if [[ "$target" == %* ]]; then
        AE_RESOLVED_PANE="$target"
        local pane_agent pane_session
        pane_agent="$(tmux display-message -p -t "$target" '#{@ae_agent}' 2>/dev/null || true)"
        pane_session="$(tmux display-message -p -t "$target" '#S' 2>/dev/null || true)"
        if [[ -n "$pane_agent" ]]; then
            if [[ -n "$pane_session" && "$pane_session" != "$_AE_SESSION" ]]; then
                AE_RESOLVED_AGENT="@${pane_session}:${pane_agent}"
            else
                AE_RESOLVED_AGENT="$pane_agent"
            fi
        fi
        return 0
    fi

    # 2. Cross-session: @session:agent-ref
    local search_session="$_AE_SESSION"
    if [[ "$target" == @* ]]; then
        if [[ "$target" != @*:* ]]; then
            echo "Error: cross-session target must be @session:agent, got '${target}'" >&2
            return 1
        fi
        target="${target#@}"
        search_session="${target%%:*}"
        target="${target#*:}"
        if [[ -z "$search_session" || -z "$target" ]]; then
            echo "Error: cross-session target must be @session:agent" >&2
            return 1
        fi
        # Verify session exists in tmux
        if ! tmux has-session -t "$search_session" 2>/dev/null; then
            echo "Error: session '${search_session}' not found" >&2
            return 1
        fi
    fi

    # 3. Resolve within session
    local resolved="" resolved_agent=""
    local alias_match="" alias_match_agent="" alias_count=0
    local bare_match="" bare_match_agent="" bare_count=0
    while IFS=$'\t' read -r pid aagent; do
        # Exact match on alias:name
        if [[ "$aagent" == "${target}" ]]; then
            resolved="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                resolved_agent="@${search_session}:${aagent}"
            else
                resolved_agent="$aagent"
            fi
            break
        fi
        # Alias-only match (e.g. "codex" matches "codex:coworker")
        local aalias="${aagent%%:*}"
        if [[ "$aalias" == "${target}" ]]; then
            alias_match="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                alias_match_agent="@${search_session}:${aagent}"
            else
                alias_match_agent="$aagent"
            fi
            alias_count=$((alias_count + 1))
        fi
        # Bare name match (e.g. "lead" matches "claude:lead")
        local aname="${aagent#*:}"
        if [[ "$aname" == "${target}" ]]; then
            bare_match="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                bare_match_agent="@${search_session}:${aagent}"
            else
                bare_match_agent="$aagent"
            fi
            bare_count=$((bare_count + 1))
        fi
    done < <(tmux list-panes -s -t "$search_session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)

    if [[ -z "$resolved" && "$alias_count" -eq 1 ]]; then
        resolved="$alias_match"
        resolved_agent="$alias_match_agent"
    fi

    if [[ -z "$resolved" && "$bare_count" -eq 1 ]]; then
        resolved="$bare_match"
        resolved_agent="$bare_match_agent"
    fi

    if [[ -z "$resolved" ]]; then
        if [[ "$alias_count" -gt 1 || "$bare_count" -gt 1 ]]; then
            echo "Error: ambiguous name '${target}' in session '${search_session}' — use alias:name format" >&2
        else
            echo "Error: agent '${target}' not found in session '${search_session}'" >&2
        fi
        return 1
    fi

    AE_RESOLVED_PANE="$resolved"
    AE_RESOLVED_AGENT="$resolved_agent"
    return 0
}

# Acquire per-target flock (shared between send and interrupt, globally across sessions)
ae_lock_target() {
    local pane="$1"
    local lockdir="${_AE_SESSIONS_DIR}/.locks"
    mkdir -p "$lockdir"
    local lockfile="${lockdir}/send-lock-${pane//[^a-zA-Z0-9]/_}"
    exec 9>"$lockfile"
    flock 9
}

ae_unlock_target() {
    exec 9>&-
}

ae_now_utc() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

ae_current_pane() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        printf '%s' "$TMUX_PANE"
    else
        tmux display-message -p '#{pane_id}' 2>/dev/null || true
    fi
}

ae_current_agent() {
    local pane
    pane="$(ae_current_pane)"
    [[ -n "$pane" ]] || return 0
    tmux display-message -p -t "$pane" '#{@ae_agent}' 2>/dev/null || true
}

ae_current_agent_ref() {
    local agent session pane
    agent="$(ae_current_agent)"
    [[ -n "$agent" ]] || return 0
    pane="$(ae_current_pane)"
    session="$(tmux display-message -p -t "${pane:-$_AE_SESSION}" '#S' 2>/dev/null || true)"
    if [[ -n "$session" && "$session" != "$_AE_SESSION" ]]; then
        printf '@%s:%s' "$session" "$agent"
    else
        printf '%s' "$agent"
    fi
}

ae_preview_text() {
    local text="$*"
    text="${text//$'\r'/}"
    text="${text//$'\n'/\\n}"
    text="${text//$'\t'/ }"
    printf '%.200s' "$text"
}

ae_extract_req_id() {
    local text="$1"
    if [[ "$text" =~ \[((ae|review)-[A-Za-z0-9._:-]+)\] ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
}

ae_log_append() {
    local file="$1" line="$2"
    {
        flock -w 5 8 || exit 1
        printf '%s\n' "$line" >>"$file"
    } 8>>"${file}.lock"
}

ae_log_read() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    {
        flock -s 8 || exit 1
        cat "$file"
    } 8<>"${file}.lock"
}

# Determine target tool type from pane metadata/process name.
# Returns: codex | claude | other
ae_target_tool() {
    local pane="$1" row agent cmd alias
    row="$(tmux list-panes -a -F '#{pane_id}|#{@ae_agent}|#{pane_current_command}' 2>/dev/null | awk -F'|' -v p="$pane" '$1==p {print; exit}')"
    [[ -z "$row" ]] && {
        echo "other"
        return 0
    }
    IFS='|' read -r _ agent cmd <<<"$row"
    alias="${agent%%:*}"
    if [[ "$alias" == "codex" || "$cmd" == "codex" ]]; then
        echo "codex"
    elif [[ "$alias" == "claude" || "$cmd" == "claude" ]]; then
        echo "claude"
    else
        echo "other"
    fi
}

ae_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/\\r}"
    printf '%s' "$s"
}

ae_emit_event() {
    local action="$1" target="${2:-}" ref="${3:-}" summary="${4:-}"
    local actor
    actor="${AE_SENDER_OVERRIDE:-$(ae_current_agent_ref)}"
    [[ -n "$actor" ]] || actor="human"
    local ts
    ts="$(date -u +%FT%TZ)"
    # Summary is capped and (for most events) flattened to one line. `chat`
    # events carry a human reply destined for Telegram, so they keep newlines
    # and get a larger cap (3500 — matches format_event's truncation, stays
    # under Telegram's 4096 limit). Either way ae_json_escape below turns any
    # newline into a literal \n, so events.jsonl stays one JSON object per line
    # — the invariant every line-oriented consumer (cmd_list, the watchdog
    # watchdog, the telegram tail) depends on.
    if [[ "$action" == "chat" ]]; then
        summary="$(printf '%s' "$summary" | head -c 3500)"
    else
        summary="$(printf '%s' "$summary" | head -c 200 | tr '\n\t' '  ')"
    fi
    local json
    json="$(printf '{"ts":"%s","actor":"%s","action":"%s"' \
        "$(ae_json_escape "$ts")" "$(ae_json_escape "$actor")" "$(ae_json_escape "$action")")"
    [[ -n "$target" ]] && json+="$(printf ',"target":"%s"' "$(ae_json_escape "$target")")"
    [[ -n "$ref" ]] && json+="$(printf ',"ref":"%s"' "$(ae_json_escape "$ref")")"
    [[ -n "$summary" ]] && json+="$(printf ',"summary":"%s"' "$(ae_json_escape "$summary")")"
    json+="}"
    ae_log_append "${_AE_META_DIR}/events.jsonl" "$json"
}

# Latest state declaration for an agent. Output: state<TAB>reason<TAB>ts (or empty).
# Scans events.jsonl backwards for newest event matching actor=<agent>; treats
# action=state events as authoritative and legacy action=done events as state=done
# so sessions that pre-date the state helper still read back consistently.
ae_latest_state_for() {
    local agent="$1"
    local events="${_AE_META_DIR}/events.jsonl"
    [[ -f "$events" ]] || return 0
    local line actor action st reason ts
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        actor="$(_event_json_str "$line" actor)"
        [[ "$actor" == "$agent" ]] || continue
        action="$(_event_json_str "$line" action)"
        case "$action" in
            state)
                st="$(_event_json_str "$line" ref)"
                reason="$(_event_json_str "$line" summary)"
                ts="$(_event_json_str "$line" ts)"
                printf '%s\t%s\t%s\n' "$st" "$reason" "$ts"
                return 0
                ;;
            done)
                reason="$(_event_json_str "$line" summary)"
                ts="$(_event_json_str "$line" ts)"
                printf '%s\t%s\t%s\n' "done" "$reason" "$ts"
                return 0
                ;;
        esac
    done < <(tac "$events" 2>/dev/null || true)
}

# Extract a flat-JSON string value (counterpart to ae_json_escape). Handles
# \" \\ \n \t \r escapes; maps \n and \t to a space for line-oriented use.
_event_json_str() {
    local line="$1" key="$2"
    local prefix="\"${key}\":\""
    local rest="${line#*"${prefix}"}"
    [[ "$rest" == "$line" ]] && return
    local result="" i=0 n=${#rest}
    local c next
    while ((i < n)); do
        c="${rest:$i:1}"
        if [[ "$c" == "\\" ]]; then
            next="${rest:$((i + 1)):1}"
            case "$next" in
                n) result+=" " ;;
                t) result+=" " ;;
                r) ;;
                '"') result+='"' ;;
                "\\") result+="\\" ;;
                *) result+="$c$next" ;;
            esac
            i=$((i + 2))
        elif [[ "$c" == '"' ]]; then
            break
        else
            result+="$c"
            i=$((i + 1))
        fi
    done
    printf '%s' "$result"
}

# Generate a request id like "<prefix>-YYYYMMDDTHHMMSSZ-<rand>"
ae_make_req_id() {
    local prefix="${1:-ae}"
    local req_suffix
    req_suffix="$(cat /proc/sys/kernel/random/uuid 2>/dev/null | cut -d- -f1 || true)"
    [[ -n "$req_suffix" ]] || req_suffix="$$-$RANDOM"
    printf '%s-%s-%s' "$prefix" "$(date -u +%Y%m%dT%H%M%SZ)" "$req_suffix"
}

# Shared body for ask/review. Resolves target, generates req_id, builds the
# message (with optional instructions block + uniform reply contract footer),
# and execs into send with the appropriate _AE_EVENT_* env vars set.
# Args: action req_prefix header instructions reply_label target body...
ae_tracked_send() {
    local action="$1" req_prefix="$2" header="$3" instructions="$4" reply_label="$5" target_name="$6"
    shift 6
    local body="$*"
    # External actors (chat bridges, webhooks) identify themselves via
    # AE_SENDER_OVERRIDE — they have no @ae_agent pane to detect. Respect
    # the override before falling back to pane-based detection.
    local self
    self="${AE_SENDER_OVERRIDE:-$(ae_current_agent_ref)}"
    if [[ -z "$self" ]]; then
        echo "Warning: could not detect caller identity (no @ae_agent on this pane). Using 'send' instead." >&2
        exec "${_AE_META_DIR}/send" "$target_name" "$body"
    fi
    # External-actor targets (telegram:*, discord:*) are event-only sinks
    # consumed by a bridge daemon; the send helper handles the no-pane case.
    # Skip ae_resolve so the literal target name is preserved end-to-end.
    if [[ "$target_name" != telegram:* && "$target_name" != discord:* ]]; then
        ae_resolve "$target_name" || exit 1
        target_name="${AE_RESOLVED_AGENT:-$target_name}"
    fi

    local req_id
    req_id="$(ae_make_req_id "$req_prefix")"
    local reply_cmd="${_AE_META_DIR}/reply --as \"${target_name}\" \"${req_id}\" \"${reply_label}\""

    local msg="${header} ${req_id} from ${self}: ${body}"
    [[ -n "$instructions" ]] && msg+=$'\n\n'"${instructions}"
    msg+=$'\n\n'"REQUIRED: When you have finished, you MUST run this exact command to reply:
${reply_cmd}
Do not reply any other way. Do NOT use peek/peak as a reply mechanism."

    exec env _AE_EVENT_ACTION="$action" _AE_EVENT_REF="$req_id" _AE_EVENT_SUMMARY="$body" \
        "${_AE_META_DIR}/send" "$target_name" "$msg"
}

# Look up the original ask/review event for a given req_id. Scans events.jsonl
# newest-first; returns the first matching ask|review event.
# Output: TAB-separated "<kind>\t<sender>\t<target>". Return 1 if not found.
ae_find_request() {
    local req_id="$1"
    local events_file="${_AE_META_DIR}/events.jsonl"
    [[ -f "$events_file" ]] || return 1
    local line ref action actor target
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        ref="$(_event_json_str "$line" ref)"
        [[ "$ref" == "$req_id" ]] || continue
        action="$(_event_json_str "$line" action)"
        if [[ "$action" == "ask" || "$action" == "review" ]]; then
            actor="$(_event_json_str "$line" actor)"
            target="$(_event_json_str "$line" target)"
            printf '%s\t%s\t%s\n' "$action" "$actor" "$target"
            return 0
        fi
    done < <(tac "$events_file" 2>/dev/null || true)
    return 1
}

ae_submit_pasted_message() {
    local pane="$1" tool="$2" buf="$3" msg="$4"
    if [[ "$tool" == "codex" ]]; then
        tmux set-buffer -b "$buf" -- "$msg" \; \
            paste-buffer -d -p -b "$buf" -t "$pane"
        sleep 0.1
        tmux send-keys -t "$pane" Enter
        return 0
    fi

    tmux set-buffer -b "$buf" -- "$msg" \; \
        paste-buffer -d -b "$buf" -t "$pane"
    sleep 0.1
    tmux send-keys -t "$pane" Enter

    # Claude sometimes stages large pastes as a "[Pasted text #…]" token
    # that requires an extra submit keystroke.
    if [[ "$tool" == "claude" ]]; then
        sleep 0.2
        if tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n 8 | grep -Eq '\[Pasted text #[0-9]+ \+[0-9]+ lines\]'; then
            tmux send-keys -t "$pane" Enter
        fi
    fi
}
LIBEOF
    chmod 0700 "${AE_META}/_lib"

