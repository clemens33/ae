# say:
helper_say_usage() {
    cat >&2 <<'USAGE'
Usage: say <text>          # push a free-text line to the Telegram chat
       echo "text" | say   # multi-line / long replies via stdin

Emits a `chat` event the telegram bridge forwards. Requires the bridge running
with `chat` in its [telegram] include filter (see `ae telegram status`).
USAGE
    exit 2
}

helper_say_main() {
    if [[ $# -gt 0 ]]; then
        text="$*"
    elif [[ ! -t 0 ]]; then
        text="$(cat)"
    else
        helper_say_usage
    fi

    # Reject empty / whitespace-only payloads — nothing to forward.
    if [[ -z "${text//[$' \t\n\r']/}" ]]; then
        helper_say_usage
    fi

    ae_emit_event "chat" "" "" "$text"
    printf 'Sent to Telegram bridge (chat): %.60s%s\n' "$text" "$([[ ${#text} -gt 60 ]] && printf '…')"
}

