# peek:
helper_peek_main() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: peek <agent-name|pane-id|@session:agent> [lines]" >&2
        echo "  Examples: peek codex:reviewer" >&2
        echo "           peek @my-feature:claude:lead 50" >&2
        exit 1
    fi
    ae_resolve "$1" || exit 1
    target="$AE_RESOLVED_PANE"
    lines="${2:-80}"

    if ! [[ "$lines" =~ ^[0-9]+$ ]]; then
        echo "Error: lines must be a number, got '$lines'" >&2
        exit 1
    fi
    ((lines > 2000)) && lines=2000
    ((lines < 1)) && lines=1

    tmux capture-pane -p -J -S "-${lines}" -E - -t "$target"
}

# agents:
helper_agents_main() {
    if [[ "${1:-}" == "--all" ]]; then
        printf "%-20s %-25s %-8s %s\n" "SESSION" "AGENT" "PANE" "PROCESS"
        for meta_file in "$_AE_SESSIONS_DIR"/*/meta; do
            [[ -f "$meta_file" ]] || continue
            sess="$(grep '^session=' "$meta_file" | cut -d= -f2-)"
            [[ -z "$sess" ]] && continue
            tmux has-session -t "$sess" 2>/dev/null || continue
            while IFS='|' read -r pid aagent cmd; do
                [[ -z "$aagent" ]] && continue
                printf "%-20s %-25s %-8s %s\n" "$sess" "$aagent" "$pid" "$cmd"
            done < <(tmux list-panes -s -t "$sess" -F '#{pane_id}|#{@ae_agent}|#{pane_current_command}' 2>/dev/null)
        done
    else
        printf "%-25s %-8s %s\n" "AGENT" "PANE" "PROCESS"
        while IFS='|' read -r pid aagent cmd; do
            [[ -z "$aagent" ]] && continue
            printf "%-25s %-8s %s\n" "$aagent" "$pid" "$cmd"
        done < <(tmux list-panes -s -t "$_AE_SESSION" -F '#{pane_id}|#{@ae_agent}|#{pane_current_command}' 2>/dev/null)
    fi
}

