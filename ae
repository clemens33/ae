#!/usr/bin/env bash
set -uo pipefail
source "$(cd "$(dirname "$0")" && pwd)/_lib"
META_DIR="$(cd "$(dirname "$0")" && pwd)"

INTERVAL="${AE_LOOP_INTERVAL_SEC:-60}"
STALE_MIN="${AE_LOOP_STALE_MIN:-15}"
MAX_NUDGES="${AE_LOOP_MAX_NUDGES:-2}"
STALE_SECS=$((STALE_MIN * 60))

PIDFILE="${META_DIR}/.loop.pid"

_loop_is_running() {
    [[ -f "$PIDFILE" ]] || return 1
    local pid; pid="$(cat "$PIDFILE" 2>/dev/null)"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

_set_meta_kv() {
    local key="$1" value="$2"
    local meta_file="${META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 0
    {
        flock -w 5 200 || return 1
        local tmp="${META_DIR}/meta.tmp.$$"
        awk -F= -v k="$key" -v v="$value" '
            BEGIN { updated = 0 }
            $1 == k { print k "=" v; updated = 1; next }
            { print }
            END { if (!updated) print k "=" v }
        ' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${META_DIR}/meta.lock"
}

_unset_meta_kv() {
    local key="$1"
    local meta_file="${META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 0
    {
        flock -w 5 200 || return 1
        local tmp="${META_DIR}/meta.tmp.$$"
        awk -F= -v k="$key" '$1 != k { print }' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${META_DIR}/meta.lock"
}

_set_meta_loop() { _set_meta_kv "loop" "$1"; }

_loop_stop() {
    if _loop_is_running; then
        local pid; pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null || true
        rm -f "$PIDFILE" "${META_DIR}/.loop.status"
        # Kill the loop window if it exists
        tmux kill-window -t "${_AE_SESSION}:ae-monitor" 2>/dev/null || true
        # Restore status-right based on what we recorded at start time.
        # If was_session=true, the saved value was an explicit session override
        # and must be restored. If was_session=false, the session inherited the
        # global value at the time, so we unset our override and let the session
        # fall back to whatever the global is *now* (which may have changed).
        local prev was_session
        prev="$(grep '^status_right_prev=' "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
        was_session="$(grep '^status_right_was_session=' "$META_DIR/meta" 2>/dev/null | cut -d= -f2- || true)"
        if [[ "$was_session" == "true" ]]; then
            tmux set-option -t "$_AE_SESSION" status-right "$prev" 2>/dev/null || true
        else
            tmux set-option -u -t "$_AE_SESSION" status-right 2>/dev/null || true
        fi
        tmux set-option -u -t "$_AE_SESSION" status-interval 2>/dev/null || true
        _unset_meta_kv "status_right_prev"
        _unset_meta_kv "status_right_was_session"
        echo "Loop stopped."
    else
        echo "Loop is not running."
    fi
    _set_meta_loop "false"
    exit 0
}

_loop_status() {
    if _loop_is_running; then
        echo "Loop is running (pid $(cat "$PIDFILE"))."
    else
        echo "Loop is not running."
    fi
    exit 0
}

_loop_start() {
    if _loop_is_running; then
        echo "Loop is already running (pid $(cat "$PIDFILE"))."
        _set_meta_loop "true"
        exit 0
    fi
    # Create hidden ae-monitor window with the loop watchdog in the top pane.
    # -a appends after the current window so it doesn't collide with index 0.
    local loop_pane events_pane
    loop_pane="$(tmux new-window -da -t "$_AE_SESSION" -n "ae-monitor" -P -F '#{pane_id}' \
        "${META_DIR}/loop _run" 2>/dev/null)" || {
        echo "Error: could not create monitor window" >&2
        exit 1
    }
    # Split horizontally and run events-tail in the bottom pane.
    events_pane="$(tmux split-window -v -t "$loop_pane" -P -F '#{pane_id}' \
        "${META_DIR}/events-tail" 2>/dev/null || true)"
    # Tag panes for peek/discoverability and label their borders
    tmux set-option -p -t "$loop_pane" @ae_agent "_loop" 2>/dev/null || true
    tmux set-option -p -t "$loop_pane" @ae_pane_label " ae loop  │  watchdog cycle log " 2>/dev/null || true
    if [[ -n "$events_pane" ]]; then
        tmux set-option -p -t "$events_pane" @ae_agent "_events" 2>/dev/null || true
        tmux set-option -p -t "$events_pane" @ae_pane_label " ae events  │  time      action   actor                  → target                 summary " 2>/dev/null || true
    fi
    # Sticky column headers via tmux pane borders (window-level option)
    tmux set-window-option -t "${_AE_SESSION}:ae-monitor" pane-border-status top 2>/dev/null || true
    tmux set-window-option -t "${_AE_SESSION}:ae-monitor" pane-border-format "#{@ae_pane_label}" 2>/dev/null || true
    # Read-only: disable input on both panes
    tmux select-pane -t "$loop_pane" -d 2>/dev/null || true
    [[ -n "$events_pane" ]] && tmux select-pane -t "$events_pane" -d 2>/dev/null || true
    # Capture the current effective status-right and track whether it came from a
    # session-level override or the global default. We must distinguish those so
    # _loop_stop can restore correctly even if the global value changes mid-loop.
    local prev_status_right was_session
    prev_status_right="$(tmux show-options -v -t "$_AE_SESSION" status-right 2>/dev/null || true)"
    if [[ -n "$prev_status_right" ]]; then
        was_session="true"
    else
        prev_status_right="$(tmux show-options -gv status-right 2>/dev/null || true)"
        was_session="false"
    fi
    # Persist alongside meta via the locked helper to avoid clobbering concurrent writers
    _set_meta_kv "status_right_prev" "$prev_status_right"
    _set_meta_kv "status_right_was_session" "$was_session"
    # Prepend the loop indicator to the existing status-right (refreshed each status-interval)
    local new_status_right="#(cat ${META_DIR}/.loop.status 2>/dev/null) ${prev_status_right}"
    tmux set-option -t "$_AE_SESSION" status-right "$new_status_right" 2>/dev/null || true
    tmux set-option -t "$_AE_SESSION" status-interval 5 2>/dev/null || true
    _set_meta_loop "true"
    echo "Loop started in hidden ae-monitor window. Use 'peek _loop' or 'peek _events' to inspect."
    exit 0
}

_last_event_age() {
    local actor="$1"
    local events_file="${META_DIR}/events.jsonl"
    [[ -f "$events_file" ]] || { echo 999999; return; }
    local last_ts
    last_ts="$(grep "\"actor\":\"${actor}\"" "$events_file" | tail -1 | sed -n 's/.*"ts":"\([^"]*\)".*/\1/p')"
    if [[ -z "$last_ts" ]]; then echo 999999; return; fi
    local last_epoch now_epoch
    last_epoch="$(date -d "$last_ts" +%s 2>/dev/null || echo 0)"
    now_epoch="$(date +%s)"
    echo $(( now_epoch - last_epoch ))
}

