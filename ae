# `ae _spawn <meta-dir> <name> --using <profile> [--] [prompt]` — the entry the
# session's `spawn` helper execs. B move 2 made the whole operation the core's:
# the argv grammar and its usage line, the name allowlist, the profile lookup,
# the seat reserved in meta BEFORE the pane exists, the window, the pane stamps,
# the manifest, the launch script, the readiness-gated brief, the rollback on
# every failure after the seat, the ownership-guarded kill, and the spawn /
# spawn-failed events.
#
# ONE duty stays here, and it is why this is not a bare exec: the post-launch
# session-id CAPTURE for the tools with no launch-time id flag (codex, opencode,
# gemini). That capture is a detached poll which OUTLIVES the command — minutes
# of sleeping and scanning the tool's own history directory — so it cannot live
# inside a core process the caller waits on. The core has already written
# `launch_id.<slot>` and `launch_time.<slot>`; this fork only watches for the id
# and writes it back through the roster. It runs ONLY after a success, because a
# rolled-back spawn has no seat to write to.
_cmd_spawn() {
    local meta_dir="$1" name rc=0
    shift
    name="${1:-}"
    META_DIR="$meta_dir" _ae_core_try --capture _spawn "$@" || rc=$?
    ((rc == 0)) || return "$rc"
    _spawn_capture_after "$meta_dir" "$name"
    return 0
}

# Fork the post-launch session-id capture for the seat `_spawn` just created.
#
# The SLOT is read back from meta rather than guessed: the core owns seat
# allocation, and `seat.spawned.<n>=<name>` is where it records which index it
# took — deriving one here would be a second allocator, disagreeing the first
# time two spawns race. The pane is found by its `@ae_slot` stamp for the same
# reason, and the tool kind from the seat's own `agent_bin.<slot>`.
#
# Nothing here is fatal. A capture that cannot start costs an exact `--resume`
# on the next cycle (the tool falls back to its CWD heuristic), never the spawn
# that has already succeeded — so every probe degrades to a quiet return.
_spawn_capture_after() {
    local meta_dir="$1" name="$2" meta="$1/meta"
    local slot="" _sl bin="" kind="" session="" pane=""
    [[ -n "$name" && -f "$meta" ]] || return 0
    # The name is allowlisted (^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$), so it carries no
    # regex metacharacter; the slot does — escape its dot before it is one.
    slot="$(sed -n "s/^seat\\.\\(spawned\\.[0-9][0-9]*\\)=${name}$/\\1/p" "$meta" | head -1 || true)"
    [[ -n "$slot" ]] || return 0
    _sl="${slot//./\\.}"
    bin="$(sed -n "s/^agent_bin\\.${_sl}=//p" "$meta" | head -1 || true)"
    [[ -n "$bin" ]] || return 0
    kind="$(tool_kind_from_cmd "$bin")"
    tool_kind_supports_launch_id "$kind" || return 0
    session="$(sed -n 's/^session=//p' "$meta" | head -1 || true)"
    [[ -n "$session" ]] || return 0
    pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@ae_slot}' 2>/dev/null |
        awk -v s="$slot" '$2 == s { print $1; exit }' || true)"
    [[ -n "$pane" ]] || return 0
    capture_session_id "$kind" "$pane" "$slot" "$meta_dir" &
    return 0
}

# `ae _retire <meta-dir> <name|%pane>` — the entry the session's `retire` helper
# execs. Wholly the core's since B move 2: exact name or `%pane` resolution, the
# refusal that protects the main/worker seats, the meta strip under meta.lock,
# the launch artifacts, the ownership-guarded kill, the manifest and the retire
# event. Nothing follows it here, so the shim EXECs.
_cmd_retire() {
    local meta_dir="$1"
    shift
    META_DIR="$meta_dir" _ae_core_try _retire "$@"
}

# Regenerate workspace.md from live tmux pane state.
#
# A.2c: the DOCUMENT is the core's — it reads the session's meta, lists the panes
# through the typed tmux transport, and writes `<dir>/workspace.md` itself, so the
# manifest and the seat context can no longer describe one session two ways. The
# glue passes the six facts it already holds plus the two config files, for the
# same reason build_ae_context does: the core does not read the environment.
regenerate_manifest() {
    local sess="$1" wdir="$2" origin="$3" mode="$4" main_pane="$5" sessions_dir="$6"
    local -a cfg=()
    [[ -n "${CONFIG_FILE:-}" && -f "${CONFIG_FILE:-}" ]] && cfg+=(--global "$CONFIG_FILE")
    [[ -n "${AE_LOCAL_CONFIG:-}" && -f "${AE_LOCAL_CONFIG:-}" ]] && cfg+=(--local "$AE_LOCAL_CONFIG")
    _ae_core_preflight_try _manifest-render "$sessions_dir" "$sess" "$wdir" "$origin" "$mode" \
        "$main_pane" ${cfg[@]+"${cfg[@]}"}
}

# --- ae orchestrator: meta-agent launcher (deprecated alias: ae hub) ---
# Copy one template file to its destination, NO overwrite, substituting a single
# __PLACEHOLDER__ via bash param expansion (no sed → safe with '/' in the value).
# Reports created vs skipped per file so partial dirs are handled explicitly.
_orchestrator_scaffold_file() {
    local src="$1" dst="$2" content
    shift 2 # remaining args are placeholder/value pairs
    if [[ -e "$dst" ]]; then
        echo "  skipped (exists): $dst"
        return 0
    fi
    content="$(cat "$src" 2>/dev/null)" || {
        echo "  ERROR reading template $src" >&2
        return 1
    }
    # Two-phase substitution so an inserted VALUE is never rescanned by a later
    # placeholder (codex: sequential ${//} reprocesses inserted text). Phase 1
    # maps every placeholder to a unique SOH-delimited sentinel (no values yet);
    # phase 2 maps sentinels to values. A real path value can't contain a \x01, so
    # phase-2 insertions can never collide — making it order-independent.
    local -a _ph _val
    local _n=0 soh=$'\x01'
    while (($# >= 2)); do
        _ph[_n]="$1"
        _val[_n]="$2"
        _n=$((_n + 1))
        shift 2
    done
    local _i
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${_ph[_i]}/${soh}${_i}${soh}}"
    done
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${soh}${_i}${soh}/${_val[_i]}}"
    done
    printf '%s\n' "$content" >"$dst" || {
        echo "  ERROR writing $dst" >&2
        return 1
    }
    echo "  created: $dst"
}

# Scaffold ~/.ae/orchestrator/{orchestrator.config,CHARTER.md} from contrib/aeorchestrator
# templates. Always scaffolds the NEW orchestrator layout; an existing legacy
# ~/.ae/meta-hub scaffold keeps working via the launch-time fallback below.
cmd_orchestrator_init() {
    local orchestrator_dir="${AE_ORCHESTRATOR_DIR:-$CONFIG_DIR/orchestrator}"
    # Reject a dir that would break the INI double-quoted instructions value.
    case "$orchestrator_dir" in
        *'"'* | *$'\n'*)
            echo "Error: AE_ORCHESTRATOR_DIR contains an unsupported character (quote/newline): $orchestrator_dir" >&2
            return 1
            ;;
    esac
    # Resolve template dir relative to THIS script (symlink-aware) with a
    # realpath/echo fallback — never hard-depend on readlink being present.
    local self tdir aemon_path charter_path helpers_dir
    self="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        echo "${BASH_SOURCE[0]:-$0}")"
    tdir="$(dirname "$self")/contrib/aeorchestrator"
    if [[ ! -d "$tdir" ]]; then
        echo "Error: orchestrator templates not found at $tdir." >&2
        echo "(single-file install?) Create $orchestrator_dir/orchestrator.config + CHARTER.md by hand." >&2
        return 1
    fi
    mkdir -p "$orchestrator_dir" || return 1
    # Canonicalize to an ABSOLUTE dir so a relative AE_ORCHESTRATOR_DIR doesn't bake a
    # relative charter path into orchestrator.config — `ae orchestrator` later cd's into the
    # dir, so `rel/CHARTER.md` would wrongly resolve to `rel/rel/CHARTER.md`.
    orchestrator_dir="$(cd "$orchestrator_dir" && pwd -P)" || return 1
    charter_path="$orchestrator_dir/CHARTER.md"
    aemon_path="$(dirname "$self")/contrib/aemonitor/aemonitor"
    # The orchestrator session is always named `orchestrator`; its helper scripts live here.
    # Baked into the charter so it's correct under any AE_HOME (default
    # ~/.ae/sessions/orchestrator, isolated e2e runs $AE_HOME/sessions/orchestrator) — never
    # the wrong (live) ~/.ae.
    helpers_dir="$CONFIG_DIR/sessions/orchestrator"
    echo "Scaffolding orchestrator into $orchestrator_dir:"
    # CHARTER.md first (the config points at it).
    _orchestrator_scaffold_file "$tdir/CHARTER.md" "$charter_path" \
        "__AEMONITOR_PATH__" "$aemon_path" "__HELPERS_DIR__" "$helpers_dir" || return 1
    _orchestrator_scaffold_file "$tdir/orchestrator.config" "$orchestrator_dir/orchestrator.config" "__CHARTER_PATH__" "$charter_path" || return 1
    echo
    echo "Done. Review/edit those files, then run: ae orchestrator"
}

cmd_orchestrator_help() {
    cat <<'EOF'
ae orchestrator — launch the orchestrator: your fleet's chief of staff. One ae session that
monitors all your other ae sessions, briefs you, relays your instructions to them,
and helps you hold an objective once you set one. `ae hub` is the deprecated alias.

  ae orchestrator           ensure the session is running (detached, isolated config)
  ae orchestrator --attach  switch/attach to it
  ae orchestrator --init    scaffold ~/.ae/orchestrator/{orchestrator.config,CHARTER.md} (never overwrites)
  ae orchestrator --help    this help

Config dir: ~/.ae/orchestrator (or $AE_HOME/orchestrator when AE_HOME is set; override with
AE_ORCHESTRATOR_DIR). A legacy ~/.ae/meta-hub scaffold (from 'ae hub --init') is still
honoured at launch and keeps its `hub` session name. See contrib/aeorchestrator/README.md.
EOF
}

# --- Dispatcher ---
# ── Session-helper template library ──────────────────────────────────
# Functions below are EMITTED into generated session helpers (_lib and
# the declare-f migrated helpers) via `declare -f` at the emission sites
# inside the SYNC_SESSION_ASSETS_BODY region. They are defined at top
# level BEFORE the dispatcher so every execution path — launch, and
# dispatcher subcommands like doctor --refresh (which awk-sources that
# region) — has them loaded prior to any emission. They execute inside a
# generated helper's runtime (after `source _lib`, which provides
# _AE_META_DIR/_AE_SESSION/_AE_SESSIONS_DIR): ae's own code paths must
# not call them. Shared bodies ae itself also uses (ae_json_escape,
# _event_json_str) live at their long-standing top-level sites instead.

ae_current_pane() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        printf '%s' "$TMUX_PANE"
    else
        tmux display-message -p '#{pane_id}' 2>/dev/null || true
    fi
}

ae_current_agent() {
    local pane
    pane="$(ae_current_pane)"
    [[ -n "$pane" ]] || return 0
    tmux display-message -p -t "$pane" '#{@ae_agent}' 2>/dev/null || true
}

ae_current_agent_ref() {
    local agent session pane
    agent="$(ae_current_agent)"
    [[ -n "$agent" ]] || return 0
    pane="$(ae_current_pane)"
    session="$(tmux display-message -p -t "${pane:-$_AE_SESSION}" '#S' 2>/dev/null || true)"
    if [[ -n "$session" && "$session" != "$_AE_SESSION" ]]; then
        printf '@%s:%s' "$session" "$agent"
    else
        printf '%s' "$agent"
    fi
}

ae_log_append() {
    local file="$1" line="$2"
    {
        flock -w 5 8 || exit 1
        printf '%s\n' "$line" >>"$file"
    } 8>>"${file}.lock"
}

ae_emit_event() {
    local action="$1" target="${2:-}" ref="${3:-}" summary="${4:-}"
    local actor
    actor="${AE_SENDER_OVERRIDE:-$(ae_current_agent_ref)}"
    [[ -n "$actor" ]] || actor="human"
    local ts
    ts="$(date -u +%FT%TZ)"
    # Summary is capped and (for most events) flattened to one line. `chat`
    # events carry a human reply destined for Telegram, so they keep newlines
    # and get a larger cap (3500 — matches format_event's truncation, stays
    # under Telegram's 4096 limit). Either way ae_json_escape below turns any
    # newline into a literal \n, so events.jsonl stays one JSON object per line
    # — the invariant every line-oriented consumer (cmd_list, the watchdog
    # watchdog, the telegram tail) depends on.
    # Sanitising boundary: drop malformed UTF-8 before anything downstream sees
    # it. Agent/user text can arrive already invalid — truncation is not the only
    # way a bad byte reaches events.jsonl.
    ae_sanitize_utf8 "$summary"
    summary="$_EV_CLEAN"
    if [[ "$action" == "chat" ]]; then
        # chat KEEPS its newlines and tabs — it is a human reply bound for
        # Telegram, and ae_json_escape turns them into literal \n / \t further
        # down, so the one-object-per-line invariant still holds. Capping is
        # therefore the only transformation here.
        ae_cap_summary "$summary" 3500
        summary="$_EV_SUMMARY"
    else
        # Flatten first, then cap. Both substitutions are one character for
        # one, so the cut point is identical either way.
        summary="${summary//$'\n'/ }"
        summary="${summary//$'\t'/ }"
        ae_cap_summary "$summary" 200
        summary="$_EV_SUMMARY"
    fi
    local json
    json="$(printf '{"ts":"%s","actor":"%s","action":"%s"' \
        "$(ae_json_escape "$ts")" "$(ae_json_escape "$actor")" "$(ae_json_escape "$action")")"
    [[ -n "$target" ]] && json+="$(printf ',"target":"%s"' "$(ae_json_escape "$target")")"
    [[ -n "$ref" ]] && json+="$(printf ',"ref":"%s"' "$(ae_json_escape "$ref")")"
    # request-integrity: session-qualified SLOT identity (the churn-proof routing key).
    [[ -n "${_AE_EVENT_ACTOR_SLOT:-}" ]] && json+="$(printf ',"actor_slot":"%s"' "$(ae_json_escape "$_AE_EVENT_ACTOR_SLOT")")"
    [[ -n "${_AE_EVENT_ACTOR_SESSION:-}" ]] && json+="$(printf ',"actor_session":"%s"' "$(ae_json_escape "$_AE_EVENT_ACTOR_SESSION")")"
    [[ -n "${_AE_EVENT_TARGET_SLOT:-}" ]] && json+="$(printf ',"target_slot":"%s"' "$(ae_json_escape "$_AE_EVENT_TARGET_SLOT")")"
    [[ -n "${_AE_EVENT_TARGET_SESSION:-}" ]] && json+="$(printf ',"target_session":"%s"' "$(ae_json_escape "$_AE_EVENT_TARGET_SESSION")")"
    [[ -n "$summary" ]] && json+="$(printf ',"summary":"%s"' "$(ae_json_escape "$summary")")"
    # The summary is capped; this is where the whole thing lives.
    [[ -n "${_AE_LAST_BODY_FILE:-}" ]] && json+="$(printf ',"body_file":"%s"' "$(ae_json_escape "$_AE_LAST_BODY_FILE")")"
    json+="}"
    ae_log_append "${_AE_META_DIR}/events.jsonl" "$json"
}

# --- session meta key/value (locked) -------------------------------------
# Shared read/write for keys in this session's meta file. Writes serialize on
# meta.lock (same lock the watchdog's meta writer uses) so concurrent helpers
# can't clobber each other; last-write-wins per key. Values are single-line.

# — session-helper template functions (send/ask/review/reply/requests/say/
#   memo/goal/peek/agents/focus/interrupt/spawn/retire/_register-sid/
#   events-tail; each emitted into its generated helper, main fn last) —

# Hand this invocation to the pinned Rust core. THE CORE IS REQUIRED.
#
# Every subcommand routed through here is core-owned: the bash bodies that once
# stood behind them are gone (slice A.1), so there is nothing to fall back TO.
# A session whose core is unbound, missing, or not the pinned version therefore
# REFUSES the command — one line on stderr, exit 2 — instead of quietly doing a
# second, divergent thing. Exit 2 is the usage-error code, kept distinct from 1
# so a caller can tell "this installation cannot serve that" from "it went
# wrong". The version is re-checked at RUN time against the pin because the
# binary at that path can be replaced under a long-lived session, and running a
# core that is not the pinned one is exactly the silent-drift failure the pair
# exists to prevent.
_ae_core_try() { # [--capture] <subcommand> [args...]
    # --capture: RUN the core as a subprocess and return its exit code, instead
    # of exec-replacing this process. For a core call that is a STEP inside a
    # larger bash flow (the archive publish inside `ae end`), which must read the
    # core's stdout and carry on. Without it the function EXECs and never
    # returns. Either way a missing core exits — in a command substitution that
    # is the substitution's own exit, so the caller reads 2 and fails.
    local capture=0
    while [[ "${1:-}" == --* ]]; do
        case "$1" in
            --capture)
                capture=1
                shift
                ;;
            *) break ;;
        esac
    done
    local sub="$1"
    shift
    local bin ver actual reason=""
    bin="$(grep '^ae_core=' "${META_DIR}/meta" 2>/dev/null | cut -d= -f2- || true)"
    ver="$(grep '^ae_core_version=' "${META_DIR}/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [[ -z "$bin" ]]; then
        reason="this session has no core bound"
    elif [[ -z "$ver" ]]; then
        # A path with no version is the shape _ae_core_bind publishes for operator
        # input it could not use.
        reason="the configured core could not be bound when this session was created or refreshed: ${bin}"
    elif [[ ! -x "$bin" ]]; then
        reason="the configured core is missing or not executable: ${bin}"
    else
        actual="$("$bin" --version 2>/dev/null | head -1 || true)"
        actual="${actual##* }"
        [[ "$actual" == "$ver" ]] ||
            reason="core version mismatch: this session pins ${ver}, ${bin} reports ${actual:-nothing}"
    fi
    if [[ -n "$reason" ]]; then
        printf "ae: the ae core is required for '%s' — %s\n" "$sub" "$reason" >&2
        exit 2
    fi
    # TMUX_PANE and the rest of the environment pass through untouched: the core
    # derives the acting agent from the pane it was invoked in.
    if ((capture)); then
        # Capture the core's own exit code explicitly — a bare call would let
        # errexit abort this function on a non-zero core before `return` runs.
        local crc=0
        "$bin" "$sub" "$META_DIR" "$@" || crc=$?
        return "$crc"
    fi
    exec "$bin" "$sub" "$META_DIR" "$@"
}

# A core call made BEFORE any session exists — the `--from` preflight runs ahead
# of the first mkdir, so there is no per-session pin (${META_DIR}/meta) for
# _ae_core_try to route through. This resolves the OPERATOR's core input directly
# (the same AE_CORE_BIN / workspace.core source _ae_core_bind pins at launch, so
# the preflight uses exactly the binary the about-to-be-created session will bind)
# and runs it as a subprocess, returning its stdout on the caller's captured pipe
# and its exit code. There is no version PIN to check against here — the operator
# config IS the authority for a session that does not exist yet — only that the
# resolved path is an executable that reports a version, the same usability test
# _ae_core_bind applies. THE CORE IS REQUIRED here too: no usable core exits 2
# with one line, exactly like _ae_core_try; the core's own 0/1/2 otherwise.
# --- Identity v2: the core owns every roster row (P34) ---------------------------
# The glue never writes a seat, profile or harness-session row. It asks the core and
# consumes US-framed records: \x1f-separated fields, one record per line, free text
# LAST, then a trailer `end<US><count>` (an empty field survives \x1f where it would
# vanish under tab-IFS — see the TSV note in AGENTS.md). There is no bash fallback for
# a roster write, by design — a missing core refuses (the shims exit 2). Roster records (`_launch-plan`, `_roster list`) are always EIGHT
# fields — kind slot name profile binary tool sid command — with `-` for absent.
_IDENT_US=$'\x1f'
# _identity_core <preflight|session> <sub> [args...] → the core's records on stdout,
# rc 0, only after its rc and its trailer agreed with what was received; rc 1 otherwise
# (the core's own stderr has already said why). `session` needs META_DIR (the bound
# core of an existing session) and _ae_core_try passes that dir as the subcommand's
# FIRST argument itself — so a session-mode caller writes `_roster add-seat …`, never
# `_roster "$dir" add-seat …`; `preflight` runs before or outside any session binding
# and the caller passes the dir explicitly.
_identity_core() {
    local mode="$1" sub="$2"
    shift 2
    local out rc=0
    # The shims refuse a missing core themselves (one line, exit 2). Inside these
    # command substitutions that exit is the SUBSHELL's, so it lands here as a
    # non-zero rc with the reason already on stderr.
    if [[ "$mode" == preflight ]]; then
        out="$(_ae_core_preflight_try "$sub" "$@")" || rc=$?
    else
        out="$(_ae_core_try --capture "$sub" "$@")" || rc=$?
    fi
    ((rc == 0)) || return 1
    # Producer-status: rc first (above), then the trailer against the records received.
    local last body="" n=0 count
    last="${out##*$'\n'}"
    if [[ "$last" != "end${_IDENT_US}"* ]]; then
        echo "Error: core '${sub}' output carries no trailer — refusing to consume it." >&2
        return 1
    fi
    count="${last#end${_IDENT_US}}"
    [[ "$out" == *$'\n'* ]] && body="${out%$'\n'*}"
    [[ -n "$body" ]] && n="$(printf '%s\n' "$body" | grep -c '')"
    if [[ "$n" != "$count" ]]; then
        echo "Error: core '${sub}' trailer says ${count} records, received ${n}." >&2
        return 1
    fi
    [[ -n "$body" ]] && printf '%s\n' "$body"
    return 0
}

_ae_core_preflight_try() { # [--exec] <subcommand> [args...]
    # --exec: EXEC the core instead of running it as a subprocess and returning
    # its code. For a top-level command the core owns outright (`list`), where an
    # extra bash process between the caller and the core buys nothing and would
    # only add a second place for a signal or an exit code to be reshaped.
    local exec_mode=0
    if [[ "${1:-}" == --exec ]]; then
        exec_mode=1
        shift
    fi
    local sub="$1"
    shift
    local bin reason=""
    bin="$(_ae_core_bin_input)" || bin=""
    # Absolute + executable + reports a version. A relative path would resolve
    # against wherever the caller happened to run.
    if [[ -z "$bin" ]]; then
        reason="no core is configured (AE_CORE_BIN, ${AE_HOME:-~/.ae}/core/current, or workspace.core)"
    elif [[ "$bin" != /* || ! -x "$bin" ]]; then
        reason="the configured core is not an absolute path to an executable: ${bin}"
    elif ! _ae_core_bin_version "$bin" >/dev/null 2>&1; then
        reason="the configured core reports no version: ${bin}"
    fi
    if [[ -n "$reason" ]]; then
        printf "ae: the ae core is required for '%s' — %s\n" "$sub" "$reason" >&2
        exit 2
    fi
    ((exec_mode)) && exec "$bin" "$sub" "$@"
    # Capture the core's own exit code explicitly — a bare call would let errexit
    # abort this function on a non-zero core before `return` runs.
    local crc=0
    "$bin" "$sub" "$@" || crc=$?
    return "$crc"
}

# — watchdog template functions (emitted into the watchdog helper; the
#   runtime flow lives in helper_watchdog_main, emitted last) —

_watchdog_is_running() {
    [[ -f "$PIDFILE" ]] || return 1
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    # Dead or empty pid → stale pidfile; clean it and report not running.
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PIDFILE" 2>/dev/null
        return 1
    fi
    # The pid is alive — but a stale pidfile can point at a RECYCLED, unrelated
    # process (kill -0 succeeds on it). Require our OWN watchdog pane
    # (@ae_agent=_watchdog) to be live in this session too — _monitor_find_pane is
    # list-panes -s on our own server. No pane → not really running: clean the
    # stale pidfile so 'status' can't lie, 'start' won't wrongly defer, and 'stop'
    # won't kill the innocent process. Safe against a starting watchdog:
    # _watchdog_start tags the pane before _run writes the pidfile, so whenever the
    # pidfile exists our pane exists too.
    if [[ -z "$(_monitor_find_pane _watchdog)" ]]; then
        rm -f "$PIDFILE" 2>/dev/null
        return 1
    fi
    return 0
}

_set_meta_kv() {
    local key="$1" value="$2"
    local meta_file="${META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 0
    {
        flock -w 5 200 || return 1
        local tmp="${META_DIR}/meta.tmp.$$"
        awk -F= -v k="$key" -v v="$value" '
            BEGIN { updated = 0 }
            $1 == k { print k "=" v; updated = 1; next }
            { print }
            END { if (!updated) print k "=" v }
        ' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${META_DIR}/meta.lock"
}

_set_meta_watchdog() { _set_meta_kv "watchdog" "$1"; }

# Kill a pane ONLY if it is still the pane the caller means. A pane id is server-
# local and REUSED after a server restart on the same socket name, so a process
# holding a stale id — a spawn rolling back, a retire, a watchdog stopping — would
# kill a stranger: measured in the integration suite, where an earlier section's
# leftover ae process took a later section's freshly spawned pane (%3 on the new
# server instance) 3 seconds after it was created, seat intact, no rollback line.
# The ownership facts are read from the PANE ITSELF at the moment of the kill, and
# the kill is authorised by a POSITIVE match — never by the absence of a
# contradiction. The pane's session name must equal the caller's, and when the
# caller names an @ae_agent stamp, that must match too.
# FAIL CLOSED on a probe that names no owner: a failing probe (rc != 0 — server gone,
# tmux unavailable, a double that answers nothing) and an empty session on rc 0
# (tmux renders an empty format for an unknown target rather than failing) both
# return without killing. Measured 2026-09-03: unknown pane → rc 0, output "\t";
# unknown server → rc 1. A pane that is not there is nothing to kill, and an
# unreadable pane is exactly the one this guard may not take on faith — a transient
# probe failure would otherwise recreate the stranger-kill path.
# A refusal is loud but non-fatal: the caller's own status stands.
_kill_owned_pane() { # <pane_id> <expected_session> [<expected_agent>]
    local pane="$1" want_session="${2:-}" want_agent="${3:-}" have have_session have_agent rc=0
    [[ -n "$pane" ]] || return 0
    have="$(tmux display-message -p -t "$pane" $'#{session_name}\t#{@ae_agent}' 2>/dev/null)" || rc=$?
    [[ $rc -eq 0 ]] || return 0
    have_session="${have%%$'\t'*}"
    have_agent="${have#*$'\t'}"
    [[ -n "$have_session" ]] || return 0
    if [[ -z "$want_session" || "$have_session" != "$want_session" ]]; then
        echo "ae: refusing to kill pane ${pane}: it belongs to session '${have_session}', not '${want_session:-<unknown>}' (stale pane id)." >&2
        return 0
    fi
    if [[ -n "$want_agent" && "$have_agent" != "$want_agent" ]]; then
        echo "ae: refusing to kill pane ${pane}: it is stamped '${have_agent:-<unstamped>}', not '${want_agent}' (stale pane id)." >&2
        return 0
    fi
    tmux kill-pane -t "$pane" 2>/dev/null || true
    return 0
}

_monitor_find_pane() {
    # Stdout: pane_id of the pane in this session tagged with @ae_agent=$1, or empty.
    tmux list-panes -s -t "$_AE_SESSION" -F '#{pane_id} #{@ae_agent}' 2>/dev/null |
        awk -v want="$1" '$2 == want { print $1; exit }'
}

# Idempotent. Creates the hidden ae-monitor window with the _events pane if
# it doesn't already exist. Sets MONITOR_EVENTS_PANE to the pane id.
# Called by session launch and by _watchdog_start.
_monitor_ensure_events_pane() {
    MONITOR_EVENTS_PANE="$(_monitor_find_pane _events)"
    [[ -n "$MONITOR_EVENTS_PANE" ]] && return 0
    # Pin the monitor window at a high fixed index so it stays RIGHTMOST in
    # the tmux footer — spawned worker windows slot in between it and the main
    # window. Fallback: append-after-current if 99 is somehow taken.
    MONITOR_EVENTS_PANE="$(tmux new-window -d -t "${_AE_SESSION}:99" -n "ae-monitor" -P -F '#{pane_id}' \
        "${META_DIR}/events-tail" 2>/dev/null ||
        tmux new-window -da -t "$_AE_SESSION" -n "ae-monitor" -P -F '#{pane_id}' \
            "${META_DIR}/events-tail" 2>/dev/null)" || {
        echo "Error: could not create monitor window" >&2
        return 1
    }
    tmux set-option -p -t "$MONITOR_EVENTS_PANE" @ae_agent "_events" 2>/dev/null || true
    tmux select-pane -t "$MONITOR_EVENTS_PANE" -T "ae events" 2>/dev/null || true
    tmux set-window-option -t "${_AE_SESSION}:ae-monitor" pane-border-status top 2>/dev/null || true
    tmux select-pane -t "$MONITOR_EVENTS_PANE" -d 2>/dev/null || true
    return 0
}

_watchdog_ensure_monitor() {
    _monitor_ensure_events_pane || exit 1
    exit 0
}

# Transition shim (loop → watchdog rename). The short-lived local shepherd branch
# and released loop versions can leave OLD artifacts: .shepherd.pid / _shepherd /
# .shepherd.status or .loop.pid / _loop / .loop.status. A 'doctor --refresh'
# rewrites helpers but does NOT restart a running watchdog, so that legacy process
# can outlive the rename. Reap it before we start or stop, so we never run two
# watchdogs at once, never leave a stray legacy pane the new watchdog would
# mis-classify as an agent, and so deprecated commands actually stop a legacy one.
# Idempotent + silent. Keep the _shepherd reap only as a local transition aid; it
# is not a public compatibility surface.
_watchdog_reap_legacy_one() {
    local legacy_name="$1"
    local legacy_pid_file="${META_DIR}/.${legacy_name}.pid" legacy_status_file="${META_DIR}/.${legacy_name}.status"
    local legacy_pid legacy_pane
    legacy_pane="$(_monitor_find_pane "_${legacy_name}")"
    # A *live* legacy watchdog is pinned to its legacy monitor pane. Only when
    # that pane exists do we kill the recorded pid — otherwise the pid file is a
    # stale artifact from a crashed watchdog whose pid may have been reused by an
    # unrelated process, and killing it blindly would be wrong. With no pane, just
    # clean up.
    if [[ -n "$legacy_pane" ]]; then
        if [[ -f "$legacy_pid_file" ]]; then
            legacy_pid="$(cat "$legacy_pid_file" 2>/dev/null || true)"
            if [[ -n "$legacy_pid" ]]; then kill "$legacy_pid" 2>/dev/null || true; fi
        fi
        _kill_owned_pane "$legacy_pane" "${_AE_SESSION:-}" "_${legacy_name}"
    fi
    rm -f "$legacy_pid_file" "$legacy_status_file"
}

_watchdog_reap_legacy() {
    _watchdog_reap_legacy_one "shepherd"
    _watchdog_reap_legacy_one "loop"
}

_watchdog_stop() {
    # Reap a pre-rename watchdog first (see _watchdog_reap_legacy). Note whether one
    # was present so we still report "stopped" even if no current watchdog ran.
    local had_legacy="no"
    if [[ -f "${META_DIR}/.shepherd.pid" || -n "$(_monitor_find_pane _shepherd)" || -f "${META_DIR}/.loop.pid" || -n "$(_monitor_find_pane _loop)" ]]; then
        had_legacy="yes"
    fi
    _watchdog_reap_legacy

    local stopped="no"
    if _watchdog_is_running; then
        local pid
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null || true
        rm -f "$PIDFILE"
        # Clear the live status user options so the bars fall back (left → just path).
        _watchdog_clear_bar_options
        # Kill only the _watchdog pane; leave the _events pane and monitor window alive.
        local watchdog_pane
        watchdog_pane="$(_monitor_find_pane _watchdog)"
        if [[ -n "$watchdog_pane" ]]; then _kill_owned_pane "$watchdog_pane" "${_AE_SESSION:-}" _watchdog; fi
        stopped="yes"
    fi

    if [[ "$stopped" == "yes" || "$had_legacy" == "yes" ]]; then
        echo "Watchdog stopped."
    else
        echo "Watchdog is not running."
    fi
    _set_meta_watchdog "false"
    exit 0
}

_watchdog_status() {
    if _watchdog_is_running; then
        echo "Watchdog is running (pid $(cat "$PIDFILE"))."
    else
        echo "Watchdog is not running."
    fi
    exit 0
}

_watchdog_start() {
    # A pre-rename watchdog may still be running under legacy artifacts after an
    # upgrade + refresh (helpers are rewritten but the running watchdog is not
    # restarted). Reap it first so we never run two watchdogs side by side.
    _watchdog_reap_legacy
    # Single-starter mutual exclusion (P4.1a). Both the launch auto-start
    # (_start_session_watchdog -> "${AE_META}/watchdog" start) and an explicit
    # `ae watchdog start` reach THIS function; without a lock two concurrent callers
    # each read _watchdog_is_running=false in the window before either establishes
    # its pane+pidfile, and BOTH split a _watchdog daemon. Acquire an flock on
    # .watchdog.start.lock BEFORE the check+spawn. FAILING to acquire is NOT licence
    # to proceed — another starter holds it and is establishing the single daemon, so
    # we DEFER (no spawn) rather than duplicate. Only a MISSING flock binary degrades
    # to the unguarded path (documented, optional platform). flock (not mkdir) so the
    # kernel releases it on any death — no stale-lock wedge. The fd stays open for the
    # rest of the function, holding the lock across the spawn+registration below.
    if command -v flock >/dev/null 2>&1; then
        # exec (persistent fd), not a block redirect: the lock must span the spawn
        # and the pidfile wait. A failed open exits the helper loudly before any
        # spawn — itself a no-spawn outcome.
        exec 201>"${META_DIR}/.watchdog.start.lock"
        if ! flock -w "$START_LOCK_WAIT" 201; then
            echo "Watchdog start deferred: could not acquire the start lock (another start in progress)." >&2
            exit 0
        fi
    fi
    # Idempotent: if a current watchdog is already running, just confirm the meta
    # flag and exit — do NOT touch status-right (its indicator must stay live).
    if _watchdog_is_running; then
        echo "Watchdog is already running (pid $(cat "$PIDFILE"))."
        _set_meta_watchdog "true"
        exit 0
    fi
    # Make sure the ae-monitor window with the _events pane exists; insert the
    # _watchdog pane above it so the visual order stays watchdog-on-top / events-below.
    _monitor_ensure_events_pane || exit 1
    local watchdog_pane
    # The helper is the CORE's daemon shim now — `exec <core> _watchdog-run
    # <dir> "$@"` — so the pane runs it with NO argument. The `_run` word was the
    # bash helper's own dispatcher arm, and the core rejects it as an unknown one.
    watchdog_pane="$(tmux split-window -v -b -t "$MONITOR_EVENTS_PANE" -P -F '#{pane_id}' \
        "${META_DIR}/watchdog" 2>/dev/null)" || {
        echo "Error: could not create watchdog pane" >&2
        exit 1
    }
    tmux set-option -p -t "$watchdog_pane" @ae_agent "_watchdog" 2>/dev/null || true
    tmux select-pane -t "$watchdog_pane" -T "ae watchdog" 2>/dev/null || true
    # Read-only: disable input on the watchdog pane (events pane was already disabled).
    tmux select-pane -t "$watchdog_pane" -d 2>/dev/null || true
    # The daemon (_run) publishes its pidfile ASYNCHRONOUSLY, so releasing the lock
    # the moment the pane exists would let the next starter race that write into a
    # duplicate spawn. HOLD the lock (fd 201, open until exit) until the daemon is
    # established by the SAME criteria the next starter's _watchdog_is_running
    # applies: a fully-written pidfile with a LIVE pid AND our tagged pane. The check
    # is NON-DESTRUCTIVE (never deletes a partial file) and requires a VALIDATED pid —
    # registering on mere file existence would release the lock over a zero-byte
    # pidfile (the write is atomic upstream, but this belt-and-suspenders holds even
    # if it were not), and the next starter would read no pid, delete it, and spawn a
    # duplicate. If nothing registers within the bound the start FAILED: tear down the
    # pane WE spawned and abort loudly while STILL holding the lock — leaving no
    # live-but-unregistered daemon for the next starter to duplicate. Bounded so a
    # stillborn daemon cannot wedge start; registration normally lands on the first
    # poll.
    local _pw _registered=0 _rp
    for _pw in $(seq 1 "$START_REGISTER_TRIES"); do
        if [[ -f "$PIDFILE" ]]; then
            _rp="$(cat "$PIDFILE" 2>/dev/null || true)"
            if [[ -n "$_rp" ]] && kill -0 "$_rp" 2>/dev/null && [[ -n "$(_monitor_find_pane _watchdog)" ]]; then
                _registered=1
                break
            fi
        fi
        sleep 0.05
    done
    if ((_registered == 0)); then
        _kill_owned_pane "$watchdog_pane" "${_AE_SESSION:-}" _watchdog
        echo "Error: watchdog did not publish a pidfile within the start bound; start aborted." >&2
        exit 1
    fi
    # status-right is OWNED BY AE (_ae_apply_status_bar bakes '[path git] [watch …]' with
    # the #{@ae_watchdog_status} reference at the END). The watchdog never rewrites the
    # bar — it only feeds the user option each cycle — so there is nothing to capture,
    # save, prepend, restore, or dedup here, and start/stop are idempotent by shape.
    _set_meta_watchdog "true"
    echo "Watchdog started in hidden ae-monitor window. Use 'peek _watchdog' or 'peek _events' to inspect."
    exit 0
}

# Live status is pushed into tmux user options, read by the bars as
# #{@ae_branch_status} (status-RIGHT, after the static path) and #{@ae_watchdog_status}
# (status-RIGHT health). User-option values are interpolated literally — no shell, no
# #() parsing — so a branch/path with spaces, ), #, etc. is safe with no escaping.
# Cleared on exit so the bars fall back cleanly (left → just the path).
# EXACT session-id lookup. stdin: '<session_id> <session_name>' rows (a
# `list-sessions -F '#{session_id} #{session_name}'` dump); $1: the wanted NAME.
# Prints the matching session id ('$N'), or NOTHING when the session is gone.
#
# Why an id, and why matched here in bash rather than by a tmux target:
#   * tmux session targets PREFIX-MATCH. Reproduced: with 'foo' absent and 'foobar'
#     alive, `set-option -w -t 'foo:0' -u @probe` WIPED foobar's option — a dead
#     session's cleanup silently clobbering a live neighbour's bar.
#   * tmux's documented '=' exact-match prefix is NOT usable here: on tmux 3.4 it works
#     for `has-session` but FAILS for `show-options`/`set-option` ("no such session:
#     =name") and returns nothing from `display-message`. An earlier attempt to anchor
#     with '=' looked like it fixed the clobber only because EVERY write silently failed
#     — it broke the bar entirely and 14 integration tests caught it.
#   * `display-message -t foo '#{session_id}'` PREFIX-MATCHES too — it happily returns
#     foobar's id for a nonexistent 'foo' — so resolving through a tmux target would
#     reintroduce the bug at the lookup layer.
# Matching the name as an exact bash string over a list-sessions dump is the only step
# tmux cannot mis-resolve; the id it yields is unique and stable for the session's life,
# exactly like the '@N' window ids used for the window options.
# EMPTY OUT MEANS SKIP THE WRITE: callers must not fall back to a bare target — an empty
# '-t' would resolve to tmux's *current* session, i.e. someone else's bar.
# ── watchdog start / stop / status, from the glue ────────────────────────
# The one watchdog surface bash still owns. The DAEMON is the core's, and the
# session's `watchdog` helper is now a thin shim onto it — `exec <core>
# _watchdog-run <dir> "$@"` — so it can no longer serve `start`/`stop`/`status`
# and this must not route through it. The three run HERE instead, against the
# session's own tmux server, and the pane `start` creates runs that same shim
# bare.
#
# In a SUBSHELL: the three bodies below end in `exit`, which is right for a
# helper's main and wrong for a caller like `doctor --refresh` that sweeps
# several sessions. The subshell also scopes the tmux shim and the globals the
# bodies read (META_DIR, _AE_SESSION, PIDFILE), which are the ones the generated
# helper's `_lib` used to supply.
#
# The AE_WATCHDOG_* daemon tunables are NOT read here: the shim passes the core
# no flags, so nothing this script could read would reach the daemon. The two
# knobs that remain are the two bash still acts on.
_watchdog_manage() { # <meta-dir> <start|stop|status|_ensure-monitor>
    (
        META_DIR="$1"
        local cmd="${2:-}" srv srv_kind
        _AE_SESSION="$(sed -n 's/^session=//p' "${META_DIR}/meta" 2>/dev/null | head -1 || true)"
        if [[ -z "$_AE_SESSION" ]]; then
            echo "Error: ${META_DIR}/meta names no session" >&2
            exit 1
        fi
        srv="$(sed -n 's/^tmux_server=//p' "${META_DIR}/meta" 2>/dev/null | head -1 || true)"
        srv_kind="$(sed -n 's/^tmux_server_kind=//p' "${META_DIR}/meta" 2>/dev/null | head -1 || true)"
        if [[ "$srv_kind" == "ambiguous" ]]; then
            echo "ae: refusing — this session's server record is ambiguous; run 'ae doctor --refresh' first." >&2
            exit 1
        fi
        if [[ -n "$srv" ]]; then
            _AE_WT_ARGS=()
            mapfile -t _AE_WT_ARGS < <(_srv_tmux_args "$srv_kind" "$srv")
            tmux() { command tmux "${_AE_WT_ARGS[@]}" "$@"; }
        fi
        PIDFILE="${META_DIR}/.watchdog.pid"
        # P4.1a start-serialization knobs. START_LOCK_WAIT: max seconds a starter
        # blocks on .watchdog.start.lock before deferring (a wedged holder must not
        # hang a start forever). START_REGISTER_TRIES: polls (x0.05s) to await the
        # spawned daemon's pidfile before declaring the start failed. Both reject
        # leading zeros — "08" is valid to ^[0-9]+$ and OCTAL to bash arithmetic.
        START_LOCK_WAIT="${AE_WATCHDOG_START_LOCK_WAIT_SEC:-15}"
        [[ "$START_LOCK_WAIT" =~ ^[1-9][0-9]*$ ]] || START_LOCK_WAIT=15
        START_REGISTER_TRIES="${AE_WATCHDOG_START_REGISTER_TRIES:-200}"
        [[ "$START_REGISTER_TRIES" =~ ^[1-9][0-9]*$ ]] || START_REGISTER_TRIES=200
        case "$cmd" in
            start) _watchdog_start ;;
            stop) _watchdog_stop ;;
            status) _watchdog_status ;;
            _ensure-monitor) _watchdog_ensure_monitor ;;
            *)
                echo "Usage: watchdog [start|stop|status]" >&2
                exit 1
                ;;
        esac
    )
}

_roster_session_id() {
    local want="$1" id name
    [[ -n "$want" ]] || return 0
    # Already an id — pass through.
    [[ "$want" == '$'* ]] && {
        printf '%s' "$want"
        return 0
    }
    # `|| [[ -n "$id" ]]`: a final row with no trailing newline makes `read` return
    # nonzero while still assigning — without this the LAST session in the dump is
    # silently invisible, which for a lookup means "gone" and skips its cleanup.
    while read -r id name || [[ -n "$id" ]]; do
        [[ "$name" == "$want" ]] || continue
        printf '%s' "$id"
        return 0
    done
    return 0
}

# Exact session id for an arbitrary NAME on the current tmux server ('' when no session
# of exactly that name is live). The ONE shared "name → exact id" resolver — tmux
# targets PREFIX-MATCH (`has-session -t proj` hits a live `project`), so any liveness or
# live-session operation must resolve here and then target by id, never by the raw name.
# (Third occurrence of the prefix-match class after display-message lookups and option
# writes; _roster_session_id is the shared string-matcher underneath.)
_ae_session_id() {
    tmux list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id "$1"
    return 0
}

# The watchdog's own session id, resolved exactly — now a thin call to the shared
# resolver above (one resolver, not a sibling copy).
_watchdog_session_id() {
    _ae_session_id "$_AE_SESSION"
    return 0
}

_watchdog_clear_bar_options() {
    local _o _wi
    local _sid
    _sid="$(_watchdog_session_id)"
    [[ -n "$_sid" ]] || return 0
    for _o in @ae_branch_status @ae_branch_name @ae_watchdog_status @ae_agents_status; do
        tmux set-option -t "$_sid" -u "$_o" 2>/dev/null || true
    done
    # @ae_window_status is WINDOW-scoped: a session -u never touches it, so a stopped
    # watchdog would freeze glyphs in the window list forever. Clear each window.
    while read -r _wi; do
        [[ -n "$_wi" ]] || continue
        # By ID: an index can renumber between listing and clearing, which would skip a
        # window and leave its glyphs frozen — the precise failure this cleanup prevents.
        tmux set-option -w -t "$_wi" -u @ae_window_status 2>/dev/null || true
    done < <(tmux list-windows -t "$_sid" -F '#{window_id}' 2>/dev/null || true)
    return 0
}

ATTACH_ON_READY=true
case "${1:-}" in
    list | ls)
        cmd_list "${@:2}"
        exit $?
        ;;
    status)
        cmd_status "${2:-}"
        exit $?
        ;;
    compact)
        # The WHOLE compact is the core's: the freeze, the confirmation, the
        # handover under the lifecycle lock, the bounded wait, the
        # revalidate/stop/archive/teardown, the four boundary lines — and the
        # relaunch of the child from the FROZEN roster. `--exec-plan` is the one
        # shape that hands the relaunch back to its caller; the glue does not ask
        # for it, so the core starts the child itself and there is nothing left
        # here to sequence.
        _ae_core_preflight_try --exec _compact "${@:2}"
        ;;
    archive)
        case "${2:-}" in
            preview)
                cmd_archive_preview "${3:-}"
                exit $?
                ;;
            *)
                echo "Usage: ae archive preview [session-name]" >&2
                exit 1
                ;;
        esac
        ;;
    next | jump)
        cmd_next "${@:2}"
        exit $?
        ;;
    doctor)
        cmd_doctor "${@:2}"
        exit $?
        ;;
    stop)
        # The whole stop is the core's — `--self` and the fleet form included. It
        # forks its own detached supervisor (`_stop --supervise <name>`), so the
        # two `_stop-supervisor` entries this dispatcher used to carry have no
        # caller left and are gone.
        #
        # THE PANE IS THE ONE FACT THE CORE CANNOT SEE FOR ITSELF. Self-ness is
        # the question "is the target the session I am running in", and its
        # answer starts from the pane THIS process sits in — which reaches a
        # child only as $TMUX_PANE, an environment variable, and the core does
        # not read the environment. So the pane crosses as a flag and the core
        # resolves it to a session name itself; no name is derived here.
        #
        # `--pane=<id>` WINS over $TMUX_PANE, and it is not a duplicate of it: in
        # a `run-shell` child the variable is INHERITED and names a FOREIGN pane
        # (measured), so an explicitly expanded #{pane_id} is the only
        # trustworthy answer from there — which is why the recipe in
        # docs/reference/commands.md binds exactly that. An EMPTY `--pane=` is
        # treated as absent rather than passed on: a flag with no value is a
        # caller mistake, and falling back is the same answer it would have got
        # by not writing the flag at all.
        _stop_args=()
        _stop_pane=""
        for _stop_a in "${@:2}"; do
            case "$_stop_a" in
                --pane=*) _stop_pane="${_stop_a#--pane=}" ;;
                *) _stop_args+=("$_stop_a") ;;
            esac
        done
        if [[ -z "$_stop_pane" ]]; then
            _stop_pane="${TMUX_PANE:-}"
        fi
        if [[ -n "$_stop_pane" ]]; then
            _stop_args+=(--pane "$_stop_pane")
        fi
        _ae_core_preflight_try --exec _stop ${_stop_args[@]+"${_stop_args[@]}"}
        ;;
    rename)
        cmd_rename "${2:-}" "${3:-}"
        exit $?
        ;;
    watchdog | loop) # 'loop' kept as the deprecated alias for the renamed feature
        cmd_watchdog "${2:-}" "${3:-}"
        exit $?
        ;;
    telegram)
        cmd_telegram "${@:2}"
        exit $?
        ;;
    orchestrator | hub) # 'hub' kept as the deprecated alias for the renamed meta-agent
        # Orchestrator (meta-agent) launcher. Trampoline: handle --init/help (exit),
        # else set up FULL config isolation (the start-orchestrator wrapper's job) and
        # FALL THROUGH to the generic start/resume path below. We must NOT
        # re-dispatch the subcommand here (that would re-enter this branch and
        # recurse) — falling through reuses the generic parser instead.
        shift
        _orchestrator_attach=false
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --init)
                    if [[ $# -gt 1 ]]; then
                        echo "Error: 'ae orchestrator --init' takes no further arguments (got: ${*:2})" >&2
                        exit 1
                    fi
                    cmd_orchestrator_init
                    exit $?
                    ;;
                -h | --help | help)
                    cmd_orchestrator_help
                    exit 0
                    ;;
                --attach | --switch)
                    _orchestrator_attach=true
                    shift
                    ;;
                --detach | --no-attach)
                    _orchestrator_attach=false
                    shift
                    ;;
                *)
                    # The orchestrator session is ALWAYS named `orchestrator` (legacy scaffold:
                    # `hub`) with the standalone config; accepting extra args would
                    # let `ae orchestrator foo` become session `foo` via the generic
                    # parser (last positional wins), leaking the reserved name +
                    # orchestrator config onto another session. Reject them.
                    echo "Error: 'ae orchestrator' takes no positional arguments (flags: --init / --help / --attach / --detach). Got: $*" >&2
                    echo "The orchestrator session is always named 'orchestrator' (config: \${AE_ORCHESTRATOR_DIR:-~/.ae/orchestrator}/orchestrator.config)." >&2
                    echo "To run a normal session literally named 'orchestrator', use: ae --local orchestrator" >&2
                    exit 1
                    ;;
            esac
        done
        if $_orchestrator_attach; then
            ATTACH_ON_READY=true
        else
            ATTACH_ON_READY=false
        fi
        # Resolve the scaffold: canonical orchestrator layout first, then the legacy
        # hub layout (from 'ae hub --init' before the rename). The config file
        # found decides the SESSION NAME too — a legacy hub.config keeps running
        # as session `hub` so its baked charter paths (~/.ae/sessions/hub) and
        # resume state stay consistent; an orchestrator.config runs as `orchestrator`.
        _orchestrator_session=orchestrator
        if [[ -n "${AE_ORCHESTRATOR_DIR:-}" ]]; then
            _orchestrator_dir="$AE_ORCHESTRATOR_DIR"
            _orchestrator_config="$_orchestrator_dir/orchestrator.config"
        elif [[ -f "$CONFIG_DIR/orchestrator/orchestrator.config" ]]; then
            _orchestrator_dir="$CONFIG_DIR/orchestrator"
            _orchestrator_config="$_orchestrator_dir/orchestrator.config"
        elif [[ -n "${AE_HUB_DIR:-}" ]]; then
            _orchestrator_dir="$AE_HUB_DIR"
            _orchestrator_config="$_orchestrator_dir/hub.config"
            _orchestrator_session=hub
        elif [[ -f "$CONFIG_DIR/meta-hub/hub.config" ]]; then
            _orchestrator_dir="$CONFIG_DIR/meta-hub"
            _orchestrator_config="$_orchestrator_dir/hub.config"
            _orchestrator_session=hub
        else
            _orchestrator_dir="$CONFIG_DIR/orchestrator"
            _orchestrator_config="$_orchestrator_dir/orchestrator.config"
        fi
        if [[ ! -f "$_orchestrator_config" ]]; then
            echo "Error: no orchestrator config at $_orchestrator_config." >&2
            echo "Run 'ae orchestrator --init' to scaffold the orchestrator config + charter." >&2
            exit 1
        fi
        if [[ "$_orchestrator_session" == "hub" ]]; then
            echo "note: using legacy hub scaffold ($_orchestrator_config) — session stays 'hub'."
            echo "      To migrate: ae end hub && ae orchestrator --init && ae orchestrator"
        fi
        # BLOCKER fix (codex): CONFIG_FILE alone does NOT isolate. AE_LOCAL_CONFIG
        # was captured from the CALLER's PWD near script top (before any cd), so a
        # project-local ./.ae/config could still override workspace.*/prompt.* and
        # reintroduce the worker-leak. Replicate the wrapper's full isolation:
        AE_LOCAL_CONFIG="" # drop the caller-PWD local config
        cd "$_orchestrator_dir" || {
            echo "Error: cannot cd to $_orchestrator_dir" >&2
            exit 1
        }
        # Set CONFIG_FILE from $PWD *after* cd so it's absolute even when the dir
        # override is relative (a relative path stored in meta would break resume).
        CONFIG_FILE="$PWD/$(basename "$_orchestrator_config")" # standalone config wins (absolute, isolated)
        # copy=local ⇒ work_dir/origin become $_orchestrator_dir; on resume the restore
        # path below rebuilds AE_LOCAL_CONFIG from stored_origin (no .ae/config
        # there), so the isolation persists across resume too.
        set -- "$_orchestrator_session" # session name (extra args already rejected above)
        # fall through (NO exit) to flag-parse + generic start/resume
        ;;
    end | rm)
        # Capture then delete, in the core: the verified stop, git, the archive,
        # and only then the removal — a failed archive fails the end with the
        # session still whole. `ae transfer` is not here any more: it was ruled
        # CUT rather than ported.
        _ae_core_preflight_try --exec _end "${@:2}"
        ;;
    _spawn)
        _cmd_spawn "${@:2}"
        exit $?
        ;;
    _retire)
        _cmd_retire "${@:2}"
        exit $?
        ;;
    _recover-pending)
        cmd_recover_pending "${@:2}"
        exit $?
        ;;
    help | -h | --help)
        cmd_help
        exit 0
        ;;
    version | --version | -V)
        echo "ae ${AE_VERSION}"
        exit 0
        ;;
    _*)
        # FAIL CLOSED ON AN INTERNAL WORD NOBODY SERVES. Everything past this
        # case falls through to LAUNCH, and a launch takes the last positional as
        # a session name — so a retired internal entry (`_stop-supervisor`,
        # `_stop-fleet-supervisor`, both cut with the fleet supervisor) would
        # silently CREATE a session named after one of its arguments instead of
        # erroring. `_`-prefixed words are ae's own namespace and are never a
        # session name; an unserved one is a caller bug, and 2 is what ae exits
        # when you asked wrong.
        echo "ae: unknown internal command '$1'." >&2
        exit 2
        ;;
esac
# --- Launch or resume: the whole operation is the core's ------------------
#
# `_launch` owns every step the flow below used to hold: the argv grammar, the
# derived name and its ownership guard, the teardown tombstones, the `--from`
# preflight, the working-copy modes, the tmux session and its layout, the meta
# publish, the session assets (helper shims and workspace.md — see the note on
# `_refresh_session_shims`), the launch scripts and their readiness-gated paste,
# the post-launch session-id capture, the monitor panes, and the attach.
#
# The core may not read the environment, so every environmental fact crosses as
# a FLAG and is spelled in exactly one place — here. The user's own argv is
# handed over VERBATIM after `--`: the grammar (and every refusal it carries) is
# the core's, and a second parser here would be a second answer.
check_deps || exit 1

# The two companions are NOT the core's — a launch that quietly grew them would
# be three operations in one. They run BEFORE the launch rather than between it
# and the attach: the core attaches as its own last step, so there is no seam
# left on this side of it. Both are guarded, idempotent and non-fatal; the one
# behaviour this ordering changes is that a launch the core REFUSES has already
# brought its companions up.
SESSION="$(_autostart_session_hint "$@")"
# THE PATH OBJECT, ahead of every side effect. The grammar says nothing about
# what is on disk: a symlink named 'valid-name' satisfies every naming rule, and
# both reuse paths — the attach-to-a-running-session fast path and the on-disk
# resume — plus the rollback's own removal then run THROUGH the link, out of the
# sessions root. The core validates the name and derives an unnamed launch's;
# what it does not check is this, so the half bash can still answer exactly — a
# name the caller TYPED — is answered here. The derived half is the core's, and
# is named as an open gap rather than guessed at from a hint.
# The NAME grammar is the core's and answers first: a traversal name is refused
# as a name, not as a path object, so the message names what is actually wrong.
if [[ -n "$SESSION" ]] && _session_name_usable "$SESSION" 2>/dev/null; then
    _require_session_path_safe "$SESSION" || exit 1
fi
# COMPANIONS RIDE ALONG WITH A LAUNCH, and both of their liveness probes need a
# tmux SERVER to answer — but the launch that creates it is one `exec` away, so
# asking here would query a socket that does not exist yet. That answer is the
# tri-state UNKNOWN, not "absent" (ENOENT is deliberately NOT clean-dead — 11th
# review B1: unlinking a LIVE server's socket looks identical), and an unknown
# answer correctly refuses to start a companion. Measured: with the probe moved
# ahead of the launch, a fresh server means NO companion ever starts.
#
# So fork a bounded waiter instead, and let it probe once the server answers. It
# is fully detached and silent, exactly as the inline calls were; and because it
# runs the autostarts ONLY on a server that answered, a launch that refuses
# without ever creating one starts nothing.
(
    _as_i=0
    while ((_as_i < 60)); do
        if tmux list-sessions >/dev/null 2>&1; then break; fi
        sleep 0.5
        _as_i=$((_as_i + 1))
    done
    if tmux list-sessions >/dev/null 2>&1; then
        _telegram_autostart_if_enabled 2>/dev/null || true
        _orchestrator_autostart_if_scaffolded 2>/dev/null || true
    fi
) >/dev/null 2>&1 &

# `if`, not `[[ … ]] && …`: a false test is the statement's exit status, and at
# TOP LEVEL under errexit that ends the script (AGENTS.md, the set -e footguns).
_launch_flags=(--home "$AE_HOME" --cwd "$PWD")
if [[ -n "${CONFIG_FILE:-}" ]]; then
    _launch_flags+=(--global "$CONFIG_FILE")
fi
if [[ -n "${AE_LOCAL_CONFIG:-}" ]]; then
    _launch_flags+=(--local-config "$AE_LOCAL_CONFIG")
fi
# THE GLUE'S OWN PATH, recorded as meta's `ae_path`. The core cannot derive it:
# `current_exe()` names the CORE, and under a versioned install those are two
# different files (versions/<v>/ae-glue vs versions/<v>/ae-core). `ae_path` is
# the recorded `ae` COMMAND — the watchdog re-execs it for `telegram _supervise`
# and `_recover-pending`, which are bash arms the core does not answer — so
# handing it the core would make a live session's watchdog re-exec unserviceable.
# Derived exactly as sync_existing_session_assets derives it, and deliberately
# NOT through `readlink -f`: the versioned path is the one to pin, not whatever
# ~/.local/bin/ae happens to point at today.
_launch_flags+=(--glue "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")")
# THE CORE THE GLUE RESOLVED, recorded as meta's `ae_core`. `current_exe()` names
# the binary that is RUNNING, which is not the same question: `_ae_core_try`
# re-resolves the pin out of meta on EVERY later call, so what belongs there is
# the path `_ae_core_bin_input` chose — AE_CORE_BIN, then core/current, then
# workspace.core. Where the two differ (a versioned `ae-core` that is a wrapper,
# a symlink, an AE_CORE_BIN whose target execs a second binary) recording the
# running one would pin the session to a core the operator never selected.
# Resolved with the same one query the preflight below uses; a failure to resolve
# is left to the preflight to report, so the flag is simply omitted here.
_launch_core="$(_ae_core_bin_input 2>/dev/null || true)"
if [[ -n "$_launch_core" ]]; then
    _launch_flags+=(--core "$_launch_core")
fi
# The server crosses as a TYPED PAIR — the core reads the kind first and ignores
# a value it cannot type, and it never asks tmux where it is. RESOLVED here, by
# the resolver that owns the question, so meta records where the launch really
# lands rather than whatever the environment happened to say.
resolve_launch_tmux_server
if [[ -n "$_LAUNCH_SRV_KIND" || -n "$_LAUNCH_SRV_VALUE" ]]; then
    _launch_flags+=(--server-kind "$_LAUNCH_SRV_KIND" --server "$_LAUNCH_SRV_VALUE")
fi
if [[ "$ATTACH_ON_READY" == "true" ]]; then
    _launch_flags+=(--attach)
else
    _launch_flags+=(--no-attach)
fi
# Attach vs switch-client is decided by whether the CALLER is in a pane, and the
# stale-$TMUX sensor that answers it is this script's (it needs `ps` and the
# caller's own tty).
if _ae_inside_tmux; then
    _launch_flags+=(--inside-tmux)
fi
_ae_core_preflight_try --exec _launch "${_launch_flags[@]}" -- "$@"
