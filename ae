#!/usr/bin/env bash
set -uo pipefail
META_DIR="$(cd "$(dirname "$0")" && pwd)"
EVENTS_FILE="${META_DIR}/events.jsonl"

# Extract a JSON string value for a flat key from one of our own events.jsonl
# lines. Walks character by character so escaped quotes (\") and backslashes
# (\\) inside the value don't terminate the parse early. Handles the same
# escape sequences ae_emit_event produces: \\, \", \n, \t, \r.
_extract_json_str() {
    local line="$1" key="$2"
    local prefix="\"${key}\":\""
    local rest="${line#*${prefix}}"
    [[ "$rest" == "$line" ]] && return
    local result="" i=0 n=${#rest}
    local c next
    while ((i < n)); do
        c="${rest:$i:1}"
        if [[ "$c" == "\\" ]]; then
            next="${rest:$((i + 1)):1}"
            case "$next" in
                n) result+=" " ;;
                t) result+=" " ;;
                r) ;;
                '"') result+='"' ;;
                "\\") result+="\\" ;;
                *) result+="$c$next" ;;
            esac
            i=$((i + 2))
        elif [[ "$c" == '"' ]]; then
            break
        else
            result+="$c"
            i=$((i + 1))
        fi
    done
    printf '%s' "$result"
}

_format_event() {
    local line="$1"
    [[ -n "$line" ]] || return
    [[ "$line" == \{* ]] || return
    local ts actor action target summary short_ts
    ts="$(_extract_json_str "$line" ts)"
    actor="$(_extract_json_str "$line" actor)"
    action="$(_extract_json_str "$line" action)"
    target="$(_extract_json_str "$line" target)"
    summary="$(_extract_json_str "$line" summary)"
    short_ts="${ts##*T}"
    short_ts="${short_ts%Z}"
    if (( ${#summary} > 60 )); then
        summary="${summary:0:57}..."
    fi
    if [[ -n "$target" ]]; then
        printf '%s  %-8s %-22s → %-22s %s\n' "$short_ts" "$action" "$actor" "$target" "$summary"
    else
        printf '%s  %-8s %-22s   %-22s %s\n' "$short_ts" "$action" "$actor" "" "$summary"
    fi
}

