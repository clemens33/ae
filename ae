# Internal: spawn a new agent pane (called via spawn helper → ae _spawn)
# Is a freshly-launched pane's TUI ready to RECEIVE its brief? Ready means the input is
# CONFIRMED IDLE — not "the process is up", and not "some marker is somewhere on screen".
#
# The marker grep this replaces ('❯|bypass permissions|for shortcuts') answered a
# different question than the caller was asking. claude's trust dialog renders
# '❯ 1. Yes, I trust this folder' — and that BARE ORNAMENT alone was the whole match: the
# real captured dialog contains neither 'bypass permissions' nor 'for shortcuts' (they
# belong to the composed TUI's footer, which is not drawn yet). So a modal read READY and
# the brief was pasted into it, where Enter answers the dialog rather than submitting
# (colead ROUND5 BLOCKER 2). One incidental glyph was enough — which is the argument for
# a predicate over a marker, not for a longer marker list.
#
# For modeled tools this is the SAME structural predicate the send path uses, so spawn
# can no longer disagree with it: a booting TUI has no live prompt (indeterminate ->
# unsafe -> not ready), and a modal is occupied (-> not ready). Unmodeled TUIs have no
# predicate — _paste_input_busy reports them safe unconditionally, which would mean
# "ready" the instant the pane exists, i.e. the boot-gap paste this poll exists to
# prevent. They keep the marker, which is weaker but is what they had before.
# AN IDLE INPUT BOX IS NOT AN INITIALIZED APPLICATION. The input predicate answers
# "is there room to type"; a TUI that renders its box during startup answers YES
# while it is still bringing itself up. MEASURED 2026-08-15, codex v0.147.0, cold
# start, real MCP config, isolated socket:
#
#     t=0.0  (blank)                                        -> not ready
#     t=0.5  header reads "model:       loading"            -> input box ALREADY drawn
#     t=1.0  "• Starting MCP servers (0/7): …"              -> still coming up
#     t=2.5  "• Starting MCP servers (4/7): …"
#     t=3.0  settled (or "⚠ MCP startup interrupted …")
#
# _spawn_input_ready answered READY from t=0.5 onward — so the bounded wait built to
# protect the paste succeeded on its FIRST poll and never waited at all.
#
# These are NEGATIVE markers: evidence that the tool is provably still starting. Their
# ABSENCE is not treated as proof of readiness, and the idle-input test still governs.
# Requiring a positive banner instead would fail every spawn the day codex stops
# printing one — a predicate that breaks closed on a cosmetic change is worse than the
# gap it closes.
_tool_initializing() { # <pane> <tool_kind> -> 0 = PROVABLY still starting up
    local pane="$1" tool="$2" cap
    case "$tool" in
        codex) ;;
        *) return 1 ;; # no modelled start-up markers -> nothing provable here
    esac
    cap="$(tmux capture-pane -p -t "$pane" 2>/dev/null)" || return 1
    [[ -n "$cap" ]] || return 1
    # SHAPE, NOT SUBSTRING. These patterns are matched as the ROWS the TUI draws, not
    # as text appearing anywhere on screen — because a settled pane whose TRANSCRIPT
    # merely mentions a marker would otherwise read "initializing" forever and refuse
    # after the full 45s wait. That is not hypothetical: these very strings are quoted
    # in AGENTS.md's capability matrix and in every discussion of this feature, so a
    # substring scan fires on an agent reading the docs in its own pane.
    #
    # COLUMN 0, no leading-whitespace tolerance — and that is a MEASURED property, not
    # a guess. Codex renders a copied start-up frame inside a message as INDENTED
    # continuation rows; measured 2026-08-15 by pasting the exact rows into a settled
    # pane:
    #
    #     │ model:       gpt-5.6-luna xhigh   /model to change │   <- chrome, column 0
    #       • Starting MCP servers (0/7): assistant-all-tools…    <- quote, indented
    #       │ model:       loading   /model to change │            <- quote, indented
    #
    # So the column separates the TUI's own chrome from any quotation of it. Allowing
    # leading whitespace re-opened the whole transcript case: an exact copied row read
    # INITIALIZING and cost a 45s false refusal — and these rows get quoted constantly,
    # including in this project's own discussions of this very feature.
    #
    # The progress row: the bullet the TUI draws starts the line. The counter is what
    # makes it a class ("servers still starting"), not any particular server list.
    if grep -qE '^•[[:space:]]+Starting MCP servers \([0-9]+/[0-9]+\)' <<<"$cap"; then
        return 0
    fi
    # The header row: inside the box (│ … │, the U+2502 the TUI draws — NOT an ASCII
    # pipe, which would match a markdown table row and put AGENTS.md's own matrix back
    # in scope), carrying the live "/model to change" affordance beside the value.
    if grep -qE '^│[[:space:]]*model:[[:space:]]+loading([[:space:]].*)?/model to change' <<<"$cap"; then
        return 0
    fi
    return 1
}

_spawn_input_ready() { # <pane> <tool_kind>
    local pane="$1" tool_kind="$2"
    # Ask the START-UP question first and for every tool: a tool that is provably
    # still initializing is not ready no matter how idle its input box looks.
    if _tool_initializing "$pane" "$tool_kind"; then
        return 1
    fi
    case "$tool_kind" in
        claude | codex)
            if _paste_input_busy "$pane" "$tool_kind"; then
                return 1 # busy / modal / unreadable -> NOT ready
            fi
            return 0
            ;;
        *)
            tmux capture-pane -p -t "$pane" 2>/dev/null |
                grep -qE '❯|bypass permissions|for shortcuts' || return 1
            return 0
            ;;
    esac
}

# ONE bounded readiness wait, used by both delivery moments. Extracted because the
# spawn path had it inline and the launch path had nothing at all — the same question
# deserves the same answer wherever it is asked.
_wait_input_ready() { # <pane> <tool_kind> [polls] -> 0 ready, 1 timed out
    local pane="$1" tool_kind="$2" polls="${3:-30}" i=0
    while ((i < polls)); do
        if _spawn_input_ready "$pane" "$tool_kind"; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

# `ae _spawn <meta-dir> <name> --using <profile> [--] [prompt]` — the entry the
# session's `spawn` helper execs. B move 2 made the whole operation the core's:
# the argv grammar and its usage line, the name allowlist, the profile lookup,
# the seat reserved in meta BEFORE the pane exists, the window, the pane stamps,
# the manifest, the launch script, the readiness-gated brief, the rollback on
# every failure after the seat, the ownership-guarded kill, and the spawn /
# spawn-failed events.
#
# ONE duty stays here, and it is why this is not a bare exec: the post-launch
# session-id CAPTURE for the tools with no launch-time id flag (codex, opencode,
# gemini). That capture is a detached poll which OUTLIVES the command — minutes
# of sleeping and scanning the tool's own history directory — so it cannot live
# inside a core process the caller waits on. The core has already written
# `launch_id.<slot>` and `launch_time.<slot>`; this fork only watches for the id
# and writes it back through the roster. It runs ONLY after a success, because a
# rolled-back spawn has no seat to write to.
_cmd_spawn() {
    local meta_dir="$1" name rc=0
    shift
    name="${1:-}"
    META_DIR="$meta_dir" _ae_core_try --capture _spawn "$@" || rc=$?
    ((rc == 0)) || return "$rc"
    _spawn_capture_after "$meta_dir" "$name"
    return 0
}

# Fork the post-launch session-id capture for the seat `_spawn` just created.
#
# The SLOT is read back from meta rather than guessed: the core owns seat
# allocation, and `seat.spawned.<n>=<name>` is where it records which index it
# took — deriving one here would be a second allocator, disagreeing the first
# time two spawns race. The pane is found by its `@ae_slot` stamp for the same
# reason, and the tool kind from the seat's own `agent_bin.<slot>`.
#
# Nothing here is fatal. A capture that cannot start costs an exact `--resume`
# on the next cycle (the tool falls back to its CWD heuristic), never the spawn
# that has already succeeded — so every probe degrades to a quiet return.
_spawn_capture_after() {
    local meta_dir="$1" name="$2" meta="$1/meta"
    local slot="" _sl bin="" kind="" session="" pane=""
    [[ -n "$name" && -f "$meta" ]] || return 0
    # The name is allowlisted (^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$), so it carries no
    # regex metacharacter; the slot does — escape its dot before it is one.
    slot="$(sed -n "s/^seat\\.\\(spawned\\.[0-9][0-9]*\\)=${name}$/\\1/p" "$meta" | head -1 || true)"
    [[ -n "$slot" ]] || return 0
    _sl="${slot//./\\.}"
    bin="$(sed -n "s/^agent_bin\\.${_sl}=//p" "$meta" | head -1 || true)"
    [[ -n "$bin" ]] || return 0
    kind="$(tool_kind_from_cmd "$bin")"
    tool_kind_supports_launch_id "$kind" || return 0
    session="$(sed -n 's/^session=//p' "$meta" | head -1 || true)"
    [[ -n "$session" ]] || return 0
    pane="$(tmux list-panes -s -t "$session" -F '#{pane_id} #{@ae_slot}' 2>/dev/null |
        awk -v s="$slot" '$2 == s { print $1; exit }' || true)"
    [[ -n "$pane" ]] || return 0
    capture_session_id "$kind" "$pane" "$slot" "$meta_dir" &
    return 0
}

# `ae _retire <meta-dir> <name|%pane>` — the entry the session's `retire` helper
# execs. Wholly the core's since B move 2: exact name or `%pane` resolution, the
# refusal that protects the main/worker seats, the meta strip under meta.lock,
# the launch artifacts, the ownership-guarded kill, the manifest and the retire
# event. Nothing follows it here, so the shim EXECs.
_cmd_retire() {
    local meta_dir="$1"
    shift
    META_DIR="$meta_dir" _ae_core_try _retire "$@"
}

# Append one event to the session log, from code that runs OUTSIDE the `_lib`
# context and so cannot call ae_emit_event: `ae stop`, and the launch path's
# delivery-failure reporter. It keeps its `_spawn_` name because the spawn path
# was its first caller; that caller is the core's since B move 2, and the two
# above are what is left.
_spawn_emit_event() { # <meta_dir> <actor> <target> <action> <summary>
    local meta_dir="$1" actor="$2" target="$3" action="$4" summary="$5"
    local _esc _actor _target _summary _ts _json
    _esc() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        s="${s//$'\r'/\\r}"
        printf '%s' "$s"
    }
    ae_sanitize_utf8 "$summary"
    summary="$_EV_CLEAN"
    _actor="$(_esc "$actor")"
    _target="$(_esc "$target")"
    _summary="$(_esc "$summary")"
    _ts="$(date -u +%FT%TZ)"
    _json="$(printf '{"ts":"%s","actor":"%s","action":"%s","target":"%s"' "$_ts" "$_actor" "$action" "$_target")"
    [[ -n "$_summary" ]] && _json+="$(printf ',"summary":"%s"' "$_summary")"
    _json+="}"
    { flock -w 5 8 && printf '%s\n' "$_json" >>"$meta_dir/events.jsonl"; } 8>>"$meta_dir/events.jsonl.lock"
    return 0
}

# Regenerate workspace.md from live tmux pane state.
#
# A.2c: the DOCUMENT is the core's — it reads the session's meta, lists the panes
# through the typed tmux transport, and writes `<dir>/workspace.md` itself, so the
# manifest and the seat context can no longer describe one session two ways. The
# glue passes the six facts it already holds plus the two config files, for the
# same reason build_ae_context does: the core does not read the environment.
regenerate_manifest() {
    local sess="$1" wdir="$2" origin="$3" mode="$4" main_pane="$5" sessions_dir="$6"
    local -a cfg=()
    [[ -n "${CONFIG_FILE:-}" && -f "${CONFIG_FILE:-}" ]] && cfg+=(--global "$CONFIG_FILE")
    [[ -n "${AE_LOCAL_CONFIG:-}" && -f "${AE_LOCAL_CONFIG:-}" ]] && cfg+=(--local "$AE_LOCAL_CONFIG")
    _ae_core_preflight_try _manifest-render "$sessions_dir" "$sess" "$wdir" "$origin" "$mode" \
        "$main_pane" ${cfg[@]+"${cfg[@]}"}
}

# --- Agent launch helper (must be defined before dispatcher for _spawn) ---
# <pane> <cmd> <prompt> <meta-dir> <slot> [resume-id] [pre-injection-cmd]
send_agent_cmd() {
    local pane="$1" cmd="$2" prompt="$3" meta_dir="$4" slot="$5" resume_id="${6:-}" pre_injection_cmd="${7:-}"
    local tool_kind launch_cmd launch_script launch_exec current

    # THE KIND IS TRANSPORTED, not recovered from the wrapped string. By this point
    # $cmd may carry an `env OPENCODE_CONFIG=…` prefix whose value is shell-quoted, and
    # re-parsing that is the same disease as re-deriving the resume id (#30), the
    # injection boundary (#43) and the manifest tool (#46). The pre-injection command is
    # what ae composed from config: the binary is word one, no prefixes, no prose.
    tool_kind="$(tool_kind_from_cmd "${pre_injection_cmd:-$cmd}")"
    launch_cmd="$(build_launch_command "$cmd" "$prompt" "$resume_id" "$pre_injection_cmd")"
    # Checked assignment, not a bare one: `x="$(fn)"` swallows the failure
    # wherever errexit is suspended (any caller reached through if/&&/||), and
    # the empty capture would then be pasted into the pane as a command. An
    # agent we cannot write a launch script for does not get started quietly.
    if ! launch_script="$(write_launch_script "$meta_dir" "$slot" "$launch_cmd" "$resume_id" "$pre_injection_cmd")"; then
        echo "ae: could not write the launch script for '${slot}' — agent not started" >&2
        return 1
    fi
    launch_exec="$(shell_quote "$launch_script")"

    # || true: fire-and-forget launch paste (of the launch command into the
    # shell) must not abort the launch on an unconfirmed submit — see the 3
    # $prompt sites. Safe today (shell tool -> return 0), guarded defensively.
    tmux_paste_submit "$pane" "$launch_exec" || true
    # Brief wait to confirm launch started (don't block attach on slow agent init)
    wait_for_agent_start "$pane" "$tool_kind" 10 || true

    # DELIVERY MODE ASKS THE SAME PREDICATE, not a second glob. codex resume does not
    # accept an inline prompt, so build_launch_command leaves it off and it is delivered
    # once the UI returns; a FRESH codex carries it inline and must NOT also get it
    # deferred. Both halves now read one answer computed from the transported id and the
    # transported boundary.
    if _launch_is_resume "$cmd" "$resume_id" "$pre_injection_cmd" && [[ "$(tool_kind_from_cmd "$cmd")" == codex ]]; then
        if [[ -n "$prompt" ]]; then
            (
                # fd 8 is the caller's LIFECYCLE LOCK. This subshell
                # outlives send_agent_cmd and a child INHERITS the
                # descriptor, so the parent's `exec 8>&-` closes only its
                # own copy and the lock stays held until this prompt lands —
                # a competing `ae end` then blocks on a launch that already
                # finished. Close it here; nothing in here needs it. (Same
                # class as 12th review I1, where SID-capture children held
                # it; that one was solved by releasing before the spawn,
                # which is not available now that the lock must cover the
                # launch-script writes these very branches follow.)
                exec 8>&-
                _deliver_launch_prompt "$pane" codex "$prompt" "$meta_dir" "$slot"
            ) &
        fi
        return 0
    fi

    # No opencode branch here any more: its context rides OPENCODE_CONFIG as
    # system-level instructions, so there is no launch-time paste to defer. codex
    # resume above is the only remaining deferred delivery.
}

# LAUNCH-TIME DELIVERY, GATED. This branch used to be `sleep 3 && if
# pane_current_command == <tool>; then paste || true`: a fixed delay guessing at
# start-up, a PROCESS-NAME check that says the binary is running rather than that it
# can accept input, and fire-and-forget on failure. A 3-second guess against a
# 30-second MCP cold start is not close, and nothing recorded the miss.
#
# It is not hypothetical. On 2026-08-15 the watchdog RECOVERED a wedged codex worker
# through exactly this path; the task landed only because the resumed session could
# reconstruct it from its own conversation history. Delivery was never confirmed —
# it was lucky.
#
# Same bounded readiness wait as the spawn path, and the same rule on timeout: do NOT
# paste into a state we could not confirm, and never fail silently. This runs
# detached from the launching shell, so "loud" has to mean DURABLE — stderr here goes
# to a pane nobody is reading. The text is written next to the session and an event is
# emitted, mirroring the spawn path's undelivered-brief contract.
_deliver_launch_prompt() { # <pane> <tool_kind> <prompt> <meta_dir> <slot>
    local pane="$1" tool_kind="$2" prompt="$3" meta_dir="$4" slot="$5"
    local _rc=0 _reason=""
    # 45s, not 30: codex's own per-server startup_timeout_sec is 30, so a 30s window
    # expires at exactly the moment the tool gives up and settles. Wait past its
    # deadline, not up to it.
    if _wait_input_ready "$pane" "$tool_kind" 90; then
        # NO select-pane. It was BARE under the detached subshell's inherited errexit,
        # so a pane vanishing between readiness and selection — normal once the
        # lifecycle fd closes: a stop, an end, the tool exiting — aborted the function
        # BEFORE the rc, the preserved text and the launch-delivery-failed event. The
        # failure reporter dying silently is the exact class this slice exists to kill.
        # DELETED rather than status-captured, because it should never have been here:
        # paste-buffer -t / send-keys -t write to the NAMED pane, focus is not part of
        # any TUI's submission contract, and selecting mid-send routes the human's
        # in-flight keystrokes into the target — acute under lead-pair, where lead and
        # colead share window 0. Only the `focus` helper may select panes.
        tmux_paste_submit "$pane" "$prompt" || _rc=$?
        if ((_rc != 0)); then
            _reason="submit UNCONFIRMED (tmux_paste_submit rc=${_rc}) — it may be staged unsent"
        fi
    else
        _rc=1
        _reason="input never reached a confirmed-ready state within 45s (still initializing, busy, modal, or unreadable)"
    fi
    if ((_rc == 0)); then
        return 0
    fi
    local _file="${meta_dir}/undelivered.launch-${slot}.txt"
    printf '%s' "$prompt" >"$_file" 2>/dev/null || _file=""
    [[ -n "$_file" ]] && chmod 600 "$_file" 2>/dev/null
    _spawn_emit_event "$meta_dir" ae "$slot" launch-delivery-failed \
        "launch prompt NOT delivered to ${slot} (${tool_kind}, pane ${pane}): ${_reason}" 2>/dev/null || true
    echo "ae: LAUNCH PROMPT NOT DELIVERED to ${slot} (pane ${pane}): ${_reason}" >&2
    if [[ -n "$_file" ]]; then
        echo "ae: the text is preserved at ${_file}" >&2
    fi
    return 1
}

# --- ae orchestrator: meta-agent launcher (deprecated alias: ae hub) ---
# Copy one template file to its destination, NO overwrite, substituting a single
# __PLACEHOLDER__ via bash param expansion (no sed → safe with '/' in the value).
# Reports created vs skipped per file so partial dirs are handled explicitly.
_orchestrator_scaffold_file() {
    local src="$1" dst="$2" content
    shift 2 # remaining args are placeholder/value pairs
    if [[ -e "$dst" ]]; then
        echo "  skipped (exists): $dst"
        return 0
    fi
    content="$(cat "$src" 2>/dev/null)" || {
        echo "  ERROR reading template $src" >&2
        return 1
    }
    # Two-phase substitution so an inserted VALUE is never rescanned by a later
    # placeholder (codex: sequential ${//} reprocesses inserted text). Phase 1
    # maps every placeholder to a unique SOH-delimited sentinel (no values yet);
    # phase 2 maps sentinels to values. A real path value can't contain a \x01, so
    # phase-2 insertions can never collide — making it order-independent.
    local -a _ph _val
    local _n=0 soh=$'\x01'
    while (($# >= 2)); do
        _ph[_n]="$1"
        _val[_n]="$2"
        _n=$((_n + 1))
        shift 2
    done
    local _i
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${_ph[_i]}/${soh}${_i}${soh}}"
    done
    for ((_i = 0; _i < _n; _i++)); do
        content="${content//${soh}${_i}${soh}/${_val[_i]}}"
    done
    printf '%s\n' "$content" >"$dst" || {
        echo "  ERROR writing $dst" >&2
        return 1
    }
    echo "  created: $dst"
}

# Scaffold ~/.ae/orchestrator/{orchestrator.config,CHARTER.md} from contrib/aeorchestrator
# templates. Always scaffolds the NEW orchestrator layout; an existing legacy
# ~/.ae/meta-hub scaffold keeps working via the launch-time fallback below.
cmd_orchestrator_init() {
    local orchestrator_dir="${AE_ORCHESTRATOR_DIR:-$CONFIG_DIR/orchestrator}"
    # Reject a dir that would break the INI double-quoted instructions value.
    case "$orchestrator_dir" in
        *'"'* | *$'\n'*)
            echo "Error: AE_ORCHESTRATOR_DIR contains an unsupported character (quote/newline): $orchestrator_dir" >&2
            return 1
            ;;
    esac
    # Resolve template dir relative to THIS script (symlink-aware) with a
    # realpath/echo fallback — never hard-depend on readlink being present.
    local self tdir aemon_path charter_path helpers_dir
    self="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null ||
        echo "${BASH_SOURCE[0]:-$0}")"
    tdir="$(dirname "$self")/contrib/aeorchestrator"
    if [[ ! -d "$tdir" ]]; then
        echo "Error: orchestrator templates not found at $tdir." >&2
        echo "(single-file install?) Create $orchestrator_dir/orchestrator.config + CHARTER.md by hand." >&2
        return 1
    fi
    mkdir -p "$orchestrator_dir" || return 1
    # Canonicalize to an ABSOLUTE dir so a relative AE_ORCHESTRATOR_DIR doesn't bake a
    # relative charter path into orchestrator.config — `ae orchestrator` later cd's into the
    # dir, so `rel/CHARTER.md` would wrongly resolve to `rel/rel/CHARTER.md`.
    orchestrator_dir="$(cd "$orchestrator_dir" && pwd -P)" || return 1
    charter_path="$orchestrator_dir/CHARTER.md"
    aemon_path="$(dirname "$self")/contrib/aemonitor/aemonitor"
    # The orchestrator session is always named `orchestrator`; its helper scripts live here.
    # Baked into the charter so it's correct under any AE_HOME (default
    # ~/.ae/sessions/orchestrator, isolated e2e runs $AE_HOME/sessions/orchestrator) — never
    # the wrong (live) ~/.ae.
    helpers_dir="$CONFIG_DIR/sessions/orchestrator"
    echo "Scaffolding orchestrator into $orchestrator_dir:"
    # CHARTER.md first (the config points at it).
    _orchestrator_scaffold_file "$tdir/CHARTER.md" "$charter_path" \
        "__AEMONITOR_PATH__" "$aemon_path" "__HELPERS_DIR__" "$helpers_dir" || return 1
    _orchestrator_scaffold_file "$tdir/orchestrator.config" "$orchestrator_dir/orchestrator.config" "__CHARTER_PATH__" "$charter_path" || return 1
    echo
    echo "Done. Review/edit those files, then run: ae orchestrator"
}

cmd_orchestrator_help() {
    cat <<'EOF'
ae orchestrator — launch the orchestrator: your fleet's chief of staff. One ae session that
monitors all your other ae sessions, briefs you, relays your instructions to them,
and helps you hold an objective once you set one. `ae hub` is the deprecated alias.

  ae orchestrator           ensure the session is running (detached, isolated config)
  ae orchestrator --attach  switch/attach to it
  ae orchestrator --init    scaffold ~/.ae/orchestrator/{orchestrator.config,CHARTER.md} (never overwrites)
  ae orchestrator --help    this help

Config dir: ~/.ae/orchestrator (or $AE_HOME/orchestrator when AE_HOME is set; override with
AE_ORCHESTRATOR_DIR). A legacy ~/.ae/meta-hub scaffold (from 'ae hub --init') is still
honoured at launch and keeps its `hub` session name. See contrib/aeorchestrator/README.md.
EOF
}

# --- Dispatcher ---
# ── Session-helper template library ──────────────────────────────────
# Functions below are EMITTED into generated session helpers (_lib and
# the declare-f migrated helpers) via `declare -f` at the emission sites
# inside the SYNC_SESSION_ASSETS_BODY region. They are defined at top
# level BEFORE the dispatcher so every execution path — launch, and
# dispatcher subcommands like doctor --refresh (which awk-sources that
# region) — has them loaded prior to any emission. They execute inside a
# generated helper's runtime (after `source _lib`, which provides
# _AE_META_DIR/_AE_SESSION/_AE_SESSIONS_DIR): ae's own code paths must
# not call them. Shared bodies ae itself also uses (ae_json_escape,
# _event_json_str) live at their long-standing top-level sites instead.

helper_state_main() {
    # Both forms are the pinned Rust core's. The WRITE (P2.2) takes the
    # events.jsonl.lock, appends under it, prints `Marked …` only after the bytes
    # are down, and refuses a caller with no pane identity instead of writing
    # actor "human". The no-argument READ (P2.4) scans the same container and
    # renders the fields it read. The shim EXECs the core and never returns; with
    # no usable core it refuses (one line, exit 2).
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    _ae_core_try _state "$@"
}

# Resolve agent target to pane ID
# Supports: %pane-id, @session:agent-ref, bare-name
# Sets: AE_RESOLVED_PANE (pane ID), AE_RESOLVED_AGENT (canonical agent ref),
# AE_RESOLVED_SLOT (validated, else empty) — or returns non-zero with an error.
# AE_RESOLVED_SESSION left the contract with B glue cut 1: the frozen send body
# was its only reader, and a published global nobody reads is a claim the next
# caller will believe.
ae_resolve() {
    local target="$1"
    AE_RESOLVED_PANE=""
    AE_RESOLVED_AGENT=""
    AE_RESOLVED_SLOT=""

    # 1. Raw pane ID — pass through
    if [[ "$target" == %* ]]; then
        AE_RESOLVED_PANE="$target"
        local pane_agent pane_session
        pane_agent="$(tmux display-message -p -t "$target" '#{@ae_agent}' 2>/dev/null || true)"
        pane_session="$(tmux display-message -p -t "$target" '#S' 2>/dev/null || true)"
        AE_RESOLVED_SLOT="$(tmux display-message -p -t "$target" '#{@ae_slot}' 2>/dev/null || true)"
        _valid_slot "$AE_RESOLVED_SLOT" || AE_RESOLVED_SLOT=""
        if [[ -n "$pane_agent" ]]; then
            if [[ -n "$pane_session" && "$pane_session" != "$_AE_SESSION" ]]; then
                AE_RESOLVED_AGENT="${pane_session}:${pane_agent}"
            else
                AE_RESOLVED_AGENT="$pane_agent"
            fi
        fi
        return 0
    fi

    # 2. Cross-session: <session>:<name> is CANONICAL (identity v2 — a name never carries
    #    a colon, so one colon is unambiguous); @session:name stays accepted.
    local search_session="$_AE_SESSION"
    if [[ "$target" == @* || "$target" == *:* ]]; then
        if [[ "$target" != *:* ]]; then
            echo "Error: cross-session target must be <session>:<name>, got '${target}'" >&2
            return 1
        fi
        target="${target#@}"
        search_session="${target%%:*}"
        target="${target#*:}"
        if [[ -z "$search_session" || -z "$target" ]]; then
            echo "Error: cross-session target must be <session>:<name>" >&2
            return 1
        fi
        # Verify session exists in tmux
        if ! tmux has-session -t "$search_session" 2>/dev/null; then
            echo "Error: session '${search_session}' not found" >&2
            return 1
        fi
    fi

    # 3. Resolve within session. Identity v2: @ae_agent IS the name — exact match,
    #    nothing else (no alias, no partial). Ambiguity cannot arise: a name is one seat.
    local resolved="" resolved_agent=""
    while IFS=$'\t' read -r pid aagent; do
        if [[ "$aagent" == "${target}" ]]; then
            resolved="$pid"
            if [[ "$search_session" != "$_AE_SESSION" ]]; then
                resolved_agent="${search_session}:${aagent}"
            else
                resolved_agent="$aagent"
            fi
            break
        fi
    done < <(tmux list-panes -s -t "$search_session" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)

    if [[ -z "$resolved" ]]; then
        echo "Error: agent '${target}' not found in session '${search_session}'" >&2
        return 1
    fi

    # Output contract: consumers read these after calling ae_resolve.
    # shellcheck disable=SC2034
    AE_RESOLVED_PANE="$resolved"
    AE_RESOLVED_AGENT="$resolved_agent"
    AE_RESOLVED_SLOT="$(tmux display-message -p -t "$resolved" '#{@ae_slot}' 2>/dev/null || true)"
    _valid_slot "$AE_RESOLVED_SLOT" || AE_RESOLVED_SLOT=""
    return 0
}

ae_now_utc() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

ae_current_pane() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        printf '%s' "$TMUX_PANE"
    else
        tmux display-message -p '#{pane_id}' 2>/dev/null || true
    fi
}

ae_current_agent() {
    local pane
    pane="$(ae_current_pane)"
    [[ -n "$pane" ]] || return 0
    tmux display-message -p -t "$pane" '#{@ae_agent}' 2>/dev/null || true
}

# Whitelist a slot string before it is stored/compared (codex hazards: validate at the
# boundary). Accepts main, worker.<n>, spawned.<n>; anything else is treated as slotless.
_valid_slot() {
    # Anchored: exactly main / worker.<digits> / spawned.<digits> — a loose glob accepted
    # worker.0x, letting a malformed/tampered @ae_slot mint a bogus slotted event.
    [[ "$1" =~ ^(main|worker\.[0-9]+|spawned\.[0-9]+)$ ]]
}

# I1: stamp @ae_slot onto RUNNING panes that lack it, mapping each pane's
# @ae_agent (alias:name) to its meta slot. Idempotent — a pane with a valid
# @ae_slot is skipped — so it is safe to run at every launch (a no-op there, the
# panes are freshly stamped) AND at `doctor --refresh`, which is the point: a
# session started BEFORE slot-keyed identity landed carries no @ae_slot, so its
# new requests fall back to name matching until a full resume; this stamps live.
#
# Called from the SYNC_SESSION_ASSETS_BODY marker region so both launch (the
# real def) and refresh (the wrapper's awk-source of that region) run it. It is
# a column-0 fn — defined for BOTH the launch process and the doctor process —
# because the refresh path only awk-sources the marker BODY; a fn defined inside
# the launch block would be invisible there and break --refresh.
#
# tmux-server-aware WITHOUT AE_TMUX_SERVER: `doctor --refresh` runs from a plain
# shell where that env var is unset, so the server is read from the session's
# own meta (matches sync_existing_session_assets' watchdog-restart path).
_stamp_live_slots() {
    local sess="$1" meta_file="$2"
    [[ -n "$sess" ]] || return 0
    [[ -f "$meta_file" ]] || return 0
    local _srv
    _srv="$(grep '^tmux_server=' "$meta_file" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    local _srvk
    _srvk="$(grep '^tmux_server_kind=' "$meta_file" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    # Ambiguous record → display no-op (never fall to the ambient server).
    [[ "$_srvk" == "ambiguous" ]] && return 0
    local -a _st=(tmux) _sel=()
    if [[ -n "$_srv" ]]; then
        mapfile -t _sel < <(_srv_tmux_args "$_srvk" "$_srv")
        _st=(command tmux "${_sel[@]}")
    fi
    # Reverse map: alias:name (display, :uuid stripped) -> slot, from meta.
    # F5 (transition-only, best-effort): keyed by DISPLAY name — the churn-prone
    # key slot-identity exists to replace. Two panes sharing a display name in
    # ONE session would collapse (last-wins) -> a mis-stamp; distinct names are
    # the norm and a mis-route self-heals at the next resume, so this is an
    # acceptable limit for the one-shot live-transition stamp.
    local -A _slot_by_agent=()
    local _k _v _an
    while IFS='=' read -r _k _v; do
        case "$_k" in
            seat.main | seat.worker.* | seat.spawned.*) ;;
            *) continue ;;
        esac
        _an="$_v" # identity v2: the value IS the name (@ae_agent)
        [[ -n "$_an" ]] || continue
        _slot_by_agent["$_an"]="${_k#seat.}"
    done <"$meta_file"
    # Stamp each unstamped pane whose @ae_agent maps to a known slot. Delimiter is
    # '|' (ae's convention for pane parsing — see the list-panes callers), NOT a
    # tab: an UNSTAMPED pane has an EMPTY @ae_slot field, and tab is IFS-
    # whitespace, so `read` would COLLAPSE the empty middle field and mis-parse
    # the row — exactly the panes I1 must detect. '|' is non-whitespace, so empty
    # fields survive. Agent names/slots/pane-ids never contain '|'.
    local _pid _pslot _pagent _want
    while IFS='|' read -r _pid _pslot _pagent; do
        [[ -n "$_pid" ]] || continue
        # Idempotent: leave already-stamped panes untouched.
        if _valid_slot "$_pslot"; then
            continue
        fi
        [[ -n "$_pagent" ]] || continue
        _want="${_slot_by_agent[$_pagent]:-}"
        [[ -n "$_want" ]] || continue
        # || true: a pane vanishing mid-refresh must not abort the sourced BODY
        # (this runs under set -e in both the launch and doctor processes).
        "${_st[@]}" set-option -p -t "$_pid" @ae_slot "$_want" 2>/dev/null || true
    done < <("${_st[@]}" list-panes -s -t "$sess" -F '#{pane_id}|#{@ae_slot}|#{@ae_agent}' 2>/dev/null || true)
    return 0
}

ae_current_agent_ref() {
    local agent session pane
    agent="$(ae_current_agent)"
    [[ -n "$agent" ]] || return 0
    pane="$(ae_current_pane)"
    session="$(tmux display-message -p -t "${pane:-$_AE_SESSION}" '#S' 2>/dev/null || true)"
    if [[ -n "$session" && "$session" != "$_AE_SESSION" ]]; then
        printf '@%s:%s' "$session" "$agent"
    else
        printf '%s' "$agent"
    fi
}

ae_preview_text() {
    local text="$*"
    text="${text//$'\r'/}"
    text="${text//$'\n'/\\n}"
    text="${text//$'\t'/ }"
    printf '%.200s' "$text"
}

ae_log_append() {
    local file="$1" line="$2"
    {
        flock -w 5 8 || exit 1
        printf '%s\n' "$line" >>"$file"
    } 8>>"${file}.lock"
}

ae_log_read() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    {
        flock -s 8 || exit 1
        cat "$file"
    } 8<>"${file}.lock"
}

ae_emit_event() {
    local action="$1" target="${2:-}" ref="${3:-}" summary="${4:-}"
    local actor
    actor="${AE_SENDER_OVERRIDE:-$(ae_current_agent_ref)}"
    [[ -n "$actor" ]] || actor="human"
    local ts
    ts="$(date -u +%FT%TZ)"
    # Summary is capped and (for most events) flattened to one line. `chat`
    # events carry a human reply destined for Telegram, so they keep newlines
    # and get a larger cap (3500 — matches format_event's truncation, stays
    # under Telegram's 4096 limit). Either way ae_json_escape below turns any
    # newline into a literal \n, so events.jsonl stays one JSON object per line
    # — the invariant every line-oriented consumer (cmd_list, the watchdog
    # watchdog, the telegram tail) depends on.
    # Sanitising boundary: drop malformed UTF-8 before anything downstream sees
    # it. Agent/user text can arrive already invalid — truncation is not the only
    # way a bad byte reaches events.jsonl.
    ae_sanitize_utf8 "$summary"
    summary="$_EV_CLEAN"
    if [[ "$action" == "chat" ]]; then
        # chat KEEPS its newlines and tabs — it is a human reply bound for
        # Telegram, and ae_json_escape turns them into literal \n / \t further
        # down, so the one-object-per-line invariant still holds. Capping is
        # therefore the only transformation here.
        ae_cap_summary "$summary" 3500
        summary="$_EV_SUMMARY"
    else
        # Flatten first, then cap. Both substitutions are one character for
        # one, so the cut point is identical either way.
        summary="${summary//$'\n'/ }"
        summary="${summary//$'\t'/ }"
        ae_cap_summary "$summary" 200
        summary="$_EV_SUMMARY"
    fi
    local json
    json="$(printf '{"ts":"%s","actor":"%s","action":"%s"' \
        "$(ae_json_escape "$ts")" "$(ae_json_escape "$actor")" "$(ae_json_escape "$action")")"
    [[ -n "$target" ]] && json+="$(printf ',"target":"%s"' "$(ae_json_escape "$target")")"
    [[ -n "$ref" ]] && json+="$(printf ',"ref":"%s"' "$(ae_json_escape "$ref")")"
    # request-integrity: session-qualified SLOT identity (the churn-proof routing key).
    [[ -n "${_AE_EVENT_ACTOR_SLOT:-}" ]] && json+="$(printf ',"actor_slot":"%s"' "$(ae_json_escape "$_AE_EVENT_ACTOR_SLOT")")"
    [[ -n "${_AE_EVENT_ACTOR_SESSION:-}" ]] && json+="$(printf ',"actor_session":"%s"' "$(ae_json_escape "$_AE_EVENT_ACTOR_SESSION")")"
    [[ -n "${_AE_EVENT_TARGET_SLOT:-}" ]] && json+="$(printf ',"target_slot":"%s"' "$(ae_json_escape "$_AE_EVENT_TARGET_SLOT")")"
    [[ -n "${_AE_EVENT_TARGET_SESSION:-}" ]] && json+="$(printf ',"target_session":"%s"' "$(ae_json_escape "$_AE_EVENT_TARGET_SESSION")")"
    [[ -n "$summary" ]] && json+="$(printf ',"summary":"%s"' "$(ae_json_escape "$summary")")"
    # The summary is capped; this is where the whole thing lives.
    [[ -n "${_AE_LAST_BODY_FILE:-}" ]] && json+="$(printf ',"body_file":"%s"' "$(ae_json_escape "$_AE_LAST_BODY_FILE")")"
    json+="}"
    ae_log_append "${_AE_META_DIR}/events.jsonl" "$json"
}

# Capture the pane's INPUT REGION with SGR escape sequences PRESERVED (capture-pane -e).
# tail -N was geometry-blind: a top-anchored TUI input box can sit far above the pane
# bottom, so a fixed bottom slice misses the live input and catches transcript echo
# instead (the F4 false-positive class). A fixed look-back (the old cy-8) was an INVENTED
# bound — the deepest real fixture was 4 rows, a sample not a limit — so a legal 10-row
# multiline input hid its prompt above the window, no prompt was found, and post-submit
# mapped that to "clear" = false success = silent loss (colead BLOCKER 2, reproduced).
# ONE sensor, TWO consumers (_paste_input_busy pre-paste, _paste_still_staged
# post-submit). UNREADABLE DIRECTIONS DIFFER, deliberately: unreadable -> empty output;
# _paste_input_busy treats empty as UNSAFE (fail-closed: defer, never clobber), while
# _paste_still_staged maps indeterminate to "clear" — the F4 compromise that trades a
# rare missed retry for never duplicating an already-sent message.
_capture_input_region() {
    # The WHOLE visible pane. Bounding the bottom at [0 .. cursor_y] was wrong in the
    # DANGEROUS direction: cursor_y is the EDIT position, not the end of the input. A
    # multiline draft keeps real unsent rows BELOW the cursor after cursor navigation or
    # a leading blank line; -E cursor_y dropped them, the sensor read IDLE, and the
    # pre-paste guard would CLOBBER a live draft (colead ROUND4 BLOCKER, reproduced on
    # real tmux: prompt row 0, unsent continuation row 1, cursor parked back on row 0 ->
    # region held only the ornament row -> IDLE). The region therefore no longer depends
    # on where the edit cursor happens to sit.
    # Rows ABOVE the input are transcript, and the structural anchor
    # (_input_region_prompt_seg) picks the live prompt out of them; rows BELOW it are the
    # box's chrome, which _input_region_content_end excludes. Extra context is inert — a
    # slightly bigger capture is the right trade against both a false success and a
    # clobber.
    local pane="$1"
    tmux capture-pane -e -p -t "$pane" -S 0 2>/dev/null || true
    return 0
}

# Reconstruct a one-line notice from a captured input box.  Claude and Codex both
# render wrapped continuation rows with TWO leading spaces, while capture-pane drops
# the visual wrap-space at the row boundary.  The intended notice is already known at
# this point (it is the exact text staged in the buffer), so reinsert ONE space only
# when the joined bytes are an exact prefix of that notice.  No other whitespace is
# normalised: this is a byte-preserving proof, not a pretty-printer.
_notice_reconstruct() { # <tool> <capture> <intended> -> reconstructed notice
    local tool="$1" capture="$2" intended="$3"
    local head line prefix part candidate="" rest j i
    local -a rows=()
    # The fixture captures are plain, while the real sensor preserves SGR. Strip CSI
    # styling only; printable bytes (including NBSP) remain data for the join.
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(printf '%s' "$line" | sed $'s/\033\\[[0-9;?]*[ -\/]*[@-~]//g')"
        rows[${#rows[@]}]="$line"
    done <<<"$capture"
    # The head includes the request id, which disambiguates whole-pane captures with
    # several historical notices in the transcript. Message and spawn heads are
    # deliberately distinct: spawn is an instruction, not transcript chat.
    head="${intended%% LONG BODY*}"
    [[ -n "$head" && "$head" != "$intended" ]] || head="⟦ae:msg from"
    if [[ "$head" != "⟦ae:msg from" ]]; then
        case "$head" in
            ⟦ae:msg\ from\ * | ⟦ae:task⟧\[*\]) ;;
            *) return 1 ;;
        esac
    fi
    for ((i = 0; i < ${#rows[@]}; i++)); do
        line="${rows[i]}"
        [[ "$line" == *"$head"* ]] || continue
        prefix="${line%%"$head"*}"
        case "$tool" in
            claude)
                [[ "$prefix" == *❯* ]] || continue
                prefix="${prefix%%❯*}"
                ;;
            codex)
                [[ "$prefix" == *›* ]] || continue
                prefix="${prefix%%›*}"
                ;;
            *) return 1 ;;
        esac
        # A transcript line may contain the same bytes, but it is not a prompt row.
        [[ -z "${prefix//[[:space:]]/}" ]] || continue
        case "$tool" in
            claude) line="${line#*❯}" ;;
            codex) line="${line#*›}" ;;
        esac
        case "$line" in
            " "*) line="${line# }" ;;
            $'\u00a0'*) line="${line#$'\u00a0'}" ;;
        esac
        candidate="$line"
        for ((j = i + 1; j < ${#rows[@]}; j++)); do
            rest="${rows[j]}"
            while [[ "$rest" == *" " ]]; do rest="${rest% }"; done
            if [[ "$tool" == codex && -z "${rest//[[:space:]]/}" ]]; then
                break
            fi
            if [[ "$tool" == claude && "$rest" =~ ^[[:space:]]*─+[[:space:]]*$ ]]; then
                break
            fi
            [[ "$rest" == "  "* ]] || break
            part="${rest:2}"
            # Reinsert exactly the one wrap-space proven by the intended bytes.
            if [[ "$intended" == "$candidate"* ]]; then
                rest="${intended:${#candidate}}"
                [[ "$rest" == " "* ]] && candidate+=" "
            fi
            candidate+="$part"
        done
        printf '%s' "$candidate"
        return 0
    done
    return 1
}

# Cheap proof gate: sentinels catch a clipped head/tail before the full byte compare.
# Older measurement captures predate the terminal id sentinel; their exact companion
# notice still gets compared, while current v4 notices require both sentinels.
_notice_prove() { # <tool> <capture> <intended> -> 0 exact, 1 unconfirmed
    local tool="$1" capture="$2" intended="$3" candidate head id
    candidate="$(_notice_reconstruct "$tool" "$capture" "$intended")" || return 1
    head="${intended%% LONG BODY*}"
    [[ "$head" != "$intended" ]] || head="⟦ae:msg from"
    case "$head" in
        ⟦ae:msg\ from\ * | ⟦ae:task⟧\[*\] | "⟦ae:msg from") ;;
        *) return 1 ;;
    esac
    [[ "$head" != "$intended" && "$candidate" == "$head"* ]] || return 1
    if [[ "$head" =~ \[([^]]+)\] ]]; then
        id="${BASH_REMATCH[1]}"
        if [[ "$intended" == *"⟧${id}⟧" ]]; then
            [[ "$candidate" == *"⟧${id}⟧" ]] || return 1
        fi
    fi
    [[ "$candidate" == "$intended" ]]
}

# Compose the small pointer that replaces an oversized framed body.  The body file is
# sender-owned; only its path crosses the pane.  Same-session recipients get the
# session-relative messages/*.txt grammar, while cross-session requests receive the
# absolute sender path and reply helper.  Globals are used deliberately so callers do
# not lose the mode/payload through command substitution under errexit.
_notice_compose() { # <action> <ref> <actor> <body-file> <target-session>
    local action="$1" ref="$2" actor="$3" body_file="$4" target_session="$5"
    local body_name body_path bytes reply_tail notice
    body_name="${body_file##*/}"
    [[ "$body_name" == *.txt ]] || return 1
    if [[ -n "${_AE_SESSION:-}" && "$target_session" == "$_AE_SESSION" ]]; then
        body_path="messages/${body_name}"
    else
        body_path="$body_file"
    fi
    bytes="$(wc -c <"$body_file" 2>/dev/null | tr -d '[:space:]')"
    [[ "$bytes" =~ ^[0-9]+$ ]] || return 1
    case "$action" in
        spawn)
            notice="⟦ae:task⟧[${ref}] LONG BODY ${bytes} B in your session dir: ${body_path} — read it fully, then begin ⟧${ref}⟧"
            ;;
        ask | review | reply)
            [[ -n "$ref" ]] || return 1
            if [[ "$body_path" == messages/* ]]; then
                reply_tail="then run your reply helper: reply ${ref} ⟧${ref}⟧"
                notice="⟦ae:msg from ${actor}⟧[${ref}] LONG BODY ${bytes} B in your session dir: ${body_path} — read it first; ${reply_tail}"
            else
                reply_tail="reply: ${_AE_META_DIR}/reply ${ref} ⟧${ref}⟧"
                notice="⟦ae:msg from ${actor}⟧[${ref}] LONG BODY ${bytes} B: ${body_path} — read it first; ${reply_tail}"
            fi
            ;;
        *)
            notice="⟦ae:msg from ${actor}⟧[-] LONG BODY ${bytes} B in your session dir: ${body_path} — read it first ⟧-⟧"
            ;;
    esac
    # A notice above this cap cannot be safely treated as a small pointer. Refuse it
    # before any paste; the full body remains recoverable at body_file. This is a
    # local pre-paste refusal, so callers report stderr only and emit no delivery event.
    [[ "$(printf '%s' "$notice" | wc -c | tr -d '[:space:]')" -le 300 ]] || return 1
    _NOTICE_PAYLOAD="$notice"
    return 0
}

_notice_prepare() { # <tool> <action> <ref> <actor> <target-session> <body-file> <direct>
    local tool="$1" action="$2" ref="$3" actor="$4" target_session="$5" body_file="$6" direct="$7"
    local bytes
    _NOTICE_MODE=direct
    _NOTICE_PAYLOAD="$direct"
    case "$tool" in claude | codex) ;; *) return 0 ;; esac
    bytes="$(wc -c <"$body_file" 2>/dev/null | tr -d '[:space:]')"
    [[ "$bytes" =~ ^[0-9]+$ ]] || return 1
    ((bytes <= 8192)) && return 0
    _notice_compose "$action" "$ref" "$actor" "$body_file" "$target_session" || return 1
    _NOTICE_MODE=notice
    return 0
}

# One measurable clear-and-retry is permitted after a notice proof failure. A changed
# capture is not proof: a footer redraw can change bytes while the old pointer remains
# staged. Require the modeled sensor to report a POSITIVE EMPTY input region after C-u;
# indeterminate and occupied both leave the pane untouched (in particular, no Enter).
_notice_clear_measurable() { # <pane> <tool> <before-capture> -> 0 clear observed
    local pane="$1" tool="$2" after occupancy=2
    tmux send-keys -t "$pane" C-u 2>/dev/null || return 1
    sleep 0.1
    after="$(_capture_input_region "$pane")"
    [[ -n "$after" ]] || return 1
    if _input_region_occupied "$pane" "$tool"; then
        occupancy=0
    else
        occupancy=$?
    fi
    ((occupancy == 1))
}

_notice_repaste() { # <buffer> <notice> <pane> -> stage the notice again
    local buf="$1" notice="$2" pane="$3"
    printf '%s' "$notice" | tmux load-buffer -b "$buf" - 2>/dev/null || return 1
    tmux paste-buffer -d -p -b "$buf" -t "$pane" 2>/dev/null
}

# Parse a captured region into styled SEGMENTS: parallel arrays _SGR_BOLD/_SGR_DIM/
# _SGR_TEXT/_SGR_LINE, one entry per run of text sharing an SGR state. Parses SGR
# *state* — params, grouping and resets — never byte literals: tmux legally serializes
# the SAME visual state many ways ($'\e[1m›', $'\e[0;1m›', $'\e[2m…\e[1m›'), so an
# exact-byte anchor is unsound and mis-reads real panes (colead BLOCKER 1, reproduced in
# isolated tmux). Only intensity matters here: 1 = bold on, 2 = dim on, 0/22 = both off;
# an extended-colour introducer (38/48) has its arguments skipped so a nested '1'/'2'
# parameter is never mistaken for bold/dim.
# Segments NEVER span a newline: _SGR_LINE[i] is the segment's row in the region, which
# is what lets the prompt rule be STRUCTURAL (line-leading) and not a wildcard — see
# _input_region_prompt_seg (colead NEW BLOCKER 1).
_sgr_parse() {
    _SGR_BOLD=()
    _SGR_DIM=()
    _SGR_TEXT=()
    _SGR_LINE=()
    local rest="$1" bold=0 dim=0 line=0 body seq rem final params text chunk
    local -a ps
    local j v
    while [[ -n "$rest" ]]; do
        # `capture-pane -e` preserves OSC hyperlinks (Claude's status footer uses
        # them). OSC is terminal control data, not printable pane content; consume
        # it through BEL or ST so zero-width hyperlinks cannot inflate a row and make
        # the input border look like occupied text.
        if [[ "$rest" == $'\e]'* ]]; then
            rest="${rest:2}"
            while [[ -n "$rest" ]]; do
                if [[ "${rest:0:1}" == $'\a' ]]; then
                    rest="${rest:1}"
                    break
                elif [[ "$rest" == $'\e\\'* ]]; then
                    rest="${rest:2}"
                    break
                elif [[ "${rest:0:1}" == $'\n' ]]; then
                    # An unterminated OSC cannot consume the next capture row.
                    # Treat the row boundary as the control's end and let the
                    # outer parser account for it normally.
                    rest="${rest:1}"
                    line=$((line + 1))
                    break
                fi
                rest="${rest:1}"
            done
            continue
        fi
        if [[ "$rest" == $'\e['* ]]; then
            body="${rest#$'\e['}"
            seq="${body%%[a-zA-Z]*}"
            rem="${body#"$seq"}"
            final="${rem:0:1}"
            rest="${rem:1}"
            [[ "$final" == "m" ]] || continue # non-SGR CSI: consumed, no state change
            params="${seq:-0}"
            IFS=';' read -ra ps <<<"$params"
            j=0
            while ((j < ${#ps[@]})); do
                v="${ps[j]:-0}"
                case "$v" in
                    "" | 0)
                        bold=0
                        dim=0
                        ;;
                    1) bold=1 ;;
                    2) dim=1 ;;
                    21 | 22)
                        bold=0
                        dim=0
                        ;;
                    38 | 48)
                        # 38;5;N (256) or 38;2;R;G;B (truecolour) — skip the arguments
                        if [[ "${ps[j + 1]:-}" == "5" ]]; then
                            ((j += 2))
                        elif [[ "${ps[j + 1]:-}" == "2" ]]; then
                            ((j += 4))
                        fi
                        ;;
                esac
                j=$((j + 1))
            done
            continue
        fi
        if [[ "$rest" == $'\e'* ]]; then
            # A non-CSI escape (charset designator $'\e(B', $'\e7'…). tmux -e emits SGR
            # only, so this is defensive — but it MUST consume bytes: the old loop took
            # this branch, matched an empty text run and spun FOREVER. Drop the whole
            # sequence (ESC + intermediates + one final byte) rather than just the ESC,
            # so a designator's final ('B' of $'\e(B') can't leak into a text run and
            # read as input content — a false OCCUPIED is the F4 duplication class.
            rest="${rest:1}"
            while [[ -n "$rest" ]]; do
                case "${rest:0:1}" in
                    ' ' | '!' | '"' | '#' | '$' | '%' | '&' | "'" | '(' | ')' | '*' | '+' | ',' | '-' | '.' | '/')
                        rest="${rest:1}" # intermediate byte, more to come
                        ;;
                    *)
                        rest="${rest:1}" # final byte: sequence complete
                        break
                        ;;
                esac
            done
            continue
        fi
        text="${rest%%$'\e'*}"
        rest="${rest#"$text"}"
        [[ -n "$text" ]] || continue
        # Split the run at newlines so every segment belongs to exactly ONE row.
        while [[ "$text" == *$'\n'* ]]; do
            chunk="${text%%$'\n'*}"
            text="${text#*$'\n'}"
            if [[ -n "$chunk" ]]; then
                _SGR_BOLD+=("$bold")
                _SGR_DIM+=("$dim")
                _SGR_TEXT+=("$chunk")
                _SGR_LINE+=("$line")
            fi
            line=$((line + 1))
        done
        if [[ -n "$text" ]]; then
            _SGR_BOLD+=("$bold")
            _SGR_DIM+=("$dim")
            _SGR_TEXT+=("$text")
            _SGR_LINE+=("$line")
        fi
    done
    return 0
}

# STRUCTURAL prompt selection over a parsed region: find the live input prompt by the
# only property that separates it from transcript — the ornament is the FIRST
# non-whitespace cell of its ROW, and the BOTTOM-MOST such row wins (the input box sits
# below the transcript; the capture stops at the cursor, which is inside the box).
# Sets _SGR_PROMPT_SEG (segment index), _SGR_PROMPT_TAIL (that segment's text from the
# ornament onward) and _SGR_PROMPT_ORN (which ornament matched, so a multi-ornament tool
# can strip exactly its own anchor). Returns 1 when no row qualifies -> indeterminate.
#
# Style alone was NOT enough (colead NEW BLOCKER 1): once the capture widened past a
# fixed look-back the whole transcript came into view, and a wildcard '*›*' over bold-and-
# not-dim segments matched bold assistant PROSE ($'\e[1mAnalysis › outcome') as a live
# prompt — a DELIVERED message then read as staged, the sender re-pressed Enter and the
# F4 duplication class reopened. Structure alone is not enough either: a submitted echo
# IS line-leading, and is excluded by style (bold AND dim). Both rules, together.
#
# live_only=1 requires bold && !dim (codex, whose echo is bold+dim). Ornaments are
# matched as literal PREFIXES, never a bracket class: '›'/'❯' are multibyte and a
# bracket expression matches per-byte under LC_ALL=C (the queued locale slice's bug).
_input_region_prompt_seg() { # <live_only:0|1> <ornament>... -> 0 + _SGR_PROMPT_SEG/_TAIL
    local live_only="$1"
    shift
    _SGR_PROMPT_SEG=-1
    _SGR_PROMPT_TAIL=""
    _SGR_PROMPT_ORN=""
    # Callers always _sgr_parse first, but this is emitted into _lib where a future one
    # might not: subscripting an UNDECLARED array under `set -u` aborts the whole helper
    # (the repo's documented hazard). No segments parsed == no prompt, which is exactly
    # what an unparsed region should report.
    [[ -n "${_SGR_TEXT+x}" ]] || return 1
    local n=${#_SGR_TEXT[@]}
    ((n > 0)) || return 1
    local maxline=${_SGR_LINE[n - 1]}
    local line i lead rest orn found
    for ((line = maxline; line >= 0; line--)); do
        found=-1
        for ((i = 0; i < n; i++)); do
            [[ "${_SGR_LINE[i]}" == "$line" ]] || continue
            # Leading whitespace is not content: tmux legally paints the cells before a
            # live ornament ($'\e[2m  \e[0;1m›' — colead's isolated-tmux serialization),
            # so the run holding them is skipped, not treated as text.
            [[ -z "${_SGR_TEXT[i]//[[:space:]]/}" ]] && continue
            found=$i
            break
        done
        ((found >= 0)) || continue
        lead="${_SGR_TEXT[found]}"
        rest="${lead#"${lead%%[![:space:]]*}"}" # from the row's first non-blank cell
        for orn in "$@"; do
            [[ "$rest" == "$orn"* ]] || continue
            if ((live_only == 1)); then
                [[ "${_SGR_BOLD[found]}" == 1 && "${_SGR_DIM[found]}" == 0 ]] || continue
            fi
            _SGR_PROMPT_SEG=$found
            _SGR_PROMPT_TAIL="$rest"
            _SGR_PROMPT_ORN="$orn"
            return 0
        done
    done
    return 1
}

# Where the input box ENDS: the first CHROME row below the prompt, exclusive. Sets
# _SGR_CONTENT_END (a line index; rows >= it are not input).
#
# This replaces cursor_y as the bottom bound. The cursor could not do this job — it marks
# the EDIT position, so a draft can extend below it (colead ROUND4 BLOCKER) — but
# something must, because the capture now runs to the pane bottom and every input box has
# chrome under it. Counting chrome as content is the OPPOSITE failure and it is worse
# than it looks: an idle pane would read OCCUPIED forever, every send would defer, and
# that is the ri-3 fleet-wide comms outage. So this bound is load-bearing in BOTH
# directions — too high clobbers a draft, too low blocks all delivery.
#
# Is this row the input box's structural BORDER, as opposed to draft content that merely
# begins with the same glyph? POSITIVE identification, on two properties measured from
# real v2.1.209 captures — a border row's printable content is ENTIRELY U+2500, AND it
# spans the full width of the region (the box is drawn edge to edge, so it is always the
# widest row; text rows are shorter because tmux strips their trailing blanks).
#
# A first-cell glyph test is NOT enough and shipped as a clobber (colead ROUND5 BLOCKER
# 1): a user pasting '─ user-pasted heading' into a draft truncated the region there, and
# the unsent body below it read IDLE -> pre-paste safe -> overwrite. On the real rig
# capture that row is 23 cells of mixed characters against the box's 167 of pure U+2500,
# so it fails BOTH properties. The welcome box's rows ('╭───', '│', '╰───') fail the
# morphology test too.
#
# Residual, in the SAFE direction: a draft row that is BOTH pure U+2500 AND exactly the
# full width is indistinguishable from a border — it is a border, morphologically. Also
# ${#s} counts characters under the fleet's C.UTF-8 but BYTES under LC_ALL=C, where a
# border (3 bytes/glyph) still measures longest, so the test holds; if it ever did not,
# no border is found, chrome counts as content, and the read is OCCUPIED -> defer (loud),
# never a clobber. The locale slice owns the general case.
_input_region_is_border() { # <row-printable-text> <region-max-width>
    local row="$1" maxw="$2"
    [[ -n "$row" ]] || return 1
    [[ -z "${row//─/}" ]] || return 1 # morphology: nothing but U+2500
    ((${#row} == maxw)) || return 1   # position: drawn edge to edge
    return 0
}

# The boundary is per-tool because the two real layouts differ (live captures,
# 2026-07-15) — each tool is given the row that actually closes ITS box:
#   claude ('border') — the box's BOTTOM BORDER sits directly under the input (a row
#           whose first non-blank cell is '─'), then the model/status rows and specimen
#           #5's 'paste again to expand' hint. Claude must NOT stop at a blank row: a
#           draft can contain one, and clipping there would drop the rows below it.
#   codex  ('blank')  — no bottom border at all: a BLANK row, then the model/path footer
#           ('  gpt-5.6-sol xhigh · ~/projects/clemens33/ae').
# Deliberately NOT "the pane's last non-blank row is the footer": that guesses chrome
# from position, and with no footer present it clips the draft's last row instead —
# the clobber direction, caught by the fixtures.
_input_region_content_end() { # <prompt_line> <stop_at: border|blank>
    local pl="$1" stop_at="$2" n=${#_SGR_TEXT[@]} i line
    local -a nonblank=() rowtext=()
    _SGR_CONTENT_END=$((${_SGR_LINE[n - 1]} + 1)) # default: everything below the prompt
    # Rebuild each row's printable text: a border must be judged on the WHOLE row, never
    # on its first cell (colead ROUND5 BLOCKER 1 — see _input_region_is_border).
    local maxw=0 w
    for ((i = 0; i < n; i++)); do
        line=${_SGR_LINE[i]}
        rowtext[line]="${rowtext[line]:-}${_SGR_TEXT[i]}"
    done
    for line in "${!rowtext[@]}"; do
        w=${#rowtext[line]}
        if ((w > maxw)); then maxw=$w; fi
    done
    for ((i = 0; i < n; i++)); do
        line=${_SGR_LINE[i]}
        ((line > pl)) || continue
        ((line < _SGR_CONTENT_END)) || continue
        [[ -z "${_SGR_TEXT[i]//[[:space:]]/}" ]] && continue
        nonblank[line]=1
        if [[ "$stop_at" == "border" ]] && _input_region_is_border "${rowtext[line]}" "$maxw"; then
            _SGR_CONTENT_END=$line
        fi
    done
    if [[ "$stop_at" == "blank" ]]; then
        # The LAST blank row below the prompt — codex's separator above the footer.
        # Deliberately not the FIRST: a draft carries its own blank rows (an empty first
        # line, a paragraph break), and stopping at one of those drops the real text
        # below it -> false IDLE -> clobber. That is the same class as the cursor bound
        # this replaced, so the bound has to be the LAST one to stay on the safe side.
        for ((line = _SGR_CONTENT_END - 1; line > pl; line--)); do
            if [[ -z "${nonblank[line]:-}" ]]; then
                _SGR_CONTENT_END=$line
                break
            fi
        done
    fi
    return 0
}

# Occupancy of the target's live input box (colead characterization, 2026-07-14/15).
# PER-TOOL — the "empty" tell differs. Returns:
#   0 = OCCUPIED       real typed/staged content sits in the input
#   1 = IDLE           bare ornament / a dim placeholder suggestion only
#   2 = INDETERMINATE  no live prompt in view / unreadable — callers fail-closed
#                      their OWN way (pre-paste busy => UNSAFE, post-submit staged
#                      => CLEAR/non-regressive).
_input_region_occupied() {
    local pane="$1" tool="$2" region
    region="$(_capture_input_region "$pane")"
    [[ -n "$region" ]] || return 2 # unreadable
    case "$tool" in
        codex)
            # Live input starts at the last BOLD-ONLY prompt $'\e[1m›'. A SUBMITTED
            # transcript echo is BOLD+DIM $'\e[1;2m›' — excluded, so cursor-region
            # isolation kills the F4 transcript-echo false-positive by style+geometry,
            # NOT a content grep (live repro 2026-07-14: '\e[1;2m› \e[0mMemo read …').
            # From the live prompt to the cursor: drop the DIM (SGR 2) placeholder-
            # suggestion span, strip remaining SGR + ornament + whitespace; ANY
            # printable remainder — INCLUDING the unstyled '[Pasted Content N chars]'
            # staging token — is OCCUPIED. (Re-enables codex staged detection safely;
            # supersedes the ri-2 DO-NOT-RE-ADD note, whose transcript-echo objection
            # stays correct and is what cursor-region isolation now resolves. Live
            # repro: staged '[Pasted Content 1469 chars]' — the old detector returned
            # clear and would have logged a false success = silent loss.)
            local i live s
            _sgr_parse "$region"
            # The LIVE prompt is the bottom-most ROW whose first non-blank cell is the
            # ornament in BOLD-and-NOT-DIM state; a submitted transcript echo is the
            # same ornament BOLD-AND-DIM, and bold prose carrying a '›' mid-row is
            # transcript regardless of style. State, not bytes: $'\e[2m…\e[1m›' leaves
            # DIM active (an echo) while $'\e[2m…\e[0;1m›' resets first (live) —
            # visually identical prefixes, opposite meanings.
            _input_region_prompt_seg 1 '›' || return 2 # no live prompt (mid-gen/abnormal)
            live=$_SGR_PROMPT_SEG
            _input_region_content_end "${_SGR_LINE[live]}" blank
            # Content = everything after the ANCHOR ornament only. Removing every '›'
            # in the region (the old tr -d) made a user-typed ornament vanish, reading
            # real input as idle and permitting a clobber — violating the very class
            # rule this sensor enforces (colead BLOCKER 3). Strip the anchor, keep all
            # printable content that follows it, including further ornaments.
            s="${_SGR_PROMPT_TAIL#*›}"
            for ((i = live + 1; i < ${#_SGR_TEXT[@]}; i++)); do
                # Below the box (blank row + model/path footer) is chrome, not input.
                ((_SGR_LINE[i] < _SGR_CONTENT_END)) || break
                # DIM-state text is the placeholder suggestion — not user content.
                [[ "${_SGR_DIM[i]}" == 1 ]] && continue
                s+="${_SGR_TEXT[i]}"
            done
            s="${s//$'\xc2\xa0'/ }"
            s="$(tr -d '\n\t ' <<<"$s")"
            # ANY unstyled printable remainder is OCCUPIED — including the unstyled
            # '[Pasted Content N chars]' staging token(s), chunked multi-token rows and
            # a leaked plaintext tail (occurrence #3). The token text is documentation,
            # never the predicate: the CLASS (unstyled printable) is the rule.
            [[ -n "$s" ]] && return 0 || return 1
            ;;
        claude)
            # STRUCTURE + CONTENT (colead's REAL v2.1.209 fixtures, 2026-07-15).
            # STRUCTURE, because styling cannot identify claude's live prompt: the
            # submitted echo is fg239-on-bg237, the live prompt is default when idle and
            # fg246 mid-generation, and NONE of them is SGR-dim — so unlike codex there
            # is no live_only style test to apply (hence live_only=0). Geometry is the
            # robust fact: the live prompt is the BOTTOM-MOST row whose FIRST non-blank
            # cell is the ornament. The old any-line grep for [>❯▌] instead took the last
            # row containing one ANYWHERE, so a transcript row could be read as the live
            # input -> staged -> extra Enters -> F4 duplication (colead NEW BLOCKER 2).
            # Claude DOES draw the live empty prompt WHILE GENERATING (fixture 2), so
            # bottom-most-wins holds mid-generation rather than degrading.
            # No border cell ever precedes ❯ — borders are their own rows — so the old
            # sed's speculative '│?' is dropped: no specimen supports it.
            # '▌' stays in the set only BECAUSE selection is structural: the splash logo
            # contains a '▌', but never as a row's first cell (the logo rows open '▐').
            #
            # CONTENT, because suggestions are disabled at launch
            # (CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=0): idle == a bare ornament, so ANY
            # content after it = OCCUPIED. If that flag ever fails and a ghost returns,
            # the ghost reads as content -> OCCUPIED -> fail CLOSED (defer/abandon),
            # never a silent clobber. This CLASS rule is also why the two staging shapes
            # need no text matching: claude's '[Pasted text #N +M lines]' token and raw
            # unstyled text (the orchestrator's variant-3 loss) are both just content.
            # It is also why specimen #5's 'paste again to expand' hint is irrelevant: it
            # renders below the box's bottom border, so _input_region_content_end drops it
            # with the rest of the chrome, while the staged token stays on the prompt row
            # where the class rule sees it. (The hint IS captured now — the capture is the
            # whole pane; it is the border bound, not capture geometry, that excludes it.)
            local i s
            _sgr_parse "$region"
            _input_region_prompt_seg 0 '❯' '>' '▌' || return 2 # no live prompt in view
            _input_region_content_end "${_SGR_LINE[$_SGR_PROMPT_SEG]}" border
            s="${_SGR_PROMPT_TAIL#"$_SGR_PROMPT_ORN"}"
            # Continuation rows of a multiline draft sit BELOW the prompt row — including
            # below the edit cursor — and are real unsent input; the box's bottom border
            # (then the status/hint rows) is where they stop being input.
            for ((i = _SGR_PROMPT_SEG + 1; i < ${#_SGR_TEXT[@]}; i++)); do
                ((_SGR_LINE[i] < _SGR_CONTENT_END)) || break
                s+="${_SGR_TEXT[i]}"
            done
            s="${s//$'\xc2\xa0'/ }" # NBSP (U+00A0) follows ❯ on a real idle row
            s="$(tr -d '\n\t ' <<<"$s")"
            [[ -n "$s" ]] && return 0 || return 1
            ;;
        *) return 1 ;; # unmodeled tool -> treat as idle (don't block delivery)
    esac
}

# Is our pasted message STILL STAGED (unsent) in the target's input box? Return
# 0 (staged) ONLY on a positive OCCUPIED read of the cursor-region — an idle or
# indeterminate read degrades to "submitted" (non-regressive: never a false loud
# alarm that would make the sender DUPLICATE an already-sent message, the F4 class).
_paste_still_staged() {
    local pane="$1" tool="$2" msg="$3" rc # msg kept for caller symmetry
    case "$tool" in
        claude | codex)
            _input_region_occupied "$pane" "$tool"
            rc=$?
            ((rc == 0)) && return 0 || return 1 # OCCUPIED=staged; idle/indeterminate=clear
            ;;
        *) return 1 ;; # unmodeled -> clear (non-regressive)
    esac
}

_paste_input_busy() {
    local pane="$1" tool="$2"
    # Only claude/codex are modeled for input protection. Other tools (gemini,
    # opencode, plain shells, test dummies) have NO reliable input predicate, so
    # fail-closed there would break every send to them — instead ALLOW (preserve
    # the pre-existing unconditional-paste behavior; the exhibits were claude +
    # codex). Fail-closed applies WITHIN a modeled tool, not to unknown ones.
    case "$tool" in
        claude | codex) ;;
        *) return 1 ;; # unmodeled -> safe (allow, don't regress)
    esac
    # UNSAFE unless the cursor-region reads confidently IDLE. OCCUPIED (typed/staged)
    # and INDETERMINATE (no live prompt = mid-generation / unreadable) both fail
    # CLOSED — never paste into uncertainty (delivery-bug exhibit #3: a helper paste
    # clipped a half-typed human question). Only a positive idle read is safe.
    local rc
    _input_region_occupied "$pane" "$tool"
    rc=$?
    ((rc == 1)) && return 1 || return 0 # IDLE=safe; OCCUPIED/INDETERMINATE=unsafe
}

# Paste a message into a pane and CONFIRM it submitted. On a busy TUI a single
# Enter can be swallowed and the staged text later clears WITHOUT sending (the
# founding deadlock exhibit: a review paste that never reached a busy codex).
# After the initial Enter, verify the input cleared; retry Enter BOUNDED (2
# attempts, ~2s total); if never confirmed, fail LOUD (non-zero + a warning).
# NO durable outbox — ae is not a queue (doctrine); the LLM sender re-sends when
# it sees the failure. Unified: tmux_paste_submit (launch) delegates here so the
# two paste paths can't drift.
ae_submit_pasted_message() {
    local pane="$1" tool="$2" buf="$3" msg="$4" mode="${5:-direct}"
    local intended="${6:-}" body_file="${7:-}"
    local _settle=0.1
    # THE BODY GOES IN ON STDIN, NOT IN ARGV, AND THE STATUS IS CHECKED.
    #
    # `set-buffer -- "$msg"` passes the whole message as a tmux COMMAND ARGUMENT, and
    # that has a ceiling. MEASURED 2026-08-15 on this box: set-buffer carries 16000
    # bytes and FAILS at 32000, while load-buffer from stdin carried 131000 without
    # complaint. Worse than the ceiling was the silence — the compound's exit status
    # was discarded, so a failed set-buffer pasted NOTHING, left the input box empty,
    # and the staged-check then read "empty" as "the message went through". A body
    # over the limit was reported DELIVERED to the sender and never existed for the
    # recipient. Both halves are fixed here: stdin removes the ceiling, and the status
    # is honoured so a transport failure is loud instead of invisible.
    if ! printf '%s' "$msg" | tmux load-buffer -b "$buf" - 2>/dev/null; then
        echo "ae: paste transport FAILED for pane ${pane} (${tool}) — could not stage ${#msg} bytes. Nothing was sent." >&2
        return 1
    fi
    # Bracketed paste is REQUESTED for every pane: tmux wraps the paste in bracket controls
    # only when the receiving application enabled that mode, so a tool or shell that never
    # asked sees a plain paste. Measured 2026-08-30 on claude: plain paste lost the head in
    # 4/4 trials, bracketed paste 0/6 with receiver-side byte-exact payloads (evidence table:
    # this change's commit message and the session memo). Completeness is measured for
    # claude only; the tool-specific submission checks below verify each TUI's own signal.
    if ! tmux paste-buffer -d -p -b "$buf" -t "$pane" 2>/dev/null; then
        echo "ae: paste FAILED into pane ${pane} (${tool}) — nothing was sent." >&2
        return 1
    fi
    if [[ "$mode" == notice ]]; then
        # A notice is a delivery pointer, so Enter is forbidden until the visible
        # input rows prove the exact staged bytes.  One clear-and-repaste is allowed
        # only when the clear itself is measurable; otherwise leave the pointer
        # staged and report the sender-owned recovery path.
        local _notice_ok=0 _notice_attempt=0 _notice_region
        while ((_notice_attempt < 2)); do
            sleep 0.1
            _notice_region="$(_capture_input_region "$pane")"
            if _notice_prove "$tool" "$_notice_region" "$intended"; then
                _notice_ok=1
                break
            fi
            ((_notice_attempt == 0)) || break
            if ! _notice_clear_measurable "$pane" "$tool" "$_notice_region"; then
                break
            fi
            if ! _notice_repaste "$buf" "$intended" "$pane"; then
                break
            fi
            _notice_attempt=1
        done
        if ((_notice_ok == 0)); then
            echo "ae: notice UNCONFIRMED to pane ${pane} (${tool}) — recovery body preserved at ${body_file}. Nothing was submitted; re-send." >&2
            return 1
        fi
    fi
    if [[ "$tool" == "claude" ]]; then
        # Claude only: the orchestrator's 24-sample sweep (2026-07-15) found sends to IDLE
        # claude panes losing the Enter — the text stayed staged raw — while sends to
        # BUSY panes queued and delivered. The lead's fresh-pane repro did NOT
        # reproduce, so this is version/client-state dependent and the root cause is
        # unproven; a longer settle is cheap insurance for the flow-control hypothesis.
        # It is NOT the guarantee — the verify-then-retry loop below is. Codex keeps
        # 0.1s: no evidence of the drop there, and every send would pay the latency.
        _settle=0.3
    fi
    sleep "$_settle"
    tmux send-keys -t "$pane" Enter

    local _attempt=0
    while ((_attempt < 2)); do
        sleep 0.3
        if ! _paste_still_staged "$pane" "$tool" "$msg"; then
            return 0
        fi
        tmux send-keys -t "$pane" Enter
        _attempt=$((_attempt + 1))
    done
    sleep 0.3
    if ! _paste_still_staged "$pane" "$tool" "$msg"; then
        return 0
    fi
    echo "ae: submit UNCONFIRMED to pane ${pane} (${tool}) — message may not have sent. Re-send." >&2
    return 1
}

# --- session meta key/value (locked) -------------------------------------
# Shared read/write for keys in this session's meta file. Writes serialize on
# meta.lock (same lock the watchdog's meta writer uses) so concurrent helpers
# can't clobber each other; last-write-wins per key. Values are single-line.

ae_meta_set() {
    local key="$1" value="$2"
    local meta_file="${_AE_META_DIR}/meta"
    [[ -f "$meta_file" ]] || return 1
    value="${value//$'\r'/}"
    value="${value//$'\n'/ }"
    {
        flock -w 5 200 || exit 1
        local tmp="${meta_file}.tmp.$$"
        awk -F= -v k="$key" -v v="$value" '
            BEGIN { updated = 0 }
            $1 == k { print k "=" v; updated = 1; next }
            { print }
            END { if (!updated) print k "=" v }
        ' "$meta_file" >"$tmp" && mv "$tmp" "$meta_file"
    } 200>"${meta_file}.lock"
}

# — session-helper template functions (send/ask/review/reply/requests/say/
#   memo/goal/peek/agents/focus/interrupt/spawn/retire/_register-sid/
#   events-tail; each emitted into its generated helper, main fn last) —

# send: the public helper, and a shim. The whole send is the pinned Rust core's
# (B move 1): the argv, the body refusal, the event fields read off THIS
# environment (AE_SENDER_OVERRIDE and the _AE_EVENT_* members — the frozen
# contract every caller of this helper writes), target resolution, the DELIVERY
# itself and the one event under the core's locked transaction. The shim EXECs
# the core, so a core that delivered and then could not record exits with that
# gap and nothing in bash remains to deliver again; with no usable core it
# refuses (one line, exit 2).
#
# The frozen `helper_send_body` and the internal `_send-deliver` entry it stood
# behind are GONE with this move. The paste was never delegated back to bash
# after B move 1 — src/deliver.rs does the dead-pane refusal, the provenance
# envelope, the recovery-body store, the per-target lock, the busy deferral, the
# bracketed paste, the oversize notice and the submit verification in-process —
# so what stood here was a second implementation of a measured path with no
# caller. A dormant one is worse than none: it drifts from the live one unseen,
# and the day something reaches for it, it is the old behaviour that answers.
helper_send_main() {
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    _ae_core_try _send "$@"
}

# ask:
helper_ask_main() {
    # The whole request goes to the pinned Rust core (P2.5a): body refusal,
    # identity, target resolution, the request id, the composed message, the
    # PASTE (in-process since B move 1 — the TUI modelling was ported, not
    # delegated) and the ask event under the core's locked transaction. The shim
    # EXECs the core; with no usable core it refuses (one line, exit 2).
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    _ae_core_try _ask "$@"
}

# review:
helper_review_main() {
    # As `ask`: the core composes, delivers, and writes the review event. The
    # shim EXECs the core; with no usable core it refuses (one line, exit 2).
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    _ae_core_try _review "$@"
}

# reply:
helper_reply_main() {
    # The whole reply goes to the pinned Rust core (P2.5b): the argv, the body
    # refusal, the request lookup, the slot-and-session check, the routing by
    # stored slot, the paste and the reply event under the core's locked
    # transaction. The shim EXECs the core; with no usable core it refuses (one
    # line, exit 2).
    META_DIR="$(cd "$(dirname "$0")" && pwd)"
    _ae_core_try _reply "$@"
}

# Hand this invocation to the pinned Rust core. THE CORE IS REQUIRED.
#
# Every subcommand routed through here is core-owned: the bash bodies that once
# stood behind them are gone (slice A.1), so there is nothing to fall back TO.
# A session whose core is unbound, missing, or not the pinned version therefore
# REFUSES the command — one line on stderr, exit 2 — instead of quietly doing a
# second, divergent thing. Exit 2 is the usage-error code, kept distinct from 1
# so a caller can tell "this installation cannot serve that" from "it went
# wrong". The version is re-checked at RUN time against the pin because the
# binary at that path can be replaced under a long-lived session, and running a
# core that is not the pinned one is exactly the silent-drift failure the pair
# exists to prevent.
_ae_core_try() { # [--capture] <subcommand> [args...]
    # --capture: RUN the core as a subprocess and return its exit code, instead
    # of exec-replacing this process. For a core call that is a STEP inside a
    # larger bash flow (the archive publish inside `ae end`), which must read the
    # core's stdout and carry on. Without it the function EXECs and never
    # returns. Either way a missing core exits — in a command substitution that
    # is the substitution's own exit, so the caller reads 2 and fails.
    local capture=0
    while [[ "${1:-}" == --* ]]; do
        case "$1" in
            --capture)
                capture=1
                shift
                ;;
            *) break ;;
        esac
    done
    local sub="$1"
    shift
    local bin ver actual reason=""
    bin="$(grep '^ae_core=' "${META_DIR}/meta" 2>/dev/null | cut -d= -f2- || true)"
    ver="$(grep '^ae_core_version=' "${META_DIR}/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [[ -z "$bin" ]]; then
        reason="this session has no core bound"
    elif [[ -z "$ver" ]]; then
        # A path with no version is the shape _ae_core_bind publishes for operator
        # input it could not use.
        reason="the configured core could not be bound when this session was created or refreshed: ${bin}"
    elif [[ ! -x "$bin" ]]; then
        reason="the configured core is missing or not executable: ${bin}"
    else
        actual="$("$bin" --version 2>/dev/null | head -1 || true)"
        actual="${actual##* }"
        [[ "$actual" == "$ver" ]] ||
            reason="core version mismatch: this session pins ${ver}, ${bin} reports ${actual:-nothing}"
    fi
    if [[ -n "$reason" ]]; then
        printf "ae: the ae core is required for '%s' — %s\n" "$sub" "$reason" >&2
        exit 2
    fi
    # TMUX_PANE and the rest of the environment pass through untouched: the core
    # derives the acting agent from the pane it was invoked in.
    if ((capture)); then
        # Capture the core's own exit code explicitly — a bare call would let
        # errexit abort this function on a non-zero core before `return` runs.
        local crc=0
        "$bin" "$sub" "$META_DIR" "$@" || crc=$?
        return "$crc"
    fi
    exec "$bin" "$sub" "$META_DIR" "$@"
}

# A core call made BEFORE any session exists — the `--from` preflight runs ahead
# of the first mkdir, so there is no per-session pin (${META_DIR}/meta) for
# _ae_core_try to route through. This resolves the OPERATOR's core input directly
# (the same AE_CORE_BIN / workspace.core source _ae_core_bind pins at launch, so
# the preflight uses exactly the binary the about-to-be-created session will bind)
# and runs it as a subprocess, returning its stdout on the caller's captured pipe
# and its exit code. There is no version PIN to check against here — the operator
# config IS the authority for a session that does not exist yet — only that the
# resolved path is an executable that reports a version, the same usability test
# _ae_core_bind applies. THE CORE IS REQUIRED here too: no usable core exits 2
# with one line, exactly like _ae_core_try; the core's own 0/1/2 otherwise.
# --- Identity v2: the core owns every roster row (P34) ---------------------------
# The glue never writes a seat, profile or harness-session row. It asks the core and
# consumes US-framed records: \x1f-separated fields, one record per line, free text
# LAST, then a trailer `end<US><count>` (an empty field survives \x1f where it would
# vanish under tab-IFS — see the TSV note in AGENTS.md). There is no bash fallback for
# a roster write, by design — a missing core refuses (the shims exit 2). Roster records (`_launch-plan`, `_roster list`) are always EIGHT
# fields — kind slot name profile binary tool sid command — with `-` for absent.
_IDENT_US=$'\x1f'
# _identity_core <preflight|session> <sub> [args...] → the core's records on stdout,
# rc 0, only after its rc and its trailer agreed with what was received; rc 1 otherwise
# (the core's own stderr has already said why). `session` needs META_DIR (the bound
# core of an existing session) and _ae_core_try passes that dir as the subcommand's
# FIRST argument itself — so a session-mode caller writes `_roster add-seat …`, never
# `_roster "$dir" add-seat …`; `preflight` runs before or outside any session binding
# and the caller passes the dir explicitly.
_identity_core() {
    local mode="$1" sub="$2"
    shift 2
    local out rc=0
    # The shims refuse a missing core themselves (one line, exit 2). Inside these
    # command substitutions that exit is the SUBSHELL's, so it lands here as a
    # non-zero rc with the reason already on stderr.
    if [[ "$mode" == preflight ]]; then
        out="$(_ae_core_preflight_try "$sub" "$@")" || rc=$?
    else
        out="$(_ae_core_try --capture "$sub" "$@")" || rc=$?
    fi
    ((rc == 0)) || return 1
    # Producer-status: rc first (above), then the trailer against the records received.
    local last body="" n=0 count
    last="${out##*$'\n'}"
    if [[ "$last" != "end${_IDENT_US}"* ]]; then
        echo "Error: core '${sub}' output carries no trailer — refusing to consume it." >&2
        return 1
    fi
    count="${last#end${_IDENT_US}}"
    [[ "$out" == *$'\n'* ]] && body="${out%$'\n'*}"
    [[ -n "$body" ]] && n="$(printf '%s\n' "$body" | grep -c '')"
    if [[ "$n" != "$count" ]]; then
        echo "Error: core '${sub}' trailer says ${count} records, received ${n}." >&2
        return 1
    fi
    [[ -n "$body" ]] && printf '%s\n' "$body"
    return 0
}

_ae_core_preflight_try() { # [--exec] <subcommand> [args...]
    # --exec: EXEC the core instead of running it as a subprocess and returning
    # its code. For a top-level command the core owns outright (`list`), where an
    # extra bash process between the caller and the core buys nothing and would
    # only add a second place for a signal or an exit code to be reshaped.
    local exec_mode=0
    if [[ "${1:-}" == --exec ]]; then
        exec_mode=1
        shift
    fi
    local sub="$1"
    shift
    local bin reason=""
    bin="$(_ae_core_bin_input)" || bin=""
    # Absolute + executable + reports a version. A relative path would resolve
    # against wherever the caller happened to run.
    if [[ -z "$bin" ]]; then
        reason="no core is configured (AE_CORE_BIN, ${AE_HOME:-~/.ae}/core/current, or workspace.core)"
    elif [[ "$bin" != /* || ! -x "$bin" ]]; then
        reason="the configured core is not an absolute path to an executable: ${bin}"
    elif ! _ae_core_bin_version "$bin" >/dev/null 2>&1; then
        reason="the configured core reports no version: ${bin}"
    fi
    if [[ -n "$reason" ]]; then
        printf "ae: the ae core is required for '%s' — %s\n" "$sub" "$reason" >&2
        exit 2
    fi
    ((exec_mode)) && exec "$bin" "$sub" "$@"
    # Capture the core's own exit code explicitly — a bare call would let errexit
    # abort this function on a non-zero core before `return` runs.
    local crc=0
    "$bin" "$sub" "$@" || crc=$?
    return "$crc"
}

