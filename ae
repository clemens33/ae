#!/usr/bin/env bash
# ae - agentic engineering: tmux-based multi-agent workspace
set -euo pipefail
AE_VERSION="2026.8.2"

# Fail fast with a clear message on bash < 4 (macOS ships 3.2 and defaults to
# zsh). This must sit BEFORE any bash-4-only syntax is parsed — bash parses
# function bodies at definition time, so a later guard never runs; 3.2 would
# die with a cryptic parse error instead.
if ((BASH_VERSINFO[0] < 4)); then
    # Re-exec under a modern bash before giving up. macOS ships 3.2 as /bin/bash,
    # and a LOGIN shell's path_helper rebuilds PATH with /bin ahead of Homebrew —
    # so `env bash` picks 3.2 even on a machine with 5.x installed. That is the
    # normal state inside a macOS tmux pane, where it made ae refuse to start.
    # Everything here must parse under 3.2: no bash-4 syntax above this point.
    # Loop safety is a bounded ATTEMPT COUNT, not a boolean. We only ever exec a
    # bash we have already PROVEN is >= 4, so the marker can only be set
    # legitimately on a >= 4 shell — its presence HERE, on a < 4 shell, is always
    # stale (inherited by a descendant that re-invoked ae through ae's own
    # PATH-resolved shebang). A boolean made that descendant refuse instead of
    # re-execing, and the orchestrator autostart child discards stderr, so it died in
    # silence. Counting recovers from a poisoned marker while still capping
    # recursion. Must parse under 3.2: no arithmetic-if, no [[ ]].
    _ae_tries="${AE_BASH_REEXEC:-0}"
    case "$_ae_tries" in '' | *[!0-9]*) _ae_tries=0 ;; esac
    if [ "$_ae_tries" -lt 2 ]; then
        for _ae_bash in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash; do
            # shellcheck disable=SC2016 # single quotes are the point: the
            # expression must be evaluated by the CANDIDATE bash, not this one.
            if [ -x "$_ae_bash" ] &&
                "$_ae_bash" -c 'exit $((BASH_VERSINFO[0] < 4))' 2>/dev/null; then
                AE_BASH_REEXEC=$((_ae_tries + 1)) exec "$_ae_bash" "$0" "$@"
            fi
        done
    fi
    echo "Error: ae requires bash >= 4.0 (found ${BASH_VERSION})." >&2
    echo "macOS: brew install bash, and make sure brew's bin dir precedes /bin on PATH (eval \"\$(brew shellenv)\")." >&2
    exit 1
fi
# The marker's job ended the moment we got here: this shell IS >= 4. Leaving it
# EXPORTED poisons every descendant that re-invokes ae through ae's own
# PATH-resolved shebang — on a hostile PATH the child lands on 3.2, sees the
# marker, skips the re-exec that would have saved it, and refuses. The orchestrator
# autostart child is spawned with stderr to /dev/null, so it died in SILENCE.
# Loop safety does not need the marker to persist: the candidate loop only execs
# a bash it has already proven is >= 4, so a re-exec can never recurse.
unset AE_BASH_REEXEC _ae_tries

# AE_HOME relocates ALL ae state (config, sessions, worktrees) without swapping
# $HOME — so an isolated run (tests, e2e) can keep the real $HOME (and real
# agent-CLI auth under ~/.claude, ~/.codex) while writing ae state elsewhere.
# Unset → the normal ~/.ae. CONFIG_DIR derives from it; everything below derives
# from CONFIG_DIR, so this single knob is authoritative for the whole tool.
AE_HOME="${AE_HOME:-${HOME}/.ae}"
CONFIG_DIR="$AE_HOME"
# CONFIG_FILE honors a pre-set env var so tests + the generated daemon
# can point at a non-default config without rewriting the user's real one.
CONFIG_FILE="${CONFIG_FILE:-${CONFIG_DIR}/config}"
WORKTREES_DIR="${CONFIG_DIR}/worktrees"
SESSIONS_DIR="${CONFIG_DIR}/sessions"

# Per-project config override (optional)
AE_LOCAL_CONFIG=""
[[ -f ".ae/config" ]] && AE_LOCAL_CONFIG="$(pwd)/.ae/config"

# Optional: isolated tmux server (for testing or multi-instance use)
# Install the ambient tmux() shim from AE_TMUX_SERVER(+_KIND). A FUNCTION so the
# selection is unit-testable behaviorally, and KIND-FIRST so an ambiguous record
# refuses even when the VALUE is blank — the old nesting under a non-empty value let
# blank+ambiguous skip the shim entirely and inherited $TMUX won (10th review B3:
# a retire killed a pane cross-server through exactly that gap).
_ae_install_tmux_shim() {
    if [[ "${AE_TMUX_SERVER_KIND:-}" == "ambiguous" ]]; then
        tmux() {
            echo "ae: refusing tmux operation — this session's server record is ambiguous; run 'ae doctor --refresh' first." >&2
            return 1
        }
        return 0
    fi
    [[ -n "${AE_TMUX_SERVER:-}" ]] || return 0
    if [[ "${AE_TMUX_SERVER_KIND:-}" == "socket" ]]; then
        tmux() { command tmux -S "$AE_TMUX_SERVER" "$@"; }
    elif [[ "${AE_TMUX_SERVER_KIND:-}" == "name" ]]; then
        tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }
    elif [[ "$AE_TMUX_SERVER" == /* ]]; then
        tmux() { command tmux -S "$AE_TMUX_SERVER" "$@"; }
    else
        tmux() { command tmux -L "$AE_TMUX_SERVER" "$@"; }
    fi
    return 0
}
_ae_install_tmux_shim

# --- Portability shims (GNU coreutils vs BSD/macOS userland) -------------
# ae runs on Linux (GNU) and macOS (BSD). Four utilities differ, and each one
# fails SILENTLY through the `|| default` idiom the call sites use: a missing
# `tac` yields nothing (newest-first scans read empty), `stat -c` yields the
# fallback (every mtime reads 0), `date -d` yields 0, `sed -i EXPR FILE` eats
# EXPR as a backup suffix. All four shipped as macOS bugs. Never call the raw
# tool — route through these.
#
# Each shim tries the GNU form FIRST and falls back to BSD, so no platform
# detection is needed and a macOS box with brew coreutils on PATH keeps taking
# the GNU path. These are shared bodies: ae calls them directly AND they are
# emitted into the generated helpers via the _lib declare -f list.

# stat(1) field lookup. GNU spells it -c FORMAT, BSD -f FORMAT, with different
# specifiers. Keys are GNU-flavoured. Prints the value; returns non-zero when
# BOTH forms fail (file gone/unreadable) so callers can still branch on it —
# the ones that want a default keep their `|| echo 0`.
_ae_stat() {
    local key="$1" file="$2"
    case "$key" in
        mtime) stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null ;;
        size) stat -c %s "$file" 2>/dev/null || stat -f %z "$file" 2>/dev/null ;;
        inode) stat -c %i "$file" 2>/dev/null || stat -f %i "$file" 2>/dev/null ;;
        uid) stat -c %u "$file" 2>/dev/null || stat -f %u "$file" 2>/dev/null ;;
        mode) stat -c %a "$file" 2>/dev/null || stat -f %Lp "$file" 2>/dev/null ;;
        # GNU %y is "YYYY-MM-DD HH:MM:SS.nnnnnnnnn +ZZZZ" and callers cut at the
        # dot, so the BSD form emits that same prefix with no fraction.
        mtime-human)
            stat -c %y "$file" 2>/dev/null ||
                stat -f %Sm -t '%Y-%m-%d %H:%M:%S' "$file" 2>/dev/null
            ;;
        *) return 1 ;;
    esac
}

# In-place sed. `sed -i EXPR FILE` is GNU-only — BSD reads EXPR as the backup
# suffix and then treats FILE as the script. Temp + rename instead of branching
# on platform: identical on both, and the target is never observable
# half-written (GNU -i does the same thing internally).
_ae_sed_inplace() {
    local expr="$1" file="$2" tmp
    tmp="${file}.sedtmp.$$"
    # `cp -p` FIRST, then truncate-and-write into that temp: a plain redirect
    # would create the temp at the ambient umask, so the rename would silently
    # rewrite the target's mode/owner (GNU `sed -i` preserves them). Copying the
    # metadata across and writing in place keeps the rename faithful.
    cp -p "$file" "$tmp" 2>/dev/null || {
        rm -f "$tmp"
        return 1
    }
    if sed "$expr" "$file" >"$tmp" && mv "$tmp" "$file"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# First JSON string value for KEY, read from stdin. Replaces the GNU-only
# `grep -oP '"key"\s*:\s*"\K…'` idiom — BSD grep has neither -P nor \K, so on
# macOS every one of those returned empty and the agent session-ID capture that
# depends on them never fired. grep -oE emits matches in source order, so
# head -1 preserves grep -oP's first-match semantics. VCLASS is a bracket
# expression for the value characters (default: anything but a quote).
# A QUERY function: the result is stdout, the status is incidental. It must end
# `return 0` — no match makes grep exit 1, and `head -1` closing the pipe early
# on a many-match input can hand grep a SIGPIPE (141); under errexit either would
# abort a bare caller (AGENTS.md, "only a BARE call proves set -e safety").
_ae_json_first() {
    local key="$1" vclass="${2:-[^\"]}"
    grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*\"${vclass}*\"" |
        head -1 |
        sed -e "s/^\"${key}\"[[:space:]]*:[[:space:]]*\"//" -e 's/"$//' || true
    return 0
}

# Same, for an unquoted numeric value. Same query contract.
_ae_json_first_num() {
    local key="$1"
    grep -oE "\"${key}\"[[:space:]]*:[[:space:]]*[0-9]+" |
        head -1 |
        sed -e "s/^\"${key}\"[[:space:]]*:[[:space:]]*//" || true
    return 0
}

# Yesterday, as YYYY/MM/DD in UTC — the day-partitioned layout codex and gemini
# use for their session logs. GNU spells the offset `-d yesterday`, BSD `-v-1d`,
# and the two are NOT interchangeable in general: `-d` takes a free-form English
# phrase, `-v` a fixed adjustment. Inlining the pair at each call site forced the
# portability detector to carry a `date` allow-list, and any allow-list wide
# enough to permit these lines also permits a NON-equivalent pair (`-d '2 days
# ago' || -v-1d`) whose two branches silently disagree. One chokepoint instead:
# the detector then needs no date exemption at all. Empty if neither form works.
_ae_yesterday() {
    date -u -d 'yesterday' +%Y/%m/%d 2>/dev/null ||
        date -u -v-1d +%Y/%m/%d 2>/dev/null ||
        true
    return 0
}

# Are we ACTUALLY inside a tmux pane — not merely carrying $TMUX? (#29)
#
# $TMUX and $TMUX_PANE are ordinary environment variables. A GUI terminal
# launched from inside a pane inherits them and hands them to every tab shell it
# opens (observed live 2026-08-05: cmux launched from pane %44), so the bare
# `[[ -n "${TMUX:-}" ]]` test fires in shells no tmux client owns. ae then takes
# the inside-tmux branch: `ae <name>` runs switch-client, which moves the
# ORIGINAL pane's view somewhere else and never attaches the terminal the human
# is looking at, and `ae end` with no name resolves to the ORIGINAL pane's
# session. An everyday action turns into a silent dead end.
#
# TRUTH TEST: our controlling terminal must be the tty of a PANE on that server.
# Not `list-clients` — a client's tty is the terminal EMULATOR's (/dev/ttys002),
# never the pane pty a shell sits on (/dev/ttys055), so matching against it
# would call every genuine in-pane shell stale. Genuine nesting still passes:
# $TMUX names the INNER server, whose pane list contains our tty.
#
# POSITIVE EVIDENCE ONLY. When the question is unanswerable — no controlling tty
# (an agent's non-interactive children have none), tmux unreachable, an empty
# pane list — we answer TRUE and keep the historical behaviour. This guard is
# here to catch a PROVEN mismatch, not to re-litigate every ambiguous case.
#
# Asked through ae's tmux shim on purpose (never `command tmux -S ${TMUX%%,*}`):
# when AE_TMUX_SERVER pins a server, that is the server switch-client would
# target, so "are we a client of THAT one" is the question the callers actually
# need answered. A shell sitting in a pane of some other server is correctly
# told "not inside" — switch-client would have no client to switch there.
#
# Cached per process: the answer cannot change mid-run, and the warning must be
# said once, not once per branch that asks.
_ae_inside_tmux() {
    [[ -n "${TMUX:-}" ]] || return 1
    case "${_AE_INSIDE_TMUX:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    local _tty="" _panes="" _p
    _tty="$(ps -o tty= -p $$ 2>/dev/null | tr -d '[:space:]')" || _tty=""
    _panes="$(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null)" || _panes=""
    # No controlling tty ("?"/"??"/"-" depending on ps flavour) or no answer
    # from tmux: unanswerable, so trust $TMUX as ae always has.
    if [[ -z "$_tty" || "$_tty" == '?' || "$_tty" == '??' || "$_tty" == '-' || -z "$_panes" ]]; then
        _AE_INSIDE_TMUX=1
        return 0
    fi
    # /dev/ stripped from BOTH sides: procps prints "pts/3" and BSD ps "ttys039"
    # against tmux's "/dev/pts/3" / "/dev/ttys039", but a ps that spelled the
    # full path would otherwise make every genuine pane look stale.
    _tty="${_tty#/dev/}"
    while IFS= read -r _p; do
        if [[ "${_p#/dev/}" == "$_tty" ]]; then
            _AE_INSIDE_TMUX=1
            return 0
        fi
    done <<<"$_panes"
    _AE_INSIDE_TMUX=0
    echo "ae: stale \$TMUX inherited (this shell is not a tmux pane) — attaching normally." >&2
    return 1
}

# --- Function index ---
#   Portability: _ae_stat, _ae_sed_inplace, _ae_yesterday, _ae_json_first, _ae_json_first_num, _ae_inside_tmux
#   Config:     parse_config, get_config
#   Helpers:    tool_kind_from_cmd, detect_current_session, _validate_session_name
#   Session:    read_session_meta, list_ae_sessions, iter_stopped_sessions
#   Commands:   cmd_list, cmd_status, cmd_next, cmd_archive_preview, cmd_rename,
#               cmd_doctor, cmd_watchdog, cmd_telegram, cmd_orchestrator_init,
#               cmd_recover_pending, cmd_help
#   Core calls: _ae_core_try, _ae_core_preflight_try — launch/resume, end, stop,
#               compact, spawn, retire, send/ask/review/reply and the archive
#               preview are the core's operations; `ae transfer` was cut
#   Assets:     regenerate_manifest, _refresh_session_shims (doctor --refresh only)
#   Spawn:      _cmd_spawn, _spawn_capture_after, capture_codex_session_id
#   Watchdog:   _watchdog_manage (start/stop/status; the daemon is the core's)

DEFAULT_CONFIG='# ae config — auto-created on first run, yours to edit. Also mirrored in the repo as
# config.sample. INI-style: [section] headers, key = value, "#" starts a comment.
# New sessions read this whole file. Stopping + resuming an existing session (ae stop <name>;
# ae <name>) relaunches its preserved agents with their CURRENT command + [prompt] — but the
# roster (main/workers), layout, and watchdog stay pinned in session meta, so edits to those
# take effect for NEW sessions only. (ae doctor --refresh regenerates the on-disk session
# helpers + workspace.md after you upgrade ae; it changes neither running agents nor config.)

[profiles]
# Register any CLI tool as a PROFILE: profile = "the shell command that launches it". A
# profile is a reusable launch recipe, not an identity: an agent IS its NAME, bound to a
# profile in [roster] below. The command must be ONE simple command (env assignments plus
# one argv; no ; | & # redirections or $(…) outside quotes) — ae refuses anything else.
# Model-named aliases: the prefix names the model + major, so the running model is legible at
# a glance. STRICT pins (never --model best) — a model-named alias must not silently run a
# different model; that would make the name lie and blind the model-drift alarm. Exact IDs
# beat family aliases where they would drift: --model opus moved to Opus 5 the day it shipped.
# opus5 = everyday builder tier (xhigh is a deliberate opt-up; Opus 5 defaults to high).
opus5 = "claude --permission-mode bypassPermissions --model claude-opus-5 --effort xhigh"
# fable5 = frontier lead tier (default lead seat; pairs with a cross-model colead as its equal peer).
fable5 = "claude --permission-mode bypassPermissions --model fable --effort xhigh"
sonnet5 = "claude --permission-mode bypassPermissions --model sonnet --effort low"
gpt56sol = "codex --yolo -m gpt-5.6-sol -c model_reasoning_effort=xhigh"
gpt56terra = "codex --yolo -m gpt-5.6-terra -c model_reasoning_effort=xhigh"
gpt56luna = "codex -m gpt-5.6-luna -c model_reasoning_effort=low -a never"
opencode = "opencode"

[roster]
# The agents promised to launch: name = profile. The NAME is the identity of the agent — it is
# addressed as <name> in the session and <session>:<name> across sessions; the profile is
# metadata (`ae list` shows it). Every seat in main/workers below must be bound here — ae
# refuses the launch otherwise and lists every violation. A name bound here but not seated
# is legal: `ae <session> use <name>` starts it as main instead. Spawn on demand with:
# spawn <name> --using <profile> [prompt].
lead = fable5
colead = gpt56sol

[workspace]
# main = the standing main seat (a [roster] NAME) — under lead-pair a technical lifecycle
# anchor, not a rank. workers = comma-separated [roster] names launched at start.
# layout = vertical | horizontal | lead-pair. watchdog = true nudges stale/idle agents.
# The leads delegate by rule (see docs/reference/delegation.md — spawn workers on demand).
# Standing seats are the JUDGMENT PAIR only: under lead-pair the FIRST worker (worker.0)
# is the COLEAD seat — an EQUAL leadership peer of the lead (interchangeable, same level,
# sharing the leads window 0:leads); main stays the technical lifecycle anchor (compact
# handover), which is infrastructure, not seniority. Builders and reviewers are NOT
# standing seats: either peer spawns them per slice (spawn builder --using opus5 / spawn
# reviewer --using gpt56sol) and retires its own spawns when the work is verified — every spawn
# ends in a retire. This keeps idle panes at zero, makes the retire contract do real
# work, and still keeps judgment (the pair) separate from review (a spawned seat) on
# every slice.
main = lead
workers = colead
layout = lead-pair
watchdog = true

[prompt]
# ae already injects the full workspace protocol into every agent — the roster, the helper
# commands (send/ask/spawn/…), the delegation and comms rules — see the generated
# ~/.ae/sessions/<name>/workspace.md. Anything set here is APPENDED on top of that; per-project
# .ae/config overrides the global one. Uncomment to add your own house rules:
# instructions = "Always write tests. Prefer TypeScript."'

# Create default config if missing
if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$DEFAULT_CONFIG" >"$CONFIG_FILE"
    # STDERR: this runs before the dispatcher, on EVERY invocation, so on a config-less
    # home it would otherwise prepend a line to the stdout of commands whose stdout is a
    # contract — `ae archive preview` promises the digest bytes and nothing else.
    echo "Created default config at $CONFIG_FILE" >&2
fi

# Simple INI parser — outputs section.key=value lines
# Reads global config, then per-project .ae/config (local values shadow global)
parse_config() {
    local section="" file line
    for file in "$CONFIG_FILE" "${AE_LOCAL_CONFIG:-}"; do
        # shellcheck disable=SC2015 # safe: if file is empty or missing, continue either way
        [[ -n "$file" ]] && [[ -f "$file" ]] || continue
        section=""
        while IFS= read -r line; do
            # Trim leading/trailing whitespace (pure bash, no sed fork)
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -z "$line" ]] && continue

            if [[ "$line" =~ ^\[([a-zA-Z_-]+)\]$ ]]; then
                section="${BASH_REMATCH[1]}"
                continue
            fi

            # Strip comments only outside quoted values
            if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*)\ *=\ *\"(.*)\"$ ]]; then
                printf '%s\n' "${section}.${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
            elif [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_-]*)\ *=\ *(.+)$ ]]; then
                local val="${BASH_REMATCH[2]}"
                val="${val%%#*}"
                val="${val%"${val##*[![:space:]]}"}"
                printf '%s\n' "${section}.${BASH_REMATCH[1]}=${val}"
            else
                continue
            fi
        done <"$file"
    done
}

# Last match wins — local config overrides global
# Cached via deterministic temp file so subshells share the same parsed result.
get_config() {
    # NO disk cache — parse on every call. The old UID-global cache file raced:
    # (a) mtime keying (1-second resolution) served a same-second config REWRITE
    # stale, and (b) the check/write/read was not one transaction, so two concurrent
    # ae invocations with DIFFERENT configs could read each other's parse (codex
    # repro: 99/300 wrong-owner reads across 300 concurrent pairs; tmp.$$ names also
    # collide across subshells of one parent). The config is under a kilobyte and
    # parse_config is pure bash — direct parsing costs microseconds and cannot lie.
    local result="" entry
    while IFS= read -r entry; do
        if [[ "$entry" == "${1}="* ]]; then
            result="${entry#*=}"
        fi
    done < <(parse_config)
    printf '%s' "$result"
}

_publish_executable_artifact() {
    local dest="$1" mode="$2"
    shift 2
    local tmp="${dest}.tmp.$$"
    if ! "$@" >"$tmp"; then
        rm -f "$tmp"
        echo "ae: failed to generate ${dest##*/} — previous version left intact" >&2
        return 1
    fi
    if ! chmod "$mode" "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if ! mv -f "$tmp" "$dest"; then
        rm -f "$tmp"
        return 1
    fi
    return 0
}

# ── The core's helper set, rewritten from bash ────────────────────────────
# The ONE asset `ae doctor --refresh` still needs that the core has no entry for.
#
# Since the B move a session helper carries NO LOGIC: it is `exec <core> <entry>
# "$META_DIR" "$@"`, and src/session_launch/assets.rs writes exactly these bytes
# at launch and resume. Refresh must produce the SAME bytes, so what follows is a
# deliberate second copy of a five-line contract — not a second implementation of
# a helper, and nothing like the 422-line generator and `_lib` library it
# replaces. The copy is not trusted to stay honest by reading: the integration
# suite refreshes a launched session and compares every helper BYTE FOR BYTE
# against what the core wrote. Delete all of this the day the core grows an entry
# that rewrites a session's assets.
#
# `<file>:<core entry>` — the same table as assets.rs PASSTHROUGH, plus the two
# monitor panes' processes (each is a pane's whole command, so it must be an
# executable file). `peak` and `loop` are aliases and are written below.
_AE_SHIM_PASSTHROUGH=(
    send:_send ask:_ask review:_review reply:_reply requests:_requests
    state:_state say:_say memo:_memo goal:_goal peek:_peek agents:_agents
    focus:_focus interrupt:_interrupt spawn:_spawn retire:_retire
    watchdog:_watchdog-run events-tail:_events-tail
)

# The core's quoting, not bash's: `shell_quote` here is `printf %q`, which leaves
# an ordinary path BARE, and the shims the core writes are always single-quoted.
# Byte parity is the whole point of this family, so it gets the core's rule.
_ae_core_quote() { # <word> -> '<word>' with every ' closed and reopened
    local out="$1" q="'\\''"
    out="${out//\'/$q}"
    printf "'%s'" "$out"
}

_emit_helper_shim() { # <core> <entry> [fixed-word...] -> the shim body on stdout
    local core="$1" entry="$2" word
    shift 2
    printf '%s\n' '#!/usr/bin/env bash' \
        '# Generated by ae — do not edit. A session helper is a thin shim: it names' \
        '# its own session directory and hands the whole argv to the ae core.' \
        'set -euo pipefail' \
        'META_DIR="$(cd "$(dirname "$0")" && pwd)"'
    printf 'exec %s %s "$META_DIR"' "$(_ae_core_quote "$core")" "$entry"
    for word in "$@"; do
        printf ' %s' "$(_ae_core_quote "$word")"
    done
    printf ' "$@"\n'
    return 0
}

_emit_helper_alias() { # <target> -> one exec to the sibling helper
    printf '%s\n' '#!/usr/bin/env bash' \
        "# Generated by ae — do not edit. An alias for the '${1}' helper." \
        'set -euo pipefail' \
        "exec \"\$(cd \"\$(dirname \"\$0\")\" && pwd)/${1}\" \"\$@\""
    return 0
}

_refresh_session_shims() { # <meta-dir>
    local dir="$1" core pair name entry
    core="$(sed -n 's/^ae_core=//p' "${dir}/meta" 2>/dev/null | head -1 || true)"
    if [[ -z "$core" ]]; then
        echo "  WARN: no core is bound for this session — helper shims left as they are" >&2
        return 1
    fi
    for pair in "${_AE_SHIM_PASSTHROUGH[@]}"; do
        name="${pair%%:*}"
        entry="${pair#*:}"
        _publish_executable_artifact "${dir}/${name}" 0755 \
            _emit_helper_shim "$core" "$entry" || return 1
    done
    # `mark-done` is `state done` with the message as the reason.
    _publish_executable_artifact "${dir}/mark-done" 0755 \
        _emit_helper_shim "$core" _state 'done' || return 1
    _publish_executable_artifact "${dir}/peak" 0755 _emit_helper_alias peek || return 1
    # `loop` is the deprecated spelling of the watchdog helper.
    _publish_executable_artifact "${dir}/loop" 0755 _emit_helper_alias watchdog || return 1
    return 0
}

tool_kind_supports_launch_id() {
    case "$1" in
        codex | opencode | gemini) return 0 ;;
        *) return 1 ;;
    esac
}

read_launch_id_for_slot() {
    local meta_dir="$1" slot="$2"
    local escaped_slot="${slot//./\\.}"
    local launch_id=""
    launch_id="$(grep "^launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [[ -z "$launch_id" ]]; then
        # Backward compatibility for sessions created before generic launch_id keys.
        launch_id="$(grep "^codex_launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_id" ]]; then
        launch_id="$(grep "^opencode_launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_id" ]]; then
        launch_id="$(grep "^gemini_launch_id\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    printf '%s' "$launch_id"
}

read_launch_time_for_slot() {
    local meta_dir="$1" slot="$2"
    local escaped_slot="${slot//./\\.}"
    local launch_time=""
    launch_time="$(grep "^launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    if [[ -z "$launch_time" ]]; then
        # Backward compatibility for sessions created before generic launch_time keys.
        launch_time="$(grep "^codex_launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_time" ]]; then
        launch_time="$(grep "^opencode_launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    if [[ -z "$launch_time" ]]; then
        launch_time="$(grep "^gemini_launch_time\.${escaped_slot}=" "${meta_dir}/meta" 2>/dev/null | cut -d= -f2- || true)"
    fi
    case "$launch_time" in
        '' | *[!0-9]*)
            launch_time=0
            ;;
    esac
    printf '%s' "$launch_time"
}

# --- status-left location rendering (mode-aware session path) ---------
# Abbreviate $HOME -> ~ for compactness. The `~` here is a literal display glyph,
# not a path to expand — hence SC2088 is intentionally disabled.
# shellcheck disable=SC2088
_ae_abbrev_home() {
    local p="$1"
    if [[ "$p" == "$HOME" ]]; then
        printf '~'
    elif [[ "$p" == "$HOME/"* ]]; then
        printf '~/%s' "${p#"$HOME"/}"
    else
        printf '%s' "$p"
    fi
}

# Truncate from the LEFT (keep the meaningful tail), prefixing … when cut.
_ae_trunc_left() {
    local s="$1" max="${2:-40}"
    if ((${#s} > max)); then
        printf '…%s' "${s: -$((max - 1))}"
    else
        printf '%s' "$s"
    fi
}

# Build the status-left location string from mode/origin/work_dir:
#   local -> <work_dir>             (origin == work_dir; one path)
#   full  -> <origin> → <work_dir>  (copy: where it was opened → the copy)
#   git   -> <origin> ⌁ <work_dir>  (worktree: origin repo ⌁ the worktree)
_ae_status_left_paths() {
    local mode="$1" origin="$2" work_dir="$3"
    local o w
    o="$(_ae_trunc_left "$(_ae_abbrev_home "$origin")")"
    w="$(_ae_trunc_left "$(_ae_abbrev_home "$work_dir")")"
    case "$mode" in
        full) printf '%s → %s' "$o" "$w" ;;
        git) printf '%s ⌁ %s' "$o" "$w" ;;
        *) printf '%s' "$w" ;;
    esac
}

# Escape a string for literal use inside tmux status FORMAT TEXT (e.g. status-left).
# Two metacharacters expand there: `#` (format introducer — `#S`/`#(cmd)`/`#{…}`) and
# `%` (strftime — `%Y`/`%H`…). Both must be doubled (`##`, `%%`) or a path containing
# them silently renders wrong or runs a shell job on every status redraw. Applied to
# the static path text. (Live branch/health are tmux user-OPTION values, which are
# interpolated literally — neither `#` nor `%` expands there — so they need no escape.)
_ae_tmux_format_literal() {
    local s="${1//\#/##}"
    printf '%s' "${s//%/%%}"
}

# Render and apply the mode-aware session location to a session's status-left,
# escaped for tmux format context, with status-left-length raised so it isn't
# clipped (tmux default is 10). No-op if the target session isn't running. Shared
# by session creation and `ae doctor --refresh` so a refreshed live session keeps
# both halves of the bar in sync. server="" uses the ambient tmux (the wrapped
# server at launch); a non-empty server (refresh path, read from meta) targets it
# explicitly via -L.
# Apply ae's status BAR to a session — both halves, one owner (ae; the watchdog only
# feeds user options). Shape: [ae <session>]  0:leads 1:workers 99:ae-monitor  [<path> <git>] [watch …]
#   left   = [ae <session>]           (name only — the window list renders after it)
#   middle = tmux's native window list (role-named windows under lead-pair/lead-solo)
#   right  = [<path><git>] [watch …]  (path static; git + watch via user options)
_ae_apply_status_bar() {
    local session="$1" mode="$2" origin="$3" work_dir="$4" server="${5:-}" server_kind="${6:-}"
    local _t=(tmux)
    if [[ "${server_kind:-}" == "ambiguous" ]]; then
        # Ambiguous record → display no-op, never the ambient server.
        return 0
    fi
    if [[ -n "$server" ]]; then
        local -a _sel_t=()
        mapfile -t _sel_t < <(_srv_tmux_args "${server_kind:-}" "$server")
        _t=(command tmux "${_sel_t[@]}")
    fi
    "${_t[@]}" has-session -t "$session" 2>/dev/null || return 0
    # Target by session ID, resolved by EXACT name match: tmux session targets
    # prefix-match, so theming 'foo' would silently rewrite live 'foobar' if foo
    # vanished mid-apply. Resolve through the same tmux command this function uses.
    local _st
    _st="$("${_t[@]}" list-sessions -F '#{session_id} #{session_name}' 2>/dev/null | _roster_session_id "$session")"
    [[ -n "$_st" ]] || return 0
    local paths sess_lit
    paths="$(_ae_tmux_format_literal "$(_ae_status_left_paths "$mode" "$origin" "$work_dir")")"
    # The SESSION NAME is user text entering a tmux FORMAT context — #-escape it like
    # the path (a name with '#' would otherwise open a format/#() directive). With the
    # name in status-left, window 0 is free to carry a role name under lead-pair.
    sess_lit="$(_ae_tmux_format_literal "$session")"
    "${_t[@]}" set-option -t "$_st" status-left "[ae ${sess_lit}] " 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" status-left-length 40 2>/dev/null || true
    # status-right is OWNED BY AE, baked once here — the watchdog never rewrites it
    # (it only sets/unsets the user options below, so there is nothing to save,
    # prepend, restore, or dedup). The path is static #-escaped text; the live parts
    # come via user options, which tmux interpolates LITERALLY — not re-expanded, not
    # parsed for directives — so branch names / status text with ), #, spaces, or
    # shell metacharacters are harmless (no #() command, no shell):
    #   @ae_branch_status   ' <branch><dirty>' — watchdog, each cycle (empty when off)
    #   @ae_watchdog_status '[watch <glyph> a/t]' — watchdog health (empty when off)
    "${_t[@]}" set-option -t "$_st" status-right "[${paths}#{@ae_branch_status}] #{@ae_watchdog_status}" 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" status-right-length 100 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" status-interval 5 2>/dev/null || true
    # SECOND status line: the focused pane's agent identity. tmux renders pane borders
    # (which carry #{@ae_agent}) only in windows with 2+ panes — a lone agent in its own
    # window (lead-solo's lead, a single worker, spawned agents) had NO visible identity.
    # Line 1 shows the active pane's @ae_agent (user option -> interpolated literally,
    # injection-safe) so 'who am I looking at' is always answered, any pane count.
    "${_t[@]}" set-option -t "$_st" status 2 2>/dev/null || true
    # tmux ARRAY options do NOT inherit per-index: setting session-scope
    # status-format[1] alone shadows the WHOLE global array, leaving index 0 (the
    # standard bar: status-left + window list + status-right) EMPTY at session scope
    # — the bar renders as a blank line (live exhibit: the first session-shape
    # launch). Copy the global [0] into the session alongside our [1].
    local _fmt0
    _fmt0="$("${_t[@]}" show-options -gv 'status-format[0]' 2>/dev/null || true)"
    if [[ -n "$_fmt0" ]]; then
        "${_t[@]}" set-option -t "$_st" 'status-format[0]' "$_fmt0" 2>/dev/null || true
    fi
    # Right side of line 1: the per-agent roster (@ae_agents_status, watchdog-published
    # each cycle, empty/unset when the watchdog is off). Agents live across multiple
    # windows and this bar renders in every one, so the whole org is visible from any
    # window. Right-aligned so it never collides with the left-aligned focused identity.
    "${_t[@]}" set-option -t "$_st" 'status-format[1]' '#[align=left] #{@ae_agent}#[align=right]#{@ae_agents_status} ' 2>/dev/null || true
    # WINDOW LIST: each window carries its own agents' verdict glyphs, so attention maps
    # SPATIALLY onto the windows you already scan ('0:leads●● 1:workers⚙◌'). The
    # right-side roster still answers WHO; this answers WHERE.
    # @ae_window_status is a WINDOW-scoped user option (watchdog-published each cycle,
    # empty/unset when it is off), interpolated literally like the others.
    # OWNERSHIP: window-status-format is user-THEMING territory. ae deliberately owns it
    # INSIDE its own sessions and writes it at SESSION scope only — a global write would
    # leak ae's glyphs into every other tmux session the user runs. #F is preserved: it
    # carries tmux's own zoom/activity/current markers, and dropping it would silently
    # eat them.
    "${_t[@]}" set-option -t "$_st" window-status-format '#I:#W#{@ae_window_status}#F' 2>/dev/null || true
    "${_t[@]}" set-option -t "$_st" window-status-current-format '#I:#W#{@ae_window_status}#F' 2>/dev/null || true
}

# Detect current ae session when running inside tmux (for ae end/status without name)
# _ae_inside_tmux, not a bare $TMUX test (#29): from a GUI terminal that inherited
# $TMUX, display-message answers for the ORIGINAL pane — so `ae end` with no name
# would target someone else's session.
detect_current_session() {
    if _ae_inside_tmux; then
        local session_name
        session_name="$(tmux display-message -p '#{session_name}' 2>/dev/null)" || return 1
        if [[ -d "${SESSIONS_DIR}/${session_name}" ]]; then
            echo "$session_name"
            return 0
        fi
    fi
    return 1
}

# Detect tool kind from command (for staleness checks on resume)
# ae prefixes an env assignment onto some launch commands (opencode's OPENCODE_CONFIG;
# claude's nesting guards). Tool detection matches on the BINARY, so a leading `env`,
# its -u/-i options, and any VAR=val words come off first.
#
# It walks WORD BY WORD from the head and stops at the first thing that is not a
# prefix — it must never scan the whole command, whose tail can be kilobytes of
# injected prose containing "=" and glob characters. (Testing `$cmd == *=*` would match
# any command whose prompt happens to contain an equals sign; the first WORD is the
# only safe thing to look at.)
# THE TOKENIZER. It runs once and yields one fact in four parts, and every consumer —
# classification, prefix extraction, command reconstruction — reads THAT rather than
# parsing its output again. The previous shape tokenized correctly and then re-split the
# raw suffix on a literal space, so a quoted or backslash-escaped path with a space in
# it ('/Applications/Open Code/codex') classified UNKNOWN while the same path without a
# space worked — the giveaway that the bug lived at shell-word boundaries. Re-parsing a
# parse is the same disease as the two capture ranges and the re-created cycle wiring:
# one definition, all callers.
#
# Results (globals, because bash returns one value and this yields four — precedent:
# _event_json_str through _EV):
#   _CMD_PREFIX   raw text before the binary, prefix words included
#   _CMD_BIN_RAW  the binary exactly as written (quotes and escapes intact)
#   _CMD_BIN      the binary DECODED, for comparison
#   _CMD_REST     raw text after the binary
_cmd_split_binary() { # <cmd>
    local cmd="$1"
    local n=${#cmd} i=0 ch nxt q word wstart skip=0 bad=0
    _CMD_PREFIX="" _CMD_BIN_RAW="" _CMD_BIN="" _CMD_REST=""
    # VALIDATION IS SCOPED TO WHAT THIS CONSUMES — the prefix words and the binary word.
    # The tail is passed through untouched and ae makes no claim about it. An earlier
    # version counted trailing backslashes across the WHOLE command and was wrong both
    # ways: `codex --yolo # note\` is valid (the backslash is inside a comment) yet was
    # refused, suppressing all codex shaping, while `codex --yolo "unterminated` is
    # invalid yet classified fine because the scan had already stopped at the binary.
    # A command that was already invalid stays invalid and fails loudly at exec, which
    # is honest: ae never promised to validate the operator's config, and writing a full
    # shell lexer in bash is not a promise it can keep.
    while :; do
        while ((i < n)) && [[ "${cmd:i:1}" == " " || "${cmd:i:1}" == $'\t' ]]; do ((i += 1)); done
        ((i < n)) || break
        wstart=$i
        word=""
        q=""
        while ((i < n)); do
            ch="${cmd:i:1}"
            if [[ "$q" == "'" ]]; then
                # Single quotes: everything is literal, including backslashes.
                if [[ "$ch" == "'" ]]; then q=""; else word+="$ch"; fi
            elif [[ "$q" == '"' ]]; then
                # Double quotes: bash honours \ only before " \ $ ` and newline;
                # anywhere else the backslash is itself literal. Closing at the FIRST
                # quote regardless — the old shape — cut a valid path in half and
                # swallowed the following argument into the binary's span.
                if [[ "$ch" == "\\" ]]; then
                    ((i + 1 < n)) || {
                        bad=1
                        break
                    }
                    nxt="${cmd:i+1:1}"
                    case "$nxt" in
                        '"' | \\ | '$' | '`')
                            word+="$nxt"
                            i=$((i + 1))
                            ;;
                        $'\n') i=$((i + 1)) ;; # line continuation: nothing emitted
                        *) word+="$ch" ;;
                    esac
                elif [[ "$ch" == '"' ]]; then
                    q=""
                else
                    word+="$ch"
                fi
            elif [[ "$ch" == "\\" ]]; then
                # A command may not END in a bare backslash: that is not valid shell,
                # and silently dropping it used to hand back a confident answer for an
                # input no shell would run.
                ((i + 1 < n)) || {
                    bad=1
                    break
                }
                i=$((i + 1))
                word+="${cmd:i:1}"
            elif [[ "$ch" == "'" || "$ch" == '"' ]]; then
                q="$ch"
            elif [[ "$ch" == " " || "$ch" == $'\t' ]]; then
                break
            else
                word+="$ch"
            fi
            i=$((i + 1))
        done
        # An unterminated quote is malformed too.
        [[ -z "$q" ]] || bad=1
        if ((bad)); then break; fi
        if ((skip)); then
            skip=0
            continue
        fi
        case "$word" in
            env) ;;       # the launcher itself
            -i) ;;        # takes NO argument
            -u) skip=1 ;; # ...unlike -u, which takes one
            *=*) ;;       # VAR=value; quotes already consumed above
            *)            # the binary
                _CMD_PREFIX="${cmd:0:wstart}"
                _CMD_BIN_RAW="${cmd:wstart:i-wstart}"
                _CMD_BIN="$word"
                _CMD_REST="${cmd:i}"
                return 0
                ;;
        esac
    done
    # FAIL TOWARD UNKNOWN. Malformed input, or nothing but prefix words: claim no
    # binary and hand the command back whole. An unclassified command costs a degraded
    # launch — no context, no exact resume — while a confidently WRONG classification
    # sends a mis-spliced command to a live pane.
    _CMD_PREFIX="" _CMD_BIN_RAW="" _CMD_BIN=""
    _CMD_REST="$cmd"
    return 0
}

_cmd_binary_kind() { # <cmd> -> the bare binary name, prefix and path removed
    _cmd_split_binary "$1"
    printf '%s' "${_CMD_BIN##*/}"
    return 0
}

tool_kind_from_cmd() {
    case "$(_cmd_binary_kind "$1")" in
        claude) echo "claude" ;;
        codex) echo "codex" ;;
        gemini) echo "gemini" ;;
        grok) echo "grok" ;;
        opencode) echo "opencode" ;;
        *) echo "unknown" ;;
    esac
}

# Find a codex session ID by matching an ae-injected launch marker in the session log.
# Scans recent session files (today + yesterday to handle UTC midnight rollover).
# Only considers files modified after $launch_time (epoch seconds) to avoid stale matches.
# Returns the UUID of the newest matching session, or empty string.
find_codex_session_by_launch_id() {
    local launch_id="$1" launch_time="${2:-0}"
    local best_id="" best_mtime=0
    local day
    for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do
        [[ -z "$day" ]] && continue
        local dir="$HOME/.codex/sessions/${day}"
        [[ -d "$dir" ]] || continue
        local f
        for f in "$dir"/*.jsonl; do
            [[ -f "$f" ]] || continue
            local mtime
            mtime="$(_ae_stat mtime "$f" || echo 0)"
            ((mtime < launch_time)) && continue
            grep -Fq "AE_CODEX_LAUNCH_ID=${launch_id}" "$f" 2>/dev/null || continue
            if ((mtime > best_mtime)); then
                local first_line file_id
                first_line="$(head -1 "$f" 2>/dev/null || true)"
                [[ -z "$first_line" ]] && continue
                file_id="$(echo "$first_line" | _ae_json_first id '[0-9a-f-]' 2>/dev/null || true)"
                if [[ -n "$file_id" ]]; then
                    best_id="$file_id"
                    best_mtime="$mtime"
                fi
            fi
        done
    done
    echo "$best_id"
}

# Find a codex session ID by matching CWD in session_meta JSON.
# Scans recent session files (today + yesterday to handle UTC midnight rollover).
# Only considers files modified after $launch_time (epoch seconds) to avoid stale matches.
# Returns the UUID of the newest matching session, or empty string.
find_codex_session_by_cwd() {
    local target_cwd="$1" launch_time="${2:-0}"
    # Normalize target CWD (resolve symlinks/worktrees)
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    local best_id="" best_mtime=0
    # Scan today and yesterday (handles UTC midnight rollover)
    local day
    for day in "$(date -u +%Y/%m/%d)" "$(_ae_yesterday)"; do
        [[ -z "$day" ]] && continue
        local dir="$HOME/.codex/sessions/${day}"
        [[ -d "$dir" ]] || continue
        local f
        for f in "$dir"/*.jsonl; do
            [[ -f "$f" ]] || continue
            # Skip files older than launch_time
            local mtime
            mtime="$(_ae_stat mtime "$f" || echo 0)"
            ((mtime < launch_time)) && continue
            # Parse first line: extract payload.cwd and payload.id
            local first_line file_cwd file_id
            first_line="$(head -1 "$f" 2>/dev/null || true)"
            [[ -z "$first_line" ]] && continue
            file_cwd="$(echo "$first_line" | _ae_json_first cwd 2>/dev/null || true)"
            [[ -z "$file_cwd" ]] && continue
            # Normalize file CWD
            file_cwd="$(realpath "$file_cwd" 2>/dev/null || echo "$file_cwd")"
            [[ "$file_cwd" != "$target_cwd" ]] && continue
            # CWD matches — pick newest by mtime
            if ((mtime > best_mtime)); then
                file_id="$(echo "$first_line" | _ae_json_first id '[0-9a-f-]' 2>/dev/null || true)"
                if [[ -n "$file_id" ]]; then
                    best_id="$file_id"
                    best_mtime="$mtime"
                fi
            fi
        done
    done
    echo "$best_id"
}

# Best-effort: capture Codex session ID post-launch.
# Fallback chain: A) sid-file from register-sid, B) launch-token scan, C) CWD scan, D) pane scrape.
capture_codex_session_id() {
    local pane="$1" slot="$2" meta_dir="$3"
    local sid_file="${meta_dir}/codex.${slot}.sid"
    local captured=""
    local work_dir launch_time launch_id
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    # A) Poll for self-registered session ID (codex writes codex.SLOT.sid via developer_instructions)
    local _attempt
    for _attempt in 1 2 3 4 5 6; do
        sleep 5
        if [[ -f "$sid_file" ]]; then
            captured="$(<"$sid_file")"
            captured="${captured//[$'\n\r ']/}" # strip whitespace
            rm -f "$sid_file"
            break
        fi
    done
    # B) Direct launch-token scan of codex session files
    if [[ -z "$captured" && -n "$launch_id" ]]; then
        captured="$(find_codex_session_by_launch_id "$launch_id" "$launch_time")"
    fi
    # C) Direct CWD-based scan of codex session files
    if [[ -z "$captured" && -n "$work_dir" ]]; then
        captured="$(find_codex_session_by_cwd "$work_dir" "$launch_time")"
    fi
    # D) Fallback: scrape TUI output (legacy, least reliable)
    if [[ -z "$captured" ]]; then
        captured="$(tmux capture-pane -t "$pane" -p 2>/dev/null |
            grep -oE 'session id: [0-9a-f-]+' | head -1 | sed 's/^session id: //' || true)"
    fi
    if [[ -n "$captured" ]]; then
        # Identity v2: the captured id is a roster row (harness_session.<slot>) — the
        # core writes it under meta.lock; no bash lock is held around the call.
        META_DIR="$meta_dir" _identity_core session _roster set-harness-session "$slot" "$captured" >/dev/null || true
    fi
}

# Find an opencode session ID by matching directory in `opencode session list --format json`.
# Only considers sessions updated after $launch_time (epoch seconds).
# Returns the session ID of the newest matching session, or empty string.
find_opencode_session_by_launch_id() {
    local launch_id="$1" launch_time="${2:-0}"
    if ! command -v opencode &>/dev/null; then
        return
    fi
    [[ "$launch_id" =~ ^[0-9a-fA-F-]+$ ]] || return
    local launch_time_ms=$((launch_time * 1000))
    local query
    query="select s.id
from session s
join message m on m.session_id = s.id
join part p on p.message_id = m.id and p.session_id = s.id
where s.time_updated >= ${launch_time_ms}
  and p.data like '%AE_OPENCODE_LAUNCH_ID=${launch_id}%'
order by s.time_updated desc
limit 1;"
    opencode db "$query" --format tsv 2>/dev/null | awk 'NR > 1 && NF { print $1; exit }'
}

# Find a Gemini session ID by matching an ae-injected launch marker in local chat history.
# Limits search to project temp dirs whose .project_root matches $target_cwd.
find_gemini_session_by_launch_id() {
    local target_cwd="$1" launch_id="$2" launch_time="${3:-0}"
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    [[ -d "$HOME/.gemini/tmp" ]] || return
    local best_id="" best_mtime=0
    local proj_dir root_file root chats_dir f mtime session_id
    for proj_dir in "$HOME/.gemini/tmp"/*; do
        [[ -d "$proj_dir" ]] || continue
        root_file="${proj_dir}/.project_root"
        [[ -f "$root_file" ]] || continue
        root="$(cat "$root_file" 2>/dev/null || true)"
        root="$(realpath "$root" 2>/dev/null || echo "$root")"
        [[ "$root" == "$target_cwd" ]] || continue
        chats_dir="${proj_dir}/chats"
        [[ -d "$chats_dir" ]] || continue
        for f in "$chats_dir"/session-*.json; do
            [[ -f "$f" ]] || continue
            mtime="$(_ae_stat mtime "$f" || echo 0)"
            ((mtime < launch_time)) && continue
            grep -Fq "AE_GEMINI_LAUNCH_ID=${launch_id}" "$f" 2>/dev/null || continue
            session_id="$(_ae_json_first sessionId <"$f" 2>/dev/null || true)"
            [[ -z "$session_id" ]] && continue
            if ((mtime > best_mtime)); then
                best_id="$session_id"
                best_mtime="$mtime"
            fi
        done
    done
    echo "$best_id"
}

# Find a Gemini session ID by matching project directory and launch time.
# Returns the newest session ID for the project after $launch_time, or empty string.
find_gemini_session_by_cwd() {
    local target_cwd="$1" launch_time="${2:-0}"
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    [[ -d "$HOME/.gemini/tmp" ]] || return
    local best_id="" best_mtime=0
    local proj_dir root_file root chats_dir f mtime session_id
    for proj_dir in "$HOME/.gemini/tmp"/*; do
        [[ -d "$proj_dir" ]] || continue
        root_file="${proj_dir}/.project_root"
        [[ -f "$root_file" ]] || continue
        root="$(cat "$root_file" 2>/dev/null || true)"
        root="$(realpath "$root" 2>/dev/null || echo "$root")"
        [[ "$root" == "$target_cwd" ]] || continue
        chats_dir="${proj_dir}/chats"
        [[ -d "$chats_dir" ]] || continue
        for f in "$chats_dir"/session-*.json; do
            [[ -f "$f" ]] || continue
            mtime="$(_ae_stat mtime "$f" || echo 0)"
            ((mtime < launch_time)) && continue
            session_id="$(_ae_json_first sessionId <"$f" 2>/dev/null || true)"
            [[ -z "$session_id" ]] && continue
            if ((mtime > best_mtime)); then
                best_id="$session_id"
                best_mtime="$mtime"
            fi
        done
    done
    echo "$best_id"
}

# Find an opencode session ID by matching directory in `opencode session list --format json`.
# Only considers sessions updated after $launch_time (epoch seconds).
# Returns the session ID of the newest matching session, or empty string.
find_opencode_session_by_cwd() {
    local target_cwd="$1" launch_time="${2:-0}"
    target_cwd="$(realpath "$target_cwd" 2>/dev/null || echo "$target_cwd")"
    if ! command -v opencode &>/dev/null; then
        return
    fi
    local json
    json="$(opencode session list --format json -n 20 2>/dev/null || true)"
    [[ -z "$json" ]] && return
    # opencode timestamps are in milliseconds
    local launch_time_ms=$((launch_time * 1000))
    local best_id="" best_updated=0
    # Compact JSON to single-line-per-object, then parse with grep
    local compact
    # `\s` and a `\n` REPLACEMENT are BOTH GNU sed extensions — BSD reads them
    # literally, so the split never happened, the whole array stayed on one line,
    # and only the FIRST session was ever examined. POSIX class + a control-byte
    # separator (inserted by bash, so sed never has to interpret an escape).
    local _sep=$'\001'
    compact="$(printf '%s' "$json" | tr -d '\n' |
        sed -E "s/\}[[:space:]]*,[[:space:]]*\{/}${_sep}{/g" | tr "$_sep" '\n')"
    local sid dir updated
    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue
        sid="$(echo "$entry" | _ae_json_first id 2>/dev/null || true)"
        [[ -z "$sid" ]] && continue
        dir="$(echo "$entry" | _ae_json_first directory 2>/dev/null || true)"
        [[ -z "$dir" ]] && continue
        updated="$(echo "$entry" | _ae_json_first_num updated 2>/dev/null || true)"
        [[ -z "$updated" ]] && continue
        ((updated < launch_time_ms)) && continue
        dir="$(realpath "$dir" 2>/dev/null || echo "$dir")"
        [[ "$dir" != "$target_cwd" ]] && continue
        if ((updated > best_updated)); then
            best_id="$sid"
            best_updated="$updated"
        fi
    done <<<"$compact"
    echo "$best_id"
}

# Best-effort: capture OpenCode session ID post-launch.
# Fallback chain: A) launch-token DB scan, B) CWD-based session list scan.
capture_opencode_session_id() {
    local pane="$1" slot="$2" meta_dir="$3"
    local captured=""
    local work_dir launch_time launch_id
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    # Poll: opencode needs time to create the session
    local _attempt
    for _attempt in 1 2 3 4 5 6; do
        sleep 5
        if [[ -n "$launch_id" ]]; then
            captured="$(find_opencode_session_by_launch_id "$launch_id" "$launch_time")"
        fi
        if [[ -z "$captured" && -n "$work_dir" ]]; then
            captured="$(find_opencode_session_by_cwd "$work_dir" "$launch_time")"
        fi
        [[ -n "$captured" ]] && break
    done
    if [[ -n "$captured" ]]; then
        # Identity v2: the captured id is a roster row (harness_session.<slot>) — the
        # core writes it under meta.lock; no bash lock is held around the call.
        META_DIR="$meta_dir" _identity_core session _roster set-harness-session "$slot" "$captured" >/dev/null || true
    fi
}

# Best-effort: capture Gemini session ID post-launch.
# Fallback chain: A) launch-token local chat scan, B) CWD-based local chat scan.
capture_gemini_session_id() {
    local pane="$1" slot="$2" meta_dir="$3"
    local captured=""
    local work_dir launch_time launch_id
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    local _attempt
    for _attempt in 1 2 3 4 5 6; do
        sleep 5
        if [[ -n "$work_dir" && -n "$launch_id" ]]; then
            captured="$(find_gemini_session_by_launch_id "$work_dir" "$launch_id" "$launch_time")"
        fi
        if [[ -z "$captured" && -n "$work_dir" ]]; then
            captured="$(find_gemini_session_by_cwd "$work_dir" "$launch_time")"
        fi
        [[ -n "$captured" ]] && break
    done
    if [[ -n "$captured" ]]; then
        # Identity v2: the captured id is a roster row (harness_session.<slot>) — the
        # core writes it under meta.lock; no bash lock is held around the call.
        META_DIR="$meta_dir" _identity_core session _roster set-harness-session "$slot" "$captured" >/dev/null || true
    fi
}

capture_session_id() {
    local tool_kind="$1" pane="$2" slot="$3" meta_dir="$4"
    case "$tool_kind" in
        codex) capture_codex_session_id "$pane" "$slot" "$meta_dir" ;;
        opencode) capture_opencode_session_id "$pane" "$slot" "$meta_dir" ;;
        gemini) capture_gemini_session_id "$pane" "$slot" "$meta_dir" ;;
        *) return 0 ;;
    esac
}

# Is CANDIDATE a DIRECT CHILD of PARENT, by pure string structure? Used as the
# belt to entry validation's braces before anything is deleted. String-structural
# rather than realpath-based on purpose: `readlink -f` is GNU-only, and this test
# is strictly stronger for the job — it rejects `parent/a/b` as well as
# `parent/../x`, which a resolved-path prefix check would happily accept.
_path_is_direct_child() {
    local parent="$1" cand="$2"
    [[ -n "$parent" && -n "$cand" ]] || return 1
    [[ "$cand" == */* ]] || return 1
    [[ "${cand%/*}" == "$parent" ]] || return 1
    local base="${cand##*/}"
    [[ -n "$base" && "$base" != "." && "$base" != ".." ]] || return 1
    return 0
}

# ALLOWLIST, deliberately not a blacklist. A session name becomes ALL of: a tmux
# session name, a DIRECTORY under ${SESSIONS_DIR}, the middle of the lifecycle
# lock filename (.lifecycle.<name>.lock), a `#{@ae_*}` neighbour in tmux format
# strings, and — since the launch rollback landed — the target of an rm -rf. A
# blacklist has to anticipate every one of those consumers, and each review round
# found one it had missed: path traversal first, then '.dotproject' (tmux CREATES
# it, ae then cannot target it — an orphan session and a stranded lock file, with
# the failure landing before the rollback exists), then backslashes, leading
# sigils, a trailing ';', tmux-format-shaped names, ASCII controls, and
# '.lifecycle.foo.lock' aliasing ae's own lock namespace.
#
# THE GRAMMAR — stated once, here, and echoed verbatim in the error:
#
#     ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$
#
# Alphanumeric start; alphanumeric, underscore or dash body; 128 characters max.
# The consequences follow by construction instead of by enumeration: a leading
# '.' cannot occur, so both the lifecycle-lock namespace and tmux's untargetable
# dot-names are unreachable; no shell metacharacter, glob, tmux format, quote or
# control byte survives; spaces are simply out.
#
# The LENGTH is the one number measured rather than picked. Every session name on
# this machine passes (longest 25, including the numeric '38' and 'AIASSIST-133'
# shapes), and the longest name default_session_name produces across 177 real
# project directories is 62 — one character inside a 63 cap. 128 keeps real
# headroom for deeper trees and stays far under the 255-byte filesystem limit.
#
# Validated ONCE, at launch entry, BEFORE the first tmux or filesystem side
# effect, so every artifact later derived from the name is well-formed by
# construction. Same class as resolve_session_ref's guard for chat-supplied refs
# — this is the argv-supplied one, which had none at all.
_validate_session_name() {
    local name="$1"
    if [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]]; then
        return 0
    fi
    echo "Error: invalid session name '${name}'." >&2
    echo "       Names must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}\$ — start with a letter or digit," >&2
    echo "       then letters, digits, '_' or '-', up to 128 characters." >&2
    return 1
}

# The MIGRATION shape, for boundaries that consume an EXISTING session rather
# than create one (a transfer source, a rename source). Sessions created before
# the grammar existed must stay usable — being unable to rename or move a legacy
# session away is a worse outcome than the name itself. Accepts:
#   - anything the grammar accepts, or
#   - a legacy name that IS ALREADY a real direct-child session directory.
# Traversal is never accepted by either arm: the second arm requires the built
# path to be a true direct child AND to exist, so '../victim' and 'a/b' are out
# even if someone creates those directories. Creation boundaries (a new name, a
# rename TARGET) use the strict grammar — legacy names get a migration path, not
# a permanent home.
#
# The existence arm requires a PHYSICAL directory — `-d` alone accepts a
# direct-child SYMLINK, and a symlink is an escape wearing a compliant name:
# `rsync -a --delete src/ sessions/legacy.name/` follows it and deletes whatever
# it points at. `! -L` is the whole difference between a migration path and a
# traversal with extra steps.
#
# Used ONLY where an existing session is CONSUMED IN PLACE — today that is the
# rename SOURCE, and only that. Not transfer: transfer creates a directory of the
# same name on the DESTINATION (either side, depending on direction), so it is a
# creation boundary in both directions, and a same-name copy cannot migrate a
# name into compliance — it propagates it. Legacy sessions rename at the source
# first, then transfer.
_session_name_usable() {
    local name="$1"
    _validate_session_name "$name" 2>/dev/null && return 0
    if _path_is_direct_child "$SESSIONS_DIR" "${SESSIONS_DIR}/${name}" &&
        [[ -d "${SESSIONS_DIR}/${name}" && ! -L "${SESSIONS_DIR}/${name}" ]]; then
        return 0
    fi
    _validate_session_name "$name"
    return 1
}

# Is the ON-DISK OBJECT at ${SESSIONS_DIR}/<name> safe to treat as that session's
# directory? A PATH question, answered INDEPENDENTLY of the name grammar — and
# that independence is the entire point. Folding it into _session_name_usable did
# not work, because that function RETURNS on a grammar accept: every
# grammar-VALID symlink skipped the check completely, so a symlink named
# 'valid-name' passed every boundary and `rsync -a --delete` onto it followed the
# link out of the sessions root and deleted what it pointed at.
#   0 — safe: absent (nothing to escape through yet), or a real physical
#       directory that is a direct child of the sessions root
#   1 — unsafe: a symlink of ANY kind (including dangling, which `-e` misses), a
#       non-directory, or a path that is not a direct child
_session_path_is_safe() {
    # SEPARATE statements: `local name="$1" p="${SESSIONS_DIR}/${name}"` expands
    # every word before assigning any of them, so p would be built from the OLD
    # name — unset here, which under `set -u` aborts ae outright. Same shape as
    # the export HOME/AE_HOME footgun in AGENTS.md.
    local name="$1"
    local p="${SESSIONS_DIR}/${name}"
    _path_is_direct_child "$SESSIONS_DIR" "$p" || return 1
    # -L before -e: a DANGLING symlink is not -e, so an -e-first test would call
    # it ABSENT and wave it through. What a given rsync then does varies by
    # implementation (the openrsync shipped here returns rc 11 rather than
    # creating through the link) — which is precisely why the classification does
    # not rest on that behaviour. A symlink of any kind is unsafe regardless.
    [[ -L "$p" ]] && return 1
    [[ -e "$p" ]] || return 0
    [[ -d "$p" ]] || return 1
    return 0
}

# Same question, phrased for a caller that wants to say why.
_require_session_path_safe() {
    local name="$1"
    _session_path_is_safe "$name" && return 0
    echo "Error: ${SESSIONS_DIR}/${name} is not a plain directory (symlink, file, or outside the sessions root)." >&2
    echo "       Refusing to use it — a symlinked session directory is an escape wearing a valid name." >&2
    return 1
}

# Read a session's metadata file (mode, origin)
read_session_meta() {
    local session_name="$1" key="$2"
    local meta="${SESSIONS_DIR}/${session_name}/meta"
    # Backward compat: try old worktree-nested path
    if [[ ! -f "$meta" ]]; then
        meta="${WORKTREES_DIR}/${session_name}/.ae/${session_name}/meta"
    fi
    if [[ -f "$meta" ]]; then
        while IFS='=' read -r k v; do
            if [[ "$k" == "$key" ]]; then
                printf '%s' "$v"
                return
            fi
        done <"$meta"
    fi
}

# Locked single-key meta write. Serializes on the same ${meta_file}.lock that the
# generated helpers' ae_meta_set and the watchdog's meta writer use — without it, a
# refresh could read old meta and mv it back OVER a concurrent helper write (e.g. an
# agent setting the session goal mid-refresh), silently dropping that update. The
# temp lives next to the meta file (same filesystem → atomic mv) and the read-modify-
# write happens entirely inside the lock.
# Write one or more keys in ONE locked temp+rename. The plural form exists because some
# facts are only true TOGETHER: a minted session id and the record that ae minted it are
# one fact in two keys, and writing them as two transactions leaves a window where the id
# is present and its provenance is not — after which the id's mere presence reads as
# launch-assigned and the next archive records that falsehood immutably.
set_session_meta_values() { # <meta-file> <key> <value> [<key> <value>...]
    local meta_file="$1"
    shift
    (($# >= 2)) && (($# % 2 == 0)) || return 1
    local -a keys=() vals=()
    while (($# >= 2)); do
        keys+=("$1")
        vals+=("$2")
        shift 2
    done
    # EVERY STEP IS CHECKED, and the rename happens only after the complete new content
    # was produced. This function may NOT lean on errexit: its callers invoke it under
    # `!` and inside `if`, both of which suppress errexit for everything it does — the
    # documented masking hazard, biting a WRITER rather than a query. Fail-open here does
    # not mean "no change"; it means a TRUNCATED meta renamed over a good one.
    #
    # A shared writer has to be MORE defensive than the private ones it replaced, not
    # merely equivalent: consolidating writers concentrates risk, so a hole that used to
    # affect one path now affects every meta path in ae.
    if [[ ! -f "$meta_file" ]]; then
        # REFUSE. Building the "new" content from an unreadable file would write a
        # replacement holding only the keys being set — which is data loss wearing the
        # shape of a successful write.
        echo "ae: cannot update '${meta_file}' — it does not exist." >&2
        return 1
    fi
    {
        flock -w 5 200 || return 1
        local tmp="${meta_file}.tmp.$$" line i seen out=""
        local -a current=()
        # ONE read of the whole file, status checked. mapfile is a single operation: it
        # either has the file's lines or it failed, with no half-read middle ground.
        mapfile -t current <"$meta_file" || return 1
        # Count-guarded loops, not `${arr[@]+…}`: `${!keys[@]+…}` is parsed as an
        # INDIRECT expansion of the value of keys[@], which fails with "invalid variable
        # name" the moment the array is non-empty. An empty meta and an empty key set both
        # have to be ordinary cases here.
        if ((${#current[@]} > 0)); then
            for line in "${current[@]}"; do
                seen=""
                if ((${#keys[@]} > 0)); then
                    for i in "${!keys[@]}"; do
                        if [[ "${line%%=*}" == "${keys[$i]}" ]]; then
                            # Replace IN PLACE, so key order is stable across rewrites.
                            out+="${keys[$i]}=${vals[$i]}"$'\n'
                            seen="$i"
                            break
                        fi
                    done
                fi
                if [[ -z "$seen" ]]; then
                    out+="${line}"$'\n'
                else
                    unset "keys[$seen]" "vals[$seen]"
                fi
            done
        fi
        if ((${#keys[@]} > 0)); then
            for i in "${!keys[@]}"; do
                out+="${keys[$i]}=${vals[$i]}"$'\n'
            done
        fi
        # ONE write, status checked; anything short of complete success removes the temp
        # and leaves the original untouched.
        if ! printf '%s' "$out" >"$tmp"; then
            rm -f "$tmp"
            return 1
        fi
        if [[ -n "$out" && ! -s "$tmp" ]]; then
            rm -f "$tmp"
            return 1
        fi
        if ! mv "$tmp" "$meta_file"; then
            rm -f "$tmp"
            return 1
        fi
    } 200>"${meta_file}.lock"
}

# One key, through the same writer — not a second implementation of "write a meta key".
set_session_meta_value() {
    set_session_meta_values "$1" "$2" "$3"
}

# Identity v2 (P34): the roster is the CORE's answer — the glue parses no identity.
# RESUME (the session meta exists — authoritative INCLUDING EMPTINESS, so a zero-worker
# session never regains config workers): a v1 meta is migrated in place first
# (`_roster migrate` refuses loudly when a legacy alias has no [profiles] entry, as the
# bash resume did), then `_roster list` yields every seat with its profile's CURRENT
# command. FRESH: `_launch-plan` validates [profiles]/[roster]/[workspace] both ways and
# yields the seats — every violation at once, before any tmux or filesystem side effect.
# Variables keep their frozen names: *_ALIASES now hold PROFILES.
_ROSTER_RECORDS=""
# Identity v2: ae derives no agent names. Duplicate seat names are REFUSED by the core
# (`_launch-plan` NameTwice) rather than renamed, and the grammar is enforced there
# for every FRESH name — the bash `_dedup_worker_names` went with the alias era.

# The core path an INSTALL publishes: <AE_HOME>/core/current, one line holding an
# absolute path. General, not tied to one installer — every install publishes
# through the same pointer — and deliberately a FILE rather than an exported
# variable.
#
# WHY A FILE. Every re-entry into ae resolves the core again: a generated helper
# execs its recorded ae path, the watchdog re-invokes `telegram _supervise`,
# compact launches its child, `doctor --refresh` regenerates. An exported
# AE_CORE_BIN is a COPY of the pointer, frozen into a tmux server's environment
# at launch and stale from the first upgrade onwards; a file is read fresh every
# time, so one install is visible to everything at once.
#
# PRECEDENCE: bundle sibling ae-core (basename of $0 is exactly ae-glue AND
# that sibling is executable) > env AE_CORE_BIN > core/current >
# workspace.core. Installed ae-glue is INTERNAL — generated helpers exec it
# directly with no B8 sanitization — so a pane-carried AE_CORE_BIN must not
# override the immutable sibling. Env is ignored silently when the sibling
# fires. Checkout `ae` and every non-bundle / missing-sibling invocation skip
# it and keep env > current > config.
#
# FAIL-QUIET, like an unusable config value: a missing file, an empty line, or a
# relative/`~` path prints nothing and lets the caller fall through to the config.
# A `~` value is refused rather than expanded because _ae_core_bin_input does not
# expand one either — pinning a path that cannot be executed is worse than
# pinning none.
_ae_core_current_input() {
    local file line
    [[ -n "${CONFIG_DIR:-}" ]] || return 0
    file="$CONFIG_DIR/core/current"
    # A SYMLINK IS NOT A POINTER WE PUBLISHED, and lstat says so before anything
    # reads through it. The wrapper refuses one too, but the wrapper is not on
    # this path: a generated helper exec'ing its recorded ae, the watchdog's
    # `telegram _supervise`, compact's child launch and a bare `ae` run with
    # AE_HOME set all reach THIS reader directly. Fail-quiet like every other
    # unusable value here — fall through to the config rather than resolve a core
    # from a path nobody published.
    if [[ -L "$file" ]]; then
        return 0
    fi
    [[ -f "$file" ]] || return 0
    line="$(head -1 "$file" 2>/dev/null || true)"
    # Trim, pure bash, same idiom as parse_config.
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ "$line" == /* ]] || return 0
    printf '%s\n' "$line"
    return 0
}

# Resolve the operator's Rust core binding, or nothing.
#
# OPERATOR-OWNED INPUTS ONLY, in precedence order: the bundle sibling ae-core
# (when $0's basename is exactly ae-glue AND that sibling is executable — env
# is then ignored, silently), then the AE_CORE_BIN environment variable, then
# <AE_HOME>/core/current (what an install published — see the reader above),
# then the config key `workspace.core`. Deliberately NOT the PATH and NOT a
# build-layout guess such as `target/release/ae`. PATH is wrong because a helper
# runs in the AGENT's inherited environment rather than the operator's shell, so
# it can resolve differently, or to a different VERSION than the one that
# created the session; a build layout is wrong because it is a developer artifact
# that does not exist on a clean install. Resolved ONCE, at creation or refresh,
# and recorded — never re-resolved at helper-run time.
#
# An empty result means NO CORE: every core-owned command then refuses (the core
# is required), so an empty binding is a broken install, not a supported mode.
_ae_core_bin_input() {
    local candidate dir sibling
    if [[ "$(basename "$0")" == "ae-glue" ]]; then
        dir="$(cd -P "$(dirname "$0")" && pwd -P)" || dir=""
        sibling="${dir:+$dir/ae-core}"
        if [[ -n "$sibling" && -x "$sibling" ]]; then
            printf '%s\n' "$sibling"
            return 0
        fi
    fi
    candidate="${AE_CORE_BIN:-}"
    if [[ -z "$candidate" ]]; then
        candidate="$(_ae_core_current_input)"
    fi
    if [[ -z "$candidate" ]]; then
        candidate="$(get_config workspace.core 2>/dev/null || true)"
    fi
    [[ -n "$candidate" ]] || return 1
    printf '%s\n' "$candidate"
    return 0
}

# The version a core binary reports, normalised to the bare version string.
# `ae --version` prints `ae <version>`, so the value is the last field.
_ae_core_bin_version() {
    local line
    line="$("$1" --version 2>/dev/null | head -1)" || return 1
    [[ -n "$line" ]] || return 1
    printf '%s\n' "${line##* }"
    return 0
}

# Evaluate the operator's core input and publish the session's binding. Called
# from BOTH sync_session_assets preambles (launch and `doctor --refresh`), so the
# rules live once:
#   no input       -> meta is left BYTE-IDENTICAL, whatever it already holds.
#                     Clearing used to be the rollback to bash; there is no bash
#                     body behind an empty pin any more, so clearing a working
#                     pin only makes the session refuse every core-owned command
#                     — `end` included, which leaves it unendable. An existing
#                     usable pin therefore survives a no-input refresh untouched,
#                     and an existing UNUSABLE one is reported by the core-pin
#                     check in `ae doctor` rather than rewritten here.
#   usable input   -> the PAIR is pinned: the path and the version it reported.
#   unusable input -> the path is pinned with an EMPTY version, and a warning
#                     goes to the launching/refreshing terminal. A helper reads
#                     that shape as configured-but-unusable and refuses, which
#                     keeps it distinguishable from blank config.
# The core is REQUIRED: either shape leaves every core-owned command refusing
# with exit 2, so the warning here is the operator's one chance to fix it before
# the session is useless.
_ae_core_bind() {
    local meta_dir="$1" candidate reason="" ver=""
    if ! candidate="$(_ae_core_bin_input)"; then
        return 0
    fi
    # Absolute only: a relative path would resolve against whatever directory a
    # helper happened to be run from.
    if [[ "$candidate" != /* ]]; then
        reason="not an absolute path"
    elif [[ ! -x "$candidate" ]]; then
        reason="missing or not executable"
    elif ! ver="$(_ae_core_bin_version "$candidate")"; then
        reason="reports no version"
    fi
    set_session_meta_value "${meta_dir}/meta" "ae_core" "$candidate"
    set_session_meta_value "${meta_dir}/meta" "ae_core_version" "$ver"
    if [[ -n "$reason" ]]; then
        printf 'ae: warning: the configured core is unusable (%s); every core-owned command will refuse: %s\n' \
            "$reason" "$candidate" >&2
    fi
    return 0
}

# List all ae sessions (tagged with AE_SESSION env var)
list_ae_sessions() {
    local sessions="" _env
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        # Bash prefix test rather than `| grep -q`: the pipe cost a second
        # process per session on a listing that already runs once per session.
        _env="$(tmux show-environment -t "$name" AE_SESSION 2>/dev/null || true)"
        if [[ "$_env" == AE_SESSION=* ]]; then
            sessions="${sessions}${name}\n"
        fi
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
    printf '%b' "$sessions"
}

# Iterate stopped sessions (on disk but not running), de-duplicated across SESSIONS_DIR and WORKTREES_DIR
iter_stopped_sessions() {
    declare -A _seen=()
    for dir in "$SESSIONS_DIR" "$WORKTREES_DIR"; do
        [[ -d "$dir" ]] || continue
        for entry in "$dir"/*/; do
            [[ -d "$entry" ]] || continue
            local name
            name="$(basename "$entry")"
            [[ -n "${_seen[$name]:-}" ]] && continue
            tmux has-session -t "$name" 2>/dev/null && continue
            _seen[$name]=1
            echo "$name"
        done
    done
}

# --- Subcommands ---

# Resolve the session's actual meta directory, checking the new path first and
# falling back to the legacy worktree-nested path that read_session_meta() also
# honors. Prints the resolved directory, or empty if none found.
_resolve_session_dir() {
    local name="$1"
    local primary="${SESSIONS_DIR}/${name}"
    if [[ -f "${primary}/meta" ]]; then
        printf '%s' "$primary"
        return
    fi
    local legacy="${WORKTREES_DIR}/${name}/.ae/${name}"
    if [[ -f "${legacy}/meta" ]]; then
        printf '%s' "$legacy"
        return
    fi
}

# `ae next` — attention navigator (Layer 2). Names the top-ranked RUNNING session
# needing attention, with the same semantics as `ae list`'s attn marker because
# since A.2c it is the same code: both are the core's. Read-only by default
# (prints); `--attach` jumps to it (switch-client inside tmux / attach-session
# outside). Exits non-zero when nothing needs attention so it composes in scripts
# and Layer 3. Tie-break across equally-severe sessions: activity, then name asc.
cmd_next() {
    # A.2c: `next`/`jump` is the CORE's, whole — the ranking, the read-only print,
    # the `--attach` jump and its own `--help` and usage error all live there, so
    # the glue keeps no second ranker to drift against `ae list`'s attention. A
    # thin exec with the argv verbatim, like `list`.
    #
    # `next` is the word the core is given for BOTH spellings: it treats `jump` as
    # the alias it always was, and every message it prints already says "ae next".
    # Nothing here parses the tail — an unknown argument is the core's usage error.
    _ae_core_preflight_try --exec next "$@"
}

# Escape a string for embedding in JSON. Single source: this body is emitted
# into every generated _lib via declare -f AND used directly by ae's own code.
# The `_json_escape` alias that used to sit under it is gone with its last
# caller — `list --json` is the core's, and no bash emits JSON on its own now.
# Flatten an event summary to one line and cap its length, into _EV_SUMMARY.
# Emitted into every generated _lib alongside ae_emit_event, its only caller.
#
# This replaces a `head -c N | tr` pipeline that cut at a BYTE count. When the
# boundary landed mid-character (an em-dash is 3 bytes), the partial sequence
# reached BSD tr under a UTF-8 locale, which refuses it — "Illegal byte
# sequence", rc 1 — and the whole ask/send failed: no delivery, no event. It was
# alignment-dependent, so the same text one byte over worked fine. Shipped and
# hit live 2026-08-02. The portability campaign covered tool ABSENCE; this is
# locale STRICTNESS, the same silent-failure family on a new axis.
#
# Two properties, both required: the cap must never abort (no tr, no fork at
# all now), and it must never emit an invalid byte into events.jsonl.
# Drop malformed UTF-8 from text bound for events.jsonl, into _EV_CLEAN.
#
# Summary text is agent- and user-controlled, so it can already be invalid
# before ae ever truncates it — `abc\x80def` passed straight through and left a
# line no UTF-8 reader will accept. AGENTS.md already names events.jsonl a
# sanitising boundary (control bytes are stripped at write time); this extends
# that same chokepoint to malformed sequences. It is DATA, not protocol: the
# event still emits, rc stays 0, the summary is just clean.
#
# Pure bash on purpose — no iconv dependency — and the common case is O(1): a
# summary with no high bytes is returned untouched without scanning.
ae_sanitize_utf8() {
    local s="$1"
    local LC_ALL=C
    if [[ "$s" != *[$'\x80'-$'\xff']* ]]; then
        _EV_CLEAN="$s"
        return 0
    fi
    local out="" i=0 n=${#s} b c1 c2 c3 need lo hi ok
    while ((i < n)); do
        printf -v b '%d' "'${s:i:1}"
        if ((b < 0x80)); then
            out+="${s:i:1}"
            i=$((i + 1))
            continue
        fi
        # Lead byte -> how many continuations, and the legal range of the FIRST
        # one. The narrowed first-continuation ranges are what reject overlong
        # encodings (C0/C1, E0 80) and UTF-16 surrogates (ED A0), which a plain
        # 80-BF check would let through and iconv would still refuse.
        need=0
        lo=0x80
        hi=0xbf
        if ((b >= 0xc2 && b <= 0xdf)); then
            need=1
        elif ((b == 0xe0)); then
            need=2
            lo=0xa0
        elif ((b >= 0xe1 && b <= 0xec)); then
            need=2
        elif ((b == 0xed)); then
            need=2
            hi=0x9f
        elif ((b >= 0xee && b <= 0xef)); then
            need=2
        elif ((b == 0xf0)); then
            need=3
            lo=0x90
        elif ((b >= 0xf1 && b <= 0xf3)); then
            need=3
        elif ((b == 0xf4)); then
            need=3
            hi=0x8f
        else
            i=$((i + 1)) # bare continuation byte, or an impossible lead
            continue
        fi
        ok=1
        ((i + need < n)) || ok=0
        if ((ok)); then
            printf -v c1 '%d' "'${s:i+1:1}"
            ((c1 >= lo && c1 <= hi)) || ok=0
            if ((ok && need >= 2)); then
                printf -v c2 '%d' "'${s:i+2:1}"
                ((c2 >= 0x80 && c2 <= 0xbf)) || ok=0
            fi
            if ((ok && need >= 3)); then
                printf -v c3 '%d' "'${s:i+3:1}"
                ((c3 >= 0x80 && c3 <= 0xbf)) || ok=0
            fi
        fi
        if ((ok)); then
            out+="${s:i:need+1}"
            i=$((i + need + 1))
        else
            i=$((i + 1)) # truncated or illegal sequence: drop the lead byte
        fi
    done
    _EV_CLEAN="$out"
    return 0
}

ae_cap_summary() {
    local s="$1" max="$2"
    # One em-dash, spelled as its UTF-8 bytes so this works on bash 4.0 (the
    # \u escape is 4.2+). Length 1 => bash is counting characters.
    local _mb=$'\xe2\x80\x94'
    # The locale must be decided BEFORE any length reasoning. An outer
    # length test would run in the AMBIENT locale, and under SJIS/GB18030 a
    # 198-ASCII + emoji string measures 200 "characters" — so the cap looked
    # satisfied, the fallback never ran, and 202 bytes were emitted with the cap
    # silently UNENFORCED. Each branch now owns its own comparison.
    if ((${#_mb} == 1)); then
        # Bash is UTF-8 character aware: ${#s} and the slice count CHARACTERS,
        # so the cut lands on a character boundary by construction and there is
        # nothing to repair. The cap is in characters here, by design.
        if ((${#s} > max)); then
            s="${s:0:max}"
        fi
    else
        # NOT UTF-8 character aware — which does NOT mean "counting bytes".
        # ja_JP.SJIS, zh_CN.GB18030 and ko_KR.eucKR are multibyte too: the probe
        # measures 2 there, and bash would both MEASURE and slice in THOSE
        # characters while the walk-back below reasons about UTF-8 bytes. Force
        # real byte semantics for the whole fallback — comparison, slice and
        # walk — with a FUNCTION-LOCAL LC_ALL, restored on return.
        local LC_ALL=C
        if ((${#s} > max)); then
            s="${s:0:max}"
            # Drop a trailing incomplete UTF-8 sequence: continuation bytes
            # (0x80-BF) first, then a dangling lead byte (0xC0-F7).
            while [[ -n "$s" && "${s: -1}" == [$'\x80'-$'\xbf'] ]]; do
                s="${s%?}"
            done
            [[ -n "$s" && "${s: -1}" == [$'\xc0'-$'\xf7'] ]] && s="${s%?}"
        fi
    fi
    _EV_SUMMARY="$s"
    return 0
}

ae_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/\\r}"
    printf '%s' "$s"
}

# shellcheck disable=SC2059 # format strings stored in variables intentionally
cmd_list() {
    # A.2a: `list` is the CORE's, whole. It computes liveness, branch and the
    # attention rollup itself, so the glue keeps no second implementation to drift
    # against — this is a thin exec with the argv verbatim, which is exactly what
    # the public wrapper (`ae-entry`) does for the same word. Both entries then
    # answer identically; a divergence would otherwise depend on which `ae` the
    # caller happened to run.
    #
    # `-h`/`--help` is the ONE exception, and it is the wrapper's contract, not a
    # convenience: ae-entry scans the tail for exactly those two tokens and routes
    # them BACK here, because the core parses help only at top level and would
    # answer a list tail with UnknownFlag rc 2. The text below is the ratified one.
    # This block retires the day the core grows a ratified list-help.
    local _lh
    for _lh in "$@"; do
        case "$_lh" in
            -h | --help)
                cat >&2 <<'LISTHELP'
Usage: ae list [--running | --all | --stopped | --needs-attn | --active] [--json]
  (default)    running sessions only
  --running    running sessions only (explicit)
  --all        running sessions, then stopped ones
  --stopped    stopped sessions only
  --needs-attn only running sessions with an attn reason — declared
               waiting-user/blocked, watchdog-derived dead/stale/throttled, or an
               unanswered inter-agent ask/review (older than 30m); implies
               running-only
               (aliases: --needs-me, --needs, --attn)
  --active     only running sessions with recent activity (an ae event in the
               last 5 min). Implies running-only (alias: --busy)
  --json       machine-readable digest (schema_version, per-session
               needs_attention + attention reason, per-agent state); honours
               the filters above.
LISTHELP
                return 0
                ;;
        esac
    done
    # Every other tail — including an unknown flag, which the core reports as a
    # usage error with exit 2 — is the core's to parse.
    _ae_core_preflight_try --exec list "$@"
}

# ── #48 archive: pure facts ─────────────────────────────────────────────────────
# Everything here is a QUERY: stdout is the answer, status is a deliberate 0, and none
# of it touches live state. The archive writer and `archive preview` share these, so a
# preview cannot drift from what would actually be published.

cmd_archive_preview() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae archive preview [session-name]" >&2
            echo "(Run inside an ae tmux session to preview it without naming it.)" >&2
            return 1
        }
    fi
    _session_name_usable "$target" || {
        echo "ae: '${target}' is not a usable session name." >&2
        return 1
    }
    local dir="${SESSIONS_DIR}/${target}"
    if [[ ! -d "$dir" ]]; then
        echo "ae: no session state for '${target}'." >&2
        return 1
    fi
    _require_session_path_safe "$target" || return 1
    # P3.2: the Rust core IS the read-only preview tracer, for every mode. It
    # renders a local session's digest and a non-local one's real git facts (HEAD,
    # range, count) through its typed Git capability — it runs `git` through the
    # one process door with OS-native argv, no shell — so the mode gate that once
    # kept unproven shapes on a bash body is gone with the body.
    #
    # `dir` is resolved, existing and path-safe; the core is handed it and renders
    # the whole preview (digest to stdout, banner to stderr) writing nothing. The
    # shim EXECs the core and never returns; with no usable core it refuses (one
    # line, exit 2). META_DIR is a prefix assignment: visible to the shim, which
    # reads ${META_DIR}/meta and execs the core with it, and never mutating the
    # global.
    META_DIR="$dir" _ae_core_try _archive-preview
}

# ── compact phase (b): the semantic handover ────────────────────────────────────
# This is the first place compact TALKS to a live agent, so every failure here is a
# DELIVERY failure and is treated as one: a send that cannot be verified refuses
# immediately, a wait that expires refuses before anything is stopped, and the only
# degradation is the explicit --digest-only — which withdraws the request through the
# sensor rather than pretending it was answered. There is no headless fallback and no
# fabricated reply: the point of the handover is that the agent that did the work says
# what matters, and nothing else can stand in for that.

# Wait for BOTH facts, polling the LOG and the MEMO — never pane output, which is the one
# source this project has repeatedly proven cannot answer "did it land". A reply alone is
# an agent saying "done" with nothing written down; a memo alone is something written with
# nobody claiming the work stopped.
# Reports WHICH of the two facts arrived, REPLY-style in _AE_CP_SAW, because the caller's
# failure message is only honest if it can tell them apart: a reply that arrived CLOSED the
# request, so "re-run to keep waiting on it" — true when nothing arrived — is false here.
# The next run would send a NEW request with a NEW ref and wait on that instead.
_AE_CP_SAW=""
# ── compact phase (c): revalidate, then end under one lock ──────────────────────
# THE ABA GUARD. Everything below re-proves the frozen tuple against the world before
# acting on it, because a name is not an instance: the session that answers to this name
# now may not be the one the human authorized. This slice proved that gap is REACHABLE in
# `ae end` itself, so here it is checked twice — once after the confirmation so a
# replacement is never MESSAGED, and again after the bounded wait so a replacement is
# never STOPPED.

cmd_status() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Usage: ae status [session-name]" >&2
            echo "(Run inside an ae tmux session to check status without specifying the name.)" >&2
            return 1
        }
    fi
    if ! tmux has-session -t "$target" 2>/dev/null; then
        if [[ -d "${SESSIONS_DIR}/${target}" ]]; then
            echo "Session '$target' is stopped."
            return 0
        fi
        echo "Session '$target' not found." >&2
        return 1
    fi
    local found=false
    while IFS=$'\t' read -r pane_id ae_agent; do
        [[ -n "$ae_agent" ]] || continue
        found=true
        echo "── ${ae_agent} (${pane_id}) ──"
        # || true: an EMPTY pane makes grep exit 1, and under `set -e` +
        # pipefail that aborted cmd_status mid-document — the caller saw a
        # truncated status AND a non-zero exit. A blank pane is not an error.
        tmux capture-pane -t "$pane_id" -p 2>/dev/null | grep -v '^$' | tail -15 || true
        echo ""
    done < <(tmux list-panes -s -t "$target" -F '#{pane_id}	#{@ae_agent}' 2>/dev/null)
    if [[ "$found" == false ]]; then
        echo "No agent panes in session '$target'."
    fi
}

# ══════════════════════════════════════════════════════════════════════════
# THE SELF/TARGET IDENTITY CONTRACT
#
# THREAT MODEL. Everything below defends against ACCIDENTAL MISUSE by this tool's
# single human and the agents acting on their behalf — a stale payload, a name
# reused between two operations, a lifecycle op landing mid-freeze, a pane that is
# not the session it appears to be. It does NOT defend against adversarial
# processes on the same machine: anything that can forge argv, write ae's metadata
# or hold its locks has already won by easier routes. Findings outside this model
# are filed as issues, not fixed inline — the contract is here to keep ordinary use
# from destroying work, not to survive an attacker who already owns the box.
#
# The question every stop must answer is "may THIS process stop THAT session".
# It decomposes differently per route:
#
#   NAMED ROUTE  (`ae stop <name>`) — the human named a target. Self-ness is
#     irrelevant; stopping a session from anywhere is legitimate. It needs only
#     the destruction facts D1..D5. It must merely never be MISCLASSIFIED as
#     self, which would route it through the supervisor and tell the user their
#     pane is closing when it is not.
#
#   IDENTITY ROUTE (`ae stop` with no name, or a target that IS us) — the kill
#     would destroy the caller mid-operation, so C1..C5 must ALL hold before the
#     work may be handed to the supervisor.
#
# This block exists because four review rounds each found a different INCOMPLETE
# FACET of the same proof (tty-but-not-server, server-but-not-target,
# target-but-not-enumeration) — a design being derived by adversarial iteration
# instead of stated. Every fact below names what PROVES it and what happens when
# it cannot be proven. A fact with no proof mechanism is a REFUSAL, never a gap
# to be filled later.
#
# ── CURRENT-TARGET FACTS (identity route; ALL required) ───────────────────
#   C1  We are inside tmux at all.
#       PROVEN BY: $TMUX and $TMUX_PANE both set.
#       UNPROVABLE -> not self. Env is a PRECONDITION, never evidence: every one
#       of these variables is inherited and can be handed to us.
#   C2  Our ambient server answers for ITSELF.
#       PROVEN BY: socket_path + server pid, round-tripped from that socket,
#       equal to the fields we were handed in $TMUX.
#       UNPROVABLE -> not self. Catches a stale $TMUX (server restarted) and a
#       forged one.
#   C3  Our ambient server IS the target's RECORDED server.
#       PROVEN BY: the same socket_path + pid pair asked of the target's recorded
#       server via _end_tmux — compared as an ANSWER, not as strings, so a -L
#       name and an -S path naming one server still match.
#       UNPROVABLE -> not self. Missing this killed a recorded session on server
#       A from an identically-named interactive pane on server B.
#   C4  Our PANE resolves, on that server, to the target session itself.
#       PROVEN BY: our pane id -> '#{session_id} #{session_name}' on that socket,
#       both equal to the target's exact live id and its name.
#       WHICH PANE ID: $TMUX_PANE for an interactive shell. NOT for a run-shell
#       child — MEASURED 2026-08-11: `run-shell -t probe` hands the child
#       TMUX_PANE=%60 (inherited from the server's own environment) while the
#       target pane is %0. The variable is not merely absent there, it is WRONG,
#       and trusting it is exactly why `run-shell -t alpha` resolved and killed
#       BETA. A run-shell child therefore learns its pane the only way tmux
#       offers: a FORMAT the server expands for the target, passed as --pane
#       #{pane_id} and validated as ^%[0-9]+$ before use. That token is
#       tmux-generated and shape-checked, unlike #{session_name}, which is
#       attacker-influenced text and stays out of the recipe.
#       UNPROVABLE -> not self.
#   C5  Our CONTROLLING TTY is that pane's tty.
#       PROVEN BY: ps -o tty= of this process == '#{pane_tty}'.
#       UNPROVABLE -> not self, EXCEPT under --self, which bypasses THIS FACT AND
#       ONLY THIS FACT, because a tmux run-shell child legitimately has no
#       controlling terminal. The flag buys the bypass of a proof MECHANISM; it
#       never supplies the CONCLUSION, and C1..C4 still have to hold.
#
# ── DESTRUCTION FACTS (both routes; ALL required) ─────────────────────────
#   D1  Name usable AND on-disk path a physical direct child, checked at EVERY
#       entrypoint (public dispatch + both internal). A boundary is entered,
#       never inherited. UNPROVABLE -> refuse, nothing touched.
#   D2  A POSITIVE recorded server. UNPROVABLE -> refuse; ae never guesses a
#       server, and since stop destroys nothing there is nothing to acknowledge
#       one's way past.
#   D3  Addressed by EXACT session id on that server, never by name (`-t <name>`
#       prefix-matches).
#   D4  The kill is VERIFIED gone, tri-state: alive and unverifiable are BOTH
#       failures and neither may print "Stopped".
#   D5  The lifecycle lock is held across identity -> kill -> verify.
#
# ── FLEET FACTS (`ae stop all`) ───────────────────────────────────────────
#   F1  The fleet is what ae's METADATA owns; enumerate the RECORDED servers.
#       Ambient enumeration is a redirectable heuristic — AE_TMUX_SERVER redirects
#       it, and using it stopped server A's session while reporting on B's.
#   F2  An AE_SESSION-tagged session seen ambiently but ABSENT from metadata is
#       reported LOUDLY as unmanaged: never silently stopped, never silently
#       ignored.
#   F3  Any mismatch or per-target failure is a loud PARTIAL FAILURE, never
#       counted as success.
#
# ── INTERACTION FACTS (the caller IS one of the fleet targets) ────────────
# C1..C5, D1..D5 and F1..F3 each hold in isolation. Both round-6 blockers lived
# in what none of them said: what happens when the session being enumerated is
# the session doing the enumerating. Stating the interaction is the fix.
#   F4  THE FLEET LOOP NEVER RUNS IN A PROCESS THE FLEET LOOP CAN KILL.
#       Rounds 4-6 tried to IDENTIFY the caller among the targets and stop it
#       last. That rests on a false premise: "cannot prove a caller" is not
#       "there is no caller". A child with $TMUX/$TMUX_PANE sanitised away is
#       still PHYSICALLY IN THE PANE that dies — measured: C1 unprovable, so the
#       caller was classed as no-one, killed inline first, and the remaining
#       target was abandoned. And --pane is an ARGV SELECTOR, not evidence of
#       where the caller lives: any process can pass any valid id, so without C5
#       the wrong target gets deferred while the real caller stays inline-killable.
#       No-tty caller attestation is impossible IN GENERAL, so ae stops attempting
#       it: `stop all` ALWAYS hands the loop to a DETACHED supervisor.
#       PROVEN BY: construction, not inference — the supervisor is nohup'd with
#       all stdio detached and holds no lifecycle fd, so no session it kills can
#       be running it. Ordering is then a nicety, never a safety property, and no
#       flag or pane id is consulted for `all` at all.
#       (C5/--pane machinery stays for SINGULAR self-stop, where the caller IS
#       the named target by construction and the tty proof genuinely holds.)
#   F5  A TARGET AE DOES NOT OWN IS A FAILURE, NOT A NOTE. An unmanaged
#       ae-tagged session found and left running means the fleet operation did
#       NOT do what `stop all` says. It contributes a non-zero rc, and the
#       success-shaped summary ("No running ae sessions.") is suppressed whenever
#       anything was found. This check KILLS NOTHING, so it stays with the caller
#       where its rc is directly useful; F4 governs the loop that kills.
#   F6  OWNERSHIP AND LIVENESS ARE SEPARATE QUESTIONS, and liveness is TRI-STATE.
#       Enumerating the fleet by "has a resolvable live id" silently DROPPED every
#       target whose recorded server was UNREACHABLE, conflating it with verified-
#       stopped: `stop all` answered rc 0 "No running ae sessions." for a session
#       that singular `stop` correctly refused with "cannot verify". Enumerate
#       OWNERSHIP from metadata; then skip a target only when it is VERIFIED GONE.
#       UNKNOWN is carried into the fleet and folded as FAILURE, never dropped.
#   F7  HANDING OFF THE LOOP MUST NOT COST THE CALLER ITS EXIT CODE. F4 moved the
#       kills out of process; an rc that then covered only the HANDOFF would starve
#       every OUTSIDE caller — a script running `ae stop all` deserves a real exit
#       status, which is F5's rc-honesty one level up. So the caller WAITS ON THE
#       RECORD instead of on the loop: bounded (~30s) polling of each target's
#       durable stop-result, then the outcomes fold into the rc alongside F5.
#       PROVEN BY: the caller's SURVIVAL, which is never asked as a question — F4's
#       abolished identity proof does not come back in disguise. A caller that WAS
#       a target dies mid-wait having already reported all it could honestly know;
#       a caller that was not stays and reports. Timeout is not a verdict on the
#       sessions: the handoff rc stands, "results pending" is said out loud, and
#       the read-back one-liner is named.
#   F8  AN OPERATION AWAITS ITS OWN RESULTS, NOT RESULTS IN GENERAL. F7 asked "is
#       there a stop-result newer than my baseline" — a COUNT DELTA, and a count
#       delta carries no provenance. Measured: two concurrent `ae stop all -y` over
#       one session, and the FIRST child's single result satisfied BOTH callers
#       (rc 0 twice) while the second child found an empty fleet and emitted
#       nothing. PROVEN BY: an OPERATION ID minted per invocation, stamped into
#       BOTH stop-request and stop-result, with the poll filtering on it. One
#       function owns the stamp so writer and reader cannot drift.
#   F9  WHAT WAS CONFIRMED IS WHAT GETS ACTED ON — THE SET IS FROZEN AT
#       CONFIRMATION. The supervisor re-enumerated metadata after the handoff, so
#       the fleet it KILLED was not the fleet the human APPROVED: a session created
#       in that gap died unconfirmed, and unawaited (measured — both died, caller
#       rc 0). A destructive scope must never be re-derived downstream of its own
#       confirmation. PROVEN BY: the caller freezes the list and passes it as argv;
#       the supervisor enumerates NOTHING and may only shrink that set, never grow
#       it. F8's id and F9's list are one payload: they are minted together, travel
#       together, and answer the same question — WHICH operation, over WHICH set.
#   F10 A FROZEN NAME AUTHORIZES KILLING THE INSTANCE THAT CARRIED IT AT
#       CONFIRMATION, NEVER WHATEVER CARRIES THE NAME AT KILL TIME. F9 froze the
#       SET but the set was made of NAMES, and a name is a slot, not a thing —
#       classic ABA. Measured: create a session, `ae end` it completely, launch a
#       FRESH one under the same name, then act on the frozen payload; the
#       REPLACEMENT died and success was recorded. The window is exactly as long as
#       a human stands at the confirmation prompt, and it falsified the promise the
#       docs make — that a session started while you were deciding is left alone.
#       PROVEN BY: freezing (name, session_id) pairs — the instance token ae already
#       records, minted per launch and preserved across stop/resume, rename and
#       transfer — and comparing the frozen value to what meta records RIGHT NOW,
#       INSIDE the per-name lifecycle lock, immediately before the server is
#       resolved and the kill issued. Inside is the whole fix: a check taken before
#       the lock is acquired leaves the identical race, since a launch can complete
#       between the check and the kill. A mismatch is a STAMPED FAILURE naming both
#       instances, and the replacement is left running.
#       "-" IS NEVER COMPARED AS IDENTITY. Treating it as a value that must match
#       was still wrong, because it is a SHARED sentinel and equality is not
#       identity when the value is shared: two pre-feature sessions both froze "-",
#       so ending one and `ae rename`-ing another into its name (rename preserves a
#       missing id) satisfied the comparison exactly, and the replacement died with
#       rc 0. Two layers, and they compose:
#         (a) MINT AT FREEZE. A session entering a fleet confirmation without an
#             identity is GIVEN one there — under its own lifecycle lock, written
#             durably (migration-on-touch, as with the doctor migrations and the
#             legacy-name arm). From its first fleet contact it has a real token:
#             stop/resume preserves it, and rename then moves something that
#             actually denotes a session.
#         (b) REFUSE A FROZEN "-". After (a) a dash can only be a stale or forged
#             payload, so it is refused outright and stamped, naming this fact.
#             Nothing is ever authorized by a sentinel two sessions can share.
#   F11 A PAYLOAD IS ACCEPTED WHOLE, OR NOT AT ALL. The first shape check validated
#       the odd tail AFTER the loop, so `opid oddone <id> dangling` KILLED oddone
#       and recorded it verified-gone before returning 1 — a refusal issued after
#       the destruction it existed to prevent. The committed seed missed it because
#       one bare name is ZERO complete pairs: the specimen never reached the
#       property. PROVEN BY: a preflight over the entire payload — count, every
#       name, every token — that must pass before the first pair is acted on. This
#       is the round-3 validate-before-act law, moved from the single target to the
#       batch.
# ══════════════════════════════════════════════════════════════════════════

# Classify an `ae end` target BEFORE any destructive prompt. Echoes:
#   live      — a running tmux session
#   stopped   — no tmux session, but a session dir exists (SESSIONS_DIR/<name>)
#   worktree  — no tmux session, no session dir, but a worktree dir exists
#   (empty)   — not found: the caller MUST error out without prompting
# 'all' is handled by the caller and never passed here. A name containing '/' can
# never be a valid session/worktree basename (path-traversal guard, preserved from the
# original elif conditions), so it classifies as not-found.
# The tmux server a target session lives on (its own meta `tmux_server`), or empty for
# the ambient/default server. The `ae end` path must target the session's OWN server:
# `_ae_session_id` lists the AMBIENT server, so a plain-shell `ae end X` for an X live on
# a NAMED server misses it, misclassifies X as stopped, deletes its state, and leaves X
# running (orphaned). The doctor orphan check already reads per-session tmux_server; the
# end path must too. (The prefix-match class's other axis: wrong SERVER, not just a name
# prefix — sweep every consumer of the target name on the end path.)
# Print "-S <path>" / "-L <name>" argv words for a (KIND, VALUE) pair. The kind is a
# SEPARATE stored key (tmux_server_kind) — never inferred from a value prefix, because
# a legacy -L server may literally be named "S:x" (7th review B2). Legacy metas have no
# kind: a non-empty legacy value is a NAME (-L; released ae never wrote paths); empty or
# kind=ambiguous prints NOTHING — callers must fail closed, never guess a server.
# Where a launch ACTUALLY lands, as a TYPED PAIR in globals (kind|value).
#
# The core may not read the environment and does not ask tmux which server it is
# on: it RECORDS the pair the glue hands it. So an unresolved `AE_TMUX_SERVER`
# (or an inherited $TMUX, or nothing at all) would land in meta verbatim, and
# every exact-server consumer would read that as "the default server" while the
# session lived somewhere else — the lie the 4th review's B1 closed.
#
# Ask tmux ITSELF for #{socket_path}; a RELATIVE answer is proven by a PID
# round-trip (7th review B1: readlink in the caller's cwd found a same-named
# decoy) and is `ambiguous` when it cannot be proven, so the core fails closed
# rather than guessing.
resolve_launch_tmux_server() {
    _LAUNCH_SRV_KIND=""
    _LAUNCH_SRV_VALUE=""
    local _sp _pid _cand _cpid
    _sp="$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)"
    if [[ -n "$_sp" ]]; then
        if [[ "$_sp" == /* ]]; then
            _LAUNCH_SRV_KIND="socket"
            _LAUNCH_SRV_VALUE="$_sp"
            return 0
        fi
        _pid="$(tmux display-message -p '#{pid}' 2>/dev/null || true)"
        # realpath fallback: `readlink -f` is GNU (macOS only grew it in 12.3),
        # and without a canonical path a relative socket reads as ambiguous and
        # forces every lifecycle operation on that session to fail closed.
        _cand="$(readlink -f -- "$_sp" 2>/dev/null || realpath "$_sp" 2>/dev/null || true)"
        if [[ -n "$_pid" && -n "$_cand" && -S "$_cand" ]]; then
            _cpid="$(command tmux -S "$_cand" display-message -p '#{pid}' 2>/dev/null || true)"
            if [[ -n "$_cpid" && "$_cpid" == "$_pid" ]]; then
                _LAUNCH_SRV_KIND="socket"
                _LAUNCH_SRV_VALUE="$_cand"
                return 0
            fi
        fi
        _LAUNCH_SRV_KIND="ambiguous"
        _LAUNCH_SRV_VALUE="$_sp"
        return 0
    fi
    if [[ -n "${AE_TMUX_SERVER:-}" ]]; then
        # The re-export path carries the kind SEPARATELY (AE_TMUX_SERVER_KIND) — use it
        # when present; otherwise type by shape. Never strip prefixes from the value:
        # a legacy -L server may literally be named "S:evil" (8th review I2).
        if [[ "${AE_TMUX_SERVER_KIND:-}" == "socket" || "${AE_TMUX_SERVER_KIND:-}" == "name" ]]; then
            _LAUNCH_SRV_KIND="$AE_TMUX_SERVER_KIND"
        elif [[ "$AE_TMUX_SERVER" == /* ]]; then
            _LAUNCH_SRV_KIND="socket"
        else
            _LAUNCH_SRV_KIND="name"
        fi
        _LAUNCH_SRV_VALUE="$AE_TMUX_SERVER"
        return 0
    fi
    # DELIBERATELY a bare $TMUX test, unlike the four client-semantics branches
    # hardened for #29: this reads the SOCKET PATH, not our client status. A
    # $TMUX inherited by a GUI terminal still names the very server that spawned
    # it — the right server to talk to. _ae_inside_tmux here would discard a
    # correct answer for being second-hand.
    if [[ -n "${TMUX:-}" ]]; then
        _LAUNCH_SRV_KIND="socket"
        _LAUNCH_SRV_VALUE="${TMUX%%,*}"
    fi
    return 0
}

_srv_tmux_args() {
    local kind="$1" v="$2"
    case "$kind" in
        socket) [[ -n "$v" ]] && printf -- '-S\n%s\n' "$v" ;;
        name) [[ -n "$v" ]] && printf -- '-L\n%s\n' "$v" ;;
        ambiguous) : ;;
        *) [[ -n "$v" ]] && printf -- '-L\n%s\n' "$v" ;;
    esac
    return 0
}

_end_target_server() {
    local _m _k
    _m="$(read_session_meta "$1" tmux_server 2>/dev/null || true)"
    _k="$(read_session_meta "$1" tmux_server_kind 2>/dev/null || true)"
    # The explicit override applies whenever the durable record is NOT positive —
    # legacy-empty OR kind=ambiguous (8th review I1).
    if [[ -n "${AE_END_SERVER:-}" ]] && [[ -z "$_m" || "$_k" == "ambiguous" ]]; then
        printf '%s' "$AE_END_SERVER"
        return 0
    fi
    printf '%s' "$_m"
    return 0
}

# The stored kind for a target ('' for legacy metas). The AE_END_SERVER override types
# itself by shape (an explicit human assertion), and only applies when the durable
# record is legacy-empty — mirroring _end_target_server.
_end_target_kind() {
    local _k _m
    _m="$(read_session_meta "$1" tmux_server 2>/dev/null || true)"
    _k="$(read_session_meta "$1" tmux_server_kind 2>/dev/null || true)"
    if [[ -n "${AE_END_SERVER:-}" ]] && [[ -z "$_m" || "$_k" == "ambiguous" ]]; then
        if [[ "$AE_END_SERVER" == /* ]]; then printf 'socket'; else printf 'name'; fi
        return 0
    fi
    printf '%s' "$_k"
    return 0
}

_end_tmux() {
    local target="$1"
    shift
    local srv kind
    srv="$(_end_target_server "$target")"
    kind="$(_end_target_kind "$target")"
    if [[ "$kind" == "ambiguous" ]]; then
        # An ambiguous record must never pick a server — the caller's fail-closed
        # guards handle it; running anything here would be a guess.
        return 1
    fi
    if [[ -z "$srv" ]]; then
        # No positive record: under the invariant nothing on the end path may aim a
        # command at a guessed server — the blank/ambiguous branch in end_session is
        # the only consumer of that state and it never reaches here.
        return 1
    fi
    local -a _sel=()
    mapfile -t _sel < <(_srv_tmux_args "$kind" "$srv")
    command tmux "${_sel[@]}" "$@"
}

# Exact session id for TARGET on its own server ('' when not live there). `|| true` keeps
# this a return-0 query even when the recorded server is DOWN — a failed `list-sessions`
# under pipefail must not set-e-abort a bare caller (AGENTS.md query-function contract).
# Was TARGET's session VERIFIABLY killed? Tri-state, because "empty query result"
# proves nothing when the query itself failed (4th review, B2: chmod the socket and
# kill+list both fail — the old empty-means-gone check then cleaned up a LIVE session).
#   0 — verified gone: a SUCCESSFUL listing lacks the name, or tmux says
#       "no server running" (killing the last session exits the server; its stale
#       socket file remains, so socket-absence is NOT the signal — the stderr is)
#   1 — verified alive: a successful listing still contains the name
#   2 — cannot verify: the server is unreachable (connect error) — callers must
#       PRESERVE state and fail loudly rather than guess
# Callers capture rc via `vg=0; _end_verify_gone t || vg=$?` (a bare call would
# errexit-abort on 1/2 — AGENTS.md).
# Best-effort sweep of the ENUMERABLE -L sockets in the tmux socket dir for a live
# session named $1 (skipping the pinned default, which the caller already checked).
# Prints the first matching server name, else nothing. -S sockets at arbitrary paths
# are inherently unenumerable — this narrows the legacy-empty ambiguity, it cannot
# close it; the residual risk is documented at the call site.
# Is a failed tmux invocation's stderr a CLEAN-DEAD server (safe to treat the session
# as gone) — as opposed to unreachable/unverifiable? ANCHORED to tmux's exact diagnostic
# shapes, never substring matching (10th review B2: a server literally NAMED
# "no server running" made its permission error contain the magic words):
#   clean-dead:  "no server running on <path>"   — and ONLY that (stale socket)
#   anything else — ENOENT, permission denied, refused, unknown — is NOT clean-dead.
# Predicate: nonzero return is a QUERY result; every caller guards it (AGENTS.md).
_tmux_err_is_clean_dead() {
    # ONLY the stale-socket shape is clean-dead: tmux leaves the socket file behind
    # when the server exits, so "no server running on <path>" proves a clean exit.
    # ENOENT does NOT (11th review B1): unlinking a LIVE server's socket yields the
    # same connect error while the server and its sessions keep running — treating it
    # as dead deleted state under a live target. ENOENT = cannot-verify, fail closed.
    [[ "$1" == "no server running on "* ]] && return 0
    return 1
}

# Exact-match check for a RUNNING tmux session (not prefix — same guard as the
# main script). Used by ae's own companion autostarts and by the telegram spawn,
# which retires a stale aewatch sidecar through it.
#
# BOUNDARY (round-3 BLOCKER): this lives at TOP LEVEL, beside the classifier it
# depends on. It previously existed ONLY inside the bash telegram daemon's
# heredoc, so ae's own top-level callers invoked an undefined command: rc 127,
# swallowed by their `2>/dev/null`, which reads as neither running nor unknown
# and therefore fell straight through to CREATE. That heredoc is gone with the
# bash bridge, and this definition is now the only one there has ever needed to
# be — keep it at top level, where its callers actually run.
#
# TRI-STATE (#28), same contract as _end_verify_gone: "the query failed" is not
# "the session is absent". The old `2>/dev/null | grep -Fxq` swallowed every
# tmux error into a plain false, so one transient client failure (observed live
# 2026-08-05 on the first tmux invocation from a freshly-launched terminal app)
# read as daemon-absent and fired an orchestrator autostart whose backgrounded
# duplicate then died silently against the session already running.
#   0 — running
#   1 — verifiably absent: a SUCCESSFUL listing lacks the name, or tmux itself
#       says the server exited (the stale-socket diagnostic)
#   2 — UNKNOWN: tmux failed for any other reason. Callers that ACT on absence
#       must treat this as "do nothing" — fail toward the no-op.
#
# BOTH ERROR DIRECTIONS, because they are not symmetric:
#   error read as ABSENCE  -> we CREATE a companion on top of a live one. For
#       the ENOENT shape that is worse than a duplicate session: the socket is
#       gone but the server is not (someone unlinked it), so the create lands a
#       SECOND SERVER on that path and the two never see each other.
#   absence read as UNKNOWN -> we skip a companion start that was wanted. The
#       human reads one line of stderr and runs `ae orchestrator` by hand.
# The first is silent and compounding, the second is loud and trivially
# recoverable — so absence must be PROVEN, never inferred from an error we
# merely failed to recognise. That is why this shares _tmux_err_is_clean_dead
# (stale socket ONLY) rather than carrying a looser classifier of its own: the
# live-unlinked case it excludes (11th review B1) is exactly the case that would
# fork a second server here.
#
# Output is captured before matching instead of piped into `grep -q`: grep's
# early exit SIGPIPEs tmux, and under pipefail that turns a match into a
# nonzero pipeline (AGENTS.md). One immediate retry absorbs the transient case
# — no sleep, because the observed failure is first-call-only and a delay would
# tax the launch path on every genuinely broken tmux.
# Bare calls errexit-abort on 1/2 — every caller guards (AGENTS.md).
daemon_session_running() {
    local _name="$1" _out="" _rc=0 _try _line
    for _try in 1 2; do
        _rc=0
        _out="$(tmux list-sessions -F '#{session_name}' 2>&1)" || _rc=$?
        if ((_rc == 0)); then
            break
        fi
        if _tmux_err_is_clean_dead "$_out"; then
            return 1
        fi
    done
    ((_rc == 0)) || return 2
    while IFS= read -r _line; do
        if [[ "$_line" == "$_name" ]]; then
            return 0
        fi
    done <<<"$_out"
    return 1
}

# WHAT THE HUMAN ACTUALLY CONFIRMED, frozen at the prompt and keyed by target. The plan
# is resolved from config, and config can change between the question and the answer: a
# reviewer flipped a session's purge_agent_history while the prompt was waiting and a
# confirmed KEEP carried out a PURGE — the same ABA shape the stop path already guards,
# reached through the confirmation gap. Populated only when a human was actually asked;
# `-f` freezes nothing, because nothing was promised.
declare -A _AE_END_FROZEN_PLAN=()
# WHOSE contract the payload is: `confirmed` (a human answered end's prompt) or `compact`
# (an ae compact operation authorized it). One mechanism, several callers — recording the
# authority costs nothing and makes a refusal legible about which agreement it is holding
# the operation to.
declare -A _AE_END_FROZEN_AUTHORITY=()
# The exact target list the human was shown. `ae end all` used to enumerate again at
# action time, so a session that appeared AFTER the prompt could be ended without ever
# having been named to anyone.
declare -a _AE_END_CONFIRMED_TARGETS=()
# WHETHER a prompt ran — a separate fact, never inferred from the list's LENGTH. An
# interactive `ae end all` with nothing to end legitimately confirms an EMPTY list, and a
# count cannot tell "confirmed nothing" from "never confirmed": reading zero as "no
# confirmation" sent execution back to a fresh enumeration and ended a session that
# appeared while the prompt waited. AN EMPTY CONFIRMED SET MUST EXECUTE NOTHING.
_AE_END_TARGETS_CONFIRMED=false
# The rendered confirmation line for the target just frozen. REPLY-style, like _EV: the
# freeze path may not fork, because a fork cannot carry the array write back.
_AE_END_PLAN_LINE=""

doctor_extract_exec() {
    local raw="$1"
    local -a parts=()
    read -r -a parts <<<"$raw"
    local part
    for part in "${parts[@]}"; do
        case "$part" in
            env) continue ;;
            *=*) continue ;;
            *)
                printf '%s' "$part"
                return 0
                ;;
        esac
    done
    return 1
}

doctor_report() {
    local level="$1" label="$2" detail="$3"
    printf "%-5s %-14s %s\n" "$level" "$label" "$detail"
    case "$level" in
        FAIL) DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)) ;;
        WARN) DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
    esac
}

check_deps() {
    if [[ -z "${BASH_VERSINFO[0]:-}" ]] || ((BASH_VERSINFO[0] < 4)); then
        echo "Error: ae requires bash >= 4.0 (found ${BASH_VERSION:-unknown})." >&2
        echo "macOS: brew install bash" >&2
        return 1
    fi
    if ! command -v tmux >/dev/null 2>&1; then
        echo "Error: tmux not found in PATH. Install tmux or run 'ae doctor' for details." >&2
        return 1
    fi
}

sync_existing_session_assets() {
    local session_name="$1"
    local meta="${SESSIONS_DIR}/${session_name}/meta"
    if [[ ! -f "$meta" ]]; then
        meta="${WORKTREES_DIR}/${session_name}/.ae/${session_name}/meta"
    fi
    if [[ ! -f "$meta" ]]; then
        echo "session '${session_name}' not found" >&2
        return 1
    fi

    local meta_dir work_dir origin mode main_pane config_file
    meta_dir="$(dirname "$meta")"

    # LEGACY tmux_server MIGRATION (5th review B2): pre-fix metas recorded "" even when
    # the session lives on a foreign server — after upgrade, every exact-server consumer
    # would read that lie as "default". Repair ONLY on positive location: the target must
    # be live on the pinned default (→ record its socket path) or on exactly ONE
    # enumerable -L socket (→ record that path). Ambiguous (several) or absent (stopped)
    # records are left alone — the end path fails closed on them rather than guessing.
    local _mig_cur
    _mig_cur="$(grep '^tmux_server=' "$meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    if [[ -z "$_mig_cur" ]]; then
        local _mig_dir _mig_hits="" _mig_n=0 _mig_sock _mig_out
        _mig_dir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
        for _mig_sock in "$_mig_dir"/*; do
            [[ -S "$_mig_sock" ]] || continue
            _mig_out="$(command tmux -S "$_mig_sock" list-sessions -F '#{session_name}' 2>/dev/null || true)"
            if printf '%s\n' "$_mig_out" | grep -Fxq -- "$session_name"; then
                _mig_hits="$_mig_sock"
                _mig_n=$((_mig_n + 1))
            fi
        done
        if ((_mig_n == 1)); then
            if {
                flock -w 5 201 || exit 1
                awk -F= -v v="${_mig_hits}" '
                    $1 == "tmux_server" { print "tmux_server=" v; seen = 1; next }
                    $1 == "tmux_server_kind" { next }
                    { print }
                    END {
                        # Pre-tmux_server-era metas lack the key entirely — replace-only
                        # here wrote kind=socket with NO value line, a malformed record
                        # (-S "") this migration exists to prevent. Add, not just replace.
                        if (!seen) print "tmux_server=" v
                        print "tmux_server_kind=socket"
                    }
                ' "$meta" >"${meta}.tmp.$$" && mv "${meta}.tmp.$$" "$meta"
            } 201>"${meta_dir}/meta.lock"; then
                echo "  migrated tmux_server: '' → ${_mig_hits} (kind=socket, positively located)"
            else
                echo "  WARN: tmux_server migration SKIPPED — could not lock meta (another writer active); record unchanged" >&2
            fi
        elif ((_mig_n > 1)); then
            echo "  WARN: '${session_name}' is live on ${_mig_n} servers — tmux_server left legacy-empty (ambiguous); end will fail closed" >&2
        else
            # ZERO hits: NOT a positive location — recording any server here would be a
            # guess (7th review B3: an arbitrary -S target made the old default-claim
            # migrate-then-delete a live session). The record stays legacy-empty; a
            # genuinely stopped session is ended with the explicit per-target
            # acknowledgement: ae end --assume-stopped <name>.
            echo "  '${session_name}' not live on any enumerable server — record left as-is; if it is genuinely stopped: ae end --assume-stopped ${session_name}"
        fi
    fi
    work_dir="$(read_session_meta "$session_name" work_dir)"
    origin="$(read_session_meta "$session_name" origin)"
    mode="$(read_session_meta "$session_name" mode)"
    main_pane="$(read_session_meta "$session_name" main_pane)"
    config_file="$(read_session_meta "$session_name" config)"

    [[ -n "$work_dir" ]] || work_dir="$origin"
    [[ -n "$origin" ]] || origin="$work_dir"
    [[ -n "$mode" ]] || mode="local"

    # The meta pins a refresh recomputes: where this glue lives, its version, and
    # the session's core binding — published as a PAIR (path + the version that
    # binary reported), so a helper that later finds a different version refuses
    # it. One rule set for launch and refresh; see _ae_core_bind.
    set_session_meta_value "${meta_dir}/meta" "ae_path" "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    set_session_meta_value "${meta_dir}/meta" "ae_version" "$AE_VERSION"
    _ae_core_bind "$meta_dir"
    if [[ -n "$config_file" ]]; then
        set_session_meta_value "${meta_dir}/meta" "config" "$config_file"
    fi
    _refresh_session_shims "$meta_dir" || return 1
    # The manifest is a core render. In a SUBSHELL because the core shims EXIT
    # rather than return when no usable core is bound, and a refresh sweeping
    # several sessions must not die on the first one (fb601995's class); the
    # config overrides are scoped by the same subshell.
    (
        [[ -n "$config_file" ]] && CONFIG_FILE="$config_file"
        AE_LOCAL_CONFIG=""
        regenerate_manifest "$session_name" "$work_dir" "$origin" "$mode" "$main_pane" "$meta_dir"
    ) || return 1

    # Keep the status-left location in sync for an already-running session — refresh
    # only regenerates on-disk assets, but a watchdog restart drops session/mode/
    # location from status-right, so the left half must carry it. No-op if the
    # session isn't running. Targets the session's own tmux server (from meta).
    local server
    server="$(read_session_meta "$session_name" tmux_server)"
    server_kind="$(read_session_meta "$session_name" tmux_server_kind)"
    _ae_apply_status_bar "$session_name" "$mode" "$origin" "$work_dir" "$server" "$server_kind"

    # Cycle a RUNNING watchdog so refreshed helper code actually goes live. The
    # running watchdog keeps its already-loaded body until restarted (refresh only
    # rewrites the on-disk script), so a stop→start makes it re-source the fresh
    # helper. Invoke the SESSION's own generated helper by path. Non-fatal: a failed
    # restart must not fail the refresh, and every probe is guarded (set -e).
    #
    # Liveness gate (BLOCKER): 'watchdog status' trusts .watchdog.pid + kill -0,
    # which a STOPPED session's stale pidfile satisfies if that PID was recycled by
    # an unrelated live process — a stop would then kill that innocent process. So
    # require genuine liveness FIRST: the tmux session exists on its own server
    # (exact match via list-sessions|grep -Fxq, not has-session which prefix-matches)
    # AND a pane still carries @ae_agent=_watchdog. Only then trust the status text.
    local _wt=(tmux)
    if [[ "${server_kind:-}" == "ambiguous" ]]; then
        # Ambiguous record → display no-op, never the ambient server.
        return 0
    fi
    if [[ -n "$server" ]]; then
        local -a _sel_wt=()
        mapfile -t _sel_wt < <(_srv_tmux_args "${server_kind:-}" "$server")
        _wt=(command tmux "${_sel_wt[@]}")
    fi
    local sess_live="" wd_pane_live=""
    if "${_wt[@]}" list-sessions -F '#{session_name}' 2>/dev/null | grep -Fxq -- "$session_name"; then
        sess_live="yes"
    fi
    if [[ "$sess_live" == "yes" ]] &&
        "${_wt[@]}" list-panes -s -t "$session_name" -F '#{@ae_agent}' 2>/dev/null | grep -Fxq -- "_watchdog"; then
        wd_pane_live="yes"
    fi
    if [[ "$wd_pane_live" == "yes" ]]; then
        local wd_status
        wd_status="$(_watchdog_manage "$meta_dir" status 2>/dev/null || true)"
        if [[ "$wd_status" == *"is running"* ]]; then
            _watchdog_manage "$meta_dir" stop >/dev/null 2>&1 || true
            sleep 0.3 # brief settle so the pane is gone before the fresh start
            _watchdog_manage "$meta_dir" start >/dev/null 2>&1 || true
            # Verify it actually came back up before claiming success (IMPORTANT):
            # 'stop' flips meta watchdog=false, so a failed 'start' would leave the
            # watchdog persistently disabled. Poll, then either announce success or
            # re-record watchdog=true so the next resume revives it — never echo
            # success unconditionally.
            local wd_up="" _i=0
            while ((_i < 5)); do
                if [[ "$(_watchdog_manage "$meta_dir" status 2>/dev/null || true)" == *"is running"* ]]; then
                    wd_up="yes"
                    break
                fi
                sleep 0.5
                _i=$((_i + 1))
            done
            if [[ "$wd_up" == "yes" ]]; then
                echo "restarted watchdog for ${session_name}"
            else
                set_session_meta_value "${meta_dir}/meta" "watchdog" "true" || true
                echo "Warning: watchdog restart failed for ${session_name} — re-enable recorded; it will start on next resume"
            fi
        fi
    fi
}

# Try to capture a pending session ID from on-disk agent session files (no live pane needed).
# Uses the same find_*_session_by_* helpers as start_capture_session_id, but skips the
# pane-polling and TUI-scrape methods so it can run from doctor without an attached agent.
# Exit codes:
#   0 = won the race; captured ID printed to stdout
#   2 = found a session file but lost the race to another recoverer
#   1 = no matching session file found (real miss) or other error
doctor_try_capture_session_id() {
    local tool_kind="$1" slot="$2" meta_dir="$3"
    local captured="" launch_time launch_id work_dir
    work_dir="$(grep '^work_dir=' "$meta_dir/meta" 2>/dev/null | cut -d= -f2- || true)"
    launch_time="$(read_launch_time_for_slot "$meta_dir" "$slot")"
    launch_id="$(read_launch_id_for_slot "$meta_dir" "$slot")"
    case "$tool_kind" in
        codex)
            if [[ -n "$launch_id" ]]; then
                captured="$(find_codex_session_by_launch_id "$launch_id" "$launch_time" 2>/dev/null || true)"
            fi
            if [[ -z "$captured" && -n "$work_dir" ]]; then
                captured="$(find_codex_session_by_cwd "$work_dir" "$launch_time" 2>/dev/null || true)"
            fi
            ;;
        gemini)
            if [[ -n "$work_dir" && -n "$launch_id" ]]; then
                captured="$(find_gemini_session_by_launch_id "$work_dir" "$launch_id" "$launch_time" 2>/dev/null || true)"
            fi
            ;;
        opencode)
            if [[ -n "$launch_id" ]]; then
                captured="$(find_opencode_session_by_launch_id "$launch_id" "$launch_time" 2>/dev/null || true)"
            fi
            ;;
    esac
    [[ -n "$captured" ]] || return 1
    # Identity v2: the core writes the row (harness_session.<slot>) under meta.lock
    # itself, so NO bash lock is held around the call — it would deadlock the core's own
    # acquire. The check is a plain read; a re-capture racing it rewrites the same fact.
    local escaped_slot="${slot//./\\.}" current_id
    current_id="$(grep "^harness_session\.${escaped_slot}=" "$meta_dir/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
    if [[ "$current_id" != "pending" ]]; then
        rc=2
    elif META_DIR="$meta_dir" _identity_core session _roster set-harness-session "$slot" "$captured" >/dev/null; then
        rc=0
    else
        rc=1
    fi
    set -e
    case "$rc" in
        0)
            printf '%s' "$captured"
            return 0
            ;;
        2) return 2 ;;
        *) return 1 ;;
    esac
}

# Walk a session's meta and try to recover any pending agent session IDs.
# Iterate a session's meta and try to recover pending session IDs.
# Calls report_fn for each entry: report_fn <kind> <slot> <agent_label> <tool_kind> <captured_or_empty>
# kind is one of: ok | already | miss | skip
# Used by both doctor (with reporting) and the watchdog (with quiet/event-based output).
walk_pending_session_ids() {
    local session_name="$1" report_fn="$2"
    local meta_dir="${SESSIONS_DIR}/${session_name}"
    [[ -f "${meta_dir}/meta" ]] || return 0

    local key val slot stored_alias agent_label cmd tool_kind captured rc
    local _esc
    while IFS='=' read -r key val; do
        # Identity v2: walk the pending harness_session rows; the seat's name and
        # profile are its own rows, read by slot.
        [[ "$key" == harness_session.* ]] || continue
        [[ "$val" == "pending" ]] || continue
        slot="${key#harness_session.}"
        _esc="${slot//./\\.}"
        agent_label="$(grep "^seat\.${_esc}=" "${meta_dir}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
        stored_alias="$(grep "^profile\.${_esc}=" "${meta_dir}/meta" 2>/dev/null | head -1 | cut -d= -f2- || true)"
        cmd="$(get_config "profiles.${stored_alias}")"
        if [[ -z "$cmd" ]]; then
            "$report_fn" "skip" "$slot" "$agent_label" "" ""
            continue
        fi
        tool_kind="$(tool_kind_from_cmd "$cmd")"
        case "$tool_kind" in
            codex | gemini | opencode) ;;
            *)
                # claude shouldn't be pending; nothing else to recover
                continue
                ;;
        esac
        rc=0
        captured="$(doctor_try_capture_session_id "$tool_kind" "$slot" "$meta_dir")" || rc=$?
        case "$rc" in
            0)
                if [[ -n "$captured" ]]; then
                    "$report_fn" "ok" "$slot" "$agent_label" "$tool_kind" "$captured"
                else
                    "$report_fn" "miss" "$slot" "$agent_label" "$tool_kind" ""
                fi
                ;;
            2)
                "$report_fn" "already" "$slot" "$agent_label" "$tool_kind" ""
                ;;
            *)
                "$report_fn" "miss" "$slot" "$agent_label" "$tool_kind" ""
                ;;
        esac
    done <"${meta_dir}/meta"
}

# doctor reporter — emits doctor_report lines for each entry
_doctor_recover_report() {
    local kind="$1" slot="$2" agent_label="$3" tool_kind="$4" captured="$5"
    case "$kind" in
        ok)
            doctor_report "OK" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "captured ${tool_kind} session id ${captured:0:8}"
            ;;
        already)
            doctor_report "OK" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "already captured by another recoverer"
            ;;
        miss)
            doctor_report "WARN" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "no matching ${tool_kind} session file found (will retry on next launch)"
            ;;
        skip)
            doctor_report "WARN" "recover:${RECOVER_SESSION_NAME}:${agent_label}" "no command configured for this agent alias"
            ;;
    esac
}

doctor_recover_pending_sessions() {
    RECOVER_SESSION_NAME="$1"
    # Hydrate config + origin from session meta (same reason as cmd_recover_pending)
    local stored_config stored_origin
    stored_config="$(read_session_meta "$1" config)"
    stored_origin="$(read_session_meta "$1" origin)"
    local prev_config="$CONFIG_FILE" prev_local="${AE_LOCAL_CONFIG:-}"
    if [[ -n "$stored_config" && -f "$stored_config" ]]; then
        CONFIG_FILE="$stored_config"
    fi
    AE_LOCAL_CONFIG=""
    if [[ -n "$stored_origin" && -f "${stored_origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${stored_origin}/.ae/config"
    fi
    walk_pending_session_ids "$1" _doctor_recover_report
    CONFIG_FILE="$prev_config"
    AE_LOCAL_CONFIG="$prev_local"
}

# watchdog reporter — TSV output: <kind>\t<slot>\t<agent_label>\t<tool_kind>\t<captured>
# Called by the watchdog helper via 'ae _recover-pending <session>'.
_watchdog_recover_report() {
    local kind="$1" slot="$2" agent_label="$3" tool_kind="$4" captured="$5"
    printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$slot" "$agent_label" "$tool_kind" "$captured"
}

# Internal: recover pending session IDs for a session and emit TSV results.
# Used by the watchdog to keep meta up to date over time. Output format:
#   ok\t<slot>\t<agent_label>\t<tool_kind>\t<captured_id>     # we won the race
#   already\t<slot>\t<agent_label>\t<tool_kind>\t             # another recoverer claimed it
#   miss\t<slot>\t<agent_label>\t<tool_kind>\t                # no matching session file found
#   skip\t<slot>\t<agent_label>\t\t                            # alias not configured
# The watchdog ignores non-ok rows; doctor reports each kind distinctly.
cmd_recover_pending() {
    local session_name="${1:-}"
    if [[ -z "$session_name" ]]; then
        echo "Usage: ae _recover-pending <session-name>" >&2
        return 1
    fi
    # Hydrate config + origin from session meta so get_config resolves the
    # same agent aliases that created the session, regardless of caller CWD.
    local stored_config stored_origin
    stored_config="$(read_session_meta "$session_name" config)"
    stored_origin="$(read_session_meta "$session_name" origin)"
    if [[ -n "$stored_config" && -f "$stored_config" ]]; then
        CONFIG_FILE="$stored_config"
    fi
    AE_LOCAL_CONFIG=""
    if [[ -n "$stored_origin" && -f "${stored_origin}/.ae/config" ]]; then
        AE_LOCAL_CONFIG="${stored_origin}/.ae/config"
    fi
    walk_pending_session_ids "$session_name" _watchdog_recover_report
}

# A per-session refresh runs in a SUBSHELL, and that is load-bearing rather than
# tidy. The core shims are fail-closed: an unusable core makes
# `_ae_core_preflight_try` print one line and EXIT 2, which `if fn; then` does not
# catch — it ends the process. Since A.2c the workspace render is one of those
# shims, so an install whose configured core reports no version used to take the
# whole refresh down at the FIRST session, leaving every later one untouched and
# printing no verdict for any of them. `doctor --refresh` is the REPAIR path (it
# is what the core-pin WARN tells the operator to run), so it must survive the
# fault it exists to repair: in a subshell that exit is the subshell's, the
# session is reported FAIL with the shim's reason already on stderr, and the loop
# goes on. Same reading as _identity_core's command substitutions, made explicit.
doctor_refresh_sessions() {
    local target="${1:-all}"
    local refreshed=0

    if [[ "$target" == "all" ]]; then
        local meta session_name
        declare -A seen_sessions=()
        for meta in "${SESSIONS_DIR}"/*/meta; do
            [[ -f "$meta" ]] || continue
            session_name="$(basename "$(dirname "$meta")")"
            seen_sessions["$session_name"]=1
            if (sync_existing_session_assets "$session_name"); then
                doctor_report "OK" "refresh:${session_name}" "refreshed session helpers and workspace"
                doctor_recover_pending_sessions "$session_name"
            else
                doctor_report "FAIL" "refresh:${session_name}" "failed to refresh session assets"
            fi
            refreshed=1
        done
        for meta in "${WORKTREES_DIR}"/*/.ae/*/meta; do
            [[ -f "$meta" ]] || continue
            session_name="$(basename "$(dirname "$meta")")"
            [[ -n "${seen_sessions[$session_name]:-}" ]] && continue
            if (sync_existing_session_assets "$session_name"); then
                doctor_report "OK" "refresh:${session_name}" "refreshed session helpers and workspace"
                doctor_recover_pending_sessions "$session_name"
            else
                doctor_report "FAIL" "refresh:${session_name}" "failed to refresh session assets"
            fi
            refreshed=1
        done
        if ((refreshed == 0)); then
            doctor_report "WARN" "refresh" "no existing sessions found in ${SESSIONS_DIR}"
        fi
        return 0
    fi

    if (sync_existing_session_assets "$target"); then
        doctor_report "OK" "refresh:${target}" "refreshed session helpers and workspace"
        doctor_recover_pending_sessions "$target"
    else
        doctor_report "FAIL" "refresh:${target}" "failed to refresh session assets"
    fi
}

cmd_doctor() {
    local refresh_target=""
    case "${1:-}" in
        "") ;;
        --refresh)
            refresh_target="${2:-all}"
            if [[ $# -gt 2 ]]; then
                echo "Usage: ae doctor [--refresh [all|<session>]]" >&2
                return 1
            fi
            ;;
        *)
            echo "Usage: ae doctor [--refresh [all|<session>]]" >&2
            return 1
            ;;
    esac

    DOCTOR_FAILURES=0
    DOCTOR_WARNINGS=0

    echo "ae doctor"
    echo ""
    doctor_report "OK" "ae" "version ${AE_VERSION}"

    if [[ -n "${BASH_VERSINFO[0]:-}" ]] && ((BASH_VERSINFO[0] >= 4)); then
        doctor_report "OK" "bash" "version ${BASH_VERSION}"
    else
        doctor_report "FAIL" "bash" "bash >= 4.0 required"
    fi

    if command -v tmux >/dev/null 2>&1; then
        doctor_report "OK" "tmux" "$(tmux -V 2>/dev/null || command -v tmux)"
    else
        doctor_report "FAIL" "tmux" "tmux not found in PATH"
    fi

    if command -v git >/dev/null 2>&1; then
        doctor_report "OK" "git" "$(git --version 2>/dev/null || command -v git)"
    else
        doctor_report "FAIL" "git" "git not found in PATH"
    fi

    # flock is OPTIONAL (util-linux; absent on stock macOS): lifecycle locking
    # degrades gracefully without it, so WARN — never FAIL (the bash+tmux+git
    # hard-dependency contract stands).
    if command -v flock >/dev/null 2>&1; then
        doctor_report "OK" "flock" "$(command -v flock)"
    else
        doctor_report "WARN" "flock" "not found — lifecycle locking degraded AND session helpers (send/ask/state/goal) lock unguarded"
    fi

    # Userland flavour. ae routes every divergent coreutil through a shim
    # (_ae_tac/_ae_stat/_ae_sed_inplace), so BSD is fully supported —
    # this row just makes the active path visible when something looks off.
    if command -v tac >/dev/null 2>&1; then
        doctor_report "OK" "userland" "GNU coreutils"
    elif tail -r /dev/null >/dev/null 2>&1; then
        doctor_report "OK" "userland" "BSD/macOS (portability shims active)"
    else
        doctor_report "FAIL" "userland" "neither 'tac' nor 'tail -r' works — cannot read event logs newest-first"
    fi

    # timeout is OPTIONAL (coreutils; absent on stock macOS). Without it the
    # watchdog's git probes run unbounded — a wedged git stalls a status refresh.
    if command -v timeout >/dev/null 2>&1; then
        doctor_report "OK" "timeout" "$(command -v timeout)"
    else
        doctor_report "WARN" "timeout" "not found — watchdog git probes run unbounded (brew install coreutils)"
    fi

    if [[ -f "$CONFIG_FILE" ]]; then
        doctor_report "OK" "config" "$CONFIG_FILE"
    else
        doctor_report "FAIL" "config" "missing ${CONFIG_FILE}"
    fi

    case ":$PATH:" in
        *":${HOME}/.local/bin:"*) doctor_report "OK" "PATH" "${HOME}/.local/bin" ;;
        *) doctor_report "WARN" "PATH" "${HOME}/.local/bin not found on PATH" ;;
    esac

    if [[ -n "${AE_LOCAL_CONFIG:-}" ]]; then
        doctor_report "OK" "local-config" "$AE_LOCAL_CONFIG"
    else
        doctor_report "WARN" "local-config" "no project override (.ae/config) in $(pwd)"
    fi

    mkdir -p "$SESSIONS_DIR" "$WORKTREES_DIR"
    doctor_report "OK" "sessions" "$SESSIONS_DIR"
    doctor_report "OK" "worktrees" "$WORKTREES_DIR"

    # Orphan check: session dirs / worktrees with no matching RUNNING session. These
    # accumulate when a wind-down DECLARES done but never runs `ae end` — the dir +
    # worktree are left behind, and every --running-scoped sensor (ae list default, the
    # orchestrator's charter) is structurally blind to them (the AIASSIST-115 class:
    # half-dead for days, 17 worktrees vs 6 running). doctor is the one lane that reads
    # on-disk state, so it surfaces the count + names and the human resumes (`ae <name>`)
    # or finishes the teardown (`ae end <name>`). WARN, not FAIL: a deliberately stopped
    # session is legitimately here too, and doctor cannot read intent.
    local _orphan_n=0 _orphan_list="" _oname _osrv
    while IFS= read -r _oname; do
        [[ -z "$_oname" ]] && continue
        # iter_stopped_sessions checks the AMBIENT tmux server. A session created on a
        # NAMED server (tmux_server in its meta) is live but invisible there, so it would
        # be a false orphan. Re-check the candidate against its OWN server (exact match)
        # before counting it. (I1)
        # Symmetric liveness re-check on the candidate's OWN server via the shared
        # resolver: a NAMED server for a named candidate, the pinned DEFAULT socket for
        # an empty one. The old named-only check false-orphaned default-server sessions
        # when doctor ran from a named-ambient shell (3rd review, I1).
        if _end_tmux "$_oname" has-session -t "=${_oname}" 2>/dev/null; then
            continue
        fi
        _orphan_n=$((_orphan_n + 1))
        _orphan_list="${_orphan_list}${_orphan_list:+, }${_oname}"
    done < <(iter_stopped_sessions)
    if ((_orphan_n == 0)); then
        doctor_report "OK" "orphans" "no stopped or orphaned session dirs"
    else
        doctor_report "WARN" "orphans" "${_orphan_n} session dir(s)/worktree(s) with no running session: ${_orphan_list}"
        doctor_report "WARN" "orphans-hint" "resume with 'ae <name>' or finish teardown with 'ae end <name>'"
    fi

    # Core pins, per session. Since the core became REQUIRED there is no bash body
    # behind a blank or unbindable pin — every core-owned command on that session
    # (end, archive, compact, and every helper) refuses with exit 2. The pin is
    # published at launch and at `doctor --refresh`, so a session can sit there
    # unusable with nothing else saying so: name it here. WARN, not FAIL, because
    # `doctor --refresh` repairs it and the rest of the install is fine.
    local _cp_bad="" _cpname _cpdir _cpbin _cpver
    while IFS= read -r _cpname; do
        [[ -z "$_cpname" ]] && continue
        _cpdir="$(_resolve_session_dir "$_cpname")"
        [[ -n "$_cpdir" && -f "${_cpdir}/meta" ]] || continue
        _cpbin="$(grep '^ae_core=' "${_cpdir}/meta" 2>/dev/null | cut -d= -f2- || true)"
        _cpver="$(grep '^ae_core_version=' "${_cpdir}/meta" 2>/dev/null | cut -d= -f2- || true)"
        if [[ -z "$_cpbin" || -z "$_cpver" || ! -x "$_cpbin" ]]; then
            _cp_bad="${_cp_bad}${_cp_bad:+, }${_cpname}"
        fi
    done < <(list_ae_sessions)
    if [[ -n "$_cp_bad" ]]; then
        doctor_report "WARN" "core-pin" "session ${_cp_bad} has no core bound; end/archive will refuse"
        doctor_report "WARN" "core-pin-hint" "repair with 'ae doctor --refresh'"
    fi

    local workspace_main
    workspace_main="$(get_config workspace.main)"
    if [[ -n "$workspace_main" ]]; then
        doctor_report "OK" "workspace.main" "$workspace_main"
    else
        doctor_report "FAIL" "workspace.main" "not set in config"
    fi

    local workers
    workers="$(get_config workspace.workers)"
    if [[ -n "$workers" ]]; then
        doctor_report "OK" "workspace.workers" "$workers"
    else
        doctor_report "WARN" "workspace.workers" "no startup workers configured"
    fi

    declare -A doctor_agents=()
    local entry key value
    while IFS= read -r entry; do
        # Identity v2: the launch recipes live in [profiles].
        [[ "$entry" == profiles.*=* ]] || continue
        key="${entry#profiles.}"
        key="${key%%=*}"
        value="${entry#*=}"
        doctor_agents["$key"]="$value"
    done < <(parse_config)

    if [[ ${#doctor_agents[@]} -eq 0 ]]; then
        doctor_report "FAIL" "profiles" "no [profiles] entries found"
    else
        local alias
        while IFS= read -r alias; do
            value="${doctor_agents[$alias]}"
            local exec_name
            exec_name="$(doctor_extract_exec "$value" || true)"
            if [[ -z "$exec_name" ]]; then
                doctor_report "FAIL" "agent:${alias}" "could not determine executable from '${value}'"
                continue
            fi
            if command -v "$exec_name" >/dev/null 2>&1; then
                doctor_report "OK" "agent:${alias}" "$exec_name"
            else
                doctor_report "FAIL" "agent:${alias}" "command '${exec_name}' not found"
            fi
        done < <(printf '%s\n' "${!doctor_agents[@]}" | sort)
    fi

    # Telegram bridge — feature-aware. Reports OK/WARN only; FAILs are
    # surfaced when the user actually runs `ae telegram start`. If the user
    # never configured the feature, we skip silently.
    local _tg_enabled _tg_token _tg_chat _tg_present
    _tg_enabled="$(get_config telegram.enabled 2>/dev/null || true)"
    _tg_token="$(get_config telegram.token_file 2>/dev/null || true)"
    _tg_chat="$(get_config telegram.chat_id 2>/dev/null || true)"
    _tg_present="false"
    if [[ -n "$_tg_enabled$_tg_token$_tg_chat" ]]; then
        _tg_present="true"
    fi
    if [[ "$_tg_present" == "true" ]]; then
        # The bridge is the ae core binary, so the ONE dependency to report is a
        # usable core — resolved the machine-general way the spawn uses, not a
        # session's meta pin.
        local _tg_core=""
        if _tg_core="$(_ae_core_bin_input)" &&
            [[ "$_tg_core" == /* && -x "$_tg_core" ]] &&
            _ae_core_bin_version "$_tg_core" >/dev/null 2>&1; then
            doctor_report "OK" "telegram.core" "$_tg_core"
        else
            doctor_report "WARN" "telegram.core" "no usable ae core (set workspace.core or AE_CORE_BIN)"
        fi
        if [[ -n "$_tg_token" ]]; then
            local _tg_err
            if _tg_err="$(_telegram_validate_token_file "$_tg_token" 2>&1)"; then
                doctor_report "OK" "telegram.token" "$(_telegram_expand_path "$_tg_token")"
            else
                doctor_report "WARN" "telegram.token" "$_tg_err"
            fi
        else
            doctor_report "WARN" "telegram.token" "telegram.token_file not set"
        fi
        if [[ -n "$_tg_chat" ]]; then
            doctor_report "OK" "telegram.chat_id" "$_tg_chat"
        else
            doctor_report "WARN" "telegram.chat_id" "telegram.chat_id not set"
        fi
        if [[ "$(_telegram_intent_enabled)" == "true" ]]; then
            if _telegram_daemon_running; then
                doctor_report "OK" "telegram.daemon" "running"
            else
                doctor_report "WARN" "telegram.daemon" "enabled but not running (will autostart on 'ae <name>')"
            fi
        else
            doctor_report "OK" "telegram.intent" "enabled=false (feature off)"
        fi
        if _telegram_load_last_autostart_refusal; then
            doctor_report "WARN" "telegram.autostart" "last refusal=${_TELEGRAM_LAST_REFUSAL_CATEGORY} at ${_TELEGRAM_LAST_REFUSAL_TS}"
        fi
    fi

    if [[ -n "$refresh_target" ]]; then
        echo ""
        doctor_refresh_sessions "$refresh_target"
    fi

    echo ""
    printf "Summary: %d failure(s), %d warning(s)\n" "$DOCTOR_FAILURES" "$DOCTOR_WARNINGS"
    ((DOCTOR_FAILURES == 0))
}

cmd_watchdog() {
    local subcmd="${1:-}"
    local target="${2:-}"
    if [[ -z "$subcmd" ]]; then
        echo "Usage: ae watchdog <start|stop|status> [session-name]" >&2
        echo "  (If run inside an ae session, session-name is optional.)" >&2
        return 1
    fi
    case "$subcmd" in
        start | stop | status) ;;
        *)
            echo "Usage: ae watchdog <start|stop|status> [session-name]" >&2
            return 1
            ;;
    esac
    if [[ -z "$target" ]]; then
        target="$(detect_current_session 2>/dev/null)" || {
            echo "Error: no session name given and not inside an ae tmux session" >&2
            return 1
        }
    fi
    local meta_dir="${SESSIONS_DIR}/${target}"
    if [[ ! -d "$meta_dir" ]]; then
        echo "Error: session '${target}' not found" >&2
        return 1
    fi
    # NOT through the session's `watchdog` helper: that file is the core's daemon
    # shim now and takes no subcommand. The management is this script's, and it
    # needs only the session directory.
    _watchdog_manage "$meta_dir" "$subcmd"
}

# ── Telegram bridge (machine-global chat daemon) ─────────────────────
#
# Forwards filtered events from every ae session on this machine to a
# Telegram chat, and routes replies back. The bridge itself is the RUST
# CORE (`ae _telegram-run`), run in a background tmux session named
# `ae-telegram`; what is left here is the start/stop/status glue and the
# config surface. The ONE dependency is a usable ae core. The retired bash
# bridge needed two optional CLIs and gated on them; the core needs none, so
# this feature ships no optional dependency and no dep gate — the core
# resolution in _telegram_spawn_daemon is the only thing that can refuse.
#
# The daemon owns its own state under ~/.ae/telegram/ (offset, sticky
# target) and reads its secrets from [telegram] in the config file ae
# hands it — never from argv, and never from the environment.

_TELEGRAM_TMUX_SESSION="ae-telegram"
# Serializes start / stop / autostart(supervise) so an "is it enabled + running?"
# check and the spawn/kill that follows are one atomic critical section. Without
# it, a watchdog supervise tick can re-spawn a daemon the user just `stop`ped.
_TELEGRAM_CONTROL_LOCK="${CONFIG_DIR}/telegram/control.lock"
_telegram_control_lock_file() {
    mkdir -p "${CONFIG_DIR}/telegram" 2>/dev/null || true
    printf '%s' "$_TELEGRAM_CONTROL_LOCK"
}

# The only refusal categories that may cross the autostart observability boundary.
# Keep this closed: status/doctor and the durable record must never expose the
# coexistence guard's free-text diagnostics or anything derived from a token.
_telegram_autostart_refusal_category() {
    case "${1:-}" in
        aewatch-live | same-token-live | token-unreadable | probe-failed | spawn-failed)
            printf '%s' "$1"
            ;;
        *)
            printf '%s' "spawn-failed"
            ;;
    esac
}

# Read the last autostart refusal, if its whole line matches the closed record
# grammar. A malformed or hand-edited record is ignored rather than echoed: the
# reader must not turn an arbitrary value in this file into a status/doctor sink.
# Results are globals because callers run this directly under errexit and the
# category/timestamp are facts, not a display string to split again.
_telegram_load_last_autostart_refusal() {
    _TELEGRAM_LAST_REFUSAL_CATEGORY=""
    _TELEGRAM_LAST_REFUSAL_TS=""
    local file="${CONFIG_DIR}/telegram/autostart-refusal" raw tab pattern
    [[ -f "$file" && -r "$file" ]] || return 1
    raw="$(<"$file")" || return 1
    # The atomic writer emits one newline-terminated record. Command substitution
    # removes that final newline; any remaining newline means more than one row.
    [[ "$raw" != *$'\n'* ]] || return 1
    tab=$'\t'
    pattern="^(aewatch-live|same-token-live|token-unreadable|probe-failed|spawn-failed)${tab}([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$"
    [[ "$raw" =~ $pattern ]] || return 1
    _TELEGRAM_LAST_REFUSAL_CATEGORY="${BASH_REMATCH[1]}"
    _TELEGRAM_LAST_REFUSAL_TS="${BASH_REMATCH[2]}"
    return 0
}

# Persist one refusal category and mirror it into the current session's event
# ledger when a session context is available. The global record is deliberately
# LAST-only and survives a later successful start; it is published temp+mv in the
# same directory so status/doctor can never observe a torn row.
_telegram_record_autostart_refusal() {
    local category session now dir file tmp safe_session event_meta
    category="$(_telegram_autostart_refusal_category "${1:-spawn-failed}")"
    session="${2:-${AE_TELEGRAM_AUTOSTART_SESSION:-${SESSION:-}}}"
    now="$(date -u +%FT%TZ)"
    dir="${CONFIG_DIR}/telegram"
    file="${dir}/autostart-refusal"
    if mkdir -p "$dir" 2>/dev/null; then
        tmp="${file}.tmp.$$"
        if ! printf '%s\t%s\n' "$category" "$now" >"$tmp"; then
            rm -f "$tmp" 2>/dev/null || true
        elif ! mv "$tmp" "$file" 2>/dev/null; then
            rm -f "$tmp" 2>/dev/null || true
        fi
    fi

    # Session names are optional in the observability record and are never needed
    # to identify the refusal. Validate before using one as an event target or a
    # path component; legacy metadata must not become a new interpolation sink.
    safe_session=""
    if [[ "$session" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]]; then
        safe_session="$session"
    fi
    event_meta=""
    if [[ -n "$safe_session" && -n "${SESSIONS_DIR:-}" ]]; then
        event_meta="${SESSIONS_DIR}/${safe_session}"
    fi
    if [[ -n "$event_meta" && -d "$event_meta" ]]; then
        # ae_emit_event owns JSON escaping and locking. Run it in a subshell so
        # this best-effort observability path cannot leak a temporary meta-dir
        # override into the caller. Bind every envelope facet here: this event is
        # an ae fact, not an ambient caller/routing/body record, and never let an
        # event failure block launch.
        (
            _AE_META_DIR="$event_meta"
            _AE_SESSION="$safe_session"
            AE_SENDER_OVERRIDE=ae
            unset _AE_EVENT_ACTOR_SLOT _AE_EVENT_ACTOR_SESSION _AE_EVENT_TARGET_SLOT _AE_EVENT_TARGET_SESSION _AE_LAST_BODY_FILE
            ae_emit_event "telegram_autostart_refused" "$safe_session" "" "category=$category"
        ) || true
    fi
    return 0
}

# Resolve a possibly-tilde-prefixed path against $HOME. Patterns are
# literal-tilde matches, not shell tilde-expansion (which would happen
# at quote-time and miss config-file values like "~/.config/...").
# shellcheck disable=SC2088
_telegram_expand_path() {
    local p="$1"
    case "$p" in
        '~') printf '%s' "$HOME" ;;
        '~/'*) printf '%s/%s' "$HOME" "${p#"~/"}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# True if a value looks like a config-affirmative.
_telegram_truthy() {
    case "${1,,}" in
        1 | true | yes | on) return 0 ;;
        *) return 1 ;;
    esac
}

# Print the configured intent: "true" if [telegram] enabled is truthy.
_telegram_intent_enabled() {
    local v
    v="$(get_config telegram.enabled 2>/dev/null || true)"
    if _telegram_truthy "$v"; then echo "true"; else echo "false"; fi
}

# Same as above but bypasses the get_config CACHE: get_config caches per
# XDG_RUNTIME_DIR, so a watchdog process with a different runtime dir could hold a
# stale enabled=true even after `stop` wrote false. Reuses parse_config so the
# value semantics (inline-comment stripping, quotes, local-override last-wins)
# match get_config exactly — just without the cache. Authoritative for the
# under-lock re-check.
_telegram_intent_enabled_uncached() {
    local entry result=""
    while IFS= read -r entry; do
        [[ "$entry" == "telegram.enabled="* ]] && result="${entry#*=}"
    done < <(parse_config)
    if _telegram_truthy "$result"; then echo "true"; else echo "false"; fi
}

# Idempotent check for daemon presence — uses exact tmux session match
# (list-sessions + grep -Fxq), not has-session which prefix-matches.
_telegram_daemon_running() {
    tmux list-sessions -F '#{session_name}' 2>/dev/null |
        grep -Fxq -- "$_TELEGRAM_TMUX_SESSION"
}

# Check feature deps. Echoes missing names space-separated. Empty == OK.
# Validate token file (path, exists, readable, mode 600, owned by user).
# Echoes error message on failure, returns non-zero. Echoes nothing on success.
_telegram_validate_token_file() {
    local path="$1"
    [[ -n "$path" ]] || {
        echo "no telegram.token_file in config"
        return 1
    }
    local resolved
    resolved="$(_telegram_expand_path "$path")"
    [[ -f "$resolved" ]] || {
        echo "token file not found: $resolved"
        return 1
    }
    [[ -r "$resolved" ]] || {
        echo "token file not readable: $resolved"
        return 1
    }
    local owner mode
    owner="$(_ae_stat uid "$resolved" || echo -1)"
    [[ "$owner" == "${UID:-$(id -u)}" ]] || {
        echo "token file not owned by you: $resolved"
        return 1
    }
    mode="$(_ae_stat mode "$resolved" || echo 000)"
    case "$mode" in
        400 | 600) ;;
        *)
            echo "token file must be chmod 600 (currently $mode): $resolved"
            return 1
            ;;
    esac
    return 0
}

# Persist the enabled flag in ~/.ae/config without disturbing other content.
# Adds the [telegram] section if it doesn't yet exist.
#
# A single section-scoped awk pass handles every case: replace `enabled`
# INSIDE [telegram], or insert it just before the next section / at EOF if
# the section exists without it. We must NOT decide replace-vs-insert from a
# global `grep enabled` — another section's `enabled =` would mislead that
# check and leave [telegram] untouched (codex-flagged).
_telegram_persist_intent() {
    local value="$1"
    local cfg="$CONFIG_FILE"
    local tmp="$cfg.tmp.$$"
    if [[ ! -f "$cfg" ]]; then
        printf '[telegram]\nenabled = %s\n' "$value" >"$cfg"
    elif ! grep -q '^\[telegram\]' "$cfg"; then
        printf '\n[telegram]\nenabled = %s\n' "$value" >>"$cfg"
    else
        awk -v val="$value" '
            BEGIN { in_tg = 0; done = 0 }
            /^\[telegram\][[:space:]]*$/ { in_tg = 1; print; next }
            /^\[/ {
                if (in_tg && !done) { print "enabled = " val; done = 1 }
                in_tg = 0; print; next
            }
            in_tg && !done && /^[[:space:]]*enabled[[:space:]]*=/ {
                print "enabled = " val; done = 1; next
            }
            { print }
            END { if (in_tg && !done) print "enabled = " val }
        ' "$cfg" >"$tmp" && mv "$tmp" "$cfg"
    fi
    # (No cache to bust: get_config parses fresh on every call — the disk cache was
    # removed after proving both stale-mtime and cross-process wrong-owner races.)
}

# Spawn the Rust core's telegram bridge in its dedicated tmux session. Caller
# must have checked deps and validated config — this just orchestrates tmux.
# The daemon inherits the EXACT config file ae validated (CONFIG_FILE) via
# --config rather than its own <ae-home>/config default: a CONFIG_FILE override
# (tests, or a non-default config) would otherwise validate one file and leave
# the daemon reading another. Secrets never ride argv — the core reads
# token_file / chat_id / allowed_user_ids out of [telegram] in --config itself.
#
# The command is passed to tmux as DIRECT ARGV, not as one shell string. A
# single-string shell-command is run through /bin/sh (dash on Linux), so it
# needs quoting we cannot do portably: printf %q emits bash-only $'...' for a
# path containing a newline or a nonprintable, and dash would then hand the
# daemon different argv than ae resolved. The multi-argument form tmux execs
# directly — no shell, no quoting boundary — so a path with a space, a quote
# or a newline survives byte-for-byte. The core path is absolute (checked
# above), which also keeps it out of option-parsing ambiguity.
# ── COEXISTENCE (pre-P5): delete at the entry flip ───────────────────────────
# WHY THIS EXISTS. The bridge's "already running" check sees only its OWN tmux
# server, so a named-server instance (ae-next) and the default-server instance
# (the installed ae) are invisible to each other — and two bridges long-polling
# ONE bot token is the failure that costs updates, not just tidiness: Telegram
# hands an update to whichever getUpdates arrives first and the other never sees
# it. Structural isolation cannot solve this one, because the token is outside
# both state trees.
#
# THIS BLOCK GOES AWAY AT THE ENTRY FLIP, when there is one ae again. It is
# deliberately conservative: it never stops the default-server instance from
# starting (a plain `ae` has AE_TMUX_SERVER unset and is not gated at all), only
# a second, named-server one.

# The bot token behind a config file, or nothing. NEVER printed anywhere: it is a
# credential, and this function exists to compare two of them, not to show them.
_telegram_coexistence_token() {
    local cfg="$1" file token
    [[ -f "$cfg" ]] || return 1
    # A SCOPED read: parse_config reads the ambient CONFIG_FILE/AE_LOCAL_CONFIG
    # globals, so they are supplied as a COMMAND PREFIX inside the subshell
    # $( ) already provides — this shell's own values are never touched.
    file="$(CONFIG_FILE="$cfg" AE_LOCAL_CONFIG="" get_config telegram.token_file 2>/dev/null || true)"
    [[ -n "$file" ]] || return 1
    file="$(_telegram_expand_path "$file")"
    [[ -f "$file" && -r "$file" ]] || return 1
    token="$(head -1 "$file" 2>/dev/null || true)"
    token="${token#"${token%%[![:space:]]*}"}"
    token="${token%"${token##*[![:space:]]}"}"
    [[ -n "$token" ]] || return 1
    printf '%s\n' "$token"
    return 0
}

# The default server's session names, or a verdict about why there are none.
#   stdout : the session names, one per line          (rc 0)
#   rc 1   : there is provably no server there        (the stale-socket shape)
#   rc 2   : cannot tell                              (anything else)
#
# THE PROBE SELECTS THE DEFAULT SERVER EXPLICITLY, and both variables that could
# redirect it are cleared:
#   TMUX         a probe run from inside a pane would otherwise inherit that
#                pane's server — and this instance's panes are exactly where the
#                guard runs from;
#   TMUX_TMPDIR  the socket DIRECTORY `-L default` resolves inside; leaving it
#                set is the same bypass in another variable.
# `-L` outranks $TMUX (measured), but only for the socket NAME; the directory is
# TMUX_TMPDIR's, so both are needed for "the default server" to mean the one word
# it says. There is deliberately NO environment knob pointing this elsewhere: an
# env-selectable default server is a production bypass of the guard. Tests
# isolate it through PATH instead.
_telegram_coexistence_probe() {
    local out="" rc=0 _try
    for _try in 1 2; do
        rc=0
        out="$(env -u TMUX -u TMUX_TMPDIR tmux -L default list-sessions -F '#{session_name}' 2>&1)" || rc=$?
        ((rc == 0)) && break
        # Tri-state, as #28: only the stale-socket shape proves there is no
        # server. Anything else is "cannot tell", and cannot tell is not absent.
        if _tmux_err_is_clean_dead "$out"; then
            return 1
        fi
    done
    ((rc == 0)) || return 2
    printf '%s\n' "$out"
    return 0
}

# Do the two instances share a bot?
#   0 = same bot, or one of the tokens cannot be read (fail CLOSED)
#   1 = provably different bots, so both may run
_telegram_coexistence_same_bot() {
    local mine theirs
    _TELEGRAM_COEXISTENCE_TOKEN_UNREADABLE=0
    if ! mine="$(_telegram_coexistence_token "$CONFIG_FILE")"; then
        mine=""
        _TELEGRAM_COEXISTENCE_TOKEN_UNREADABLE=1
    fi
    if ! theirs="$(_telegram_coexistence_token "$HOME/.ae/config")"; then
        theirs=""
        _TELEGRAM_COEXISTENCE_TOKEN_UNREADABLE=1
    fi
    if [[ -n "$mine" && -n "$theirs" && "$mine" != "$theirs" ]]; then
        return 1
    fi
    return 0
}

# 0 = go ahead, 1 = refuse (with the reason on stderr).
#
# Called TWICE around the spawn — see the call sites. It is one function rather
# than a pre-check and a separate re-check because the question is identical both
# times, and two copies of a tri-state probe is two places for the tri-state to
# be got wrong.
_telegram_coexistence_guard() {
    _TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY=""
    _TELEGRAM_COEXISTENCE_TOKEN_UNREADABLE=0
    # Only a named-server instance can be the SECOND bridge. The installed ae has
    # no AE_TMUX_SERVER and is never gated by its own coexistence guard.
    [[ -n "${AE_TMUX_SERVER:-}" ]] || return 0

    local names rc=0 line found_bridge=0 found_aewatch=0
    names="$(_telegram_coexistence_probe)" || rc=$?
    if ((rc == 1)); then
        return 0
    fi
    if ((rc != 0)); then
        _TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY="probe-failed"
        echo "ae telegram: cannot tell whether another ae instance's bridge is live on the default tmux server" >&2
        echo "ae telegram: refusing to start a second bridge on the same bot token: run 'ae telegram stop', or give ae-next a distinct bot token" >&2
        return 1
    fi
    while IFS= read -r line; do
        if [[ "$line" == "$_TELEGRAM_TMUX_SESSION" ]]; then found_bridge=1; fi
        if [[ "$line" == "ae-aewatch" ]]; then found_aewatch=1; fi
    done <<<"$names"

    # AEWATCH FIRST, and REFUSE rather than kill. A live aewatch claims the
    # bridge-owner marker and kills competing bridges on EVERY tmux server, so it
    # would take ours down seconds after we start it — but it belongs to the
    # other instance, and killing another instance's process is not this
    # command's to do. (The named-server retirement below is different: that
    # sidecar is on OUR server.) Ordered before the token comparison because it
    # holds whoever's bot is configured.
    if ((found_aewatch == 1)); then
        _TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY="aewatch-live"
        echo "ae telegram: a retired aewatch sidecar is live on the default tmux server, and it kills competing bridges on every server. Stop it first: tmux kill-session -t ae-aewatch on the default server (or ae watchdog stop)" >&2
        return 1
    fi
    ((found_bridge == 1)) || return 0
    # A bridge IS live over there. Two different bots are two different
    # conversations and may both run; the same bot may not.
    if ! _telegram_coexistence_same_bot; then
        return 0
    fi
    if ((_TELEGRAM_COEXISTENCE_TOKEN_UNREADABLE == 1)); then
        _TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY="token-unreadable"
    else
        _TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY="same-token-live"
    fi
    echo "ae telegram: another ae instance's Telegram bridge is live on the default tmux server with the same bot token: run 'ae telegram stop', or give ae-next a distinct bot token" >&2
    return 1
}

_telegram_spawn_daemon() {
    _TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY=""
    # Every failure below RETURNS, and the function ends with an explicit 0.
    # Previously the write was unchecked, new-session's rc was discarded, and a
    # trailing `|| true` on a cosmetic tmux call forced rc 0 — so the caller's
    # "autostart failed (continuing without bridge)" warning could never fire
    # and a bridge that never started looked like one that had.
    #
    # The bridge is machine-global (one per host, not one per session), so the
    # core is resolved the machine-general way — the same operator-input +
    # absolute + executable + reports-a-version test _ae_core_preflight_try
    # applies — never from a session's meta pin. The bash bridge is retired, so
    # there is no fallback body to degrade to: an unusable core is a hard
    # refusal here, and the caller decides how loud that is (explicit start
    # errors, autostart warns and continues).
    local _core
    _core="$(_ae_core_bin_input)" || {
        echo "ae telegram: no ae core configured (set workspace.core or AE_CORE_BIN)" >&2
        return 1
    }
    [[ "$_core" == /* && -x "$_core" ]] || {
        echo "ae telegram: ae core not an executable absolute path: $_core" >&2
        return 1
    }
    _ae_core_bin_version "$_core" >/dev/null 2>&1 || {
        echo "ae telegram: ae core reports no version: $_core" >&2
        return 1
    }
    # COEXISTENCE (pre-P5): delete at the entry flip. Placed BEFORE the aewatch
    # retirement below because the guard is a pure probe and the retirement is a
    # KILL: refusing after it would leave the machine with no bridge at all.
    if ! _telegram_coexistence_guard; then
        return 1
    fi
    # Retire a stale aewatch sidecar first (RR P4). A RUNNING aewatch holds the old
    # bytes whatever this file now says: it claims the bridge-owner marker and kills
    # competing bridges on every tmux server, so it would kill the core we are about
    # to start. Placed AFTER the core checks deliberately — an unusable core returns
    # above, and retiring the sidecar there would leave the machine with no bridge at
    # all. The probe is TRI-STATE and only rc 0 (verified running) fires the kill: an
    # UNKNOWN answer (rc 2, tmux could not say) must never authorise a destructive
    # guess (#28). The kill itself is best-effort and never fatal.
    if daemon_session_running ae-aewatch 2>/dev/null; then
        echo "ae telegram: retiring stale aewatch sidecar (superseded by the Rust bridge)" >&2
        tmux kill-session -t ae-aewatch 2>/dev/null || true
    fi
    # <ae-home> is CONFIG_DIR, not $HOME/.ae: an isolated (AE_HOME=...) run must
    # spawn a daemon reading THAT tree, never the live ~/.ae. --home is the real
    # $HOME, and is used only to expand a ~/ token_file path.
    if ! tmux new-session -d -s "$_TELEGRAM_TMUX_SESSION" -c "$HOME" \
        "$_core" _telegram-run "$CONFIG_DIR" --config "$CONFIG_FILE" --home "$HOME" 2>/dev/null; then
        return 1
    fi
    # COEXISTENCE (pre-P5): delete at the entry flip. CHECK -> SPAWN -> RE-CHECK,
    # with SELF-RETREAT.
    #
    # WHY A SECOND LOOK. The pre-check answers about a moment that has already
    # passed by the time the session exists, and the other instance is the plain
    # `ae` — FROZEN on main, which means it will never learn to honour a claim,
    # a lock or a marker this side invents. There is no protocol to agree on, so
    # the only move available is to look again and, if the other bridge came up
    # in the window, take OUR OWN down. Never theirs: killing another instance's
    # process is not this command's to do, and it is the instance the operator
    # did not ask to disturb.
    #
    # THE RESIDUAL, stated rather than papered over: between the spawn above and
    # the probe below, both bridges can be polling the same bot for a few
    # seconds, and each update in that window goes to whichever getUpdates
    # arrived first. The window is BOUNDED by this re-check, not closed by it.
    # That is accepted: the alternative is a claim protocol only one side can
    # implement.
    if ! _telegram_coexistence_guard; then
        # Through the shim — our server, our session.
        tmux kill-session -t "$_TELEGRAM_TMUX_SESSION" 2>/dev/null || true
        return 1
    fi
    # Cosmetic only — these may fail without the bridge being any less started.
    tmux set-option -t "$_TELEGRAM_TMUX_SESSION" status off 2>/dev/null || true
    tmux rename-window -t "$_TELEGRAM_TMUX_SESSION" "ae-telegram" 2>/dev/null || true
    return 0
}

# Best-effort idempotent autostart — called from the `ae <name>` start path.
# Strictly non-fatal: any error path is a one-line stderr warn, returns 0.
# Caller's session start path MUST NOT be affected by anything here.
# Companion: ensure the orchestrator comes up with the fleet. Opt-in purely by
# existing state — a scaffold from 'ae orchestrator --init' (canonical or legacy
# hub layout); no new config keys. Skips when already running, when launching
# the orchestrator itself, or under AE_NO_AUTOSTART=1 (also the recursion guard for
# the fire-and-forget self-invocation below). Never blocks or fails a launch.
# The session name a launch argv NAMES — for the two autostart guards and
# nothing else: the orchestrator companion must not be started for the
# orchestrator session itself, and a telegram refusal record says which session
# it was refusing for. ADVISORY, and deliberately not a grammar: the core owns
# the launch grammar and every refusal it carries, so this scan accepts anything
# and answers with the last positional exactly as that grammar's `*)` arm does.
# `use` and `--from` consume the word after them (an agent name and an archive
# uuid — neither is a session name). No positional means the core will DERIVE the
# name, and a derived name always carries a path hash, so it can never be
# literally `orchestrator` or `hub`; empty is the right answer there.
_autostart_session_hint() {
    local word name=""
    while [[ $# -gt 0 ]]; do
        word="$1"
        shift
        case "$word" in
            use | --from)
                if (($# > 0)); then
                    shift
                fi
                ;;
            --*) ;;
            *) name="$word" ;;
        esac
    done
    printf '%s\n' "$name"
    return 0
}

_orchestrator_autostart_if_scaffolded() {
    [[ "${AE_NO_AUTOSTART:-}" == "1" ]] && return 0
    case "${SESSION:-}" in orchestrator | hub) return 0 ;; esac
    # Scaffold probe mirrors the orchestrator trampoline's era-detection EXACTLY
    # (review finding): a set AE_ORCHESTRATOR_DIR is authoritative (set-but-missing
    # means 'ae orchestrator' would error — don't fire a child that dies silently),
    # then canonical, then AE_HUB_DIR (authoritative likewise), then legacy.
    local _sconf=""
    if [[ -n "${AE_ORCHESTRATOR_DIR:-}" ]]; then
        _sconf="${AE_ORCHESTRATOR_DIR}/orchestrator.config"
    elif [[ -f "$CONFIG_DIR/orchestrator/orchestrator.config" ]]; then
        _sconf="$CONFIG_DIR/orchestrator/orchestrator.config"
    elif [[ -n "${AE_HUB_DIR:-}" ]]; then
        _sconf="${AE_HUB_DIR}/hub.config"
    elif [[ -f "$CONFIG_DIR/meta-hub/hub.config" ]]; then
        _sconf="$CONFIG_DIR/meta-hub/hub.config"
    fi
    [[ -n "$_sconf" && -f "$_sconf" ]] || return 0
    # Tri-state probes (#28): only a VERIFIED absence may start a companion.
    # An UNKNOWN answer (rc 2 — tmux failed to answer at all) cannot rule out a
    # orchestrator that is already running, and the cost of guessing wrong is a
    # duplicate session whose backgrounded launch dies with its stderr on
    # /dev/null. Fail toward doing nothing, and say why.
    local _st_rc=0 _hub_rc=0
    daemon_session_running orchestrator || _st_rc=$?
    if ((_st_rc == 0)); then
        return 0
    fi
    daemon_session_running hub || _hub_rc=$?
    if ((_hub_rc == 0)); then
        return 0
    fi
    if ((_st_rc == 2 || _hub_rc == 2)); then
        echo "Orchestrator autostart skipped — tmux did not answer, so a running orchestrator cannot be ruled out." >&2
        return 0
    fi
    echo "Starting orchestrator companion session in the background (AE_NO_AUTOSTART=1 skips)."
    # Launch through the interpreter we are already running under, not through
    # ae's PATH-resolved shebang: this child's stderr goes to /dev/null, so a
    # wrong-bash refusal would be invisible. Belt and braces with the
    # `unset AE_BASH_REEXEC` at the top of the file.
    (AE_NO_AUTOSTART=1 "${BASH:-bash}" "$0" orchestrator >/dev/null 2>&1 &)
    return 0
}

_telegram_autostart_if_enabled() {
    # The Rust core is the ONE bridge now: the aewatch stand-down guard is gone
    # along with the bash bridge it used to suppress, so intent + liveness are
    # the whole decision. Every revive path (launch, reattach, watchdog
    # _supervise) still funnels here.
    [[ "$(_telegram_intent_enabled)" == "true" ]] || return 0
    _telegram_daemon_running && return 0
    # No dependency pre-check: the bridge IS the ae core, so "can this machine
    # run it" is exactly "is there a usable core", which _telegram_spawn_daemon
    # already decides. A second gate here would duplicate that judgement and
    # drift from it. An unusable core reaches the caller as a failed spawn, and
    # the warn-and-continue tail below is where it surfaces.
    local token_file err lock refusal_category autostart_session
    autostart_session="${AE_TELEGRAM_AUTOSTART_SESSION:-${SESSION:-}}"
    token_file="$(get_config telegram.token_file 2>/dev/null || true)"
    if err="$(_telegram_validate_token_file "$token_file" 2>&1)"; then
        : # ok
    else
        _telegram_record_autostart_refusal "token-unreadable" "$autostart_session"
        echo "ae telegram: skipped autostart — $err" >&2
        return 0
    fi
    lock="$(_telegram_control_lock_file)"
    {
        # Non-blocking: if a start/stop/supervise is mid-flight, skip this tick —
        # autostart must never delay session launch. Re-check intent + running
        # UNDER the lock so a concurrent `ae telegram stop` can't be undone (the
        # stop-vs-supervise TOCTOU race).
        flock -n 9 || return 0
        # Authoritative (uncached) re-check: a same-second `stop` must win even
        # if this process's get_config cache (possibly a different
        # XDG_RUNTIME_DIR) still has enabled=true.
        [[ "$(_telegram_intent_enabled_uncached)" == "true" ]] || return 0
        _telegram_daemon_running && return 0
        if ! _telegram_spawn_daemon 2>/dev/null; then
            refusal_category="${_TELEGRAM_COEXISTENCE_REFUSAL_CATEGORY:-spawn-failed}"
            _telegram_record_autostart_refusal "$refusal_category" "$autostart_session"
            echo "ae telegram: autostart failed (continuing without bridge)" >&2
        fi
    } 9>"$lock"
    return 0
}

cmd_telegram_help() {
    cat <<'EOF'
Usage:
  ae telegram setup      Interactive: writes [telegram] config + token file
  ae telegram start      Persist enabled=true and start the daemon now
  ae telegram stop       Persist enabled=false and stop the daemon now
  ae telegram status     Report runtime + intent state

Config block in ~/.ae/config:
  [telegram]
  enabled = true
  token_file = "~/.config/ae/telegram-bot.token"
  chat_id = 123456789
  allowed_user_ids = "123456789"
  include = "send,ask,review,reply,done,alert,throttled,chat"   # default
  exclude = "memo"                                             # default empty

Requires: a configured ae core (workspace.core or AE_CORE_BIN) and nothing
else. The bridge IS the ae core binary, run in tmux session `ae-telegram`;
it forwards filtered events from every ae session on this machine.
See docs/internals/bridge-protocol.md for the underlying contract.
EOF
}

cmd_telegram_setup() {
    local token_path_default="$HOME/.config/ae/telegram-bot.token"
    mkdir -p "$(dirname "$token_path_default")"
    echo "ae telegram setup — interactive."
    echo
    local token chat_id
    # -s keeps the token off the screen/scrollback. It is not a shell-history
    # risk here (read runs inside the script, not the user's interactive shell),
    # but visible-on-screen is its own leak vector (over-the-shoulder, recording).
    read -r -s -p "Bot token (from @BotFather): " token
    echo
    [[ -n "$token" ]] || {
        echo "Error: token required" >&2
        return 1
    }
    read -r -p "Chat ID (your Telegram numeric id): " chat_id
    [[ -n "$chat_id" ]] || {
        echo "Error: chat_id required" >&2
        return 1
    }
    if ! [[ "$chat_id" =~ ^-?[0-9]+$ ]]; then
        echo "Error: chat_id must be numeric" >&2
        return 1
    fi

    local tok_target="$token_path_default"
    read -r -p "Token file path [$tok_target]: " _tok_input
    [[ -n "$_tok_input" ]] && tok_target="$(_telegram_expand_path "$_tok_input")"
    mkdir -p "$(dirname "$tok_target")"
    (
        umask 077
        printf '%s\n' "$token" >"$tok_target"
    )
    chmod 600 "$tok_target"

    # Write config block (preserve user's existing content).
    if [[ ! -f "$CONFIG_FILE" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        : >"$CONFIG_FILE"
    fi
    if grep -q '^\[telegram\]' "$CONFIG_FILE"; then
        echo "Warning: [telegram] section already exists in $CONFIG_FILE — leaving as-is."
        echo "Edit it manually if values changed."
    else
        cat >>"$CONFIG_FILE" <<EOF

[telegram]
enabled = true
token_file = "${tok_target/#$HOME/~}"
chat_id = $chat_id
allowed_user_ids = "$chat_id"
EOF
    fi
    echo
    echo "Saved token to $tok_target (chmod 600)."
    echo "Wrote [telegram] block to $CONFIG_FILE."
    echo "Run 'ae telegram start' to spawn the daemon."
}

cmd_telegram_start() {
    # No dependency pre-check — see _telegram_autostart_if_enabled. An unusable
    # core fails in the spawn below, which prints WHICH of the three conditions
    # failed; this path only adds that the start did not happen.
    local err
    local token_file
    token_file="$(get_config telegram.token_file 2>/dev/null || true)"
    if ! err="$(_telegram_validate_token_file "$token_file" 2>&1)"; then
        echo "Error: $err" >&2
        return 1
    fi
    local chat_id lock
    chat_id="$(get_config telegram.chat_id 2>/dev/null || true)"
    [[ -n "$chat_id" ]] || {
        echo "Error: telegram.chat_id missing in config" >&2
        return 1
    }
    lock="$(_telegram_control_lock_file)"
    # Under the control lock so start serializes with stop/supervise (the whole
    # start/stop/supervise trio shares it): enable + spawn happen atomically.
    {
        # Must hold the lock (serializes with stop/supervise). Busy → report,
        # don't run the critical section unlocked.
        flock -w 5 9 || {
            echo "ae telegram: busy (start/stop/supervise in progress) — try again" >&2
            return 1
        }
        _telegram_persist_intent "true"
        if _telegram_daemon_running; then
            echo "ae telegram: already running (tmux session $_TELEGRAM_TMUX_SESSION)"
            return 0
        fi
        _telegram_spawn_daemon
        if _telegram_daemon_running; then
            echo "ae telegram: started (tmux session $_TELEGRAM_TMUX_SESSION)"
            return 0
        fi
        echo "Error: failed to spawn daemon" >&2
        return 1
    } 9>"$lock"
}

cmd_telegram_stop() {
    local lock
    lock="$(_telegram_control_lock_file)"
    # Hold the control lock across disable + kill so an in-flight autostart/
    # supervise tick can't re-spawn after we've disabled (it re-checks intent
    # under the same lock). Wait briefly, but proceed best-effort if contended.
    {
        # Must hold the lock to be correct — proceeding unlocked would re-open
        # the stop-vs-supervise race. If we can't get it in 5s, report busy.
        flock -w 5 9 || {
            echo "ae telegram: busy (start/stop/supervise in progress) — try again" >&2
            return 1
        }
        _telegram_persist_intent "false"
        if _telegram_daemon_running; then
            tmux kill-session -t "$_TELEGRAM_TMUX_SESSION" 2>/dev/null
            echo "ae telegram: stopped"
        else
            echo "ae telegram: was not running"
        fi
    } 9>"$lock"
}

cmd_telegram_status() {
    local intent runtime
    intent="$(_telegram_intent_enabled)"
    if _telegram_daemon_running; then runtime="running"; else runtime="stopped"; fi
    echo "ae telegram:"
    echo "  intent:  enabled=$intent (in $CONFIG_FILE)"
    echo "  backend: ae core (state in $CONFIG_DIR/telegram)"
    echo "  runtime: daemon $runtime (tmux session $_TELEGRAM_TMUX_SESSION)"
    if _telegram_load_last_autostart_refusal; then
        echo "  autostart: last refusal=${_TELEGRAM_LAST_REFUSAL_CATEGORY} at ${_TELEGRAM_LAST_REFUSAL_TS}"
    fi
    local core=""
    if core="$(_ae_core_bin_input)" &&
        [[ "$core" == /* && -x "$core" ]] &&
        _ae_core_bin_version "$core" >/dev/null 2>&1; then
        echo "  core:    $core"
    else
        echo "  core:    not configured (set workspace.core or AE_CORE_BIN)"
    fi
    local token_file err
    token_file="$(get_config telegram.token_file 2>/dev/null || true)"
    if [[ -n "$token_file" ]]; then
        if err="$(_telegram_validate_token_file "$token_file" 2>&1)"; then
            echo "  token:   OK ($(_telegram_expand_path "$token_file"))"
        else
            echo "  token:   ERROR — $err"
        fi
    else
        echo "  token:   not configured"
    fi
    # The state the DAEMON owns, which is not what the bash bridge owned. Its
    # state.tsv (one row per tracked session, the outbound fan-in cursor) is
    # orphaned: nothing writes it any more, so reporting it described a file
    # that would stay absent forever. The core keeps two files here instead —
    # and deliberately no global outbound cursor, because outbound progress is
    # PER SESSION (<meta>/telegram-outbound.cursor) and has no single path to
    # print.
    local _tg_state_dir="$CONFIG_DIR/telegram"
    local _f _shown=""
    for _f in tg_offset current_target; do
        # `[[ ... ]] && x` as a loop body's LAST statement returns 1 when the
        # condition is false, and ae runs under errexit — the documented footgun.
        if [[ -f "${_tg_state_dir}/${_f}" ]]; then
            _shown+=" $_f"
        fi
    done
    if [[ -n "$_shown" ]]; then
        echo "  state:   ${_shown# } (in $_tg_state_dir)"
    else
        echo "  state:   none yet (in $_tg_state_dir)"
    fi
    # An explicit include= that omits `chat` silently drops agents' `say`
    # replies (outbound chat). When include is unset the default carries `chat`,
    # so only warn when the user pinned an include without it.
    local include_cfg
    include_cfg="$(get_config telegram.include 2>/dev/null || true)"
    if [[ -n "$include_cfg" ]]; then
        local inc_words=" ${include_cfg//,/ } "
        if [[ "$inc_words" == *" chat "* ]]; then
            echo "  include: $include_cfg"
        else
            echo "  include: $include_cfg"
            echo "           WARN: 'chat' not in include — agent 'say' replies will NOT forward to Telegram. Add 'chat' to [telegram] include."
        fi
    fi
}

cmd_telegram() {
    local sub="${1:-status}"
    shift 2>/dev/null || true
    case "$sub" in
        setup) cmd_telegram_setup "$@" ;;
        start) cmd_telegram_start "$@" ;;
        stop) cmd_telegram_stop "$@" ;;
        status) cmd_telegram_status "$@" ;;
        # Internal: best-effort revive used by the watchdog (step 10). Runs
        # the same autostart path as `ae <name>` — respects [telegram] enabled,
        # never flips the persisted flag, idempotent. Not for direct use.
        _supervise) _telegram_autostart_if_enabled 2>/dev/null || true ;;
        help | -h | --help) cmd_telegram_help ;;
        *)
            echo "Error: unknown subcommand 'telegram $sub'" >&2
            cmd_telegram_help >&2
            return 2
            ;;
    esac
}

